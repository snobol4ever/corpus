*  inf_oracle.sno -- the SPITBOL child of the infinite_snobol4 SCRIPtix program: receives one SNOBOL4 expression per
*  request on the COMM channel (SCRIP scripts/monitor/comm_ipc_spitbol.c, cloned from the sync-step monitor's IPC), EVALs
*  it under SETEXIT exactly as inf_eval.sno does, and answers with one result line. The parent names the two pipes in
*  SCRIP_COMM_REQ and SCRIP_COMM_REP and the library in SCRIP_COMM_LIB.
        &TRIM = 1
        lib = HOST(4, 'SCRIP_COMM_LIB')
        LOAD('COMM_OPEN(STRING,STRING)STRING', lib)             :F(END)
        LOAD('COMM_RECV()STRING', lib)                          :F(END)
        LOAD('COMM_REPLY(STRING)STRING', lib)                   :F(END)
        COMM_OPEN(HOST(4, 'SCRIP_COMM_REQ'), HOST(4, 'SCRIP_COMM_REP'))   :F(END)
        safe = DUPL('.', 32) SUBSTR(&ALPHABET, 33, 95) DUPL('.', 129)
        DEFINE('render(r)t')                                    :(render_end)
render  t = DATATYPE(r)
        render = t
        IDENT(t, 'STRING')                                      :S(render_s)
        IDENT(t, 'INTEGER')                                     :S(render_n)
        IDENT(t, 'REAL')                                        :S(render_n)F(RETURN)
render_s
        render = t ' ' SIZE(r) ' ' REPLACE(r, &ALPHABET, safe)  :(RETURN)
render_n
        render = t ' ' r                                        :(RETURN)
render_end
loop    line = COMM_RECV()                                      :F(END)
        &ERRLIMIT = 1000
        SETEXIT('errh')
        r = EVAL(line)                                          :S(ok)
        COMM_REPLY('FAIL')                                      :(loop)
ok      COMM_REPLY(render(r))                                   :(loop)
errh    COMM_REPLY('ERROR ' &ERRTYPE)                           :(loop)
END
