# inf_snobol4.icn -- THE infinite_snobol4 GENERATOR: literal-only SNOBOL4 expressions, one per line, for inf_eval.sno to EVAL
# under SPITBOL and under SCRIP (Lon 2026-10-02, in-chat to the ceo: "use all literal values and no identifiers for now ...
# integers, reals, and strings are samples. But patterns should be very exhaustive, POS(0), POS(1), ARB, every pattern
# primitive"; "For keywords, every single keyword; exhaustive."; "combine the two programs into one. random + every together.";
# "Let's do a random/every run that concentrates on building interesting subject strings, probably calculator expressions for
# example. Use Icon generator to gen those using suspend/return just like Expressions.icn I suppose. Then generate in the form
# s ? ... where s is the literals mentioned and ... is the crazy all pattern combo test.").
# ONE PROGRAM, TWO WALKS OVER EACH GRAMMAR, the technique of Expressions.icn: the RANDOM walk (r_*) draws once per procedure
# and RETURNS the first succeeding guarded alternative; the EVERY walk (e_*) SUSPENDS every production, the global tokens
# counted through the reversible assignment <- in e_token, e_room refusing an arm that cannot fit, each level enumerating the
# level below once.
# GRAMMAR EXPR, lowest precedence first: match E1 ? E1 | alternation E2 | E1 | concatenation E3 E2 | addition E4 + E3,
# E4 - E3 | multiplication E5 * E4, E5 / E4 | exponentiation E6 ** E5, E6 ^ E5, E6 ! E5 | unary - + * | primary: a literal,
# a keyword, a pattern primitive or pattern function on literal arguments, or ( E ). A primitive call counts as one token.
# GRAMMAR MATCH: S ? P. S is one of the literal strings, or a calculator expression of Expressions.icn quoted as a string
#   expression := term | term + expression | term - expression    term := factor | factor * term | factor / term
#   factor := element | + factor | - factor                       element := x | y | z | INT | ( expression )
# and P is every pattern combination: alternation P | P, concatenation P P, grouping ( P ), ARBNO( P ) and FENCE( P ) over
# every primitive of EXPR, the calculator primitives (ANY NOTANY SPAN BREAK BREAKX of operator, letter, digit and paren sets)
# and the literal strings x + ( ) 1 and the null string. The subject counts as one token.
# Usage: inf_snobol4 [walk=random|every|both] [kind=expr|match|both] [count=N] [limit=N] [seed=N] [elimit=N] [plimit=N]
#        [climit=N]; count random expressions of at most limit tokens from &random := seed; every EXPR expression of at most
#        elimit tokens; every S ? P with P at most plimit tokens and S every literal string and every calculator subject of at
#        most climit tokens. No arguments: a small sample of all four walks. Output order: random EXPR, every EXPR, random
#        MATCH, every MATCH. An expression the exclusion list names (inf_exclude.tsv) is redrawn (random) or skipped and
#        counted (every); each walk's count goes to standard error.
global tokens, limit, leaves, subjects, pleaves
procedure inf_integers()
    return ["0", "1", "2", "10"];
end
procedure inf_reals()
    return ["0.0", "1.5", "1.1", "2.0"];
end
procedure inf_strings()
    return ["''", "'a'", "'ab'", "'abc'", "'0'", "'1'", "'1.1'", "'x'", "'y'", "'z'", "'(matched [things])'", "'('", "')'",
            "'['", "']'", "\"b\""];
end
procedure inf_keywords()
    local l, k;
    l := [];
    every k := !["ABEND", "ABORT", "ALPHABET", "ANCHOR", "ARB", "BAL", "CASE", "CODE", "COMPARE", "DUMP", "ERRLIMIT", "ERRTEXT",
                 "ERRTYPE", "FAIL", "FENCE", "FILE", "FNCLEVEL", "FTRACE", "FULLSCAN", "INPUT", "LASTFILE", "LASTLINE", "LASTNO",
                 "LCASE", "LINE", "MAXLNGTH", "OUTPUT", "PROFILE", "REM", "RTNTYPE", "STCOUNT", "STLIMIT", "STNO", "SUCCEED",
                 "TRACE", "TRIM", "UCASE"] do put(l, "&" || k);
    return l;
end
procedure inf_patterns()
    local l, f, a;
    l := ["ARB", "BAL", "REM", "FAIL", "FENCE", "ABORT", "SUCCEED"];
    every f := !["ANY", "NOTANY", "SPAN", "BREAK", "BREAKX"] do
        every a := !["'a'", "'ab'", "''"] do put(l, f || "(" || a || ")");
    every f := !["POS", "RPOS", "LEN", "TAB", "RTAB"] do
        every a := !["0", "1", "2"] do put(l, f || "(" || a || ")");
    every f := !["ARBNO", "FENCE"] do
        every a := !["'a'", "LEN(1)", "'a' | 'b'"] do put(l, f || "(" || a || ")");
    return l;
end
procedure inf_calc_patterns()
    local l, f, a;
    l := [];
    every f := !["ANY", "NOTANY", "SPAN", "BREAK", "BREAKX"] do
        every a := !["'+-'", "'*/'", "'xyz'", "'0123456789'", "'()'"] do put(l, f || "(" || a || ")");
    every f := !["POS", "RPOS", "LEN", "TAB", "RTAB"] do put(l, f || "(3)");
    return l ||| ["'x'", "'+'", "'('", "')'", "'1'", "''"];
end
procedure inf_exclusions()
    return ["SUCCEED", " ** &STLIMIT", " ^ &STLIMIT", " ! &STLIMIT", "&LINE", "&LASTLINE", "&FILE", "&LASTFILE", "&STNO",
            "&LASTNO", "&STCOUNT"];
end
procedure inf_excluded(e)
    return find(!inf_exclusions(), e);
end
procedure r_token(s)
    tokens +:= 1;
    return s;
end
procedure r_room(n)
    return tokens + n <= limit;
end
procedure r_bin(s)
    return r_token(?[" " || s || " ", s || " ", " " || s, s]);
end
procedure r_un(s)
    return r_token(?[s, s || " "]);
end
procedure r_match()
    local r;
    r := ?100;
    return ( (r <= 40 | not r_room(4), r_alt())
           | (r <= 80, r_token(?subjects) || r_bin("?") || r_alt())
           | (r_alt() || r_bin("?") || r_alt())
           );
end
procedure r_alt()
    local r;
    r := ?100;
    return ( (r <= 75 | not r_room(4), r_cat())
           | (r_cat() || r_bin("|") || r_alt())
           );
end
procedure r_cat()
    local r;
    r := ?100;
    return ( (r <= 70 | not r_room(4), r_add())
           | (r_add() || r_token(" ") || r_cat())
           );
end
procedure r_add()
    local r;
    r := ?100;
    return ( (r <= 75 | not r_room(4), r_mul())
           | (r <= 88, r_mul() || r_bin("+") || r_add())
           | (r_mul() || r_bin("-") || r_add())
           );
end
procedure r_mul()
    local r;
    r := ?100;
    return ( (r <= 75 | not r_room(4), r_exp())
           | (r <= 88, r_exp() || r_bin("*") || r_mul())
           | (r_exp() || r_bin("/") || r_mul())
           );
end
procedure r_exp()
    local r;
    r := ?100;
    return ( (r <= 85 | not r_room(4), r_unary())
           | (r <= 92, r_unary() || r_bin("**") || r_exp())
           | (r <= 96, r_unary() || r_bin("^") || r_exp())
           | (r_unary() || r_bin("!") || r_exp())
           );
end
procedure r_unary()
    local r;
    r := ?100;
    return ( (r <= 85 | not r_room(3), r_primary())
           | (r_un(?"-+*") || r_unary())
           );
end
procedure r_primary()
    local r;
    r := ?100;
    return ( (r <= 40 | not r_room(3), r_token(?leaves))
           | (r_token("(") || r_match() || r_token(")"))
           );
end
procedure r_element()
    local r;
    r := ?100;
    return ( (r <= 20, "x")
           | (r <= 40, "y")
           | (r <= 60, "z")
           | (r <= 80, string(?100))
           | ("(" || r_expression() || ")")
           );
end
procedure r_factor()
    local r;
    r := ?100;
    return ( (r <= 80, r_element())
           | (r <= 90, "+" || r_factor())
           | ("-" || r_factor())
           );
end
procedure r_term()
    local r;
    r := ?100;
    return ( (r <= 70, r_factor())
           | (r <= 85, r_factor() || "*" || r_term())
           | (r_factor() || "/" || r_term())
           );
end
procedure r_expression()
    local r;
    r := ?100;
    return ( (r <= 70, r_term())
           | (r <= 85, r_term() || "+" || r_expression())
           | (r_term() || "-" || r_expression())
           );
end
procedure r_subject()
    local r;
    r := ?100;
    return ( (r <= 40, r_token(?subjects))
           | r_token("'" || r_expression() || "'")
           );
end
procedure r_palt()
    local r;
    r := ?100;
    return ( (r <= 60 | not r_room(3), r_pcat())
           | (r_pcat() || r_token(" | ") || r_palt())
           );
end
procedure r_pcat()
    local r;
    r := ?100;
    return ( (r <= 55 | not r_room(3), r_pelem())
           | (r_pelem() || r_token(" ") || r_pcat())
           );
end
procedure r_pelem()
    local r;
    r := ?100;
    return ( (r <= 70 | not r_room(3), r_token(?pleaves))
           | (r <= 80, r_token("(") || r_palt() || r_token(")"))
           | (r <= 90, r_token("ARBNO(") || r_palt() || r_token(")"))
           | (r_token("FENCE(") || r_palt() || r_token(")"))
           );
end
procedure e_token(s)
    suspend (tokens <- tokens + 1, tokens <= limit, s);
end
procedure e_room(n)
    return tokens + n <= limit;
end
procedure e_bin(s)
    suspend e_token(" " || s || " ") | e_token(s || " ") | e_token(" " || s) | e_token(s);
end
procedure e_un(s)
    suspend e_token(s) | e_token(s || " ");
end
procedure e_match()
    local f;
    suspend (e_room(3), e_token(!subjects) || e_bin("?") || e_alt());
    every f := e_alt() do
        suspend ( f
                | (e_room(2), f || e_bin("?") || e_alt())
                );
end
procedure e_alt()
    local f;
    every f := e_cat() do
        suspend ( f
                | (e_room(2), f || e_bin("|") || e_alt())
                );
end
procedure e_cat()
    local f;
    every f := e_add() do
        suspend ( f
                | (e_room(2), f || e_token(" ") || e_cat())
                );
end
procedure e_add()
    local f;
    every f := e_mul() do
        suspend ( f
                | (e_room(2), f || e_bin("+" | "-") || e_add())
                );
end
procedure e_mul()
    local f;
    every f := e_exp() do
        suspend ( f
                | (e_room(2), f || e_bin("*" | "/") || e_mul())
                );
end
procedure e_exp()
    local f;
    every f := e_unary() do
        suspend ( f
                | (e_room(2), f || e_bin("**" | "^" | "!") || e_exp())
                );
end
procedure e_unary()
    suspend e_primary() | (e_room(2), e_un(!"-+*") || e_unary());
end
procedure e_primary()
    suspend e_token(!leaves) | (e_room(3), e_token("(") || e_match() || e_token(")"));
end
procedure e_element()
    suspend ( e_token("x" | "y" | "z" | "1" | "42")
            | (e_room(3), e_token("(") || e_expression() || e_token(")"))
            );
end
procedure e_factor()
    suspend ( e_element()
            | (e_room(2), e_token("+" | "-") || e_factor())
            );
end
procedure e_term()
    local f;
    every f := e_factor() do
        suspend ( f
                | (e_room(2), f || e_token("*" | "/") || e_term())
                );
end
procedure e_expression()
    local f;
    every f := e_term() do
        suspend ( f
                | (e_room(2), f || e_token("+" | "-") || e_expression())
                );
end
procedure e_palt()
    local f;
    every f := e_pcat() do
        suspend ( f
                | (e_room(2), f || e_token(" | ") || e_palt())
                );
end
procedure e_pcat()
    local f;
    every f := e_pelem() do
        suspend ( f
                | (e_room(2), f || e_token(" ") || e_pcat())
                );
end
procedure e_pelem()
    suspend e_token(!pleaves) | (e_room(3), e_token("(" | "ARBNO(" | "FENCE(") || e_palt() || e_token(")"));
end
procedure random_walk(kind, n, lim, seed)
    local e;
    &random := seed;
    every 1 to n do {
        repeat {
            tokens := 0;
            limit := lim;
            e := if kind == "expr" then r_match() else r_subject() || r_token(" ? ") || r_palt();
            if tokens <= limit & not inf_excluded(e) then break;
        };
        write(e);
    };
    write(&errout, n, " random ", kind, " expressions of at most ", lim, " tokens from seed ", seed);
end
procedure every_expr(lim)
    local n, x, e;
    limit := lim;
    tokens := 0;
    n := 0;
    x := 0;
    every e := e_match() do
        if inf_excluded(e) then x +:= 1 else { write(e); n +:= 1; };
    write(&errout, n, " expr expressions of at most ", lim, " tokens, ", x, " excluded");
end
procedure every_match(plim, clim)
    local subj, pats, n, x, s, p, e;
    subj := inf_strings();
    limit := clim;
    tokens := 0;
    every put(subj, "'" || e_expression() || "'");
    pats := [];
    limit := plim;
    tokens := 0;
    every put(pats, e_palt());
    n := 0;
    x := 0;
    every s := !subj do
        every p := !pats do {
            e := s || " ? " || p;
            if inf_excluded(e) then x +:= 1 else { write(e); n +:= 1; };
        };
    write(&errout, n, " match expressions, ", *subj, " subjects (calculator at most ", clim, " tokens) by ", *pats,
          " patterns of at most ", plim, " tokens, ", x, " excluded");
end
procedure main(args)
    local opt, a, k, v, w, d, i;
    opt := table();
    opt["walk"] := "both";
    opt["kind"] := "both";
    opt["count"] := "50";
    opt["limit"] := "8";
    opt["seed"] := "1";
    opt["elimit"] := "1";
    opt["plimit"] := "1";
    opt["climit"] := "1";
    every a := !args do {
        if not (a ? (k := tab(upto('=')), move(1), v := tab(0))) then stop("inf_snobol4: an argument is key=value, not ", a);
        if /opt[k] then stop("inf_snobol4: unknown key ", k);
        opt[k] := v;
    };
    every k := "count" | "limit" | "seed" | "elimit" | "plimit" | "climit" do
        integer(opt[k]) | stop("inf_snobol4: ", k, " is not an integer: ", opt[k]);
    w := opt["walk"];
    d := opt["kind"];
    w == ("random" | "every" | "both") | stop("inf_snobol4: walk is random, every or both, not ", w);
    d == ("expr" | "match" | "both") | stop("inf_snobol4: kind is expr, match or both, not ", d);
    subjects := inf_strings();
    leaves := inf_integers() ||| inf_reals() ||| inf_strings() ||| inf_keywords() ||| inf_patterns();
    pleaves := [];
    every a := !(inf_patterns() ||| inf_calc_patterns()) do
        if not inf_excluded(a) then put(pleaves, a);
    if d == ("expr" | "both") then {
        if w == ("random" | "both") then {
            i := leaves;
            leaves := leaves ||| inf_patterns() ||| inf_patterns();
            random_walk("expr", integer(opt["count"]), integer(opt["limit"]), integer(opt["seed"]));
            leaves := i;
        };
        if w == ("every" | "both") then every_expr(integer(opt["elimit"]));
    };
    if d == ("match" | "both") then {
        if w == ("random" | "both") then random_walk("match", integer(opt["count"]), integer(opt["limit"]), integer(opt["seed"]));
        if w == ("every" | "both") then every_match(integer(opt["plimit"]), integer(opt["climit"]));
    };
end
