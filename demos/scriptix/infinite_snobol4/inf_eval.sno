*  inf_eval.sno -- the evaluator of infinite_snobol4: one SNOBOL4 expression per line of standard input, EVALed, one
*  result line out, so SPITBOL and SCRIP running it on the same lines can be compared line for line. SETEXIT traps
*  every error, EVAL's compile errors included, and the loop keeps going (Lon 2026-10-02).
*  THE VARIABLES a..z BELONG TO THE TEST (Lon 2026-10-02, in-chat to the ceo: "So never use variable a..z since they are
*  used by the test for simplicity."): every name of this program is inf_-prefixed, because SNOBOL4 scope is dynamic and
*  an EVALed (k = 5) would otherwise stomp the evaluator's own counter. A batch's PRE-SET lines give a..z their values
*  and the batch code may stomp on them (Lon: "They can be stomped on. That is the fun of the batch."); state lives for
*  the whole batch, one process per batch. THE SUPPORTING CODE USES NO SINGLE-LETTER NAME (Lon 2026-10-03), and f, g and
*  h are the test's three functions (Lon: "We should add a f, g, h as FUNCTIONS that return a value and a name of variable,
*  like .a or .x. And return "a" and "x"." then "Then you could have PATTERN . f() will assign to variable A (not a). I
*  said it wrong. Use capitols from NAMES in the program."): f(n) a VALUE, the value of the cell named by the n-th string
*  ($a[n]); g(n) the STRING naming the CAPITAL of the n-th string ('A' for 0), so PATTERN $ $g(n) captures into it; h(n)
*  the NAME of that capital (.A, datatype NAME, read from inf_names, the one table that spells the capitals, because SCRIP
*  cannot lower .$x), so PATTERN . h(n) captures into it; each fails when a[n] does not exist or names no capital. THE CLOSED WORLD (Lon 2026-10-03: "The test is to run the pattern, and the results are values X..Z." and "Just
*  assign CONDITIONAL and IMMEDIATE to X through Z for each."): when the batch's preset line (inf_caps = 1) has run, every
*  result line carries the 26 capitals after the value, A=- for null, else A= and the rendered value (X, Y and Z take
*  the direct captures, h(n) and $g(n) reach any capital); every test starts from null capitals (inf_capnull before each
*  line, on both sides), so each test is independent and one divergence is one bug.
*  AN AGGREGATE IS RENDERED BY WHAT IT HOLDS (DESIGN-PLAN random-codegen-scope step 9; the design's R3: this renderer and the
*  Snocone section's are one program in two spellings): an ARRAY as ARRAY, its prototype and its items by index in brackets,
*  a two-dimensional one row after row; a TABLE as TABLE, its size (the rows CONVERT gives it, which hold only the entries
*  whose value is not null) and its entries key=value in brackets, sorted by their rendered text, so that no engine's hash
*  order shows; an item, a key or a value renders as a value does, an aggregate inside one by its name only, and every other
*  datatype is its name. Every pattern here is anchored by its own first element, because a batch may set &ANCHOR.
        &TRIM = 1
        inf_safe = DUPL('.', 32) SUBSTR(&ALPHABET, 33, 95) DUPL('.', 129)
        DEFINE('inf_render(inf_value,inf_inner)inf_dtype')      :(inf_render_end)
inf_render
        inf_dtype = DATATYPE(inf_value)
        inf_render = inf_dtype
        IDENT(inf_dtype, 'STRING')                              :S(inf_render_s)
        IDENT(inf_dtype, 'INTEGER')                             :S(inf_render_n)
        IDENT(inf_dtype, 'REAL')                                :S(inf_render_n)
        DIFFER(inf_inner)                                       :S(RETURN)
        IDENT(inf_dtype, 'ARRAY')                               :S(inf_render_a)
        IDENT(inf_dtype, 'TABLE')                               :S(inf_render_t)F(RETURN)
inf_render_s
        inf_render = inf_dtype ' ' SIZE(inf_value) ' ' REPLACE(inf_value, &ALPHABET, inf_safe) :(RETURN)
inf_render_n
        inf_render = inf_dtype ' ' inf_value                    :(RETURN)
inf_render_a
        inf_render = inf_dtype ' ' PROTOTYPE(inf_value) ' [' inf_items(inf_value) ']' :(RETURN)
inf_render_t
        inf_render = inf_dtype ' ' inf_entries(inf_value)       :(RETURN)
inf_render_end
        DEFINE('inf_low(inf_spec)inf_text')                     :(inf_low_end)
inf_low
        inf_spec BREAK(':') . inf_text ':'                      :F(inf_low_one)
        inf_low = inf_text + 0                                  :(RETURN)
inf_low_one
        inf_low = 1                                             :(RETURN)
inf_low_end
        DEFINE('inf_items(inf_arr)inf_proto,inf_dim1,inf_dim2,inf_lo2,inf_i,inf_j,inf_item,inf_sep') :(inf_items_end)
inf_items
        inf_proto = PROTOTYPE(inf_arr)
        inf_items = ''
        inf_sep = ''
        inf_proto BREAK(',') . inf_dim1 ',' REM . inf_dim2     :F(inf_items_v)
        inf_dim2 BREAK(',')                                     :S(RETURN)
        inf_i = inf_low(inf_dim1)
        inf_lo2 = inf_low(inf_dim2)
inf_items_r
        inf_item = inf_arr[inf_i, inf_lo2]                      :F(RETURN)
        inf_j = inf_lo2
inf_items_c
        inf_item = inf_arr[inf_i, inf_j]                        :F(inf_items_n)
        inf_items = inf_items inf_sep inf_render(inf_item, 1)
        inf_sep = ', '
        inf_j = inf_j + 1                                       :(inf_items_c)
inf_items_n
        inf_i = inf_i + 1                                       :(inf_items_r)
inf_items_v
        inf_i = inf_low(inf_proto)
inf_items_l
        inf_item = inf_arr[inf_i]                               :F(RETURN)
        inf_items = inf_items inf_sep inf_render(inf_item, 1)
        inf_sep = ', '
        inf_i = inf_i + 1                                       :(inf_items_l)
inf_items_end
        DEFINE('inf_entries(inf_tbl)inf_pairs,inf_proto,inf_count,inf_keys,inf_entry,inf_i,inf_j,inf_sep') :(inf_entries_end)
inf_entries
        inf_pairs = CONVERT(inf_tbl, 'ARRAY')                   :F(inf_entries_0)
        inf_proto = PROTOTYPE(inf_pairs)
        inf_proto BREAK(',') . inf_count
        inf_keys = ARRAY(inf_count)
        inf_i = 1
inf_entries_l
        inf_entry = inf_render(inf_pairs[inf_i, 1], 1) '=' inf_render(inf_pairs[inf_i, 2], 1) :F(inf_entries_j)
        inf_j = inf_i
inf_entries_s
        GT(inf_j, 1) LGT(inf_keys[inf_j - 1], inf_entry)       :F(inf_entries_p)
        inf_keys[inf_j] = inf_keys[inf_j - 1]
        inf_j = inf_j - 1                                       :(inf_entries_s)
inf_entries_p
        inf_keys[inf_j] = inf_entry
        inf_i = inf_i + 1                                       :(inf_entries_l)
inf_entries_j
        inf_entries = inf_count ' ['
        inf_sep = ''
        inf_i = 1
inf_entries_k
        inf_entry = inf_keys[inf_i]                             :F(inf_entries_e)
        inf_entries = inf_entries inf_sep inf_entry
        inf_sep = ', '
        inf_i = inf_i + 1                                       :(inf_entries_k)
inf_entries_e
        inf_entries = inf_entries ']'                           :(RETURN)
inf_entries_0
        inf_entries = '0 []'                                    :(RETURN)
inf_entries_end
        inf_names = TABLE()
        inf_names['A'] = .A
        inf_names['B'] = .B
        inf_names['C'] = .C
        inf_names['D'] = .D
        inf_names['E'] = .E
        inf_names['F'] = .F
        inf_names['G'] = .G
        inf_names['H'] = .H
        inf_names['I'] = .I
        inf_names['J'] = .J
        inf_names['K'] = .K
        inf_names['L'] = .L
        inf_names['M'] = .M
        inf_names['N'] = .N
        inf_names['O'] = .O
        inf_names['P'] = .P
        inf_names['Q'] = .Q
        inf_names['R'] = .R
        inf_names['S'] = .S
        inf_names['T'] = .T
        inf_names['U'] = .U
        inf_names['V'] = .V
        inf_names['W'] = .W
        inf_names['X'] = .X
        inf_names['Y'] = .Y
        inf_names['Z'] = .Z
        DEFINE('f(inf_arg)inf_s')                               :(inf_f_end)
f       inf_s = a[inf_arg]                                      :F(FRETURN)
        f = $inf_s                                              :(RETURN)
inf_f_end
        DEFINE('g(inf_arg)inf_s')                               :(inf_g_end)
g       inf_s = a[inf_arg]                                      :F(FRETURN)
        g = REPLACE(inf_s, &LCASE, &UCASE)                      :(RETURN)
inf_g_end
        DEFINE('h(inf_arg)inf_s')                               :(inf_h_end)
h       inf_s = a[inf_arg]                                      :F(FRETURN)
        h = inf_names[REPLACE(inf_s, &LCASE, &UCASE)]
        DIFFER(h)                                               :S(NRETURN)F(FRETURN)
inf_h_end
        DEFINE('inf_capnull()inf_rest,inf_letter')              :(inf_capnull_end)
inf_capnull
        inf_rest = &UCASE
inf_capnull_loop
        inf_rest LEN(1) . inf_letter =                          :F(RETURN)
        $inf_letter =                                           :(inf_capnull_loop)
inf_capnull_end
        DEFINE('inf_capline()inf_rest,inf_letter')              :(inf_capline_end)
inf_capline
        inf_rest = &UCASE
        inf_capline = ''
inf_capline_loop
        inf_rest LEN(1) . inf_letter =                          :F(RETURN)
        DIFFER($inf_letter)                                     :F(inf_capline_null)
        inf_capline = inf_capline ' ' inf_letter '=' inf_render($inf_letter) :(inf_capline_loop)
inf_capline_null
        inf_capline = inf_capline ' ' inf_letter '=-'           :(inf_capline_loop)
inf_capline_end
inf_loop
        inf_line = INPUT                                        :F(END)
        inf_capnull()
        &ERRLIMIT = 1000
        SETEXIT('inf_errh')
        inf_result = EVAL(inf_line)                             :S(inf_ok)
        inf_out = 'FAIL'                                        :(inf_put)
inf_ok  inf_out = inf_render(inf_result)                        :(inf_put)
inf_errh
        inf_out = 'ERROR ' &ERRTYPE
inf_put
        DIFFER(inf_caps)                                        :F(inf_write)
        inf_out = inf_out ' |' inf_capline()
inf_write
        OUTPUT = inf_out                                        :(inf_loop)
END
