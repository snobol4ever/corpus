program sample(output);
const n = 50;
type range = 2..n;
var flags: array [range] of boolean;
    i, j, count: integer;
    a, b, t: integer;
function gcd(x, y: integer): integer;
begin
  if y = 0 then gcd := x else gcd := gcd(y, x mod y)
end;
begin
  for i := 2 to n do flags[i] := true;
  count := 0;
  for i := 2 to n do
    if flags[i] then begin
      count := count + 1;
      write(i:4);
      j := i + i;
      while j <= n do begin flags[j] := false; j := j + i end
    end;
  writeln;
  writeln('primes up to ', n:1, ': ', count:1);
  a := 0; b := 1;
  for i := 1 to 10 do begin write(a:4); t := a + b; a := b; b := t end;
  writeln;
  writeln('gcd(1071, 462) = ', gcd(1071, 462):1)
end.
