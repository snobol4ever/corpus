# inf_grammar.icn -- the literal-only SNOBOL4 expression grammar the infinite_snobol4 generators share (Lon 2026-10-02: "use all literal
# values and no identifiers for now ... integers, reals, and strings are samples. But patterns should be very exhaustive,
# POS(0), POS(1), ARB, every pattern primitive"; "For strings "0", "1", "1.1" are interesting."; "For strings "x", "y", and "z", and "(matched [things])" are
# interesting."; "For strings "(", ")", "[", and "]" are interesting."; "For keywords, every single keyword; exhaustive.").
# The keywords are the 37 of the oracle's own standard-variable table (sbl.min: every svk* entry and the svfnk/svfpk names).
# Levels, lowest precedence first: match E1 ? E1 | alternation E2 | E1 | concatenation E3 E2 | addition E4 + E3, E4 - E3 |
# multiplication E5 * E4, E5 / E4 | exponentiation E6 ** E5, E6 ^ E5, E6 ! E5 | unary - + * | primary: a literal, a pattern
# primitive or pattern function on literal arguments, or ( E ). A primitive call counts as one token.
procedure inf_integers()
    return ["0", "1", "2", "10"];
end
procedure inf_reals()
    return ["0.0", "1.5", "1.1", "2.0"];
end
procedure inf_strings()
    return ["''", "'a'", "'ab'", "'abc'", "'0'", "'1'", "'1.1'", "'x'", "'y'", "'z'", "'(matched [things])'", "'('", "')'",
            "'['", "']'", "\"b\""];
end
procedure inf_keywords()
    local l, k;
    l := [];
    every k := !["ABEND", "ABORT", "ALPHABET", "ANCHOR", "ARB", "BAL", "CASE", "CODE", "COMPARE", "DUMP", "ERRLIMIT", "ERRTEXT",
                 "ERRTYPE", "FAIL", "FENCE", "FILE", "FNCLEVEL", "FTRACE", "FULLSCAN", "INPUT", "LASTFILE", "LASTLINE", "LASTNO",
                 "LCASE", "LINE", "MAXLNGTH", "OUTPUT", "PROFILE", "REM", "RTNTYPE", "STCOUNT", "STLIMIT", "STNO", "SUCCEED",
                 "TRACE", "TRIM", "UCASE"] do put(l, "&" || k);
    return l;
end
procedure inf_patterns()
    local l, f, a;
    l := ["ARB", "BAL", "REM", "FAIL", "FENCE", "ABORT", "SUCCEED"];
    every f := !["ANY", "NOTANY", "SPAN", "BREAK", "BREAKX"] do
        every a := !["'a'", "'ab'", "''"] do put(l, f || "(" || a || ")");
    every f := !["POS", "RPOS", "LEN", "TAB", "RTAB"] do
        every a := !["0", "1", "2"] do put(l, f || "(" || a || ")");
    every f := !["ARBNO", "FENCE"] do
        every a := !["'a'", "LEN(1)", "'a' | 'b'"] do put(l, f || "(" || a || ")");
    return l;
end
procedure inf_exclusions()
    return ["SUCCEED"];
end
procedure inf_excluded(e)
    return find(!inf_exclusions(), e);
end
