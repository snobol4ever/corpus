# gen_every_snobol4.icn -- the EXHAUSTIVE sister of bootstrap/parser_snobol4.sc (Lon and the ceo, 2026-10-01): the same
# seventeen levels as gen_random_snobol4.icn, each a generator that SUSPENDS every production in turn, the technique of
# Expressions.icn: the global tokens counts the tokens on the current path through the reversible assignment <- and
# e_token refuses a token past the global limit, so the final rejection on every path is the total token count. Two
# refinements over the calculator, both measured: e_room refuses an arm that needs more tokens than remain before it
# starts (it changes nothing enumerated; without it limit 1 ran past 300 s under iconx, every failing path retried
# every lower level once per arm), and each level enumerates the level below ONCE, reusing each result f for the
# pass-through and for every operator arm, so the work is proportional to the output rather than to the product of the
# arms down the chain. Every operator, name, literal, bracket and comma is one token; blanks are not. Every binary
# operator is produced in its four spacings and every unary operator in its two (Lon), so the enumeration covers the
# spellings the parsers must read apart. The program prints every statement OUTPUT = <expression> of at most limit
# tokens, grouped by left operand; the count on stderr.
# Usage: gen_every_snobol4 [limit]   -- every statement of at most limit tokens (default 2)
global tokens, limit
procedure e_token(s)
    suspend (tokens <- tokens + 1, tokens <= limit, s);
end
procedure e_room(n)
    return tokens + n <= limit;
end
procedure e_bin(s)
    suspend e_token(" " || s || " ") | e_token(s || " ") | e_token(" " || s) | e_token(s);
end
procedure e_un(s)
    suspend e_token(s) | e_token(s || " ");
end
procedure e_expr0()
    local f;
    every f := e_expr1() do
        suspend ( f
                | (e_room(2), f || e_bin("=") || e_expr0())
                );
end
procedure e_expr1()
    local f;
    every f := e_expr2() do
        suspend ( f
                | (e_room(2), f || e_bin("?") || e_expr1())
                );
end
procedure e_expr2()
    local f;
    every f := e_expr3() do
        suspend ( f
                | (e_room(2), f || e_bin("&") || e_expr2())
                );
end
procedure e_expr3()
    local f;
    every f := e_expr4() do
        suspend ( f
                | (e_room(2), f || e_bin("|") || e_expr3())
                );
end
procedure e_expr4()
    local f;
    every f := e_expr5() do
        suspend ( f
                | (e_room(2), f || e_token(" ") || e_expr4())
                );
end
procedure e_expr5()
    local f;
    every f := e_expr6() do
        suspend ( f
                | (e_room(2), f || e_bin("@") || e_expr5())
                );
end
procedure e_expr6()
    local f;
    every f := e_expr7() do
        suspend ( f
                | (e_room(2), f || e_bin("+") || e_expr6())
                | (e_room(2), f || e_bin("-") || e_expr6())
                );
end
procedure e_expr7()
    local f;
    every f := e_expr8() do
        suspend ( f
                | (e_room(2), f || e_bin("#") || e_expr7())
                );
end
procedure e_expr8()
    local f;
    every f := e_expr9() do
        suspend ( f
                | (e_room(2), f || e_bin("/") || e_expr8())
                );
end
procedure e_expr9()
    local f;
    every f := e_expr10() do
        suspend ( f
                | (e_room(2), f || e_bin("*") || e_expr9())
                );
end
procedure e_expr10()
    local f;
    every f := e_expr11() do
        suspend ( f
                | (e_room(2), f || e_bin("%") || e_expr10())
                );
end
procedure e_expr11()
    local f;
    every f := e_expr12() do
        suspend ( f
                | (e_room(2), f || e_bin("**") || e_expr11())
                | (e_room(2), f || e_bin("^") || e_expr11())
                | (e_room(2), f || e_bin("!") || e_expr11())
                );
end
procedure e_expr12()
    local f;
    every f := e_expr13() do
        suspend ( f
                | (e_room(2), f || e_bin("$") || e_expr12())
                | (e_room(2), f || e_bin(".") || e_expr12())
                );
end
procedure e_expr13()
    local f;
    every f := e_expr14() do
        suspend ( f
                | (e_room(2), f || e_bin("~") || e_expr13())
                );
end
procedure e_expr14()
    suspend ( e_expr15()
            | e_token("&ANCHOR")
            | e_token("&ALPHABET")
            | (e_room(2), e_un(!"@~?&+-*$.!^%/#=|") || e_expr14())
            );
end
procedure e_expr15()
    local f;
    every f := e_expr17() do
        suspend ( f
                | (e_room(3), f || e_token("[") || e_args() || e_token("]"))
                | (e_room(3), f || e_token("<") || e_args() || e_token(">"))
                );
end
procedure e_args()
    local a;
    suspend (e_room(2), e_token(", ") || e_expr0());
    every a := e_expr0() do
        suspend ( a
                | (e_room(2), a || e_token(", ") || e_expr0())
                | (e_room(1), a || e_token(","))
                );
end
procedure e_expr17()
    suspend ( e_token("X")
            | e_token("1")
            | e_token("'a'")
            | e_token("\"b\"")
            | e_token("1.5")
            | (e_room(3), e_token("F(") || e_args() || e_token(")"))
            | (e_room(3), e_token("LEN(") || e_expr0() || e_token(")"))
            | (e_room(2), e_token("(") || e_token(")"))
            | (e_room(3), e_token("(") || e_expr0() || e_token(")"))
            | (e_room(5), e_token("(") || e_expr0() || e_token(", ") || e_expr0() || e_token(")"))
            );
end
procedure main(args)
    local n;
    limit := integer(args[1]) | 2;
    tokens := 0;
    n := 0;
    every write("\tOUTPUT = ", e_expr0()) do n +:= 1;
    write(&errout, n, " statements of at most ", limit, " tokens");
end
