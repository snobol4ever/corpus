# ExpressionsAll.icn -- the EXHAUSTIVE twin of Expressions.icn (Lon and the ceo, 2026-10-01): every calculator expression of
# the same grammar, in derivation order, up to a token bound. Every nonterminal is a generator that suspends each of its
# productions in turn; the global tokens counts the tokens on the current path through the reversible assignment <- (undone
# when the path is backtracked), and tok() refuses a token past the global limit, so the final rejection on every path is
# the total token count. Operators and parentheses count as tokens; x y z and the one integer literal are the leaves.
#   term    := factor | factor '+' term | factor '-' term
#   factor  := element | element '*' factor | element '/' factor
#   element := item | '+' element | '-' element
#   item    := x | y | z | 1 | '(' term ')'
# Usage: ExpressionsAll [limit]   -- every expression of at most limit tokens (default 3), one per line; the count on stderr.
global tokens, limit
procedure tok(s)
    suspend (tokens <- tokens + 1, tokens <= limit, s);
end
procedure item()
    suspend tok("x") | tok("y") | tok("z") | tok("1") | (tok("(") || term() || tok(")"));
end
procedure element()
    suspend item() | (tok("+") || element()) | (tok("-") || element());
end
procedure factor()
    suspend element() | (element() || tok("*") || factor()) | (element() || tok("/") || factor());
end
procedure term()
    suspend factor() | (factor() || tok("+") || term()) | (factor() || tok("-") || term());
end
procedure main(args)
    local n;
    limit := integer(args[1]) | 3;
    tokens := 0;
    n := 0;
    every write(term()) do n +:= 1;
    write(&errout, n, " expressions of at most ", limit, " tokens");
end
