#-----------------------------------------------------------------------------------------------------------------------
# Usage: Expressions [count [seed]]   -- count expressions (default 100), &random := seed (default 0), one per line.
#-----------------------------------------------------------------------------------------------------------------------
procedure item()
    local r;
    r := ?100;
    if      r <= 20 then return "x"
    else if r <= 40 then return "y"
    else if r <= 60 then return "z"
    else if r <= 80 then return string(?100)
    else                 return "(" || term() || ")";
end
#-----------------------------------------------------------------------------------------------------------------------
procedure element()
    local r;
    r := ?100;
    if      r <= 80 then return item()
    else if r <= 90 then return "+" || element()
    else                 return "-" || element();
end
#-----------------------------------------------------------------------------------------------------------------------
procedure factor()
    local r;
    r := ?100;
    if      r <= 70 then return element()
    else if r <= 85 then return element() || "*" || factor()
    else                 return element() || "/" || factor();
end
#-----------------------------------------------------------------------------------------------------------------------
procedure term()
    local r;
    r := ?100;
    if      r <= 70 then return factor()
    else if r <= 85 then return factor() || "+" || term()
    else                 return factor() || "-" || term();
end
#-----------------------------------------------------------------------------------------------------------------------
procedure expression()
    return term();
end
#-----------------------------------------------------------------------------------------------------------------------
procedure main(args)
    local n;
    n := integer(args[1]) | 100;
    &random := integer(args[2]) | 0;
    every 1 to n do write(expression());
end
