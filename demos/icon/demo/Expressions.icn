#-----------------------------------------------------------------------------------------------------------------------
# Usage: Expressions [count [seed]]   -- count expressions (default 100), &random := seed (default 0), one per line.
#-----------------------------------------------------------------------------------------------------------------------
procedure item()
    local r;
    r := ?100;
    if      r <= 20 then suspend "x"
    else if r <= 40 then suspend "y"
    else if r <= 60 then suspend "z"
    else if r <= 80 then suspend string(?100)
    else                 suspend "(" || (term() \ 1) || ")";
end
#-----------------------------------------------------------------------------------------------------------------------
procedure element()
    local r;
    r := ?100;
    if      r <= 80 then suspend item() \ 1
    else if r <= 90 then suspend "+" || (element() \ 1)
    else                 suspend "-" || (element() \ 1);
end
#-----------------------------------------------------------------------------------------------------------------------
procedure factor()
    local r;
    r := ?100;
    if      r <= 70 then suspend element() \ 1
    else if r <= 85 then suspend (element() \ 1) || "*" || (factor() \ 1)
    else                 suspend (element() \ 1) || "/" || (factor() \ 1);
end
#-----------------------------------------------------------------------------------------------------------------------
procedure term()
    local r;
    r := ?100;
    if      r <= 70 then suspend factor() \ 1
    else if r <= 85 then suspend (factor() \ 1) || "+" || (term() \ 1)
    else                 suspend (factor() \ 1) || "-" || (term() \ 1);
end
#-----------------------------------------------------------------------------------------------------------------------
procedure expression()
    suspend term() \ 1;
end
#-----------------------------------------------------------------------------------------------------------------------
procedure main(args)
    local n;
    n := integer(args[1]) | 100;
    &random := integer(args[2]) | 0;
    every 1 to n do write(expression());
end
