# gen_random_snobol4.icn -- the RANDOM sister of bootstrap/parser_snobol4.sc (Lon and the ceo, 2026-10-01): every level of
# the SNOBOL4 expression grammar as that parser recognises it, SPITBOL's extensions included (the comma list, binary ? and
# the sixteen unary operators), each level a procedure that draws r once and RETURNS the first succeeding alternative of a
# guarded expression list, the technique of Expressions.icn. The program prints count statements OUTPUT = <expression>,
# one per line. GUARDED BY LENGTH (Lon): the global tokens counts every operator, name, literal, bracket and comma on the
# statement; an operator arm is taken only while r_room says the budget holds, the leaf is forced otherwise, and main
# redraws any statement that still runs past limit. SPACING (Lon): a binary operator is printed in one of its four
# combinations of blank and no blank on either side, a unary operator with or without a blank before its operand, so the
# parsers meet every spelling SNOBOL4 reads differently (X + Y adds, X +Y concatenates X with +Y, X+Y is an error).
# The parser's levels, lowest precedence first:
#   Expr0  assignment, right-recursive       E1 = E0
#   Expr1  pattern match                     E2 ? E2 ...
#   Expr2  binary &                          E3 & E3 ...
#   Expr3  alternation                       E4 | E4 ...
#   Expr4  concatenation                     E5 E5 ...
#   Expr5  binary @                          E6 @ E6 ...
#   Expr6  addition, subtraction             E7 + E7 ...   E7 - E7 ...
#   Expr7  binary #                          E8 # E8 ...
#   Expr8  division                          E9 / E9 ...
#   Expr9  multiplication                    E10 * E10 ...
#   Expr10 binary %                          E11 % E11 ...
#   Expr11 exponentiation, right-recursive   E12 ** E11   E12 ^ E11   E12 ! E11
#   Expr12 capture                           E13 $ E13 ...   E13 . E13 ...
#   Expr13 binary ~, right-recursive         E14 ~ E13
#   Expr14 unary                             @ ~ ? & + - * $ . ! ^ % / # = |  applied to E14, and the keyword &NAME
#   Expr15 indexing                          E17 [ args ]   E17 < args >
#   Expr17 primary                           ( )   ( E )   ( E, E )   ( , E )   F( args )   X   'a'   "b"   1.5   1
# Usage: gen_random_snobol4 [count [limit [seed]]]   -- count statements (default 100) of at most limit tokens (default 12)
#                                                     from &random := seed (default 0)
global tokens, limit
procedure r_token(s)
    tokens +:= 1;
    return s;
end
procedure r_room(n)
    return tokens + n <= limit;
end
procedure r_bin(s)
    return r_token(?[" " || s || " ", s || " ", " " || s, s]);
end
procedure r_un(s)
    return r_token(?[s, s || " "]);
end
procedure r_expr0()
    local r;
    r := ?100;
    return ( (r <= 80 | not r_room(4), r_expr1())
           | (r_expr1() || r_bin("=") || r_expr0())
           );
end
procedure r_expr1()
    local r;
    r := ?100;
    return ( (r <= 80 | not r_room(4), r_expr2())
           | (r_expr2() || r_bin("?") || r_expr1())
           );
end
procedure r_expr2()
    local r;
    r := ?100;
    return ( (r <= 80 | not r_room(4), r_expr3())
           | (r_expr3() || r_bin("&") || r_expr2())
           );
end
procedure r_expr3()
    local r;
    r := ?100;
    return ( (r <= 80 | not r_room(4), r_expr4())
           | (r_expr4() || r_bin("|") || r_expr3())
           );
end
procedure r_expr4()
    local r;
    r := ?100;
    return ( (r <= 80 | not r_room(4), r_expr5())
           | (r_expr5() || r_token(" ") || r_expr4())
           );
end
procedure r_expr5()
    local r;
    r := ?100;
    return ( (r <= 80 | not r_room(4), r_expr6())
           | (r_expr6() || r_bin("@") || r_expr5())
           );
end
procedure r_expr6()
    local r;
    r := ?100;
    return ( (r <= 80 | not r_room(4), r_expr7())
           | (r <= 90, r_expr7() || r_bin("+") || r_expr6())
           | (r_expr7() || r_bin("-") || r_expr6())
           );
end
procedure r_expr7()
    local r;
    r := ?100;
    return ( (r <= 80 | not r_room(4), r_expr8())
           | (r_expr8() || r_bin("#") || r_expr7())
           );
end
procedure r_expr8()
    local r;
    r := ?100;
    return ( (r <= 80 | not r_room(4), r_expr9())
           | (r_expr9() || r_bin("/") || r_expr8())
           );
end
procedure r_expr9()
    local r;
    r := ?100;
    return ( (r <= 80 | not r_room(4), r_expr10())
           | (r_expr10() || r_bin("*") || r_expr9())
           );
end
procedure r_expr10()
    local r;
    r := ?100;
    return ( (r <= 80 | not r_room(4), r_expr11())
           | (r_expr11() || r_bin("%") || r_expr10())
           );
end
procedure r_expr11()
    local r;
    r := ?100;
    return ( (r <= 80 | not r_room(4), r_expr12())
           | (r <= 86, r_expr12() || r_bin("**") || r_expr11())
           | (r <= 93, r_expr12() || r_bin("^") || r_expr11())
           | (r_expr12() || r_bin("!") || r_expr11())
           );
end
procedure r_expr12()
    local r;
    r := ?100;
    return ( (r <= 80 | not r_room(4), r_expr13())
           | (r <= 90, r_expr13() || r_bin("$") || r_expr12())
           | (r_expr13() || r_bin(".") || r_expr12())
           );
end
procedure r_expr13()
    local r;
    r := ?100;
    return ( (r <= 80 | not r_room(4), r_expr14())
           | (r_expr14() || r_bin("~") || r_expr13())
           );
end
procedure r_expr14()
    local r;
    r := ?100;
    return ( (r <= 70 | not r_room(3), r_expr15())
           | (r <= 74, r_token("&ANCHOR"))
           | (r <= 76, r_token("&ALPHABET"))
           | (r_un(?"@~?&+-*$.!^%/#=|") || r_expr14())
           );
end
procedure r_expr15()
    local r;
    r := ?100;
    return ( (r <= 86 | not r_room(5), r_expr17())
           | (r <= 93, r_expr17() || r_token("[") || r_args() || r_token("]"))
           | (r_expr17() || r_token("<") || r_args() || r_token(">"))
           );
end
procedure r_args()
    local r;
    r := ?100;
    return ( (r <= 60 | not r_room(4), r_expr0())
           | (r <= 80, r_expr0() || r_token(", ") || r_expr0())
           | (r <= 90, r_token(", ") || r_expr0())
           | (r_expr0() || r_token(","))
           );
end
procedure r_expr17()
    local r;
    r := ?100;
    return ( (r <= 25, r_token("X"))
           | (r <= 40, r_token("Y"))
           | (r <= 55, r_token(string(?9)))
           | (r <= 62, r_token("'a'"))
           | (r <= 67, r_token("\"b\""))
           | (r <= 72, r_token("1.5"))
           | (not r_room(5), r_token("X"))
           | (r <= 78, r_token("F(") || r_args() || r_token(")"))
           | (r <= 84, r_token("LEN(") || r_expr0() || r_token(")"))
           | (r <= 87, r_token("(") || r_token(")"))
           | (r <= 94, r_token("(") || r_expr0() || r_token(")"))
           | (r_token("(") || r_expr0() || r_token(", ") || r_expr0() || r_token(")"))
           );
end
procedure main(args)
    local n, e;
    n := integer(args[1]) | 100;
    limit := integer(args[2]) | 12;
    &random := integer(args[3]) | 0;
    every 1 to n do {
        repeat {
            tokens := 0;
            e := r_expr0();
            if tokens <= limit then break;
        };
        write("\tOUTPUT = ", e);
    };
end
