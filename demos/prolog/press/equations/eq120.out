   gives : 
    sin(x1) + 2 * cos(x1) = (1/2) * 5 ^ (1/2)


sin(arctan((1/2)) + x1) * 5 ^ (1/2) = (1/2) * 5 ^ (1/2) 

	Letting n1 denote an arbitrary integer
    x1 = -1 * arctan((1/2)) + 180 * n1 + arcsin((1/2) * 5 ^ (1/2) * 5 ^ (-1/2)) * -1 ^ n1
     (by Isolation)

Applying substitution 
    x1 = 2 * x

   to    : 
    x1 = -1 * arctan((1/2)) + 180 * n1 + arcsin((1/2) * 5 ^ (1/2) * 5 ^ (-1/2)) * -1 ^ n1

   gives : 
    2 * x = -1 ^ n1 * arcsin((1/2) * 5 ^ (1/2) * 5 ^ (-1/2)) + -1 * arctan((1/2)) + 180 * n1


    x = (1/2) * (180 * n1 + arcsin((1/2) * 5 ^ (1/2) * 5 ^ (-1/2)) * -1 ^ n1 + -1 * arctan((1/2)))
     (by Isolation)

