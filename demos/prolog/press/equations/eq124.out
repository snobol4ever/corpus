    X3 =  x = 360 * n2 + arccos(-1 * ((82/169) + (-72/169) * (7/6) ^ (1/2)) ^ (1/2))
    X4 =  x = 360 * n2 + -1 * arccos(-1 * ((82/169) + (-72/169) * (7/6) ^ (1/2)) ^ (1/2))
    X5 =  x = 360 * n3 + arccos(((82/169) + (72/169) * (7/6) ^ (1/2)) ^ (1/2))
    X6 =  x = 360 * n3 + -1 * arccos(((82/169) + (72/169) * (7/6) ^ (1/2)) ^ (1/2))
    X7 =  x = 360 * n4 + arccos(-1 * ((82/169) + (72/169) * (7/6) ^ (1/2)) ^ (1/2))
    X8 =  x = 360 * n4 + -1 * arccos(-1 * ((82/169) + (72/169) * (7/6) ^ (1/2)) ^ (1/2))


