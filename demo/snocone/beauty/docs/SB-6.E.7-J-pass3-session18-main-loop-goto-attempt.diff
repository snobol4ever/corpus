< // Canonical Snocone slurp idiom: `Line = INPUT` is the predicate — the
< // assignment expression evaluates to FAIL on EOF, and the surrounding
< // while-test exits cleanly.  (Per programs/snocone/report.md line 1240.)
< //
< // Algorithm mirrors beauty.sno main00..main05 exactly:
< //   * lines starting with '*' or '-' are header lines, passed through;
< //   * other lines accumulate into Src, with continuation lines
< //     ('.' or '+' first char) folded in;
< //   * each completed logical unit is parsed and pretty-printed;
< //   * on EOF, parse the in-progress unit (if any) and stop.
< //
< // Boolean flags use null=false, 1=true throughout (Snocone: 0 is truthy/
< // non-null).  `have_line` distinguishes "Line holds an unprocessed
< // look-ahead" from "Line was just consumed; refetch on next iteration".
< input_done = '';
< Line = '';
< have_line = '';
< while (IDENT(input_done)) {
<     if (IDENT(have_line)) {
<         if (Line = INPUT) { have_line = 1; }
<         else { input_done = 1; }
<     }
<     if (IDENT(input_done)) {
<         if (Line ? (POS(0) ANY('*-'))) {
<             // Header line — pass through verbatim.
<             OUTPUT = Line;
<             have_line = '';
<         } else {
<             // Start a new logical unit; gather continuation lines.
<             Src = Line nl;
<             have_line = '';
<             cont_more = 1;
<             while (DIFFER(cont_more)) {
<                 cont_more = '';
<                 if (Line = INPUT) {
<                     have_line = 1;
<                     if (Line ? (POS(0) ANY('.+'))) {
<                         Src = Src Line nl;
<                         have_line = '';
<                         cont_more = 1;
<                     }
<                     // else: non-continuation, keep for next outer iteration
<                 } else {
<                     input_done = 1;
<                     have_line = '';
<                 }
<             }
<             // Parse the accumulated Src; on error print and continue.
<             if (Src ? (POS(0) *Parse *Space RPOS(0))) {
<                 sno = Pop();
<                 if (DIFFER(sno)) { pp(sno); }
<                 else { OUTPUT = 'Internal Error'; OUTPUT = Src; }
<             } else {
<                 OUTPUT = 'Parse Error'; OUTPUT = Src;
<             }
<         }
<     }
< }
---
> // Body-part-faithful translation of beauty.sno main00..main05 + mainErr1/2.
> // Each label below maps to its .sno counterpart; flow follows .sno verbatim:
> //   :F(LBL)  →  if (~(EXPR)) { goto LBL; }
> //   :S(LBL)  →  if (EXPR)    { goto LBL; }
> //   :(LBL)   →  goto LBL;
> // Body parts (assignments, pattern matches, call) are unchanged in name and
> // content. `END` is SNOBOL4-reserved; the .sc port uses `mainEnd` instead.
> // goto used here is structurally equivalent to .sno's :F/:S/:() flow — the
> // nested-while restructuring (attempted in sessions #17 + this session)
> // surfaces SB-6.E.7-H more aggressively than the goto form does, so the
> // goto form is the correct port until SB-6.E.7-H is fixed.
> 
> // main00            Line        =  INPUT                                 :F(END)
> main00:
> if (~(Line = INPUT)) { goto mainEnd; }
> // main01            Src         =
> main01:
> Src = ;
> //                   Line        POS(0) ANY('*-')                         :F(main02)
> if (~(Line ? (POS(0) ANY('*-')))) { goto main02; }
> //                   OUTPUT         =  Line                               :(main00)
> OUTPUT = Line;
> goto main00;
> // main02            Src         =  Src Line nl
> main02:
> Src = Src Line nl;
> //                   Line        =  INPUT                                 :F(main05)
> if (~(Line = INPUT)) { goto main05; }
> //                   Line        POS(0) ANY('.+')                         :S(main02)
> if (Line ? (POS(0) ANY('.+'))) { goto main02; }
> //                   Src         POS(0) *Parse *Space RPOS(0)             :F(mainErr1)
> if (~(Src ? (POS(0) *Parse *Space RPOS(0)))) { goto mainErr1; }
> //                   DIFFER(sno = Pop())                                  :F(mainErr2)
> if (~DIFFER(sno = Pop())) { goto mainErr2; }
> //                   pp(sno)                                              :(main01)
> pp(sno);
> goto main01;
> // main05            Src         POS(0) *Parse *Space RPOS(0)             :F(mainErr1)
> main05:
> if (~(Src ? (POS(0) *Parse *Space RPOS(0)))) { goto mainErr1; }
> //                   DIFFER(sno = Pop())                                  :F(mainErr2)
> if (~DIFFER(sno = Pop())) { goto mainErr2; }
> //                   pp(sno)                                              :(END)
> pp(sno);
> goto mainEnd;
> // mainErr1          OUTPUT         =  'Parse Error'
> mainErr1:
