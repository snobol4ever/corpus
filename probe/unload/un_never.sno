*  UNLOAD of a name that was NEVER DEFINEd succeeds, in silence — the oracle
*  raises nothing.  Unloading twice succeeds too.
        UNLOAD('NEVERDEF')                      :S(A)F(B)
A       OUTPUT = 'never-defined: SUCCEEDED'     :(C)
B       OUTPUT = 'never-defined: FAILED'
C       DEFINE('MYFN(X)')
        UNLOAD('MYFN')
        UNLOAD('MYFN')                          :S(D)F(E)
D       OUTPUT = 'second unload: SUCCEEDED'     :(END)
E       OUTPUT = 'second unload: FAILED'        :(END)
MYFN    MYFN = X                                :(RETURN)
END
