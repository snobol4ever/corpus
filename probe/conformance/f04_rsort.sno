        A = ARRAY(5)
        A<1> = 3
        A<2> = 1
        A<3> = 4
        A<4> = 1
        A<5> = 5
        S = RSORT(A)
        OUTPUT = S<1> '-' S<2> '-' S<3> '-' S<4> '-' S<5>
        T = TABLE()
        T<'b'> = 2
        T<'a'> = 1
        T<'c'> = 3
        ST = RSORT(T,1)
        OUTPUT = ST<1,1> ST<1,2> '-' ST<2,1> ST<2,2> '-' ST<3,1> ST<3,2>
END
