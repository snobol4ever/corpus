        'abcdef' ? POS(0) 'abc'                   :F(bad1)
        OUTPUT = 'pos0-anchors-ok'                   :(next)
bad1    OUTPUT = 'pos0-should-have-matched'
next
        'abcdef' ? 'abc' POS(3) 'def'             :F(bad2)
        OUTPUT = 'pos3-verified-ok'                  :(next2)
bad2    OUTPUT = 'pos3-should-have-matched'
next2
        'abcdef' ? 'abc' POS(4)                   :S(bad3)
        OUTPUT = 'pos-mismatch-correctly-fails'       :(fin)
bad3    OUTPUT = 'pos-mismatch-wrongly-succeeded'
fin
END
