        DEFINE('foo(x)y,z')                         :(main)
foo     y = x
        z = y * 2
        foo = z                                      :(RETURN)
main    OUTPUT = LOCAL('foo', 1)
        OUTPUT = LOCAL('foo', 2)
        LOCAL('foo', 3)                              :S(bad)
        OUTPUT = 'local-out-of-range-ok'              :(fin)
bad     OUTPUT = 'local-out-of-range-bad'
fin
END
