        A = ARRAY(3)
        A<1> = 'x'
        B = COPY(A)
        B<1> = 'y'
        OUTPUT = A<1>
        OUTPUT = B<1>
        IDENT(A,B)                                        :S(bad1)
        OUTPUT = 'copy-array-distinct-ok'                   :(chk2)
bad1    OUTPUT = 'copy-array-same-bad'
chk2    T = TABLE()
        T<'k'> = 'v1'
        T2 = COPY(T)
        T2<'k'> = 'v2'
        OUTPUT = T<'k'>
        OUTPUT = T2<'k'>
END
