        'abcdef' ? 'abc' RPOS(3)                  :F(bad1)
        OUTPUT = 'rpos3-verified-ok'                 :(next)
bad1    OUTPUT = 'rpos3-should-have-matched'
next
        'abcdef' ? 'abcdef' RPOS(0)                :F(bad2)
        OUTPUT = 'rpos0-anchors-end-ok'               :(next2)
bad2    OUTPUT = 'rpos0-should-have-matched'
next2
        'abcdef' ? 'abc' RPOS(0)                   :S(bad3)
        OUTPUT = 'rpos-mismatch-correctly-fails'       :(fin)
bad3    OUTPUT = 'rpos-mismatch-wrongly-succeeded'
fin
END
