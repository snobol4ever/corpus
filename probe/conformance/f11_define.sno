        DEFINE('foo(x)', 'entry')
        DEFINE('bar(x)')
        DEFINE('rec(n)temp')                         :(main)
entry   foo = x * 2                                  :(RETURN)
bar     bar = x * 3                                  :(RETURN)
rec     temp = n
        EQ(n,1)                                       :F(rdeep)
        rec = temp                                    :(RETURN)
rdeep   rec = rec(n - 1) + temp                        :(RETURN)
main    OUTPUT = foo(21)
        OUTPUT = bar(21)
        OUTPUT = rec(3)
END
