        'abcdef' ? TAB(3) . X                       :F(bad1)
        OUTPUT = 'tab3:' X                             :(next)
bad1    OUTPUT = 'tab-should-have-matched'
next
        'abcdef' ? TAB(3) TAB(1)                    :S(bad2)
        OUTPUT = 'tab-backward-correctly-fails'         :(next2)
bad2    OUTPUT = 'tab-backward-wrongly-succeeded'
next2
        'abcdef' ? TAB(0) . Y                       :F(bad3)
        OUTPUT = 'tab0-null:[' Y ']'                    :(fin)
bad3    OUTPUT = 'tab0-should-have-matched'
fin
END
