*  Regression witness (conform-copy-table-aliases): COPY(table) independence.
*  f51_copy proves only that mutating the COPY does not reach the ORIGINAL, on a
*  one-entry string-keyed table. This pins what that cannot: independence in the
*  OTHER direction, integer (descriptor-hashed) keys, an empty-table copy, and
*  that nesting stays SHALLOW -- a deep copy would pass f51 and be wrong here.
        T = TABLE()
        T<'a'> = 1
        T<2> = 'int-key'
        T<'c'> = 'three'
        C = COPY(T)
        T<'a'> = 'MUTATED-ORIG'
        OUTPUT = 'copy-a=' C<'a'>
        OUTPUT = 'copy-int=' C<2>
        C<'c'> = 'MUTATED-COPY'
        OUTPUT = 'orig-c=' T<'c'>
        E = TABLE()
        EC = COPY(E)
        EC<'k'> = 'v'
        OUTPUT = 'empty-orig-k=[' E<'k'> ']'
        OUTPUT = 'empty-copy-k=' EC<'k'>
        N = TABLE()
        INNER = TABLE()
        INNER<'i'> = 'inner-v'
        N<'nest'> = INNER
        NC = COPY(N)
        X = NC<'nest'>
        X<'i'> = 'SHALLOW'
        OUTPUT = 'nested-shared=' INNER<'i'>
        IDENT(T,C)                                                              :S(same)F(dist)
same    OUTPUT = 'copy-is-alias-BAD'                                            :(fin)
dist    OUTPUT = 'copy-distinct-ok'
fin
END
