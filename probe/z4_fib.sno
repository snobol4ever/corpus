*       Z4 PROBE — DEFINE recursion.  Frame-vs-cell call cost.
        DEFINE('FIB(N)')                                :(FIBEND)
FIB     LE(N,1)                                         :S(FIBR)
        FIB = FIB(N - 1) + FIB(N - 2)                   :(RETURN)
FIBR    FIB = N                                         :(RETURN)
FIBEND
        K = 0
        A = 0
LOOP    K = K + 1
        A = A + FIB(17)
        LT(K,120)                                         :S(LOOP)
        OUTPUT = 'fib ' A
END
