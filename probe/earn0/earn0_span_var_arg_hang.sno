*  MINIMAL: SPAN(var) where var holds a charset string -- hangs in m3, SIGSEGVs in m4.
*  SPAN(literal) with the IDENTICAL string works instantly.  Same divergence for a subject
*  as short as 3 same-char digits; 2-char subject does not hang but silently mis-answers.
	digits = '0123456789'
	X = '999'
	X SPAN(digits) . V                                    :S(YES)
	OUTPUT = 'no digits'
	:(END)
YES	OUTPUT = V
END
