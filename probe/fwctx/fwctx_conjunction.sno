START
-INCLUDE 'global.inc'
-INCLUDE 'case.inc'
-INCLUDE 'assign.inc'
-INCLUDE 'match.inc'
-INCLUDE 'counter.inc'
-INCLUDE 'stack.inc'
-INCLUDE 'tree.inc'
-INCLUDE 'ShiftReduce.inc'
-INCLUDE 'TDump.inc'
-INCLUDE 'Gen.inc'
-INCLUDE 'Qize.inc'
-INCLUDE 'ReadWrite.inc'
-INCLUDE 'XDump.inc'
-INCLUDE 'semantic.inc'
-INCLUDE 'omega.inc'
-INCLUDE 'trace.inc'
                  &FULLSCAN      =  1
                  &MAXLNGTH      =  524288
                  DEFINE('SHX(t,v)')
                  DEFINE('shf2(p,t)')                                            :(X2END)
SHX               OUTPUT         =  'SHX(' t ',' v ')'
                  SHX            =  .dummyy                                      :(NRETURN)
shf2              shf2           =  EVAL("p . thy . *SHX('" t "', thy)")         :(RETURN)
X2END
                  DEFINE('PCX()')
                  DEFINE('nP2()')
                  DEFINE('nQ2()')                                                :(XEND)
PCX               OUTPUT         =  'PCX()'
                  PCX            =  .dummyx                                      :(NRETURN)
nP2               nP2            =  epsilon . *PCX()                             :(RETURN)
nQ2               nQ2            =  epsilon . *PCX()                             :(RETURN)
XEND
                  Space          =  SPAN(' ' tab) | epsilon
                  Label          =  shf2(BREAK(' ' tab nl ';'), 'Label')
                  Stmt           =  *Label
+                                   ( 'ZZZDEADARM1'
+                                   | shf2(epsilon, '') shf2(epsilon, '') shf2(epsilon, '') shf2(epsilon, '')
+                                   )
+                                   FENCE('ZZZDEADGOTO' | shf2(epsilon, '') shf2(epsilon, ''))
+                                   epsilon
                  Command        =  *Stmt ("'Stmt'" & 7) (nl | ';')
                  Parse          =  nP2() ARBNO(*Command) ("'Parse'" & 1) nQ2()
                  Src            =  'START' nl
                  Src            POS(0) *Parse *Space RPOS(0)                    :F(NO)
                  OUTPUT         =  'match'                                      :(DONE)
NO                OUTPUT         =  'nomatch'
DONE
END
