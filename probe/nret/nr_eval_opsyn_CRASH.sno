        DEFINE('PC()')
        DEFINE('nP()')
        DEFINE('Reduce(t,n)')
        DEFINE('red(t,n)')
        OPSYN('&', 'red', 2)
        :(MAIN)
PC      PC = .dummy                                       :(NRETURN)
nP      nP = epsilon . *PC()                              :(RETURN)
Reduce  Reduce = .dummy                                   :(NRETURN)
red     red = EVAL("epsilon . *Reduce(" t ", " n ")")     :(RETURN)
MAIN    epsilon = LEN(0)
        XList = 'x'
        E = nP() *XList ("'E'" & '1')
        'x' ? E                                           :F(ERR)
        OUTPUT = 'matched'                                :(END)
ERR     OUTPUT = 'no match'
END
