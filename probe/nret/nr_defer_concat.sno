        DEFINE('PC()')
        DEFINE('nP()')
        DEFINE('nPop()')
        :(MAIN)
PC      PC = .dummy                             :(NRETURN)
nP      nP = epsilon . *PC()                    :(RETURN)
nPop    nPop = epsilon . *PC()                  :(RETURN)
MAIN    epsilon = LEN(0)
        XList = 'x'
        E = nP() *XList nPop()
        'x' ? E                                 :F(ERR)
        OUTPUT = 'matched'                      :(END)
ERR     OUTPUT = 'no match'
END
