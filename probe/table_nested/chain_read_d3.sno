* chain_read_d3 -- MECHANISM PROBE, row table-nested-subscript-cost. Depth-3 rung of the
* chain_read_d1/d2/d3 ladder: same slot cycle, same leaf INTEGER value (slot*3), two extra chained
* hops (level1[slot][slot][slot], a diagonal).  Table pre-built, no creation/IDENT in the timed
* loop -- mirrors claws5's own mem[num][wrd][tag] hop count with nothing else varying.
        &STLIMIT = -1
        ZCHK = 20
        ZBUD = 500
        ZFLR = 20
        level1 = TABLE()
        slot = 0
seed1   inner2 = TABLE()
        inner3 = TABLE()
        inner3[slot] = slot * 3
        inner2[slot] = inner3
        level1[slot] = inner2
        slot = LT(slot, 7) slot + 1                     :S(seed1)
        DEFINE('ZBODY(ZKN)')                            :(ZBODY_END)
ZBODY   ZKN = ZKN + 0
        ZI = 1
        total = 0
        slot = 0
ZBL     total = total + level1[slot][slot][slot]
        EQ(slot, 7)                                      :S(zreset)
        slot = slot + 1                                   :(zcont)
zreset  slot = 0
zcont   ZI = LT(ZI, ZKN) ZI + 1                           :S(ZBL)
        ZBODY = total                                     :(RETURN)
ZBODY_END
-INCLUDE '../../benchmarks/snobol4/harness.inc'
