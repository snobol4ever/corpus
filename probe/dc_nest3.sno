*  dc_nest3 [DCAP] three-deep nesting: capture of capture of defer
        P = LEN(2)
        Q = LEN(3)
        'ABCDEFG' ? (((*P $ X) $ W) (*Q $ Y)) $ Z      :F(NO)
        OUTPUT = '=S'                                  :(EN)
NO      OUTPUT = '=F'
EN      OUTPUT = 'X=' X
        OUTPUT = 'W=' W
        OUTPUT = 'Y=' Y
        OUTPUT = 'Z=' Z
END
