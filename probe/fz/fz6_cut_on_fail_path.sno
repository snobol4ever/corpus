*	FZ-3: a fenced group that FAILS, then one that succeeds.  The failing attempt unwinds through
*	the cut box beta; the succeeding one then reads its SAVE cursor across a live release.
	S = 'aaabbbccc'
	S ? SPAN('a') . X FENCE SPAN('b') . Y	:F(BAD)
	OUTPUT = 'A=' X '/' Y
	S ? (SPAN('a') FENCE SPAN('z')) . W	:S(BAD)
	OUTPUT = 'E=fail-ok/' W
	S ? (SPAN('a') FENCE SPAN('b')) . W	:F(BAD)
	OUTPUT = 'F=' W	:(END)
BAD	OUTPUT = 'UNEXPECTED'
END
