        digits = '0123456789'
        DATA('tree(t,v,n,c)')
        DEFINE('F(x)')             :(FEnd)
F       t(x) POS(0) ANY(&UCASE &LCASE) SPAN(digits &UCASE '_' &LCASE) RPOS(0)  :S(RETURN)F(FRETURN)
FEnd
        leaf = tree('Name','foo',,)
        F(leaf)                    :S(OK)F(NO)
OK      OUTPUT = 'MATCHED'         :(END)
NO      OUTPUT = 'NOMATCH'
END
