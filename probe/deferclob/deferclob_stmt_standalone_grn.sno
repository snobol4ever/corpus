        nl = CHAR(10)
        Label = BREAK(' ' nl)
        epsilon = ''
        White = SPAN(' ') | epsilon
        Expr = SPAN('0123456789')
        Stmt = *Label (*White *Expr | epsilon)
        Src = 'START' nl
        Src ? POS(0) *Stmt nl RPOS(0)                       :S(OK)F(NO)
OK      OUTPUT = 'match'                                    :(FIN)
NO      OUTPUT = 'nomatch'
FIN
END
