* PROBE: identical loop body to arith_loop.sno's ZBODY, but running top-level -- no DEFINE, no CALL.
        &TRIM = 1
        &ANCHOR = 0
        &STLIMIT = -1
        ZKN = 1000
        A = 0
        ZI = 1
ZBL     A = A + 1
        ZI = LT(ZI, ZKN) ZI + 1                         :S(ZBL)
        OUTPUT = A
END
