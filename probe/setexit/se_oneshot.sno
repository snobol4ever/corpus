* SETEXIT FACE 4 -- THE TRAP IS ONE-SHOT.  Firing DISARMS it, so the SECOND error takes
* the ordinary failure exit and the handler is NOT re-entered.
	SETEXIT(.H)
	&ERRLIMIT = 10
	D = 0
	X = 1 / D		:F(S5)
S5	OUTPUT = "MID"
	Y = 1 / D		:F(S7)
S7	OUTPUT = "AFTER"
	:(END)
H	OUTPUT = "HANDLER S" &LASTNO
	:(CONTINUE)
END
