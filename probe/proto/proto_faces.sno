* proto_faces.sno — EVERY PROTOTYPE FACE, EACH SPELLED TWICE: BARE, THEN WITH AN EXCESS ARGUMENT.
* Manual Ch.8 (and stage2.h nformals): only FORMALS bind arguments and EXCESS ARGUMENTS ARE
* EVALUATED THEN IGNORED, so the `_x` line of every pair must be BYTE-IDENTICAL to the line above
* it -- same VALUE and same DATATYPE.  Companion to proto_excess_arg.sno (which isolates the
* trigger on two faces); this file is the WIDTH: array bare/string/range/multi-dim/negative-lower,
* table default/explicit/two-arg/comma-elided/COPY-carried, and the SORT-built array.
* ⛔ NO INVALID-OBJECT FACE IS PINNED HERE ON PURPOSE.  PROTOTYPE of a STRING, an INTEGER, a REAL,
* a DATA object or the null string is ERROR 164 on the oracle, and its arm is a fatal error dump --
* no .ref may pin a SPITBOL error report (the s190/s191 trap).  That half is verified by hand.
* Oracle: x64/bin/sbl -bf (the ONE arm; sbl_flags() in scorecard_snobol4.sh).
        t = TABLE()
        t<'cat'> = 'dog'
        t<7> = 45
        OUTPUT = 'arr_bare    = ' PROTOTYPE(ARRAY(3)) ' / ' DATATYPE(PROTOTYPE(ARRAY(3)))
        OUTPUT = 'arr_bare_x  = ' PROTOTYPE(ARRAY(3),1) ' / ' DATATYPE(PROTOTYPE(ARRAY(3),1))
        OUTPUT = 'arr_str3    = ' PROTOTYPE(ARRAY('3')) ' / ' DATATYPE(PROTOTYPE(ARRAY('3')))
        OUTPUT = 'arr_str3_x  = ' PROTOTYPE(ARRAY('3'),1) ' / ' DATATYPE(PROTOTYPE(ARRAY('3'),1))
        OUTPUT = 'arr_1_3     = ' PROTOTYPE(ARRAY('1:3')) ' / ' DATATYPE(PROTOTYPE(ARRAY('1:3')))
        OUTPUT = 'arr_1_3_x   = ' PROTOTYPE(ARRAY('1:3'),1) ' / ' DATATYPE(PROTOTYPE(ARRAY('1:3'),1))
        OUTPUT = 'arr_2c3     = ' PROTOTYPE(ARRAY('2,3')) ' / ' DATATYPE(PROTOTYPE(ARRAY('2,3')))
        OUTPUT = 'arr_2c3_x   = ' PROTOTYPE(ARRAY('2,3'),1) ' / ' DATATYPE(PROTOTYPE(ARRAY('2,3'),1))
        OUTPUT = 'arr_1_2c1_3 = ' PROTOTYPE(ARRAY('1:2,1:3')) ' / ' DATATYPE(PROTOTYPE(ARRAY('1:2,1:3')))
        OUTPUT = 'arr_1_2c_x  = ' PROTOTYPE(ARRAY('1:2,1:3'),1) ' / ' DATATYPE(PROTOTYPE(ARRAY('1:2,1:3'),1))
        OUTPUT = 'arr_0_5     = ' PROTOTYPE(ARRAY('0:5')) ' / ' DATATYPE(PROTOTYPE(ARRAY('0:5')))
        OUTPUT = 'arr_0_5_x   = ' PROTOTYPE(ARRAY('0:5'),1) ' / ' DATATYPE(PROTOTYPE(ARRAY('0:5'),1))
        OUTPUT = 'arr_m2_2    = ' PROTOTYPE(ARRAY('-2:2')) ' / ' DATATYPE(PROTOTYPE(ARRAY('-2:2')))
        OUTPUT = 'arr_m2_2_x  = ' PROTOTYPE(ARRAY('-2:2'),1) ' / ' DATATYPE(PROTOTYPE(ARRAY('-2:2'),1))
        OUTPUT = 'arr_3d      = ' PROTOTYPE(ARRAY('2,3,4')) ' / ' DATATYPE(PROTOTYPE(ARRAY('2,3,4')))
        OUTPUT = 'arr_3d_x    = ' PROTOTYPE(ARRAY('2,3,4'),1) ' / ' DATATYPE(PROTOTYPE(ARRAY('2,3,4'),1))
        OUTPUT = 'tbl_dflt    = ' PROTOTYPE(TABLE()) ' / ' DATATYPE(PROTOTYPE(TABLE()))
        OUTPUT = 'tbl_dflt_x  = ' PROTOTYPE(TABLE(),1) ' / ' DATATYPE(PROTOTYPE(TABLE(),1))
        OUTPUT = 'tbl_5       = ' PROTOTYPE(TABLE(5)) ' / ' DATATYPE(PROTOTYPE(TABLE(5)))
        OUTPUT = 'tbl_5_x     = ' PROTOTYPE(TABLE(5),1) ' / ' DATATYPE(PROTOTYPE(TABLE(5),1))
        OUTPUT = 'tbl_5_7     = ' PROTOTYPE(TABLE(5,7)) ' / ' DATATYPE(PROTOTYPE(TABLE(5,7)))
        OUTPUT = 'tbl_5_7_x   = ' PROTOTYPE(TABLE(5,7),1) ' / ' DATATYPE(PROTOTYPE(TABLE(5,7),1))
        OUTPUT = 'tbl_commas  = ' PROTOTYPE(TABLE(,,'d')) ' / ' DATATYPE(PROTOTYPE(TABLE(,,'d')))
        OUTPUT = 'tbl_commas_x= ' PROTOTYPE(TABLE(,,'d'),1) ' / ' DATATYPE(PROTOTYPE(TABLE(,,'d'),1))
        OUTPUT = 'tbl_copy    = ' PROTOTYPE(COPY(TABLE(5))) ' / ' DATATYPE(PROTOTYPE(COPY(TABLE(5))))
        OUTPUT = 'tbl_copy_x  = ' PROTOTYPE(COPY(TABLE(5)),1) ' / ' DATATYPE(PROTOTYPE(COPY(TABLE(5)),1))
        OUTPUT = 'arr_of_sort = ' PROTOTYPE(SORT(t)) ' / ' DATATYPE(PROTOTYPE(SORT(t)))
        OUTPUT = 'arr_of_srt_x= ' PROTOTYPE(SORT(t),1) ' / ' DATATYPE(PROTOTYPE(SORT(t),1))
END
