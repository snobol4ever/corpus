          $('Z' 'Z') = 1
          DEFINE('F()')                         :(GO)
F         F = LEN(4)                            :(RETURN)
GO        'abcdef' POS(0) *F() 'ef' RPOS(0)     :S(PRE)F(PRE)
PRE       C = CODE(" 'abcdef' POS(0) *F() 'ef' RPOS(0) :S(COK)F(CNO) ;COK OUTPUT = 'match' :(RET) ;CNO OUTPUT = 'nomatch' :(RET)")
          OUTPUT = 'before'                     :<C>
RET       OUTPUT = 'back'
END
