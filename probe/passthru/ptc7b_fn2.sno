          $('Z' 'Z') = 1
          DEFINE('F1()')                        :(GO)
F1        F1 = LEN(3) | LEN(2) ANY('c') LEN(1)  :(RETURN)
GO        C = CODE(" 'abcdef' POS(0) *F1() 'ef' RPOS(0) :S(COK)F(CNO) ;COK OUTPUT = 'match' :(RET) ;CNO OUTPUT = 'nomatch' :(RET)")
          OUTPUT = 'before'                     :<C>
RET       OUTPUT = 'back'
END
