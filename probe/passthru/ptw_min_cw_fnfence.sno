          DEFINE('mk()')                        :(E)
mk        mk = LEN(0)                           :(RETURN)
E         P = mk() FENCE(ARBNO('a') | '')
          'aa' POS(0) *P RPOS(0)                :S(OK)F(NO)
OK        OUTPUT = 'match'                      :(END)
NO        OUTPUT = 'nomatch'
END
