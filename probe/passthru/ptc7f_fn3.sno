          $('Z' 'Z') = 1
          P1 = LEN(2)
          DEFINE('F2()')                        :(GO)
F2        F2 = LEN(1) *P1 LEN(1)                :(RETURN)
GO        C = CODE(" 'abcdef' POS(0) *F2() 'ef' RPOS(0) :S(COK)F(CNO) ;COK OUTPUT = 'match' :(RET) ;CNO OUTPUT = 'nomatch' :(RET)")
          OUTPUT = 'before'                     :<C>
RET       OUTPUT = 'back'
END
