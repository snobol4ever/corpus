          $('Z' 'Z') = 1
          D01 = LEN(1) ; D02 = LEN(2) ; D03 = LEN(3) ; D04 = LEN(4)
          D05 = LEN(5) ; D06 = LEN(6) ; D07 = LEN(7) ; D08 = LEN(8)
          D09 = LEN(1) ; D10 = LEN(2) ; D11 = LEN(3) ; D12 = LEN(4)
          D13 = LEN(5) ; D14 = LEN(6) ; D15 = LEN(7) ; D16 = LEN(8)
          LBL = SPAN('L')
          DEFINE('FS()')                        :(GO)
FS        FS = *LBL SPAN('g')                   :(RETURN)
GO        P = (LEN(1) . HD) ARBNO(*FS())
          'xLgLLgg' POS(0) *P RPOS(0)           :S(OK)F(NO)
OK        OUTPUT = 'match:' HD                  :(END)
NO        OUTPUT = 'nomatch'
END
