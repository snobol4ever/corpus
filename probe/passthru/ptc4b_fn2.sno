          $('Z' 'Z') = 1
          DEFINE('F1()')                        :(GO)
F1        F1 = (LEN(3) . CV | LEN(2) . CV) TAB(4)                :(RETURN)
GO        'abcdef' POS(0) *F1() 'ef' RPOS(0)    :S(OK)F(NO)
OK        OUTPUT = 'match:' CV                  :(END)
NO        OUTPUT = 'nomatch'
END
