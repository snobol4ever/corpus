          DEFINE('mk(p)')                       :(E)
mk        mk = p                                :(RETURN)
E         A = ARBNO('a')
          P = mk(A) ''
          'aa' POS(0) *P RPOS(0)                :S(OK)F(NO)
OK        OUTPUT = 'match'                      :(END)
NO        OUTPUT = 'nomatch'
END
