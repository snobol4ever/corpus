          DEFINE('k()')                         :(D1)
k         k = ''                                :(RETURN)
D1        DEFINE('mk2(p,t)')                    :(D2)
mk2       mk2 = EVAL("p . thx . *Sh('" t "', thx)")   :(RETURN)
D2        DEFINE('Sh(t,v)')                     :(D3)
Sh        Sh = .dummy                           :(NRETURN)
D3        nl = ''
          G0         =  *G1
          G1            =  ARBNO(*G2)
          G2            =  FENCE(*G3)
          G3            =  (*G4 | '')
          G4            =  (*G5) ('' . v4)
          G5            =  k() *G6
          G6            =  *G7 nl
          G7            =  *G8
          G8            =  ARBNO('a')
          P = *G0
          'aa a' POS(0) *P                      :S(OK)F(NO)
OK        OUTPUT = 'match'                      :(END)
NO        OUTPUT = 'nomatch'
END
