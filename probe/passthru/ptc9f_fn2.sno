          $('Z' 'Z') = 1
          DEFINE('F1()')                        :(GO)
F1        F1 = 'a' | 'b'                        :(RETURN)
GO        P = (LEN(1) . HD) ARBNO(*F1())
          'xabab' POS(0) *P RPOS(0)             :S(OK)F(NO)
OK        OUTPUT = 'match:' HD                  :(END)
NO        OUTPUT = 'nomatch'
END
