          $('Z' 'Z') = 1
          DEFINE('F1()')                        :(GO)
F1        F1 = ANY('ab')                        :(RETURN)
GO        P2 = ARBNO(*F1() . CV)
          'abab' POS(0) *P2 RPOS(0)             :S(OK)F(NO)
OK        OUTPUT = 'match:' CV                  :(END)
NO        OUTPUT = 'nomatch'
END
