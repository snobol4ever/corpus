          DEFINE('reduce(t,n)')
          DEFINE('DoReduce(t,n)')
          OPSYN('&', 'reduce', 2)               :(E)
DoReduce  OUTPUT = 'DoReduce(' t ', ' n ')'
          DoReduce = .dummy                     :(NRETURN)
reduce    reduce = EVAL("epsilon . *DoReduce(" t ", " n ")") :(RETURN)
E         P = ARBNO('a') ("'A'" & 1)
          'aa' POS(0) *P RPOS(0)                :S(OK)F(NO)
OK        OUTPUT = 'match'                      :(END)
NO        OUTPUT = 'nomatch'
END
