          $('Z' 'Z') = 1
          DEFINE('red2(t,n)')
          DEFINE('RDX(t,n)')                    :(SEND)
red2      red2 = EVAL("epsilon . *RDX(" t ", " n ")")  :(RETURN)
RDX       OUTPUT = 'R(' t ',' n ')'
          RDX = .dummy                          :(NRETURN)
SEND      OPSYN('&', 'red2', 2)
          P2 = ARBNO('a') ("'q'" & 1)
          'aa' POS(0) *P2 RPOS(0)               :S(OK)F(NO)
OK        OUTPUT = 'match'                      :(END)
NO        OUTPUT = 'nomatch'
END
