          DEFINE('mk()')
          DEFINE('mk2()')                       :(E)
mk        mk = ARBNO('a')                       :(RETURN)
mk2       mk2 = ''                              :(RETURN)
E         P = mk() mk2()
          'aa' POS(0) *P RPOS(0)                :S(OK)F(NO)
OK        OUTPUT = 'match'                      :(END)
NO        OUTPUT = 'nomatch'
END
