        DEFINE('ONCE(ID)NAME')                   :(ONCE_END)
ONCE    ONCE  =  IDENT(ID,NULL)
+       CONVERT('ONCE(' &STCOUNT ')' , 'EXPRESSION')  :S(RETURN)
        NAME   =  'ONCE..'  ID
        ONCE   =  $NAME
        $NAME  =  FAIL                           :(RETURN)
ONCE_END
        P  =  ONCE()
        'xyz'  P                                 :S(OK)F(NO)
OK      OUTPUT = 'matched'                        :(END1)
NO      OUTPUT = 'failed'
END1
END
