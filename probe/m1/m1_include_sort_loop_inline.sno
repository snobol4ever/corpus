    UTF = TABLE()
    UTF['k1'] = 'NAME_1'
    UTF['k2'] = 'NAME_2'
    UTF['k3'] = 'NAME_3'
    UTF['k4'] = 'NAME_4'
    UTF['k5'] = 'NAME_5'
    UTF['k6'] = 'NAME_6'
    UTF['k7'] = 'NAME_7'
    UTF['k8'] = 'NAME_8'
    UTF['k9'] = 'NAME_9'
    UTF['k10'] = 'NAME_10'
    UTF['k11'] = 'NAME_11'
    UTF['k12'] = 'NAME_12'
    UTF['k13'] = 'NAME_13'
    UTF['k14'] = 'NAME_14'
    UTF['k15'] = 'NAME_15'
    UTF['k16'] = 'NAME_16'
    UTF['k17'] = 'NAME_17'
    UTF['k18'] = 'NAME_18'
    UTF['k19'] = 'NAME_19'
    UTF['k20'] = 'NAME_20'
    UTF_Array = SORT(UTF)
    i = 0
G1  i = i + 1
    $UTF_Array[i, 2] = UTF_Array[i, 1]  :S(G1)
    UTF_Array =
    i =
        OUTPUT = 'main ' NAME_1 ' ' NAME_20
END
