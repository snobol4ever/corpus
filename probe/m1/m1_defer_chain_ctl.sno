*                 s186 CONTROL for m1_defer_chain: the SAME shape one hop shallower (P2 -> P1).  This arm was
*                 always green in both engines -- it is what proves the defect is the SECOND hop, not deferral.
                  digits         =  '0123456789'
                  P1             =  SPAN(digits)
                  P2             =  *P1
                  S              =  'A1'
                  S              POS(0) 'A' *P2 RPOS(0)                          :F(NO)
                  OUTPUT         =  'match'                                      :(FIN)
NO                OUTPUT         =  'nomatch'
FIN
END
