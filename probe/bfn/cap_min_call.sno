* dc2: deferred capture CALL, inline in match statement
          $('Z' 'Z') = 1
          DEFINE('PC()')                                  :(SEND)
PC        OUTPUT = 'PC()'
          PC = .dummy                                     :(NRETURN)
SEND
          'ab' LEN(1) . *PC()                             :F(NO)
          OUTPUT = 'match d=' dummy                       :(DONE)
NO        OUTPUT = 'nomatch'
DONE
END
