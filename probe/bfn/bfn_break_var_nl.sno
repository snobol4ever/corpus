* bw6: bw2 but tail is BREAK(nl) nl and subject ends in newline
          $('Z' 'Z') = 1
          nl = CHAR(10)
          DEFINE('PC()')
          DEFINE('nPush()')                               :(SEND)
PC        OUTPUT = 'PC()'
          PC = .dummy                                     :(NRETURN)
nPush     nPush = epsilon . *PC()                         :(RETURN)
SEND
          Parse = nPush() BREAK(nl) nl
          Src = 'START' nl
          Src *Parse                                      :F(NOMATCH)
          OUTPUT = 'match'                                :(DONE)
NOMATCH   OUTPUT = 'nomatch'
DONE
END
