* bw6d: BREAK on literal char, no nl variable
          $('Z' 'Z') = 1
          DEFINE('PC()')
          DEFINE('nPush()')                               :(SEND)
PC        OUTPUT = 'PC()'
          PC = .dummy                                     :(NRETURN)
nPush     nPush = epsilon . *PC()                         :(RETURN)
SEND
          Parse = nPush() BREAK('x') 'x'
          Src = 'STARTx'
          Src *Parse                                      :F(NOMATCH)
          OUTPUT = 'match'                                :(DONE)
NOMATCH   OUTPUT = 'nomatch'
DONE
END
