*------------------------------------------------------------------------------
* Minimized from v05_treebank_pushlist_235.sno (49 lines vs 94). Isolates the m3/m4
* divergence to: a *E deferred-expression pattern call (NOT EVAL -- EVAL is not
* present here and the crash still reproduces), whose real invocation is pumped at
* match-END (rt_dcap_pump, not during the match traversal), reaching a disjunction
* box (the LT(place,0) n(x)+place idiom in ListValue/ListInsert) several calls deep.
* See .github/FINDING-2026-08-24-seat03-vlist-v05-m4-sigsegv-is-not-the-disjunction-its-eval-indirect-call-memory-corruption.md
* addendum for the confirmed mechanism (gdb software-watchpoint catches the exact
* write: n157_disjunction_α's `mov DWORD PTR [rsp+0x6f0],0x0` lands on environ[]).
*------------------------------------------------------------------------------
                DATA('list(n,a)')
                DEFINE('ListValue(x,place)')
                DEFINE('ListInsert(x,item,place)a,i,size')
                DEFINE('ListSize(x)')                                   :(ListEnd)
*------------------------------------------------------------------------------
ListValue       place           =   LT(place, 0) n(x) + place
                ListValue       =   a(x)[place]                         :S(RETURN)F(FRETURN)
*------------------------------------------------------------------------------
ListInsert      ListInsert      =   x
                size            =   ListSize(x)
                place           =   LT(place, 0) n(x) + place
                GE(place, 0)                                            :F(error)
                LE(place, n(x))                                         :F(error)
                LT(n(x), size)                                          :F(ListInsert4)
                i               =   n(x) + 1
ListInsert1     i               =   GT(i, place + 1) i - 1              :F(ListInsert2)
                a(x)[i]         =   a(x)[i - 1]                         :(ListInsert1)
ListInsert2     a(x)[i - 1]     =   item                                :(ListInsert9)
ListInsert4     a               =   ARRAY('0:' (IDENT(a(x)) 0, size * 2 - 1))
                i               =   -1
ListInsert5     i               =   LT(i, place - 1) i + 1              :F(ListInsert6)
                a[i]            =   a(x)[i]                             :(ListInsert5)
ListInsert6     a[i + 1]        =   item
ListInsert7     i               =   LT(i, n(x) - 1) i + 1               :F(ListInsert8)
                a[i + 1]        =   a(x)[i]                             :(ListInsert7)
ListInsert8     a(x)            =   a
ListInsert9     n(x)            =   n(x) + 1                            :(RETURN)
*------------------------------------------------------------------------------
ListSize        ListSize        =   IDENT(a(x)) 0                       :S(RETURN)
                PROTOTYPE(a(x)) '0:' REM . ListSize
                ListSize        =   ListSize + 1                        :(RETURN)
ListEnd
*------------------------------------------------------------------------------
                DEFINE('Push_list(vs)');    DEFINE('push_list(v)')      :(StackEnd)
*------------------------------------------------------------------------------
Push_list       Push_list       =         epsilon . *push_list(vs)           :(RETURN)
*------------------------------------------------------------------------------
push_list       newl            =   list()
                ListInsert(stack, newl, n(stack))
                push_list       =   .dummy                          :(NRETURN)
*------------------------------------------------------------------------------
StackEnd    stack           =   list()
        p = POS(0) Push_list('BANK') 'ab' RPOS(0)
        'ab' ? p  :F(NO)
        OUTPUT = 'MATCH size=' ListSize(stack)  :(END)
NO      OUTPUT = 'FAIL'
END
