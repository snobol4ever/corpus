*  SPITBOL ADMITS EXACTLY TWO SUBSCRIPTABLE OBJECTS -- AN ARRAY AND A TABLE (manual v3.7
*  p.89-90 Array referencing, p.94-95 Table referencing).  Every other operand is
*  Appendix D 235, "Subscripted operand is not table or array".  This is the ALLOW-LIST
*  census: one line per SPITBOL datatype, so a cure that refuses only the null string
*  (the shape the four idx_* witnesses happen to carry) cannot pass it.
*  &ERRLIMIT converts each error to statement failure so the codes are PINNABLE: an
*  unconverted 235 prints a SPITBOL dump no .ref may honestly carry.
        &ERRLIMIT = 100
        DATA('PT(X,Y)')
        NULLS =
        STR = 'hello'
        INT = 7
        REAL = 1.5
        PAT = SPAN('a')
        NAM = .STR
        EXPR = *(1 + 2)
        COD = CODE(' OUTPUT = 1' CHAR(10) 'END' CHAR(10))
        OBJ = PT(1, 2)
        ARR = ARRAY('0:3')
        TBL = TABLE()
        V = NULLS[1]                            :F(F1)
        OUTPUT = 'null-string  accepted'        :(N1)
F1      OUTPUT = 'null-string  ' &ERRTYPE
N1      V = STR[2]                              :F(F2)
        OUTPUT = 'string       accepted=' V     :(N2)
F2      OUTPUT = 'string       ' &ERRTYPE
N2      V = INT[1]                              :F(F3)
        OUTPUT = 'integer      accepted=' V     :(N3)
F3      OUTPUT = 'integer      ' &ERRTYPE
N3      V = REAL[1]                             :F(F4)
        OUTPUT = 'real         accepted=' V     :(N4)
F4      OUTPUT = 'real         ' &ERRTYPE
N4      V = PAT[1]                              :F(F5)
        OUTPUT = 'pattern      accepted'        :(N5)
F5      OUTPUT = 'pattern      ' &ERRTYPE
N5      V = NAM[1]                              :F(F6)
        OUTPUT = 'name         accepted=' V     :(N6)
F6      OUTPUT = 'name         ' &ERRTYPE
N6      V = EXPR[1]                             :F(F7)
        OUTPUT = 'expression   accepted'        :(N7)
F7      OUTPUT = 'expression   ' &ERRTYPE
N7      V = COD[1]                              :F(F8)
        OUTPUT = 'code         accepted'        :(N8)
F8      OUTPUT = 'code         ' &ERRTYPE
N8      V = OBJ[1]                              :F(F9)
        OUTPUT = 'data-object  accepted=' V     :(N9)
F9      OUTPUT = 'data-object  ' &ERRTYPE
N9      ARR[1] = 'in-array'
        OUTPUT = 'array        accepted=' ARR[1]
        TBL['k'] = 'in-table'
        OUTPUT = 'table        accepted=' TBL['k']
        OUTPUT = 'end'
END
