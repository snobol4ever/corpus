          $('Z' 'Z') = 1
          nl = CHAR(10)
          tab = CHAR(9)
          Stmt3 = BREAK(' ' tab nl ';') FENCE((( SPAN(' ' tab) FENCE(nl '+' | epsilon) | nl '+' ) | epsilon) ':' | epsilon) (( SPAN(' ' tab) FENCE(nl '+' | epsilon) | nl '+' ) | epsilon)
          Src = 'START' nl
          Src POS(0) Stmt3 nl RPOS(0)                     :F(NO)
          OUTPUT = 'match'                                :(DONE)
NO        OUTPUT = 'nomatch'
DONE
END
