* y1: faithful Stmt skeleton -- real seam/FENCE/epsilon-shift topology, Expr road stubbed to fail
          $('Z' 'Z') = 1
          nl = CHAR(10)
          tab = CHAR(9)
          DEFINE('SH(t,v)')
          DEFINE('shift(p,t)')
          DEFINE('PC()')
          DEFINE('nPush()')
          DEFINE('nPop2()')                               :(SEND)
SH        OUTPUT = 'SH(' t ',' v ')'
          SH = .dummy                                     :(NRETURN)
shift     shift = EVAL("p . thx . *SH('" t "', thx)")     :(RETURN)
PC        OUTPUT = 'PC()'
          PC = .dummy                                     :(NRETURN)
nPush     nPush = epsilon . *PC()                         :(RETURN)
nPop2     nPop2 = epsilon . *PC()                         :(RETURN)
SEND
          White = ( SPAN(' ' tab)
+                   FENCE(nl ('+' | '.') FENCE(SPAN(' ' tab) | epsilon) | epsilon)
+                 | nl ('+' | '.') FENCE(SPAN(' ' tab) | epsilon)
+                 )
          Gray = *White | epsilon
          Goto2 = *Gray ':' *Gray
          Label = shift(BREAK(' ' tab nl ';'), 'Label')
          XDEAD = 'ZZZNOTPRESENT'
          Stmt3 = *Label
+                 ( *White *XDEAD
+                 | shift(epsilon, '') shift(epsilon, '') shift(epsilon, '') shift(epsilon, '')
+                 )
+                 FENCE(*Goto2 | shift(epsilon, '') shift(epsilon, ''))
+                 *Gray
          Parse = nPush() *Stmt3 (nl | ';') nPop2()
          Space = SPAN(' ' tab) | epsilon
          Src = 'START' nl
          Src POS(0) *Parse *Space RPOS(0)                :F(NO)
          OUTPUT = 'match'                                :(DONE)
NO        OUTPUT = 'nomatch'
DONE
END
