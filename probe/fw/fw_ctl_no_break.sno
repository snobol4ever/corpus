          $('Z' 'Z') = 1
          nl = CHAR(10)
          tab = CHAR(9)
          White = ( SPAN(' ' tab)
+                   FENCE(nl ('+' | '.') FENCE(SPAN(' ' tab) | epsilon) | epsilon)
+                 | nl ('+' | '.')
+                 )
          Gray = White | epsilon
          Stmt3 = 'START' FENCE(Gray ':' | epsilon) Gray
          Src = 'START' nl
          Src POS(0) Stmt3 nl RPOS(0)                    :F(NO)
          OUTPUT = 'match'                                :(DONE)
NO        OUTPUT = 'nomatch'
DONE
END
