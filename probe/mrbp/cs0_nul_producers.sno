        N = CHAR(0)
        A = 'AB' N 'CD'
        OUTPUT = 'concat  SIZE=' SIZE(A)
        A POS(0) LEN(5) RPOS(0)         :F(X1)
        OUTPUT = 'concat  LEN5 MATCH'   :(P2)
X1      OUTPUT = 'concat  LEN5 NOMATCH'
P2      B = SUBSTR(A,1,5)
        OUTPUT = 'substr  SIZE=' SIZE(B)
        B POS(0) LEN(5) RPOS(0)         :F(X2)
        OUTPUT = 'substr  LEN5 MATCH'   :(P3)
X2      OUTPUT = 'substr  LEN5 NOMATCH'
P3      C = REVERSE(A)
        OUTPUT = 'reverse SIZE=' SIZE(C)
        C POS(0) LEN(5) RPOS(0)         :F(X3)
        OUTPUT = 'reverse LEN5 MATCH'   :(P4)
X3      OUTPUT = 'reverse LEN5 NOMATCH'
P4      D = A
        OUTPUT = 'copy    SIZE=' SIZE(D)
        D POS(0) LEN(5) RPOS(0)         :F(X4)
        OUTPUT = 'copy    LEN5 MATCH'   :(Z)
X4      OUTPUT = 'copy    LEN5 NOMATCH'
Z
END
