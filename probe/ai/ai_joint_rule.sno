    I = 7; J = 5; R = 2.5; Q = 1.5; S = '42'; T = ' 3 '; NUL = ''
    OUTPUT = "ii+ " (I + J);   OUTPUT = "ii- " (I - J);   OUTPUT = "ii* " (I * J)
    OUTPUT = "ir+ " (I + R);   OUTPUT = "ri+ " (R + I);   OUTPUT = "rr+ " (R + Q)
    OUTPUT = "ir* " (I * R);   OUTPUT = "ri- " (R - I);   OUTPUT = "rr- " (R - Q)
    OUTPUT = "si+ " (S + I);   OUTPUT = "is+ " (I + S);   OUTPUT = "st+ " (T + I)
    OUTPUT = "nu+ " (NUL + I); OUTPUT = "sr+ " (S + R)
    OUTPUT = "dt-ii " DATATYPE(I + J); OUTPUT = "dt-ir " DATATYPE(I + R)
    OUTPUT = "dt-ri " DATATYPE(R + I); OUTPUT = "dt-rr " DATATYPE(R + Q)
    OUTPUT = "dt-si " DATATYPE(S + I); OUTPUT = "dt-sr " DATATYPE(S + R)
END
