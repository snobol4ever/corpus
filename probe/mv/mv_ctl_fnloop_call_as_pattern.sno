*  GREEN CONTROL: same fn goto loop building a pattern, call-as-pattern at the match
*  GOAL-SNOBOL4-100 R-2 / R-8 witness set (s105).  Oracle: /home/claude/x64/bin/sbl -b <file>
*  site, but NO nested call in the appended piece.  Passes -- so the nested eager call
*  is load-bearing.
        DEFINE('mk(s)c')                :(mk_end)
mk      IDENT(s)                        :S(RETURN)
        s POS(0) LEN(1) . c =
        mk = mk c                       :(mk)
mk_end
        'ab' mk('ab')                   :F(NO)
        OUTPUT = 'MATCHED fnloop-call'  :(FIN)
NO      OUTPUT = 'NOMATCH'
FIN
END
