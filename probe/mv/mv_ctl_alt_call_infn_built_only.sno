*  GREEN CONTROL (s106) -- same ALT-arm call in a DEFINE body, BUILT BUT NEVER MATCHED => PASS.
*  GOAL-SNOBOL4-100 R-4(b)/eager-call witness set (s106).  Oracle: /home/claude/x64/bin/sbl -b <file>
*  Construction is sound; the crash is at MATCH time.
        DEFINE('mk(s)c,p')              :(mk_end)
mk      c = s
        p = (REPLACE(c,&LCASE,&UCASE) | c)
        mk = 'built-ok'                 :(RETURN)
mk_end
        OUTPUT = mk('a')
END
