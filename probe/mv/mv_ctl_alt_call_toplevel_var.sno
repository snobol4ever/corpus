*  GREEN CONTROL (s106) -- identical ALT-arm call with a VARIABLE argument at TOP LEVEL => PASS.
*  GOAL-SNOBOL4-100 R-4(b)/eager-call witness set (s106).  Oracle: /home/claude/x64/bin/sbl -b <file>
*  Falsifies "variable vs literal argument" as the axis.  NOTE: green by coincidence only --
*  see mv_alt_call_build_order.sno, which shows this same shape calls at the WRONG TIME.
        DEFINE('up(up)')                :(up_end)
up      up = REPLACE(up, &LCASE, &UCASE)  :(RETURN)
up_end
        c = 'a'
        P = LEN(0)
        P = P (up(c) | c)
        'A' P                           :F(NO)
        OUTPUT = 'MATCHED e1'           :(FIN)
NO      OUTPUT = 'NOMATCH'
FIN
END
