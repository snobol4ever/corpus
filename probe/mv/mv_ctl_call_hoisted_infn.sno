*  GREEN CONTROL (s106) -- same call in a DEFINE body HOISTED OUT of the ALT arm into a local,
*  GOAL-SNOBOL4-100 R-4(b)/eager-call witness set (s106).  Oracle: /home/claude/x64/bin/sbl -b <file>
*  then the ALT is over two plain vars => PASS.  The arm-INTERIOR position is the ingredient.
        DEFINE('up(up)')                :(up_end)
up      up = REPLACE(up, &LCASE, &UCASE)  :(RETURN)
up_end
        DEFINE('mk(s)c,t')              :(mk_end)
mk      c = s
        t = up(c)
        mk = (t | c)                    :(RETURN)
mk_end
        'A' mk('a')                     :F(NO)
        OUTPUT = 'MATCHED e6'           :(FIN)
NO      OUTPUT = 'NOMATCH'
FIN
END
