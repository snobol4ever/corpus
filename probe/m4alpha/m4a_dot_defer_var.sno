*  s194 row semantic-driver-m4-segv -- ONE preamble, three DEFINEs; only the pattern line differs.
*  The m4 defect is `.` value-assignment whose deferred right operand is a ZERO-ARG call.
        DEFINE("Zero()")
        DEFINE("One(a)")
        DEFINE("Two(a,b)")                               :(CE)
Zero           n = n + 1
               Zero = .dummy                             :(NRETURN)
One            n = n + a
               One = .dummy                              :(NRETURN)
Two            n = n + a + b
               Two = .dummy                              :(NRETURN)
CE
        subj = "A"
        p = LEN(1) . *n
        OUTPUT = "before"
        subj p                                           :F(F)
        OUTPUT = "after n=" n " dummy=[" dummy "]"       :(T)
F       OUTPUT = "nomatch n=" n
T
END
