*  SPITBOL manual v3.7 p.136 -- NRETURN + deferred evaluation, verbatim shape
        DEFINE('PUSH(X)')
        STK = TABLE()                                     :(PUSH_END)
PUSH    STK[0] = STK[0] + 1
        PUSH = .STK[STK[0]]
        $PUSH = X                                         :(NRETURN)
PUSH_END
        'ABCDE' ? LEN(2) . *PUSH() 'D' LEN(1) . *PUSH()   :F(NOMATCH)
        OUTPUT = 'n=' STK[0] ' [1]=' STK[1] ' [2]=' STK[2] :(DONE)
NOMATCH OUTPUT = 'nomatch'
DONE
END
