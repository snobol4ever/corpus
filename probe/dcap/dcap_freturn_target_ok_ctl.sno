*  CONTROL, GREEN -- the SAME shape where the deferred call SUCCEEDS (:S(NRETURN)), so both
*  engines match.  Its greenness is what proves the defect is the FAILURE path only, and it is the
*  regression guard: a cure that makes this red has broken the working half.
        DEFINE('chk(s)')                                   :(m)
chk     chk            =  .dummy
        s              'YES'                               :S(NRETURN)F(FRETURN)
m       'ABC'          POS(0) SPAN('ABC') $ tx $ *chk('YESSIR') RPOS(0)  :S(Y)F(N)
Y       OUTPUT = 'matched'                                 :(E)
N       OUTPUT = 'nomatch'
E       OUTPUT = 'end'
END
