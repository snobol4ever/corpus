*  N33 [N] body kind ANY (width-1 leaf, ZERO zd_k)
*  subject: 'a,b,c'
*  pattern: POS(0) ANY('abc') ARBNO(',' ANY('abc')) RPOS(0)
*  routes legacy via k0=1; the SPAN control N27 differs ONLY in leaf kind

        SUBJ = 'a,b,c'
        SUBJ ? POS(0) ANY('abc') ARBNO(',' ANY('abc')) RPOS(0) :F(NO)
        OUTPUT = '=S'                                   :(EN)
NO      OUTPUT = '=F'
EN
END
