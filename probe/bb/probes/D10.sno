*  D10 [D] ARBNO(*P) with capture inside body
*  subject: 'abc'
*  pattern: POS(0) ARBNO(*P . W) RPOS(0)

        SUBJ = 'abc'
        P = LEN(1)
        W = '<unset>'
        SUBJ ? POS(0) ARBNO(*P . W) RPOS(0)                    :F(NO)
        OUTPUT = '=S'                                   :(EN)
NO      OUTPUT = '=F'
EN      OUTPUT = 'W=' W
END
