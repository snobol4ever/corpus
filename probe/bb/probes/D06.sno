*  D06 [D] *VAR re-evaluated: P changed between matches
*  subject: 'abcd'
*  pattern: POS(0) *P $ OUTPUT

        SUBJ = 'abcd'
        P = LEN(1)
        SUBJ ? POS(0) *P $ OUTPUT                              :F(NO)
        OUTPUT = '=S'                                   :(EN)
NO      OUTPUT = '=F'
EN      P = LEN(3)
        SUBJ ? POS(0) *P $ OUTPUT
END
