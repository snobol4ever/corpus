*  H04 [H] FENCE1 over an ALTERNATION (the cut)
*  subject: 'abcd'
*  pattern: POS(0) FENCE('ab' | 'a') 'cd' RPOS(0)

        SUBJ = 'abcd'
        SUBJ ? POS(0) FENCE('ab' | 'a') 'cd' RPOS(0)           :F(NO)
        OUTPUT = '=S'                                   :(EN)
NO      OUTPUT = '=F'
EN
END
