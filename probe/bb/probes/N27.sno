*  N27 [N] body kind SPAN/SPAN (control)
*  subject: 'ab,ab'
*  pattern: POS(0) SPAN('ab') ARBNO(',' SPAN('ab')) RPOS(0)

        SUBJ = 'ab,ab'
        SUBJ ? POS(0) SPAN('ab') ARBNO(',' SPAN('ab')) RPOS(0) :F(NO)
        OUTPUT = '=S'                                   :(EN)
NO      OUTPUT = '=F'
EN
END
