*  A13 [A] ALT unequal-length arms + subsequent
*  subject: 'abcd'
*  pattern: POS(0) ('a' | 'ab' | 'abc') $ OUTPUT 'cd' RPOS(0)

        SUBJ = 'abcd'
        SUBJ ? POS(0) ('a' | 'ab' | 'abc') $ OUTPUT 'cd' RPOS(0) :F(NO)
        OUTPUT = '=S'                                   :(EN)
NO      OUTPUT = '=F'
EN
END
