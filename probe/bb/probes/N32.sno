*  N32 [N] body kind ALTERNATION (manual p.122 PAIRS, verbatim)
*  subject: 'CCBBAAAACC'
*  pattern: POS(0) ARBNO('AA' | 'BB' | 'CC') RPOS(0)
*  routes legacy via sq=0 (ALTERNATE in body span), not via k0

        SUBJ = 'CCBBAAAACC'
        SUBJ ? POS(0) ARBNO('AA' | 'BB' | 'CC') RPOS(0)        :F(NO)
        OUTPUT = '=S'                                   :(EN)
NO      OUTPUT = '=F'
EN
END
