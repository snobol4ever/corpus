*  H13 [H] control for H12: no fence
*  subject: 'BlueBird'
*  pattern: POS(0) ARBNO('Bird' | 'Blue' | LEN(1)) $ OUTPUT RPOS(0)

        SUBJ = 'BlueBird'
        SUBJ ? POS(0) ARBNO('Bird' | 'Blue' | LEN(1)) $ OUTPUT RPOS(0) :F(NO)
        OUTPUT = '=S'                                   :(EN)
NO      OUTPUT = '=F'
EN
END
