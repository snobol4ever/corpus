*  N15 [N] ARBNO(*)ALT inner only (case 1 inner)
*  subject: 'BlueGoldBirdFish'
*  pattern: POS(0) ARBNO('Bird' | 'Blue' | LEN(1)) $ OUTPUT RPOS(0)

        SUBJ = 'BlueGoldBirdFish'
        SUBJ ? POS(0) ARBNO('Bird' | 'Blue' | LEN(1)) $ OUTPUT RPOS(0) :F(NO)
        OUTPUT = '=S'                                   :(EN)
NO      OUTPUT = '=F'
EN
END
