*  A09 [A] ALT BACKTRACK: same site, arm3 resume
*  subject: 'AXYB'
*  pattern: POS(0) ('AB' | 'A' | LEN(2) | LEN(3)) $ OUTPUT 'B' RPOS(0)

        SUBJ = 'AXYB'
        SUBJ ? POS(0) ('AB' | 'A' | LEN(2) | LEN(3)) $ OUTPUT 'B' RPOS(0) :F(NO)
        OUTPUT = '=S'                                   :(EN)
NO      OUTPUT = '=F'
EN
END
