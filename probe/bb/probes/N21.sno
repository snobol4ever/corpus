*  N21 [N] two sibling ARBNOs
*  subject: 'aabb'
*  pattern: POS(0) ARBNO('a') $ OUTPUT ARBNO('b') $ OUTPUT RPOS(0)

        SUBJ = 'aabb'
        SUBJ ? POS(0) ARBNO('a') $ OUTPUT ARBNO('b') $ OUTPUT RPOS(0) :F(NO)
        OUTPUT = '=S'                                   :(EN)
NO      OUTPUT = '=F'
EN
END
