*  B01 [B] FLAT pattern, ONE pending-capture node (control for B02)
*  subject: 'abcd'
*  pattern: POS(0) LEN(2) . P LEN(2)

        SUBJ = 'abcd'
        P = '<unset>'
        SUBJ ? POS(0) LEN(2) . P LEN(2)                 :F(NO)
        OUTPUT = '=S'                                   :(EN)
NO      OUTPUT = '=F'
EN      OUTPUT = 'P=' P
END
