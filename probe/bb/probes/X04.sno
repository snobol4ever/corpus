*  X04 [X] nested ARBNO, $ on OUTER body
*  subject: '(ab)(c)'
*  pattern: POS(0) ARBNO(('(' ARBNO(NOTANY(')')) ')') $ OUTPUT) RPOS(0)

        SUBJ = '(ab)(c)'
        SUBJ ? POS(0) ARBNO(('(' ARBNO(NOTANY(')')) ')') $ OUTPUT) RPOS(0) :F(NO)
        OUTPUT = '=S'                                   :(EN)
NO      OUTPUT = '=F'
EN
END
