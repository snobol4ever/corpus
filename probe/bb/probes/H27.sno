*  H27 [H] FENCE1 that FAILS overall, . silent
*  subject: 'abcd'
*  pattern: POS(0) FENCE(LEN(2) . W) 'ZZ'

        SUBJ = 'abcd'
        W = '<unset>'
        SUBJ ? POS(0) FENCE(LEN(2) . W) 'ZZ'                   :F(NO)
        OUTPUT = '=S'                                   :(EN)
NO      OUTPUT = '=F'
EN      OUTPUT = 'W=' W
END
