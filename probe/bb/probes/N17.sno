*  N17 [N] ARBNO(*)ALT capture INSIDE body (case 4)
*  subject: 'BlueGold'
*  pattern: POS(0) ARBNO(('Bird' | 'Blue' | LEN(1)) . W) RPOS(0)

        SUBJ = 'BlueGold'
        W = '<unset>'
        SUBJ ? POS(0) ARBNO(('Bird' | 'Blue' | LEN(1)) . W) RPOS(0) :F(NO)
        OUTPUT = '=S'                                   :(EN)
NO      OUTPUT = '=F'
EN      OUTPUT = 'W=' W
END
