*  D12 [D] recursive pattern via * (manual LIST)
*  subject: '(12,(3,45,(6)),78)'
*  pattern: POS(0) *LIST RPOS(0)

        SUBJ = '(12,(3,45,(6)),78)'
        ITEM = SPAN('0123456789') | *LIST
        LIST = '(' ITEM ARBNO(',' ITEM) ')'
        SUBJ ? POS(0) *LIST RPOS(0)                            :F(NO)
        OUTPUT = '=S'                                   :(EN)
NO      OUTPUT = '=F'
EN
END
