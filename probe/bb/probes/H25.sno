*  H25 [H] FENCE1 in OUTER of nested ARBNO
*  subject: '(ab)(c)'
*  pattern: POS(0) ARBNO(FENCE('(' ARBNO(NOTANY(')')) ')')) RPOS(0)

        SUBJ = '(ab)(c)'
        SUBJ ? POS(0) ARBNO(FENCE('(' ARBNO(NOTANY(')')) ')')) RPOS(0) :F(NO)
        OUTPUT = '=S'                                   :(EN)
NO      OUTPUT = '=F'
EN
END
