*  H24 [H] FENCE1 in INNER of nested ARBNO
*  subject: '(ab)(c)'
*  pattern: POS(0) ARBNO('(' ARBNO(FENCE(NOTANY(')'))) ')') RPOS(0)

        SUBJ = '(ab)(c)'
        SUBJ ? POS(0) ARBNO('(' ARBNO(FENCE(NOTANY(')'))) ')') RPOS(0) :F(NO)
        OUTPUT = '=S'                                   :(EN)
NO      OUTPUT = '=F'
EN
END
