*  D11 [D] ARBNO(*P) where P is an ALTERNATION
*  subject: 'BlueBird'
*  pattern: POS(0) ARBNO(*P) $ OUTPUT RPOS(0)

        SUBJ = 'BlueBird'
        P = 'Bird' | 'Blue' | LEN(1)
        SUBJ ? POS(0) ARBNO(*P) $ OUTPUT RPOS(0)               :F(NO)
        OUTPUT = '=S'                                   :(EN)
NO      OUTPUT = '=F'
EN
END
