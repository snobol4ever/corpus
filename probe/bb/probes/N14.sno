*  N14 [N] ARBNO FAILS overall, . inside silent
*  subject: 'abcd'
*  pattern: POS(0) ARBNO(LEN(1) . W) 'ZZ'

        SUBJ = 'abcd'
        W = '<unset>'
        SUBJ ? POS(0) ARBNO(LEN(1) . W) 'ZZ'                   :F(NO)
        OUTPUT = '=S'                                   :(EN)
NO      OUTPUT = '=F'
EN      OUTPUT = 'W=' W
END
