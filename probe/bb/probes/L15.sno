*  L15 [L] @ cursor capture, three positions
*  subject: 'abcd'
*  pattern: @P0 LEN(2) @P1 LEN(2) @P2

        SUBJ = 'abcd'
        P0 = '?'
        P1 = '?'
        P2 = '?'
        SUBJ ? @P0 LEN(2) @P1 LEN(2) @P2                       :F(NO)
        OUTPUT = '=S'                                   :(EN)
NO      OUTPUT = '=F'
EN      OUTPUT = 'P=' P0 ',' P1 ',' P2
END
