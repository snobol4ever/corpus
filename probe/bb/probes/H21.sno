*  H21 [H] FENCE1 over deferred ALT *P
*  subject: 'BlueBird'
*  pattern: POS(0) ARBNO(FENCE(*P)) $ OUTPUT RPOS(0)

        SUBJ = 'BlueBird'
        P = 'Bird' | 'Blue' | LEN(1)
        SUBJ ? POS(0) ARBNO(FENCE(*P)) $ OUTPUT RPOS(0)        :F(NO)
        OUTPUT = '=S'                                   :(EN)
NO      OUTPUT = '=F'
EN
END
