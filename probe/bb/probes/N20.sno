*  N20 [N] ARBNO of a captured SEQUENCE body
*  subject: 'ababab'
*  pattern: POS(0) ARBNO(('a' 'b') . W) RPOS(0)

        SUBJ = 'ababab'
        W = '<unset>'
        SUBJ ? POS(0) ARBNO(('a' 'b') . W) RPOS(0)             :F(NO)
        OUTPUT = '=S'                                   :(EN)
NO      OUTPUT = '=F'
EN      OUTPUT = 'W=' W
END
