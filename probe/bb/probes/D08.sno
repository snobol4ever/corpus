*  D08 [D] LEN(*N), N set DURING the match (manual)
*  subject: '12ABCDEFGHIJKLMNOPQ'
*  pattern: SPAN('0123456789') $ N LEN(*N) . FIELD

        SUBJ = '12ABCDEFGHIJKLMNOPQ'
        FIELD = '<unset>'
        SUBJ ? SPAN('0123456789') $ N LEN(*N) . FIELD          :F(NO)
        OUTPUT = '=S'                                   :(EN)
NO      OUTPUT = '=F'
EN      OUTPUT = 'N=' N
        OUTPUT = 'FIELD=' FIELD
END
