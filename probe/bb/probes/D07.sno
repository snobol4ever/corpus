*  D07 [D] LEN(*N), N fixed before the match
*  subject: 'abcdef'
*  pattern: POS(0) LEN(*N) . OUTPUT

        SUBJ = 'abcdef'
        N = 3
        SUBJ ? POS(0) LEN(*N) . OUTPUT                         :F(NO)
        OUTPUT = '=S'                                   :(EN)
NO      OUTPUT = '=F'
EN
END
