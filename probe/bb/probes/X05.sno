*  X05 [X] nested ARBNO, . in inner + . on outer
*  subject: '(ab)(c)'
*  pattern: POS(0) ARBNO(('(' ARBNO(NOTANY(')') . I) ')') . O) RPOS(0)

        SUBJ = '(ab)(c)'
        I = '<unset>'
        O = '<unset>'
        SUBJ ? POS(0) ARBNO(('(' ARBNO(NOTANY(')') . I) ')') . O) RPOS(0) :F(NO)
        OUTPUT = '=S'                                   :(EN)
NO      OUTPUT = '=F'
EN      OUTPUT = 'I=' I
        OUTPUT = 'O=' O
END
