*  N16 [N] ARBNO(*)ALT FULL (case 1)
*  subject: 'BlueGoldBirdFish'
*  pattern: (POS(0) ARBNO('Bird' | 'Blue' | LEN(1)) $ OUTPUT RPOS(0)) $ OUTPUT

        SUBJ = 'BlueGoldBirdFish'
        SUBJ ? (POS(0) ARBNO('Bird' | 'Blue' | LEN(1)) $ OUTPUT RPOS(0)) $ OUTPUT :F(NO)
        OUTPUT = '=S'                                   :(EN)
NO      OUTPUT = '=F'
EN
END
