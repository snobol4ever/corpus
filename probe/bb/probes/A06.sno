*  A06 [A] ALT3 capture INSIDE every arm
*  subject: 'xycd'
*  pattern: POS(0) ('ab' . W | 'xy' . W | 'pq' . W)

        SUBJ = 'xycd'
        W = '<unset>'
        SUBJ ? POS(0) ('ab' . W | 'xy' . W | 'pq' . W)         :F(NO)
        OUTPUT = '=S'                                   :(EN)
NO      OUTPUT = '=F'
EN      OUTPUT = 'W=' W
END
