*  X07 [X] manual LIST: ITEM ARBNO(',' ITEM)
*  subject: '(12,345,6)'
*  pattern: POS(0) '(' ITEM ARBNO(',' ITEM) ')' RPOS(0)

        SUBJ = '(12,345,6)'
        ITEM = SPAN('0123456789')
        SUBJ ? POS(0) '(' ITEM ARBNO(',' ITEM) ')' RPOS(0)     :F(NO)
        OUTPUT = '=S'                                   :(EN)
NO      OUTPUT = '=F'
EN
END
