*  X11 [X] nested ARBNO + capture on inner ARBNO
*  subject: '(ab)(c)'
*  pattern: POS(0) ARBNO('(' ARBNO(NOTANY(')')) . G ')') RPOS(0)

        SUBJ = '(ab)(c)'
        G = '<unset>'
        SUBJ ? POS(0) ARBNO('(' ARBNO(NOTANY(')')) . G ')') RPOS(0) :F(NO)
        OUTPUT = '=S'                                   :(EN)
NO      OUTPUT = '=F'
EN      OUTPUT = 'G=' G
END
