*  F04 [F] . behind a FENCE, match succeeds
*  subject: 'ab'
*  pattern: ('a' . Y) FENCE 'b'

        SUBJ = 'ab'
        Y = '<unset>'
        SUBJ ? ('a' . Y) FENCE 'b'                             :F(NO)
        OUTPUT = '=S'                                   :(EN)
NO      OUTPUT = '=F'
EN      OUTPUT = 'Y=' Y
END
