        &TRIM = 1
        &ANCHOR = 0
        DEFINE('F(N)')  :(E)
F       F = EQ(N, 0) 0  :S(RETURN)
        F = N + F(N - 1)  :(RETURN)
E       P = BREAK(',') . W ','
        D = '10,20,'
        T = TABLE(16)
        I = 0
L       LT(I, 2)  :F(Z)
        I = I + 1
        T[I] = I  :(L)
Z       OUTPUT = "tot: " (T[1] + T[2])
END
