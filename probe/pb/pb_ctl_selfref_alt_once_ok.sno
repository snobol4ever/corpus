*  ============================================================================
*  CONTROL for the PB-1s per-site snapshot class (s107).  GREEN -- must stay green.
*  Each control removes exactly ONE ingredient from pb_selfref_alt_cycle.sno.
*  ============================================================================
*  INGREDIENT REMOVED: the second execution.  One pass through the site leaves
*  PAT$1$V0 holding LEN(0), which does not defer to PAT$1$V0 => no cycle.
        mk = LEN(0)
        n = 0
LP      n = n + 1
        mk = mk ('X' | 'y')
        LT(n,1)                         :S(LP)
        'X' mk                          :F(NO)
        OUTPUT = 'MATCHED once'         :(FIN)
NO      OUTPUT = 'NOMATCH once'
FIN
END
