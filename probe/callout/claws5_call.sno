* claws5_call -- ABLATION POINT D (FINDING s199 ladder): claws5_cap.sno (point B, sibling in this
* directory) plus exactly ONE more ingredient, a match-time deferred callout `. *token()` whose
* WHOLE body is a counter bump and :(NRETURN) -- no table, no work.  This isolates PURE ENTRY/EXIT
* overhead of a match-time deferred callout: row `callout-fragment-entry-cost` (s199 measured
* 2.66x SPITBOL on this shape, 6.5% of full claws5.sno's total).  Deliberately NO FENCE: the ladder
* adds one ingredient per step and a bare counter bump has no side effect worth protecting from
* backtrack (unlike claws5.sno's real `token()`, which mutates a shared `mem` table and needs
* FENCE for determinism) -- see claws5_cap.sno's header for the same reasoning applied to captures.
* ZTOK is primed once at top level, outside ZBODY's K-loop, so the per-iteration hot path asm-diffs
* against claws5_cap.sno with NOTHING added except the callout itself.
* input: claws5.dat on stdin (runner redirects <family>.dat).  check = SIZE(ZSRC), same contract as
* claws5_cap.sno/claws5-match.sno -- A/B/D stay check-comparable, only C (the table build) differs.
        ZTOK    =   0
        DEFINE('token()')                               :(token_end)
token   ZTOK    =   ZTOK + 1
        token   =   .dummy                              :(NRETURN)
token_end
        &TRIM   =   0
        claws   =   POS(0)
+                   ARBNO(
+                     ( (SPAN('0123456789') . num) '_CRD :_PUN'
+                     | (NOTANY('_') BREAK('_')) . wrd
+                       '_'
+                       (ANY(&UCASE) SPAN('0123456789' &UCASE)) . tag . *token()
+                     )
+                     SPAN(' ' CHAR(10))
+                   )
+                   RPOS(0)
        &STLIMIT =  -1
        ZCHK    =   1
        ZBUD    =   1000
        ZFLR    =   20
        INPUT(.INPUT, 9, '[-f0 -r4194304]')
        ZSRC    =   INPUT
        DEFINE('ZBODY(ZKN)')                            :(ZBODY_END)
ZBODY   ZI      =   1
ZBL     ZSRC    ?   claws                               :F(ZBAD)
        ZI      =   LT(ZI, ZKN) ZI + 1                  :S(ZBL)
        ZBODY   =   SIZE(ZSRC)                          :(RETURN)
ZBAD    ZBODY   =   'MATCH-FAILED'                      :(RETURN)
ZBODY_END
-INCLUDE '../../benchmarks/snobol4/harness.inc'
