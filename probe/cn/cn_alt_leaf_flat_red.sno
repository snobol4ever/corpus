*  CN-15 / s170 -- THE ALT-ARM CRASH HAS NOTHING TO DO WITH CONSTANTS.  No &constant, no
*  substitution, no nesting: twenty ordinary assignments, then one alternation whose arms
*  hold a SCRATCH-CELL LEAF (SPAN).  A leaf on an ALT arm addresses its suspension cell at
*  a RAW FLAT ZLS COORDINATE off rsp (LFC legacy arm, x86_asm.h:1216); the padding pushes
*  that coordinate past the live frame, so the box writes into the process argv/envp array
*  above the stack and libc dies the next time it walks environ -- getenv("SCRIP_DCAP_TRACE")
*  inside c_rt_dcap_end_ok_open at match end, far from the cause.
*  MEASURED s170: default arm m3 PASS / m4 rc=139.  SCRIP_SPAN_FRAME=1: PASS both media.
*  This is the s130/s131 LEAF-SUSPENSION class (probe/clobarm, probe/leafsib), not a CN defect.
	V1 = "pad1"
	V2 = "pad2"
	V3 = "pad3"
	V4 = "pad4"
	V5 = "pad5"
	V6 = "pad6"
	V7 = "pad7"
	V8 = "pad8"
	V9 = "pad9"
	V10 = "pad10"
	V11 = "pad11"
	V12 = "pad12"
	V13 = "pad13"
	V14 = "pad14"
	V15 = "pad15"
	V16 = "pad16"
	V17 = "pad17"
	V18 = "pad18"
	V19 = "pad19"
	V20 = "pad20"
	"ab" POS(0) (SPAN("ab") | SPAN("09")) RPOS(0)	:S(Y)F(N)
Y	OUTPUT = "match"	:(END)
N	OUTPUT = "nomatch"
END
