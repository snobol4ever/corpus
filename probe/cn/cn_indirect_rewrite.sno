*  CN / the $() INDIRECT LAW, HALF TWO -- AN &-NAMED INDIRECT VARIABLE IS REWRITABLE.
*  Sibling of cn_indirect_is_ordinary_var.sno, which proved the two namespaces are
*  DISJOINT but wrote each indirect cell exactly ONCE -- so it could not see the seal
*  SCRIP used to stamp on any NV entry whose name began with '&'.  That seal made the
*  FIRST indirect write silent (oracle-true, and green) and the SECOND raise error 341.
*  Measured on live x64 sbl, this file's .ref is its verbatim output:
*    w1/w2/w3   three successive indirect writes to the same &-name are ALL accepted
*    dt         the cell keeps an ordinary datatype -- it is a variable, not a keyword
*    anch-*     two indirect writes to '&ANCHOR' leave the KEYWORD reading 1 throughout
*    via-var    $N where N holds the &-name reaches the same ordinary cell
*  Together with the sibling this is the whole ruling: $('&X') is an ordinary variable
*  spelled "&X", in a namespace wholly disjoint from the keyword &X, in BOTH directions
*  and for EVERY store, not just the first.
	$('&ZED') = 1
	OUTPUT = 'w1=[' $('&ZED') ']'
	$('&ZED') = 2
	OUTPUT = 'w2=[' $('&ZED') ']'
	$('&ZED') = 3
	OUTPUT = 'w3=[' $('&ZED') ']'
	OUTPUT = 'dt=' DATATYPE($('&ZED'))
	&ANCHOR = 1
	$('&ANCHOR') = 'X1'
	$('&ANCHOR') = 'X2'
	OUTPUT = 'anch-indirect=[' $('&ANCHOR') ']'
	OUTPUT = 'anch-direct=' &ANCHOR
	N = '&ZED'
	OUTPUT = 'via-var=[' $N ']'
	OUTPUT = 'reached-end'
END
