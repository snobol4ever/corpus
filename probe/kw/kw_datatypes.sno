*  KW-1 witness: the DATATYPE of every protected repository keyword.
*  SNOBOL4 has NO cset datatype -- &UCASE/&LCASE/&ALPHABET are STRINGs.
	OUTPUT = 'ALPHABET=' DATATYPE(&ALPHABET) ' ' SIZE(&ALPHABET)
	OUTPUT = 'UCASE=' DATATYPE(&UCASE) ' ' SIZE(&UCASE)
	OUTPUT = 'LCASE=' DATATYPE(&LCASE) ' ' SIZE(&LCASE)
	OUTPUT = 'ARB=' DATATYPE(&ARB)
	OUTPUT = 'BAL=' DATATYPE(&BAL)
	OUTPUT = 'REM=' DATATYPE(&REM)
	OUTPUT = 'FAIL=' DATATYPE(&FAIL)
	OUTPUT = 'FENCE=' DATATYPE(&FENCE)
	OUTPUT = 'ABORT=' DATATYPE(&ABORT)
	OUTPUT = 'SUCCEED=' DATATYPE(&SUCCEED)
	OUTPUT = 'RTNTYPE=' DATATYPE(&RTNTYPE)
	OUTPUT = 'STCOUNT=' DATATYPE(&STCOUNT)
	OUTPUT = 'UCASE-val=' &UCASE
	OUTPUT = 'LCASE-val=' &LCASE
END
