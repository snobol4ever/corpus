*  KW-1 witness: bare (unprefixed) keyword names are ORDINARY VARIABLES.
*  Manual Ch.16 p.187: "Their names are set apart from other variables by
*  the unary operator ampersand (&)."  A bare name therefore has NO keyword
*  meaning and reads as the null string until the program assigns it.
	OUTPUT = '[' STCOUNT ']'
	OUTPUT = '[' STNO ']'
	OUTPUT = '[' STLIMIT ']'
	OUTPUT = '[' ANCHOR ']'
	OUTPUT = '[' TRIM ']'
	OUTPUT = '[' FULLSCAN ']'
	OUTPUT = '[' CASE ']'
	OUTPUT = '[' MAXLNGTH ']'
	OUTPUT = '[' FTRACE ']'
	OUTPUT = '[' TRACE ']'
	OUTPUT = '[' ERRLIMIT ']'
	OUTPUT = '[' CODE ']'
	OUTPUT = '[' FNCLEVEL ']'
	OUTPUT = '[' RTNTYPE ']'
	OUTPUT = 'DT-STCOUNT=' DATATYPE(STCOUNT)
	OUTPUT = 'DT-ANCHOR=' DATATYPE(ANCHOR)
*  a bare name is assignable like any variable, and assigning it must NOT
*  disturb the keyword of the same name
	ANCHOR = 'mine'
	OUTPUT = 'bare-after-assign=[' ANCHOR ']'
	OUTPUT = 'kw-still=' &ANCHOR
END
