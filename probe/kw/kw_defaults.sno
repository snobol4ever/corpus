*  KW-1 witness: initial values of every SNOBOL4 keyword (manual Ch.16).
*  These are the values the KW-STATIC .data block must be born holding.
	OUTPUT = 'ANCHOR=' &ANCHOR
	OUTPUT = 'TRIM=' &TRIM
	OUTPUT = 'CASE=' &CASE
	OUTPUT = 'CODE=' &CODE
	OUTPUT = 'DUMP=' &DUMP
	OUTPUT = 'ERRLIMIT=' &ERRLIMIT
	OUTPUT = 'ERRTYPE=' &ERRTYPE
	OUTPUT = 'FTRACE=' &FTRACE
	OUTPUT = 'FULLSCAN=' &FULLSCAN
	OUTPUT = 'MAXLNGTH=' &MAXLNGTH
	OUTPUT = 'STLIMIT=' &STLIMIT
	OUTPUT = 'TRACE=' &TRACE
	OUTPUT = 'ABEND=' &ABEND
	OUTPUT = 'INPUT=' &INPUT
	OUTPUT = 'OUTPUT=' &OUTPUT
	OUTPUT = 'PROFILE=' &PROFILE
	OUTPUT = 'COMPARE=' &COMPARE
	OUTPUT = 'FNCLEVEL=' &FNCLEVEL
	OUTPUT = 'RTNTYPE=[' &RTNTYPE ']'
	OUTPUT = 'ERRTEXT=[' &ERRTEXT ']'
END
