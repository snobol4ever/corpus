*  OPSYN's THIRD ARGUMENT IS A KIND SELECTOR, NOT AN ARITY (manual v3.7 p.116, p.234-235).
*  0/omitted = FUNCTION synonym; 1 = s1 must be an UNUSED UNARY operator (! # % / = |);
*  ANY OTHER NON-ZERO = s1 must be an UNUSED BINARY operator (# % & @ ~) -- the SIL adds
*  the undefined-binop count to i and compares against the undefined-unop count, so only
*  i=1 reaches the unary table and i=2,3,99 all reach the binary one (v37.min s$ops).
*  &ERRLIMIT converts each error to statement failure so the codes are PINNABLE: an
*  unconverted OPSYN error prints a SPITBOL dump no .ref may honestly carry.
        &ERRLIMIT = 20
        OPSYN('STRLEN', 'SIZE', 1)              :F(B1)
        OUTPUT = 'fn-name i=1        accepted'  :(N1)
B1      OUTPUT = 'fn-name i=1        ' &ERRTYPE
N1      OPSYN('SUM', '+', 2)                    :F(B2)
        OUTPUT = 'fn-name i=2        accepted'  :(N2)
B2      OUTPUT = 'fn-name i=2        ' &ERRTYPE
N2      OPSYN('+', 'SIZE', 2)                   :F(B3)
        OUTPUT = 'used-op i=2        accepted'  :(N3)
B3      OUTPUT = 'used-op i=2        ' &ERRTYPE
N3      OPSYN('&', 'DIFFER', 2)                 :F(B4)
        OUTPUT = 'unused-bin & i=2   accepted'  :(N4)
B4      OUTPUT = 'unused-bin & i=2   ' &ERRTYPE
N4      OPSYN('!', 'SIZE', 1)                   :F(B5)
        OUTPUT = 'unused-un ! i=1    accepted'  :(N5)
B5      OUTPUT = 'unused-un ! i=1    ' &ERRTYPE
N5      OPSYN('@', 'SIZE', 3)                   :F(B6)
        OUTPUT = 'unused-bin @ i=3   accepted'  :(N6)
B6      OUTPUT = 'unused-bin @ i=3   ' &ERRTYPE
N6      OPSYN('&', 'SIZE', 1)                   :F(B7)
        OUTPUT = 'bin-op as i=1      accepted'  :(N7)
B7      OUTPUT = 'bin-op as i=1      ' &ERRTYPE
N7      OPSYN('~', 'SIZE', 'zz')                :F(B8)
        OUTPUT = 'i not integer      accepted'  :(N8)
B8      OUTPUT = 'i not integer      ' &ERRTYPE
N8      OPSYN('~', 'SIZE', -1)                  :F(B9)
        OUTPUT = 'i negative         accepted'  :(N9)
B9      OUTPUT = 'i negative         ' &ERRTYPE
N9      OPSYN('~', 'SIZE', 16777216)            :F(B10)
        OUTPUT = 'i = 2**24          accepted'  :(N10)
B10     OUTPUT = 'i = 2**24          ' &ERRTYPE
N10     OPSYN('~', 'SIZE', 16777217)            :F(B11)
        OUTPUT = 'i = 2**24 + 1      accepted'  :(N11)
B11     OUTPUT = 'i = 2**24 + 1      ' &ERRTYPE
N11     OPSYN('%', 'SIZE', '2')                 :F(B12)
        OUTPUT = 'i numeral string   accepted'  :(N12)
B12     OUTPUT = 'i numeral string   ' &ERRTYPE
N12     OPSYN('#', 'SIZE', 2.7)                 :F(B13)
        OUTPUT = 'i real 2.7         accepted'  :(END)
B13     OUTPUT = 'i real 2.7         ' &ERRTYPE
END
