*  math_remdr_real - .cmth extends REMDR to reals in the SAME sentence as the 8 functions
*  SPITBOL extended math (.cmth, sbl.min:1658).  Returns REAL always; INT/REAL/STRING args all coerce.
*  .ref is LIVE ORACLE output (x64 sbl -bf), not SCRIP output.
*  (sbl.min:260).  Either operand real yields a REAL result; int/int stays INTEGER.
	OUTPUT = REMDR(7,3) " " DATATYPE(REMDR(7,3))
	OUTPUT = REMDR(7.5,2.0) " " DATATYPE(REMDR(7.5,2.0))
	OUTPUT = REMDR(7,2.0)
	OUTPUT = REMDR(7.5,2)
	OUTPUT = REMDR(-7.5,2.0)
	OUTPUT = REMDR("7.5","2.0")
END
