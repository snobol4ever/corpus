{"at": [1, 3, 26], "act": "rename", "new": "Steps", "expect": {"cells": ["function Steps(n, c) {\n    c = 0;\n    while (NE(n, 1)) {\n        if (EQ(REMDR(n, 2), 0)) { n = n / 2; } else { n = 3 * n + 1; }\n        c = c + 1;\n    }\n    Steps = c; return;\n}\nfunction IsEven(n) {\n    if (EQ(n, 0)) return;\n    if (IsOdd(n - 1)) return;\n    freturn;\n}\nfunction IsOdd(n) {\n    if (EQ(n, 0)) freturn;\n    if (IsEven(n - 1)) return;\n    freturn;\n}", "i = 1;\nwhile (LE(i, 10)) {\n    OUTPUT = i ' takes ' Steps(i) ' steps';\n    i = i + 1;\n}", "best = 0;\nat = 0;\ni = 1;\nwhile (LT(i, 30)) {\n    c = Steps(i);\n    if (GT(c, best)) { best = c; at = i; }\n    i = i + 1;\n}\nOUTPUT = 'longest below 30: ' at ' with ' best ' steps';\nif (IsEven(6)) { OUTPUT = '6 is even'; }\nif (IsOdd(7)) { OUTPUT = '7 is odd'; }"]}}
{"at": [2, 1, 1], "act": "rename", "new": "most", "expect": {"cells": ["function Collatz(n, c) {\n    c = 0;\n    while (NE(n, 1)) {\n        if (EQ(REMDR(n, 2), 0)) { n = n / 2; } else { n = 3 * n + 1; }\n        c = c + 1;\n    }\n    Collatz = c; return;\n}\nfunction IsEven(n) {\n    if (EQ(n, 0)) return;\n    if (IsOdd(n - 1)) return;\n    freturn;\n}\nfunction IsOdd(n) {\n    if (EQ(n, 0)) freturn;\n    if (IsEven(n - 1)) return;\n    freturn;\n}", "i = 1;\nwhile (LE(i, 10)) {\n    OUTPUT = i ' takes ' Collatz(i) ' steps';\n    i = i + 1;\n}", "most = 0;\nat = 0;\ni = 1;\nwhile (LT(i, 30)) {\n    c = Collatz(i);\n    if (GT(c, most)) { most = c; at = i; }\n    i = i + 1;\n}\nOUTPUT = 'longest below 30: ' at ' with ' most ' steps';\nif (IsEven(6)) { OUTPUT = '6 is even'; }\nif (IsOdd(7)) { OUTPUT = '7 is odd'; }"]}}
{"at": [0, 11, 9], "act": "rename", "new": "OddQ", "expect": {"cells": ["function Collatz(n, c) {\n    c = 0;\n    while (NE(n, 1)) {\n        if (EQ(REMDR(n, 2), 0)) { n = n / 2; } else { n = 3 * n + 1; }\n        c = c + 1;\n    }\n    Collatz = c; return;\n}\nfunction IsEven(n) {\n    if (EQ(n, 0)) return;\n    if (OddQ(n - 1)) return;\n    freturn;\n}\nfunction OddQ(n) {\n    if (EQ(n, 0)) freturn;\n    if (IsEven(n - 1)) return;\n    freturn;\n}", "i = 1;\nwhile (LE(i, 10)) {\n    OUTPUT = i ' takes ' Collatz(i) ' steps';\n    i = i + 1;\n}", "best = 0;\nat = 0;\ni = 1;\nwhile (LT(i, 30)) {\n    c = Collatz(i);\n    if (GT(c, best)) { best = c; at = i; }\n    i = i + 1;\n}\nOUTPUT = 'longest below 30: ' at ' with ' best ' steps';\nif (IsEven(6)) { OUTPUT = '6 is even'; }\nif (OddQ(7)) { OUTPUT = '7 is odd'; }"]}}
