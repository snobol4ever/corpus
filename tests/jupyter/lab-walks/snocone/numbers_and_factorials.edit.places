{"at": [2, 5, 9], "act": "rename", "new": "IsPrimeX", "expect": {"cells": ["function GCD(a, b, t) {\n    while (DIFFER(b, 0)) { t = b; b = REMDR(a, b); a = t; }\n    GCD = a; return;\n}\nfunction IsPrimeX(n, i, lim) {\n    if (LE(n, 1)) freturn;\n    i = 2;\n    while (LE(i * i, n)) {\n        if (EQ(REMDR(n, i), 0)) freturn;\n        i = i + 1;\n    }\n    return;\n}\nfunction Fact(n) {\n    if (LE(n, 1)) { Fact = 1; return; }\n    Fact = n * Fact(n - 1);\n    return;\n}\n", "facts = TABLE();\ni = 0;\nwhile (LT(i, 6)) {\n    i = i + 1;\n    facts[i] = Fact(i);\n    OUTPUT = i '! = ' facts[i];\n}\n", "n = 0;\ncount = 0;\nwhile (LT(n, 30)) {\n    n = n + 1;\n    if (IsPrimeX(n)) { count = count + 1; OUTPUT = n ' is prime'; }\n}\nOUTPUT = count ' primes, gcd(' facts[5] ', ' facts[4] ') = ' GCD(facts[5], facts[4]);\n"]}}
{"at": [2, 2, 1], "act": "rename", "new": "total", "expect": {"cells": ["function GCD(a, b, t) {\n    while (DIFFER(b, 0)) { t = b; b = REMDR(a, b); a = t; }\n    GCD = a; return;\n}\nfunction IsPrime(n, i, lim) {\n    if (LE(n, 1)) freturn;\n    i = 2;\n    while (LE(i * i, n)) {\n        if (EQ(REMDR(n, i), 0)) freturn;\n        i = i + 1;\n    }\n    return;\n}\nfunction Fact(n) {\n    if (LE(n, 1)) { Fact = 1; return; }\n    Fact = n * Fact(n - 1);\n    return;\n}\n", "facts = TABLE();\ni = 0;\nwhile (LT(i, 6)) {\n    i = i + 1;\n    facts[i] = Fact(i);\n    OUTPUT = i '! = ' facts[i];\n}\n", "n = 0;\ntotal = 0;\nwhile (LT(n, 30)) {\n    n = n + 1;\n    if (IsPrime(n)) { total = total + 1; OUTPUT = n ' is prime'; }\n}\nOUTPUT = total ' primes, gcd(' facts[5] ', ' facts[4] ') = ' GCD(facts[5], facts[4]);\n"]}}
{"at": [1, 1, 1], "act": "rename", "new": "memo", "expect": {"cells": ["function GCD(a, b, t) {\n    while (DIFFER(b, 0)) { t = b; b = REMDR(a, b); a = t; }\n    GCD = a; return;\n}\nfunction IsPrime(n, i, lim) {\n    if (LE(n, 1)) freturn;\n    i = 2;\n    while (LE(i * i, n)) {\n        if (EQ(REMDR(n, i), 0)) freturn;\n        i = i + 1;\n    }\n    return;\n}\nfunction Fact(n) {\n    if (LE(n, 1)) { Fact = 1; return; }\n    Fact = n * Fact(n - 1);\n    return;\n}\n", "memo = TABLE();\ni = 0;\nwhile (LT(i, 6)) {\n    i = i + 1;\n    memo[i] = Fact(i);\n    OUTPUT = i '! = ' memo[i];\n}\n", "n = 0;\ncount = 0;\nwhile (LT(n, 30)) {\n    n = n + 1;\n    if (IsPrime(n)) { count = count + 1; OUTPUT = n ' is prime'; }\n}\nOUTPUT = count ' primes, gcd(' memo[5] ', ' memo[4] ') = ' GCD(memo[5], memo[4]);\n"]}}
