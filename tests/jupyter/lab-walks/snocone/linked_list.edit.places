{"at": [1, 3, 27], "act": "rename", "new": "Cons", "expect": {"cells": ["struct node { val, link }\nfunction Cons(l, v) { Cons = node(v, l); return; }\nfunction Length(l, c) {\n    c = 0;\n    while (DIFFER(l)) { c = c + 1; l = link(l); }\n    Length = c; return;\n}\nfunction Sum(l, s) {\n    s = 0;\n    while (DIFFER(l)) { s = s + val(l); l = link(l); }\n    Sum = s; return;\n}\nfunction Show(l, s) {\n    s = '';\n    while (DIFFER(l)) { s = s val(l) ' '; l = link(l); }\n    Show = s; return;\n}\nfunction Reverse(l, r, nx) {\n    while (DIFFER(l)) { nx = link(l); link(l) = r; r = l; l = nx; }\n    Reverse = r; return;\n}", "list = ;\ni = 1;\nwhile (LE(i, 5)) { list = Cons(list, i * i); i = i + 1; }\nOUTPUT = 'list: ' Show(list);\nOUTPUT = 'length ' Length(list) ', sum ' Sum(list);", "rev = Reverse(list);\nOUTPUT = 'reversed: ' Show(rev);\nOUTPUT = 'length ' Length(rev) ', sum ' Sum(rev);"]}}
{"at": [1, 1, 1], "act": "rename", "new": "items", "expect": {"cells": ["struct node { val, link }\nfunction Push(l, v) { Push = node(v, l); return; }\nfunction Length(l, c) {\n    c = 0;\n    while (DIFFER(l)) { c = c + 1; l = link(l); }\n    Length = c; return;\n}\nfunction Sum(l, s) {\n    s = 0;\n    while (DIFFER(l)) { s = s + val(l); l = link(l); }\n    Sum = s; return;\n}\nfunction Show(l, s) {\n    s = '';\n    while (DIFFER(l)) { s = s val(l) ' '; l = link(l); }\n    Show = s; return;\n}\nfunction Reverse(l, r, nx) {\n    while (DIFFER(l)) { nx = link(l); link(l) = r; r = l; l = nx; }\n    Reverse = r; return;\n}", "items = ;\ni = 1;\nwhile (LE(i, 5)) { items = Push(items, i * i); i = i + 1; }\nOUTPUT = 'list: ' Show(items);\nOUTPUT = 'length ' Length(items) ', sum ' Sum(items);", "rev = Reverse(items);\nOUTPUT = 'reversed: ' Show(rev);\nOUTPUT = 'length ' Length(rev) ', sum ' Sum(rev);"]}}
{"at": [2, 2, 23], "act": "rename", "new": "Render", "expect": {"cells": ["struct node { val, link }\nfunction Push(l, v) { Push = node(v, l); return; }\nfunction Length(l, c) {\n    c = 0;\n    while (DIFFER(l)) { c = c + 1; l = link(l); }\n    Length = c; return;\n}\nfunction Sum(l, s) {\n    s = 0;\n    while (DIFFER(l)) { s = s + val(l); l = link(l); }\n    Sum = s; return;\n}\nfunction Render(l, s) {\n    s = '';\n    while (DIFFER(l)) { s = s val(l) ' '; l = link(l); }\n    Render = s; return;\n}\nfunction Reverse(l, r, nx) {\n    while (DIFFER(l)) { nx = link(l); link(l) = r; r = l; l = nx; }\n    Reverse = r; return;\n}", "list = ;\ni = 1;\nwhile (LE(i, 5)) { list = Push(list, i * i); i = i + 1; }\nOUTPUT = 'list: ' Render(list);\nOUTPUT = 'length ' Length(list) ', sum ' Sum(list);", "rev = Reverse(list);\nOUTPUT = 'reversed: ' Render(rev);\nOUTPUT = 'length ' Length(rev) ', sum ' Sum(rev);"]}}
