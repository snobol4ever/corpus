{"at": [1, 3, 1], "act": "rename", "new": "Populate", "expect": {"cells": ["function Populate(a, n, i, x) {\n    x = 5;\n    i = 1;\n    while (LE(i, n)) { x = REMDR(x * 7 + 3, 31); a[i] = x; i = i + 1; }\n}\nfunction Show(a, n, i, s) {\n    s = a[1];\n    i = 2;\n    while (LE(i, n)) { s = s ' ' a[i]; i = i + 1; }\n    Show = s; return;\n}\nfunction Sort(a, n, i, j, t) {\n    i = 2;\n    while (LE(i, n)) {\n        t = a[i];\n        j = i - 1;\n        while (GT(j, 0)) {\n            if (LE(a[j], t)) { break; }\n            a[j + 1] = a[j];\n            j = j - 1;\n        }\n        a[j + 1] = t;\n        i = i + 1;\n    }\n}\nfunction Find(a, n, x, lo, hi, mid) {\n    lo = 1; hi = n;\n    while (LE(lo, hi)) {\n        mid = (lo + hi) / 2;\n        if (EQ(a[mid], x)) { Find = mid; return; }\n        if (LT(a[mid], x)) { lo = mid + 1; } else { hi = mid - 1; }\n    }\n    freturn;\n}", "n = 8;\na = ARRAY(n);\nPopulate(a, n);\nOUTPUT = 'before: ' Show(a, n);\nSort(a, n);\nOUTPUT = 'after:  ' Show(a, n);", "x = a[3];\nOUTPUT = 'find ' x ' at ' Find(a, n, x);\nif (Find(a, n, 99)) { OUTPUT = 'find 99 found'; } else { OUTPUT = 'find 99 not found'; }"]}}
{"at": [1, 2, 1], "act": "rename", "new": "arr", "expect": {"cells": ["function Fill(a, n, i, x) {\n    x = 5;\n    i = 1;\n    while (LE(i, n)) { x = REMDR(x * 7 + 3, 31); a[i] = x; i = i + 1; }\n}\nfunction Show(a, n, i, s) {\n    s = a[1];\n    i = 2;\n    while (LE(i, n)) { s = s ' ' a[i]; i = i + 1; }\n    Show = s; return;\n}\nfunction Sort(a, n, i, j, t) {\n    i = 2;\n    while (LE(i, n)) {\n        t = a[i];\n        j = i - 1;\n        while (GT(j, 0)) {\n            if (LE(a[j], t)) { break; }\n            a[j + 1] = a[j];\n            j = j - 1;\n        }\n        a[j + 1] = t;\n        i = i + 1;\n    }\n}\nfunction Find(a, n, x, lo, hi, mid) {\n    lo = 1; hi = n;\n    while (LE(lo, hi)) {\n        mid = (lo + hi) / 2;\n        if (EQ(a[mid], x)) { Find = mid; return; }\n        if (LT(a[mid], x)) { lo = mid + 1; } else { hi = mid - 1; }\n    }\n    freturn;\n}", "n = 8;\narr = ARRAY(n);\nFill(arr, n);\nOUTPUT = 'before: ' Show(arr, n);\nSort(arr, n);\nOUTPUT = 'after:  ' Show(arr, n);", "x = arr[3];\nOUTPUT = 'find ' x ' at ' Find(arr, n, x);\nif (Find(arr, n, 99)) { OUTPUT = 'find 99 found'; } else { OUTPUT = 'find 99 not found'; }"]}}
{"at": [2, 2, 27], "act": "rename", "new": "Locate", "expect": {"cells": ["function Fill(a, n, i, x) {\n    x = 5;\n    i = 1;\n    while (LE(i, n)) { x = REMDR(x * 7 + 3, 31); a[i] = x; i = i + 1; }\n}\nfunction Show(a, n, i, s) {\n    s = a[1];\n    i = 2;\n    while (LE(i, n)) { s = s ' ' a[i]; i = i + 1; }\n    Show = s; return;\n}\nfunction Sort(a, n, i, j, t) {\n    i = 2;\n    while (LE(i, n)) {\n        t = a[i];\n        j = i - 1;\n        while (GT(j, 0)) {\n            if (LE(a[j], t)) { break; }\n            a[j + 1] = a[j];\n            j = j - 1;\n        }\n        a[j + 1] = t;\n        i = i + 1;\n    }\n}\nfunction Locate(a, n, x, lo, hi, mid) {\n    lo = 1; hi = n;\n    while (LE(lo, hi)) {\n        mid = (lo + hi) / 2;\n        if (EQ(a[mid], x)) { Locate = mid; return; }\n        if (LT(a[mid], x)) { lo = mid + 1; } else { hi = mid - 1; }\n    }\n    freturn;\n}", "n = 8;\na = ARRAY(n);\nFill(a, n);\nOUTPUT = 'before: ' Show(a, n);\nSort(a, n);\nOUTPUT = 'after:  ' Show(a, n);", "x = a[3];\nOUTPUT = 'find ' x ' at ' Locate(a, n, x);\nif (Locate(a, n, 99)) { OUTPUT = 'find 99 found'; } else { OUTPUT = 'find 99 not found'; }"]}}
