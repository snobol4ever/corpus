{"at": [1, 3, 1], "act": "rename", "new": "Tally", "expect": {"cells": ["function NextWord(w) {\n    text ? POS(0) SPAN(' ') = '';\n    if (IDENT(text)) freturn;\n    if (text ? POS(0) BREAK(' ') . w = '') { NextWord = w; return; }\n    NextWord = text;\n    text = '';\n    return;\n}\nfunction Tally(words, w, n) {\n    while (w = NextWord()) {\n        n = words[w];\n        if (IDENT(n)) { n = 0; }\n        words[w] = n + 1;\n    }\n}", "text = 'the cat and the dog and the bird sat';\nwords = TABLE();\nTally(words);", "a = SORT(words);\ni = 1;\nwhile (a[i, 1]) {\n    if (GT(a[i, 2], 1)) { OUTPUT = a[i, 1] ' ' a[i, 2]; }\n    i = i + 1;\n}"]}}
{"at": [1, 1, 1], "act": "rename", "new": "input", "expect": {"cells": ["function NextWord(w) {\n    input ? POS(0) SPAN(' ') = '';\n    if (IDENT(input)) freturn;\n    if (input ? POS(0) BREAK(' ') . w = '') { NextWord = w; return; }\n    NextWord = input;\n    input = '';\n    return;\n}\nfunction Count(words, w, n) {\n    while (w = NextWord()) {\n        n = words[w];\n        if (IDENT(n)) { n = 0; }\n        words[w] = n + 1;\n    }\n}", "input = 'the cat and the dog and the bird sat';\nwords = TABLE();\nCount(words);", "a = SORT(words);\ni = 1;\nwhile (a[i, 1]) {\n    if (GT(a[i, 2], 1)) { OUTPUT = a[i, 1] ' ' a[i, 2]; }\n    i = i + 1;\n}"]}}
