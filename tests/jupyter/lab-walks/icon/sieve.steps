# sieve.ipynb, Icon entry (scrip-icon): code cells 0 the sieve, 1 main (the driver counts code cells only). developer_09 2026-11-23. EXPECTED by the program, never copied from a reading: a step in enters the callee at its first executable statement (line 3 of sieve, not its local line 2); the statement of line 7 runs once for each prime i whose turn it is (2 3 5 7 11 13 17 19 below 20, a composite never reaches it); a step over a statement goes to the next statement of the same procedure, the every body being a statement of its own (line 6 is the if of the next i); a step out runs to the caller unless a breakpoint stops it first (the breakpoint at line 7 does, at i = 5).
{"break": [1, 3]}
{"break": [0, 7]}
{"run": 0, "expect": {"stopped": false, "output": ""}}
{"run": 1, "expect": {"cell": 1, "line": 3, "frames": [["main", 3]], "output": ""}}
{"act": "in", "expect": {"cell": 0, "line": 3, "frames": [["sieve", 3], ["main", 3]], "vars": {"n": "20"}}}
{"act": "next", "expect": {"cell": 0, "line": 4, "frames": [["sieve", 4], ["main", 3]]}}
{"act": "next", "expect": {"cell": 0, "line": 5, "frames": [["sieve", 5], ["main", 3]]}}
{"act": "continue", "expect": {"cell": 0, "line": 7, "frames": [["sieve", 7], ["main", 3]], "vars": {"n": "20", "i": "2"}}}
{"act": "next", "expect": {"cell": 0, "line": 6, "vars": {"i": "3"}}}
{"act": "next", "expect": {"cell": 0, "line": 7, "vars": {"i": "3"}}}
{"act": "out", "expect": {"cell": 0, "line": 7, "frames": [["sieve", 7], ["main", 3]], "vars": {"i": "5"}}}
{"act": "continue", "expect": {"cell": 0, "line": 7, "frames": [["sieve", 7], ["main", 3]], "vars": {"i": "7"}}}
{"act": "continue", "expect": {"cell": 0, "line": 7, "frames": [["sieve", 7], ["main", 3]], "vars": {"i": "11"}}}
{"act": "continue", "expect": {"cell": 0, "line": 7, "frames": [["sieve", 7], ["main", 3]], "vars": {"i": "13"}}}
{"act": "continue", "expect": {"cell": 0, "line": 7, "frames": [["sieve", 7], ["main", 3]], "vars": {"i": "17"}}}
{"act": "continue", "expect": {"cell": 0, "line": 7, "frames": [["sieve", 7], ["main", 3]], "vars": {"i": "19"}}}
