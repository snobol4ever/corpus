{"at": [0, 2, 10], "act": "rename", "new": "collatz2", "expect": {"cells": ["# Collatz and Hanoi: loops and recursion\nfunction collatz2(n)\n  local steps\n  steps := 0\n  while n ~= 1 do {\n    if n % 2 = 0 then n := n / 2 else n := 3 * n + 1\n    steps := steps + 1\n  }\n  return steps\nend", "function longest(limit)\n  local i, best, bi, c\n  best := 0\n  bi := 1\n  i := 1\n  while i <= limit do {\n    c := collatz2(i)\n    if c > best then {\n      best := c\n      bi := i\n    }\n    i := i + 1\n  }\n  return bi\nend", "%%rebus\nfunction hanoi(n, src, dst, via)\n  if n = 0 then return 0\n  return hanoi(n - 1, src, via, dst) + 1 + hanoi(n - 1, via, dst, src)\nend\n\nfunction main()\n  OUTPUT := \"collatz 27 \" || collatz2(27)\n  OUTPUT := \"longest under 30 \" || longest(30)\n  OUTPUT := \"hanoi 5 \" || hanoi(5, \"a\", \"c\", \"b\")\nend"]}}
{"at": [1, 2, 9], "act": "rename", "new": "i2", "expect": {"cells": ["# Collatz and Hanoi: loops and recursion\nfunction collatz(n)\n  local steps\n  steps := 0\n  while n ~= 1 do {\n    if n % 2 = 0 then n := n / 2 else n := 3 * n + 1\n    steps := steps + 1\n  }\n  return steps\nend", "function longest(limit)\n  local i2, best, bi, c\n  best := 0\n  bi := 1\n  i2 := 1\n  while i2 <= limit do {\n    c := collatz(i2)\n    if c > best then {\n      best := c\n      bi := i2\n    }\n    i2 := i2 + 1\n  }\n  return bi\nend", "%%rebus\nfunction hanoi(n, src, dst, via)\n  if n = 0 then return 0\n  return hanoi(n - 1, src, via, dst) + 1 + hanoi(n - 1, via, dst, src)\nend\n\nfunction main()\n  OUTPUT := \"collatz 27 \" || collatz(27)\n  OUTPUT := \"longest under 30 \" || longest(30)\n  OUTPUT := \"hanoi 5 \" || hanoi(5, \"a\", \"c\", \"b\")\nend"]}}
