{"at": [2, 8, 8], "act": "rename", "new": "pt", "expect": {"cells": ["record pt(x, y)\n\nfunction sqdist(p, q)\n  local dx, dy\n  dx := x(p) - x(q)\n  dy := y(p) - y(q)\n  return dx * dx + dy * dy\nend", "function sortpoints(a, n)\n  local i, j, t\n  i := 1\n  while i < n do {\n    j := 1\n    while j <= n - i do {\n      if x(a[j]) > x(a[j + 1]) then {\n        t := a[j]\n        a[j] := a[j + 1]\n        a[j + 1] := t\n      }\n      j := j + 1\n    }\n    i := i + 1\n  }\n  return a\nend", "function main()\n  local pts, k, o\n  pts := ARRAY(4)\n  pts[1] := pt(5, 1)\n  pts[2] := pt(2, 7)\n  pts[3] := pt(9, 3)\n  pts[4] := pt(1, 1)\n  o := pt(0, 0)\n  pts := sortpoints(pts, 4)\n  k := 1\n  while k <= 4 do {\n    OUTPUT := x(pts[k]) || \",\" || y(pts[k]) || \" \" || sqdist(pts[k], o)\n    k := k + 1\n  }\nend"]}}
{"at": [2, 12, 55], "act": "rename", "new": "dist2", "expect": {"cells": ["record point(x, y)\n\nfunction dist2(p, q)\n  local dx, dy\n  dx := x(p) - x(q)\n  dy := y(p) - y(q)\n  return dx * dx + dy * dy\nend", "function sortpoints(a, n)\n  local i, j, t\n  i := 1\n  while i < n do {\n    j := 1\n    while j <= n - i do {\n      if x(a[j]) > x(a[j + 1]) then {\n        t := a[j]\n        a[j] := a[j + 1]\n        a[j + 1] := t\n      }\n      j := j + 1\n    }\n    i := i + 1\n  }\n  return a\nend", "function main()\n  local pts, k, o\n  pts := ARRAY(4)\n  pts[1] := point(5, 1)\n  pts[2] := point(2, 7)\n  pts[3] := point(9, 3)\n  pts[4] := point(1, 1)\n  o := point(0, 0)\n  pts := sortpoints(pts, 4)\n  k := 1\n  while k <= 4 do {\n    OUTPUT := x(pts[k]) || \",\" || y(pts[k]) || \" \" || dist2(pts[k], o)\n    k := k + 1\n  }\nend"]}}
{"at": [0, 7, 15], "act": "rename", "new": "ddx", "expect": {"cells": ["record point(x, y)\n\nfunction sqdist(p, q)\n  local ddx, dy\n  ddx := x(p) - x(q)\n  dy := y(p) - y(q)\n  return ddx * ddx + dy * dy\nend", "function sortpoints(a, n)\n  local i, j, t\n  i := 1\n  while i < n do {\n    j := 1\n    while j <= n - i do {\n      if x(a[j]) > x(a[j + 1]) then {\n        t := a[j]\n        a[j] := a[j + 1]\n        a[j + 1] := t\n      }\n      j := j + 1\n    }\n    i := i + 1\n  }\n  return a\nend", "function main()\n  local pts, k, o\n  pts := ARRAY(4)\n  pts[1] := point(5, 1)\n  pts[2] := point(2, 7)\n  pts[3] := point(9, 3)\n  pts[4] := point(1, 1)\n  o := point(0, 0)\n  pts := sortpoints(pts, 4)\n  k := 1\n  while k <= 4 do {\n    OUTPUT := x(pts[k]) || \",\" || y(pts[k]) || \" \" || sqdist(pts[k], o)\n    k := k + 1\n  }\nend"]}}
