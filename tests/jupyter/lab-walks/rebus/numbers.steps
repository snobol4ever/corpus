{"act": "next", "expect": {"cell": 0, "line": 3, "frames": [["fact", 3], ["fact", 3], ["main", 7]], "vars": {"n": "2"}}}
{"act": "in", "expect": {"cell": 0, "line": 2, "frames": [["fact", 2], ["fact", 3], ["fact", 3], ["main", 7]], "vars": {"n": "1"}}}
{"act": "next", "expect": {"cell": 0, "line": 7, "frames": [["fib", 7], ["main", 7]], "vars": {"n": "3"}}}
{"act": "next", "expect": {"cell": 0, "line": 8, "frames": [["fib", 8], ["main", 7]], "vars": {"n": "3"}}}
{"act": "in", "expect": {"cell": 0, "line": 7, "frames": [["fib", 7], ["fib", 8], ["main", 7]], "vars": {"n": "2"}}}
