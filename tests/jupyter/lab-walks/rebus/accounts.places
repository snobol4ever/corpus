{"at": [2, 12, 10], "act": "rename", "new": "acct", "expect": {"cells": ["record acct(owner, balance)\n\nfunction deposit(a, amt)\n  balance(a) := balance(a) + amt\n  return a\nend", "function withdraw(a, amt)\n  if amt > balance(a) then fail\n  balance(a) := balance(a) - amt\n  return a\nend\n\nfunction report(a)\n  OUTPUT := owner(a) || \" \" || balance(a)\n  return a\nend", "function transfer(src, dst, amt)\n  if withdraw(src, amt) then {\n    deposit(dst, amt)\n    return amt\n  }\n  fail\nend\n\nfunction main()\n  local ann, bob\n  ann := acct(\"ann\", 100)\n  bob := acct(\"bob\", 20)\n  report(ann)\n  report(bob)\n  if transfer(ann, bob, 70) then OUTPUT := \"moved 70\"\n  if transfer(ann, bob, 70) then OUTPUT := \"moved 70 again\" else OUTPUT := \"refused\"\n  report(ann)\n  report(bob)\nend"]}}
{"at": [2, 3, 5], "act": "rename", "new": "put", "expect": {"cells": ["record account(owner, balance)\n\nfunction put(a, amt)\n  balance(a) := balance(a) + amt\n  return a\nend", "function withdraw(a, amt)\n  if amt > balance(a) then fail\n  balance(a) := balance(a) - amt\n  return a\nend\n\nfunction report(a)\n  OUTPUT := owner(a) || \" \" || balance(a)\n  return a\nend", "function transfer(src, dst, amt)\n  if withdraw(src, amt) then {\n    put(dst, amt)\n    return amt\n  }\n  fail\nend\n\nfunction main()\n  local ann, bob\n  ann := account(\"ann\", 100)\n  bob := account(\"bob\", 20)\n  report(ann)\n  report(bob)\n  if transfer(ann, bob, 70) then OUTPUT := \"moved 70\"\n  if transfer(ann, bob, 70) then OUTPUT := \"moved 70 again\" else OUTPUT := \"refused\"\n  report(ann)\n  report(bob)\nend"]}}
{"at": [2, 17, 10], "act": "rename", "new": "amy", "expect": {"cells": ["record account(owner, balance)\n\nfunction deposit(a, amt)\n  balance(a) := balance(a) + amt\n  return a\nend", "function withdraw(a, amt)\n  if amt > balance(a) then fail\n  balance(a) := balance(a) - amt\n  return a\nend\n\nfunction report(a)\n  OUTPUT := owner(a) || \" \" || balance(a)\n  return a\nend", "function transfer(src, dst, amt)\n  if withdraw(src, amt) then {\n    deposit(dst, amt)\n    return amt\n  }\n  fail\nend\n\nfunction main()\n  local amy, bob\n  amy := account(\"ann\", 100)\n  bob := account(\"bob\", 20)\n  report(amy)\n  report(bob)\n  if transfer(amy, bob, 70) then OUTPUT := \"moved 70\"\n  if transfer(amy, bob, 70) then OUTPUT := \"moved 70 again\" else OUTPUT := \"refused\"\n  report(amy)\n  report(bob)\nend"]}}
