{"at": [0, 2, 10], "act": "rename", "new": "rev2", "expect": {"cells": ["# Words: reverse, palindromes and vowels\nfunction rev2(s)\n  local i, r\n  r := \"\"\n  i := size(s)\n  while i >= 1 do {\n    r := r || SUBSTR(s, i, 1)\n    i := i - 1\n  }\n  return r\nend", "function ispal(s)\n  if s == rev2(s) then return s\n  fail\nend\n\nfunction isvowel(c)\n  if c == \"a\" then return 1\n  if c == \"e\" then return 1\n  if c == \"i\" then return 1\n  if c == \"o\" then return 1\n  if c == \"u\" then return 1\n  fail\nend\n\nfunction vowels(s)\n  local i, n, c\n  n := 0\n  i := 1\n  while i <= size(s) do {\n    c := SUBSTR(s, i, 1)\n    if isvowel(c) then n := n + 1\n    i := i + 1\n  }\n  return n\nend", "%%rebus\nfunction main()\n  OUTPUT := rev2(\"stressed\")\n  OUTPUT := vowels(\"encyclopedia\")\n  if ispal(\"level\") then OUTPUT := \"level yes\"\n  if ispal(\"scrip\") then OUTPUT := \"scrip yes\" else OUTPUT := \"scrip no\"\nend"]}}
{"at": [1, 16, 9], "act": "rename", "new": "i2", "expect": {"cells": ["# Words: reverse, palindromes and vowels\nfunction rev(s)\n  local i, r\n  r := \"\"\n  i := size(s)\n  while i >= 1 do {\n    r := r || SUBSTR(s, i, 1)\n    i := i - 1\n  }\n  return r\nend", "function ispal(s)\n  if s == rev(s) then return s\n  fail\nend\n\nfunction isvowel(c)\n  if c == \"a\" then return 1\n  if c == \"e\" then return 1\n  if c == \"i\" then return 1\n  if c == \"o\" then return 1\n  if c == \"u\" then return 1\n  fail\nend\n\nfunction vowels(s)\n  local i2, n, c\n  n := 0\n  i2 := 1\n  while i2 <= size(s) do {\n    c := SUBSTR(s, i2, 1)\n    if isvowel(c) then n := n + 1\n    i2 := i2 + 1\n  }\n  return n\nend", "%%rebus\nfunction main()\n  OUTPUT := rev(\"stressed\")\n  OUTPUT := vowels(\"encyclopedia\")\n  if ispal(\"level\") then OUTPUT := \"level yes\"\n  if ispal(\"scrip\") then OUTPUT := \"scrip yes\" else OUTPUT := \"scrip no\"\nend"]}}
