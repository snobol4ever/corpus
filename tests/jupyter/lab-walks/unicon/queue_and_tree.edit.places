{"at": [1, 1, 13], "act": "rename", "new": "name_x", "expect": {"cells": ["class Queue (items)   # a queue kept in a list\n  method push (item)\n    put (items, item);\n  end\n\n  method take ()\n    return pop (items);\n  end\n\n  method is_empty ()\n    return *items = 0;\n  end\n\n  initially ()\n    items := [];\nend", "record node(name_x, kids)   # a tree node\n\nprocedure build(name, depth)\n   local n, i;\n   n := node(name, []);\n   if depth > 0 then {\n      every i := 1 to 2 do put(n.kids, build(name || i, depth - 1));\n   };\n   return n;\nend\n\nprocedure count(n)\n   local c, k;\n   c := 1;\n   every k := !n.kids do c +:= count(k);\n   return c;\nend", "procedure walk(root)\n   local q, n, k, seen;   # the queue, the node, a kid, the count\n   q := Queue();\n   q.push(root);\n   seen := 0;\n   while not q.is_empty() do {\n      n := q.take();\n      seen +:= 1;\n      write(\"visit \", n.name_x);\n      every k := !n.kids do q.push(k);\n   };\n   return seen;\nend", "procedure main()\n   local t, c, s;\n   t := build(\"n\", 2);\n   c := count(t);\n   write(\"nodes: \", c);\n   s := walk(t);\n   write(\"walked: \", s);\nend"]}}
