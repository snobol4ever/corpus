{"at": [0, 3, 11], "act": "rename", "new": "steps_x", "expect": {"cells": ["global memo   # steps already known\n\nprocedure steps_x (n)\n   local r;   # the steps of this n\n   if n = 1 then\n      return 0;\n   if \\memo[n] then\n      return memo[n];\n   if n % 2 = 0 then\n      r := 1 + steps_x (n / 2)\n   else\n      r := 1 + steps_x (3 * n + 1);\n   memo[n] := r;\n   return r;\nend", "procedure longest (limit)\n   local n, best, s;\n   best := 1;\n   every n := 2 to limit do {\n      s := steps_x (n);\n      if s > steps_x (best) then best := n;\n   };\n   return best;\nend", "procedure main ()\n   local n, best;\n   memo := table ();\n   write (\"steps(6) = \", steps_x (6));\n   every n := 1 to 6 do write (n, \": \", steps_x (n));\n   best := longest (30);\n   write (\"longest under 30: \", best, \" with \", steps_x (best), \" steps\");\n   write (\"memo holds \", *memo);\nend"]}}
{"at": [0, 4, 10], "act": "rename", "new": "r_x", "expect": {"cells": ["global memo   # steps already known\n\nprocedure steps (n)\n   local r_x;   # the steps of this n\n   if n = 1 then\n      return 0;\n   if \\memo[n] then\n      return memo[n];\n   if n % 2 = 0 then\n      r_x := 1 + steps (n / 2)\n   else\n      r_x := 1 + steps (3 * n + 1);\n   memo[n] := r_x;\n   return r_x;\nend", "procedure longest (limit)\n   local n, best, s;\n   best := 1;\n   every n := 2 to limit do {\n      s := steps (n);\n      if s > steps (best) then best := n;\n   };\n   return best;\nend", "procedure main ()\n   local n, best;\n   memo := table ();\n   write (\"steps(6) = \", steps (6));\n   every n := 1 to 6 do write (n, \": \", steps (n));\n   best := longest (30);\n   write (\"longest under 30: \", best, \" with \", steps (best), \" steps\");\n   write (\"memo holds \", *memo);\nend"]}}
{"at": [1, 1, 20], "act": "rename", "new": "limit_x", "expect": {"cells": ["global memo   # steps already known\n\nprocedure steps (n)\n   local r;   # the steps of this n\n   if n = 1 then\n      return 0;\n   if \\memo[n] then\n      return memo[n];\n   if n % 2 = 0 then\n      r := 1 + steps (n / 2)\n   else\n      r := 1 + steps (3 * n + 1);\n   memo[n] := r;\n   return r;\nend", "procedure longest (limit_x)\n   local n, best, s;\n   best := 1;\n   every n := 2 to limit_x do {\n      s := steps (n);\n      if s > steps (best) then best := n;\n   };\n   return best;\nend", "procedure main ()\n   local n, best;\n   memo := table ();\n   write (\"steps(6) = \", steps (6));\n   every n := 1 to 6 do write (n, \": \", steps (n));\n   best := longest (30);\n   write (\"longest under 30: \", best, \" with \", steps (best), \" steps\");\n   write (\"memo holds \", *memo);\nend"]}}
