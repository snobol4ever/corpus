{"at": [0, 1, 8], "act": "rename", "new": "item_x", "expect": {"cells": ["record item_x(name, qty, price)   # one stock line\n\nprocedure add(stock, name, qty, price)\n   if member(stock, name) then\n      stock[name].qty +:= qty\n   else\n      stock[name] := item_x(name, qty, price);\n   return stock[name];\nend\n\nprocedure value(stock)\n   local total, k;   # the value so far, a key\n   total := 0;\n   every k := key(stock) do total +:= stock[k].qty * stock[k].price;\n   return total;\nend\n\nprocedure report(stock)\n   local pairs, p, it;\n   pairs := sort(stock);\n   every p := !pairs do {\n      it := p[2];\n      write(left(it.name, 8), right(it.qty, 5), right(it.price, 4));\n   };\n   return *pairs;\nend\n\nprocedure main()\n   local stock, n;\n   stock := table();\n   add(stock, \"bolt\", 100, 2);\n   add(stock, \"nut\", 250, 1);\n   add(stock, \"gear\", 12, 15);\n   add(stock, \"bolt\", 50, 2);\n   n := report(stock);\n   write(\"items: \", n);\n   write(\"value: \", value(stock));\nend"]}}
{"at": [0, 1, 13], "act": "rename", "new": "name_x", "expect": {"cells": ["record item(name_x, qty, price)   # one stock line\n\nprocedure add(stock, name, qty, price)\n   if member(stock, name) then\n      stock[name].qty +:= qty\n   else\n      stock[name] := item(name, qty, price);\n   return stock[name];\nend\n\nprocedure value(stock)\n   local total, k;   # the value so far, a key\n   total := 0;\n   every k := key(stock) do total +:= stock[k].qty * stock[k].price;\n   return total;\nend\n\nprocedure report(stock)\n   local pairs, p, it;\n   pairs := sort(stock);\n   every p := !pairs do {\n      it := p[2];\n      write(left(it.name_x, 8), right(it.qty, 5), right(it.price, 4));\n   };\n   return *pairs;\nend\n\nprocedure main()\n   local stock, n;\n   stock := table();\n   add(stock, \"bolt\", 100, 2);\n   add(stock, \"nut\", 250, 1);\n   add(stock, \"gear\", 12, 15);\n   add(stock, \"bolt\", 50, 2);\n   n := report(stock);\n   write(\"items: \", n);\n   write(\"value: \", value(stock));\nend"]}}
{"at": [0, 3, 11], "act": "rename", "new": "add_x", "expect": {"cells": ["record item(name, qty, price)   # one stock line\n\nprocedure add_x(stock, name, qty, price)\n   if member(stock, name) then\n      stock[name].qty +:= qty\n   else\n      stock[name] := item(name, qty, price);\n   return stock[name];\nend\n\nprocedure value(stock)\n   local total, k;   # the value so far, a key\n   total := 0;\n   every k := key(stock) do total +:= stock[k].qty * stock[k].price;\n   return total;\nend\n\nprocedure report(stock)\n   local pairs, p, it;\n   pairs := sort(stock);\n   every p := !pairs do {\n      it := p[2];\n      write(left(it.name, 8), right(it.qty, 5), right(it.price, 4));\n   };\n   return *pairs;\nend\n\nprocedure main()\n   local stock, n;\n   stock := table();\n   add_x(stock, \"bolt\", 100, 2);\n   add_x(stock, \"nut\", 250, 1);\n   add_x(stock, \"gear\", 12, 15);\n   add_x(stock, \"bolt\", 50, 2);\n   n := report(stock);\n   write(\"items: \", n);\n   write(\"value: \", value(stock));\nend"]}}
{"at": [0, 3, 15], "act": "rename", "new": "stock_x", "expect": {"cells": ["record item(name, qty, price)   # one stock line\n\nprocedure add(stock_x, name, qty, price)\n   if member(stock_x, name) then\n      stock_x[name].qty +:= qty\n   else\n      stock_x[name] := item(name, qty, price);\n   return stock_x[name];\nend\n\nprocedure value(stock)\n   local total, k;   # the value so far, a key\n   total := 0;\n   every k := key(stock) do total +:= stock[k].qty * stock[k].price;\n   return total;\nend\n\nprocedure report(stock)\n   local pairs, p, it;\n   pairs := sort(stock);\n   every p := !pairs do {\n      it := p[2];\n      write(left(it.name, 8), right(it.qty, 5), right(it.price, 4));\n   };\n   return *pairs;\nend\n\nprocedure main()\n   local stock, n;\n   stock := table();\n   add(stock, \"bolt\", 100, 2);\n   add(stock, \"nut\", 250, 1);\n   add(stock, \"gear\", 12, 15);\n   add(stock, \"bolt\", 50, 2);\n   n := report(stock);\n   write(\"items: \", n);\n   write(\"value: \", value(stock));\nend"]}}
{"at": [0, 12, 10], "act": "rename", "new": "total_x", "expect": {"cells": ["record item(name, qty, price)   # one stock line\n\nprocedure add(stock, name, qty, price)\n   if member(stock, name) then\n      stock[name].qty +:= qty\n   else\n      stock[name] := item(name, qty, price);\n   return stock[name];\nend\n\nprocedure value(stock)\n   local total_x, k;   # the value so far, a key\n   total_x := 0;\n   every k := key(stock) do total_x +:= stock[k].qty * stock[k].price;\n   return total_x;\nend\n\nprocedure report(stock)\n   local pairs, p, it;\n   pairs := sort(stock);\n   every p := !pairs do {\n      it := p[2];\n      write(left(it.name, 8), right(it.qty, 5), right(it.price, 4));\n   };\n   return *pairs;\nend\n\nprocedure main()\n   local stock, n;\n   stock := table();\n   add(stock, \"bolt\", 100, 2);\n   add(stock, \"nut\", 250, 1);\n   add(stock, \"gear\", 12, 15);\n   add(stock, \"bolt\", 50, 2);\n   n := report(stock);\n   write(\"items: \", n);\n   write(\"value: \", value(stock));\nend"]}}
