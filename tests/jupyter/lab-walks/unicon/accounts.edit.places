{"at": [0, 1, 7], "act": "rename", "new": "Account_x", "expect": {"cells": ["class Account_x (owner, balance, log)   # an account keeps its own log\n  method deposit (amt)\n    balance +:= amt;\n    put (log, \"deposit \" || amt);\n    return balance;\n  end\n\n  method can_pay (amt)\n    return balance >= amt;\n  end\n\n  method withdraw (amt)\n    if can_pay (amt) then {\n      balance -:= amt;\n      put (log, \"withdraw \" || amt);\n      return balance;\n    };\n    put (log, \"refused \" || amt);\n    fail;\n  end\n\n  method show ()\n    write (owner, \": \", balance);\n  end\n\n  initially (o, b)\n    owner := o;\n    balance := b;\n    log := [];\nend\nclass Savings : Account_x (rate)\n  method add_interest ()\n    local i;\n    i := balance * rate / 100;\n    deposit (i);\n    return i;\n  end\n\n  initially (o, b, r)\n    self.Account_x.initially (o, b);\n    rate := r;\nend", "procedure report (a)\n   local line;\n   a.show ();\n   every line := !a.log do write (\"  \", line);\n   return *a.log;\nend", "procedure main ()\n   local s, i, n;\n   s := Savings (\"ann\", 100, 5);\n   every i := 1 to 3 do {\n      s.deposit (i * 10);\n      s.add_interest ();\n   };\n   s.withdraw (500);\n   s.withdraw (50);\n   n := report (s);\n   write (\"entries: \", n);\nend"]}}
{"at": [0, 2, 10], "act": "rename", "new": "deposit_x", "expect": {"cells": ["class Account (owner, balance, log)   # an account keeps its own log\n  method deposit_x (amt)\n    balance +:= amt;\n    put (log, \"deposit \" || amt);\n    return balance;\n  end\n\n  method can_pay (amt)\n    return balance >= amt;\n  end\n\n  method withdraw (amt)\n    if can_pay (amt) then {\n      balance -:= amt;\n      put (log, \"withdraw \" || amt);\n      return balance;\n    };\n    put (log, \"refused \" || amt);\n    fail;\n  end\n\n  method show ()\n    write (owner, \": \", balance);\n  end\n\n  initially (o, b)\n    owner := o;\n    balance := b;\n    log := [];\nend\nclass Savings : Account (rate)\n  method add_interest ()\n    local i;\n    i := balance * rate / 100;\n    deposit_x (i);\n    return i;\n  end\n\n  initially (o, b, r)\n    self.Account.initially (o, b);\n    rate := r;\nend", "procedure report (a)\n   local line;\n   a.show ();\n   every line := !a.log do write (\"  \", line);\n   return *a.log;\nend", "procedure main ()\n   local s, i, n;\n   s := Savings (\"ann\", 100, 5);\n   every i := 1 to 3 do {\n      s.deposit_x (i * 10);\n      s.add_interest ();\n   };\n   s.withdraw (500);\n   s.withdraw (50);\n   n := report (s);\n   write (\"entries: \", n);\nend"]}}
{"at": [1, 1, 11], "act": "rename", "new": "report_x", "expect": {"cells": ["class Account (owner, balance, log)   # an account keeps its own log\n  method deposit (amt)\n    balance +:= amt;\n    put (log, \"deposit \" || amt);\n    return balance;\n  end\n\n  method can_pay (amt)\n    return balance >= amt;\n  end\n\n  method withdraw (amt)\n    if can_pay (amt) then {\n      balance -:= amt;\n      put (log, \"withdraw \" || amt);\n      return balance;\n    };\n    put (log, \"refused \" || amt);\n    fail;\n  end\n\n  method show ()\n    write (owner, \": \", balance);\n  end\n\n  initially (o, b)\n    owner := o;\n    balance := b;\n    log := [];\nend\nclass Savings : Account (rate)\n  method add_interest ()\n    local i;\n    i := balance * rate / 100;\n    deposit (i);\n    return i;\n  end\n\n  initially (o, b, r)\n    self.Account.initially (o, b);\n    rate := r;\nend", "procedure report_x (a)\n   local line;\n   a.show ();\n   every line := !a.log do write (\"  \", line);\n   return *a.log;\nend", "procedure main ()\n   local s, i, n;\n   s := Savings (\"ann\", 100, 5);\n   every i := 1 to 3 do {\n      s.deposit (i * 10);\n      s.add_interest ();\n   };\n   s.withdraw (500);\n   s.withdraw (50);\n   n := report_x (s);\n   write (\"entries: \", n);\nend"]}}
{"at": [0, 1, 23], "act": "rename", "new": "balance_x", "expect": {"cells": ["class Account (owner, balance_x, log)   # an account keeps its own log\n  method deposit (amt)\n    balance_x +:= amt;\n    put (log, \"deposit \" || amt);\n    return balance_x;\n  end\n\n  method can_pay (amt)\n    return balance_x >= amt;\n  end\n\n  method withdraw (amt)\n    if can_pay (amt) then {\n      balance_x -:= amt;\n      put (log, \"withdraw \" || amt);\n      return balance_x;\n    };\n    put (log, \"refused \" || amt);\n    fail;\n  end\n\n  method show ()\n    write (owner, \": \", balance_x);\n  end\n\n  initially (o, b)\n    owner := o;\n    balance_x := b;\n    log := [];\nend\nclass Savings : Account (rate)\n  method add_interest ()\n    local i;\n    i := balance_x * rate / 100;\n    deposit (i);\n    return i;\n  end\n\n  initially (o, b, r)\n    self.Account.initially (o, b);\n    rate := r;\nend", "procedure report (a)\n   local line;\n   a.show ();\n   every line := !a.log do write (\"  \", line);\n   return *a.log;\nend", "procedure main ()\n   local s, i, n;\n   s := Savings (\"ann\", 100, 5);\n   every i := 1 to 3 do {\n      s.deposit (i * 10);\n      s.add_interest ();\n   };\n   s.withdraw (500);\n   s.withdraw (50);\n   n := report (s);\n   write (\"entries: \", n);\nend"]}}
{"at": [0, 2, 19], "act": "rename", "new": "amt_x", "expect": {"cells": ["class Account (owner, balance, log)   # an account keeps its own log\n  method deposit (amt_x)\n    balance +:= amt_x;\n    put (log, \"deposit \" || amt_x);\n    return balance;\n  end\n\n  method can_pay (amt)\n    return balance >= amt;\n  end\n\n  method withdraw (amt)\n    if can_pay (amt) then {\n      balance -:= amt;\n      put (log, \"withdraw \" || amt);\n      return balance;\n    };\n    put (log, \"refused \" || amt);\n    fail;\n  end\n\n  method show ()\n    write (owner, \": \", balance);\n  end\n\n  initially (o, b)\n    owner := o;\n    balance := b;\n    log := [];\nend\nclass Savings : Account (rate)\n  method add_interest ()\n    local i;\n    i := balance * rate / 100;\n    deposit (i);\n    return i;\n  end\n\n  initially (o, b, r)\n    self.Account.initially (o, b);\n    rate := r;\nend", "procedure report (a)\n   local line;\n   a.show ();\n   every line := !a.log do write (\"  \", line);\n   return *a.log;\nend", "procedure main ()\n   local s, i, n;\n   s := Savings (\"ann\", 100, 5);\n   every i := 1 to 3 do {\n      s.deposit (i * 10);\n      s.add_interest ();\n   };\n   s.withdraw (500);\n   s.withdraw (50);\n   n := report (s);\n   write (\"entries: \", n);\nend"]}}
{"at": [0, 33, 11], "act": "rename", "new": "i_x", "expect": {"cells": ["class Account (owner, balance, log)   # an account keeps its own log\n  method deposit (amt)\n    balance +:= amt;\n    put (log, \"deposit \" || amt);\n    return balance;\n  end\n\n  method can_pay (amt)\n    return balance >= amt;\n  end\n\n  method withdraw (amt)\n    if can_pay (amt) then {\n      balance -:= amt;\n      put (log, \"withdraw \" || amt);\n      return balance;\n    };\n    put (log, \"refused \" || amt);\n    fail;\n  end\n\n  method show ()\n    write (owner, \": \", balance);\n  end\n\n  initially (o, b)\n    owner := o;\n    balance := b;\n    log := [];\nend\nclass Savings : Account (rate)\n  method add_interest ()\n    local i_x;\n    i_x := balance * rate / 100;\n    deposit (i_x);\n    return i_x;\n  end\n\n  initially (o, b, r)\n    self.Account.initially (o, b);\n    rate := r;\nend", "procedure report (a)\n   local line;\n   a.show ();\n   every line := !a.log do write (\"  \", line);\n   return *a.log;\nend", "procedure main ()\n   local s, i, n;\n   s := Savings (\"ann\", 100, 5);\n   every i := 1 to 3 do {\n      s.deposit (i * 10);\n      s.add_interest ();\n   };\n   s.withdraw (500);\n   s.withdraw (50);\n   n := report (s);\n   write (\"entries: \", n);\nend"]}}
