{"act": "out", "expect": {"cell": 3, "line": 6, "frames": [["main", 6]], "vars": {"s": "object Savings_1(4)", "i": "1"}, "output": ""}}
{"act": "in", "expect": {"cell": 1, "line": 4, "frames": [["Savings_add_interest", 4], ["main", 6]], "vars": {"i": "&null"}, "output": ""}}
