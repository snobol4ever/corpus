{"at": [0, 1, 11], "act": "rename", "new": "words_x", "expect": {"cells": ["procedure words_x (s)\n   local w;   # the word being scanned\n   s ? {\n      while tab (upto (&letters)) do {\n         w := tab (many (&letters));\n         suspend w;\n      };\n   };\nend", "procedure longest (s)   # the first of the longest words\n   local w, best;\n   best := \"\";\n   every w := words_x (s) do\n      if *w > *best then best := w;\n   return best;\nend", "procedure main ()\n   local text, w, n;\n   text := \"the quick brown fox jumps\";\n   n := 0;\n   every w := words_x (text) do {\n      n +:= 1;\n      write (n, \" \", w);\n   };\n   write (\"longest: \", longest (text));\n   text ? write (\"first space at \", find (\" \"));\nend"]}}
{"at": [0, 2, 10], "act": "rename", "new": "w_x", "expect": {"cells": ["procedure words (s)\n   local w_x;   # the word being scanned\n   s ? {\n      while tab (upto (&letters)) do {\n         w_x := tab (many (&letters));\n         suspend w_x;\n      };\n   };\nend", "procedure longest (s)   # the first of the longest words\n   local w, best;\n   best := \"\";\n   every w := words (s) do\n      if *w > *best then best := w;\n   return best;\nend", "procedure main ()\n   local text, w, n;\n   text := \"the quick brown fox jumps\";\n   n := 0;\n   every w := words (text) do {\n      n +:= 1;\n      write (n, \" \", w);\n   };\n   write (\"longest: \", longest (text));\n   text ? write (\"first space at \", find (\" \"));\nend"]}}
{"at": [0, 1, 18], "act": "rename", "new": "s_x", "expect": {"cells": ["procedure words (s_x)\n   local w;   # the word being scanned\n   s_x ? {\n      while tab (upto (&letters)) do {\n         w := tab (many (&letters));\n         suspend w;\n      };\n   };\nend", "procedure longest (s)   # the first of the longest words\n   local w, best;\n   best := \"\";\n   every w := words (s) do\n      if *w > *best then best := w;\n   return best;\nend", "procedure main ()\n   local text, w, n;\n   text := \"the quick brown fox jumps\";\n   n := 0;\n   every w := words (text) do {\n      n +:= 1;\n      write (n, \" \", w);\n   };\n   write (\"longest: \", longest (text));\n   text ? write (\"first space at \", find (\" \"));\nend"]}}
