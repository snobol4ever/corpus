# Prolog, program 1 hanoi_moves (the towers of hanoi of rosetta-prolog with a moves record kept by assertz/retract): developer_05 2026-11-23. The expects are worked out from the program and the law of skill debugger section 2a (Prolog: a stop at a clause head after head unification and before each body goal; a variable not yet born reads _; next passes a call whole; in enters a clause the program defines; the line of a frame is its waiting call), never read off a run. Cells from 0 among the code cells, lines from 1 in the cell; frames top first as [name/arity, line]; the directive of the last cell is the root frame main.
{"run": 0}
{"run": 1}
{"break": [1, 3]}
{"run": 2, "expect": {"cell": 1, "line": 3, "frames": [["hanoi/4", 3], ["run/1", 2], ["main", 6]], "vars": {"N": "3", "M": "_", "From": "left", "To": "right", "Via": "centre"}}}
{"act": "next", "expect": {"cell": 1, "line": 4, "frames": [["hanoi/4", 4], ["run/1", 2], ["main", 6]], "vars": {"N": "3", "M": "2"}}}
{"act": "in", "expect": {"cell": 1, "line": 2, "frames": [["hanoi/4", 2], ["hanoi/4", 4], ["run/1", 2], ["main", 6]], "vars": {"N": "2", "M": "_", "From": "left", "To": "centre", "Via": "right"}}}
{"act": "next", "expect": {"cell": 1, "line": 3, "frames": [["hanoi/4", 3], ["hanoi/4", 4], ["run/1", 2], ["main", 6]], "vars": {"N": "2", "M": "_"}}}
{"act": "next", "expect": {"cell": 1, "line": 4, "vars": {"N": "2", "M": "1"}}}
{"act": "in", "expect": {"cell": 1, "line": 2, "frames": [["hanoi/4", 2], ["hanoi/4", 4], ["hanoi/4", 4], ["run/1", 2], ["main", 6]], "vars": {"N": "1", "M": "_", "From": "left", "To": "right", "Via": "centre"}}}
{"act": "next", "expect": {"cell": 1, "line": 3, "vars": {"N": "1", "M": "_"}}}
{"act": "next", "expect": {"cell": 1, "line": 4, "vars": {"N": "1", "M": "0"}}}
{"act": "next", "expect": {"cell": 1, "line": 5, "frames": [["hanoi/4", 5], ["hanoi/4", 4], ["hanoi/4", 4], ["run/1", 2], ["main", 6]], "output": ""}}
{"act": "next", "expect": {"cell": 1, "line": 1, "frames": [["hanoi/4", 1], ["hanoi/4", 4], ["hanoi/4", 4], ["hanoi/4", 4], ["run/1", 2], ["main", 6]]}}
{"act": "next", "expect": {"cell": 1, "line": 5, "frames": [["hanoi/4", 5], ["hanoi/4", 4], ["hanoi/4", 4], ["run/1", 2], ["main", 6]], "output": ""}}
{"act": "in", "expect": {"cell": 0, "line": 4, "frames": [["record/2", 4], ["hanoi/4", 5], ["hanoi/4", 4], ["hanoi/4", 4], ["run/1", 2], ["main", 6]], "vars": {"From": "left", "To": "right", "N": "_", "N1": "_"}}}
{"act": "next", "expect": {"cell": 0, "line": 5, "vars": {"N": "_"}}}
{"act": "next", "expect": {"cell": 0, "line": 6, "vars": {"N": "0", "N1": "_"}}}
{"act": "next", "expect": {"cell": 0, "line": 7, "vars": {"N": "0", "N1": "1"}}}
{"act": "next", "expect": {"cell": 0, "line": 8, "vars": {"N1": "1"}, "output": ""}}
{"act": "evaluate", "expression": "X is N1 + 10", "expect": {"result": "X = 11"}}
{"act": "next", "expect": {"cell": 1, "line": 6, "frames": [["hanoi/4", 6], ["hanoi/4", 4], ["hanoi/4", 4], ["run/1", 2], ["main", 6]], "vars": {"N": "1", "M": "0", "From": "left", "To": "right", "Via": "centre"}, "output": "1: left -> right\n"}}
{"act": "out", "expect": {"cell": 1, "line": 5, "frames": [["hanoi/4", 5], ["hanoi/4", 4], ["run/1", 2], ["main", 6]], "vars": {"N": "2", "M": "1", "From": "left", "To": "centre", "Via": "right"}, "output": "1: left -> right\n"}}
{"act": "continue", "expect": {"cell": 1, "line": 3, "frames": [["hanoi/4", 3], ["hanoi/4", 6], ["hanoi/4", 4], ["run/1", 2], ["main", 6]], "vars": {"N": "1", "M": "_", "From": "right", "To": "centre", "Via": "left"}, "output": "1: left -> right\n2: left -> centre\n"}}
{"act": "continue", "expect": {"cell": 1, "line": 3, "frames": [["hanoi/4", 3], ["hanoi/4", 6], ["run/1", 2], ["main", 6]], "vars": {"N": "2", "M": "_", "From": "centre", "To": "right", "Via": "left"}, "output": "1: left -> right\n2: left -> centre\n3: right -> centre\n4: left -> right\n"}}
