{"at": [1, 10, 3], "act": "rename", "new": "count", "expect": {"cells": ["{$mode objfpc}\nprogram board;\nvar\n  a: array [1..8] of boolean;\n  b: array [2..16] of boolean;\n  c: array [-7..7] of boolean;\n  x: array [1..8] of integer;\n  count: integer;\nprocedure print;\nvar k: integer;\nbegin\n  count := count + 1;\n  write('solution ', count, ':');\n  for k := 1 to 8 do\n    write(x[k]: 3);\n  writeln\nend;\nprocedure place(i: integer);\nvar j: integer;\nbegin\n  for j := 1 to 8 do\n    if a[j] and b[i+j] and c[i-j] then\n    begin\n      x[i] := j;\n      a[j] := false; b[i+j] := false; c[i-j] := false;\n      if i < 8 then place(i+1) else print;\n      a[j] := true; b[i+j] := true; c[i-j] := true\n    end\nend;\nbegin\nend.\n", "{$mode objfpc}\nprogram run;\nvar\n  a: array [1..8] of boolean; external;\n  b: array [2..16] of boolean; external;\n  c: array [-7..7] of boolean; external;\n  count: integer; external;\nvar i: integer;\nbegin\n  count := 0;\n  for i := 1 to 8 do a[i] := true;\n  for i := 2 to 16 do b[i] := true;\n  for i := -7 to 7 do c[i] := true;\n  place(1);\n  writeln('total ', count)\nend.\n"]}}
{"at": [0, 9, 11], "act": "rename", "new": "report", "expect": {"cells": ["{$mode objfpc}\nprogram board;\nvar\n  a: array [1..8] of boolean;\n  b: array [2..16] of boolean;\n  c: array [-7..7] of boolean;\n  x: array [1..8] of integer;\n  found: integer;\nprocedure report;\nvar k: integer;\nbegin\n  found := found + 1;\n  write('solution ', found, ':');\n  for k := 1 to 8 do\n    write(x[k]: 3);\n  writeln\nend;\nprocedure place(i: integer);\nvar j: integer;\nbegin\n  for j := 1 to 8 do\n    if a[j] and b[i+j] and c[i-j] then\n    begin\n      x[i] := j;\n      a[j] := false; b[i+j] := false; c[i-j] := false;\n      if i < 8 then place(i+1) else report;\n      a[j] := true; b[i+j] := true; c[i-j] := true\n    end\nend;\nbegin\nend.\n", "{$mode objfpc}\nprogram run;\nvar\n  a: array [1..8] of boolean; external;\n  b: array [2..16] of boolean; external;\n  c: array [-7..7] of boolean; external;\n  found: integer; external;\nvar i: integer;\nbegin\n  found := 0;\n  for i := 1 to 8 do a[i] := true;\n  for i := 2 to 16 do b[i] := true;\n  for i := -7 to 7 do c[i] := true;\n  place(1);\n  writeln('total ', found)\nend.\n"]}}
