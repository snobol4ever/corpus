{"at": [1, 8, 3], "act": "rename", "new": "total", "expect": {"cells": ["{$mode objfpc}\nprogram board;\nvar\n  peg: array [1..3] of integer;\n  total: integer;\nfunction pegname(p: integer): char;\nbegin\n  pegname := chr(ord('A') + p - 1)\nend;\nprocedure report(disk, src, dst: integer);\nbegin\n  total := total + 1;\n  writeln('move ', total, ': disk ', disk, ' ', pegname(src), ' to ', pegname(dst))\nend;\nprocedure hanoi(n, src, dst, via: integer);\nbegin\n  if n > 0 then\n  begin\n    hanoi(n - 1, src, via, dst);\n    peg[src] := peg[src] - 1;\n    peg[dst] := peg[dst] + 1;\n    report(n, src, dst);\n    hanoi(n - 1, via, dst, src)\n  end\nend;\nbegin\nend.\n", "{$mode objfpc}\nprogram run;\nvar\n  peg: array [1..3] of integer; external;\n  total: integer; external;\nvar rounds: integer;\nbegin\n  total := 0;\n  for rounds := 2 to 3 do\n  begin\n    peg[1] := rounds; peg[2] := 0; peg[3] := 0;\n    hanoi(rounds, 1, 3, 2);\n    writeln('pegs ', peg[1], ' ', peg[2], ' ', peg[3])\n  end;\n  writeln('moves ', total)\nend.\n"]}}
{"at": [0, 19, 5], "act": "rename", "new": "solve", "expect": {"cells": ["{$mode objfpc}\nprogram board;\nvar\n  peg: array [1..3] of integer;\n  moves: integer;\nfunction pegname(p: integer): char;\nbegin\n  pegname := chr(ord('A') + p - 1)\nend;\nprocedure report(disk, src, dst: integer);\nbegin\n  moves := moves + 1;\n  writeln('move ', moves, ': disk ', disk, ' ', pegname(src), ' to ', pegname(dst))\nend;\nprocedure solve(n, src, dst, via: integer);\nbegin\n  if n > 0 then\n  begin\n    solve(n - 1, src, via, dst);\n    peg[src] := peg[src] - 1;\n    peg[dst] := peg[dst] + 1;\n    report(n, src, dst);\n    solve(n - 1, via, dst, src)\n  end\nend;\nbegin\nend.\n", "{$mode objfpc}\nprogram run;\nvar\n  peg: array [1..3] of integer; external;\n  moves: integer; external;\nvar rounds: integer;\nbegin\n  moves := 0;\n  for rounds := 2 to 3 do\n  begin\n    peg[1] := rounds; peg[2] := 0; peg[3] := 0;\n    solve(rounds, 1, 3, 2);\n    writeln('pegs ', peg[1], ' ', peg[2], ' ', peg[3])\n  end;\n  writeln('moves ', moves)\nend.\n"]}}
{"at": [0, 10, 18], "act": "rename", "new": "plate", "expect": {"cells": ["{$mode objfpc}\nprogram board;\nvar\n  peg: array [1..3] of integer;\n  moves: integer;\nfunction pegname(p: integer): char;\nbegin\n  pegname := chr(ord('A') + p - 1)\nend;\nprocedure report(plate, src, dst: integer);\nbegin\n  moves := moves + 1;\n  writeln('move ', moves, ': disk ', plate, ' ', pegname(src), ' to ', pegname(dst))\nend;\nprocedure hanoi(n, src, dst, via: integer);\nbegin\n  if n > 0 then\n  begin\n    hanoi(n - 1, src, via, dst);\n    peg[src] := peg[src] - 1;\n    peg[dst] := peg[dst] + 1;\n    report(n, src, dst);\n    hanoi(n - 1, via, dst, src)\n  end\nend;\nbegin\nend.\n", "{$mode objfpc}\nprogram run;\nvar\n  peg: array [1..3] of integer; external;\n  moves: integer; external;\nvar rounds: integer;\nbegin\n  moves := 0;\n  for rounds := 2 to 3 do\n  begin\n    peg[1] := rounds; peg[2] := 0; peg[3] := 0;\n    hanoi(rounds, 1, 3, 2);\n    writeln('pegs ', peg[1], ' ', peg[2], ' ', peg[3])\n  end;\n  writeln('moves ', moves)\nend.\n"]}}
