{"at": [0, 6, 10], "act": "rename", "new": "nameof", "expect": {"cells": ["{$mode objfpc}\nprogram board;\nvar\n  peg: array [1..3] of integer;\n  moves: integer;\nfunction nameof(p: integer): char;\nbegin\n  nameof := chr(ord('A') + p - 1)\nend;\nprocedure report(disk, src, dst: integer);\nbegin\n  moves := moves + 1;\n  writeln('move ', moves, ': disk ', disk, ' ', nameof(src), ' to ', nameof(dst))\nend;\nprocedure hanoi(n, src, dst, via: integer);\nbegin\n  if n > 0 then\n  begin\n    hanoi(n - 1, src, via, dst);\n    peg[src] := peg[src] - 1;\n    peg[dst] := peg[dst] + 1;\n    report(n, src, dst);\n    hanoi(n - 1, via, dst, src)\n  end\nend;\nbegin\nend.\n", "{$mode objfpc}\nprogram run;\nvar\n  peg: array [1..3] of integer; external;\n  moves: integer; external;\nvar rounds: integer;\nbegin\n  moves := 0;\n  for rounds := 2 to 3 do\n  begin\n    peg[1] := rounds; peg[2] := 0; peg[3] := 0;\n    hanoi(rounds, 1, 3, 2);\n    writeln('pegs ', peg[1], ' ', peg[2], ' ', peg[3])\n  end;\n  writeln('moves ', moves)\nend.\n"]}}
