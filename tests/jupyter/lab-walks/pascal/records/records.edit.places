{"at": [0, 16, 3], "act": "rename", "new": "filled", "expect": {"cells": ["{$mode objfpc}\nprogram stock;\ntype\n  Item = record\n    name: string[8];\n    qty, price: integer\n  end;\nvar\n  items: array [1..4] of Item;\n  filled: integer;\nprocedure put(k: integer; nm: string; q, p: integer);\nbegin\n  items[k].name := nm;\n  items[k].qty := q;\n  items[k].price := p;\n  filled := k\nend;\nprocedure setup;\nbegin\n  filled := 0;\n  put(1, 'bolt', 10, 3);\n  put(2, 'nut', 20, 1);\n  put(3, 'gear', 5, 12);\n  put(4, 'cog', 8, 7)\nend;\nprocedure restock(k, n: integer);\nbegin\n  items[k].qty := items[k].qty + n\nend;\nprocedure show;\nvar k: integer;\nbegin\n  for k := 1 to filled do\n    writeln(items[k].name: 6, items[k].qty: 4, items[k].price: 4)\nend;\nfunction total(k: integer): integer;\nbegin\n  if k > filled then\n    total := 0\n  else\n    total := items[k].qty * items[k].price + total(k + 1)\nend;\nbegin\nend.\n", "{$mode objfpc}\nprogram run;\nbegin\n  setup;\n  show;\n  restock(3, 5);\n  restock(4, 2);\n  show;\n  writeln('total ', total(1))\nend.\n"]}}
{"at": [1, 6, 3], "act": "rename", "new": "refill", "expect": {"cells": ["{$mode objfpc}\nprogram stock;\ntype\n  Item = record\n    name: string[8];\n    qty, price: integer\n  end;\nvar\n  items: array [1..4] of Item;\n  count: integer;\nprocedure put(k: integer; nm: string; q, p: integer);\nbegin\n  items[k].name := nm;\n  items[k].qty := q;\n  items[k].price := p;\n  count := k\nend;\nprocedure setup;\nbegin\n  count := 0;\n  put(1, 'bolt', 10, 3);\n  put(2, 'nut', 20, 1);\n  put(3, 'gear', 5, 12);\n  put(4, 'cog', 8, 7)\nend;\nprocedure refill(k, n: integer);\nbegin\n  items[k].qty := items[k].qty + n\nend;\nprocedure show;\nvar k: integer;\nbegin\n  for k := 1 to count do\n    writeln(items[k].name: 6, items[k].qty: 4, items[k].price: 4)\nend;\nfunction total(k: integer): integer;\nbegin\n  if k > count then\n    total := 0\n  else\n    total := items[k].qty * items[k].price + total(k + 1)\nend;\nbegin\nend.\n", "{$mode objfpc}\nprogram run;\nbegin\n  setup;\n  show;\n  refill(3, 5);\n  refill(4, 2);\n  show;\n  writeln('total ', total(1))\nend.\n"]}}
{"at": [0, 9, 26], "act": "rename", "new": "Part", "expect": {"cells": ["{$mode objfpc}\nprogram stock;\ntype\n  Part = record\n    name: string[8];\n    qty, price: integer\n  end;\nvar\n  items: array [1..4] of Part;\n  count: integer;\nprocedure put(k: integer; nm: string; q, p: integer);\nbegin\n  items[k].name := nm;\n  items[k].qty := q;\n  items[k].price := p;\n  count := k\nend;\nprocedure setup;\nbegin\n  count := 0;\n  put(1, 'bolt', 10, 3);\n  put(2, 'nut', 20, 1);\n  put(3, 'gear', 5, 12);\n  put(4, 'cog', 8, 7)\nend;\nprocedure restock(k, n: integer);\nbegin\n  items[k].qty := items[k].qty + n\nend;\nprocedure show;\nvar k: integer;\nbegin\n  for k := 1 to count do\n    writeln(items[k].name: 6, items[k].qty: 4, items[k].price: 4)\nend;\nfunction total(k: integer): integer;\nbegin\n  if k > count then\n    total := 0\n  else\n    total := items[k].qty * items[k].price + total(k + 1)\nend;\nbegin\nend.\n", "{$mode objfpc}\nprogram run;\nbegin\n  setup;\n  show;\n  restock(3, 5);\n  restock(4, 2);\n  show;\n  writeln('total ', total(1))\nend.\n"]}}
{"at": [1, 9, 21], "act": "rename", "new": "sum", "expect": {"cells": ["{$mode objfpc}\nprogram stock;\ntype\n  Item = record\n    name: string[8];\n    qty, price: integer\n  end;\nvar\n  items: array [1..4] of Item;\n  count: integer;\nprocedure put(k: integer; nm: string; q, p: integer);\nbegin\n  items[k].name := nm;\n  items[k].qty := q;\n  items[k].price := p;\n  count := k\nend;\nprocedure setup;\nbegin\n  count := 0;\n  put(1, 'bolt', 10, 3);\n  put(2, 'nut', 20, 1);\n  put(3, 'gear', 5, 12);\n  put(4, 'cog', 8, 7)\nend;\nprocedure restock(k, n: integer);\nbegin\n  items[k].qty := items[k].qty + n\nend;\nprocedure show;\nvar k: integer;\nbegin\n  for k := 1 to count do\n    writeln(items[k].name: 6, items[k].qty: 4, items[k].price: 4)\nend;\nfunction sum(k: integer): integer;\nbegin\n  if k > count then\n    sum := 0\n  else\n    sum := items[k].qty * items[k].price + sum(k + 1)\nend;\nbegin\nend.\n", "{$mode objfpc}\nprogram run;\nbegin\n  setup;\n  show;\n  restock(3, 5);\n  restock(4, 2);\n  show;\n  writeln('total ', sum(1))\nend.\n"]}}
