{"at": [1, 9, 3], "act": "rename", "new": "passes", "expect": {"cells": ["{$mode objfpc}\nprogram board;\nvar\n  a: array [1..12] of integer;\n  t: array [1..12] of integer;\n  passes: integer;\nprocedure show(const msg: string);\nvar k: integer;\nbegin\n  write(msg);\n  for k := 1 to 12 do\n    write(a[k]: 4);\n  writeln\nend;\nprocedure merge(lo, mid, hi: integer);\nvar i, j, k: integer;\nbegin\n  i := lo; j := mid + 1; k := lo;\n  while (i <= mid) and (j <= hi) do\n  begin\n    if a[i] <= a[j] then\n    begin\n      t[k] := a[i]; i := i + 1\n    end\n    else\n    begin\n      t[k] := a[j]; j := j + 1\n    end;\n    k := k + 1\n  end;\n  while i <= mid do\n  begin\n    t[k] := a[i]; i := i + 1; k := k + 1\n  end;\n  while j <= hi do\n  begin\n    t[k] := a[j]; j := j + 1; k := k + 1\n  end;\n  for k := lo to hi do\n    a[k] := t[k];\n  passes := passes + 1\nend;\nprocedure msort(lo, hi: integer);\nvar mid: integer;\nbegin\n  if lo < hi then\n  begin\n    mid := (lo + hi) div 2;\n    msort(lo, mid);\n    msort(mid + 1, hi);\n    merge(lo, mid, hi)\n  end\nend;\nbegin\nend.\n", "{$mode objfpc}\nprogram run;\nvar\n  a: array [1..12] of integer; external;\n  t: array [1..12] of integer; external;\n  passes: integer; external;\nvar n: integer;\nbegin\n  passes := 0;\n  for n := 1 to 12 do\n    a[n] := (n * 7) mod 13;\n  show('before:');\n  msort(1, 12);\n  show('after: ');\n  writeln('merges ', passes)\nend.\n"]}}
{"at": [1, 12, 3], "act": "rename", "new": "dump", "expect": {"cells": ["{$mode objfpc}\nprogram board;\nvar\n  a: array [1..12] of integer;\n  t: array [1..12] of integer;\n  merges: integer;\nprocedure dump(const msg: string);\nvar k: integer;\nbegin\n  write(msg);\n  for k := 1 to 12 do\n    write(a[k]: 4);\n  writeln\nend;\nprocedure merge(lo, mid, hi: integer);\nvar i, j, k: integer;\nbegin\n  i := lo; j := mid + 1; k := lo;\n  while (i <= mid) and (j <= hi) do\n  begin\n    if a[i] <= a[j] then\n    begin\n      t[k] := a[i]; i := i + 1\n    end\n    else\n    begin\n      t[k] := a[j]; j := j + 1\n    end;\n    k := k + 1\n  end;\n  while i <= mid do\n  begin\n    t[k] := a[i]; i := i + 1; k := k + 1\n  end;\n  while j <= hi do\n  begin\n    t[k] := a[j]; j := j + 1; k := k + 1\n  end;\n  for k := lo to hi do\n    a[k] := t[k];\n  merges := merges + 1\nend;\nprocedure msort(lo, hi: integer);\nvar mid: integer;\nbegin\n  if lo < hi then\n  begin\n    mid := (lo + hi) div 2;\n    msort(lo, mid);\n    msort(mid + 1, hi);\n    merge(lo, mid, hi)\n  end\nend;\nbegin\nend.\n", "{$mode objfpc}\nprogram run;\nvar\n  a: array [1..12] of integer; external;\n  t: array [1..12] of integer; external;\n  merges: integer; external;\nvar n: integer;\nbegin\n  merges := 0;\n  for n := 1 to 12 do\n    a[n] := (n * 7) mod 13;\n  dump('before:');\n  msort(1, 12);\n  dump('after: ');\n  writeln('merges ', merges)\nend.\n"]}}
{"at": [0, 23, 7], "act": "rename", "new": "buf", "expect": {"cells": ["{$mode objfpc}\nprogram board;\nvar\n  a: array [1..12] of integer;\n  buf: array [1..12] of integer;\n  merges: integer;\nprocedure show(const msg: string);\nvar k: integer;\nbegin\n  write(msg);\n  for k := 1 to 12 do\n    write(a[k]: 4);\n  writeln\nend;\nprocedure merge(lo, mid, hi: integer);\nvar i, j, k: integer;\nbegin\n  i := lo; j := mid + 1; k := lo;\n  while (i <= mid) and (j <= hi) do\n  begin\n    if a[i] <= a[j] then\n    begin\n      buf[k] := a[i]; i := i + 1\n    end\n    else\n    begin\n      buf[k] := a[j]; j := j + 1\n    end;\n    k := k + 1\n  end;\n  while i <= mid do\n  begin\n    buf[k] := a[i]; i := i + 1; k := k + 1\n  end;\n  while j <= hi do\n  begin\n    buf[k] := a[j]; j := j + 1; k := k + 1\n  end;\n  for k := lo to hi do\n    a[k] := buf[k];\n  merges := merges + 1\nend;\nprocedure msort(lo, hi: integer);\nvar mid: integer;\nbegin\n  if lo < hi then\n  begin\n    mid := (lo + hi) div 2;\n    msort(lo, mid);\n    msort(mid + 1, hi);\n    merge(lo, mid, hi)\n  end\nend;\nbegin\nend.\n", "{$mode objfpc}\nprogram run;\nvar\n  a: array [1..12] of integer; external;\n  buf: array [1..12] of integer; external;\n  merges: integer; external;\nvar n: integer;\nbegin\n  merges := 0;\n  for n := 1 to 12 do\n    a[n] := (n * 7) mod 13;\n  show('before:');\n  msort(1, 12);\n  show('after: ');\n  writeln('merges ', merges)\nend.\n"]}}
