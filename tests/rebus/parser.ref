#----------------------------------------------------------------- 1 blank_lines
(STMT :subj (TT_FNC DEFINE (TT_QLIT "MAIN()")))
(STMT :go rb_1)
(STMT :lbl MAIN)
(STMT :eq :subj (TT_VAR X) :repl (TT_ILIT 1))
(STMT :eq :subj (TT_VAR Y) :repl (TT_ILIT 2))
(STMT :go RETURN)
(STMT :lbl rb_1)
(STMT :subj (TT_FNC MAIN))
#---------------------------------------------------------------- 2 comment_hash
(STMT :subj (TT_FNC DEFINE (TT_QLIT "MAIN()")))
(STMT :go rb_1)
(STMT :lbl MAIN)
(STMT :eq :subj (TT_VAR X) :repl (TT_ILIT 1))
(STMT :go RETURN)
(STMT :lbl rb_1)
(STMT :subj (TT_FNC MAIN))
#-------------------------------------------------------------- 3 compound_basic
(STMT :subj (TT_FNC DEFINE (TT_QLIT "MAIN()")))
(STMT :go rb_1)
(STMT :lbl MAIN)
(STMT :eq :subj (TT_VAR OUTPUT) :repl (TT_QLIT "a"))
(STMT :eq :subj (TT_VAR OUTPUT) :repl (TT_QLIT "b"))
(STMT :go RETURN)
(STMT :lbl rb_1)
(STMT :subj (TT_FNC MAIN))
#---------------------------------------------------------------- 4 cursor_basic
(STMT :subj (TT_FNC DEFINE (TT_QLIT "MAIN()")))
(STMT :go rb_1)
(STMT :lbl MAIN)
(STMT :subj (TT_VAR X) :pat (TT_CAPT_CURSOR POS))
(STMT :go RETURN)
(STMT :lbl rb_1)
(STMT :subj (TT_FNC MAIN))
#----------------------------------------------------------------- 5 deref_basic
(STMT :subj (TT_FNC DEFINE (TT_QLIT "MAIN()")))
(STMT :go rb_1)
(STMT :lbl MAIN)
(STMT :eq :subj (TT_VAR X) :repl (TT_INDIRECT (TT_VAR Y)))
(STMT :eq :subj (TT_VAR Z) :repl (TT_INDIRECT (TT_QLIT "name")))
(STMT :go RETURN)
(STMT :lbl rb_1)
(STMT :subj (TT_FNC MAIN))
#---------------------------------------------------------------- 6 field_access
(STMT :subj (TT_FNC DEFINE (TT_QLIT "MAIN()")))
(STMT :go rb_1)
(STMT :lbl MAIN)
(STMT :eq :subj (TT_VAR X) :repl (TT_VAR R.FIELD))
(STMT :go RETURN)
(STMT :lbl rb_1)
(STMT :subj (TT_FNC MAIN))
#------------------------------------------------------------------- 7 flow_fail
(STMT :subj (TT_FNC DEFINE (TT_QLIT "MAIN()")))
(STMT :go rb_1)
(STMT :lbl MAIN)
(STMT :go FRETURN)
(STMT :go RETURN)
(STMT :lbl rb_1)
(STMT :subj (TT_FNC MAIN))
#------------------------------------------------------------------- 8 flow_stop
(STMT :subj (TT_FNC DEFINE (TT_QLIT "MAIN()")))
(STMT :go rb_1)
(STMT :lbl MAIN)
(STMT :end)
(STMT :go RETURN)
(STMT :lbl rb_1)
(STMT :subj (TT_FNC MAIN))
#-------------------------------------------------------------- 9 keyword_assign
(STMT :subj (TT_FNC DEFINE (TT_QLIT "MAIN()")))
(STMT :go rb_1)
(STMT :lbl MAIN)
(STMT :eq :subj (TT_KEYWORD FULLSCAN) :repl (TT_ILIT 1))
(STMT :eq :subj (TT_KEYWORD ANCHOR) :repl (TT_ILIT 0))
(STMT :go RETURN)
(STMT :lbl rb_1)
(STMT :subj (TT_FNC MAIN))
#----------------------------------------------------------------- 10 local_vars
(STMT :subj (TT_FNC DEFINE (TT_QLIT "MAIN()/X,Y")))
(STMT :go rb_1)
(STMT :lbl MAIN)
(STMT :eq :subj (TT_VAR X) :repl (TT_ILIT 1))
(STMT :go RETURN)
(STMT :lbl rb_1)
(STMT :subj (TT_FNC MAIN))
#------------------------------------------------------------------- 11 real_lit
(STMT :subj (TT_FNC DEFINE (TT_QLIT "MAIN()")))
(STMT :go rb_1)
(STMT :lbl MAIN)
(STMT :eq :subj (TT_VAR X) :repl (TT_FLIT 3.14))
(STMT :eq :subj (TT_VAR Y) :repl (TT_FLIT 2.718))
(STMT :go RETURN)
(STMT :lbl rb_1)
(STMT :subj (TT_FNC MAIN))
#---------------------------------------------------------------- 12 return_bare
(STMT :subj (TT_FNC DEFINE (TT_QLIT "MAIN()")))
(STMT :go rb_1)
(STMT :lbl MAIN)
(STMT :go RETURN)
(STMT :go RETURN)
(STMT :lbl rb_1)
(STMT :subj (TT_FNC MAIN))
#----------------------------------------------------------------- 13 return_val
(STMT :subj (TT_FNC DEFINE (TT_QLIT "F(X)")))
(STMT :go rb_1)
(STMT :lbl F)
(STMT :eq :subj (TT_VAR F) :repl (TT_VAR X))
(STMT :go RETURN)
(STMT :go RETURN)
(STMT :lbl rb_1)
(STMT :subj (TT_FNC MAIN))
#------------------------------------------------------------------ 14 unary_pat
(STMT :subj (TT_FNC DEFINE (TT_QLIT "MAIN()")))
(STMT :go rb_1)
(STMT :lbl MAIN)
(STMT :eq :subj (TT_VAR X) :repl (TT_FNC DIFFER (TT_VAR Y)))
(STMT :eq :subj (TT_VAR Z) :repl (TT_ITERATE (TT_VAR W)))
(STMT :eq :subj (TT_VAR A) :repl (TT_FNC IDENT (TT_VAR B)))
(STMT :eq :subj (TT_VAR C) :repl (TT_FNC DIFFER (TT_VAR D)))
(STMT :go RETURN)
(STMT :lbl rb_1)
(STMT :subj (TT_FNC MAIN))
#------------------------------------------------------------------ 15 unary_pos
(STMT :subj (TT_FNC DEFINE (TT_QLIT "MAIN()")))
(STMT :go rb_1)
(STMT :lbl MAIN)
(STMT :eq :subj (TT_VAR X) :repl (TT_VAR Y))
(STMT :go RETURN)
(STMT :lbl rb_1)
(STMT :subj (TT_FNC MAIN))
