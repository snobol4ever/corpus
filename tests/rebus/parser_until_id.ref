(STMT :subj (TT_FNC DEFINE (TT_QLIT "MAIN()")))
(STMT :go rb_1)
(STMT :lbl MAIN)
(STMT :lbl rb_2)
(STMT :subj (TT_NUL) :goS rb_4 :goF rb_3)
(STMT :lbl rb_3)
(STMT :subj (TT_FNC EQ
  (TT_VAR X)
  (TT_ILIT 1)
))
(STMT :go rb_2)
(STMT :lbl rb_4)
(STMT :go RETURN)
(STMT :lbl rb_1)
(STMT :subj (TT_FNC MAIN))
