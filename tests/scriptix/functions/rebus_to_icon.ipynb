    "%%rebus\n",
    "function TWICE(n)\n",
    "  return n * 2\n",
    "end\n",
    "function SHOUT(s)\n",
    "  return s || \"!\"\n",
    "end\n",
    "function main()\n",
    "end\n"
   ]
