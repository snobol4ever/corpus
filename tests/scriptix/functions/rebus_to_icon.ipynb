   "source": [
    "%%icon\n",
    "global TWICE, SHOUT\n",
    "procedure main();\n",
    "  write(\"twice \", TWICE(7));\n",
    "  write(\"shout \", SHOUT(\"seven\"));\n",
    "end\n"
   ]
