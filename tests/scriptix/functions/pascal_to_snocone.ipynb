    "{$mode objfpc}\n",
    "program define;\n",
    "function TWICE(n: integer): integer;\n",
    "begin\n",
    "  TWICE := n * 2\n",
    "end;\n",
    "function SHOUT(s: string): string;\n",
    "begin\n",
    "  SHOUT := s + '!'\n",
    "end;\n",
    "begin\n",
    "end.\n"
   ]
  },
  {
   "cell_type": "code",
