procedure main();
  local r, s, c, i, t;
  r := "";
  s := "the quick (brown) fox jumps; over 4.5 lazy dogs";
  c := 'aeiou';
  every i := upto(c, s, 3, 15) do r ||:= i || ",";
  every i := upto(c, s, -12, 0) do r ||:= i || ",";
  r ||:= (upto('z', s, 10, 40) | "-") || ",";
  r ||:= (upto(c, s, 60) | "-") || ",";
  r ||:= (find("o", s, 15, 30) | "-") || ",";
  every i := find("o", s, 1, 0) do r ||:= i || ",";
  r ||:= (find("", s, 3, 3) | "-") || ",";
  r ||:= (many(&lcase, s, 5) | "-") || ",";
  r ||:= (many(&lcase, s, 5, 8) | "-") || ",";
  r ||:= (many(c, s, 3) | "-") || ",";
  r ||:= (any(c, s, 3) | "-") || ",";
  r ||:= (any(c, s, 0) | "-") || ",";
  r ||:= (any("xyz", s, 1) | "-") || ",";
  r ||:= (match("the", s, 1) | "-") || ",";
  r ||:= (match("quick", s, 5) | "-") || ",";
  r ||:= (match("quick", s, 5, 8) | "-") || ",";
  r ||:= (bal('x', '(', ')', "(a)x", 1) | "-") || ",";
  r ||:= (bal(')', '(', ')', s, 1) | "-") || ",";
  t := "abcabc";
  r ||:= (find(t, s || t, 1) | "-") || ",";
  "inner subject" ? { r ||:= (upto('b', "xxbxb") | "-") || "," || &pos || "," || (find("e", s, 1, 12) | "-") || ",";
    r ||:= (tab(upto('s')) | "-") || "," || &pos };
  write(r);
end
