procedure starseq(s)
   /s := "";
   suspend "" | (starseq(s) || !s);
end
procedure grow(s)
   return s || "a";
end
procedure param(s)
   every write("param ", s || !"ab");
   write("param ", s);
end
global g
procedure stat()
   static t;
   local z;
   z := "a";
   t := z || z;
   every write("static ", t || !"ab");
   write("static ", t);
end
procedure main()
   local y, z, n, L;
   n := 0;
   every write("starseq ", starseq("ab")) do { n +:= 1; if n > 12 then break };
   y := grow("a");
   every write("return ", y || !"ab");
   write("return ", *y, " ", y);
   z := "a";
   y := z || z;
   every write("local ", y || !"ab");
   write("local ", *y, " ", y);
   param(z || z);
   g := z || z;
   every write("global ", g || !"ab");
   write("global ", g);
   stat();
   L := [z || z];
   every write("list ", L[1] || !"ab");
   write("list ", L[1]);
   y := z || z;
   y ||:= "x";
   every write("augment ", y || !"ab");
   write("augment ", y);
   every write("inline ", (y := z || z) || !"ab");
   write("inline ", y);
   every write("chain ", grow("a") || !"ab" || "c");
end
