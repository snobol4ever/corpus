#--------------------------------------------------- 1 rung17_real_arith_integer
procedure main();
  write(integer(3.9));
  write(integer("42"));
end
#-------------------------------------------------- 2 rung17_real_arith_real_add
procedure main();
  x := 1.5;
  y := 2.5;
  write(x + y);
end
#------------------------------------------------- 3 rung17_real_arith_real_conv
procedure main();
  write(real(5));
end
#-------------------------------------------------- 4 rung17_real_arith_real_mul
procedure main();
  write(2.0 * 3.5);
end
#----------------------------------------------- 5 rung17_real_arith_string_conv
procedure main();
  write(string(42));
  write(string(3.14));
end
