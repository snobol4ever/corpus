#------------------------------------------------------ 1 rung14_limit_limit_alt
procedure main();
  every write((1|2|3|4|5) \ 2);
end
#---------------------------------------------------- 2 rung14_limit_limit_large
procedure main();
  every write((1 to 3) \ 10);
end
#------------------------------------------------------ 3 rung14_limit_limit_str
procedure main();
  every write(("a"|"b"|"c") \ 2);
end
#------------------------------------------------------- 4 rung14_limit_limit_to
procedure main();
  every write((1 to 10) \ 3);
end
#----------------------------------------------------- 5 rung14_limit_limit_zero
procedure main();
  every write((1 to 5) \ 0);
  write("done");
end
