#--------------------------------------------- 1 rung05_scan_scan_concat_subject
# rung05 t04: scan of concat result
procedure main();
  ("foo" || "bar") ? write(&subject);
end
#----------------------------------------------------- 2 rung05_scan_scan_nested
# rung05 t05: nested scan — inner restores outer subject
procedure main();
  local a;
  local b;
  a := "first";
  b := "second";
  a ? (b ? write(&subject));
  write(&subject);
end
#--------------------------------------------------- 3 rung05_scan_scan_restores
# rung05 t03: &subject restored after scan
procedure main();
  local s;
  s := "outer";
  s ? write(&subject);
  write(s);
end
#---------------------------------------------------- 4 rung05_scan_scan_subject
# rung05 t01: scan sets &subject; body reads it
procedure main();
  "hello" ? write(&subject);
end
#-------------------------------------------------------- 5 rung05_scan_scan_var
# rung05 t02: scan from variable
procedure main();
  local s;
  s := "world";
  s ? write(&subject);
end
