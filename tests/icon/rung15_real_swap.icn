#---------------------------------------------------- 1 rung15_real_swap_lconcat
procedure main();
  s := "hello" ||| " world";
  write(s);
end
#----------------------------------------------- 2 rung15_real_swap_real_literal
procedure main();
  write(3.14);
end
#--------------------------------------------------- 3 rung15_real_swap_real_var
procedure main();
  x := 2.5;
  write(x);
end
#------------------------------------------------- 4 rung15_real_swap_swap_basic
procedure main();
  x := 1;
  y := 2;
  x :=: y;
  write(x);
  write(y);
end
#--------------------------------------------------- 5 rung15_real_swap_swap_str
procedure main();
  a := "hello";
  b := "world";
  a :=: b;
  write(a);
  write(b);
end
