#SRC: JCON

procedure main()

   write(left("abc"));
   write(left("def", ));
   write(left("ghi", &null));
   write(left("jkl", 2));
   write(left("mno", 3));
   write(left(237, 4));
   write(left("stu", 5));
   write(left("vwx", 6));

   write(left("abc", 3, ));
   write(left("def", , "."));
   write(left("ghi", &null, "."));
   write(left("jkl", 2, "."));
   write(left("mno", 3, "."));
   write(left(237, 4, "."));
   write(left("stu", 5, "."));
   write(left("vwx", 6, "."));

   write(left("abc", 3, ));
   write(left("def", , "<>"));
   write(left("ghi", &null, "<>"));
   write(left("jkl", 2, "<>"));
   write(left("mno", 3, "<>"));
   write(left(237, 4, "<>"));
   write(left("stu", 5, "<>"));
   write(left("vwx", 6, "<>"));
end
