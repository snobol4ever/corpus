#SRC: V9SAM

#
#          S I E V E   O F   E R A T O S T H E N E S
#

#  This program illustrates the use of sets in implementing the
#  classical sieve algorithm for computing prime numbers.

procedure main(args)
   local limit, s, i, primes;
   limit := integer(args[1]) | 1000;
   s := set();
   every insert(s,1 to limit);
   every member(s,i := 2 to limit) do
      every delete(s,i + i to limit by i);
   delete(s,1);
   write("There are ",*s," primes in the first ",limit," integers.");
   # primes := sort(s)
   # write("The primes are:")
   # every write(right(!primes,*limit + 1))
end
#--------------------------------------------- 743 procedure_every_alt_replace_1
# queens.icn — N-Queens via recursive backtracking
# Icon idiom: every-driven search, global constraint arrays
# Shows: recursive generators, every with if, global state, string mutation

global n, placed, rows, up, down, qcount

procedure safe(c, r)
    if rows[r]     ~= 0 then fail;
    if up[n+r-c]   ~= 0 then fail;
    if down[r+c-1] ~= 0 then fail;
    return;
end

procedure show()
    local sep, line, col;
    qcount +:= 1;
    sep := repl("-", 4*n+1);
    write("solution ", qcount, ":");
    every col := 1 to n do {
        write("  ", sep);
        line := repl("|   ", n) || "|";
        line[4*(placed[col]-1)+3] := "Q";
        write("  ", line);
    };
    write("  ", sep);
end

procedure try_col(c)
    local r;
    if c > n then { show(); return; };
    every r := 1 to n do {
        if safe(c, r) then {
            placed[c] := r;
            rows[r] := 1; up[n+r-c] := 1; down[r+c-1] := 1;
            try_col(c + 1);
            rows[r] := 0; up[n+r-c] := 0; down[r+c-1] := 0;
        };
    };
end

procedure main(args)
    n := integer(args[1]) | 6;
    placed := list(n, 0);
    rows   := list(n, 0);
    up     := list(2*n-1, 0);
    down   := list(2*n-1, 0);
    qcount := 0;
    write(n, "-Queens:");
    try_col(1);
    write(qcount, " solutions total.");
end
#--------------------------------------------- 744 procedure_every_alt_replace_8
# queens.icn — N-Queens via recursive backtracking
# Icon idiom: every-driven search, global constraint arrays
# Shows: recursive generators, every with if, global state, string mutation

global n, placed, rows, up, down, qcount

procedure safe(c, r)
    if rows[r]     ~= 0 then fail;
    if up[n+r-c]   ~= 0 then fail;
    if down[r+c-1] ~= 0 then fail;
    return;
end

procedure show()
    local sep, line, col;
    qcount +:= 1;
    sep := repl("-", 4*n+1);
    write("solution ", qcount, ":");
    every col := 1 to n do {
        write("  ", sep);
        line := repl("|   ", n) || "|";
        line[4*(placed[col]-1)+3] := "Q";
        write("  ", line);
    };
    write("  ", sep);
end

procedure try_col(c)
    local r;
    if c > n then { show(); return; };
    every r := 1 to n do {
        if safe(c, r) then {
            placed[c] := r;
            rows[r] := 1; up[n+r-c] := 1; down[r+c-1] := 1;
            try_col(c + 1);
            rows[r] := 0; up[n+r-c] := 0; down[r+c-1] := 0;
        };
    };
end

procedure main(args)
    n := integer(args[1]) | 6;
    placed := list(n, 0);
    rows   := list(n, 0);
    up     := list(2*n-1, 0);
    down   := list(2*n-1, 0);
    qcount := 0;
    write(n, "-Queens:");
    try_col(1);
    write(qcount, " solutions total.");
end
