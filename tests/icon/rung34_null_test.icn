#---------------------------------------------- 1 rung34_null_test_nonnull_fails
procedure main();
  if \(1 > 2) then write("yes") else write("no");
end
#------------------------------------------- 2 rung34_null_test_nonnull_in_every
procedure main();
  every write(\(1 to 3));
end
#------------------------------------------- 3 rung34_null_test_nonnull_succeeds
procedure main();
  x := \(1 + 2);
  write(x);
end
#------------------------------------------------- 4 rung34_null_test_null_fails
procedure main();
  if /(1 < 2) then write("yes") else write("no");
end
#---------------------------------------------- 5 rung34_null_test_null_succeeds
procedure main();
  x := /(1 > 2);
  write("ok");
end
