#------------------------------------------------------ 1 rung27_read_read_count
procedure main();
  local n;
  n := 0;
  while read() do
    n := n + 1;
  write(n);
end
#--------------------------------------------------- 2 rung27_read_read_eof_fail
procedure main();
  if read() then
    write("got line")
  else
    write("eof");
end
#------------------------------------------------------- 3 rung27_read_read_line
procedure main();
  local line;
  line := read();
  write(line);
end
#------------------------------------------------------- 4 rung27_read_read_loop
procedure main();
  local line;
  while line := read() do
    write(line);
end
#----------------------------------------------------- 5 rung27_read_reads_bytes
procedure main();
  local s;
  s := reads(5);
  write(s);
end
