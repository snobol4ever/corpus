#------------------------------------------------------ 1 rung22_lists_bang_list
procedure main();
  L := [1, 2, 3];
  every write(!L);
end
#------------------------------------------------------------ 2 rung22_lists_get
procedure main();
  L := [5, 6, 7];
  write(get(L));
  write(get(L));
end
#----------------------------------------------------------- 3 rung22_lists_pull
procedure main();
  L := [1, 2, 3];
  write(pull(L));
end
#-------------------------------------------------- 4 rung22_lists_push_put_size
procedure main();
  L := [];
  push(L, 10);
  push(L, 20);
  write(*L);
end
#------------------------------------------------------- 5 rung22_lists_put_bang
procedure main();
  L := [];
  put(L, 4);
  put(L, 5);
  put(L, 6);
  every write(!L);
end
