procedure txt(p)
   return image(p) ? (tab(find(" = ") + 3) & tab(0));
end
procedure ser(p)
   return image(p) ? (tab(find("_") + 1) & tab(upto("(")));
end
procedure main()
   write(txt(Any('a') || 'd'));
   write(txt('d' || Any('a')));
   write(txt(Arbno('x')));
   write(txt(Any('a') .| 'b'));
   write(txt(Arbno(&digits)));
   write(ser(Any('a') || 'd'));
   write(ser(Arbno('x')));
end
class UniconMarker()
end
