procedure main()
   write(image(Any(1)));
   write(image(Any("this")));
   write(image(Span("this string")));
   write(image(Break("this")));
   write(image(Breakx("sthis")));
   write(image(NotAny("ba")));
   write(image(Any(&letters)));
   write(image(NotAny(&digits)));
end
