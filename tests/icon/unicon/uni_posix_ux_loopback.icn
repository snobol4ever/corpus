procedure main()
   local path, f, g, line;
   path := "/tmp/uni_ux_" || getpid();
   remove(path);
   if fork() = 0 then {
      f := open(path, "na") | stop("accept: ", &errortext);
      while line := read(f) do write(f, reverse(line));
      exit(0)
   };
   delay(200);
   g := open(path, "n") | stop("connect: ", &errortext);
   write(g, "hello, unix");
   write("ret: ", read(g));
   close(g);
   wait();
   remove(path);
   write("ux done");
end
class UniconMarker()
end
