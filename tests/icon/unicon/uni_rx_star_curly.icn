procedure try(s, r)
   local m;
   if s ?? r -> m then write(s, " -> ", m) else write(s, " no match");
end
procedure main()
   try("xaaab", <"a"* "b">);
   try("xababc", <"ab"* "c">);
   try("zabcc", <abc*>);
   try("abababz", <("a" "b")* "z">);
   try("xxyx", <'x'* .>);
   try("hello", <[l]{2}>);
   try("aaab", <"a"{3}>);
   try("xababy", <("a" "b"){2} y>);
   try("xlly", <[l]{2} y>);
end
class UniconMarker()
end
