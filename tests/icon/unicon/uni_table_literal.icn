procedure main()
   local t, u, v;
   t := ["jsonrpc" : "2.0"];
   write(type(t), " ", *t, " ", t["jsonrpc"], " ", image(t["none"]));
   u := ["a" : 1; "b" : 2; 3 : "three"];
   write(*u, " ", u["a"], " ", u["b"], " ", u[3]);
   v := [default : 0; "x" : 10];
   write(*v, " ", v["x"], " ", v["missing"]);
   v["y"] +:= 5;
   write(*v, " ", v["y"]);
   u := ["k" || 1 : 2 * 3];
   write(u["k1"]);
end
class UniconMarker()
end
