procedure txt(p)
   return image(p) ? (tab(find(" = ") + 3) & tab(0));
end
procedure main()
   write(txt(Any('a')));
   write(txt(NotAny('\n')));
   write(txt(Span(&digits)));
   write(txt(Break(' ')));
   write(txt(Breakx(' ')));
   write(txt(Len(3)));
   write(txt(Pos(0)));
   write(txt(Pos(2)));
   write(txt(Pos(-3)));
   write(txt(Rpos(0)));
   write(txt(Tab(4)));
   write(txt(Rtab(0)));
   write(txt(Rem()));
   write(txt(Arb()));
   write(txt(Bal()));
   write(txt(Fence()));
   write(txt(Abort()));
   write(txt(Fail()));
   write(txt(Succeed()));
   write(txt(Arbno("c")));
   write(txt(Any('a') || "b"));
   write(txt("a" || Any('b')));
   write(txt(Any('a') || Any('b') || Any('c')));
   write(txt(Any('a') .| Any('b')));
   write(txt((Any('a') .| Any('b')) || Any('c')));
   write(txt(Any('a') || (Any('b') .| Any('c'))));
   write(txt(Any('a') .| (Any('b') .| Any('c'))));
   write(txt(Arbno(Any('a') .| Any('b'))));
   write(txt(Any('\t')));
   write(txt(Any(&lcase)));
   write(txt(Any('0123456789a')));
end
class UniconMarker()
end
