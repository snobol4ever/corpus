procedure f(x)
   return x;
end
procedure main()
   local i, j, s, a;
   i := 1;
   j := 2;
   s := "abc";
   a := [1, 2];
   if i < j then write("lt1");
   if *s < 5 then write("lt2");
   if a[1] < a[2] then write("lt3");
   if f(i) < 3 then write("lt4");
   if "abc" << "abd" then write("slt");
   if i < j < 3 then write("chain");
   i := i + 1 < 5;
   write(i);
end
class UniconMarker()
end
