procedure try(s, r)
   local m;
   if s ?? r -> m then write(s, " -> ", m) else write(s, " no match");
end
procedure main()
   try("xaaabb", <"a"+ "b">);
   try("xabbb", <[a][b]+>);
   try("xabccc", <abc+>);
   try("xababc", <"ab"+ c>);
   try("a color", <colou?r>);
   try("a colour", <colou?r>);
   try("xabay", <("a" | "b")+ "y">);
   try("xaby", <("a" | "b")+ "y">);
   try("xall", <"all"?>);
   try("xlly", <"a"? "ll" y>);
   try("x...y", <.+ y>);
   try("xaay", <[a]{2}+ y>);
   try("xbby", <([a] | [b]){2} y>);
end
class UniconMarker()
end
