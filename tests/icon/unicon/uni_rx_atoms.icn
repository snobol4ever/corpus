procedure try(s, r)
   local m;
   if s ?? r -> m then write(s, " -> ", m) else write(s, " no match");
end
procedure main()
   write(image(<abc>));
   write(image(<12>));
   try("hotdog", <"cat" | "dog">);
   try("the cat sat", <([f]|[c])"at">);
   try("xadz", <[a-c][^a-c]>);
   try("xabcx", <a.c>);
   try("xfat", <'f' | 'c'>);
   try("a b", <"a" " " "b">);
   try("xyz", <("x" "y") | "z">);
   try("zz", <("x" "y") | "z">);
   try("1234", <1 2>);
end
class UniconMarker()
end
