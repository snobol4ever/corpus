procedure show(v)
   write(&errornumber, " ", &errortext, " ", type(v));
end
procedure main()
   &error := 1;
   set([]) ++ 'a';
   show(&errorvalue);
   &error := 1;
   'a' ++ set([]);
   show(&errorvalue);
   &error := 1;
   [] ** [];
   show(&errorvalue);
   &error := 1;
   table() -- set();
   show(&errorvalue);
   write('abc' ** 'bcd');
   write(*(set([1]) ++ set([2])));
end
class UniconMarker()
end
