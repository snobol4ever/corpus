class UniconMarker()
end

procedure inner()
   local i;
   every i := -1 to 3 do
      write("cur ", i, " ", image(proc(&current, i)) | "fail");
   every i := -1 to 3 do
      write("main ", i, " ", image(proc(&main, i)) | "fail");
end

procedure outer()
   inner();
end

procedure main()
   local i;
   outer();
   every i := -1 to 2 do
      write("top ", i, " ", image(proc(&current, i)) | "fail");
   write(image(proc("write", 1)) | "fail", " ", image(proc(main)) | "fail");
end
