class S(d, e, f)
   method m1()
   end
   method m2()
   end
end
procedure main()
   local x;
   x := S(1, 2, 3);
   every writes(" ", !membernames(x)); write();
   every writes(" ", !membernames("S")); write();
   every writes(" ", !methodnames(x)); write();
   every writes(" ", !methodnames("S")); write();
   write(image(membernames("NoSuch")) | "fails");
end
