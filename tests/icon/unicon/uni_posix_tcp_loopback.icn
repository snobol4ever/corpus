procedure main()
   local port, f, g, line;
   port := "127.0.0.1:" || (20000 + ?20000);
   if fork() = 0 then {
      f := open(port, "na") | stop("accept: ", &errortext);
      while line := read(f) do write(f, reverse(line));
      exit(0)
   };
   delay(200);
   g := open(port, "n") | stop("connect: ", &errortext);
   write(g, "hello, world");
   write("ret: ", read(g));
   close(g);
   wait();
   write("tcp done");
end
class UniconMarker()
end
