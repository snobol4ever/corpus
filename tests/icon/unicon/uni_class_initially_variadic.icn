class Bag(name, items)
   method show();
      write(name, " has ", *items);
      every writes(" ", image(!items));
      write();
   end
   initially(label, rest[]);
      name := label;
      items := rest;
end
class Pair(p, q)
   initially(a[]);
      p := *a;
      q := a;
end
procedure main();
   local b, c;
   b := Bag("one", 1, "two", 3.5);
   b.show();
   b := Bag("none");
   b.show();
   c := Pair(7, 8, 9);
   write(c.p, " ", image(c.q[2]));
   c := Pair();
   write(c.p, " ", *c.q);
end
