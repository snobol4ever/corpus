procedure main()
   local a, b;
   if not (&features == "concurrent threads") then stop("no threads");
   write("create two threads");
   a := thread greet(1);
   b := thread greet(2);
   write(<<@ a);
   write(<<@ b);
   wait(a); wait(b);
   write("joined");
end
procedure greet(n)
   ("hello from thread " || n) @>>;
end
