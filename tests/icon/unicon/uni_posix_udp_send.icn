procedure main()
   local port, f, r;
   port := 20000 + ?20000;
   f := open(":" || port, "nua") | stop("udp open: ", &errortext);
   write("send: ", image(send("127.0.0.1:" || port, "zz")));
   if *select(f, 2000) > 0 then { r := receive(f); write("got ", image(r.msg)) } else write("timeout");
   close(f);
   write("send done");
end
class UniconMarker()
end
