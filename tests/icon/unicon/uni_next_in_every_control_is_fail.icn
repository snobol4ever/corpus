procedure main()
   local i;
   every !["x1", "no", "x2"] ? { (="x") | next; writes(tab(0), " "); };
   write();
   i := 0;
   while (i +:= 1) <= 2 do {
      every !["x1", "no", "x2"] ? { (="x") | next; writes(i, tab(0), " "); };
      writes("| ");
   };
   write();
   every i := 1 to 2 do {
      every !["x1", "no"] ? { (="x") | next; writes(i, tab(0), " "); };
      writes("| ");
   };
   write();
end
class UniconMarker()
end
