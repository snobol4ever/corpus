procedure main()
   local L, pid;
   L := pipe() | stop("pipe: ", &errortext);
   every write(L[2], "b" | "a" | "c");
   close(L[2]);
   pid := system(["cat", "-n"], L[1], &output, &errout, "nowait") | stop("system: ", &errortext);
   write(type(pid));
   close(L[1]);
   wait(pid);
   write("spawn done");
end
class UniconMarker()
end
