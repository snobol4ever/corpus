procedure main()
   local p, m, r;
   p := <([f]|[c])"at">;
   p := p -> m || Rem() -> r;
   if "the cat sat" ?? p then write(m, "|", r);
   p := <"a"+ "b"? [c-e]{2}>;
   if "xaabdd" ?? p -> m then write(m);
   p := <'x'* .>;
   if "xxxy" ?? p -> m then write(m);
   write(type(<a|b>));
end
class UniconMarker()
end
