procedure main()
   local a, b, t;
   if not (&features == "concurrent threads") then stop("no threads");
   a := thread A(); b := thread B();
   b @> a;
   a @> b;
   "Main" @> a;
   t := <<@ a;
   write(t || " ==> Main");
   wait(a); wait(b);
end
procedure A()
   local b, t;
   b := <<@;
   t := <<@;
   (t || " ==> A") @>> b;
   t := <<@ b;
   (t || " ==> A") @>>;
end
procedure B()
   local a, t;
   a := <<@;
   t := <<@;
   (t || " ==> B") @>>;
end
