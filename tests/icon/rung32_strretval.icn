#----------------------------------------------- 1 rung32_strretval_basic_strret
procedure greet(name);
  return "hello " || name;
end
procedure main();
  write(greet("world"));
end
#------------------------------------------------------ 2 rung32_strretval_chain
procedure prefix(s);
  return "pre:" || s;
end
procedure suffix(s);
  return s || ":suf";
end
procedure wrap(s);
  return prefix(suffix(s));
end
procedure main();
  write(wrap("mid"));
end
#---------------------------------------------- 3 rung32_strretval_strret_assign
procedure shout(s);
  return s || "!";
end
procedure main();
  r := shout("hi");
  write(r);
  write(shout("bye"));
end
#----------------------------------------------- 4 rung32_strretval_strret_every
procedure tag(s);
  return "[" || s || "]";
end
procedure main();
  every write(tag("a" | "b" | "c"));
end
#--------------------------------------------- 5 rung32_strretval_two_str_params
procedure join(a, b);
  return a || "-" || b;
end
procedure main();
  write(join("foo", "bar"));
  write(join("hello", "world"));
end
