#-------------------------------------------------- 1 rung16_subscript_sub_basic
procedure main();
  s := "hello";
  write(s[1]);
  write(s[3]);
  write(s[5]);
end
#-------------------------------------------------- 2 rung16_subscript_sub_every
procedure main();
  s := "abc";
  every write(s[1 to 3]);
end
#--------------------------------------------------- 3 rung16_subscript_sub_fail
procedure main();
  s := "hi";
  if s[5] then write("yes") else write("no");
end
#------------------------------------------------ 4 rung16_subscript_sub_literal
procedure main();
  write("icon"[2]);
end
#---------------------------------------------------- 5 rung16_subscript_sub_neg
procedure main();
  s := "hello";
  write(s[-1]);
  write(s[-2]);
end
