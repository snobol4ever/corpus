procedure main()
   local first, i, c, s;
   first := cset("abc");
   s := "";
   every i := 1 to 1200 do {
      c := cset(string(i)) ++ &letters;
      s := string(c);
   };
   write(image(first), " ", *first, " ", string(first));
   write(*s);
   c := first ++ 'z';
   write(image(c), " ", *c);
end
