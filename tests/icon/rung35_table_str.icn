#---------------------------------------- 1 rung35_table_str_str_default_int_key
procedure main();
  local t;
  t := table("none");
  t[1] := "yes";
  write(t[1]);
  write(t[2]);
end
#--------------------------------------------- 2 rung35_table_str_str_table_read
procedure main();
  local t;
  t := table("0");
  t["alice"] := "1";
  t["bob"] := "1";
  write(t["alice"]);
  write(t["bob"]);
  write(t["carol"]);
end
