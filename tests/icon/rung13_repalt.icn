#--------------------------------------------------------- 1 rung13_repalt_empty
procedure main();
  every write(|(1 to 0) \ 3);
  write("done");
end
#----------------------------------------------------------- 2 rung13_repalt_int
procedure main();
  every write(|1 \ 3);
end
#----------------------------------------------------------- 3 rung13_repalt_str
procedure main();
  every write(|"hi" \ 2);
end
#------------------------------------------------------------ 4 rung13_repalt_to
procedure main();
  every write(|(1 to 2) \ 5);
end
#----------------------------------------------------------- 5 rung13_repalt_to3
procedure main();
  every write(|(1 to 3) \ 7);
end
#----------------------------------------------------------- 6 rung13_repalt_var
procedure main();
  x := 5;
  every write(|x \ 3);
end
