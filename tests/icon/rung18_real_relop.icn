#----------------------------------------------- 1 rung18_real_relop_mixed_relop
procedure main();
  n := 2;
  if n < 2.5 then write("yes") else write("no");
end
#--------------------------------------------------- 2 rung18_real_relop_real_eq
procedure main();
  x := 3.0;
  if x = 3.0 then write("equal") else write("nope");
end
#--------------------------------------------------- 3 rung18_real_relop_real_gt
procedure main();
  if 1.5 > 2.5 then write("gt") else write("le");
end
#--------------------------------------------------- 4 rung18_real_relop_real_lt
procedure main();
  x := 2.5;
  y := 3.0;
  if x < y then write("yes") else write("no");
end
#------------------------------------------- 5 rung18_real_relop_real_relop_goal
procedure main();
  every write(3.0 < (2.5 | 3.5 | 4.5));
end
