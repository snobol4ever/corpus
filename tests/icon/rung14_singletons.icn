#------------------------------------------------------ 1 rung14_case_return_arm
procedure main();
    write(f(2));
    write(f(1));
    write(f(9));
end
procedure f(x);
    case x of {
        1: return "a";
        2: { write("side"); return "b" }
    };
    return "c";
end
#------------------------------------------------------- 2 rung15_iterate_string
procedure main();
  s := "xyz";
  every write(!s);
end
#---------------------------------------------------- 3 rung16_seqexpr_gen_basic
# rung16 A5: generative seq-expr (side-effect; alternate) as direct every generator
procedure main()
  x := 0;
  every (x := x + 10; "a" | "b" | "c");
  write(x);
end
