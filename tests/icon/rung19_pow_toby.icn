#----------------------------------------------------- 1 rung19_pow_toby_pow_int
procedure main();
  write(2^10);
end
#---------------------------------------------------- 2 rung19_pow_toby_pow_real
procedure main();
  write(2.0^0.5);
end
#----------------------------------------------------- 3 rung19_pow_toby_pow_var
procedure main();
  x := 3.0;
  write(x^2);
end
#----------------------------------------------- 4 rung19_pow_toby_real_toby_neg
procedure main();
  every write(3.0 to 1.0 by -1.0);
end
#----------------------------------------------- 5 rung19_pow_toby_real_toby_pos
procedure main();
  every write(1.0 to 2.0 by 0.5);
end
