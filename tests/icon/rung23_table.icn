#---------------------------------------------------- 1 rung23_table_table_basic
procedure main();
  local t;
  t := table(0);
  t[1] := 42;
  write(t[1]);
end
#-------------------------------------------------- 2 rung23_table_table_default
procedure main();
  local t;
  t := table(99);
  t[1] := 7;
  write(t[1]);
  write(t[2]);
end
#-------------------------------------------- 3 rung23_table_table_insert_delete
procedure main();
  local t;
  t := table(0);
  insert(t, 1, 10);
  insert(t, 2, 20);
  write(t[1]);
  write(t[2]);
  delete(t, 1);
  write(t[1]);
end
#------------------------------------------------------ 4 rung23_table_table_key
procedure main();
  local t, total;
  t := table(0);
  t[1] := 10;
  t[2] := 20;
  t[3] := 30;
  total := 0;
  every total +:= t[key(t)];
  write(total);
end
#--------------------------------------------------- 5 rung23_table_table_member
procedure main();
  local t;
  t := table(0);
  t[5] := 1;
  if member(t, 5) then write(1);
  if member(t, 9) then write(2);
  write(3);
end
