#---------------------------------------------------------- 1 rung26_pow_int_pow
procedure main();
  write(2 ^ 10);
  write(3 ^ 3);
end
#-------------------------------------------------------- 2 rung26_pow_pow_assoc
procedure main();
  write(2 ^ 2 ^ 3);
end
#--------------------------------------------------------- 3 rung26_pow_pow_expr
procedure main();
  local x;
  x := 2 ^ 3 + 1;
  write(x);
end
#--------------------------------------------------------- 4 rung26_pow_pow_zero
procedure main();
  write(5 ^ 0);
  write(0 ^ 5);
end
#--------------------------------------------------------- 5 rung26_pow_real_pow
procedure main();
  write(4.0 ^ 0.5);
  write(2.0 ^ 8.0);
end
