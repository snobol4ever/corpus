#-------------------------------------------- 1 rung35_block_body_every_do_block
procedure main();
  every x := 1 to 3 do {
    y := x * 2;
    write(y);
  };
end
#------------------------------------------- 2 rung35_block_body_every_gen_block
procedure main();
  L := [10, 20, 30];
  every v := !L do {
    w := v + 100;
    write(w);
  };
  write("break");
  every v := !L do {
    if v = 20 then break;
    write(v);
  };
  write("next");
  every v := !L do {
    if v = 20 then next;
    write(v);
  };
end
#-------------------------------------------------- 3 rung35_block_body_if_block
procedure main();
  x := 5;
  if x > 3 then {
    write("big");
    write(x);
  };
end
#--------------------------------------------- 4 rung35_block_body_if_else_block
procedure main();
  x := 2;
  if x > 3 then {
    write("big");
  } else {
    write("small");
    write(x);
  };
end
#---------------------------------------------- 5 rung35_block_body_nested_block
procedure main();
  total := 0;
  every x := 1 to 3 do {
    total +:= x;
  };
  write(total);
end
#-------------------------------------------- 6 rung35_block_body_while_do_block
procedure main();
  i := 1;
  while i <= 3 do {
    write(i);
    i +:= 1;
  };
end
