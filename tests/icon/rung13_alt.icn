#---------------------------------------------------- 1 rung13_alt_alt_augconcat
procedure main();
  s := "";
  every s ||:= ("a"|"b"|"c");
  write(s);
end
#---------------------------------------------------- 2 rung13_alt_alt_cross_arg
procedure main();
  every write(1 | 2, ":", 3 | 4);
end
#----------------------------------------- 3 rung13_alt_alt_cross_arg_sideeffect
procedure noisy();
  write("[eval]");
  return "X";
end
procedure main();
  every write(1 | 2, noisy(), 3 | 4);
end
#-------------------------------------------------- 4 rung13_alt_alt_every_write
procedure main();
  every write("a"|"b"|"c");
end
#------------------------------------------------------- 5 rung13_alt_alt_filter
procedure main();
  every (x := (1|2|3|4|5)) > 2 & write(x);
end
#---------------------------------------------------------- 6 rung13_alt_alt_int
procedure main();
  every write(1|2|3);
end
#------------------------------------------------------- 7 rung13_alt_alt_nested
procedure main();
  every write(("a"|"b") || ("x"|"y"));
end
#------------------------------------------------------- 8 rung13_alt_return_arm
procedure absv(n);
  n > 0 | return -n;
  return n;
end
procedure main();
  write(absv(5));
  write(absv(-7));
  every write((1 to 2) | (8 to 9));
end
