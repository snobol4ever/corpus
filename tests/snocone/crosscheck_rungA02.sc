x =;
OUTPUT = x;
/*---------------------------------------------------- 4 A02_assign_overwrite */
// A02_assign_overwrite.sc — overwrite variable, output second value
x = 'first';
x = 'second';
OUTPUT = x;
/*------------------------------------------------------- 5 A02_assign_string */
// A02_assign_string.sc — assign string to variable, output it
