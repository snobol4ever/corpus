(STMT :subj (TT_WHILE
  (TT_FNC EQ (TT_VAR x) (TT_ILIT 1))
  (TT_PROGRAM
    (TT_STMT
      (TT_ATTR :line (TT_QLIT "2"))
      (TT_ATTR :stno (TT_QLIT "1"))
      (TT_ATTR :incl (TT_QLIT "1"))
      (TT_ATTR :src (TT_QLIT "        <stmt 1, line 2: source not in main file (INCLUDE)>"))
      (TT_ATTR :subj (TT_LOOP_NEXT))
    )
  )
))
