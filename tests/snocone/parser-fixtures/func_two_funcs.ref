(STMT :subj (TT_DEFINE
  (TT_QLIT "p")
  (TT_QLIT "p()")
  (TT_PROGRAM (TT_STMT (TT_ATTR :line (TT_QLIT "1")) (TT_ATTR :stno (TT_QLIT "1")) (TT_ATTR :subj (TT_RETURN))))
))
(STMT :subj (TT_DEFINE
  (TT_QLIT "q")
  (TT_QLIT "q(x)")
  (TT_PROGRAM
    (TT_STMT
      (TT_ATTR :line (TT_QLIT "2"))
      (TT_ATTR :stno (TT_QLIT "3"))
      (TT_ATTR :subj (TT_VAR q))
      (TT_ATTR :eq)
      (TT_ATTR :repl (TT_VAR x))
    )
    (TT_STMT (TT_ATTR :line (TT_QLIT "2")) (TT_ATTR :stno (TT_QLIT "4")) (TT_ATTR :subj (TT_RETURN)))
  )
))
