#---------------------------------------------- 465 benchmark_rc-man-or-boy-test
sub A ($k is copy, $x1, $x2, $x3, $x4, $x5) {
    my $B := { A(--$k, $B, $x1, $x2, $x3, $x4) };
    $k <= 0 ?? $x4() + $x5() !! $B();
}

say A(10, {1}, {-1}, {-1}, {1}, {0});
