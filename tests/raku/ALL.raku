#--------------------------------------------------- 87 smartmatch_say_replace_1
my $s = "hello";
if ($s ~~ /e(l+)(o)/) { say($1); }
#--------------------------------------------------- 88 smartmatch_say_replace_2
my $s = "hello";
if ($s ~~ /(?<word>\w+)/) { say($<word>); }
#--------------------------------------------------- 89 smartmatch_say_replace_3
my $s = "hello";
if ($s ~~ /e(l+)/) { say($0); }
#--------------------------------------------------- 90 smartmatch_say_replace_4
my $s = "x";
if ($s ~~ /^x$/) { say("anchor"); }
#--------------------------------------------------- 91 smartmatch_say_replace_5
my $s = "hello world";
if ($s ~~ /\s+/) { say("space"); }
#--------------------------------------------------- 92 smartmatch_say_replace_6
my $s = "anything";
if ($s ~~ /.*/) { say("match"); }
#--------------------------------------------------- 93 smartmatch_say_replace_7
my $s = "hello";
if ($s ~~ /ell/) { say("match"); }
#----------------------------------------------------- 94 smartmatch_array_say_1
my $s = "aaa";
my @m = ($s ~~ m:g/a/);
say(@m);
#--------------------------------------------------- 95 smartmatch_say_replace_8
my $s = "abc123";
if ($s ~~ /\d+/) { say("digit"); }
if ($s ~~ /[a-z]+/) { say("lower"); }
if ($s ~~ /a|b/) { say("alt"); }
