sub anyval($x) { return $x }
say "abc".chars;
say "abc".uc;
say "Hello".lc;
say "abc".flip;
say (1, 2, 3).elems;
say [4, 5, 6].elems;
say (-7).abs;
say 16.sqrt;
say 3.7.Int;
say "42".Int + 1;
say 5.Str ~ "x";
say (3/4).numerator;
say (1, 2, 3).join("-");
say (3, 1, 2).sort.join(",");
say {a => 1, b => 2}.keys.sort.join(",");
say (1..5).sum;
say "a,b,c".split(",").elems;
say "hello world".words.join("|");
say "hello".index("l");
say "hello".substr(1, 3);
say "Hello".starts-with("He");
say 10.base(2);
say 255.fmt("%x");
say 3.14159.round(0.01);
my $v = anyval("dyn");
say $v.chars;
say $v.uc;
$v = anyval([1, 2]);
say $v.elems;
$v = anyval(2.5);
say $v.floor;
$v = anyval({x => 1});
say $v.keys.join;
