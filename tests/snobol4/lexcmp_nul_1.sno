        A = CHAR(0) CHAR(2) CHAR(4)
        B = CHAR(0) CHAR(2)
        C = CHAR(0) CHAR(9)
        D = CHAR(0) CHAR(2) CHAR(4)
        OUTPUT = 'sizes ' SIZE(A) ' ' SIZE(B) ' ' SIZE(C)
        OUTPUT = LGT(A,B) 'LGT(A,B) yes'                :S(L1)
        OUTPUT = 'LGT(A,B) no'
L1      OUTPUT = LLT(B,A) 'LLT(B,A) yes'                :S(L2)
        OUTPUT = 'LLT(B,A) no'
L2      OUTPUT = LEQ(A,C) 'LEQ(A,C) yes'                :S(L3)
        OUTPUT = 'LEQ(A,C) no'
L3      OUTPUT = LNE(A,C) 'LNE(A,C) yes'                :S(L4)
        OUTPUT = 'LNE(A,C) no'
L4      OUTPUT = LGE(A,B) 'LGE(A,B) yes'                :S(L5)
        OUTPUT = 'LGE(A,B) no'
L5      OUTPUT = LLE(B,A) 'LLE(B,A) yes'                :S(L6)
        OUTPUT = 'LLE(B,A) no'
L6      OUTPUT = LGE(B,A) 'LGE(B,A) yes'                :S(L7)
        OUTPUT = 'LGE(B,A) no'
L7      OUTPUT = LLE(A,B) 'LLE(A,B) yes'                :S(L8)
        OUTPUT = 'LLE(A,B) no'
L8      OUTPUT = LEQ(A,D) 'LEQ(A,D) yes'                :S(L9)
        OUTPUT = 'LEQ(A,D) no'
L9      OUTPUT = LLT(C,A) 'LLT(C,A) yes'                :S(L10)
        OUTPUT = 'LLT(C,A) no'
L10     OUTPUT = LGT(C,A) 'LGT(C,A) yes'                :S(L11)
        OUTPUT = 'LGT(C,A) no'
L11     OUTPUT = LGT('abc','ab') 'LGT(abc,ab) yes'      :S(L12)
        OUTPUT = 'LGT(abc,ab) no'
L12     OUTPUT = LGT('ab','abc') 'LGT(ab,abc) yes'      :S(L13)
        OUTPUT = 'LGT(ab,abc) no'
L13     OUTPUT = LEQ('','') 'LEQ(null,null) yes'        :S(L14)
        OUTPUT = 'LEQ(null,null) no'
L14     OUTPUT = LGT(CHAR(255) , CHAR(1)) 'LGT(255,1) yes' :S(L15)
        OUTPUT = 'LGT(255,1) no'
L15     OUTPUT = LGT(3, 12) 'LGT(3,12) yes'             :S(L16)
        OUTPUT = 'LGT(3,12) no'
L16     OUTPUT = 'done'
END
