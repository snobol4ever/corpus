 X = 'hello'; IDENT(X, 'hello') :S(OK)F(FAIL);OK OUTPUT = 'PASS' :(END);FAIL OUTPUT = 'FAIL';END;* f01_core_labels_goto
*-------------------------------------------------------------- 2 f02_string_ops
        S = 'abcdef'
        IDENT(SIZE(S), 6)                       :F(FAIL)
        IDENT(SUBSTR(S, 2, 3), 'bcd')           :F(FAIL)
        IDENT(DUPL('ab', 3), 'ababab')          :F(FAIL)
        IDENT(REPLACE('aeiou','aeiou','AEIOU'), 'AEIOU')  :F(FAIL)
        IDENT(REVERSE('abc'), 'cba')            :F(FAIL)
        IDENT(TRIM('hello   '), 'hello')        :F(FAIL)
        OUTPUT = 'PASS'                         :(END)
FAIL    OUTPUT = 'FAIL'
END
 EQ(2 + 3, 5) :F(FAIL); GT(10, 5) :F(FAIL); LT(3, 7) :F(FAIL); NE(1, 2) :F(FAIL); GT(1.5, 1.0) :F(FAIL); EQ(REMDR(10, 3), 1) :F(FAIL); OUTPUT = 'PASS' :(END);FAIL OUTPUT = 'FAIL';END;* f03_numeric
*------------------------------------------------------ 4 f04_pattern_primitives
        'hello' POS(0) 'he' RPOS(3)            :F(FAIL)
        'abcde' ANY('abc')                      :F(FAIL)
        'abcxyz' SPAN('abc') . V
        IDENT(V, 'abc')                         :F(FAIL)
        'abcxyz' BREAK('x') . V
        IDENT(V, 'abc')                         :F(FAIL)
        'hi' ARB                                :F(FAIL)
        'aaa' ARBNO('a')                        :F(FAIL)
        'hello' LEN(3)                          :F(FAIL)
        'abc' TAB(2)                            :F(FAIL)
        'abc' RTAB(1)                           :F(FAIL)
        'abc' REM                               :F(FAIL)
        OUTPUT = 'PASS'                         :(END)
FAIL    OUTPUT = 'FAIL'
END
*----------------------------------------------------------------- 5 f05_capture
        S = 'hello world'
        S SPAN(&LCASE) . W
        IDENT(W, 'hello')                       :F(FAIL)
        N = 99
        'abcdef' LEN(3) $ V @N
        IDENT(V, 'abc')                         :F(FAIL)
        EQ(N, 3)                                :F(FAIL)
        OUTPUT = 'PASS'                         :(END)
FAIL    OUTPUT = 'FAIL'
END
*----------------------------------------------------- 6 f06_builtins_predicates
        IDENT('a', 'a')                         :F(FAIL)
        DIFFER('a', 'b')                        :F(FAIL)
        INTEGER(42)                             :F(FAIL)
        LGT('b', 'a')                           :F(FAIL)
        IDENT(DATATYPE(42), 'INTEGER')          :F(FAIL)
        IDENT(DATATYPE('hi'), 'STRING')         :F(FAIL)
        IDENT(CONVERT(3, 'STRING'), '3')        :F(FAIL)
        OUTPUT = 'PASS'                         :(END)
FAIL    OUTPUT = 'FAIL'
END
*---------------------------------------------------------------- 7 f07_keywords
        IDENT(SIZE(&ALPHABET), 256)             :F(FAIL)
        IDENT(SIZE(&UCASE), 26)                 :F(FAIL)
        IDENT(SIZE(&LCASE), 26)                 :F(FAIL)
        &ANCHOR = 1
        'xyz' POS(0) 'x'                        :F(FAIL)
        &ANCHOR = 0
        OUTPUT = 'PASS'                         :(END)
FAIL    OUTPUT = 'FAIL'
END
*-------------------------------------------------------- 8 f08_data_array_table
        DATA('POINT(X,Y)')
        P = POINT(3, 4)
        IDENT(DATATYPE(P), 'POINT')             :F(FAIL)
        EQ(X(P), 3)                             :F(FAIL)
        A = ARRAY(3, 0)
        A<2> = 99
        EQ(A<2>, 99)                            :F(FAIL)
        T = TABLE()
        T<'key'> = 'val'
        IDENT(T<'key'>, 'val')                  :F(FAIL)
        OUTPUT = 'PASS'                         :(END)
FAIL    OUTPUT = 'FAIL'
END
*--------------------------------------------------------------- 9 f09_functions
        DEFINE('FACT(N)')
        EQ(FACT(5), 120)                        :F(FAIL)
        OUTPUT = 'PASS'                         :(END)
FAIL    OUTPUT = 'FAIL'                         :(END)
FACT    EQ(N, 0)                               :S(FACT_Z)
        FACT = N * FACT(N - 1)                 :(RETURN)
FACT_Z  FACT = 1                               :(RETURN)
END
*------------------------------------------------------------ 10 f12_load_unload
        DEFINE('MYFN(X)')
        IDENT(MYFN('hello'), 'hello')           :F(FAIL)
        UNLOAD('MYFN')
        &ERRLIMIT = 1
        SETEXIT('OK')
        MYFN('a')
        OUTPUT = 'FAIL'                         :(END)
OK      OUTPUT = 'PASS' :(END)
FAIL    OUTPUT = 'FAIL'                         :(END)
MYFN    MYFN = X                               :(RETURN)
END
*---------------------------------------------------------------- 11 f14_dyn_opt
        COUNT = 0
        I = 0
LOOP    LT(I, 10)                               :F(DONE)
        S = 'hello world'
        S 'hello'                               :F(FAIL)
        COUNT = COUNT + 1
        I = I + 1                               :(LOOP)
DONE    EQ(COUNT, 10)                           :F(FAIL)
        OUTPUT = 'PASS'                         :(END)
FAIL    OUTPUT = 'FAIL'
END
*------------------------------------------------------------------ 12 f14_opsyn
        OPSYN('STRLEN', 'SIZE')
        EQ(STRLEN('hello'), 5)                  :F(FAIL)
        OPSYN('LENGTH', 'SIZE', 0)
        EQ(LENGTH('hello'), 5)                  :F(FAIL)
        OPSYN('&', 'DIFFER', 2)
        X = IDENT(1 & 2) 'differs'
        IDENT(X, 'differs')                     :F(FAIL)
        Y = 'same'
        Y = IDENT(1 & 1) 'differs'
        IDENT(Y, 'same')                        :F(FAIL)
        OUTPUT = 'PASS'                         :(END)
FAIL    OUTPUT = 'FAIL'
END
 IDENT(SIZE(&UCASE), 26) :F(FAIL); OUTPUT = 'PASS';END;* f16_cli_switches
 OUTPUT = 'PASS';END;* f17_include
 R = 3.14; INTEGER(R) :S(FAIL); IDENT(DATATYPE(R), 'REAL') :F(FAIL); GT(R, 3.0) :F(FAIL); EQ(CHOP(3.9), 3.0) :F(FAIL); OUTPUT = 'PASS' :(END);FAIL OUTPUT = 'FAIL';END;* f19_real_numbers
 IDENT(SIZE(&ALPHABET), 256) :F(FAIL); OUTPUT = 'PASS' :(END);FAIL OUTPUT = 'FAIL';END;* f20_alphabet_unicode
