        OUTPUT = DUPL('ab',3)
        OUTPUT = DUPL('xy',0)
        DUPL('xy',-1)                                     :S(bad1)
        OUTPUT = 'dupl-negative-failed-ok'                  :(chk2)
bad1    OUTPUT = 'dupl-negative-succeeded-bad'
chk2    'abcdef' DUPL(LEN(1),3) . V                        :F(bad2)
        OUTPUT = 'dupl-pattern=' V                            :(fin)
bad2    OUTPUT = 'dupl-pattern-failed-bad'
fin
END
