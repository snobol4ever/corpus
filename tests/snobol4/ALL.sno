        xTrace = 0 ; doParseTree = FALSE
        p7 = TV(0, LEN(5), 'HELLO')
        IDENT(REPLACE(DATATYPE(p7), &LCASE, &UCASE), dPATTERN)                :S(P7)F(F7)
