*------------------------------------------------- 1340 keyword_replace_branch_3
*  k41 -- the IMMEDIATE pattern lambda, LANDED ARM ONLY (row lang-lambda-pattern-primitives).
*  ⭐ WHY THIS EXISTS BESIDE k40 RATHER THAN INSTEAD OF IT: k40 is the row's INSTRUMENT, authored
*  before the cure and RED ON PURPOSE until the whole feature lands (conditional lambda, backtrack
*  unqueue, and the stored-pattern round trip are all still unlanded). A red instrument cannot also
*  be a regression guard -- so this file grades the part that IS landed and is green today, and k40
*  keeps measuring the distance still to go. Deleting either one would lose a different thing.
*  ⛔ SELF-PINNED, NEVER sbl-GRADED: SPITBOL cannot even LEX this file -- sbl -bf dies at the Greek
*  line with ERROR 230 "syntax error: illegal character".
        &ANCHOR = 0
*  1. assignment expression inside the lambda, evaluated when the cursor passes
        N = 0
        X = 'ab'
        X 'a' LAMBDA(N = 5) 'b'                     :F(F1)
        OUTPUT = 'k41.1 matched N=' N               :(T2)
F1      OUTPUT = 'k41.1 FAIL'
*  2. expression FAILURE fails the match at that point
T2      X 'a' LAMBDA(LT(2, 1)) 'b'                  :S(F2)
        OUTPUT = 'k41.2 expr failure failed the match' :(T3)
F2      OUTPUT = 'k41.2 FAIL'
*  3. expression SUCCESS matches the null string and consumes nothing
T3      X 'a' LAMBDA(LT(1, 2)) 'b'                  :F(F3)
        OUTPUT = 'k41.3 expr success matched epsilon' :(T4)
F3      OUTPUT = 'k41.3 FAIL'
*  4. the Greek spelling is first-class and means the same thing
T4      M = 0
        X 'a' Λ(M = 7) 'b'                          :F(F4)
        OUTPUT = 'k41.4 greek matched M=' M         :(T5)
F4      OUTPUT = 'k41.4 FAIL'
*  5. IMMEDIATE is not undone by a later failure in the same match
T5      K = 0
        X 'a' LAMBDA(K = 3) LAMBDA(LT(2, 1)) 'b'    :S(F5)
        OUTPUT = 'k41.5 K=' K ' after failed match' :(END)
F5      OUTPUT = 'k41.5 FAIL'
END
*------------------------------------------- 1341 table_array_datatype_replace_1
* proto_faces.sno — EVERY PROTOTYPE FACE, EACH SPELLED TWICE: BARE, THEN WITH AN EXCESS ARGUMENT.
* Manual Ch.8 (and stage2.h nformals): only FORMALS bind arguments and EXCESS ARGUMENTS ARE
* EVALUATED THEN IGNORED, so the `_x` line of every pair must be BYTE-IDENTICAL to the line above
* it -- same VALUE and same DATATYPE.  Companion to proto_excess_arg.sno (which isolates the
* trigger on two faces); this file is the WIDTH: array bare/string/range/multi-dim/negative-lower,
* table default/explicit/two-arg/comma-elided/COPY-carried, and the SORT-built array.
* ⛔ NO INVALID-OBJECT FACE IS PINNED HERE ON PURPOSE.  PROTOTYPE of a STRING, an INTEGER, a REAL,
* a DATA object or the null string is ERROR 164 on the oracle, and its arm is a fatal error dump --
* no .ref may pin a SPITBOL error report (the s190/s191 trap).  That half is verified by hand.
* Oracle: x64/bin/sbl -bf (the ONE arm; sbl_flags() in scorecard_snobol4.sh).
        t = TABLE()
        t<'cat'> = 'dog'
        t<7> = 45
        OUTPUT = 'arr_bare    = ' PROTOTYPE(ARRAY(3)) ' / ' DATATYPE(PROTOTYPE(ARRAY(3)))
        OUTPUT = 'arr_bare_x  = ' PROTOTYPE(ARRAY(3),1) ' / ' DATATYPE(PROTOTYPE(ARRAY(3),1))
        OUTPUT = 'arr_str3    = ' PROTOTYPE(ARRAY('3')) ' / ' DATATYPE(PROTOTYPE(ARRAY('3')))
        OUTPUT = 'arr_str3_x  = ' PROTOTYPE(ARRAY('3'),1) ' / ' DATATYPE(PROTOTYPE(ARRAY('3'),1))
        OUTPUT = 'arr_1_3     = ' PROTOTYPE(ARRAY('1:3')) ' / ' DATATYPE(PROTOTYPE(ARRAY('1:3')))
        OUTPUT = 'arr_1_3_x   = ' PROTOTYPE(ARRAY('1:3'),1) ' / ' DATATYPE(PROTOTYPE(ARRAY('1:3'),1))
        OUTPUT = 'arr_2c3     = ' PROTOTYPE(ARRAY('2,3')) ' / ' DATATYPE(PROTOTYPE(ARRAY('2,3')))
        OUTPUT = 'arr_2c3_x   = ' PROTOTYPE(ARRAY('2,3'),1) ' / ' DATATYPE(PROTOTYPE(ARRAY('2,3'),1))
        OUTPUT = 'arr_1_2c1_3 = ' PROTOTYPE(ARRAY('1:2,1:3')) ' / ' DATATYPE(PROTOTYPE(ARRAY('1:2,1:3')))
        OUTPUT = 'arr_1_2c_x  = ' PROTOTYPE(ARRAY('1:2,1:3'),1) ' / ' DATATYPE(PROTOTYPE(ARRAY('1:2,1:3'),1))
        OUTPUT = 'arr_0_5     = ' PROTOTYPE(ARRAY('0:5')) ' / ' DATATYPE(PROTOTYPE(ARRAY('0:5')))
        OUTPUT = 'arr_0_5_x   = ' PROTOTYPE(ARRAY('0:5'),1) ' / ' DATATYPE(PROTOTYPE(ARRAY('0:5'),1))
        OUTPUT = 'arr_m2_2    = ' PROTOTYPE(ARRAY('-2:2')) ' / ' DATATYPE(PROTOTYPE(ARRAY('-2:2')))
        OUTPUT = 'arr_m2_2_x  = ' PROTOTYPE(ARRAY('-2:2'),1) ' / ' DATATYPE(PROTOTYPE(ARRAY('-2:2'),1))
        OUTPUT = 'arr_3d      = ' PROTOTYPE(ARRAY('2,3,4')) ' / ' DATATYPE(PROTOTYPE(ARRAY('2,3,4')))
        OUTPUT = 'arr_3d_x    = ' PROTOTYPE(ARRAY('2,3,4'),1) ' / ' DATATYPE(PROTOTYPE(ARRAY('2,3,4'),1))
        OUTPUT = 'tbl_dflt    = ' PROTOTYPE(TABLE()) ' / ' DATATYPE(PROTOTYPE(TABLE()))
        OUTPUT = 'tbl_dflt_x  = ' PROTOTYPE(TABLE(),1) ' / ' DATATYPE(PROTOTYPE(TABLE(),1))
        OUTPUT = 'tbl_5       = ' PROTOTYPE(TABLE(5)) ' / ' DATATYPE(PROTOTYPE(TABLE(5)))
        OUTPUT = 'tbl_5_x     = ' PROTOTYPE(TABLE(5),1) ' / ' DATATYPE(PROTOTYPE(TABLE(5),1))
        OUTPUT = 'tbl_5_7     = ' PROTOTYPE(TABLE(5,7)) ' / ' DATATYPE(PROTOTYPE(TABLE(5,7)))
        OUTPUT = 'tbl_5_7_x   = ' PROTOTYPE(TABLE(5,7),1) ' / ' DATATYPE(PROTOTYPE(TABLE(5,7),1))
        OUTPUT = 'tbl_commas  = ' PROTOTYPE(TABLE(,,'d')) ' / ' DATATYPE(PROTOTYPE(TABLE(,,'d')))
        OUTPUT = 'tbl_commas_x= ' PROTOTYPE(TABLE(,,'d'),1) ' / ' DATATYPE(PROTOTYPE(TABLE(,,'d'),1))
        OUTPUT = 'tbl_copy    = ' PROTOTYPE(COPY(TABLE(5))) ' / ' DATATYPE(PROTOTYPE(COPY(TABLE(5))))
        OUTPUT = 'tbl_copy_x  = ' PROTOTYPE(COPY(TABLE(5)),1) ' / ' DATATYPE(PROTOTYPE(COPY(TABLE(5)),1))
        OUTPUT = 'arr_of_sort = ' PROTOTYPE(SORT(t)) ' / ' DATATYPE(PROTOTYPE(SORT(t)))
        OUTPUT = 'arr_of_srt_x= ' PROTOTYPE(SORT(t),1) ' / ' DATATYPE(PROTOTYPE(SORT(t),1))
END
*--------------------------------------- 1342 datatype_replace_keyword_replace_2
* 1115_data_basic.sno — DATA: constructor, DATATYPE, field accessors, mutator, VALUE()
* Rung 11. 6 assertions.
* DATATYPE() result normalized to uppercase for oracle-stability across engines
* (CSNOBOL4 returns uppercase type names; SPITBOL/scrip-cc return lowercase;
*  SPITBOL -f/-F fold switches also affect case). User field values untouched.

        DATA('NODE(VAL,LSON,RSON)')

        A = NODE('x', 'y', 'z')

        DIFFER(REPLACE(DATATYPE(A),&LCASE,&UCASE), 'NODE')   :f(e001)
        OUTPUT = 'FAIL 1115/001: datatype of node'            :(END)
e001

        DIFFER(VAL(A), 'x')                   :f(e002)
        OUTPUT = 'FAIL 1115/002: field accessor val'   :(END)
e002

*       constructor with no args: all fields null
        B = NODE()
        DIFFER(RSON(B))            :f(e003)
        OUTPUT = 'FAIL 1115/003: unset field is null'  :(END)
e003

*       field mutator: accessor on left side of =
        LSON(B) = A
        DIFFER(RSON(LSON(B)), 'z')                   :f(e004)
        OUTPUT = 'FAIL 1115/004: nested accessor after mutate' :(END)
e004

*       VALUE() retrieves value of a named variable
        DIFFER($'B', B)                   :f(e005)
        OUTPUT = 'FAIL 1115/005: value() by variable name' :(END)
e005

*       mutate val field
        VAL(A) = 'new'
        DIFFER(VAL(A), 'new')                   :f(e006)
        OUTPUT = 'FAIL 1115/006: mutate field and read back' :(END)
e006

        OUTPUT = 'PASS 1115_data_basic (6/6)'
END
*--------------------------------------------- 1343 user_function_array_branch_2
        DEFINE('roman(n)s,v,r,i')                                     :(roman_end)
roman   s = ''
        v = ARRAY(13)
        v<1> = 1000
        v<2> = 900
        v<3> = 500
        v<4> = 400
        v<5> = 100
        v<6> = 90
        v<7> = 50
        v<8> = 40
        v<9> = 10
        v<10> = 9
        v<11> = 5
        v<12> = 4
        v<13> = 1
        r = ARRAY(13)
        r<1> = 'M'
        r<2> = 'CM'
        r<3> = 'D'
        r<4> = 'CD'
        r<5> = 'C'
        r<6> = 'XC'
        r<7> = 'L'
        r<8> = 'XL'
        r<9> = 'X'
        r<10> = 'IX'
        r<11> = 'V'
        r<12> = 'IV'
        r<13> = 'I'
        i = 1
RLOOP   GT(n, 0)                                                       :F(RDONE)
        GE(n, v<i>)                                                    :F(RNEXT)
        s = s r<i>
        n = n - v<i>                                                   :(RLOOP)
RNEXT   i = i + 1                                                      :(RLOOP)
RDONE   roman = s                                                      :(RETURN)
roman_end
        OUTPUT = roman(1)
        OUTPUT = roman(4)
        OUTPUT = roman(9)
        OUTPUT = roman(42)
        OUTPUT = roman(1999)
        OUTPUT = roman(2024)
END
