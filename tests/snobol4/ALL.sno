*-------------------------------------------- 1716 arb_span_pos_replace_branch_3
*  leafsib arb flat red -- s193 (row alt-arb-bal-witness).  THE ALT-ARM LEAF-SUSPENSION CLASS
*  FOR ARB, minted in the PADDED shape of probe/cn/cn_alt_leaf_flat_red because this family's
*  own leafsib_arb.sno has gone INERT: on the STORED road (`t = (... | ARB . I)`) its cell is
*  already [rbp-96] on BOTH killswitch arms, so it is green for a reason unrelated to the switch
*  it exists to test, and its --compile output is byte-identical across the two arms.
*  Here the alternation is INLINE, so the ARB suspension cell is a RAW FLAT ZLS COORDINATE off
*  rsp (LFC legacy arm).  Only the padding count differs across this pair -- the pattern is the
*  same -- which is what proves the defect is the COORDINATE'S MAGNITUDE and never the shape.
*  Twenty padding assignments put it at [rsp+480], PAST the live frame, so the box writes above
*  the stack.  MEASURED s193, SCRIP 408aab34 pristine, RT_OPT -O0, oracle-diffed:
*    SCRIP_SPAN_FRAME=0  -> m3 pass / m4 rc=139
*    SCRIP_SPAN_FRAME=1  -> pass BOTH media   (=1 is the SHIPPED DEFAULT since s188, d3251f23)
*  ARB SEMANTICS (SPITBOL v3.7 p.207): ARB carries IMPLICIT alternatives tried BEFORE explicit
*  ones -- it behaves as (LEN(0) | LEN(1) | LEN(2) | ...) -- so its beta resumes an ADVANCING
*  SCAN through a suspension cursor.  That resume is what makes it a scratch-cell leaf.
	V1 = "pad1"
	V2 = "pad2"
	V3 = "pad3"
	V4 = "pad4"
	V5 = "pad5"
	V6 = "pad6"
	V7 = "pad7"
	V8 = "pad8"
	V9 = "pad9"
	V10 = "pad10"
	V11 = "pad11"
	V12 = "pad12"
	V13 = "pad13"
	V14 = "pad14"
	V15 = "pad15"
	V16 = "pad16"
	V17 = "pad17"
	V18 = "pad18"
	V19 = "pad19"
	V20 = "pad20"
	"ab" POS(0) (ARB | SPAN("09")) RPOS(0)	:S(Y)F(N)
Y	OUTPUT = "match"	:(END)
N	OUTPUT = "nomatch"
END
*-------------------------------- 1717 code_eval_array_datatype_replace_branch_1
*     indirect_name_datatypes.sno -- WHICH DATATYPES $ REFUSES, AND THE LHS AND
*     DOUBLE-INDIRECTION POSITIONS.  Every refusal here is ERROR 239 on the live
*     oracle; each spends exactly one &ERRLIMIT credit, which the closing line
*     counts.  $3.5 is admitted and names the variable literally called 3.5 --
*     round-tripped through $'3.5' so the accept half is pinned by value, not by
*     the absence of an error.
*     ⛔ NO CODE-OBJECT LINE HERE ON PURPOSE: the oracle refuses $CODE(...) with 239,
*     but SCRIP's CODE() answers DATATYPE STRING (measured), so such a line would
*     pass for the wrong reason.  EXPRESSION and the DATA object carry that half,
*     and DATATYPE agrees with the oracle on both (PT / EXPRESSION, measured).
        &ERRLIMIT = 1000
        DATA('PT(XX,YY)')
        P = PT(1,2)
        A = $P                          :F(F1)
        OUTPUT = 'T1 ok DATA'           :(T2)
F1      OUTPUT = 'T1 ERR ' &ERRTYPE
T2      Q = *(1 + 1)
        B = $Q                          :F(F2)
        OUTPUT = 'T2 ok EXPR'           :(T3)
F2      OUTPUT = 'T2 ERR ' &ERRTYPE
T3      $UNSET1 = 'x'                   :F(F3)
        OUTPUT = 'T3 ok LHSNULL'        :(T4)
F3      OUTPUT = 'T3 ERR ' &ERRTYPE
T4      $ARRAY(2) = 'x'                 :F(F4)
        OUTPUT = 'T4 ok LHSARR'         :(T5)
F4      OUTPUT = 'T4 ERR ' &ERRTYPE
T5      OUTPUT = $UNSET2                :F(F5)
        OUTPUT = 'T5 ok OUTNULL'        :(T6)
F5      OUTPUT = 'T5 ERR ' &ERRTYPE
T6      D = $$UNSET3                    :F(F6)
        OUTPUT = 'T6 ok DBL'            :(T7)
F6      OUTPUT = 'T6 ERR ' &ERRTYPE
T7      E = $(1 - 1)                    :F(F7)
        OUTPUT = 'T7 ok ZERO'           :(T8)
F7      OUTPUT = 'T7 ERR ' &ERRTYPE
T8      $3.5 = 'realname'
        G = $'3.5'                      :F(F8)
        OUTPUT = 'T8 realname=' G       :(T9)
F8      OUTPUT = 'T8 ERR ' &ERRTYPE
T9      OUTPUT = 'END errlimit=' &ERRLIMIT
END
*-------------------------------------------------- 1718 benchmark_table_variety
* table_variety -- probes one TABLE with keys of EVERY datatype and reports the census.
* bottleneck: table key handling across every key datatype, not just integers.
* ⭐ WHY THIS EXISTS (hq_P s262, Lon): table_access is integer-keyed only, so the
*   s262 typed-key cure -- one hash function per datatype -- shipped with coverage
*   of exactly ONE of the six types it added.  This kernel exercises integer,
*   string, real and null keys, negative and zero integers, keys that collide,
*   overwrite-in-place, deletion, lookup misses, and a table whose keys are of
*   MIXED type in one table -- the case where "hash by datatype first" is the only
*   thing keeping two different keys apart.
* ⛔ The census is a sum over EVERY probe, so a wrong bucket, a wrong compare or a
*   lost entry changes it.  It is not a smoke test that only proves we ran.
* Standalone:  scrip table_variety.sno   |   sbl -bf table_variety.sno
        &TRIM = 1
        &ANCHOR = 0
        &STLIMIT = -1
        DEFINE('TABLE_VARIETY(N)')                      :(TABLE_VARIETY_END)
TABLE_VARIETY  ZI = 1
        ZS = 0
ZBL     tab = TABLE(64)
*       integers: positive, zero, negative -- all three sign paths of the int hash
        ix = -30
INTFILL tab[ix] = ix * 3
        ix = LT(ix, 30) ix + 1                          :S(INTFILL)
*       strings: short and long, and one that looks like an integer
        sx = 1
STRFILL tab['k' sx] = sx * 5
        tab['a_much_longer_key_' sx] = sx * 7
        sx = LT(sx, 20) sx + 1                          :S(STRFILL)
        tab['17'] = 1700
*       reals, and the null key
        rx = 1
REALFIL tab[rx / 2.0] = rx * 11
        rx = LT(rx, 12) rx + 1                          :S(REALFIL)
        tab[''] = 99
*       ⭐ THE MIXED-TYPE PROBE: 17 and '17' are DIFFERENT keys.  A hash or a
*       compare that ignores the datatype collapses them and the census moves.
        tab[17] = 1717
        ZS = ZS + tab[17] + tab['17']
*       overwrite in place must not add an entry
        tab[5] = 500
        tab[5] = 501
        ZS = ZS + tab[5]
*       read every integer back
        ix = -30
INTREAD ZS = ZS + tab[ix]
        ix = LT(ix, 30) ix + 1                          :S(INTREAD)
*       read every string back
        sx = 1
STRREAD ZS = ZS + tab['k' sx] + tab['a_much_longer_key_' sx]
        sx = LT(sx, 20) sx + 1                          :S(STRREAD)
*       read every real back
        rx = 1
REALRD  ZS = ZS + tab[rx / 2.0]
        rx = LT(rx, 12) rx + 1                          :S(REALRD)
        ZS = ZS + tab['']
*       misses must return the null value, not a neighbour's
        ZS = ZS + SIZE(tab[9999]) + SIZE(tab['absent']) + SIZE(tab[-9999])
        ZI = LT(ZI, N) ZI + 1                           :S(ZBL)
        TABLE_VARIETY = ZS                              :(RETURN)
TABLE_VARIETY_END
*BENCH kernel=TABLE_VARIETY check=40 bud=500 flr=20
        OUTPUT = 'census of one pass  = ' TABLE_VARIETY(1)
        OUTPUT = 'census of 40 passes = ' TABLE_VARIETY(40)
        OUTPUT = 'tab[17] = ' tab[17] '   tab["17"] = ' tab['17'] '   tab[5] = ' tab[5]
END
