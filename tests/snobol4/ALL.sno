        &ANCHOR = 0
        &STLIMIT = -1
        DEFINE('FIB(N)')                                :(FIBE)
FIB     FIB = LT(N, 2) N                                :S(RETURN)
        FIB = FIB(N - 1) + FIB(N - 2)                   :(RETURN)
FIBE
        DEFINE('FIBONACCI(N)')                          :(FIBONACCI_END)
FIBONACCI  ZI = 1
ZBL     R = FIB(16)
        ZI = LT(ZI, N) ZI + 1                           :S(ZBL)
        FIBONACCI = R                                   :(RETURN)
FIBONACCI_END
*BENCH kernel=FIBONACCI check=3 bud=500 flr=20
        K = 0
FTAB    OUTPUT = 'fib(' K ') = ' FIB(K)
        K = LT(K, 16) K + 1                             :S(FTAB)
END
*----------------------------------------------------- 1569 benchmark_var_access
* var_access -- drives five natural variables through a dependent update chain N times.
* bottleneck: natural variable read and write traffic.
* Standalone:  scrip var_access.sno   |   sbl -bf var_access.sno   |   snobol4 var_access.sno
        &TRIM = 1
        &ANCHOR = 0
        &STLIMIT = -1
        DEFINE('VAR_ACCESS(N)')                         :(VAR_ACCESS_END)
VAR_ACCESS  A = 1
        B = 2
        C = 0
        D = 0
        E = 0
        ZI = 1
ZBL     A = A + 1
        B = B + 2
        C = A + B
        D = C + A
        E = D + B
        ZI = LT(ZI, N) ZI + 1                           :S(ZBL)
        VAR_ACCESS = E                                  :(RETURN)
VAR_ACCESS_END
*BENCH kernel=VAR_ACCESS check=1000 bud=500 flr=20
        OUTPUT = 'E after 1 step    = ' VAR_ACCESS(1)
        OUTPUT = 'E after 1000 steps = ' VAR_ACCESS(1000)
        OUTPUT = 'A=' A ' B=' B ' C=' C ' D=' D
END
*--------------------------------------------- 1570 code_eval_eval_bal_replace_1
*  KW-3b witness: A KEYWORD THE MANUAL NAMES CAN NEVER BE AN UNKNOWN "&name" ON
*  THE WRITE SIDE EITHER.  s147 fixed exactly this hole on the READ side (CN-2
*  re-keyed the tier-3 read to a canonical "&Name", so &ARB/&BAL/&REM fell into
*  the user-constant tier and raised 342 ON READ).  The WRITE side has the same
*  hole, unfixed: rt_keyword_write_snobol4's legacy cascade handles only
*  anchor/trim/maxlngth/error/trace/dump/random plus four accept-and-ignore
*  names, and EVERY OTHER keyword falls through to NV_SET_fn, which CN-2 marks
*  is_const -- so the SECOND assignment raises 341 and TERMINATES the program.
*  &CASE is a documented unprotected keyword (manual Ch.16: "Setting it to zero
*  will prevent case-folding during compilation with the functions CODE and
*  EVAL.  Initially 1, causing case-folding to occur."), so re-assigning it is
*  ordinary, supported SPITBOL.
*  ⛔ THE PRECEDING STATEMENT IS LOAD-BEARING, DO NOT "SIMPLIFY" IT AWAY: with
*  the &CASE pair as the program's FIRST statements the seal does not fire and
*  the witness goes green for the wrong reason.  It is minimized already.
*  ARM-SENSITIVE BY CONSTRUCTION, and that is the point: the armed block claims
*  every keyword it names in kwb_write and returns BEFORE the NV_SET_fn
*  constant tier is ever reached, so KW-2/KW-3b fix this class wholesale rather
*  than by patching the legacy cascade (which KW-4 deletes outright).
	OUTPUT = 'start'
	&CASE = 1
	&CASE = 0
	OUTPUT = 'case=' &CASE
	&ERRLIMIT = 1
	&ERRLIMIT = 0
	OUTPUT = 'errlimit=' &ERRLIMIT
	OUTPUT = 'still running'
END
*--------------------------- 1571 user_function_code_eval_array_replace_branch_1
*  seq_code_loop_in_function - distilled from gimpel SEQ_driver (batch C);
*  the same crash takes AI_driver and AOPA_driver, which both go through SEQ.
*  A DEFINE'd function that (a) reaches its loop variable INDIRECTLY through
*  a name argument, (b) drives a CODE()-compiled statement with an indirect
*  goto :<ARG_S>, and (c) returns after that loop finally fails, runs the
*  loop body correctly -- a, b, c below -- and then SEGFAULTS on the way out.
*  Oracle (sbl -b) prints a, b, c, then "K = 4".  SCRIP prints a, b, c and
*  dies with SIGSEGV in BOTH m3 and m4.
*  BOTH INGREDIENTS ARE NEEDED, and each half is correct on its own:
*    - the CODE loop with :<C> at top level, exiting on failure, is right
*      (see the L1/L2 loop below, which prints "exited with K = 4");
*    - a function that writes and reads its caller's variable through
*      $ARG_NAME and then FRETURNs is right (see F1 below).
*  Only the two together crash, so this is not "CODE is unimplemented" --
*  CODE, :<VAR> and indirect name arguments each work.
        DEFINE('S1(ARG_S,ARG_NAME)')            :(S1_END)
S1      $ARG_NAME  =  0
        ARG_S  =  CODE(ARG_S ' :S(S1_1)F(S1_2)')        :F(ERROR)
S1_1    $ARG_NAME  =  $ARG_NAME + 1             :<ARG_S>
S1_2    EQ($ARG_NAME,1)                         :S(FRETURN)F(RETURN)
S1_END
        DEFINE('F1(ARG_NAME)')                  :(F1_END)
F1      $ARG_NAME  =  0
        $ARG_NAME  =  $ARG_NAME + 1
        EQ($ARG_NAME,1)                         :S(FRETURN)F(RETURN)
F1_END
        A  =  ARRAY(3)
        A<1>  =  'a'
        A<2>  =  'b'
        A<3>  =  'c'
        C  =  CODE(' OUTPUT = A<J> :S(L1)F(L2)')
        J  =  0
L1      J  =  J + 1                             :<C>
L2      OUTPUT  =  'sibling CODE loop exited with J = ' J
        F1(.M)                                  :F(SIB2)
        OUTPUT  =  'sibling function returned, M = ' M    :(WITNESS)
SIB2    OUTPUT  =  'sibling function freturned, M = ' M
WITNESS S1(' OUTPUT = A<K> ', .K)
        OUTPUT  =  'witness returned, K = ' K
END
*--------------------------------- 1572 user_function_rem_array_replace_branch_1
*------------------------------------------------------------------------------
                DATA('list(n,a)')
                DEFINE('ListValue(x,place)')
                DEFINE('ListName(x,place)')
                DEFINE('ListAppend(x,item)')
                DEFINE('ListPrepend(x,item)')
                DEFINE('ListInsert(x,item,place)a,i,size')
                DEFINE('ListRemove(x,place)i,size')
                DEFINE('ListPop(x)')
                DEFINE('ListSize(x)')                                   :(ListEnd)
*------------------------------------------------------------------------------
ListValue       place           =   LT(place, 0) n(x) + place
                ListValue       =   a(x)[place]                         :S(RETURN)F(FRETURN)
ListName        place           =   LT(place, 0) n(x) + place
                ListName        =   .a(x)[place]                        :S(RETURN)F(FRETURN)
*------------------------------------------------------------------------------
ListAppend      ListAppend      =   ListInsert(x, item, n(x))     :(RETURN)
*------------------------------------------------------------------------------
ListPrepend     ListPrepend     =   ListInsert(x, item, 0)              :(RETURN)
*------------------------------------------------------------------------------
ListInsert      ListInsert      =   x
                size            =   ListSize(x)
                place           =   LT(place, 0) n(x) + place
                GE(place, 0)                                            :F(error)
                LE(place, n(x))                                         :F(error)
                LT(n(x), size)                                          :F(ListInsert4)
                i               =   n(x) + 1
ListInsert1     i               =   GT(i, place + 1) i - 1              :F(ListInsert2)
                a(x)[i]         =   a(x)[i - 1]                         :(ListInsert1)
ListInsert2     a(x)[i - 1]     =   item                                :(ListInsert9)
ListInsert4     a               =   ARRAY('0:' (IDENT(a(x)) 0, size * 2 - 1))
                i               =   -1
ListInsert5     i               =   LT(i, place - 1) i + 1              :F(ListInsert6)
                a[i]            =   a(x)[i]                             :(ListInsert5)
ListInsert6     a[i + 1]        =   item
ListInsert7     i               =   LT(i, n(x) - 1) i + 1               :F(ListInsert8)
                a[i + 1]        =   a(x)[i]                             :(ListInsert7)
ListInsert8     a(x)            =   a
ListInsert9     n(x)            =   n(x) + 1                            :(RETURN)
*------------------------------------------------------------------------------
ListRemove      place           =   LT(place, 0) n(x) + place
                GE(place, 0)                                            :F(FRETURN)
                LT(place, n(x))                                         :F(FRETURN)
                ListRemove      =   a(x)[place]
                i               =   place
ListRemove1     i               =   LT(i, n(x) - 1) i + 1               :F(ListRemove2)
                a(x)[i - 1]     =   a(x)[i]                             :(ListRemove1)
ListRemove2     a(x)[i]         =
                n(x)            =   n(x) - 1                            :(RETURN)
*------------------------------------------------------------------------------
ListPop         ListPop         =   ListRemove(x, -1)                   :S(RETURN)F(FRETURN)
*------------------------------------------------------------------------------
ListSize        ListSize        =   IDENT(a(x)) 0                       :S(RETURN)
                PROTOTYPE(a(x)) '0:' REM . ListSize
                ListSize        =   ListSize + 1                        :(RETURN)
ListEnd
        s = list()
        ListAppend(s, list())
        OUTPUT = 'after1 n=' n(s) ' proto=' PROTOTYPE(a(s))
        ListAppend(s, list())
        OUTPUT = 'after2 n=' n(s) ' proto=' PROTOTYPE(a(s))
        ListAppend(s, list())
        OUTPUT = 'after3 n=' n(s) ' proto=' PROTOTYPE(a(s))
END
*------------------------------------ 1573 len_datatype_replace_replace_branch_1
*  driver.sno — test driver for semantic subsystem
*  Oracle: snobol4 -f -P256k -Idemo/inc driver.sno

-INCLUDE 'global.inc'
-INCLUDE 'counter.inc'
-INCLUDE 'semantic.inc'

        &STLIMIT = 1000000
        dPATTERN   = REPLACE(DATATYPE(LEN(1)), &LCASE, &UCASE)
        dINTEGER   = REPLACE(DATATYPE(1),      &LCASE, &UCASE)
        InitCounter()

*  1: nPush() returns PATTERN
        IDENT(REPLACE(DATATYPE(nPush()), &LCASE, &UCASE), dPATTERN) :S(P1)F(F1)
P1      OUTPUT = 'PASS: 1 nPush=PATTERN'              :(T1)
F1      OUTPUT = 'FAIL: 1'
T1

*  2: nInc() returns PATTERN
        IDENT(REPLACE(DATATYPE(nInc()), &LCASE, &UCASE), dPATTERN) :S(P2)F(F2)
P2      OUTPUT = 'PASS: 2 nInc=PATTERN'               :(T2)
F2      OUTPUT = 'FAIL: 2'
T2

