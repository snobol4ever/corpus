*---------------------------------------------------------- 1803 benchmark_roman
* roman -- converts integers to Roman numerals and prints them.
* bottleneck: recursive function dispatch; RPOS/LEN/BREAK patterns; REPLACE.
* The kernel converts a DIFFERENT integer each iteration (1001..1000+N) rather than a
* fixed '1776': a fixed argument is hoistable in principle and exercises exactly one
* recursion depth, so a varying one keeps the row honest as the optimizer grows.  Its
* census is the total length of every numeral produced, so it witnesses each
* conversion, not just that the loop ran.
* Standalone:  scrip roman.sno   |   sbl -bf roman.sno   |   snobol4 roman.sno
        &TRIM = 1
        &ANCHOR = 0
        &STLIMIT = -1
        DEFINE('ROMAN(N)T')                             :(ROMAN_END)
ROMAN   N ? RPOS(1) LEN(1) . T =                        :F(RETURN)
        '0,1I,2II,3III,4IV,5V,6VI,7VII,8VIII,9IX,' T BREAK(',') . T   :F(FRETURN)
        ROMAN = REPLACE(ROMAN(N), 'IVXLCDM', 'XLCDM**') T   :S(RETURN)F(FRETURN)
ROMAN_END
        DEFINE('ROMAN_RUN(N)')                          :(ROMAN_RUN_END)
ROMAN_RUN  ZI = 1
        ZS = 0
ZBL     ZS = ZS + SIZE(ROMAN(1000 + ZI))
        ZI = LT(ZI, N) ZI + 1                           :S(ZBL)
        ROMAN_RUN = ZS                                  :(RETURN)
ROMAN_RUN_END
*BENCH kernel=ROMAN_RUN check=200 bud=500 flr=20
        OUTPUT = '1776 -> ' ROMAN(1776)
        OUTPUT = '2026 -> ' ROMAN(2026)
        OUTPUT = '   4 -> ' ROMAN(4)
        OUTPUT = '  40 -> ' ROMAN(40)
        OUTPUT = '3999 -> ' ROMAN(3999)
        K = 1001
RTAB    OUTPUT = K ' -> ' ROMAN(K)
        K = LT(K, 1010) K + 1                           :S(RTAB)
        OUTPUT = 'total numeral length for 1001..1200 = ' ROMAN_RUN(200)
END
*-------------------------------------------------------------- 1804 demo_porter
*// ---------------------------------------------------------------------------------------------------------
*// porter.sno — Porter (1980) stemming algorithm in SNOBOL4
*//
*// Faithful translation of the Python PATTERN version from CSCE-5200 Project 1, which uses the
*// snobol4python library (SNOBOL4python 0.5.2).  The snobol4python-to-SPITBOL primitive map is:
*//
*//   Python (snobol4python)       SNOBOL4 (SPITBOL)
*//   ──────────────────────       ───────────────────────────────────────────────────────────
*//   POS(0) / RPOS(0)             POS(0) / RPOS(0)
*//   RTAB(n)                      RTAB(n)
*//   σ('sses')                    'sses'
*//   P @ "var"                    P $ var          (immediate — at match time; used for guards)
*//   P % "var"                    P . var          (conditional — on commit; used to keep text)
*//   Λ(callable)                  *pred_fn()       (pattern-valued fn: '' = ok, FAIL = nope)
*//   λ("stmt")                    (epsilon . *action_fn())   (deferred commit-time side effect)
*//   A | B                        A | B
*//   A + B                        A B              (juxtaposition = concatenation)
*//
*// Oracle: SPITBOL x64 (/home/claude/x64/bin/sbl).  Test fixture: voc.txt / output.txt from
*// tartarus.org/martin/PorterStemmer (23,531 words).
*// ---------------------------------------------------------------------------------------------------------

               &ANCHOR        =  0
               &FULLSCAN      =  1
               epsilon        =

               VOWELS         =  'aeiou'
               LC             =  'abcdefghijklmnopqrstuvwxyz'

*// ---------------------------------------------------------------------------------------------------------
*// cons(i): true if stem[i] is a consonant.  Letters 1-indexed (SNOBOL4 SUBSTR is 1-based).
*// ---------------------------------------------------------------------------------------------------------
               DEFINE('cons(i)c')                                   :(cons_end)
cons           c              =  SUBSTR(stem, i, 1)
               c              ANY(VOWELS)                          :S(FRETURN)
               DIFFER(c, 'y')                                       :S(RETURN)
               EQ(i, 1)                                             :S(RETURN)
               cons(i - 1)                                          :S(FRETURN)F(RETURN)
cons_end

*// ---------------------------------------------------------------------------------------------------------
*// m(): Porter's measure — the number of VC sequences in 'stem'.  Returns integer.
*// ---------------------------------------------------------------------------------------------------------
               DEFINE('m()i,n,L')                                   :(m_end)
m              L              =  SIZE(stem)
               EQ(L, 0)                                             :S(RETURN)
               i              =  1
               n              =  0
mC0            GT(i, L)                                             :S(RETURN)
               cons(i)                                              :F(mV1)
               i              =  i + 1                              :(mC0)
mV1            i              =  i + 1
mV             GT(i, L)                                             :S(RETURN)
               cons(i)                                              :S(mC1)
               i              =  i + 1                              :(mV)
mC1            i              =  i + 1
               n              =  n + 1
               m              =  n
mC             GT(i, L)                                             :S(RETURN)
               cons(i)                                              :F(mV1)
               i              =  i + 1                              :(mC)
m_end

*// ---------------------------------------------------------------------------------------------------------
*// vowelinstem(): true if any char of stem is a vowel (y after consonant counts).
*// ---------------------------------------------------------------------------------------------------------
               DEFINE('vowelinstem()i,L')                           :(vis_end)
vowelinstem    L              =  SIZE(stem)
               i              =  1
visL           GT(i, L)                                             :S(FRETURN)
               cons(i)                                              :F(RETURN)
               i              =  i + 1                              :(visL)
vis_end

*// ---------------------------------------------------------------------------------------------------------
*// doublec(j): stem[j] == stem[j-1] and both consonants.  j 1-based.
*// ---------------------------------------------------------------------------------------------------------
               DEFINE('doublec(j)')                                 :(dc_end)
doublec        LT(j, 2)                                             :S(FRETURN)
               DIFFER(SUBSTR(stem, j, 1), SUBSTR(stem, j - 1, 1))   :S(FRETURN)
               cons(j)                                              :S(RETURN)F(FRETURN)
dc_end

*// ---------------------------------------------------------------------------------------------------------
*// cvc(i): stem[i-2..i] = c-v-c  and  stem[i] not in {w,x,y}.  i 1-based.
*// ---------------------------------------------------------------------------------------------------------
               DEFINE('cvc(i)c')                                    :(cvc_end)
cvc            LT(i, 3)                                             :S(FRETURN)
               cons(i)                                              :F(FRETURN)
               cons(i - 1)                                          :S(FRETURN)
               cons(i - 2)                                          :F(FRETURN)
               c              =  SUBSTR(stem, i, 1)
               c              ANY('wxy')                           :S(FRETURN)F(RETURN)
cvc_end

*// ---------------------------------------------------------------------------------------------------------
*// Guards — pattern-valued.  Return null pattern ('') on success, FAIL on failure.
*// Called as *gX() inside a pattern.
*// ---------------------------------------------------------------------------------------------------------
               DEFINE('g_vis()')                                    :(g_vis_end)
g_vis          vowelinstem()                                        :F(gv_no)
               g_vis          =                                     :(RETURN)
gv_no          g_vis          =  FAIL                               :(RETURN)
g_vis_end

               DEFINE('g_m_gt_0()')                                 :(g_m0_end)
g_m_gt_0       GT(m(), 0)                                           :F(gm0_no)
               g_m_gt_0       =                                     :(RETURN)
gm0_no         g_m_gt_0       =  FAIL                               :(RETURN)
g_m0_end

               DEFINE('g_m_gt_1()')                                 :(g_m1_end)
g_m_gt_1       GT(m(), 1)                                           :F(gm1_no)
               g_m_gt_1       =                                     :(RETURN)
gm1_no         g_m_gt_1       =  FAIL                               :(RETURN)
g_m1_end

               DEFINE('g_m_eq_1()')                                 :(g_me1_end)
g_m_eq_1       EQ(m(), 1)                                           :F(gme1_no)
               g_m_eq_1       =                                     :(RETURN)
gme1_no        g_m_eq_1       =  FAIL                               :(RETURN)
g_me1_end

               DEFINE('g_not_cvc_last()L')                          :(g_ncvc_end)
g_not_cvc_last L              =  SIZE(stem)
               cvc(L)                                               :S(gnc_no)
               g_not_cvc_last =                                     :(RETURN)
gnc_no         g_not_cvc_last =  FAIL                               :(RETURN)
g_ncvc_end

               DEFINE('g_stem_not_m()L')                            :(g_snm_end)
g_stem_not_m   L              =  SIZE(stem)
               DIFFER(SUBSTR(stem, L, 1), 'm')                      :F(gsnm_no)
               g_stem_not_m   =                                     :(RETURN)
gsnm_no        g_stem_not_m   =  FAIL                               :(RETURN)
g_snm_end

               DEFINE('g_stem_last_st()L,last')                     :(g_sls_end)
g_stem_last_st L              =  SIZE(stem)
               last           =  SUBSTR(stem, L, 1)
               last           ANY('st')                            :F(gsls_no)
               g_stem_last_st =                                     :(RETURN)
gsls_no        g_stem_last_st =  FAIL                               :(RETURN)
g_sls_end

               DEFINE('g_m_ll_gt_1()save,r')                        :(g_mll_end)
g_m_ll_gt_1    save           =  stem
               stem           =  save 'll'
               r              =  m()
               stem           =  save
               GT(r, 1)                                             :F(gmll_no)
               g_m_ll_gt_1    =                                     :(RETURN)
gmll_no        g_m_ll_gt_1    =  FAIL                               :(RETURN)
g_mll_end

*// ---------------------------------------------------------------------------------------------------------
*// Action setters.  Each corresponds to λ("target='X'") in the Python.  Called via
*// (epsilon . *s_X()) so they fire at commit time on the winning arm.
*// ---------------------------------------------------------------------------------------------------------
               DEFINE('s_ss()')    :(s_ss_end)
s_ss           target         =  'ss'
               s_ss           =  .dummy                             :(NRETURN)
s_ss_end
               DEFINE('s_i()')     :(s_i_end)
s_i            target         =  'i'
               s_i            =  .dummy                             :(NRETURN)
s_i_end
               DEFINE('s_empty()') :(s_empty_end)
s_empty        target         =
               s_empty        =  .dummy                             :(NRETURN)
s_empty_end
               DEFINE('s_ee()')    :(s_ee_end)
s_ee           target         =  'ee'
               s_ee           =  .dummy                             :(NRETURN)
s_ee_end
               DEFINE('s_ate()')   :(s_ate_end)
s_ate          target         =  'ate'
               s_ate          =  .dummy                             :(NRETURN)
s_ate_end
               DEFINE('s_tion()')  :(s_tion_end)
s_tion         target         =  'tion'
               s_tion         =  .dummy                             :(NRETURN)
s_tion_end
               DEFINE('s_ence()')  :(s_ence_end)
s_ence         target         =  'ence'
               s_ence         =  .dummy                             :(NRETURN)
s_ence_end
               DEFINE('s_ance()')  :(s_ance_end)
s_ance         target         =  'ance'
               s_ance         =  .dummy                             :(NRETURN)
s_ance_end
               DEFINE('s_ize()')   :(s_ize_end)
s_ize          target         =  'ize'
               s_ize          =  .dummy                             :(NRETURN)
s_ize_end
               DEFINE('s_ble()')   :(s_ble_end)
s_ble          target         =  'ble'
               s_ble          =  .dummy                             :(NRETURN)
s_ble_end
               DEFINE('s_al()')    :(s_al_end)
s_al           target         =  'al'
               s_al           =  .dummy                             :(NRETURN)
s_al_end
               DEFINE('s_ent()')   :(s_ent_end)
s_ent          target         =  'ent'
               s_ent          =  .dummy                             :(NRETURN)
s_ent_end
               DEFINE('s_e()')     :(s_e_end)
s_e            target         =  'e'
               s_e            =  .dummy                             :(NRETURN)
s_e_end
               DEFINE('s_ous()')   :(s_ous_end)
s_ous          target         =  'ous'
               s_ous          =  .dummy                             :(NRETURN)
s_ous_end
               DEFINE('s_ive()')   :(s_ive_end)
s_ive          target         =  'ive'
               s_ive          =  .dummy                             :(NRETURN)
s_ive_end
               DEFINE('s_ful()')   :(s_ful_end)
s_ful          target         =  'ful'
               s_ful          =  .dummy                             :(NRETURN)
s_ful_end
               DEFINE('s_log()')   :(s_log_end)
s_log          target         =  'log'
               s_log          =  .dummy                             :(NRETURN)
s_log_end
               DEFINE('s_ic()')    :(s_ic_end)
s_ic           target         =  'ic'
               s_ic           =  .dummy                             :(NRETURN)
s_ic_end
               DEFINE('s_l()')     :(s_l_end)
s_l            target         =  'l'
               s_l            =  .dummy                             :(NRETURN)
s_l_end

*// step1ab_cleanup — Python's λ("porter_step1ab_cleanup()"): commit-time action (NOT a guard)
*// that sets target and may mutate stem.
               DEFINE('a_s1ab_cleanup()L,last,P')                   :(a_s1ab_end)
a_s1ab_cleanup
               L              =  SIZE(stem)
               P              =  RTAB(2) ('at' | 'bl' | 'iz') RPOS(0)
               stem           P                                     :F(a_s1_next1)
               target         =  'e'                                :(a_s1_done)
a_s1_next1     doublec(L)                                           :F(a_s1_next2)
               last           =  SUBSTR(stem, L, 1)
               last           ANY('lsz')                           :S(a_s1_next2)
               stem           =  SUBSTR(stem, 1, L - 1)
               target         =                                     :(a_s1_done)
a_s1_next2     EQ(m(), 1)                                           :F(a_s1_else)
               cvc(L)                                               :F(a_s1_else)
               target         =  'e'                                :(a_s1_done)
a_s1_else      target         =
a_s1_done      a_s1ab_cleanup =  .dummy                             :(NRETURN)
a_s1ab_end

*// ---------------------------------------------------------------------------------------------------------
*// Porter rule patterns.  Read these top-down next to the Python source — they are the same shape.
*// ---------------------------------------------------------------------------------------------------------
               p1a            =
+              POS(0)
+              ( RTAB(4) $ stem 'sses' (epsilon . *s_ss())
+              | RTAB(3) $ stem 'ies'  (epsilon . *s_i())
+              | RTAB(2) $ stem 'ss'   (epsilon . *s_ss())
+              | RTAB(1) $ stem 's'    (epsilon . *s_empty())
+              )
+              RPOS(0)

               p1b            =
+              POS(0)
+              ( RTAB(3) $ stem 'eed' (*g_m_gt_0() (epsilon . *s_ee()) | epsilon)
+              | RTAB(2) $ stem 'ed'  *g_vis() (epsilon . *a_s1ab_cleanup())
+              | RTAB(3) $ stem 'ing' *g_vis() (epsilon . *a_s1ab_cleanup())
+              )
+              RPOS(0)

               p1c            =
+              POS(0)
+              ( RTAB(1) $ stem 'y' *g_vis() (epsilon . *s_i())
+              )
+              RPOS(0)

               p2             =
+              POS(0)
+              ( RTAB(7) $ stem 'ational' *g_m_gt_0() (epsilon . *s_ate())
+              | RTAB(6) $ stem 'tional'  *g_m_gt_0() (epsilon . *s_tion())
+              | RTAB(4) $ stem 'enci'    *g_m_gt_0() (epsilon . *s_ence())
+              | RTAB(4) $ stem 'anci'    *g_m_gt_0() (epsilon . *s_ance())
+              | RTAB(4) $ stem 'izer'    *g_m_gt_0() (epsilon . *s_ize())
+              | RTAB(3) $ stem 'bli'     *g_m_gt_0() (epsilon . *s_ble())
+              | RTAB(4) $ stem 'alli'    *g_m_gt_0() (epsilon . *s_al())
+              | RTAB(5) $ stem 'entli'   *g_m_gt_0() (epsilon . *s_ent())
+              | RTAB(3) $ stem 'eli'     *g_m_gt_0() (epsilon . *s_e())
+              | RTAB(5) $ stem 'ousli'   *g_m_gt_0() (epsilon . *s_ous())
+              | RTAB(7) $ stem 'ization' *g_m_gt_0() (epsilon . *s_ize())
+              | RTAB(5) $ stem 'ation'   *g_m_gt_0() (epsilon . *s_ate())
+              | RTAB(4) $ stem 'ator'    *g_m_gt_0() (epsilon . *s_ate())
+              | RTAB(5) $ stem 'alism'   *g_m_gt_0() (epsilon . *s_al())
+              | RTAB(7) $ stem 'iveness' *g_m_gt_0() (epsilon . *s_ive())
+              | RTAB(7) $ stem 'fulness' *g_m_gt_0() (epsilon . *s_ful())
+              | RTAB(7) $ stem 'ousness' *g_m_gt_0() (epsilon . *s_ous())
+              | RTAB(5) $ stem 'aliti'   *g_m_gt_0() (epsilon . *s_al())
+              | RTAB(5) $ stem 'iviti'   *g_m_gt_0() (epsilon . *s_ive())
+              | RTAB(6) $ stem 'biliti'  *g_m_gt_0() (epsilon . *s_ble())
+              | RTAB(4) $ stem 'logi'    *g_m_gt_0() (epsilon . *s_log())
+              )
+              RPOS(0)

               p3             =
+              POS(0)
+              ( RTAB(5) $ stem 'icate' *g_m_gt_0() (epsilon . *s_ic())
+              | RTAB(5) $ stem 'ative' *g_m_gt_0() (epsilon . *s_empty())
+              | RTAB(5) $ stem 'alize' *g_m_gt_0() (epsilon . *s_al())
+              | RTAB(5) $ stem 'iciti' *g_m_gt_0() (epsilon . *s_ic())
+              | RTAB(4) $ stem 'ical'  *g_m_gt_0() (epsilon . *s_ic())
+              | RTAB(3) $ stem 'ful'   *g_m_gt_0() (epsilon . *s_empty())
+              | RTAB(4) $ stem 'ness'  *g_m_gt_0() (epsilon . *s_empty())
+              )
+              RPOS(0)

               p4             =
+              POS(0)
+              ( RTAB(2) $ stem 'al'    *g_m_gt_1() (epsilon . *s_empty())
+              | RTAB(4) $ stem 'ance'  *g_m_gt_1() (epsilon . *s_empty())
+              | RTAB(4) $ stem 'ence'  *g_m_gt_1() (epsilon . *s_empty())
+              | RTAB(2) $ stem 'er'    *g_m_gt_1() (epsilon . *s_empty())
+              | RTAB(2) $ stem 'ic'    *g_m_gt_1() (epsilon . *s_empty())
+              | RTAB(4) $ stem 'able'  *g_m_gt_1() (epsilon . *s_empty())
+              | RTAB(4) $ stem 'ible'  *g_m_gt_1() (epsilon . *s_empty())
+              | RTAB(3) $ stem 'ant'   *g_m_gt_1() (epsilon . *s_empty())
+              | RTAB(5) $ stem 'ement' *g_m_gt_1() (epsilon . *s_empty())
+              | RTAB(4) $ stem 'ment'  *g_m_gt_1() (epsilon . *s_empty())
+              | RTAB(3) $ stem 'ent'   *g_m_gt_1() *g_stem_not_m() (epsilon . *s_empty())
+              | RTAB(3) $ stem 'ion'   *g_m_gt_1() *g_stem_last_st() (epsilon . *s_empty())
+              | RTAB(2) $ stem 'ou'    *g_m_gt_1() (epsilon . *s_empty())
+              | RTAB(3) $ stem 'ism'   *g_m_gt_1() (epsilon . *s_empty())
+              | RTAB(3) $ stem 'ate'   *g_m_gt_1() (epsilon . *s_empty())
+              | RTAB(3) $ stem 'iti'   *g_m_gt_1() (epsilon . *s_empty())
+              | RTAB(3) $ stem 'ous'   *g_m_gt_1() (epsilon . *s_empty())
+              | RTAB(3) $ stem 'ive'   *g_m_gt_1() (epsilon . *s_empty())
+              | RTAB(3) $ stem 'ize'   *g_m_gt_1() (epsilon . *s_empty())
+              )
+              RPOS(0)

               p5a            =
+              POS(0)
+              ( RTAB(1) $ stem 'e'
+                ( *g_m_gt_1()
+                | *g_m_eq_1() *g_not_cvc_last()
+                )
+                (epsilon . *s_empty())
+              )
+              RPOS(0)

               p5b            =
+              POS(0)
+              ( RTAB(2) $ stem 'll' *g_m_ll_gt_1() (epsilon . *s_l())
+              )
+              RPOS(0)

*// ---------------------------------------------------------------------------------------------------------
*// stemmer(token): run the Porter pipeline.  Sentinel 'UNSET' on target detects non-firing pattern.
*// ---------------------------------------------------------------------------------------------------------
               DEFINE('stemmer(token)')                             :(stm_end)
stemmer        LE(SIZE(token), 2)                                   :F(stm_run)
               stemmer        =  token                              :(RETURN)
stm_run        token          =  REPLACE(token, &UCASE, LC)

               target         =  'UNSET'
               token          p1a                                   :F(stm_1b)
               DIFFER(target, 'UNSET')                              :F(stm_1b)
               token          =  stem target

stm_1b         target         =  'UNSET'
               token          p1b                                   :F(stm_1c)
               DIFFER(target, 'UNSET')                              :F(stm_1c)
               token          =  stem target

stm_1c         target         =  'UNSET'
               token          p1c                                   :F(stm_2)
               DIFFER(target, 'UNSET')                              :F(stm_2)
               token          =  stem target

stm_2          target         =  'UNSET'
               token          p2                                    :F(stm_3)
               DIFFER(target, 'UNSET')                              :F(stm_3)
               token          =  stem target

stm_3          target         =  'UNSET'
               token          p3                                    :F(stm_4)
               DIFFER(target, 'UNSET')                              :F(stm_4)
               token          =  stem target

stm_4          target         =  'UNSET'
               token          p4                                    :F(stm_5a)
               DIFFER(target, 'UNSET')                              :F(stm_5a)
               token          =  stem target

stm_5a         target         =  'UNSET'
               token          p5a                                   :F(stm_5b)
               DIFFER(target, 'UNSET')                              :F(stm_5b)
               token          =  stem target

stm_5b         target         =  'UNSET'
               token          p5b                                   :F(stm_done)
               DIFFER(target, 'UNSET')                              :F(stm_done)
               token          =  stem target

stm_done       stemmer        =  token                              :(RETURN)
stm_end

*// ---------------------------------------------------------------------------------------------------------
*// Driver: read each word from INPUT, write its stem to OUTPUT.
*// ---------------------------------------------------------------------------------------------------------
NEXT           word           =  INPUT                              :F(END)
               OUTPUT         =  stemmer(word)                      :(NEXT)
END
*---------------------------------------- 1805 user_function_eval_arbno_branch_1
        $('Z' 'Z') = 1
        nl = CHAR(10)
        tab = CHAR(9)
        DEFINE('SH(t,v)')
        DEFINE('shift(p,t)')
        DEFINE('PC()')
        DEFINE('nPush()')
        DEFINE('nPop2()')                               :(SEND)
SH        OUTPUT = 'SH(' t ',' v ')'
        SH = .dummy                                     :(NRETURN)
shift     shift = EVAL("p . thx . *SH('" t "', thx)")     :(RETURN)
PC        OUTPUT = 'PC()'
        PC = .dummy                                     :(NRETURN)
nPush     nPush = epsilon . *PC()                         :(RETURN)
nPop2     nPop2 = epsilon . *PC()                         :(RETURN)
SEND
        White = ( SPAN(' ' tab)
+                   FENCE(nl ('+' | '.') FENCE(SPAN(' ' tab) | epsilon) | epsilon)
+                 | nl ('+' | '.') FENCE(SPAN(' ' tab) | epsilon)
+                 )
        Gray = *White | epsilon
        Goto2 = *Gray ':' *Gray
        Label = shift(BREAK(' ' tab nl ';'), 'Label')
        XDEAD = 'ZZZNOTPRESENT'
        Stmt3 = *Label
+                 ( *White *XDEAD
+                 | shift(epsilon, '') shift(epsilon, '') shift(epsilon, '') shift(epsilon, '')
+                 )
+                 FENCE(*Goto2 | shift(epsilon, '') shift(epsilon, ''))
+                 *Gray
        Command = *Stmt3 (nl | ';')
        Parse = nPush() ARBNO(*Command) nPop2()
        Space = SPAN(' ' tab) | epsilon
        Src = 'START' nl
        Src POS(0) *Parse *Space RPOS(0)                :F(NO)
        OUTPUT = 'match'                                :(DONE)
NO        OUTPUT = 'nomatch'
DONE
END
*-------------------------------- 1806 user_function_eval_arbno_replace_branch_2
START
-INCLUDE 'global.inc'
-INCLUDE 'case.inc'
-INCLUDE 'assign.inc'
-INCLUDE 'match.inc'
-INCLUDE 'counter.inc'
-INCLUDE 'stack.inc'
-INCLUDE 'tree.inc'
-INCLUDE 'ShiftReduce.inc'
-INCLUDE 'TDump.inc'
-INCLUDE 'Gen.inc'
-INCLUDE 'Qize.inc'
-INCLUDE 'ReadWrite.inc'
-INCLUDE 'XDump.inc'
-INCLUDE 'semantic.inc'
-INCLUDE 'omega.inc'
-INCLUDE 'trace.inc'
                  &FULLSCAN      =  1
                  &MAXLNGTH      =  524288
                  DEFINE('SHX(t,v)')
                  DEFINE('shf2(p,t)')                                            :(X2END)
SHX               OUTPUT         =  'SHX(' t ',' v ')'
                  SHX            =  .dummyy                                      :(NRETURN)
shf2              shf2           =  EVAL("p . thy . *SHX('" t "', thy)")         :(RETURN)
X2END
                  DEFINE('PCX()')
                  DEFINE('nP2()')
                  DEFINE('nQ2()')                                                :(XEND)
PCX               OUTPUT         =  'PCX()'
                  PCX            =  .dummyx                                      :(NRETURN)
nP2               nP2            =  epsilon . *PCX()                             :(RETURN)
nQ2               nQ2            =  epsilon . *PCX()                             :(RETURN)
XEND
                  Space          =  SPAN(' ' tab) | epsilon
                  Label          =  shf2(BREAK(' ' tab nl ';'), 'Label')
                  Stmt           =  *Label
+                                   ( 'ZZZDEADARM1'
+                                   | shf2(epsilon, '') shf2(epsilon, '') shf2(epsilon, '') shf2(epsilon, '')
+                                   )
+                                   FENCE('ZZZDEADGOTO' | shf2(epsilon, '') shf2(epsilon, ''))
+                                   epsilon
                  Command        =  *Stmt ("'Stmt'" & 7) (nl | ';')
                  Parse          =  nP2() ARBNO(*Command) ("'Parse'" & 1) nQ2()
                  Src            =  'START' nl
                  Src            POS(0) *Parse *Space RPOS(0)                    :F(NO)
                  OUTPUT         =  'match'                                      :(DONE)
NO                OUTPUT         =  'nomatch'
DONE
END
*--------------------------------------------------------- 1807 benchmark_porter
*// ---------------------------------------------------------------------------------------------------------
*// porter.sno — Porter (1980) stemming algorithm in SNOBOL4
*//
*// Faithful translation of the Python PATTERN version from CSCE-5200 Project 1, which uses the
*// snobol4python library (SNOBOL4python 0.5.2).  The snobol4python-to-SPITBOL primitive map is:
*//
*//   Python (snobol4python)       SNOBOL4 (SPITBOL)
*//   ──────────────────────       ───────────────────────────────────────────────────────────
*//   POS(0) / RPOS(0)             POS(0) / RPOS(0)
*//   RTAB(n)                      RTAB(n)
*//   σ('sses')                    'sses'
*//   P @ "var"                    P $ var          (immediate — at match time; used for guards)
*//   P % "var"                    P . var          (conditional — on commit; used to keep text)
*//   Λ(callable)                  *pred_fn()       (pattern-valued fn: '' = ok, FAIL = nope)
*//   λ("stmt")                    (epsilon . *action_fn())   (deferred commit-time side effect)
*//   A | B                        A | B
*//   A + B                        A B              (juxtaposition = concatenation)
*//
*// Oracle: SPITBOL x64 (/home/claude/x64/bin/sbl).  Test fixture: voc.txt / output.txt from
*// tartarus.org/martin/PorterStemmer (23,531 words).
*// ---------------------------------------------------------------------------------------------------------

               &ANCHOR        =  0
               &FULLSCAN      =  1
               epsilon        =

               VOWELS         =  'aeiou'
               LC             =  'abcdefghijklmnopqrstuvwxyz'

*// ---------------------------------------------------------------------------------------------------------
*// cons(i): true if stem[i] is a consonant.  Letters 1-indexed (SNOBOL4 SUBSTR is 1-based).
*// ---------------------------------------------------------------------------------------------------------
               DEFINE('cons(i)c')                                   :(cons_end)
cons           c              =  SUBSTR(stem, i, 1)
               c              ANY(VOWELS)                          :S(FRETURN)
               DIFFER(c, 'y')                                       :S(RETURN)
               EQ(i, 1)                                             :S(RETURN)
               cons(i - 1)                                          :S(FRETURN)F(RETURN)
cons_end

*// ---------------------------------------------------------------------------------------------------------
*// m(): Porter's measure — the number of VC sequences in 'stem'.  Returns integer.
*// ---------------------------------------------------------------------------------------------------------
               DEFINE('m()i,n,L')                                   :(m_end)
m              L              =  SIZE(stem)
               EQ(L, 0)                                             :S(RETURN)
               i              =  1
               n              =  0
mC0            GT(i, L)                                             :S(RETURN)
               cons(i)                                              :F(mV1)
               i              =  i + 1                              :(mC0)
mV1            i              =  i + 1
mV             GT(i, L)                                             :S(RETURN)
               cons(i)                                              :S(mC1)
               i              =  i + 1                              :(mV)
mC1            i              =  i + 1
               n              =  n + 1
               m              =  n
mC             GT(i, L)                                             :S(RETURN)
               cons(i)                                              :F(mV1)
               i              =  i + 1                              :(mC)
m_end

*// ---------------------------------------------------------------------------------------------------------
*// vowelinstem(): true if any char of stem is a vowel (y after consonant counts).
*// ---------------------------------------------------------------------------------------------------------
               DEFINE('vowelinstem()i,L')                           :(vis_end)
vowelinstem    L              =  SIZE(stem)
               i              =  1
visL           GT(i, L)                                             :S(FRETURN)
               cons(i)                                              :F(RETURN)
               i              =  i + 1                              :(visL)
vis_end

*// ---------------------------------------------------------------------------------------------------------
*// doublec(j): stem[j] == stem[j-1] and both consonants.  j 1-based.
*// ---------------------------------------------------------------------------------------------------------
               DEFINE('doublec(j)')                                 :(dc_end)
doublec        LT(j, 2)                                             :S(FRETURN)
               DIFFER(SUBSTR(stem, j, 1), SUBSTR(stem, j - 1, 1))   :S(FRETURN)
               cons(j)                                              :S(RETURN)F(FRETURN)
dc_end

*// ---------------------------------------------------------------------------------------------------------
*// cvc(i): stem[i-2..i] = c-v-c  and  stem[i] not in {w,x,y}.  i 1-based.
*// ---------------------------------------------------------------------------------------------------------
               DEFINE('cvc(i)c')                                    :(cvc_end)
cvc            LT(i, 3)                                             :S(FRETURN)
               cons(i)                                              :F(FRETURN)
               cons(i - 1)                                          :S(FRETURN)
               cons(i - 2)                                          :F(FRETURN)
               c              =  SUBSTR(stem, i, 1)
               c              ANY('wxy')                           :S(FRETURN)F(RETURN)
cvc_end

*// ---------------------------------------------------------------------------------------------------------
*// Guards — pattern-valued.  Return null pattern ('') on success, FAIL on failure.
*// Called as *gX() inside a pattern.
*// ---------------------------------------------------------------------------------------------------------
               DEFINE('g_vis()')                                    :(g_vis_end)
g_vis          vowelinstem()                                        :F(gv_no)
               g_vis          =                                     :(RETURN)
gv_no          g_vis          =  FAIL                               :(RETURN)
g_vis_end

               DEFINE('g_m_gt_0()')                                 :(g_m0_end)
g_m_gt_0       GT(m(), 0)                                           :F(gm0_no)
               g_m_gt_0       =                                     :(RETURN)
gm0_no         g_m_gt_0       =  FAIL                               :(RETURN)
g_m0_end

               DEFINE('g_m_gt_1()')                                 :(g_m1_end)
g_m_gt_1       GT(m(), 1)                                           :F(gm1_no)
               g_m_gt_1       =                                     :(RETURN)
gm1_no         g_m_gt_1       =  FAIL                               :(RETURN)
g_m1_end

               DEFINE('g_m_eq_1()')                                 :(g_me1_end)
g_m_eq_1       EQ(m(), 1)                                           :F(gme1_no)
               g_m_eq_1       =                                     :(RETURN)
gme1_no        g_m_eq_1       =  FAIL                               :(RETURN)
g_me1_end

               DEFINE('g_not_cvc_last()L')                          :(g_ncvc_end)
g_not_cvc_last L              =  SIZE(stem)
               cvc(L)                                               :S(gnc_no)
               g_not_cvc_last =                                     :(RETURN)
gnc_no         g_not_cvc_last =  FAIL                               :(RETURN)
g_ncvc_end

               DEFINE('g_stem_not_m()L')                            :(g_snm_end)
g_stem_not_m   L              =  SIZE(stem)
               DIFFER(SUBSTR(stem, L, 1), 'm')                      :F(gsnm_no)
               g_stem_not_m   =                                     :(RETURN)
gsnm_no        g_stem_not_m   =  FAIL                               :(RETURN)
g_snm_end

               DEFINE('g_stem_last_st()L,last')                     :(g_sls_end)
g_stem_last_st L              =  SIZE(stem)
               last           =  SUBSTR(stem, L, 1)
               last           ANY('st')                            :F(gsls_no)
               g_stem_last_st =                                     :(RETURN)
gsls_no        g_stem_last_st =  FAIL                               :(RETURN)
g_sls_end

               DEFINE('g_m_ll_gt_1()save,r')                        :(g_mll_end)
g_m_ll_gt_1    save           =  stem
               stem           =  save 'll'
               r              =  m()
               stem           =  save
               GT(r, 1)                                             :F(gmll_no)
               g_m_ll_gt_1    =                                     :(RETURN)
gmll_no        g_m_ll_gt_1    =  FAIL                               :(RETURN)
g_mll_end

*// ---------------------------------------------------------------------------------------------------------
*// Action setters.  Each corresponds to λ("target='X'") in the Python.  Called via
*// (epsilon . *s_X()) so they fire at commit time on the winning arm.
*// ---------------------------------------------------------------------------------------------------------
               DEFINE('s_ss()')    :(s_ss_end)
s_ss           target         =  'ss'
               s_ss           =  .dummy                             :(NRETURN)
s_ss_end
               DEFINE('s_i()')     :(s_i_end)
s_i            target         =  'i'
               s_i            =  .dummy                             :(NRETURN)
s_i_end
               DEFINE('s_empty()') :(s_empty_end)
s_empty        target         =
               s_empty        =  .dummy                             :(NRETURN)
s_empty_end
               DEFINE('s_ee()')    :(s_ee_end)
s_ee           target         =  'ee'
               s_ee           =  .dummy                             :(NRETURN)
s_ee_end
               DEFINE('s_ate()')   :(s_ate_end)
s_ate          target         =  'ate'
               s_ate          =  .dummy                             :(NRETURN)
s_ate_end
               DEFINE('s_tion()')  :(s_tion_end)
s_tion         target         =  'tion'
               s_tion         =  .dummy                             :(NRETURN)
s_tion_end
               DEFINE('s_ence()')  :(s_ence_end)
s_ence         target         =  'ence'
               s_ence         =  .dummy                             :(NRETURN)
s_ence_end
               DEFINE('s_ance()')  :(s_ance_end)
s_ance         target         =  'ance'
               s_ance         =  .dummy                             :(NRETURN)
s_ance_end
               DEFINE('s_ize()')   :(s_ize_end)
s_ize          target         =  'ize'
               s_ize          =  .dummy                             :(NRETURN)
s_ize_end
               DEFINE('s_ble()')   :(s_ble_end)
s_ble          target         =  'ble'
               s_ble          =  .dummy                             :(NRETURN)
s_ble_end
               DEFINE('s_al()')    :(s_al_end)
s_al           target         =  'al'
               s_al           =  .dummy                             :(NRETURN)
s_al_end
               DEFINE('s_ent()')   :(s_ent_end)
s_ent          target         =  'ent'
               s_ent          =  .dummy                             :(NRETURN)
s_ent_end
               DEFINE('s_e()')     :(s_e_end)
s_e            target         =  'e'
               s_e            =  .dummy                             :(NRETURN)
s_e_end
               DEFINE('s_ous()')   :(s_ous_end)
s_ous          target         =  'ous'
               s_ous          =  .dummy                             :(NRETURN)
s_ous_end
               DEFINE('s_ive()')   :(s_ive_end)
s_ive          target         =  'ive'
               s_ive          =  .dummy                             :(NRETURN)
s_ive_end
               DEFINE('s_ful()')   :(s_ful_end)
s_ful          target         =  'ful'
               s_ful          =  .dummy                             :(NRETURN)
s_ful_end
               DEFINE('s_log()')   :(s_log_end)
s_log          target         =  'log'
               s_log          =  .dummy                             :(NRETURN)
s_log_end
               DEFINE('s_ic()')    :(s_ic_end)
s_ic           target         =  'ic'
               s_ic           =  .dummy                             :(NRETURN)
s_ic_end
               DEFINE('s_l()')     :(s_l_end)
s_l            target         =  'l'
               s_l            =  .dummy                             :(NRETURN)
s_l_end

*// step1ab_cleanup — Python's λ("porter_step1ab_cleanup()"): commit-time action (NOT a guard)
*// that sets target and may mutate stem.
               DEFINE('a_s1ab_cleanup()L,last,P')                   :(a_s1ab_end)
a_s1ab_cleanup
               L              =  SIZE(stem)
               P              =  RTAB(2) ('at' | 'bl' | 'iz') RPOS(0)
               stem           P                                     :F(a_s1_next1)
               target         =  'e'                                :(a_s1_done)
a_s1_next1     doublec(L)                                           :F(a_s1_next2)
               last           =  SUBSTR(stem, L, 1)
               last           ANY('lsz')                           :S(a_s1_next2)
               stem           =  SUBSTR(stem, 1, L - 1)
               target         =                                     :(a_s1_done)
a_s1_next2     EQ(m(), 1)                                           :F(a_s1_else)
               cvc(L)                                               :F(a_s1_else)
               target         =  'e'                                :(a_s1_done)
a_s1_else      target         =
a_s1_done      a_s1ab_cleanup =  .dummy                             :(NRETURN)
a_s1ab_end

*// ---------------------------------------------------------------------------------------------------------
*// Porter rule patterns.  Read these top-down next to the Python source — they are the same shape.
*// ---------------------------------------------------------------------------------------------------------
               p1a            =
+              POS(0)
+              ( RTAB(4) $ stem 'sses' (epsilon . *s_ss())
+              | RTAB(3) $ stem 'ies'  (epsilon . *s_i())
+              | RTAB(2) $ stem 'ss'   (epsilon . *s_ss())
+              | RTAB(1) $ stem 's'    (epsilon . *s_empty())
+              )
+              RPOS(0)

               p1b            =
+              POS(0)
+              ( RTAB(3) $ stem 'eed' (*g_m_gt_0() (epsilon . *s_ee()) | epsilon)
+              | RTAB(2) $ stem 'ed'  *g_vis() (epsilon . *a_s1ab_cleanup())
+              | RTAB(3) $ stem 'ing' *g_vis() (epsilon . *a_s1ab_cleanup())
+              )
+              RPOS(0)

               p1c            =
+              POS(0)
+              ( RTAB(1) $ stem 'y' *g_vis() (epsilon . *s_i())
+              )
+              RPOS(0)

               p2             =
+              POS(0)
+              ( RTAB(7) $ stem 'ational' *g_m_gt_0() (epsilon . *s_ate())
+              | RTAB(6) $ stem 'tional'  *g_m_gt_0() (epsilon . *s_tion())
+              | RTAB(4) $ stem 'enci'    *g_m_gt_0() (epsilon . *s_ence())
+              | RTAB(4) $ stem 'anci'    *g_m_gt_0() (epsilon . *s_ance())
+              | RTAB(4) $ stem 'izer'    *g_m_gt_0() (epsilon . *s_ize())
+              | RTAB(3) $ stem 'bli'     *g_m_gt_0() (epsilon . *s_ble())
+              | RTAB(4) $ stem 'alli'    *g_m_gt_0() (epsilon . *s_al())
+              | RTAB(5) $ stem 'entli'   *g_m_gt_0() (epsilon . *s_ent())
+              | RTAB(3) $ stem 'eli'     *g_m_gt_0() (epsilon . *s_e())
+              | RTAB(5) $ stem 'ousli'   *g_m_gt_0() (epsilon . *s_ous())
+              | RTAB(7) $ stem 'ization' *g_m_gt_0() (epsilon . *s_ize())
+              | RTAB(5) $ stem 'ation'   *g_m_gt_0() (epsilon . *s_ate())
+              | RTAB(4) $ stem 'ator'    *g_m_gt_0() (epsilon . *s_ate())
+              | RTAB(5) $ stem 'alism'   *g_m_gt_0() (epsilon . *s_al())
+              | RTAB(7) $ stem 'iveness' *g_m_gt_0() (epsilon . *s_ive())
+              | RTAB(7) $ stem 'fulness' *g_m_gt_0() (epsilon . *s_ful())
+              | RTAB(7) $ stem 'ousness' *g_m_gt_0() (epsilon . *s_ous())
+              | RTAB(5) $ stem 'aliti'   *g_m_gt_0() (epsilon . *s_al())
+              | RTAB(5) $ stem 'iviti'   *g_m_gt_0() (epsilon . *s_ive())
+              | RTAB(6) $ stem 'biliti'  *g_m_gt_0() (epsilon . *s_ble())
+              | RTAB(4) $ stem 'logi'    *g_m_gt_0() (epsilon . *s_log())
+              )
+              RPOS(0)

               p3             =
+              POS(0)
+              ( RTAB(5) $ stem 'icate' *g_m_gt_0() (epsilon . *s_ic())
+              | RTAB(5) $ stem 'ative' *g_m_gt_0() (epsilon . *s_empty())
+              | RTAB(5) $ stem 'alize' *g_m_gt_0() (epsilon . *s_al())
+              | RTAB(5) $ stem 'iciti' *g_m_gt_0() (epsilon . *s_ic())
+              | RTAB(4) $ stem 'ical'  *g_m_gt_0() (epsilon . *s_ic())
+              | RTAB(3) $ stem 'ful'   *g_m_gt_0() (epsilon . *s_empty())
+              | RTAB(4) $ stem 'ness'  *g_m_gt_0() (epsilon . *s_empty())
+              )
+              RPOS(0)

               p4             =
+              POS(0)
+              ( RTAB(2) $ stem 'al'    *g_m_gt_1() (epsilon . *s_empty())
+              | RTAB(4) $ stem 'ance'  *g_m_gt_1() (epsilon . *s_empty())
+              | RTAB(4) $ stem 'ence'  *g_m_gt_1() (epsilon . *s_empty())
+              | RTAB(2) $ stem 'er'    *g_m_gt_1() (epsilon . *s_empty())
+              | RTAB(2) $ stem 'ic'    *g_m_gt_1() (epsilon . *s_empty())
+              | RTAB(4) $ stem 'able'  *g_m_gt_1() (epsilon . *s_empty())
+              | RTAB(4) $ stem 'ible'  *g_m_gt_1() (epsilon . *s_empty())
+              | RTAB(3) $ stem 'ant'   *g_m_gt_1() (epsilon . *s_empty())
+              | RTAB(5) $ stem 'ement' *g_m_gt_1() (epsilon . *s_empty())
+              | RTAB(4) $ stem 'ment'  *g_m_gt_1() (epsilon . *s_empty())
+              | RTAB(3) $ stem 'ent'   *g_m_gt_1() *g_stem_not_m() (epsilon . *s_empty())
+              | RTAB(3) $ stem 'ion'   *g_m_gt_1() *g_stem_last_st() (epsilon . *s_empty())
+              | RTAB(2) $ stem 'ou'    *g_m_gt_1() (epsilon . *s_empty())
+              | RTAB(3) $ stem 'ism'   *g_m_gt_1() (epsilon . *s_empty())
+              | RTAB(3) $ stem 'ate'   *g_m_gt_1() (epsilon . *s_empty())
+              | RTAB(3) $ stem 'iti'   *g_m_gt_1() (epsilon . *s_empty())
+              | RTAB(3) $ stem 'ous'   *g_m_gt_1() (epsilon . *s_empty())
+              | RTAB(3) $ stem 'ive'   *g_m_gt_1() (epsilon . *s_empty())
+              | RTAB(3) $ stem 'ize'   *g_m_gt_1() (epsilon . *s_empty())
+              )
+              RPOS(0)

               p5a            =
+              POS(0)
+              ( RTAB(1) $ stem 'e'
+                ( *g_m_gt_1()
+                | *g_m_eq_1() *g_not_cvc_last()
+                )
+                (epsilon . *s_empty())
+              )
+              RPOS(0)

               p5b            =
+              POS(0)
+              ( RTAB(2) $ stem 'll' *g_m_ll_gt_1() (epsilon . *s_l())
+              )
+              RPOS(0)

*// ---------------------------------------------------------------------------------------------------------
*// stemmer(token): run the Porter pipeline.  Sentinel 'UNSET' on target detects non-firing pattern.
*// ---------------------------------------------------------------------------------------------------------
               DEFINE('stemmer(token)')                             :(stm_end)
stemmer        LE(SIZE(token), 2)                                   :F(stm_run)
               stemmer        =  token                              :(RETURN)
stm_run        token          =  REPLACE(token, &UCASE, LC)

               target         =  'UNSET'
               token          p1a                                   :F(stm_1b)
               DIFFER(target, 'UNSET')                              :F(stm_1b)
               token          =  stem target

stm_1b         target         =  'UNSET'
               token          p1b                                   :F(stm_1c)
               DIFFER(target, 'UNSET')                              :F(stm_1c)
               token          =  stem target

stm_1c         target         =  'UNSET'
               token          p1c                                   :F(stm_2)
               DIFFER(target, 'UNSET')                              :F(stm_2)
               token          =  stem target

stm_2          target         =  'UNSET'
               token          p2                                    :F(stm_3)
               DIFFER(target, 'UNSET')                              :F(stm_3)
               token          =  stem target

stm_3          target         =  'UNSET'
               token          p3                                    :F(stm_4)
               DIFFER(target, 'UNSET')                              :F(stm_4)
               token          =  stem target

stm_4          target         =  'UNSET'
               token          p4                                    :F(stm_5a)
               DIFFER(target, 'UNSET')                              :F(stm_5a)
               token          =  stem target

stm_5a         target         =  'UNSET'
               token          p5a                                   :F(stm_5b)
               DIFFER(target, 'UNSET')                              :F(stm_5b)
               token          =  stem target

stm_5b         target         =  'UNSET'
               token          p5b                                   :F(stm_done)
               DIFFER(target, 'UNSET')                              :F(stm_done)
               token          =  stem target

stm_done       stemmer        =  token                              :(RETURN)
stm_end

*// ---------------------------------------------------------------------------------------------------------
*// ---------------------------------------------------------------------------------------------------------
*// Driver: slurp every input word, then write each word's stem to OUTPUT.
*// PORTER(N) re-stems the whole word list N times and returns the total stem length;
*// it is what scripts/bench_wrap.sh times.  The standalone driver below IS the stemmer.
*// ---------------------------------------------------------------------------------------------------------
               WORDS          =  ARRAY(32768)
               NW             =  0
PLOAD          PLINE          =  INPUT                              :F(PLOADED)
               NW             =  NW + 1
               WORDS[NW]      =  PLINE                              :(PLOAD)
PLOADED        EQ(NW, 0)                                            :S(END)
               DEFINE('PORTER(N)')                                  :(PORTER_END)
PORTER         ZI             =  1
ZBL            ZACC           =  0
               ZJ             =  1
ZWLP           ZACC           =  ZACC + SIZE(stemmer(WORDS[ZJ]))
               ZJ             =  LT(ZJ, NW) ZJ + 1                  :S(ZWLP)
               ZI             =  LT(ZI, N) ZI + 1                   :S(ZBL)
               PORTER         =  ZACC                               :(RETURN)
PORTER_END
*BENCH kernel=PORTER check=1 bud=1000 flr=20
               PJ             =  1
PNEXT          OUTPUT         =  stemmer(WORDS[PJ])
               PJ             =  LT(PJ, NW) PJ + 1                  :S(PNEXT)
END
*--------------------------------------------------- 1808 benchmark_calculator-1
        DEFINE('EMIT()')
        DEFINE('PSH()')
        DEFINE('DRF(nm)')
        DEFINE('ADD()')
        DEFINE('SUB()')
        DEFINE('MUL()')
        DEFINE('DIV()')
        DEFINE('NEG()')                         :(FNS_end)
EMIT    OUTPUT = EQ(quiet) DRF(S[1])
        sp = 0
        EMIT = .dm                              :(NRETURN)

PSH     PSH = .S[sp = sp + 1]                   :(NRETURN)
DRF     DRF = nm
        nm ? POS(0) ANY(&LCASE) RPOS(0)         :F(RETURN)
        DRF = vars[nm]                          :(RETURN)
ADD     S[sp = sp - 1] = DRF(S[sp]) + DRF(S[sp + 1])
        ADD = .dm                               :(NRETURN)
SUB     S[sp = sp - 1] = DRF(S[sp]) - DRF(S[sp + 1])
        SUB = .dm                               :(NRETURN)
MUL     S[sp = sp - 1] = DRF(S[sp]) * DRF(S[sp + 1])
        MUL = .dm                               :(NRETURN)
DIV     S[sp = sp - 1] = DRF(S[sp]) / DRF(S[sp + 1])
        DIV = .dm                               :(NRETURN)
NEG     S[sp] = -DRF(S[sp])
        NEG = .dm                               :(NRETURN)
FNS_end
*------------------------------------------------------------------------------
        S = ARRAY(65536)
        V = ANY(&LCASE) . *PSH()
        I = SPAN('0123456789') . *PSH()
        A = V | I | FENCE('(' *X ')')
        F = A | FENCE('+' *F) | FENCE('-' *F . *NEG())
        T = F ( FENCE('*' *T . *MUL()) | FENCE('/' *T . *DIV()) | '' )
        X = T ( FENCE('+' *X . *ADD()) | FENCE('-' *X . *SUB()) | '' )
        eol = CHAR(10) FENCE
        C = POS(0) ARBNO(X eol . *EMIT()) RPOS(0)
*------------------------------------------------------------------------------
        &TRIM = 0
        vars = TABLE()
        vars['x'] = 1
        vars['y'] = 2
        vars['z'] = 3
* read all at once: raw fd 0, one 4 MiB-max transfer (larger inputs truncate)
*------------------------------------------------------------------------------
* quiet -- 0 prints every evaluated line (the application's real answer), 1 keeps
* the arithmetic and suppresses the printing.  CALCULATOR_1(N) below re-evaluates
* the whole input N times with printing off; the standalone driver at the bottom
* leaves it on and IS the calculator.
*------------------------------------------------------------------------------
        quiet = 0
        DEFINE('CALCULATOR_1(N)')  :(CALCULATOR_1_END)
CALCULATOR_1  quiet = 1
        ZI = 1
ZBL     sp = 0
        src C  :F(ZBAD)
        ZI = LT(ZI, N) ZI + 1  :S(ZBL)
        quiet = 0
        CALCULATOR_1 = 'matched bytes=' SIZE(src)  :(RETURN)
ZBAD    quiet = 0
        CALCULATOR_1 = 'Pattern match failed'  :(RETURN)
CALCULATOR_1_END
*------------------------------------------------------------------------------
        INPUT(.INPUT, 9, '[-f0 -r4194304]')
        src = INPUT
*BENCH kernel=CALCULATOR_1 check=1 bud=1000 flr=20
* TIME() is integer nanoseconds off a monotonic wall clock (FINDING s249);
* divide by 1000000 for match_ms.  TERMINAL is stderr, so stdout stays byte-comparable.
        t0 = TIME()
        sp = 0
        src C                                   :F(bad)
        t1 = TIME()
        TERMINAL = 'match_ms=' (t1 - t0) / 1000000        :(END)
bad     t1 = TIME()
        OUTPUT = 'Boo!'
        TERMINAL = 'match_ms=' (t1 - t0) / 1000000
END
*--------------------------------------------------- 1809 benchmark_calculator-2
*------------------------------------------------------------------------------
* calculator-2.sno — precedence calculator, Variant 2: LEFT associativity
* (Lon, 2026-07-24).  Same atoms/factors as calculator-1; terms and
* expressions fold LEFT: 10-2-3 = (10-2)-3 = 5; 8/4/2 = (8/4)/2 = 1.
* Lon's intended form was Gimpel's left-recursive grammar (p. 411, the
* L_ONE program):  T = F | *T ANY('*/') F ;  X = T | *X ANY('+-') T.
* That form worked in mainframe SNOBOL4 ONLY because quickscan assumed
* every deferred pattern eats >= 1 character, bounding the recursion by
* subject length.  Measured 2026-07-24: it stack-overflows on 3+4 under
* SPITBOL (ERROR 246), SCRIP m3 (SEGV, same plunge), and csnobol4 in BOTH
* &FULLSCAN modes (Error 16) — csnobol4's quickscan does not propagate the
* length budget into deferred expansions.  See programs/gimpel/L_ONE.sno's
* header: the Catspaw patch removed the left recursion for SPITBOL and
* bought right associativity as the price; calculator-1.sno is that shape.
* THIS file keeps the associativity left recursion was for, fullscan-safe,
* by ITERATION: T = F ARBNO(op F . *action) — instances match left to
* right, actions fold left.  Unary signs: ANY('+-') pushes the sign char,
* SGN pops value+sign after the recursive *F (sign chains work: --3 = 3).
* Operand order conventional (head OP tail).  Variables in a TABLE keyed
* by letter; x=1, y=2, z=3; other lowercase letters deref to null = 0.
* Shares calculator.input / calculator-gen.py with calculator-1; own ref
* (490 of 2208 lines differ from calculator-1.ref — the associativity
* delta).  Every '/' divisor is a trailing nonzero literal digit, safe
* under either grouping.
* Run: sbl -b calculator-2.sno < calculator.input
*      scrip --run calculator-2.sno < calculator.input
*------------------------------------------------------------------------------
        DEFINE('EMIT()')
        DEFINE('PSH()')
        DEFINE('DRF(nm)')
        DEFINE('ADD()')
        DEFINE('SUB()')
        DEFINE('MUL()')
        DEFINE('DIV()')
        DEFINE('SGN()p1')                       :(FNS_end)
EMIT    OUTPUT = EQ(quiet) DRF(S[1])
        sp = 0
        EMIT = .dm                              :(NRETURN)
PSH     PSH = .S[sp = sp + 1]                   :(NRETURN)
DRF     DRF = nm
        nm POS(0) ANY(&LCASE) RPOS(0)           :F(RETURN)
        DRF = vars[nm]                          :(RETURN)
ADD     S[sp = sp - 1] = DRF(S[sp]) + DRF(S[sp + 1])
        ADD = .dm                               :(NRETURN)
SUB     S[sp = sp - 1] = DRF(S[sp]) - DRF(S[sp + 1])
        SUB = .dm                               :(NRETURN)
MUL     S[sp = sp - 1] = DRF(S[sp]) * DRF(S[sp + 1])
        MUL = .dm                               :(NRETURN)
DIV     S[sp = sp - 1] = DRF(S[sp]) / DRF(S[sp + 1])
        DIV = .dm                               :(NRETURN)
SGN     p1 = DRF(S[sp])
        p1 = IDENT(S[sp = sp - 1], '-') -p1
        S[sp] = p1
        SGN = .dm                               :(NRETURN)
FNS_end
*------------------------------------------------------------------------------
        S = ARRAY(65536)
        LCASE = &LCASE
        DIGITS = '0123456789'
        V = ANY(&LCASE) . *PSH()
        I = SPAN('0123456789') . *PSH()
        A = FENCE(V | I | '(' *X ')')
        F = FENCE(A | ANY('+-') . *PSH() *F . *SGN())
        T = F ARBNO('*' F . *MUL() | '/' F . *DIV())
        X = T ARBNO('+' T . *ADD() | '-' T . *SUB())
        eol = CHAR(10) FENCE
        C = POS(0) ARBNO(X eol (epsilon . *EMIT())) RPOS(0)
*------------------------------------------------------------------------------
        &TRIM = 0
        vars = TABLE()
        vars['x'] = 1
        vars['y'] = 2
        vars['z'] = 3
* read all at once: raw fd 0, one 4 MiB-max transfer (larger inputs truncate)
*------------------------------------------------------------------------------
* quiet -- 0 prints every evaluated line (the application's real answer), 1 keeps
* the arithmetic and suppresses the printing.  CALCULATOR_2(N) below re-evaluates
* the whole input N times with printing off; the standalone driver at the bottom
* leaves it on and IS the calculator.
*------------------------------------------------------------------------------
        quiet = 0
        DEFINE('CALCULATOR_2(N)')  :(CALCULATOR_2_END)
CALCULATOR_2  quiet = 1
        ZI = 1
ZBL     sp = 0
        src C  :F(ZBAD)
        ZI = LT(ZI, N) ZI + 1  :S(ZBL)
        quiet = 0
        CALCULATOR_2 = 'matched bytes=' SIZE(src)  :(RETURN)
ZBAD    quiet = 0
        CALCULATOR_2 = 'Pattern match failed'  :(RETURN)
CALCULATOR_2_END
*------------------------------------------------------------------------------
        INPUT(.INPUT, 9, '[-f0 -r4194304]')
        src = INPUT
*BENCH kernel=CALCULATOR_2 check=1 bud=1000 flr=20
* TIME() is integer nanoseconds off a monotonic wall clock (FINDING s249);
* divide by 1000000 for match_ms.  TERMINAL is stderr, so stdout stays byte-comparable.
        t0 = TIME()
        sp = 0
        src C                                   :F(bad)
        t1 = TIME()
        TERMINAL = 'match_ms=' (t1 - t0) / 1000000        :(END)
bad     t1 = TIME()
        OUTPUT = 'Boo!'
        TERMINAL = 'match_ms=' (t1 - t0) / 1000000
END
*-------------------------------- 1810 user_function_arbno_span_replace_branch_3
*------------------------------------------------------------------------------
* claws5.sno — CLAWS5 POS-tagged corpus tokenizer
* ENG 685, Lon Cherryholmes Sr.
* Run: sbl -b claws5.sno   (CLAWS5inTASA.dat must be in working directory)
*
* Faithful SNOBOL4 port of assignment3.py (claws_info pattern).
* Function names match Python lambda semantics:
*   init()      λ("mem = dict()")
*   new_sent()  λ("num=int(num)") + λ("mem[num]=dict()")
*   add_tok()   λ("if wrd not in mem[num][wrd]: ...") + λ("mem[num][wrd][tag]+=1")
*
* Each is a single NRETURN function; called as  epsilon . *fn()  in the pattern.
*------------------------------------------------------------------------------
               &TRIM           =  1
               &ANCHOR         =  0
               &FULLSCAN       =  1
               &ALPHABET       POS(10) LEN(1) . nl
               DIGITS          =  '0123456789'
               UCASE           =  'ABCDEFGHIJKLMNOPQRSTUVWXYZ'
*------------------------------------------------------------------------------
*  init() — λ("mem = dict()")
*------------------------------------------------------------------------------
               DEFINE('init()')                             :(init_end)
init           mem             =  TABLE()
               sentno          =  0
               init            =  .dummy                    :(NRETURN)
init_end
*------------------------------------------------------------------------------
*  new_sent() — λ("num=int(num)") + λ("mem[num]=dict()")
*  Reads global: num (captured by SPAN(DIGITS) . num just before)
*------------------------------------------------------------------------------
               DEFINE('new_sent()')                         :(new_sent_end)
new_sent       sentno          =  +num
               mem[sentno]     =  TABLE()
               new_sent        =  .dummy                    :(NRETURN)
new_sent_end
*------------------------------------------------------------------------------
*  add_tok() — λ("if wrd not in mem[num]:      mem[num][wrd]=dict()")
*            + λ("if tag not in mem[num][wrd]: mem[num][wrd][tag]=0")
*            + λ("mem[num][wrd][tag] += 1")
*  Reads globals: sentno, wrd, tag
*------------------------------------------------------------------------------
               DEFINE('add_tok()')                          :(add_tok_end)
add_tok        DIFFER(mem[sentno][wrd])                     :F(new_wrd)
               DIFFER(mem[sentno][wrd][tag])                :F(new_tag)
               mem[sentno][wrd][tag]  =  mem[sentno][wrd][tag] + 1  :(done)
new_wrd        mem[sentno][wrd]       =  TABLE()
new_tag        mem[sentno][wrd][tag]  =  1
done           add_tok         =  .dummy                    :(NRETURN)
add_tok_end
*------------------------------------------------------------------------------
*  claws_pat — direct port of Python claws_info pattern:
*    POS(0)
*    + λ("mem=dict()")
*    + ARBNO(
*        ( SPAN(DIGITS)%"num" + σ('_CRD :_PUN') + λ("num=int(num)") + λ("mem[num]=dict()")
*        | (NOTANY("_")+BREAK("_"))%"wrd" + σ('_')
*          + (ANY(UCASE)+SPAN(DIGITS+UCASE))%"tag"
*          + λ("mem[num][wrd][tag]+=1")
*        ) + σ(' ')
*      )
*    + RPOS(0)
*------------------------------------------------------------------------------
               claws_pat       =
+              POS(0)
+              (epsilon . *init())
+              ARBNO(
+                ( (SPAN(DIGITS) . num) '_CRD :_PUN'
+                  (epsilon . *new_sent())
+                | (NOTANY('_') BREAK('_')) . wrd
+                  '_'
+                  (ANY(UCASE) SPAN(DIGITS UCASE)) . tag
+                  (epsilon . *add_tok())
+                )
+                ' '
+              )
+              RPOS(0)
*------------------------------------------------------------------------------
               DEFINE('pp_mem()sk,wk,tk,si,wi,ti')          :(pp_mem_end)
pp_mem         OUTPUT          =  '{'
               sk              =  SORT(mem)
               si              =  0
pp_s           si              =  si + 1
               sk[si,1]                                     :F(pp_s_done)
               si              GT(si, 1) OUTPUT = '   },'
               OUTPUT          =  '   ' sk[si,1] ': {'
               wk              =  SORT(mem[sk[si,1]])
               wi              =  0
pp_w           wi              =  wi + 1
               wk[wi,1]                                     :F(pp_w_done)
               wi              GT(wi, 1) OUTPUT = '      },'
               OUTPUT          =  '      ' wk[wi,1] ': {'
               tk              =  SORT(mem[sk[si,1]][wk[wi,1]])
               ti              =  0
pp_t           ti              =  ti + 1
               tk[ti,1]                                     :F(pp_t_done)
               OUTPUT          =  '         '
+                                 tk[ti,1] ': '
+                                 mem[sk[si,1]][wk[wi,1]][tk[ti,1]]
+                                 ','                        :(pp_t)
pp_t_done      OUTPUT          =  '      }'                 :(pp_w)
pp_w_done      OUTPUT          =  '   }'                    :(pp_s)
pp_s_done      OUTPUT          =  '}'
               pp_mem          =  .dummy                    :(RETURN)
pp_mem_end
*------------------------------------------------------------------------------
               INPUT(.rdch, 8, 'CLAWS5inTASA.dat')          :F(main_err)
slurp          line            =  rdch                      :F(slurp_done)
               src             =  src line ' '              :(slurp)
slurp_done     ENDFILE(8)
               src             ?  claws_pat                 :F(main_fail)
               pp_mem()                                     :(END)
main_fail      OUTPUT          =  'Pattern match failed'    :(END)
main_err       OUTPUT          =  'Could not read CLAWS5inTASA.dat'
*------------------------------------------------------------------------------
END
*------------------------------- 1811 user_function_arbno_fence_replace_branch_1
*  claws5_table_flat1 -- minimal witness, row table-flat-1level-segv (FINDING-2026-08-21-s199).
*  Flattens claws5's 3-level counts[number][word][tag] table build to ONE level, counts[word],
*  keeping the SAME grammar shape (FENCE/ARBNO + a deferred *token() callout) claws5 itself uses.
*  Self-contained: no -INCLUDE, no file I/O, one deterministic pass over an embedded literal line.
        &TRIM = 0
        DEFINE('token()')  :(token_end)
token   number = +number
        counts = IDENT(counts) TABLE()
        counts[word] = IDENT(counts[word]) 0
        counts[word] = counts[word] + 1
        token = .dummy  :(NRETURN)
token_end
        grammar = POS(0)
+                 ARBNO(
+                   FENCE(
+                     (SPAN('0123456789') . number) '_CRD :_PUN'
+                   | (NOTANY('_') BREAK('_')) . word
+                     '_'
+                     (ANY(&UCASE) SPAN('0123456789' &UCASE)) . tag . *token()
+                   )
+                   SPAN(' ' CHAR(10))
+                 )
+                 RPOS(0)
        text = '1_CRD dog_NN1 cat_NN2 dog_NN1' CHAR(10)
        text ? grammar                                  :F(bad)
        OUTPUT = 'dog=' counts['dog'] ' cat=' counts['cat']  :(done)
bad     OUTPUT = 'MATCH-FAILED'
done
END
*---------------------------------------------- 1812 scrip_test_treebank-prepend
*------------------------------------------------------------------------------
* treebank.sno — Penn Treebank s-expression parser
* ENG 685, Lon Cherryholmes Sr.
*
* Faithful SNOBOL4 port of assignment3.py (treebank pattern).
* Run: sbl -b treebank.sno   (VBGinTASA.dat must be in working directory)
*
* Function names match Python exactly:
*   init_list(v)  push_list(v)  push_item(v)  pop_list()  pop_final(v)
*
* Each is a single NRETURN function usable two ways:
*   (1) Direct deferred call in pattern:  (word . tag) . *push_list(tag)
*   (2) Zero-width epsilon hook:          (epsilon . *push_list('BANK'))
*
* Python:
*   def init_list(v): λ(f"{v}=None") + λ("stack=[]")
*   def push_list(v): λ("stack.append(list())") + λ("stack[-1].append(v)")
*   def push_item(v): λ("stack[-1].append(v)")
*   def pop_list():   λ("stack[-2].append(tuple(stack.pop()))")
*   def pop_final(v): λ(f"{v}=tuple(stack.pop())")
*------------------------------------------------------------------------------
               &TRIM          =  1
               &ANCHOR        =  0
               &FULLSCAN      =  1
               &ALPHABET      POS(10) LEN(1) . nl
*------------------------------------------------------------------------------
               DATA('list(head,tail)')
*------------------------------------------------------------------------------
               DEFINE('list_reverse(lst)acc,cur')           :(list_reverse_end)
list_reverse   acc            =
               cur            =  lst
lr1            DIFFER(cur)                                  :F(lr_done)
               acc            =  list(head(cur), acc)
               cur            =  tail(cur)                  :(lr1)
lr_done        list_reverse   =  acc                        :(RETURN)
list_reverse_end
*------------------------------------------------------------------------------
               DEFINE('stk_push_frame(v)')                  :(stk_push_frame_end)
stk_push_frame stk            =  list(list(v,), stk)
               stk_push_frame =  .dummy                     :(RETURN)
stk_push_frame_end
*------------------------------------------------------------------------------
               DEFINE('stk_push_item(v)')                   :(stk_push_item_end)
stk_push_item  head(stk)      =  list(v, head(stk))
               stk_push_item  =  .dummy                     :(RETURN)
stk_push_item_end
*------------------------------------------------------------------------------
               DEFINE('stk_pop_into_parent()child')         :(stk_pop_into_parent_end)
stk_pop_into_parent
               child          =  list_reverse(head(stk))
               stk            =  tail(stk)
               head(stk)      =  list(child, head(stk))
               stk_pop_into_parent =  .dummy                :(RETURN)
stk_pop_into_parent_end
*------------------------------------------------------------------------------
               DEFINE('stk_pop_final(var)')                 :(stk_pop_final_end)
stk_pop_final  $var           =  list_reverse(head(stk))
               stk            =  tail(stk)
               stk_pop_final  =  .dummy                     :(RETURN)
stk_pop_final_end
*------------------------------------------------------------------------------
*  init_list(v) — λ(f"{v}=None") + λ("stack=[]")
*------------------------------------------------------------------------------
               DEFINE('init_list(v)')                       :(init_list_end)
init_list      $v             =
               stk            =
               init_list      =  .dummy                     :(NRETURN)
init_list_end
*------------------------------------------------------------------------------
*  push_list(v) — λ("stack.append(list())") + λ("stack[-1].append(v)")
*  Called as: (word . tag) . *push_list(tag)   or   epsilon . *push_list('BANK')
*------------------------------------------------------------------------------
               DEFINE('push_list(v)')                       :(push_list_end)
push_list      dummy          =  stk_push_frame(v)
               push_list      =  .dummy                     :(NRETURN)
push_list_end
*------------------------------------------------------------------------------
*  push_item(v) — λ("stack[-1].append(v)")
*  Called as: (word . wrd) . *push_item(wrd)
*------------------------------------------------------------------------------
               DEFINE('push_item(v)')                       :(push_item_end)
push_item      dummy          =  stk_push_item(v)
               push_item      =  .dummy                     :(NRETURN)
push_item_end
*------------------------------------------------------------------------------
*  pop_list() — λ("stack[-2].append(tuple(stack.pop()))")
*------------------------------------------------------------------------------
               DEFINE('pop_list()')                         :(pop_list_end)
pop_list       dummy          =  stk_pop_into_parent()
               pop_list       =  .dummy                     :(NRETURN)
pop_list_end
*------------------------------------------------------------------------------
*  pop_final(v) — λ(f"{v}=tuple(stack.pop())")
*------------------------------------------------------------------------------
               DEFINE('pop_final(v)')                       :(pop_final_end)
pop_final      dummy          =  stk_pop_final(v)
               pop_final      =  .dummy                     :(NRETURN)
pop_final_end
*------------------------------------------------------------------------------
               delim          =  SPAN(' ' nl)
               word           =  NOTANY('( )' nl) BREAK('( )' nl)
*------------------------------------------------------------------------------
*  group — direct port of Python:
*    σ('(') + word%"tag" + push_list(tag)
*    + ARBNO(delim + (ζ(λ:group) | word%"wrd" + push_item(wrd)))
*    + pop_list() + σ(')')
*------------------------------------------------------------------------------
               group          =
+              '('
+              (word . tag) . *push_list(tag)
+              ARBNO(
+                  *delim
+                  ( *group
+                  | (word . wrd) . *push_item(wrd)
+                  )
+              )
+              (epsilon . *pop_list())
+              ')'
*------------------------------------------------------------------------------
*  treebank — direct port of Python:
*    POS(0) + init_list("bank") + push_list("'BANK'")
*    + ARBNO(push_list("'ROOT'") + ARBNO(group) + pop_list() + delim)
*    + pop_final("bank") + RPOS(0)
*------------------------------------------------------------------------------
               treebank       =
+              POS(0)
+              (epsilon . *init_list('bank'))
+              (epsilon . *push_list('BANK'))
+              ARBNO(
+                  (epsilon . *push_list('ROOT'))
+                  ARBNO(*group)
+                  *delim
+                  (epsilon . *pop_list())
+              )
+              (epsilon . *pop_final('bank'))
+              RPOS(0)
*------------------------------------------------------------------------------
               DEFINE('pp_node(node,indent)child,nxt,pad')  :(pp_node_end)
pp_node        pad            =  DUPL(' ', indent)
               IDENT(DATATYPE(node), 'string')              :F(pp_node_list)
               OUTPUT         =  pad node                   :(RETURN)
pp_node_list   OUTPUT         =  pad '(' head(node)
               child          =  tail(node)
pp_ch          DIFFER(child)                                :F(pp_close)
               nxt            =  tail(child)
               pp_node(head(child), indent + 3)
               child          =  nxt                        :(pp_ch)
pp_close       OUTPUT         =  pad ')'                    :(RETURN)
pp_node_end
*------------------------------------------------------------------------------
               DEFINE('pp_bank()cur')                       :(pp_bank_end)
pp_bank        pp_node(bank, 0)
               pp_bank        =  .dummy                     :(RETURN)
pp_bank_end
*------------------------------------------------------------------------------
               INPUT(.rdch, 8, 'VBGinTASA.dat')             :F(main_err)
slurp          line           =  rdch                       :F(slurp_done)
               src            =  src line nl                :(slurp)
slurp_done     ENDFILE(8)
               src            treebank                      :F(main_fail)
               dummy          =  pp_bank()                  :(END)
main_fail      OUTPUT         =  'Pattern match failed'     :(END)
main_err       OUTPUT         =  'Could not read VBGinTASA.dat'
*------------------------------------------------------------------------------
END
*-------------------------------------------------------------- 1813 demo_claws5
*------------------------------------------------------------------------------
        DEFINE('token()')  :(token_end)
token   num = +num
        mem = IDENT(mem) TABLE()
        mem[num] = IDENT(mem[num]) TABLE()
        mem[num][wrd] = IDENT(mem[num][wrd]) TABLE()
        mem[num][wrd][tag] = IDENT(mem[num][wrd][tag]) 0
        mem[num][wrd][tag] = mem[num][wrd][tag] + 1
        token = .dummy  :(NRETURN)
token_end
*------------------------------------------------------------------------------
        &TRIM   =   0
        claws   =   POS(0)
+                   ARBNO(
+                     FENCE(
+                       (SPAN('0123456789') . num) '_CRD :_PUN'
+                     | (NOTANY('_') BREAK('_')) . wrd
+                       '_'
+                       (ANY(&UCASE) SPAN('0123456789' &UCASE)) . tag . *token()
+                     )
+                     SPAN(' ' CHAR(10))
+                   )
+                   RPOS(0)
        INPUT(.INPUT, 9, '[-f0 -r4194304]')
        src     =   INPUT  :F(error)
        src     ?   claws  :F(error)
        OUTPUT  =   'matched bytes=' SIZE(src)  :(END)
error   OUTPUT  =   'Pattern match failed'
END
*--------------------------------------------------------- 1814 benchmark_claws5
*------------------------------------------------------------------------------
        DEFINE('token()')  :(token_end)
token   num = +num
        mem = IDENT(mem) TABLE()
        mem[num] = IDENT(mem[num]) TABLE()
        mem[num][wrd] = IDENT(mem[num][wrd]) TABLE()
        mem[num][wrd][tag] = IDENT(mem[num][wrd][tag]) 0
        mem[num][wrd][tag] = mem[num][wrd][tag] + 1
        token = .dummy  :(NRETURN)
token_end
*------------------------------------------------------------------------------
        &TRIM   =   0
        claws   =   POS(0)
+                   ARBNO(
+                     FENCE(
+                       (SPAN('0123456789') . num) '_CRD :_PUN'
+                     | (NOTANY('_') BREAK('_')) . wrd
+                       '_'
+                       (ANY(&UCASE) SPAN('0123456789' &UCASE)) . tag . *token()
+                     )
+                     SPAN(' ' CHAR(10))
+                   )
+                   RPOS(0)
*------------------------------------------------------------------------------
* CLAWS5(N) -- rebuild the num -> word -> tag -> count table N times from the
* slurped corpus and report the bytes matched.  mem is cleared each pass so every
* pass does the same work.
*------------------------------------------------------------------------------
        DEFINE('CLAWS5(N)')  :(CLAWS5_END)
CLAWS5  ZI = 1
ZBL     mem =
        src ? claws  :F(ZBAD)
        ZI = LT(ZI, N) ZI + 1  :S(ZBL)
        CLAWS5 = 'matched bytes=' SIZE(src)  :(RETURN)
ZBAD    CLAWS5 = 'Pattern match failed'  :(RETURN)
CLAWS5_END
*------------------------------------------------------------------------------
        INPUT(.INPUT, 9, '[-f0 -r4194304]')
        src = INPUT
*BENCH kernel=CLAWS5 check=1 bud=1000 flr=20
        OUTPUT = CLAWS5(1)
END
*------------------------------------------------------------ 1815 demo_treebank
*------------------------------------------------------------------------------
                DATA('list(n,a)')
                DEFINE('ListValue(x,place)')
                DEFINE('ListName(x,place)')
                DEFINE('ListAppend(x,item)')
                DEFINE('ListPrepend(x,item)')
                DEFINE('ListInsert(x,item,place)a,i,size')
                DEFINE('ListRemove(x,place)i,size')
                DEFINE('ListPop(x)')
                DEFINE('ListSize(x)')                                   :(ListEnd)
*------------------------------------------------------------------------------
ListValue       place           =   LT(place, 0) n(x) + place
                ListValue       =   a(x)[place]                         :S(RETURN)F(FRETURN)
ListName        place           =   LT(place, 0) n(x) + place
                ListName        =   .a(x)[place]                        :S(RETURN)F(FRETURN)
*------------------------------------------------------------------------------
ListAppend      ListAppend      =   ListInsert(x, item, n(x))           :(RETURN)
*------------------------------------------------------------------------------
ListPrepend     ListPrepend     =   ListInsert(x, item, 0)              :(RETURN)
*------------------------------------------------------------------------------
ListInsert      ListInsert      =   x
                size            =   ListSize(x)
                place           =   LT(place, 0) n(x) + place
                GE(place, 0)                                            :F(error)
                LE(place, n(x))                                         :F(error)
                LT(n(x), size)                                          :F(ListInsert4)
                i               =   n(x) + 1
ListInsert1     i               =   GT(i, place + 1) i - 1              :F(ListInsert2)
                a(x)[i]         =   a(x)[i - 1]                         :(ListInsert1)
ListInsert2     a(x)[i - 1]     =   item                                :(ListInsert9)
ListInsert4     a               =   ARRAY('0:' (IDENT(a(x)) 0, size * 2 - 1))
                i               =   -1
ListInsert5     i               =   LT(i, place - 1) i + 1              :F(ListInsert6)
                a[i]            =   a(x)[i]                             :(ListInsert5)
ListInsert6     a[i + 1]        =   item
ListInsert7     i               =   LT(i, n(x) - 1) i + 1               :F(ListInsert8)
                a[i + 1]        =   a(x)[i]                             :(ListInsert7)
ListInsert8     a(x)            =   a
ListInsert9     n(x)            =   n(x) + 1                            :(RETURN)
*------------------------------------------------------------------------------
ListRemove      place           =   LT(place, 0) n(x) + place
                GE(place, 0)                                            :F(FRETURN)
                LT(place, n(x))                                         :F(FRETURN)
                ListRemove      =   a(x)[place]
                i               =   place
ListRemove1     i               =   LT(i, n(x) - 1) i + 1               :F(ListRemove2)
                a(x)[i - 1]     =   a(x)[i]                             :(ListRemove1)
ListRemove2     a(x)[i]         =
                n(x)            =   n(x) - 1                            :(RETURN)
*------------------------------------------------------------------------------
ListPop         ListPop         =   ListRemove(x, -1)                   :S(RETURN)F(FRETURN)
*------------------------------------------------------------------------------
ListSize        ListSize        =   IDENT(a(x)) 0                       :S(RETURN)
                PROTOTYPE(a(x)) '0:' REM . ListSize
                ListSize        =   ListSize + 1                        :(RETURN)
ListEnd
*------------------------------------------------------------------------------
                DEFINE('Init_list(vs)');    DEFINE('init_list(v)')
                DEFINE('Push_list(vs)');    DEFINE('push_list(v)')
                DEFINE('Push_item(vs)');    DEFINE('push_item(v)')
                DEFINE('Pop_list()');       DEFINE('pop_list()')
                DEFINE('Pop_final(vs)');    DEFINE('pop_final(v)')      :(StackEnd)
*------------------------------------------------------------------------------
Init_list       Init_list       =   EVAL("epsilon . *init_list(" vs ")")  :(RETURN)
Push_list       Push_list       =   EVAL("epsilon . *push_list(" vs ")")  :(RETURN)
Push_item       Push_item       =   EVAL("epsilon . *push_item(" vs ")")  :(RETURN)
Pop_list        Pop_list        =         epsilon . *pop_list()           :(RETURN)
Pop_final       Pop_final       =   EVAL("epsilon . *pop_final(" vs ")")  :(RETURN)
*------------------------------------------------------------------------------
init_list       $v              =
                tags            =   TABLE()
                stack           =   list()
                init_list       =   .dummy                          :(NRETURN)
*------------------------------------------------------------------------------
push_list       tags[v]         =   tags[v] + 1
                ListAppend(stack, list())
                ListAppend(ListValue(stack, -1), v)
                push_list       =   .dummy                          :(NRETURN)
*------------------------------------------------------------------------------
push_item       ListAppend(ListValue(stack, -1), v)
                push_item       =   .dummy                          :(NRETURN)
*------------------------------------------------------------------------------
pop_list        ListAppend(ListValue(stack, -2), ListPop(stack))
                pop_list        =   .dummy                          :(NRETURN)
*------------------------------------------------------------------------------
pop_final       $v              =   ListPop(stack)
                pop_final       =   .dummy                          :(NRETURN)
*------------------------------------------------------------------------------
StackEnd        delim           =   SPAN(' ' CHAR(10))
                word            =   NOTANY('( )' CHAR(10)) BREAK('( )' CHAR(10))
*------------------------------------------------------------------------------
                group           =   '('
+                                   word . tag Push_list('tag')
+                                   ARBNO(
+                                     delim
+                                     FENCE(
+                                       *group
+                                     | word . wrd Push_item('wrd')
+                                     )
+                                   )
+                                   Pop_list()
+                                   ')'
*------------------------------------------------------------------------------
                treebank        =   POS(0)
+                                   Init_list("'bank'")
+                                   Push_list("'BANK'")
+                                   ARBNO(
+                                     Push_list("'ROOT'")
+                                     ARBNO(*group FENCE)
+                                     delim
+                                     FENCE
+                                     Pop_list()
+                                   )
+                                   Pop_final("'bank'")
+                                   RPOS(0)
*------------------------------------------------------------------------------
                INPUT(.INPUT, 9, '[-f0 -r1000000]')
                src             =   INPUT  :F(error)
                src             ?   treebank  :F(error)
                OUTPUT          =   'matched bytes=' SIZE(src)  :(END)
error           OUTPUT          =   'Pattern match failed'
END
*-------------------------------- 1816 user_function_eval_arbno_replace_branch_1
* json -- TIME-BASED: fixed ms budget, count iterations.
* workload: 631 KB of twitter.json parsed into real TABLEs/ARRAYs; check is the full node census.
* DESERIALIZING -- the -match sibling runs the same grammar with NO captures; the delta
* between them is the cost of the sprinkled loads (capture + *function() + structure build).
* Every OUTPUT in the original driver is accumulated into the check value instead of printed,
* so the check witnesses every value computed, not merely that the match succeeded.
* input: json.dat on stdin (runner redirects <family>.dat).
        &STLIMIT =  -1
        ZCHK    =   1
        ZBUD    =   1000
        ZFLR    =   20
*------------------------------------------------------------------------------
* json.sno - JSON DE-SERIALIZER: RFC-8259 text -> native SNOBOL4 data structures.
* ENG 685, Lon Cherryholmes Sr.
*
* This is the WORK member of the json family (json-match.sno / json-match-fence.sno
* are the recognize-only members: same grammar, zero side effects).  Here the ONE
* BIG pattern match carries deferred semantic actions that BUILD the data:
*
*     JSON object  ->  TABLE, keyed by member name   (wrapped in jobj so that
*                      insertion order is retained for deterministic output)
*     JSON array   ->  ARRAY(1..n), one-origin
*     JSON number  ->  INTEGER  (no fraction, no exponent)
*                      REAL     (fraction or exponent present)
*     JSON string  ->  STRING   (escapes decoded, \uXXXX -> UTF-8)
*     true / false ->  STRING 'true' / 'false'
*     null         ->  the null string
*
* Values are reduced on a shift/reduce value stack: a frame records the stack
* base at '{' or '[', and the close brace pops everything above that base into
* one TABLE or ARRAY.  No per-frame allocation, so cost is O(nodes), not O(depth
* * nodes).  All deferred actions are DIRECT (epsilon . *f()) - none are built
* through EVAL, so the run-time-compiled and compile-time-built deferred forms
* are never mixed in one program.
*
* Run: scrip --run json.sno < citm_catalog.json
*      sbl -b -d512m -i64m -s256m json.sno < citm_catalog.json
*      snobol4 -b -f -d 8m -P 4m -S 4m json.sno < citm_catalog.json
*------------------------------------------------------------------------------
                bslash          =   CHAR(92)
                tabch           =   CHAR(9)
                lf              =   CHAR(10)
                cr              =   CHAR(13)
                dq              =   '"'
                dig             =   '0123456789'
*------------------------------------------------------------------------------
                DATA('jobj(otab,okeys,onum)')
*------------------------------------------------------------------------------
*  Value stack (shift/reduce), key stack, and frame stack.
*------------------------------------------------------------------------------
                VMAX            =   262144
                DMAX            =   4096
                vs              =   ARRAY(VMAX)
                ks              =   ARRAY(VMAX)
                fkd             =   ARRAY(DMAX)
                fvb             =   ARRAY(DMAX)
                fkb             =   ARRAY(DMAX)
                vsp             =   0
                ksp             =   0
                dep             =   0
                maxdep          =   0
                nObj            =   0
                nArr            =   0
                nStr            =   0
                nInt            =   0
                nReal           =   0
                nBool           =   0
                nNull           =   0
*------------------------------------------------------------------------------
*  Escape and hex lookup tables.
*------------------------------------------------------------------------------
                esc             =   TABLE()
                esc[dq]         =   dq
                esc[bslash]     =   bslash
                esc['/']        =   '/'
                esc['b']        =   CHAR(8)
                esc['f']        =   CHAR(12)
                esc['n']        =   lf
                esc['r']        =   cr
                esc['t']        =   tabch
                hxv             =   TABLE()
                hxs             =   '0123456789abcdef'
                hxi             =   0
hxlp            hxi             =   LT(hxi, 16) hxi + 1         :F(hxdone)
                hxc             =   SUBSTR(hxs, hxi, 1)
                hxv[hxc]        =   hxi - 1
                hxv[REPLACE(hxc, &LCASE, &UCASE)] = hxi - 1     :(hxlp)
hxdone
*------------------------------------------------------------------------------
*  jutf8(n) - Unicode scalar -> UTF-8 byte string (BMP; surrogates passed through).
*------------------------------------------------------------------------------
                DEFINE('jutf8(n)')                              :(jutf8_end)
jutf8           LT(n, 128)                                      :F(jutf8_2)
                jutf8           =   CHAR(n)                     :(RETURN)
jutf8_2         LT(n, 2048)                                     :F(jutf8_3)
                jutf8           =   CHAR(192 + (n / 64)) CHAR(128 + REMDR(n, 64))
+                                                               :(RETURN)
jutf8_3         jutf8           =   CHAR(224 + (n / 4096))
+                                   CHAR(128 + REMDR(n / 64, 64))
+                                   CHAR(128 + REMDR(n, 64))    :(RETURN)
jutf8_end
*------------------------------------------------------------------------------
*  jdec(s) - decode JSON string escapes.  Fast path returns s untouched when the
*  literal held no backslash at all, which is the common case by a wide margin.
*------------------------------------------------------------------------------
                DEFINE('jdec(s)r,seg,ec,hx,n')                  :(jdec_end)
jdec            s               bslash                          :F(jdec_fast)
                r               =
jdec_lp         s               FENCE (BREAK(bslash) | '') . seg bslash LEN(1) . ec =
+                                                               :F(jdec_done)
                r               =   r seg
                IDENT(ec, 'u')                                  :S(jdec_u)
                r               =   r esc[ec]                   :(jdec_lp)
jdec_u          s               FENCE LEN(4) . hx =             :F(jdec_done)
                n               =   ((hxv[SUBSTR(hx, 1, 1)] * 16 + hxv[SUBSTR(hx, 2, 1)]) * 16
+                                   + hxv[SUBSTR(hx, 3, 1)]) * 16 + hxv[SUBSTR(hx, 4, 1)]
                r               =   r jutf8(n)                  :(jdec_lp)
jdec_done       jdec            =   r s                         :(RETURN)
jdec_fast       jdec            =   s                           :(RETURN)
jdec_end
*------------------------------------------------------------------------------
*  Value-stack shift.
*------------------------------------------------------------------------------
                DEFINE('vpush(v)')                              :(vpush_end)
vpush           vsp             =   vsp + 1
                GT(vsp, VMAX)                                   :S(voflo)
                vs[vsp]         =   v
                vpush           =   .dummy                      :(RETURN)
voflo           OUTPUT          =   'json.sno: value stack overflow at ' vsp
                vpush           =   .dummy                      :(RETURN)
vpush_end
*------------------------------------------------------------------------------
*  Deferred semantic actions - ALL direct (epsilon . *f()), none via EVAL.
*------------------------------------------------------------------------------
                DEFINE('pobj()')                                :(pobj_end)
pobj            dep             =   dep + 1
                maxdep          =   GT(dep, maxdep) dep
                maxdep          =   maxdep
                fkd[dep]        =   'O'
                fvb[dep]        =   vsp
                fkb[dep]        =   ksp
                pobj            =   .dummy                      :(NRETURN)
pobj_end
*------------------------------------------------------------------------------
                DEFINE('parr()')                                :(parr_end)
parr            dep             =   dep + 1
                maxdep          =   GT(dep, maxdep) dep
                maxdep          =   maxdep
                fkd[dep]        =   'A'
                fvb[dep]        =   vsp
                fkb[dep]        =   ksp
                parr            =   .dummy                      :(NRETURN)
parr_end
*------------------------------------------------------------------------------
                DEFINE('ekey()')                                :(ekey_end)
ekey            ksp             =   ksp + 1
                ks[ksp]         =   jdec(jxk)
                ekey            =   .dummy                      :(NRETURN)
ekey_end
*------------------------------------------------------------------------------
                DEFINE('eobj()vb,kb,n,t,ka,i')                  :(eobj_end)
eobj            vb              =   fvb[dep]
                kb              =   fkb[dep]
                n               =   vsp - vb
                t               =   TABLE()
                ka              =   ARRAY(GT(n, 0) n)           :F(eobj_empty)
                i               =   0
eobj_lp         i               =   LT(i, n) i + 1              :F(eobj_fin)
                ka[i]           =   ks[kb + i]
                t[ka[i]]        =   vs[vb + i]                  :(eobj_lp)
eobj_empty      ka              =   ARRAY(1)
eobj_fin        vsp             =   vb
                ksp             =   kb
                dep             =   dep - 1
                nObj            =   nObj + 1
                dummy           =   vpush(jobj(t, ka, n))
                eobj            =   .dummy                      :(NRETURN)
eobj_end
*------------------------------------------------------------------------------
                DEFINE('earr()vb,n,a,i')                        :(earr_end)
earr            vb              =   fvb[dep]
                n               =   vsp - vb
                a               =   ARRAY(GT(n, 0) n)           :F(earr_empty)
                i               =   0
earr_lp         i               =   LT(i, n) i + 1              :F(earr_fin)
                a[i]            =   vs[vb + i]                  :(earr_lp)
earr_empty      a               =   ARRAY(1)
earr_fin        vsp             =   vb
                dep             =   dep - 1
                nArr            =   nArr + 1
                dummy           =   vpush(a)
                earr            =   .dummy                      :(NRETURN)
earr_end
*------------------------------------------------------------------------------
                DEFINE('estr()')                                :(estr_end)
estr            nStr            =   nStr + 1
                dummy           =   vpush(jdec(jxs))
                estr            =   .dummy                      :(NRETURN)
estr_end
*------------------------------------------------------------------------------
*  INTEGER when the literal carried neither fraction nor exponent, else REAL.
*------------------------------------------------------------------------------
                DEFINE('enum()')                                :(enum_end)
enum            jxn             ANY('.eE')                      :S(enum_real)
                nInt            =   nInt + 1
                dummy           =   vpush(CONVERT(jxn, 'INTEGER'))
                enum            =   .dummy                      :(NRETURN)
enum_real       nReal           =   nReal + 1
                dummy           =   vpush(CONVERT(jxn, 'REAL'))
                enum            =   .dummy                      :(NRETURN)
enum_end
*------------------------------------------------------------------------------
                DEFINE('etru()')                                :(etru_end)
etru            nBool           =   nBool + 1
                dummy           =   vpush('true')
                etru            =   .dummy                      :(NRETURN)
etru_end
*------------------------------------------------------------------------------
                DEFINE('efal()')                                :(efal_end)
efal            nBool           =   nBool + 1
                dummy           =   vpush('false')
                efal            =   .dummy                      :(NRETURN)
efal_end
*------------------------------------------------------------------------------
                DEFINE('enul()')                                :(enul_end)
enul            nNull           =   nNull + 1
                dummy           =   vpush(NULL)
                enul            =   .dummy                      :(NRETURN)
enul_end
*------------------------------------------------------------------------------
*  THE GRAMMAR - RFC 8259.  Same shape as json-match.sno; the only additions are
*  the capture dots and the deferred action epsilons.
*------------------------------------------------------------------------------
                ws              =   FENCE(SPAN(' ' tabch lf cr) | '')
                jescape         =   bslash
+                                   ( ANY(dq '/bfnrt' bslash)
+                                   | 'u' ANY('0123456789abcdefABCDEF') ANY('0123456789abcdefABCDEF') ANY('0123456789abcdefABCDEF') ANY('0123456789abcdefABCDEF')
+                                   )
                jchunk          =   BREAK(dq bslash lf cr)
                jstrbody        =   jchunk ARBNO(jescape jchunk)
*------------------------------------------------------------------------------
                jnumber         =   ( FENCE('-' | '')
+                                     ( '0' | ANY('123456789') FENCE(SPAN(dig) | '') )
+                                     FENCE('.' SPAN(dig) | '')
+                                     FENCE(ANY('eE') FENCE(ANY('+-') | '') SPAN(dig) | '')
+                                   ) . jxn
*------------------------------------------------------------------------------
                jkey            =   dq jstrbody . jxk dq (epsilon . *ekey())
                jstring         =   dq jstrbody . jxs dq (epsilon . *estr())
*------------------------------------------------------------------------------
                jmember         =   ws jkey ws ':' *jelement
                jobject         =   '{' (epsilon . *pobj())
+                                   ( jmember ARBNO(',' jmember) | ws )
+                                   '}' (epsilon . *eobj()) FENCE
                jarray          =   '[' (epsilon . *parr())
+                                   ( *jelement ARBNO(',' *jelement) | ws )
+                                   ']' (epsilon . *earr()) FENCE
                jvalue          =   jstring
+                                   | jnumber (epsilon . *enum())
+                                   | jobject
+                                   | jarray
+                                   | 'true'  (epsilon . *etru())
+                                   | 'false' (epsilon . *efal())
+                                   | 'null'  (epsilon . *enul())
                jelement        =   ws *jvalue ws
                json            =   POS(0) jelement RPOS(0)
*------------------------------------------------------------------------------
                &TRIM           =   0
*------------------------------------------------------------------------------
*  READ ALL AT ONCE - .INPUT is re-associated raw on fd 0 with a 4 MiB record
*  length, so a single reference transfers the whole input in one read, byte
*  for byte (no line splitting, no newline reconstruction).  Inputs larger
*  than 4194304 bytes are silently truncated at the -r length.
*------------------------------------------------------------------------------
        INPUT(.INPUT, 9, '[-f0 -r4194304]')
        ZSRC    =   INPUT
        DEFINE('ZBODY(ZKN)')                            :(ZBODY_END)
ZBODY   ZI      =   1
ZBL     vsp     =   0
        ksp     =   0
        dep     =   0
        maxdep  =   0
        nObj    =   0
        nArr    =   0
        nStr    =   0
        nInt    =   0
        nReal   =   0
        nBool   =   0
        nNull   =   0
        ZSRC    ?   json                                :F(ZBAD)
        ZI      =   LT(ZI, ZKN) ZI + 1                  :S(ZBL)
        ZBODY   =   nObj '/' nArr '/' nStr '/' nInt '/' nReal '/' nBool '/' nNull '/' maxdep
+                                                       :(RETURN)
ZBAD    ZBODY   =   'MATCH-FAILED'                      :(RETURN)
ZBODY_END
*	PT-J WALL 1 (s169): ZERO ARBNO iterations complete; the FIRST ARBNO iteration over the
*	deferred (*) body NEVER RETURNS.  `["s"]` has no comma so ARBNO never fires -- it matches
*	in ~1.1 s.  `["s","s"]` fires it ONCE and the program does not come back.
*	⛔ SCRIP DOES NOT TERMINATE ON THE SECOND MATCH.  Measured s169: still spinning at
*	   4 min 11 s, RSS FLAT at 28 MB (control-flow loop, NOT allocation growth); 420 s budget,
*	   no completion; 5 of 5 clean runs timed out.  ⛔ NEVER wire into a gate without a timeout.
*	⛔ The pure-grammar sibling (json-match.sno) does NOT hang on this input -- it has its own
*	   defect (SIGSEGV on any non-empty object).  The hang needs THIS grammar, the one with
*	   the captures, which is why this witness carries it whole: reduction FAILED this seat.
	ZSRC = '["s"]'
	OUTPUT = 'one-element ' ZBODY(1)
	ZSRC = '["s","s"]'
	OUTPUT = 'two-element ' ZBODY(1)
END
