                fvb             =   ARRAY(DMAX)
                fkb             =   ARRAY(DMAX)
                vsp             =   0
                ksp             =   0
                dep             =   0
                maxdep          =   0
                nObj            =   0
                nArr            =   0
                nStr            =   0
                nInt            =   0
                nReal           =   0
                nBool           =   0
                nNull           =   0
*------------------------------------------------------------------------------
*  Escape and hex lookup tables.
*------------------------------------------------------------------------------
                esc             =   TABLE()
                esc[dq]         =   dq
                esc[bslash]     =   bslash
                esc['/']        =   '/'
                esc['b']        =   CHAR(8)
                esc['f']        =   CHAR(12)
                esc['n']        =   lf
                esc['r']        =   cr
                esc['t']        =   tabch
                hxv             =   TABLE()
                hxs             =   '0123456789abcdef'
                hxi             =   0
