*-------------------------------------- 1463 fence_span_capture_replace_branch_2
*	FZ-3: a capture GROUP that WRAPS the cut, plus a capture to the RIGHT of the group.
*	Both readers are staged [rsp+off] cells that the release moves; the predecessor statement is
*	what puts the group COND far enough down the spine for a stale offset to be visible.
	S = 'aaabbbccc'
	S ? SPAN('a') . X FENCE SPAN('b') . Y	:F(BAD)
	OUTPUT = 'A=' X '/' Y
	S ? (SPAN('a') FENCE SPAN('b') . M) . W SPAN('c') . V	:F(BAD)
	OUTPUT = 'C=' W '/' M '/' V	:(END)
BAD	OUTPUT = 'UNEXPECTED-FAIL'
END
*-------------------------------------- 1464 fence_span_capture_replace_branch_5
*	FZ-3: the capture group wraps the cut inside a REPLACEMENT statement, so MATCH_REPLACE reads
*	the subject and the group COND reads its SAVE cursor on the same spine the cut shortened.
	S = 'aaabbbccc'
	S ? SPAN('a') . X FENCE SPAN('b') . Y	:F(BAD)
	OUTPUT = 'A=' X '/' Y
	T = 'aaabbbccc'
	T ? (SPAN('a') FENCE SPAN('b')) . W = 'Z'	:F(BAD)
	OUTPUT = 'R=' T '/' W	:(END)
BAD	OUTPUT = 'UNEXPECTED-FAIL'
END
