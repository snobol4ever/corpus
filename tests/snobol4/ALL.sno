*----------------------------------------- 1708 arbno_fence_pos_replace_branch_1
*  arbno_defer_altarg_red - stored ARBNO whose deferred argument has INTERNAL ALTERNATIVES.
*  NO FENCE ANYWHERE.  Minted s123 as the discriminating control for 148/119/129/149:
*  those four are named "..._fence_..." but the seal is NOT what breaks them.
*  Oracle: ARBNO takes 'a' (cursor 0->1), RPOS(0) fails, backtrack INTO the placed
*  instance picks its second alternative 'ab' (cursor 0->2), RPOS(0) succeeds => MATCH.
*  SCRIP default: NOMATCH (silent wrong answer, no backtrack into a stored pattern).
*  SCRIP SCRIP_DEFER_RESUME=1: SIGSEGV (rbp walks the frame chain to 0) -- SAME crash
*  as the four fence witnesses, proving the crash is the ARBNO retry-unwind over-pop
*  and not a seal-visibility failure.
        cmd   = ('a' | 'ab')
        outer = ARBNO(*cmd)
        s     = 'ab'
        s POS(0) *outer RPOS(0)                               :S(BAD)F(GOOD)
BAD     OUTPUT = 'match'                                      :(END)
GOOD    OUTPUT = 'nomatch'
END
*-------------------------------------------------- 1709 fence_bal_arb_replace_1
*  KW-1 witness: the DATATYPE of every protected repository keyword.
*  SNOBOL4 has NO cset datatype -- &UCASE/&LCASE/&ALPHABET are STRINGs.
	OUTPUT = 'ALPHABET=' DATATYPE(&ALPHABET) ' ' SIZE(&ALPHABET)
	OUTPUT = 'UCASE=' DATATYPE(&UCASE) ' ' SIZE(&UCASE)
	OUTPUT = 'LCASE=' DATATYPE(&LCASE) ' ' SIZE(&LCASE)
	OUTPUT = 'ARB=' DATATYPE(&ARB)
	OUTPUT = 'BAL=' DATATYPE(&BAL)
	OUTPUT = 'REM=' DATATYPE(&REM)
	OUTPUT = 'FAIL=' DATATYPE(&FAIL)
	OUTPUT = 'FENCE=' DATATYPE(&FENCE)
	OUTPUT = 'ABORT=' DATATYPE(&ABORT)
	OUTPUT = 'SUCCEED=' DATATYPE(&SUCCEED)
	OUTPUT = 'RTNTYPE=' DATATYPE(&RTNTYPE)
	OUTPUT = 'STCOUNT=' DATATYPE(&STCOUNT)
	OUTPUT = 'UCASE-val=' &UCASE
	OUTPUT = 'LCASE-val=' &LCASE
END
*--------------------------------------------------- 1710 benchmark_string_manip
* string_manip -- masks every vowel in a fixed sentence and reports the result.
* bottleneck: REPLACE character translation over a fixed string.
* Standalone:  scrip string_manip.sno   |   sbl -bf string_manip.sno   |   snobol4 string_manip.sno
        &TRIM = 1
        &ANCHOR = 0
        &STLIMIT = -1
        DEFINE('STRING_MANIP(N)')                       :(STRING_MANIP_END)
STRING_MANIP  ZI = 1
ZBL     S = 'The quick brown fox jumps over the lazy dog'
        S = REPLACE(S, 'aeiou', '*****')
        NS = SIZE(S)
        ZI = LT(ZI, N) ZI + 1                           :S(ZBL)
        STRING_MANIP = NS                               :(RETURN)
STRING_MANIP_END
*BENCH kernel=STRING_MANIP check=1000 bud=500 flr=20
        OUTPUT = 'masked length = ' STRING_MANIP(1000)
        OUTPUT = 'masked text   = ' S
END
*----------------------------------------------- 1711 benchmark_name_indirection
* name_indirection -- repeatedly reads and writes a variable through a runtime-computed name.
* bottleneck: $-indirection's by-name dispatch chain (rt_call_arr_bl -> try_call_builtin_by_name_bl -> bn_sno_name),
* the mechanism perf-dispatch-fastpath-name-indirect targets. holder never becomes a compile-time-known literal
* name at the $ site, so the s266 .VAR-over-a-literal fold (lower_snobol4.c) cannot short-circuit this loop.
* Standalone:  scrip name_indirection.sno   |   sbl -bf name_indirection.sno   |   snobol4 name_indirection.sno
        &TRIM = 1
        &ANCHOR = 0
        &STLIMIT = -1
        DEFINE('name_indirection(n)')                   :(name_indirection_end)
name_indirection    target = 0
        holder = 'target'
        counter = 1
indirect_loop    $holder = $holder + 1
        counter = LT(counter, n) counter + 1            :S(indirect_loop)
        name_indirection = $holder                       :(RETURN)
name_indirection_end
*BENCH kernel=name_indirection check=20000 bud=500 flr=20
        OUTPUT = 'final value = ' name_indirection(20000)
END
*-------------------------------------------- 1712 arb_span_pos_replace_branch_2
*  leafsib arb flat grn -- s193 (row alt-arb-bal-witness).  THE ALT-ARM LEAF-SUSPENSION CLASS
*  FOR ARB, minted in the PADDED shape of probe/cn/cn_alt_leaf_flat_grn because this family's
*  own leafsib_arb.sno has gone INERT: on the STORED road (`t = (... | ARB . I)`) its cell is
*  already [rbp-96] on BOTH killswitch arms, so it is green for a reason unrelated to the switch
*  it exists to test, and its --compile output is byte-identical across the two arms.
*  Here the alternation is INLINE, so the ARB suspension cell is a RAW FLAT ZLS COORDINATE off
*  rsp (LFC legacy arm).  Only the padding count differs across this pair -- the pattern is the
*  same -- which is what proves the defect is the COORDINATE'S MAGNITUDE and never the shape.
*  Five padding assignments leave it at [rsp+240], still INSIDE the live frame, so the program is
*  green on BOTH arms in BOTH media.  A green here is LUCK, not correctness -- it is the control
*  that dates the red twin's crash to the coordinate and not to ARB.
*  ARB SEMANTICS (SPITBOL v3.7 p.207): ARB carries IMPLICIT alternatives tried BEFORE explicit
*  ones -- it behaves as (LEN(0) | LEN(1) | LEN(2) | ...) -- so its beta resumes an ADVANCING
*  SCAN through a suspension cursor.  That resume is what makes it a scratch-cell leaf.
	V1 = "pad1"
	V2 = "pad2"
	V3 = "pad3"
	V4 = "pad4"
	V5 = "pad5"
	"ab" POS(0) (ARB | SPAN("09")) RPOS(0)	:S(Y)F(N)
Y	OUTPUT = "match"	:(END)
N	OUTPUT = "nomatch"
END
