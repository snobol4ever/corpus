                DEFINE('ekey()')                                :(ekey_end)
ekey            ksp             =   ksp + 1
                ks[ksp]         =   jdec(jxk)
                ekey            =   .dummy                      :(NRETURN)
ekey_end
*------------------------------------------------------------------------------
                DEFINE('eobj()vb,kb,n,t,ka,i')                  :(eobj_end)
eobj            vb              =   fvb[dep]
                kb              =   fkb[dep]
                n               =   vsp - vb
                t               =   TABLE()
                ka              =   ARRAY(GT(n, 0) n)           :F(eobj_empty)
                i               =   0
eobj_lp         i               =   LT(i, n) i + 1              :F(eobj_fin)
                ka[i]           =   ks[kb + i]
                t[ka[i]]        =   vs[vb + i]                  :(eobj_lp)
eobj_empty      ka              =   ARRAY(1)
eobj_fin        vsp             =   vb
                ksp             =   kb
                dep             =   dep - 1
                nObj            =   nObj + 1
                dummy           =   vpush(jobj(t, ka, n))
                eobj            =   .dummy                      :(NRETURN)
eobj_end
*------------------------------------------------------------------------------
                DEFINE('earr()vb,n,a,i')                        :(earr_end)
earr            vb              =   fvb[dep]
                n               =   vsp - vb
                a               =   ARRAY(GT(n, 0) n)           :F(earr_empty)
                i               =   0
earr_lp         i               =   LT(i, n) i + 1              :F(earr_fin)
                a[i]            =   vs[vb + i]                  :(earr_lp)
earr_empty      a               =   ARRAY(1)
earr_fin        vsp             =   vb
                dep             =   dep - 1
                nArr            =   nArr + 1
                dummy           =   vpush(a)
                earr            =   .dummy                      :(NRETURN)
earr_end
*------------------------------------------------------------------------------
                DEFINE('estr()')                                :(estr_end)
estr            nStr            =   nStr + 1
                dummy           =   vpush(jdec(jxs))
                estr            =   .dummy                      :(NRETURN)
estr_end
*------------------------------------------------------------------------------
*  INTEGER when the literal carried neither fraction nor exponent, else REAL.
*------------------------------------------------------------------------------
                DEFINE('enum()')                                :(enum_end)
enum            jxn             ANY('.eE')                      :S(enum_real)
                nInt            =   nInt + 1
                dummy           =   vpush(CONVERT(jxn, 'INTEGER'))
                enum            =   .dummy                      :(NRETURN)
enum_real       nReal           =   nReal + 1
                dummy           =   vpush(CONVERT(jxn, 'REAL'))
                enum            =   .dummy                      :(NRETURN)
enum_end
*------------------------------------------------------------------------------
                DEFINE('etru()')                                :(etru_end)
etru            nBool           =   nBool + 1
                dummy           =   vpush('true')
                etru            =   .dummy                      :(NRETURN)
etru_end
*------------------------------------------------------------------------------
                DEFINE('efal()')                                :(efal_end)
efal            nBool           =   nBool + 1
                dummy           =   vpush('false')
                efal            =   .dummy                      :(NRETURN)
efal_end
*------------------------------------------------------------------------------
                DEFINE('enul()')                                :(enul_end)
enul            nNull           =   nNull + 1
                dummy           =   vpush(NULL)
                enul            =   .dummy                      :(NRETURN)
enul_end
*------------------------------------------------------------------------------
*  THE GRAMMAR - RFC 8259.  Same shape as json-match.sno; the only additions are
*  the capture dots and the deferred action epsilons.
*------------------------------------------------------------------------------
                ws              =   FENCE(SPAN(' ' tabch lf cr) | '')
                jescape         =   bslash
+                                   ( ANY(dq '/bfnrt' bslash)
+                                   | 'u' ANY('0123456789abcdefABCDEF') ANY('0123456789abcdefABCDEF') ANY('0123456789abcdefABCDEF') ANY('0123456789abcdefABCDEF')
+                                   )
                jchunk          =   BREAK(dq bslash lf cr)
                jstrbody        =   jchunk ARBNO(jescape jchunk)
*------------------------------------------------------------------------------
                jnumber         =   ( FENCE('-' | '')
+                                     ( '0' | ANY('123456789') FENCE(SPAN(dig) | '') )
+                                     FENCE('.' SPAN(dig) | '')
+                                     FENCE(ANY('eE') FENCE(ANY('+-') | '') SPAN(dig) | '')
+                                   ) . jxn
*------------------------------------------------------------------------------
                jkey            =   dq jstrbody . jxk dq FENCE (epsilon . *ekey())
                jstring         =   dq jstrbody . jxs dq FENCE (epsilon . *estr())
*------------------------------------------------------------------------------
                jmember         =   ws jkey ws ':' *jelement
                jobject         =   '{' (epsilon . *pobj())
+                                   ( jmember ARBNO(',' jmember) | ws )
+                                   '}' (epsilon . *eobj()) FENCE
                jarray          =   '[' (epsilon . *parr())
+                                   ( *jelement ARBNO(',' *jelement) | ws )
+                                   ']' (epsilon . *earr()) FENCE
                jvalue          =   jstring
+                                   | jnumber (epsilon . *enum())
+                                   | jobject
+                                   | jarray
+                                   | 'true'  (epsilon . *etru())
+                                   | 'false' (epsilon . *efal())
+                                   | 'null'  (epsilon . *enul())
                jelement        =   ws *jvalue ws
                json            =   POS(0) jelement RPOS(0)
*------------------------------------------------------------------------------
                &TRIM           =   0
*------------------------------------------------------------------------------
*  READ ALL AT ONCE - .INPUT is re-associated raw on fd 0 with a 4 MiB record
*  length, so a single reference transfers the whole input in one read, byte
*  for byte (no line splitting, no newline reconstruction).  Inputs larger
*  than 4194304 bytes are silently truncated at the -r length.
*------------------------------------------------------------------------------
                INPUT(.INPUT, 9, '[-f0 -r4194304]')
                src             =   INPUT                       :F(slurped)
slurped         OUTPUT          =   'input bytes=' SIZE(src)
*------------------------------------------------------------------------------
*  THE ONE BIG PATTERN MATCH - timed alone.  TIME() is integer nanoseconds off a
*  monotonic wall clock (FINDING s249), so t1 - t0 is the match only: no slurp,
*  no reporting, no start-up; divide by 1000000 for match_ms, same idiom as
*  harness.inc's "ms:" line.  Written to TERMINAL, i.e. stderr, so that stdout
*  stays deterministic and byte-comparable against .ref.
*------------------------------------------------------------------------------
                t0              =   TIME()
                src             json                            :F(fail)
                t1              =   TIME()
*------------------------------------------------------------------------------
                root            =   vs[1]
                OUTPUT          =   'root=' DATATYPE(root)
                OUTPUT          =   'objects=' nObj
                OUTPUT          =   'arrays=' nArr
                OUTPUT          =   'strings=' nStr
                OUTPUT          =   'integers=' nInt
                OUTPUT          =   'reals=' nReal
                OUTPUT          =   'booleans=' nBool
                OUTPUT          =   'nulls=' nNull
                OUTPUT          =   'maxdepth=' maxdep
                TERMINAL        =   'match_ms=' (t1 - t0) / 1000000       :(END)
*------------------------------------------------------------------------------
fail            t1              =   TIME()
                OUTPUT          =   'Pattern match failed'
                TERMINAL        =   'match_ms=' (t1 - t0) / 1000000
*------------------------------------------------------------------------------
END
*----------------------------------------------------------- 1818 benchmark_json
*------------------------------------------------------------------------------
* json.sno - JSON DE-SERIALIZER: RFC-8259 text -> native SNOBOL4 data structures.
* ENG 685, Lon Cherryholmes Sr.
*
* This is the WORK member of the json family (json-match.sno / json-match-fence.sno
* are the recognize-only members: same grammar, zero side effects).  Here the ONE
* BIG pattern match carries deferred semantic actions that BUILD the data:
*
*     JSON object  ->  TABLE, keyed by member name   (wrapped in jobj so that
*                      insertion order is retained for deterministic output)
*     JSON array   ->  ARRAY(1..n), one-origin
*     JSON number  ->  INTEGER  (no fraction, no exponent)
*                      REAL     (fraction or exponent present)
*     JSON string  ->  STRING   (escapes decoded, \uXXXX -> UTF-8)
*     true / false ->  STRING 'true' / 'false'
*     null         ->  the null string
*
* Values are reduced on a shift/reduce value stack: a frame records the stack
* base at '{' or '[', and the close brace pops everything above that base into
* one TABLE or ARRAY.  No per-frame allocation, so cost is O(nodes), not O(depth
* * nodes).  All deferred actions are DIRECT (epsilon . *f()) - none are built
* through EVAL, so the run-time-compiled and compile-time-built deferred forms
* are never mixed in one program.
*
* Run: scrip --run json.sno < citm_catalog.json
*      sbl -b -d512m -i64m -s256m json.sno < citm_catalog.json
*      snobol4 -b -f -d 8m -P 4m -S 4m json.sno < citm_catalog.json
*------------------------------------------------------------------------------
                bslash          =   CHAR(92)
                tabch           =   CHAR(9)
                lf              =   CHAR(10)
                cr              =   CHAR(13)
                dq              =   '"'
                dig             =   '0123456789'
*------------------------------------------------------------------------------
                DATA('jobj(otab,okeys,onum)')
*------------------------------------------------------------------------------
*  Value stack (shift/reduce), key stack, and frame stack.
*------------------------------------------------------------------------------
                VMAX            =   262144
                DMAX            =   4096
                vs              =   ARRAY(VMAX)
                ks              =   ARRAY(VMAX)
                fkd             =   ARRAY(DMAX)
                fvb             =   ARRAY(DMAX)
                fkb             =   ARRAY(DMAX)
                vsp             =   0
                ksp             =   0
                dep             =   0
                maxdep          =   0
                nObj            =   0
                nArr            =   0
                nStr            =   0
                nInt            =   0
                nReal           =   0
                nBool           =   0
                nNull           =   0
*------------------------------------------------------------------------------
*  Escape and hex lookup tables.
*------------------------------------------------------------------------------
                esc             =   TABLE()
                esc[dq]         =   dq
                esc[bslash]     =   bslash
                esc['/']        =   '/'
                esc['b']        =   CHAR(8)
                esc['f']        =   CHAR(12)
                esc['n']        =   lf
                esc['r']        =   cr
                esc['t']        =   tabch
                hxv             =   TABLE()
                hxs             =   '0123456789abcdef'
                hxi             =   0
hxlp            hxi             =   LT(hxi, 16) hxi + 1         :F(hxdone)
                hxc             =   SUBSTR(hxs, hxi, 1)
                hxv[hxc]        =   hxi - 1
                hxv[REPLACE(hxc, &LCASE, &UCASE)] = hxi - 1     :(hxlp)
hxdone
*------------------------------------------------------------------------------
*  jutf8(n) - Unicode scalar -> UTF-8 byte string (BMP; surrogates passed through).
*------------------------------------------------------------------------------
                DEFINE('jutf8(n)')                              :(jutf8_end)
jutf8           LT(n, 128)                                      :F(jutf8_2)
                jutf8           =   CHAR(n)                     :(RETURN)
jutf8_2         LT(n, 2048)                                     :F(jutf8_3)
                jutf8           =   CHAR(192 + (n / 64)) CHAR(128 + REMDR(n, 64))
+                                                               :(RETURN)
jutf8_3         jutf8           =   CHAR(224 + (n / 4096))
+                                   CHAR(128 + REMDR(n / 64, 64))
+                                   CHAR(128 + REMDR(n, 64))    :(RETURN)
jutf8_end
*------------------------------------------------------------------------------
*  jdec(s) - decode JSON string escapes.  Fast path returns s untouched when the
*  literal held no backslash at all, which is the common case by a wide margin.
*------------------------------------------------------------------------------
                DEFINE('jdec(s)r,seg,ec,hx,n')                  :(jdec_end)
jdec            s               bslash                          :F(jdec_fast)
                r               =
jdec_lp         s               FENCE (BREAK(bslash) | '') . seg bslash LEN(1) . ec =
+                                                               :F(jdec_done)
                r               =   r seg
                IDENT(ec, 'u')                                  :S(jdec_u)
                r               =   r esc[ec]                   :(jdec_lp)
jdec_u          s               FENCE LEN(4) . hx =             :F(jdec_done)
                n               =   ((hxv[SUBSTR(hx, 1, 1)] * 16 + hxv[SUBSTR(hx, 2, 1)]) * 16
+                                   + hxv[SUBSTR(hx, 3, 1)]) * 16 + hxv[SUBSTR(hx, 4, 1)]
                r               =   r jutf8(n)                  :(jdec_lp)
jdec_done       jdec            =   r s                         :(RETURN)
jdec_fast       jdec            =   s                           :(RETURN)
jdec_end
*------------------------------------------------------------------------------
*  Value-stack shift.
*------------------------------------------------------------------------------
                DEFINE('vpush(v)')                              :(vpush_end)
vpush           vsp             =   vsp + 1
                GT(vsp, VMAX)                                   :S(voflo)
                vs[vsp]         =   v
                vpush           =   .dummy                      :(RETURN)
voflo           OUTPUT          =   'json.sno: value stack overflow at ' vsp
                vpush           =   .dummy                      :(RETURN)
vpush_end
*------------------------------------------------------------------------------
*  Deferred semantic actions - ALL direct (epsilon . *f()), none via EVAL.
*------------------------------------------------------------------------------
                DEFINE('pobj()')                                :(pobj_end)
pobj            dep             =   dep + 1
                maxdep          =   GT(dep, maxdep) dep
                maxdep          =   maxdep
                fkd[dep]        =   'O'
                fvb[dep]        =   vsp
                fkb[dep]        =   ksp
                pobj            =   .dummy                      :(NRETURN)
pobj_end
*------------------------------------------------------------------------------
                DEFINE('parr()')                                :(parr_end)
parr            dep             =   dep + 1
                maxdep          =   GT(dep, maxdep) dep
                maxdep          =   maxdep
                fkd[dep]        =   'A'
                fvb[dep]        =   vsp
                fkb[dep]        =   ksp
                parr            =   .dummy                      :(NRETURN)
parr_end
*------------------------------------------------------------------------------
                DEFINE('ekey()')                                :(ekey_end)
ekey            ksp             =   ksp + 1
                ks[ksp]         =   jdec(jxk)
                ekey            =   .dummy                      :(NRETURN)
ekey_end
*------------------------------------------------------------------------------
                DEFINE('eobj()vb,kb,n,t,ka,i')                  :(eobj_end)
eobj            vb              =   fvb[dep]
                kb              =   fkb[dep]
                n               =   vsp - vb
                t               =   TABLE()
                ka              =   ARRAY(GT(n, 0) n)           :F(eobj_empty)
                i               =   0
eobj_lp         i               =   LT(i, n) i + 1              :F(eobj_fin)
                ka[i]           =   ks[kb + i]
                t[ka[i]]        =   vs[vb + i]                  :(eobj_lp)
eobj_empty      ka              =   ARRAY(1)
eobj_fin        vsp             =   vb
                ksp             =   kb
                dep             =   dep - 1
                nObj            =   nObj + 1
                dummy           =   vpush(jobj(t, ka, n))
                eobj            =   .dummy                      :(NRETURN)
eobj_end
*------------------------------------------------------------------------------
                DEFINE('earr()vb,n,a,i')                        :(earr_end)
earr            vb              =   fvb[dep]
                n               =   vsp - vb
                a               =   ARRAY(GT(n, 0) n)           :F(earr_empty)
                i               =   0
earr_lp         i               =   LT(i, n) i + 1              :F(earr_fin)
                a[i]            =   vs[vb + i]                  :(earr_lp)
earr_empty      a               =   ARRAY(1)
earr_fin        vsp             =   vb
                dep             =   dep - 1
                nArr            =   nArr + 1
                dummy           =   vpush(a)
                earr            =   .dummy                      :(NRETURN)
earr_end
*------------------------------------------------------------------------------
                DEFINE('estr()')                                :(estr_end)
estr            nStr            =   nStr + 1
                dummy           =   vpush(jdec(jxs))
                estr            =   .dummy                      :(NRETURN)
estr_end
*------------------------------------------------------------------------------
*  INTEGER when the literal carried neither fraction nor exponent, else REAL.
*------------------------------------------------------------------------------
                DEFINE('enum()')                                :(enum_end)
enum            jxn             ANY('.eE')                      :S(enum_real)
                nInt            =   nInt + 1
                dummy           =   vpush(CONVERT(jxn, 'INTEGER'))
                enum            =   .dummy                      :(NRETURN)
enum_real       nReal           =   nReal + 1
                dummy           =   vpush(CONVERT(jxn, 'REAL'))
                enum            =   .dummy                      :(NRETURN)
enum_end
*------------------------------------------------------------------------------
                DEFINE('etru()')                                :(etru_end)
etru            nBool           =   nBool + 1
                dummy           =   vpush('true')
                etru            =   .dummy                      :(NRETURN)
etru_end
*------------------------------------------------------------------------------
                DEFINE('efal()')                                :(efal_end)
efal            nBool           =   nBool + 1
                dummy           =   vpush('false')
                efal            =   .dummy                      :(NRETURN)
efal_end
*------------------------------------------------------------------------------
                DEFINE('enul()')                                :(enul_end)
enul            nNull           =   nNull + 1
                dummy           =   vpush(NULL)
                enul            =   .dummy                      :(NRETURN)
enul_end
*------------------------------------------------------------------------------
*  THE GRAMMAR - RFC 8259.  Same shape as json-match.sno; the only additions are
*  the capture dots and the deferred action epsilons.
*------------------------------------------------------------------------------
                ws              =   FENCE(SPAN(' ' tabch lf cr) | '')
                jescape         =   bslash
+                                   ( ANY(dq '/bfnrt' bslash)
+                                   | 'u' ANY('0123456789abcdefABCDEF') ANY('0123456789abcdefABCDEF') ANY('0123456789abcdefABCDEF') ANY('0123456789abcdefABCDEF')
+                                   )
                jchunk          =   BREAK(dq bslash lf cr)
                jstrbody        =   jchunk ARBNO(jescape jchunk)
*------------------------------------------------------------------------------
                jnumber         =   ( FENCE('-' | '')
+                                     ( '0' | ANY('123456789') FENCE(SPAN(dig) | '') )
+                                     FENCE('.' SPAN(dig) | '')
+                                     FENCE(ANY('eE') FENCE(ANY('+-') | '') SPAN(dig) | '')
+                                   ) . jxn
*------------------------------------------------------------------------------
                jkey            =   dq jstrbody . jxk dq FENCE (epsilon . *ekey())
                jstring         =   dq jstrbody . jxs dq FENCE (epsilon . *estr())
*------------------------------------------------------------------------------
                jmember         =   ws jkey ws ':' *jelement
                jobject         =   '{' (epsilon . *pobj())
+                                   ( jmember ARBNO(',' jmember) | ws )
+                                   '}' (epsilon . *eobj()) FENCE
                jarray          =   '[' (epsilon . *parr())
+                                   ( *jelement ARBNO(',' *jelement) | ws )
+                                   ']' (epsilon . *earr()) FENCE
                jvalue          =   jstring
+                                   | jnumber (epsilon . *enum())
+                                   | jobject
+                                   | jarray
+                                   | 'true'  (epsilon . *etru())
+                                   | 'false' (epsilon . *efal())
+                                   | 'null'  (epsilon . *enul())
                jelement        =   ws *jvalue ws
                json            =   POS(0) jelement RPOS(0)
*------------------------------------------------------------------------------
                &TRIM           =   0
*------------------------------------------------------------------------------
*  READ ALL AT ONCE - .INPUT is re-associated raw on fd 0 with a 4 MiB record
*  length, so a single reference transfers the whole input in one read, byte
*  for byte (no line splitting, no newline reconstruction).  Inputs larger
*  than 4194304 bytes are silently truncated at the -r length.
*------------------------------------------------------------------------------
*------------------------------------------------------------------------------
* JSON(N) -- deserialize the slurped text N times and report the node census.
* Every counter and both stacks are reset per pass, so each pass does the same
* work and the census is the census of ONE parse, not of N accumulated ones.
*------------------------------------------------------------------------------
        DEFINE('JSON(N)')  :(JSON_END)
JSON    ZI = 1
ZBL     vsp = 0
        ksp = 0
        dep = 0
        maxdep = 0
        nObj = 0
        nArr = 0
        nStr = 0
        nInt = 0
        nReal = 0
        nBool = 0
        nNull = 0
        src json  :F(ZBAD)
        ZI = LT(ZI, N) ZI + 1  :S(ZBL)
        JSON = nObj '/' nArr '/' nStr '/' nInt '/' nReal '/' nBool '/' nNull '/' maxdep
+                                                       :(RETURN)
ZBAD    JSON = 'Pattern match failed'  :(RETURN)
JSON_END
*------------------------------------------------------------------------------
        INPUT(.INPUT, 9, '[-f0 -r4194304]')
        src             =   INPUT
*BENCH kernel=JSON check=1 bud=1000 flr=20
                OUTPUT          =   'input bytes=' SIZE(src)
*------------------------------------------------------------------------------
*  THE ONE BIG PATTERN MATCH - timed alone.  TIME() is integer nanoseconds off a
*  monotonic wall clock (FINDING s249), so t1 - t0 is the match only: no slurp,
*  no reporting, no start-up; divide by 1000000 for match_ms, same idiom as
*  harness.inc's "ms:" line.  Written to TERMINAL, i.e. stderr, so that stdout
*  stays deterministic and byte-comparable against .ref.
*------------------------------------------------------------------------------
                t0              =   TIME()
                src             json                            :F(fail)
                t1              =   TIME()
*------------------------------------------------------------------------------
                root            =   vs[1]
                OUTPUT          =   'root=' DATATYPE(root)
                OUTPUT          =   'objects=' nObj
                OUTPUT          =   'arrays=' nArr
                OUTPUT          =   'strings=' nStr
                OUTPUT          =   'integers=' nInt
                OUTPUT          =   'reals=' nReal
                OUTPUT          =   'booleans=' nBool
                OUTPUT          =   'nulls=' nNull
                OUTPUT          =   'maxdepth=' maxdep
                TERMINAL        =   'match_ms=' (t1 - t0) / 1000000       :(END)
*------------------------------------------------------------------------------
fail            t1              =   TIME()
                OUTPUT          =   'Pattern match failed'
                TERMINAL        =   'match_ms=' (t1 - t0) / 1000000
*------------------------------------------------------------------------------
END
*--------------------------------------------------- 1819 simple_program_1 XFAIL
* -INCLUDE names a file that exists nowhere in the corpus repo.  BOTH scrip and sbl -bf refuse
* it identically (ERROR 285 upstream) -- a missing corpus fixture, not a SCRIP defect.  Mirrors
* the already-documented lon_cherryholmes 24-file include gap (RULES.md ABSOLUTE RULES).
-INCLUDE 'nonexistent_target.sno'
END
*--------------------------------------------------- 1820 simple_output_63 XFAIL
* SCRIP requires uppercase END (design choice, RULES.md); csnobol4_suite programs commonly end
* lowercase.  BOTH scrip and the sbl -bf correctness oracle reject this -- corpus dialect, not a
* SCRIP-only defect.  Cure: util_uppercase_keywords.py already exists for this normalization.
	value = 1
	OUTPUT = value
end
*--------------------------------------------------- 1821 simple_output_67 XFAIL
*  MINIMAL WITNESS (s183): BLANKS('X = A') must remove blanks -> 'X=A'.
*  SCRIP answers 'X = A' -- a SILENT WRONG ANSWER, oracle-differential, and
*  INDEPENDENT of RTSEQ-RESUME (SCRIP_RTSEQ_RESUME=0 gives the same wrong answer).
-INCLUDE "BLANKS.sno"
        OUTPUT  =  BLANKS('X = A')
END
*--------------------------------------------------- 1822 simple_output_64 XFAIL
* ORD (character -> ordinal value, the inverse of CHAR) is unimplemented in scrip: fatal parse-
* time "Error 5 -- Undefined function or operation", no output at all (root cause of
* csnobol4_suite/ord.sno's RC1).  sbl -bf ALSO refuses it (runtime ERROR 022 -- undefined
* function called) though it degrades softer (continues to a stats dump, rc=0) rather than
* refusing to compile.  Both tools lack ORD -- likely a CSNOBOL4-only extension outside SCRIP's
* stated SPITBOL-semantics target, not a confirmed SCRIP-specific gap.
	OUTPUT = ORD('A')
END
*--------------------------------------------------- 1823 simple_output_68 XFAIL
*  gim_double_include_hang - INCLUDING THE SAME FILE TWICE HANGS SCRIP.
*
*  Distilled from gimpel batch D.  MINP.sno includes SPACING.sno AND
*  COUNT.sno, and SPACING.sno itself includes COUNT.sno -- the ordinary
*  "name every module you use" habit, which is why the shape is everywhere in
*  the gimpel library.  The oracle is INCLUDE-ONCE and answers normally.
*  SCRIP re-expands the file, and the resulting image never terminates:
*  rc=124, NO output, NO diagnostic, in BOTH modes.
*
*  ORACLE: 3.  SCRIP: hangs.
*  Control one file over: gim_double_include_once_control (same body, one
*  include) is GREEN, so the ingredient is the SECOND include and nothing else.
-INCLUDE "gim_double_include_hang_A.sno"
-INCLUDE "gim_double_include_hang_A.sno"
        OUTPUT  =  DI_COUNT('aaa','a')
END
*--------------------------------------------------- 1824 simple_output_70 XFAIL
*  gim_or_single_alternative_crash - distilled from gimpel batch E, where it
*  takes OR_driver, ORSORT_driver and ORVISUAL_driver together.
*  ONE call to OR(LIST) with a SINGLE one-character alternative crashes
*  SCRIP.  The oracle (sbl -b) prints "built".  SCRIP dies before it.
*  ⛔ IT IS NONDETERMINISTIC, AND THAT IS THE POINT: measured n=12 per mode
*  on the full driver, SCRIP always fails but the SIGNAL varies run to run --
*  OR m3 SIGSEGV 7 / SIGABRT 5, m4 SIGSEGV 8 / SIGABRT 4; ORSORT m3 9/3,
*  m4 6/6; ORVISUAL m3 SIGSEGV 2 / SIGABRT 5 / COMPLETED 5, m4 SIGABRT 9 /
*  COMPLETED 3.  At this minimum size it is 6/6 crashes, alternating 139
*  and 134.  A SINGLE-RUN BOARD ROW ON THIS FAMILY IS AN ARBITRARY DRAW,
*  not a verdict -- do not bisect against one run.
*  ⭐ THE m4 BINARY FLAPS TOO, so the nondeterminism lives in the RUNTIME
*  (out/libscrip_rt.so), not in compilation: the same emitted binary run
*  twice gives different signals.
*  ⛔ AND SHRINKING PROVES IT IS NOT THE ALTERNATION: ',A,B' ',AB,AC' and
*  ',ABLE,ACTOR' all crash exactly as ',A' does, so the defect is reached by
*  OR's machinery on ONE alternative and needs no alternation at all.
*  On the runs where the full ORVISUAL driver DOES complete, OR() does not
*  return a wrong string -- it FAILS, so the OUTPUT statement assigns
*  nothing and the line is absent entirely.
*  OR.sno and BALREV.sno are copied in beside this file so the probe stands
*  alone in its own directory (the BLANKS.sno + DIFF.sno precedent).
-INCLUDE "OR.sno"
        P  =  OR(',A')
        OUTPUT  =  'built'
