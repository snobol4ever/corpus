*---------------------------------------- 1425 code_eval_datatype_trim_replace_1
*  KW-1 witness: bare (unprefixed) keyword names are ORDINARY VARIABLES.
*  Manual Ch.16 p.187: "Their names are set apart from other variables by
*  the unary operator ampersand (&)."  A bare name therefore has NO keyword
*  meaning and reads as the null string until the program assigns it.
	OUTPUT = '[' STCOUNT ']'
	OUTPUT = '[' STNO ']'
	OUTPUT = '[' STLIMIT ']'
	OUTPUT = '[' ANCHOR ']'
	OUTPUT = '[' TRIM ']'
	OUTPUT = '[' FULLSCAN ']'
	OUTPUT = '[' CASE ']'
	OUTPUT = '[' MAXLNGTH ']'
	OUTPUT = '[' FTRACE ']'
	OUTPUT = '[' TRACE ']'
	OUTPUT = '[' ERRLIMIT ']'
	OUTPUT = '[' CODE ']'
	OUTPUT = '[' FNCLEVEL ']'
	OUTPUT = '[' RTNTYPE ']'
	OUTPUT = 'DT-STCOUNT=' DATATYPE(STCOUNT)
	OUTPUT = 'DT-ANCHOR=' DATATYPE(ANCHOR)
*  a bare name is assignable like any variable, and assigning it must NOT
*  disturb the keyword of the same name
	ANCHOR = 'mine'
	OUTPUT = 'bare-after-assign=[' ANCHOR ']'
	OUTPUT = 'kw-still=' &ANCHOR
END
*------------------------------------------ 1426 convert_size_indirect_replace_1
*  driver.sno — test driver for global.sno
*  Oracle: snobol4 -f -P256k -I$INC driver.sno
*  Exercises: character constants (nul/bs/ht/tab/nl/lf/vt/ff/cr/fSlash/semicolon/bSlash)
*             UTF table construction and lookup
*             TRUE/FALSE/digits globals
-INCLUDE 'global.inc'

        &STLIMIT = 1000000

*  Character constants — verify by IDENT against CHAR() round-trip
        OUTPUT = EQ(SIZE(nul),1)   IDENT(nul,CHAR(0))   'PASS: nul'
        OUTPUT = EQ(SIZE(bs),1)    IDENT(bs,CHAR(8))    'PASS: bs'
        OUTPUT = EQ(SIZE(ht),1)    IDENT(ht,CHAR(9))    'PASS: ht'
        OUTPUT = EQ(SIZE(tab),1)   IDENT(tab,CHAR(9))   'PASS: tab'
        OUTPUT = EQ(SIZE(nl),1)    IDENT(nl,CHAR(10))   'PASS: nl'
        OUTPUT = EQ(SIZE(lf),1)    IDENT(lf,CHAR(10))   'PASS: lf'
        OUTPUT = EQ(SIZE(vt),1)    IDENT(vt,CHAR(11))   'PASS: vt'
        OUTPUT = EQ(SIZE(ff),1)    IDENT(ff,CHAR(12))   'PASS: ff'
        OUTPUT = EQ(SIZE(cr),1)    IDENT(cr,CHAR(13))   'PASS: cr'
        OUTPUT = IDENT(fSlash,CHAR(47))                 'PASS: fSlash'
        OUTPUT = IDENT(semicolon,CHAR(59))              'PASS: semicolon'
        OUTPUT = IDENT(bSlash,CHAR(92))                 'PASS: bSlash'

*  TRUE/FALSE/digits
        OUTPUT = IDENT(CONVERT(TRUE,'STRING'),'1')   'PASS: TRUE'
        OUTPUT = IDENT(CONVERT(FALSE,'STRING'),'0')  'PASS: FALSE'
        OUTPUT = IDENT(digits,'0123456789') 'PASS: digits'

*  UTF table — spot check a few well-known entries
        OUTPUT = IDENT(UTF[CHAR(194) CHAR(169)],'COPYRIGHT_SIGN')    'PASS: UTF COPYRIGHT_SIGN'
        OUTPUT = IDENT(UTF[CHAR(194) CHAR(174)],'REGISTERED_SIGN')   'PASS: UTF REGISTERED_SIGN'
        OUTPUT = IDENT(UTF[CHAR(226) CHAR(128) CHAR(148)],'EM_DASH') 'PASS: UTF EM_DASH'

*  UTF indirect assignment (G1 loop) — verify $'name' = name mapping
        OUTPUT = IDENT(COPYRIGHT_SIGN, CHAR(194) CHAR(169)) 'PASS: UTF indirect COPYRIGHT_SIGN'
        OUTPUT = IDENT(EM_DASH, CHAR(226) CHAR(128) CHAR(148)) 'PASS: UTF indirect EM_DASH'

END
*----------------------------------------------- 1427 dupl_size_replace_branch_1
*---------------------------------------------------------------------------------------------------
* beauty_readwrite_roundtrip.sno -- CALLS beauty's Read()/Write() (corpus/include/ReadWrite.inc) on
* REAL files, not just bad paths, so the file-spec argument shape is genuinely exercised end to end.
* FINDING-2026-08-29-hq_P-a-program-passing-is-not-evidence-the-code-it-includes-passes.md found
* that beauty.sno itself never calls Read()/Write() (it only -INCLUDEs them), so their portability
* had never actually been graded against a live oracle -- this witness closes that gap. Also checks
* the offset->line-number map Read() builds, and the pre-existing bad-path FRETURN behavior.
* Oracle: VERIFIED IDENTICAL under BOTH x64/bin/sbl -bf (SPITBOL) and CSNOBOL4B 2.3.3 snobol4 -f --
* .ref is safe to grade against either.
* Run from corpus/include so -INCLUDE resolves (same convention as util_run_beauty_oracle.sh):
*   (cd corpus/include && /home/resources/x64/bin/sbl -bf ../probe/beauty_readwrite_roundtrip.sno)
*   (cd corpus/include && /home/resources/csnobol4/snobol4 -f -b ../probe/beauty_readwrite_roundtrip.sno)
*---------------------------------------------------------------------------------------------------
-INCLUDE 'global.inc'
-INCLUDE 'ReadWrite.inc'
        longLine  =  DUPL('x', 5000)
        content   =  'first line' nl longLine nl 'last line' nl
        Write('/tmp/beauty_rw_roundtrip_probe_tmp.dat', content)          :F(T1BAD)
        got       =  Read('/tmp/beauty_rw_roundtrip_probe_tmp.dat', 'rwmap') :F(T1BAD)
        IDENT(got, content)                                               :F(T1BAD)
        OUTPUT = 'T1 PASS: Write/Read roundtrip on a real file matches exactly, size=' SIZE(got)
        :(T2)
T1BAD   OUTPUT = 'T1 FAIL: roundtrip mismatch or FRETURN, got-size=' SIZE(got)
T2      IDENT(rwmap[0], 1)                                                :F(T2BAD)
        IDENT(rwmap[SIZE('first line') + 1], 2)                           :F(T2BAD)
        OUTPUT = 'T2 PASS: line-offset map matches for the long-line record'
        :(T3)
T2BAD   OUTPUT = 'T2 FAIL: line-offset map wrong'
T3      Read('/nonexistent/directory/nope.txt')                           :S(T3BAD)
        OUTPUT = 'T3 PASS: Read FRETURN on inaccessible path'
        :(T4)
T3BAD   OUTPUT = 'T3 FAIL: Read should have FRETURNed on inaccessible path'
T4      Write('/nonexistent/directory/nope.txt', 'x')                     :S(T4BAD)
        OUTPUT = 'T4 PASS: Write FRETURN on inaccessible path'
        :(DONE)
T4BAD   OUTPUT = 'T4 FAIL: Write should have FRETURNed on inaccessible path'
DONE
END
