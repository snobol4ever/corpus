*----------------------------------------------------- 1748 benchmark_pattern_bt
* pattern_bt -- matches an alternation that must backtrack before the winning arm commits.
* bottleneck: alternation backtracking; capture on the winning arm.
* Standalone:  scrip pattern_bt.sno   |   sbl -bf pattern_bt.sno   |   snobol4 pattern_bt.sno
        &TRIM = 1
        &ANCHOR = 0
        &STLIMIT = -1
        PAT = ('aaa' | 'bbb' | 'ccc' | 'ddd') SPAN('abcd') . W
        SUB = 'xxxxxxxxxxbbbccccddddaaaaxxxxxxxxxxbbbccccddddaaaa'
        DEFINE('PATTERN_BT(N)')                         :(PATTERN_BT_END)
PATTERN_BT  ZI = 1
ZBL     SUB ? PAT
        ZI = LT(ZI, N) ZI + 1                           :S(ZBL)
        PATTERN_BT = W                                  :(RETURN)
PATTERN_BT_END
*BENCH kernel=PATTERN_BT check=1000 bud=500 flr=20
        OUTPUT = 'subject = ' SUB
        OUTPUT = 'captured tail = ' PATTERN_BT(1000)
END
*--------------------------------------------- 1749 any_pos_len_replace_branch_1
*     cross.sno - Print visual intersections between two words.
*     Input: pairs of lines, H then V, one pair per two INPUT lines.
*     Tests: @N position capture, ANY(string), conditional replacement,
*            POS(N), LEN(1), DUPL(), nested loop via FAIL-like structure.

      &TRIM    =  1
AGAIN H        =  INPUT                            :F(END)
      V        =  INPUT                            :F(END)
      HC       =  H
NEXTH HC       ?  @NH ANY(V) . CROSS = '*'         :F(AGAIN)
      VC       =  V
NEXTV VC       ?  @NV CROSS = '#'                  :F(NEXTH)
      OUTPUT   =
      PRINTV   =  V
      PRINTV   ?  POS(NV) LEN(1) = '#'
PRINT PRINTV   ?  LEN(1) . C =                     :F(NEXTV)
      OUTPUT   =  DIFFER(C, '#') DUPL(' ', NH) C   :S(PRINT)
      OUTPUT   =  H                                :(PRINT)
END
*--------------------------------------------- 1750 any_pos_len_replace_branch_2
*     cross.sno - Print visual intersections between two words.
*     Input: pairs of lines, H then V, one pair per two input lines.
*     Tests: @N position capture, ANY(string), conditional replacement,
*            POS(N), LEN(1), DUPL(), nested loop via FAIL-like structure.

      &TRIM    =  1
AGAIN H        =  INPUT                            :F(END)
      V        =  INPUT                            :F(END)
      HC       =  H
NEXTH HC       ?  @NH ANY(V) . CROSS = '*'         :F(AGAIN)
      VC       =  V
NEXTV VC       ?  @NV CROSS = '#'                  :F(NEXTH)
      OUTPUT   =
      PRINTV   =  V
      PRINTV   ?  POS(NV) LEN(1) = '#'
PRINT PRINTV   ?  LEN(1) . C =                     :F(NEXTV)
      OUTPUT   =  DIFFER(C, '#') DUPL(' ', NH) C   :S(PRINT)
      OUTPUT   =  H                                :(PRINT)
END
*------------------------------------------------- 1751 benchmark_string_pattern
* string_pattern -- splits a comma-separated record into its leading three fields.
* bottleneck: BREAK scanning with conditional capture, field split.
* Standalone:  scrip string_pattern.sno   |   sbl -bf string_pattern.sno
        &TRIM = 1
        &ANCHOR = 0
        &STLIMIT = -1
        REC = 'alpha,beta,gamma,delta,epsilon'
        PAT = BREAK(',') . F1 ',' BREAK(',') . F2 ',' BREAK(',') . F3
        DEFINE('STRING_PATTERN(N)')                     :(STRING_PATTERN_END)
STRING_PATTERN  ZI = 1
ZBL     REC ? PAT
        ZI = LT(ZI, N) ZI + 1                           :S(ZBL)
        STRING_PATTERN = F3                             :(RETURN)
STRING_PATTERN_END
*BENCH kernel=STRING_PATTERN check=1000 bud=500 flr=20
        OUTPUT = 'record = ' REC
        OUTPUT = 'field 3 = ' STRING_PATTERN(1000)
        OUTPUT = 'field 1 = ' F1
        OUTPUT = 'field 2 = ' F2
END
