*---------------------------------------- 1429 indirect_keyword_replace_branch_5
*  driver.sno — test driver for counter.sno
*  Oracle: snobol4 -f -P256k -I$INC driver.sno
*  Run via: bash test/beauty/run_beauty_subsystem.sh counter
-INCLUDE 'global.inc'
-INCLUDE 'counter.inc'

        &STLIMIT = 1000000
        dummy = InitCounter()

*  1: push and increment 3 times, top = 3
        dummy = PushCounter()
        dummy = IncCounter()
        dummy = IncCounter()
        dummy = IncCounter()
        IDENT(TopCounter(), 3)                                 :S(P1)
        OUTPUT = 'FAIL: 1 push/inc/top'                       :(T1)
P1      OUTPUT = 'PASS: 1 push/inc/top = 3'
T1

*  2: nested push, inc once, top = 1
        dummy = PushCounter()
        dummy = IncCounter()
        IDENT(TopCounter(), 1)                                 :S(P2)
        OUTPUT = 'FAIL: 2 nested top'                         :(T2)
P2      OUTPUT = 'PASS: 2 nested top = 1'
T2

*  3: pop restores outer (top = 3)
        dummy = PopCounter()
        IDENT(TopCounter(), 3)                                 :S(P3)
        OUTPUT = 'FAIL: 3 pop restore'                        :(T3)
P3      OUTPUT = 'PASS: 3 pop restore = 3'
T3

*  4: pop outer, stack empty → PopCounter fails
        dummy = PopCounter()
        PopCounter()                                           :F(P4)
        OUTPUT = 'FAIL: 4 empty pop'                          :(T4)
P4      OUTPUT = 'PASS: 4 empty pop fails'
T4

*  5: TopCounter on empty stack fails
        TopCounter()                                           :F(P5)
        OUTPUT = 'FAIL: 5 empty top'                          :(T5)
P5      OUTPUT = 'PASS: 5 empty top fails'
T5

END
*-------------------------------------------- 1430 size_keyword_replace_branch_1
*  driver.sno — test driver for ReadWrite subsystem
*  Oracle: snobol4 -f -P256k -Idemo/inc driver.sno
*  Run via: INC=demo/inc bash test/beauty/run_beauty_subsystem.sh ReadWrite
*
*  Exercises: LineMap(str,mapName), Read()/Write() FRETURN on bad paths
*  Depends on: global.sno (nl)
*  Note: Read()/Write() use INPUT/OUTPUT unit-file association which requires
*        a writable filesystem. Tests 4-5 verify FRETURN on inaccessible paths.
*        Tests 1-3, 6-8 exercise LineMap entirely in memory.

-INCLUDE 'global.inc'
-INCLUDE 'ReadWrite.inc'

        &STLIMIT = 1000000

*  1: LineMap offset 0 = line 1
        LineMap('alpha' nl 'beta' nl 'gamma' nl, 'lm1')
        EQ(lm1[0], 1)                                  :S(P1)F(F1)
P1      OUTPUT = 'PASS: 1 LineMap[0]=1'                :(T1)
F1      OUTPUT = 'FAIL: 1 LineMap[0]=' lm1[0]
T1

*  2: LineMap offset SIZE('alpha')+1 = line 2
        off2 = SIZE('alpha') + 1
        EQ(lm1[off2], 2)                               :S(P2)F(F2)
P2      OUTPUT = 'PASS: 2 LineMap offset ' off2 ' = line 2' :(T2)
F2      OUTPUT = 'FAIL: 2 LineMap[' off2 ']=' lm1[off2]
T2

*  3: LineMap offset SIZE('alpha')+1+SIZE('beta')+1 = line 3
        off3 = SIZE('alpha') + 1 + SIZE('beta') + 1
        EQ(lm1[off3], 3)                               :S(P3)F(F3)
P3      OUTPUT = 'PASS: 3 LineMap offset ' off3 ' = line 3' :(T3)
F3      OUTPUT = 'FAIL: 3 LineMap[' off3 ']=' lm1[off3]
T3

*  4: Read FRETURN on inaccessible path
        Read('/nonexistent/path/file.txt')             :F(P4)
        OUTPUT = 'FAIL: 4 Read bad path should FRETURN' :(T4)
P4      OUTPUT = 'PASS: 4 Read FRETURN on bad path'
T4

*  5: Write FRETURN on inaccessible path
        Write('/nonexistent/path/file.txt', 'x' nl)    :F(P5)
        OUTPUT = 'FAIL: 5 Write bad path should FRETURN' :(T5)
P5      OUTPUT = 'PASS: 5 Write FRETURN on bad path'
T5

*  6: LineMap empty string — still creates table with lmMap[0]=1
        LineMap('', 'lm6')
        DIFFER(lm6)                                    :S(P6)F(F6)
P6      OUTPUT = 'PASS: 6 LineMap empty string creates table' :(T6)
F6      OUTPUT = 'FAIL: 6 LineMap empty string no table'
T6

*  7: LineMap single word no trailing nl
        LineMap('hello', 'lm7')
        EQ(lm7[0], 1)                                  :S(P7)F(F7)
P7      OUTPUT = 'PASS: 7 LineMap single word no-nl'   :(T7)
F7      OUTPUT = 'FAIL: 7 LineMap[0]=' lm7[0]
T7

*  8: LineMap does not require rdMapName — inline form
        LineMap('x' nl 'y' nl, 'lm8')
        EQ(lm8[SIZE('x') + 1], 2)                      :S(P8)F(F8)
P8      OUTPUT = 'PASS: 8 LineMap 2-line second offset' :(T8)
F8      OUTPUT = 'FAIL: 8 LineMap 2-line offset got ' lm8[SIZE('x') + 1]
T8

END
*---------------------------------- 1431 table_datatype_keyword_replace_branch_1
*  driver.sno — test driver for trace subsystem (B-277)
*  Oracle: snobol4 -f -P256k -Idemo/inc driver.sno
*  Run via: INC=demo/inc bash test/beauty/run_beauty_subsystem.sh trace

-INCLUDE 'global.inc'
-INCLUDE 'trace.inc'

        &STLIMIT = 1000000

        dummy     = ''
        strOfs    = 0
        t8Max     = 0
        t8MaxLine = 0
        t8MaxLast = 0
        doDebug   = 0

*  Portable DATATYPE tokens (dialect-independent)
        dSTRING   = DATATYPE('')
        dNAME     = DATATYPE(.dummy)

* -----------------------------------------------------------------------
*  1: T8Pos nil t8Map => LPAD(ofs,8)
* -----------------------------------------------------------------------
        r1 = T8Pos(5, '')
        IDENT(r1, '       5')                         :S(P1)F(F1)
P1      OUTPUT = 'PASS: 1 T8Pos nil map=LPAD'          :(T1)
F1      OUTPUT = 'FAIL: 1 got=[' r1 ']'
T1

* -----------------------------------------------------------------------
*  2: T8Pos with t8Map — ofs=7 in 2-line map (line1: 0-4, line2: 5+)
* -----------------------------------------------------------------------
        t8Map2    = TABLE()
        t8Map2[0] = 1
        t8Map2[5] = 2
        t8Max     = 0
        r2        = T8Pos(7, t8Map2)
        IDENT(r2, '(    2,   3,     2,   3)')         :S(P2)F(F2)
P2      OUTPUT = 'PASS: 2 T8Pos map line/col'          :(T2)
F2      OUTPUT = 'FAIL: 2 got=[' r2 ']'
T2

* -----------------------------------------------------------------------
*  3: T8Pos updates t8Max
* -----------------------------------------------------------------------
        t8Max2b   = TABLE()
        t8Max2b[0] = 1
        t8Max      = 0
        T8Pos(12, t8Max2b)
        EQ(t8Max, 12)                                  :S(P3)F(F3)
P3      OUTPUT = 'PASS: 3 T8Pos updates t8Max'         :(T3)
F3      OUTPUT = 'FAIL: 3 t8Max=' t8Max
T3

* -----------------------------------------------------------------------
*  4: T8Trace doDebug=0 => sets T8Trace=.dummy (STRING), NRETURNs
* -----------------------------------------------------------------------
        doDebug   = 0
        r4        = T8Trace(1, 'hello', 0)
        IDENT(DATATYPE(r4), dSTRING)                   :S(P4)F(F4)
P4      OUTPUT = 'PASS: 4 T8Trace doDebug=0 returns STRING' :(T4)
F4      OUTPUT = 'FAIL: 4 datatype=' DATATYPE(r4)
T4

* -----------------------------------------------------------------------
*  5: T8Trace doDebug=1, lvl=2 => LE(2,1) fails => NRETURN
* -----------------------------------------------------------------------
        doDebug   = 1
        t8Max     = 0 ; t8MaxLine = 0 ; strOfs = 0 ; t8Map = ''
