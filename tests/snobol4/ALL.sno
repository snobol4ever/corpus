*---------------------------------------- 1351 indirect_keyword_replace_branch_1
*  driver.sno — test driver for Gen subsystem
*  Oracle: snobol4 -f -P256k -I$INC driver.sno
*  Run via: bash test/beauty/run_beauty_subsystem.sh Gen
*
*  Exercises: Gen/GenTab/GenSetCont/IncLevel/DecLevel/SetLevel/GetLevel
*  Depends on: global.sno (nl)
*  Gimpel parallel: none direct; output buffering pattern used throughout beauty.sno

-INCLUDE 'global.inc'
-INCLUDE 'Gen.inc'

        &STLIMIT = 1000000
        xTrace = 0

*  Reset Gen globals before each test
*  $'#L'=0, $'$B'='', $'$X'='', $'$C'=''

*  1: GetLevel() returns 0 initially
        $'#L'  = 0
        $'$B'  =
        $'$X'  =
        $'$C'  =
        lv     = GetLevel()
        IDENT(lv, 0)                                    :S(P1)
        OUTPUT = 'FAIL: 1 GetLevel init got: ' lv       :(T1)
P1      OUTPUT = 'PASS: 1 GetLevel init'
T1

*  2: IncLevel increments by default 2
        $'#L'  = 0
        IncLevel()
        lv2    = GetLevel()
        IDENT(lv2, 2)                                   :S(P2)
        OUTPUT = 'FAIL: 2 IncLevel default got: ' lv2   :(T2)
P2      OUTPUT = 'PASS: 2 IncLevel default'
T2

*  3: DecLevel decrements by default 2
        DecLevel()
        lv3    = GetLevel()
        IDENT(lv3, 0)                                   :S(P3)
        OUTPUT = 'FAIL: 3 DecLevel default got: ' lv3   :(T3)
P3      OUTPUT = 'PASS: 3 DecLevel default'
T3

*  4: SetLevel sets explicitly
        SetLevel(4)
        lv4    = GetLevel()
        IDENT(lv4, 4)                                   :S(P4)
        OUTPUT = 'FAIL: 4 SetLevel got: ' lv4           :(T4)
P4      OUTPUT = 'PASS: 4 SetLevel'
T4

*  5: Gen with no newline — stays in buffer, no output yet
        $'#L'  = 0
        $'$B'  =
        $'$X'  =
        $'$C'  =
        Gen('hello')
        IDENT($'$B', 'hello')                           :S(P5)
        OUTPUT = 'FAIL: 5 Gen buffer got: [' $'$B' ']'  :(T5)
P5      OUTPUT = 'PASS: 5 Gen buffering'
T5

*  6: Gen with newline — flushes line to OUTPUT
        $'#L'  = 0
        $'$B'  =
        $'$X'  =
        $'$C'  =
        Gen('line1' nl)
        OUTPUT = 'PASS: 6 Gen flush'
T6

*  7: Gen two fragments then newline — concatenates then flushes
        $'#L'  = 0
        $'$B'  =
        $'$X'  =
        $'$C'  =
        Gen('foo')
        Gen('bar' nl)
        OUTPUT = 'PASS: 7 Gen concat+flush'
T7

END
*---------------------------------------- 1352 indirect_keyword_replace_branch_2
*  driver.sno — test driver for ShiftReduce subsystem
*  Oracle: snobol4 -f -P256k -I$INC driver.sno
*  Run via: bash test/beauty/run_beauty_subsystem.sh ShiftReduce
*
*  Exercises: Shift(t,v) / Reduce(t,n)
*  Depends on: stack.sno (Push/Pop/Top), tree.sno (tree DATA type)
*  Ref: snobol4corpus/programs/include/ShiftReduce.inc

-INCLUDE 'global.inc'
-INCLUDE 'stack.inc'
-INCLUDE 'tree_mini.inc'
-INCLUDE 'ShiftReduce.inc'

        &STLIMIT = 1000000
        xTrace = 0

*  1: InitStack then Shift a leaf — stack has one node
        InitStack()
        Shift('Id', 'foo')
        nd = Top()
        IDENT(t(nd), 'Id')                               :S(P1a)
        OUTPUT = 'FAIL: 1a Shift type'                  :(T1)
P1a     IDENT(v(nd), 'foo')                              :S(P1)
        OUTPUT = 'FAIL: 1b Shift value'                 :(T1)
P1      OUTPUT = 'PASS: 1 Shift leaf'
T1

*  2: Shift two leaves then Reduce(2) — produces internal node
        InitStack()
        Shift('Id', 'x')
        Shift('Int', '42')
        Reduce('BinOp', 2)
        nd = Top()
        IDENT(t(nd), 'BinOp')                            :S(P2a)
        OUTPUT = 'FAIL: 2a Reduce type'                 :(T2)
P2a     IDENT(n(nd), 2)                                  :S(P2b)
        OUTPUT = 'FAIL: 2b Reduce nchildren'            :(T2)
P2b     IDENT(t(c(nd)[1]), 'Id')                         :S(P2c)
        OUTPUT = 'FAIL: 2c Reduce child1 type'          :(T2)
P2c     IDENT(t(c(nd)[2]), 'Int')                        :S(P2)
        OUTPUT = 'FAIL: 2d Reduce child2 type'          :(T2)
P2      OUTPUT = 'PASS: 2 Reduce 2 children'
T2

*  3: Reduce(0) — zero children, empty array
        InitStack()
        Reduce('Epsilon', 0)
        nd = Top()
        IDENT(t(nd), 'Epsilon')                          :S(P3a)
        OUTPUT = 'FAIL: 3a Reduce0 type'                :(T3)
P3a     IDENT(n(nd), 0)                                  :S(P3)
        OUTPUT = 'FAIL: 3b Reduce0 nchildren'           :(T3)
P3      OUTPUT = 'PASS: 3 Reduce 0 children'
T3

*  4: Shift with empty value (v='') — v(s) should be '' not unset
        InitStack()
        Shift('Keyword', '')
        nd = Top()
        IDENT(t(nd), 'Keyword')                          :S(P4a)
        OUTPUT = 'FAIL: 4a Shift empty-v type'          :(T4)
P4a     IDENT(v(nd), '')                                 :S(P4)
        OUTPUT = 'FAIL: 4b Shift empty-v value'         :(T4)
P4      OUTPUT = 'PASS: 4 Shift empty value'
T4

*  5: Shift 3 leaves, Reduce('List',3) — children in correct order
        InitStack()
        Shift('A', 'a')
        Shift('B', 'b')
        Shift('C', 'c')
        Reduce('List', 3)
        nd = Top()
        IDENT(n(nd), 3)                                  :S(P5a)
