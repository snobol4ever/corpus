        DEFINE('nPush()')
        DEFINE('nPop2()')                               :(SEND)
SH        OUTPUT = 'SH(' t ',' v ')'
        SH = .dummy                                     :(NRETURN)
shift     shift = EVAL("p . thx . *SH('" t "', thx)")     :(RETURN)
