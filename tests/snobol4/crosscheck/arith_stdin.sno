*-------------------------------------------------------------------- 1 fileinfo
*     fileinfo.sno - Count characters and lines read from stdin.
*     Tests: SIZE(), integer accumulation, unanchored loop, END branch on EOF.

         &TRIM    =  1
NEXTL    CHARS    =  CHARS + SIZE(INPUT)                    :F(DONE)
         LINES    =  LINES + 1                              :(NEXTL)
DONE     OUTPUT   =  CHARS ' characters, ' LINES ' lines read'
END
*--------------------------------------------------------------------- 2 triplet
*     triplet.sno - Center INPUT lines and add blank line every third.
*     Tests: DUPL(), REMDR(), integer arithmetic, SIZE(), &TRIM.

         &TRIM    =  1
         N        =  0
LOOP     S        =  INPUT                                  :F(END)
         OUTPUT   =  DUPL(' ', (80 - SIZE(S)) / 2) S
         N        =  REMDR(N + 1, 3)
         OUTPUT   =  EQ(N, 0)                               :(LOOP)
END
