*----------------------------------------------------------------------- 1 cross
*     cross.sno - Print visual intersections between two words.
*     Input: pairs of lines, H then V, one pair per two INPUT lines.
*     Tests: @N position capture, ANY(string), conditional replacement,
*            POS(N), LEN(1), DUPL(), nested loop via FAIL-like structure.

      &TRIM    =  1
AGAIN H        =  INPUT                            :F(END)
      V        =  INPUT                            :F(END)
      HC       =  H
NEXTH HC       ?  @NH ANY(V) . CROSS = '*'         :F(AGAIN)
      VC       =  V
NEXTV VC       ?  @NV CROSS = '#'                  :F(NEXTH)
      OUTPUT   =
      PRINTV   =  V
      PRINTV   ?  POS(NV) LEN(1) = '#'
PRINT PRINTV   ?  LEN(1) . C =                     :F(NEXTV)
      OUTPUT   =  DIFFER(C, '#') DUPL(' ', NH) C   :S(PRINT)
      OUTPUT   =  H                                :(PRINT)
END
*----------------------------------------------------------------------- 2 word1
*     word1.sno - Extract noun phrases matching "the X of Y" or "the X a Y".
*     Tests: ARB as output-capturing side effect in pattern, unanchored scan,
*            alternation (|), looping match on single line.

      PAT      =  " the " ARB . OUTPUT (" of " | " a ")
LOOP  LINE     =  INPUT                            :F(END)
      LINE     ?  PAT                              :(LOOP)
END
*----------------------------------------------------------------------- 3 word2
*     word2.sno - Fixed-column record parsing using TAB().
*     Tests: POS(0), LEN(N), TAB(N), ARB, REM, capture to named variables.
*     Input format: YYYY  Name              : Invention
*                   0123  6                22  24
*     Note: TAB(24) requires " :" to end before column 24.
*     Name field retains padding spaces (compare word3/word4).

      PAT      =  POS(0) LEN(4) . WHEN
+                 TAB(6) ARB . WHO " :"
+                 TAB(24) REM . WHAT
LOOP  LINE     =  INPUT                            :F(END)
      LINE     ?  PAT                              :F(LOOP)
      OUTPUT   =  WHO " invented the " WHAT " in " WHEN  :(LOOP)
END
*----------------------------------------------------------------------- 4 word3
*     word3.sno - Record parsing using BREAK/SPAN/ARB.
*     Tests: BREAK(x), SPAN(x), ARB backtracking, multiple captures.
*     Input format: YYYY  Name  : Invention  (spaces flexible, no TAB requirement)
*     Uses ARB (greedy) for name -- matches longest name before last " :".
*     Name field is trimmed of padding (compare word2, word4).

      PAT      =  POS(0) BREAK(' ') . WHEN (' ' SPAN(' '))
+                 ARB . WHO (' ' SPAN(' :'))
+                 REM . WHAT
LOOP  LINE     =  INPUT                            :F(END)
      LINE     ?  PAT                              :F(LOOP)
      OUTPUT   =  WHO " invented the " WHAT " in " WHEN  :(LOOP)
END
*----------------------------------------------------------------------- 5 word4
*     word4.sno - Record parsing using BREAKX instead of ARB.
*     Tests: BREAKX(x) vs ARB -- BREAKX fails if no non-space chars present,
*            while ARB succeeds with null. BREAKX is more precise for names.
*     Input format: YYYY  Name  : Invention  (same as word3)
*     For well-formed data, output matches word3.

      PAT      =  POS(0) BREAK(' ') . WHEN (' ' SPAN(' '))
+                 BREAKX(' ') . WHO (' ' SPAN(' :'))
+                 REM . WHAT
LOOP  LINE     =  INPUT                            :F(END)
      LINE     ?  PAT                              :F(LOOP)
      OUTPUT   =  WHO " invented the " WHAT " in " WHEN  :(LOOP)
END
*------------------------------------------------------------------- 6 wordcount
*     wordcount.sno - Count words in INPUT.
*     Tests: BREAK/SPAN word boundary detection, hyphenated and
*            apostrophe-joined words (it's, well-known count as one word each).

      &TRIM    =  1
      NUMERALS =  '0123456789'
      WORD     =  "'-" NUMERALS &UCASE &LCASE
      WPAT     =  BREAK(WORD) SPAN(WORD)
NEXTL LINE     =  INPUT                            :F(DONE)
NEXTW LINE     ?  WPAT =                           :F(NEXTL)
      N        =  N + 1                            :(NEXTW)
DONE  OUTPUT   =  +N ' words'
END
