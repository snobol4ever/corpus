*---------------------------------------------------------- 1 W01_pat_lit_anchor
        subject = 'hello world'
        subject 'world'                    :f(e001)
        OUTPUT = 'PASS W01/003: unanchored substring match'  :(END)
e001    OUTPUT = 'FAIL W01/003: unanchored substring match should succeed'
END
 subject = 'hello world'; subject 'world' :f(e001); OUTPUT = 'PASS W01/001: literal match succeeded' :(END);e001 OUTPUT = 'FAIL W01/001: literal match should succeed';END;* W01_pat_lit_basic
