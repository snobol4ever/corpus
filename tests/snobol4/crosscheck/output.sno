 OUTPUT = 'hello world';END;* 001_output_string_literal
 OUTPUT = 42;END;* 002_output_integer_literal
 OUTPUT = 3.14;END;* 003_output_real_literal
 OUTPUT = '';END;* 004_output_empty_string
 OUTPUT = 'line one'; OUTPUT = 'line two'; OUTPUT = 'line three';END;* 005_output_multiline
