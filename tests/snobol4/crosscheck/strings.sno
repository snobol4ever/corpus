 OUTPUT = SIZE('hello');END;* 065_builtin_size
 OUTPUT = SUBSTR('hello world', 7, 5);END;* 066_builtin_substr
 OUTPUT = REPLACE('hello', 'aeiou', 'AEIOU');END;* 067_builtin_replace
 OUTPUT = SIZE(TRIM('hello '));END;* 068_builtin_trim
 OUTPUT = DUPL('ab', 3);END;* 069_builtin_dupl
 OUTPUT = REVERSE('hello');END;* 070_builtin_reverse
 OUTPUT = &UCASE;END;* 071_builtin_ucase
 OUTPUT = &LCASE;END;* 072_builtin_lcase
 OUTPUT = LPAD('hi', 6);END;* 073_builtin_lpad
 OUTPUT = SIZE(RPAD('hi', 6));END;* 074_builtin_rpad
*--------------------------------------------------- 11 075_builtin_integer_test
        INTEGER('42')                                               :S(YES)F(NO)
YES     OUTPUT = 'numeric' :(NEXT)
NO      OUTPUT = 'not numeric'
NEXT    INTEGER('abc')                                              :S(YES2)F(NO2)
YES2    OUTPUT = 'numeric' :(END)
NO2     OUTPUT = 'not numeric'
END
