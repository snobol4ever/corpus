*---------------------------------------------------- 13 tbl_counted_string_keys
        z = CHAR(0)
        tab = TABLE()
        tab['a' z 'b'] = 'FIRST'
        tab['a' z 'c'] = 'SECOND'
        tab['a'] = 'PLAIN'
        OUTPUT = 'ab=' tab['a' z 'b'] ' ac=' tab['a' z 'c'] ' a=' tab['a']
        tab[z] = 'JUSTNUL'
        tab[''] = 'EMPTY'
        OUTPUT = 'nul=' tab[z] ' empty=' tab['']
        OUTPUT = 'sizes=' SIZE('a' z 'b') ',' SIZE(z) ',' SIZE('')
        tab['pre' z] = 'WITHNUL'
        tab['pre'] = 'NONUL'
        OUTPUT = 'pre_nul=' tab['pre' z] ' pre=' tab['pre']
END
