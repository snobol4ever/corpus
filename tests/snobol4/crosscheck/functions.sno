*------------------------------------------------------- 1 060_pred_operand_edge
        X = 'q'
        X = '2'
        OUTPUT = GT(X, 1) 'a'
        OUTPUT = GT(2.5, 2) 'b'
        OUTPUT = LT('2.5', X) 'c'
        OUTPUT = EQ('2.0', 2) 'd'
        OUTPUT = GE(, 0) 'e'
        OUTPUT = LGT('b', 'a') 'f'
        OUTPUT = LGT(10, 9) 'g'
        OUTPUT = NE(3, X) 'h'
        OUTPUT = LE(X, 2) 'i'
        OUTPUT = LNE(X, 'q') 'j'
        OUTPUT = LLT('a', X) 'k'
        OUTPUT = LEQ(X, '2') 'l'
END
 DEFINE('double(s)') :(double_end);double double = 2 * s :(RETURN);double_end; OUTPUT = double(5); OUTPUT = double(21);END;* 083_define_simple_return
 DEFINE('bump(v)') :(bumpend);bump bump = v + 1 :(RETURN);bumpend; S = ''; J = 0;LOOP S = S bump(2 * J); J = J + 1; LT(J, 5) :S(LOOP); OUTPUT = S;END;* 084_define_loop_call
 DEFINE('add(a,b)') :(add_end);add add = a + b :(RETURN);add_end; OUTPUT = add(3, 4); OUTPUT = add(10, 32);END;* 085_define_two_args
 DEFINE('swap(a,b)tmp') :(swap_end);swap tmp = a; a = b; b = tmp; OUTPUT = a ' ' b :(RETURN);swap_end; swap('hello', 'world');END;* 086_define_locals
*---------------------------------------------------------- 6 087_define_freturn
        DEFINE('ispos(x)')                                          :(ispos_end)
ispos   GT(x, 0)                                                   :S(RETURN)F(FRETURN)
ispos_end
        ispos(5)                                                    :S(A)F(B)
A       OUTPUT = 'positive' :(NEXT)
B       OUTPUT = 'wrong'
NEXT    ispos(-3)                                                   :S(C)F(D)
C       OUTPUT = 'wrong' :(END)
D       OUTPUT = 'not positive'
END
*---------------------------------------------------- 7 088_define_recursive_fib
        DEFINE('fib(n)')                                            :(fib_end)
fib     LE(n, 1)                                                   :S(base)
        fib = fib(n - 1) + fib(n - 2)                             :(RETURN)
base    fib = n                                                    :(RETURN)
fib_end
        OUTPUT = fib(0)
        OUTPUT = fib(1)
        OUTPUT = fib(6)
        OUTPUT = fib(10)
END
 DEFINE('upcase(s)') :(upcase_end);upcase upcase = REPLACE(s, &LCASE, &UCASE) :(RETURN);upcase_end; OUTPUT = upcase('hello'); OUTPUT = upcase('world');END;* 089_define_in_pattern
 DEFINE('bumpit(v)', .bumpit) :(bumpend);bumpit bumpit = v + 1 :(RETURN);bumpend; OUTPUT = bumpit(41);END;* 090_define_entry_label
 DEFINE('F(N)T') :(F_END);F N ? LEN(1) . T :F(FRETURN); F = T :(RETURN);F_END; OUTPUT = F('AB');END;* 097_define_capture_return_d2probe
