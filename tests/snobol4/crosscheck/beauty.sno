*-------------------------------------------------------------- 1 gen_cont_split
-INCLUDE 'Gen.inc'
        nl             =  CHAR(10)
        GenSetCont('+')
        SetLevel(4)
        Gen('AAA' nl 'BBB')
        Gen('CCC' nl)
        GenSetCont('+')
        SetLevel(4)
        Gen('DDD' nl 'EEE' nl 'FFF' nl)
END
*-------------------------------------------------------------- 2 gen_tab_marker
-INCLUDE 'Gen.inc'
        nl             =  CHAR(10)
        GenSetCont('+')
        SetLevel(4)
        Gen('AAA' nl)
        GenTab()
        Gen('BBB' nl)
END
