*----------------------------------------------------------- 1 076_builtin_ident
        IDENT('abc', 'abc')                                         :S(YES)F(NO)
YES     OUTPUT = 'equal' :(NEXT)
NO      OUTPUT = 'not equal'
NEXT    IDENT('abc', 'xyz')                                         :S(YES2)F(NO2)
YES2    OUTPUT = 'equal' :(END)
NO2     OUTPUT = 'not equal'
END
 DIFFER('abc', 'xyz') :S(YES)F(NO);YES OUTPUT = 'different' :(END);NO OUTPUT = 'same';END;* 077_builtin_differ
 GT(5, 3) :S(YES)F(NO);YES OUTPUT = '5 > 3' :(NEXT);NO OUTPUT = 'wrong';NEXT GT(3, 5) :S(YES2)F(NO2);YES2 OUTPUT = 'wrong' :(END);NO2 OUTPUT = '3 not > 5';END;* 078_builtin_gt
 LT(3, 5) :S(A)F(END);A OUTPUT = '3 < 5'; LE(5, 5) :S(B)F(END);B OUTPUT = '5 <= 5'; GE(7, 5) :S(C)F(END);C OUTPUT = '7 >= 5';END;* 079_builtin_lt_le_ge
 EQ(42, 42) :S(YES)F(NO);YES OUTPUT = '42 = 42' :(NEXT);NO OUTPUT = 'wrong';NEXT NE(42, 99) :S(YES2)F(NO2);YES2 OUTPUT = '42 != 99' :(END);NO2 OUTPUT = 'wrong';END;* 080_builtin_eq_ne
 OUTPUT = REPLACE(DATATYPE('hello'), &LCASE, &UCASE); OUTPUT = REPLACE(DATATYPE(42), &LCASE, &UCASE); OUTPUT = REPLACE(DATATYPE(3.14), &LCASE, &UCASE);END;* 081_builtin_datatype
 X = 1; X = 2; GT(&STNO, 1) :S(YES)F(NO);YES OUTPUT = 'stno ok' :(END);NO OUTPUT = 'wrong';END;* 082_keyword_stcount
 OUTPUT = SIZE(&ALPHABET); OUTPUT = SIZE(&UCASE); OUTPUT = SIZE(&LCASE);END;* 097_keyword_alphabet
*---------------------------------------------------------- 9 098_keyword_anchor
        &ANCHOR = 1
        X = 'hello world'
        X 'hello'                                                   :S(YES)F(NO)
YES     OUTPUT = 'anchored match ok'
        X 'world'                                                   :S(YES2)F(NO2)
YES2    OUTPUT = 'should not reach' :(END)
NO      OUTPUT = 'wrong' :(END)
NO2     OUTPUT = 'anchor prevented mid-string match'
END
*------------------------------------------------------------- 10 099_keyword_rw
        DIFFER(&ANCHOR, 0)                         :F(e001)
        OUTPUT = 'FAIL 099/001: &ANCHOR default'   :(END)
e001
        &ANCHOR = 1
        X = 'hello world'
        X 'hello'                                  :S(e002ok)F(e002)
e002    OUTPUT = 'FAIL 099/002: anchor=1 int'      :(END)
e002ok  X 'world'                                  :S(e002b)F(e002bok)
e002b   OUTPUT = 'FAIL 099/002b: anchor blocked mid' :(END)
e002bok
        &ANCHOR = '0'
        X = 'hello world'
        X 'world'                                  :S(e003ok)F(e003)
e003    OUTPUT = 'FAIL 099/003: anchor=0 str coerce' :(END)
e003ok
        DIFFER(DATATYPE(&STLIMIT), 'INTEGER')      :F(e004)
        OUTPUT = 'FAIL 099/004: STLIMIT datatype'  :(END)
e004
        &ANCHOR = 1
        DIFFER(&ANCHOR, 1)                         :F(e005)
        OUTPUT = 'FAIL 099/005: ANCHOR round-trip' :(END)
e005
        &ANCHOR = 0
        OUTPUT = 'PASS 099_keyword_rw (5/5)'
END
*-------------------------------------------------------- 11 099_lexical_compare
        LGT('b', 'a')                                               :S(A)F(END)
A       OUTPUT = 'b > a'
        LLT('a', 'b')                                               :S(B)F(END)
B       OUTPUT = 'a < b'
        LEQ('cat', 'cat')                                           :S(C)F(END)
C       OUTPUT = 'cat = cat'
        LNE('cat', 'dog')                                           :S(D)F(END)
D       OUTPUT = 'cat != dog'
END
*---------------------------------------------------------- 12 100_roman_numeral
        DEFINE('roman(n)s,v,r,i')                                     :(roman_end)
roman   s = ''
        v = ARRAY(13)
        v<1> = 1000
        v<2> = 900
        v<3> = 500
        v<4> = 400
        v<5> = 100
        v<6> = 90
        v<7> = 50
        v<8> = 40
        v<9> = 10
        v<10> = 9
        v<11> = 5
        v<12> = 4
        v<13> = 1
        r = ARRAY(13)
        r<1> = 'M'
        r<2> = 'CM'
        r<3> = 'D'
        r<4> = 'CD'
        r<5> = 'C'
        r<6> = 'XC'
        r<7> = 'L'
        r<8> = 'XL'
        r<9> = 'X'
        r<10> = 'IX'
        r<11> = 'V'
        r<12> = 'IV'
        r<13> = 'I'
        i = 1
RLOOP   GT(n, 0)                                                       :F(RDONE)
        GE(n, v<i>)                                                    :F(RNEXT)
        s = s r<i>
        n = n - v<i>                                                   :(RLOOP)
RNEXT   i = i + 1                                                      :(RLOOP)
RDONE   roman = s                                                      :(RETURN)
roman_end
        OUTPUT = roman(1)
        OUTPUT = roman(4)
        OUTPUT = roman(9)
        OUTPUT = roman(42)
        OUTPUT = roman(1999)
        OUTPUT = roman(2024)
END
