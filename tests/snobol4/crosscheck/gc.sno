*---------------------------------------------------- 1 200_gc_churn_live_anchor
        KEEP = 'anchor-' DUPL('K', 15)
        I = 0
loop    I = LT(I, 400) I + 1                                        :F(done)
        G = 'garbage-' I '-' DUPL('x', 20)
        G = G '-more-' I :(loop)
done    OUTPUT = KEEP
        OUTPUT = 'iterations=' I
END
*--------------------------------------------------------- 2 201_gc_live_globals
        V1 = 'alpha-' DUPL('a', 8)
        V2 = 'beta-' DUPL('b', 8)
        V3 = 'gamma-' DUPL('c', 8)
        V4 = 'delta-' DUPL('d', 8)
        V5 = 'epsilon-' DUPL('e', 8)
        V6 = 'zeta-' DUPL('f', 8)
        I = 0
loop    I = LT(I, 300) I + 1                                        :F(done)
        G = 'junk' I DUPL('y', 25) :(loop)
done    OUTPUT = V1
        OUTPUT = V2
        OUTPUT = V3
        OUTPUT = V4
        OUTPUT = V5
        OUTPUT = V6
END
*-------------------------------------------------------- 3 202_gc_array_strings
        A = ARRAY(20)
        I = 0
fill    I = LT(I, 20) I + 1                                         :F(churn)
        A<I> = 'elem-' I '-' DUPL('e', 10) :(fill)
churn   J = 0
cl      J = LT(J, 300) J + 1                                        :F(chk)
        G = 'junk' J DUPL('z', 30) :(cl)
chk     OUTPUT = A<1>
        OUTPUT = A<10>
        OUTPUT = A<20>
END
*---------------------------------------------------- 4 203_gc_table_string_keys
        T = TABLE()
        I = 0
mk      I = LT(I, 15) I + 1                                         :F(churn)
        T<'key-' I> = 'val-' I '-' DUPL('v', 6) :(mk)
churn   J = 0
cl      J = LT(J, 300) J + 1                                        :F(rd)
        G = DUPL('w', 25) J :(cl)
rd      K = 2 + 1
        OUTPUT = T<'key-' K>
        OUTPUT = T<'key-' 15>
        OUTPUT = T<'key-' 7>
END
*----------------------------------------------------- 5 204_gc_recursive_frames
        DEFINE('build(n)s,t')                                       :(b_end)
build   s = 'L' n
        t = DUPL('q', 12) '-' n
        build = EQ(n, 0) 'base'                                     :S(RETURN)
        build = s '/' build(n - 1)                                  :(RETURN)
b_end
        OUTPUT = build(6)
        OUTPUT = build(3)
END
*--------------------------------------------------------- 6 205_gc_data_records
        DATA('node(val,nxt)')
        HEAD = node('n-0-' DUPL('p', 5), )
        I = 0
mk      I = LT(I, 30) I + 1                                         :F(churn)
        HEAD = node('n-' I '-' DUPL('p', 5), HEAD) :(mk)
churn   J = 0
cl      J = LT(J, 250) J + 1                                        :F(walk)
        G = 'trash' J DUPL('t', 20) :(cl)
walk    C = 0
        P = HEAD
wl      P = DIFFER(P) nxt(P)                                        :F(done)
        C = C + 1 :(wl)
done    OUTPUT = 'links=' C
        OUTPUT = val(HEAD)
        OUTPUT = val(nxt(nxt(HEAD)))
END
*------------------------------------------------------ 7 206_gc_pattern_capture
        R =
        I = 0
lp      I = LT(I, 60) I + 1                                         :F(done)
        S = 'ab' I 'cd' DUPL('m', 5)
        S 'ab' BREAK('c') . V1 'cd'                                 :F(bad)
        G = 'junk' DUPL('w', 40) I
        R = R ',' V1 :(lp)
bad     OUTPUT = 'MATCH FAILED'                                     :(END)
done    OUTPUT = V1
        OUTPUT = SIZE(R)
END
*------------------------------------------------------- 8 207_gc_indirect_names
        I = 0
st      I = LT(I, 12) I + 1                                         :F(churn)
        $('VAR' I) = 'stored-' I '-' DUPL('s', 6) :(st)
churn   J = 0
cl      J = LT(J, 200) J + 1                                        :F(rd)
        G = 'x' J DUPL('k', 15) :(cl)
rd      OUTPUT = $('VAR' 3)
        OUTPUT = $('VAR' 12)
END
*--------------------------------------------------------- 9 208_gc_shared_alias
        S = 'shared-payload-' DUPL('s', 12)
        A = ARRAY(3)
        A<1> = S
        T = TABLE()
        T<'k'> = S
        J = 0
cl      J = LT(J, 250) J + 1                                        :F(rd)
        G = 'alias-junk' J DUPL('j', 18) :(cl)
rd      OUTPUT = S
        OUTPUT = A<1>
        OUTPUT = T<'k'>
END
*--------------------------------------------------------- 10 209_gc_big_strings
        BIG = DUPL('abcdefghij', 500)
        J = 0
cl      J = LT(J, 250) J + 1                                        :F(rd)
        G = 'medium-' J '-' DUPL('g', 35) :(cl)
rd      OUTPUT = SIZE(BIG)
        BIG POS(0) LEN(10) . HEAD10
        OUTPUT = HEAD10
        BIG RTAB(10) REM . TAIL10
        OUTPUT = TAIL10
END
*-------------------------------------------------------- 11 210_gc_deep_nesting
        DATA('box(payload)')
        A = ARRAY(5)
        A<3> = box('deep-' DUPL('d', 8))
        T = TABLE()
        T<'slot'> = A
        J = 0
cl      J = LT(J, 250) J + 1                                        :F(rd)
        G = 'nest-junk' J DUPL('n', 22) :(cl)
rd      TMP = T<'slot'>
        OUTPUT = payload(TMP<3>)
END
 X = 'before'; N = .X; J = 0;cl J = LT(J, 200) J + 1 :F(wr); G = 'name-junk' J DUPL('m', 20) :(wr);wr $N = 'after-' DUPL('n', 6); OUTPUT = X; OUTPUT = $N;END;* 211_gc_name_ref
 DEFINE('j3(a,b,c)') :(j_end);j3 j3 = a '|' b '|' c :(RETURN);j_end; I = 0;lp I = LT(I, 80) I + 1 :F(done); R = j3('A' I, DUPL('b', 10) I, 'C' I) :(lp);done OUTPUT = R;END;* 212_gc_args_in_flight
 KEEP = 'survivor-' DUPL('S', 10); I = 0;loop I = LT(I, 30000) I + 1 :F(done); G = 'blk-' I '-' DUPL('x', 2000) :(loop);done OUTPUT = KEEP; OUTPUT = 'iters=' I;END;* 213_gc_exhaustion_churn
*------------------------------------------------- 15 214_gc_exhaustion_live_set
        A = ARRAY(100)
        I = 0
fill    I = LT(I, 100) I + 1                                        :F(churn)
        A<I> = 'live-' I '-' DUPL('L', 50) :(fill)
churn   J = 0
cl      J = LT(J, 20000) J + 1                                      :F(chk)
        G = 'waste-' J '-' DUPL('w', 2000) :(cl)
chk     OUTPUT = A<1>
        OUTPUT = A<50>
        OUTPUT = A<100>
        OUTPUT = SIZE(A<77>)
END
