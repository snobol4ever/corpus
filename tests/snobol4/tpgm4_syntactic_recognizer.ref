     ./*
     -TITLE SPITBOL TEST PROGRAM #6 -- TOPOLOGICAL SORT
     *
     *        TOPOLOGICAL SORT
     *
     *   MAPS A PARTIAL ORDERING OF OBJECTS INTO A LINEAR ORDERING
     *
     *        A(1), A(2), ..., A(N)
     *
     *   SUCH THAT IF   A(S) < A(T) IN THE PARTIAL ORDERING,THEN S < T.
     *   (CF. D.E.KNUTH, THE ART OF COMPUTER PROGRAMMING,VOLUME 1,
     *   ADDISON-WESLEY,MASS.,1968, P.262)
     *
<<< NO SYNTACTIC ERROR >>>

              &DUMP = 2
<<< NO SYNTACTIC ERROR >>>

              OUTPUT('OUT',6,'(121A1)')
<<< NO SYNTACTIC ERROR >>>

              PAIR      = BREAK('<') . MU LEN(1) BREAK(',') . NU LEN(1)
<<< NO SYNTACTIC ERROR >>>

              DATA('ITEM(COUNT,TOP)')
<<< NO SYNTACTIC ERROR >>>

              DATA('NODE(SUC,NEXT)')
<<< NO SYNTACTIC ERROR >>>

              DEFINE('DECR(X)')
<<< NO SYNTACTIC ERROR >>>

              DEFINE('INDEX(TAU)')
<<< NO SYNTACTIC ERROR >>>

              INPUT(.INPUT,,72)
     *
     *     READ IN THE NUMBER OF ITEMS, N, AND GENERATE AN ARRAY OF ITEMS.
     *
     *   EACH ITEM HAS TWO FIELDS, (COUNT,TOP), WHERE
     *        COUNT = NO. OF ELEMENTS PRECEEDING IT.
<<< NO SYNTACTIC ERROR >>>

              TOP = TOP OF LIST OF ITEMS SUCCEEDING IT.
     *
<<< NO SYNTACTIC ERROR >>>

              N         = TRIM(INPUT)
<<< NO SYNTACTIC ERROR >>>

              X         = ARRAY('0:' N)
     *   INITIALIZE THE ITEMS TO (0,NULL).
     *
<<< NO SYNTACTIC ERROR >>>

     T1       X<I>      =  ITEM(0,)              :F(T1A)
<<< NO SYNTACTIC ERROR >>>

              I         =  I + 1                 :(T1)
     *
     *   READ IN RELATIONS.
     *
<<< NO SYNTACTIC ERROR >>>

     T1A      OUT       = '1 THE RELATIONS ARE:'
<<< NO SYNTACTIC ERROR >>>

     T2A      REL       = TRIM(INPUT) ','        :F(T3A)
<<< NO SYNTACTIC ERROR >>>

              OUTPUT    = REL
<<< NO SYNTACTIC ERROR >>>

     T2       REL       PAIR  =                  :F(T2A)
<<< NO SYNTACTIC ERROR >>>

              J         = INDEX(MU)
<<< NO SYNTACTIC ERROR >>>

              K         = INDEX(NU)
     *
     *   SINCE MU < NU, INCREASE THE COUNT OF THE KTH ITEM AND ADD A
     *   NODE TO THE LIST OF SUCCESSORS OF THE JTH ITEM.
     *
<<< NO SYNTACTIC ERROR >>>

     T3       COUNT(X<K>) = COUNT(X<K>) + 1
<<< NO SYNTACTIC ERROR >>>

              TOP(X<J>) = NODE(K,TOP(X<J>))      :(T2)
     -EJECT
     *
     *    A QUEUE IS MAINTAINED OF THOSE ITEMS WITH ZERO COUNT FIELD.
     *    THE LINKS FOR THE QUEUE, QLINK, ARE KEPT IN THE COUNT FIELD.
     *    THE VARIABLES F,R POINT TO THE FRONT AND REAR OF THE QUEUE.
     *
<<< NO SYNTACTIC ERROR >>>

     T3A      OPSYN('QLINK','COUNT')
     *
     *    INITIALIZE THE QUEUE FOR OUTPUT.
     *
<<< NO SYNTACTIC ERROR >>>

              R         = 0
<<< NO SYNTACTIC ERROR >>>

              QLINK(X<0>) = 0
<<< NO SYNTACTIC ERROR >>>

              K         = 0
<<< NO SYNTACTIC ERROR >>>

     T4       K         = ?X<K + 1>  K + 1       :F(T4A)
<<< NO SYNTACTIC ERROR >>>

              QLINK(X<R>) = EQ(COUNT(X<K>),0)  K :F(T4)
<<< NO SYNTACTIC ERROR >>>

              R         = K                      :(T4)
<<< NO SYNTACTIC ERROR >>>

     T4A      F         = QLINK(X<0>)
     *
     *    OUTPUT THE FRONT OF THE QUEUE.
     *
<<< NO SYNTACTIC ERROR >>>

              OUT       = '0 THE LINEAR ORDERING IS:'
<<< NO SYNTACTIC ERROR >>>

     T5       OUTPUT    = NE(F,0)  $(F ':')      :F(T8)
<<< NO SYNTACTIC ERROR >>>

              N         = N - 1
<<< NO SYNTACTIC ERROR >>>

              P         = TOP(X<F>)
     *    ERASE RELATIONS.
<<< NO SYNTACTIC ERROR >>>

     T6       IDENT(P)                           :S(T7)
<<< NO SYNTACTIC ERROR >>>

              DECR(.COUNT(X<SUC(P)>))            :S(T6A)
     *
     *    IF COUNT IS ZERO ADD  ITEM TO QUEUE.
     *
<<< NO SYNTACTIC ERROR >>>

              QLINK(X<R>) = SUC(P)
<<< NO SYNTACTIC ERROR >>>

              R         = SUC(P)
<<< NO SYNTACTIC ERROR >>>

     T6A      P         = NEXT(P)                :(T6)
     *
     *    REMOVE FROM QUEUE.
     *
<<< NO SYNTACTIC ERROR >>>

     T7       F         = QLINK(X<F>)            :(T5)
     *
     *    FUNCTION DEFINITIONS.
     *
<<< NO SYNTACTIC ERROR >>>

     DECR     $X        = GT($X,1)  $X - 1       :S(RETURN)
<<< NO SYNTACTIC ERROR >>>

              $X        = 0                      :(FRETURN)
     *
<<< NO SYNTACTIC ERROR >>>

     INDEX    INDEX     = DIFFER($(TAU ':'))  $(TAU ':')  :S(RETURN)
<<< NO SYNTACTIC ERROR >>>

              TERMCT    = LT(TERMCT,N)  TERMCT + 1    :F(FRETURN)
<<< NO SYNTACTIC ERROR >>>

              INDEX     = TERMCT
<<< NO SYNTACTIC ERROR >>>

              $(TERMCT ':')   =  TAU
<<< SYNTACTIC ERROR >>>

              $(TAU ':')   =  TERMCT             :(RETURN)
     *
<<< SYNTACTIC ERROR >>>

     T8       OUTPUT    = NE(N,0) 'THE ORDERING CONTAINS A LOOP.'
<<< NO SYNTACTIC ERROR >>>

     END
<<< NO SYNTACTIC ERROR >>>

     14
<<< NO SYNTACTIC ERROR >>>

     LETTERS<ALPHANUM,NUMBERS<ALPHANUM
<<< NO SYNTACTIC ERROR >>>

     BLANKS<OPTBLANKS
<<< NO SYNTACTIC ERROR >>>

     NUMBERS<REAL
<<< NO SYNTACTIC ERROR >>>

     NUMBERS<INTEGER
<<< NO SYNTACTIC ERROR >>>

     LETTERS<VARIABLE,ALPHANUM<VARIABLE
<<< NO SYNTACTIC ERROR >>>

     BINARY<BINARYOP,BLANKS<BINARYOP
<<< NO SYNTACTIC ERROR >>>

     UNQALPHABET<DLITERAL
<<< NO SYNTACTIC ERROR >>>

     UNQALPHABET<SLITERAL
<<< NO SYNTACTIC ERROR >>>

     SLITERAL<LITERAL,DLITERAL<LITERAL,INTEGER<LITERAL,REAL<LITERAL
     ./*
     -TITLE SPITBOL TEST PROGRAM #7 -- SYMBOL TABLE GENERATOR
     *
     *        THIS PROGRAM DEMONSTRATES THE STORAGE OF SYMBOL TABLES
     *        USING A TECHIQUE IN WHICH NAMES ARE STORED AS LINKED LISTS
     *        OF CHARACTERS. THE DATA FUNCTION IS USED TO FORM THE
     *        REQUIRED NODES WHICH CONTAIN APPROPRIATE POINTERS TO BE
     *        USED ON FAILURE OR SUCCESS OF THE CHARACTER BY CHARACTER MATCH
     *
     -CODE
<<< NO SYNTACTIC ERROR >>>

              DATA('SYMB(CHAR,LINK,ALT,ASSOC,SUCC)')
<<< NO SYNTACTIC ERROR >>>

              INPUT(.INPUT,,72)
<<< NO SYNTACTIC ERROR >>>

              SPC = '     ::'
<<< NO SYNTACTIC ERROR >>>

              ALPH = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
<<< NO SYNTACTIC ERROR >>>

     CLEAR    HEAD =
<<< NO SYNTACTIC ERROR >>>

              SWITCH1 = .FIRST
<<< NO SYNTACTIC ERROR >>>

              X = 0
<<< NO SYNTACTIC ERROR >>>

     READA    OUTPUT =
<<< NO SYNTACTIC ERROR >>>

     READ     CARD = TRIM(INPUT)                      :F(END1)
<<< NO SYNTACTIC ERROR >>>

              OUTPUT = CARD
<<< NO SYNTACTIC ERROR >>>

              DIFFER(CARD)                            :F(BADCARD)
<<< NO SYNTACTIC ERROR >>>

              CARD POS(0) '$' =                       :S(CONTROL)
<<< NO SYNTACTIC ERROR >>>

              CARD NOTANY(ALPH)                       :F(INCX)
<<< NO SYNTACTIC ERROR >>>

     BADCARD  OUTPUT = '  CARD ABOVE IS ILLEGAL'      :(READ)
<<< NO SYNTACTIC ERROR >>>

     INCX     X = X + 1                               :($SWITCH1)
<<< NO SYNTACTIC ERROR >>>

     FIRST    SWITCH1 = .SEARCH
<<< NO SYNTACTIC ERROR >>>

     F1       CARD LEN(1) . CH =                      :F(ERR)
<<< NO SYNTACTIC ERROR >>>

              HEAD = SYMB(CH)
<<< NO SYNTACTIC ERROR >>>

              CURRENT = HEAD
<<< NO SYNTACTIC ERROR >>>

     F2       CARD LEN(1) . CH =                      :F(INSERT)
<<< NO SYNTACTIC ERROR >>>

     F3       SUCC(CURRENT) = SYMB(CH,CURRENT)
<<< NO SYNTACTIC ERROR >>>

              CURRENT = SUCC(CURRENT)                 :(F2)
<<< NO SYNTACTIC ERROR >>>

     INSERT   ASSOC(CURRENT) = ASSOC(CURRENT) X ","   :(READ)
<<< NO SYNTACTIC ERROR >>>

     SEARCH   CARD LEN(1) . CH =                      :F(ERR)
<<< NO SYNTACTIC ERROR >>>

              LGT(CHAR(HEAD), CH)                     :S(S7)
<<< NO SYNTACTIC ERROR >>>

              IDENT(CHAR(HEAD),CH)                    :S(S5)
     *
     *  FIRST CHARACTER OF HEAD IS < FIRST CHAR OF CHAR JUST READ
     *  IF ALT(HEAD) NULL THEN MUST EXTEND STRUCTURE
     *
<<< NO SYNTACTIC ERROR >>>

              IDENT(ALT(HEAD))                        :S(S3)
<<< NO SYNTACTIC ERROR >>>

              CURRENT = ALT(HEAD)
<<< NO SYNTACTIC ERROR >>>

     S1       LGT(CHAR(CURRENT),CH)                   :S(S6)
<<< NO SYNTACTIC ERROR >>>

              IDENT(CHAR(CURRENT),CH)                 :S(S4)
<<< NO SYNTACTIC ERROR >>>

              IDENT(ALT(CURRENT))                     :S(S2)
<<< NO SYNTACTIC ERROR >>>

              CURRENT = ALT(CURRENT)                  :(S1)
     *
     *  NEW ALTERNATIVE MUST BE INSERTED AT END
     *
<<< NO SYNTACTIC ERROR >>>

     S2       ALT(CURRENT) = SYMB(CH,CURRENT)
     *
     *  THEN REST OF WORD STRUNG OUT
     *
<<< NO SYNTACTIC ERROR >>>

              CURRENT = ALT(CURRENT)                  :(F2)
     *
     *  NEW ALTERNATIVE MUST BE INSERTED AT HEAD OF LIST
     *
<<< NO SYNTACTIC ERROR >>>

     S3       ALT(HEAD) = SYMB(CH,HEAD)
<<< NO SYNTACTIC ERROR >>>

              CURRENT = ALT(HEAD)                     :(F2)
     -EJECT
     *
     *  CHARACTER HAS BEEN FOUND. NOW LOOK AT NEXT HCARACTER OF WORD
     *
<<< NO SYNTACTIC ERROR >>>

     S4       CARD LEN(1) . CH  =                     :F(INSERT)
     *  IF NO SUCCESSORS, STRING OUT REST OF WORD
     *
<<< NO SYNTACTIC ERROR >>>

              IDENT(SUCC(CURRENT))                    :S(F3)
     *
     *  OTHERWISE CONTINUE EXAMINATION
     *
<<< NO SYNTACTIC ERROR >>>

              CURRENT = SUCC(CURRENT)                 :(S1)
<<< NO SYNTACTIC ERROR >>>

     S5       CURRENT = HEAD                          :(S4)
     *
     *  CHAR IS SMALLER THAN CURRENT ALTERNATIVE
     *
<<< NO SYNTACTIC ERROR >>>

     S6       Y = LINK(CURRENT)
<<< NO SYNTACTIC ERROR >>>

              ALT(Y) = IDENT(ALT(Y),CURRENT) SYMB(CH,Y)         :F(S6A)
<<< NO SYNTACTIC ERROR >>>

              Y = ALT(Y)                              :(S6B)
<<< NO SYNTACTIC ERROR >>>

     S6A      SUCC(Y) = SYMB(CH,Y)
<<< NO SYNTACTIC ERROR >>>

              Y = SUCC(Y)
<<< NO SYNTACTIC ERROR >>>

     S6B      ALT(Y) = CURRENT
<<< NO SYNTACTIC ERROR >>>

              LINK(CURRENT) = Y
<<< NO SYNTACTIC ERROR >>>

              CURRENT = Y                             :(F2)
     *
     *  NEW ALTERNATIVE MUST BE LINKED TO HEAD, AT TOP OF LIST
     *
<<< NO SYNTACTIC ERROR >>>

     S7       Y = HEAD
<<< NO SYNTACTIC ERROR >>>

              HEAD = SYMB(CH)
<<< NO SYNTACTIC ERROR >>>

              LINK(Y) = HEAD
<<< NO SYNTACTIC ERROR >>>

              ALT(HEAD) = Y
<<< NO SYNTACTIC ERROR >>>

              CURRENT = HEAD                          :(F2)
<<< NO SYNTACTIC ERROR >>>

     CONTROL  IDENT(CARD,"*")                         :F(C1)
<<< NO SYNTACTIC ERROR >>>

              OUTPUT =
<<< NO SYNTACTIC ERROR >>>

              OUTPUT = '  (STRUCTURE IS CLEARED)'
<<< NO SYNTACTIC ERROR >>>

              OUTPUT =                                :(CLEAR)
<<< NO SYNTACTIC ERROR >>>

     C1       IDENT(CARD,'$')                         :F(C2)
<<< NO SYNTACTIC ERROR >>>

              OUTPUT =
<<< NO SYNTACTIC ERROR >>>

              OUTPUT = '  (PRINTOUT OF ENTIRE STRUCTURE FOLLOWS...)'
<<< NO SYNTACTIC ERROR >>>

              OUTPUT =
<<< NO SYNTACTIC ERROR >>>

              IDENT(HEAD)                             :S(C4)
<<< NO SYNTACTIC ERROR >>>

              HOLD =
<<< NO SYNTACTIC ERROR >>>

              START = HEAD                            :(LISTEM)
<<< NO SYNTACTIC ERROR >>>

     C2       IDENT(CARD)                             :S(BADCARD)
<<< NO SYNTACTIC ERROR >>>

              CARD NOTANY(ALPH)                       :S(BADCARD)
     -EJECT
     *
     *  HERE TO PRINT WORDS STARTING WITH SPECIFIED HEAD
     *
<<< NO SYNTACTIC ERROR >>>

              OUTPUT =
<<< NO SYNTACTIC ERROR >>>

              OUTPUT = '  (PRINTOUT OF ALL WORDS BEGINNING WITH "'
     +          CARD '"...)'
<<< NO SYNTACTIC ERROR >>>

              OUTPUT =
<<< NO SYNTACTIC ERROR >>>

              HOLD = CARD
<<< NO SYNTACTIC ERROR >>>

              CURRENT = HEAD
<<< NO SYNTACTIC ERROR >>>

              CARD LEN(1) . CH =
<<< NO SYNTACTIC ERROR >>>

     C3       IDENT(CHAR(CURRENT),CH)                 :S(NEXT)
<<< NO SYNTACTIC ERROR >>>

              CURRENT = ALT(CURRENT)
<<< NO SYNTACTIC ERROR >>>

              IDENT(CURRENT)                          :F(C3)
<<< NO SYNTACTIC ERROR >>>

     C4       OUTPUT = '  (NO WORDS)'                 :(READA)
<<< NO SYNTACTIC ERROR >>>

     NEXT     CARD LEN(1) . CH =                      :F(SETUP)
<<< NO SYNTACTIC ERROR >>>

              CURRENT = SUCC(CURRENT)
<<< NO SYNTACTIC ERROR >>>

              IDENT(CURRENT)                          :S(C4)F(C3)
<<< NO SYNTACTIC ERROR >>>

     SETUP    OUTPUT = DIFFER(ASSOC(CURRENT)) SPC HOLD '  ' ASSOC(CURRENT)
<<< NO SYNTACTIC ERROR >>>

              START = DIFFER(SUCC(CURRENT)) SUCC(CURRENT)  :F(C4)
<<< NO SYNTACTIC ERROR >>>

     LISTEM   N = 0
<<< NO SYNTACTIC ERROR >>>

              CURRENT = START
<<< NO SYNTACTIC ERROR >>>

     L1       HOLD = HOLD CHAR(CURRENT)
<<< NO SYNTACTIC ERROR >>>

     L2       OUTPUT = DIFFER(ASSOC(CURRENT)) SPC HOLD '  ' ASSOC(CURRENT)
<<< NO SYNTACTIC ERROR >>>

              CURRENT = DIFFER(SUCC(CURRENT)) SUCC(CURRENT)  :S(L1)
<<< NO SYNTACTIC ERROR >>>

     BACKUP   CURRENT = DIFFER(ALT(CURRENT)) ALT(CURRENT)  :F(B1)
<<< NO SYNTACTIC ERROR >>>

              N = N + 1
<<< NO SYNTACTIC ERROR >>>

              $('STACK' N) = LINK(CURRENT)
<<< SYNTACTIC ERROR >>>

              HOLD LEN(1) RPOS(0) = CHAR(CURRENT)     :(L2)
<<< NO SYNTACTIC ERROR >>>

     B1       Y = LINK(CURRENT)
<<< NO SYNTACTIC ERROR >>>

              IDENT(Y)                                :S(READA)
<<< NO SYNTACTIC ERROR >>>

              IDENT(Y,START) IDENT(ALT(Y),CURRENT)    :S(READA)
<<< NO SYNTACTIC ERROR >>>

              IDENT(Y,START) IDENT(ALT(Y))            :S(READA)
<<< NO SYNTACTIC ERROR >>>

              CURRENT = Y
<<< NO SYNTACTIC ERROR >>>

              HOLD DIFFER($('STACK' N),Y)  LEN(1) RPOS(0) =  :S(BACKUP)
<<< SYNTACTIC ERROR >>>

              N = N - 1                               :(B1)
<<< NO SYNTACTIC ERROR >>>

     END1     OUTPUT =
<<< NO SYNTACTIC ERROR >>>

              OUTPUT = '(ALL DATA PROCESSED)'
<<< NO SYNTACTIC ERROR >>>

     END
<<< NO SYNTACTIC ERROR >>>

