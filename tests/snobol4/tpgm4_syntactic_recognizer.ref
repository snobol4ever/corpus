<<< NO SYNTACTIC ERROR >>>

              OUTPUT('SKIP',6,'(A1)')
     *
<<< NO SYNTACTIC ERROR >>>

              DEFINE('INSERT(LIST,CARD)TEMP')               :(INSERTEND)
     *
<<< NO SYNTACTIC ERROR >>>

     INSERT   $LIST  =  IDENT($LIST)  CARD(NUM(CARD),NULL)  :S(RETURN)
<<< NO SYNTACTIC ERROR >>>

              $LIST  =  GT(NUM(CARD),NUM($LIST))  CARD(NUM(CARD),$LIST)
     .                                                      :S(RETURN)
<<< NO SYNTACTIC ERROR >>>

              TEMP  =  $LIST
<<< NO SYNTACTIC ERROR >>>

     INS1     IDENT(NEXT(TEMP))                             :S(INS2)
<<< NO SYNTACTIC ERROR >>>

              NEXT(TEMP)  =  GT(NUM(CARD),NUM(NEXT(TEMP)))
     .                       CARD(NUM(CARD),NEXT(TEMP))     :S(RETURN)
<<< NO SYNTACTIC ERROR >>>

              TEMP  =  NEXT(TEMP)                           :(INS1)
<<< NO SYNTACTIC ERROR >>>

     INS2     NEXT(TEMP)  =  CARD(NUM(CARD),NULL)           :(RETURN)
<<< NO SYNTACTIC ERROR >>>

     INSERTEND
     *
     *
<<< NO SYNTACTIC ERROR >>>

              DEFINE('LINE(STR1,COL1,STR2,COL2)BL1,BL2')    :(LINEEND)
     *
<<< NO SYNTACTIC ERROR >>>

     LINE     BL  LEN(COL1 - 1) . BL1
<<< NO SYNTACTIC ERROR >>>

              IDENT(STR2)                                   :S(LINE1)
<<< NO SYNTACTIC ERROR >>>

              BL  LEN(COL2 - (COL1 + SIZE(STR1))) . BL2
<<< SYNTACTIC ERROR >>>

     LINE1    LINE  =  BL1  STR1  BL2  STR2                 :(RETURN)
<<< NO SYNTACTIC ERROR >>>

     LINEEND
     *
     *
<<< NO SYNTACTIC ERROR >>>

              DEFINE('NTH(LIST,NUM)TEMP')                   :(NTHEND)
     *
<<< NO SYNTACTIC ERROR >>>

     NTH      NTH  =  EQ(NUM,0)  $LIST                      :F(NTH1)
<<< NO SYNTACTIC ERROR >>>

              $LIST  =  NEXT($LIST)                         :(RETURN)
<<< NO SYNTACTIC ERROR >>>

     NTH1     TEMP  =  $LIST
<<< NO SYNTACTIC ERROR >>>

     NTH2     NUM  =  NUM - 1
<<< NO SYNTACTIC ERROR >>>

              NTH  =  EQ(NUM,0)  NEXT(TEMP)                 :S(NTH3)
<<< NO SYNTACTIC ERROR >>>

              TEMP  =  NEXT(TEMP)                           :(NTH2)
<<< NO SYNTACTIC ERROR >>>

     NTH3     NEXT(TEMP)  =  NEXT(NEXT(TEMP))               :(RETURN)
<<< NO SYNTACTIC ERROR >>>

     NTHEND
     *
     *
<<< NO SYNTACTIC ERROR >>>

              DEFINE('RANDOM(N)')                           :(RANDOMEND)
<<< NO SYNTACTIC ERROR >>>

     RANDOM   RAN.VAR  =  RAN.VAR * 1061 + 3251
<<< NO SYNTACTIC ERROR >>>

              RAN.VAR  ARB  RPOS(5)  =
<<< NO SYNTACTIC ERROR >>>

              RANDOM  =  (RAN.VAR * N) / 100000             :(RETURN)
<<< SYNTACTIC ERROR >>>

     RANDOMEND
