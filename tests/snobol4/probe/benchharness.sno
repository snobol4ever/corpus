*-------------------------------------------------------------- 1 probe_deflocal
* PROBE: same loop body, but A and ZI declared as true DEFINE-locals (the real kernels do NOT do this).
        &TRIM = 1
        &ANCHOR = 0
        &STLIMIT = -1
        DEFINE('ZBODY(ZKN)A,ZI')                        :(ZBODY_END)
ZBODY   A = 0
        ZI = 1
ZBL     A = A + 1
        ZI = LT(ZI, ZKN) ZI + 1                         :S(ZBL)
        ZBODY = A                                       :(RETURN)
ZBODY_END
        OUTPUT = ZBODY(1000)
END
*--------------------------------------------------------------- 2 probe_defwrap
* PROBE: identical loop body, DEFINE-wrapped exactly as arith_loop.sno's real ZBODY/harness shape.
        &TRIM = 1
        &ANCHOR = 0
        &STLIMIT = -1
        DEFINE('ZBODY(ZKN)')                            :(ZBODY_END)
ZBODY   A = 0
        ZI = 1
ZBL     A = A + 1
        ZI = LT(ZI, ZKN) ZI + 1                         :S(ZBL)
        ZBODY = A                                       :(RETURN)
ZBODY_END
        OUTPUT = ZBODY(1000)
END
*-------------------------------------------------------------- 3 probe_toplevel
* PROBE: identical loop body to arith_loop.sno's ZBODY, but running top-level -- no DEFINE, no CALL.
        &TRIM = 1
        &ANCHOR = 0
        &STLIMIT = -1
        ZKN = 1000
        A = 0
        ZI = 1
ZBL     A = A + 1
        ZI = LT(ZI, ZKN) ZI + 1                         :S(ZBL)
        OUTPUT = A
END
