*-------------------------------------------------------------------- 1 dc_nest2
*  dc_nest2 [DCAP] nested immediate captures over DEFER operands
*  ((*P $ X) (*Q $ Y)) $ Z  --  Z must span from *P's begin to *Q's end
        P = LEN(2)
        Q = LEN(3)
        'ABCDEFG' ? ((*P $ X) (*Q $ Y)) $ Z            :F(NO)
        OUTPUT = '=S'                                  :(EN)
NO      OUTPUT = '=F'
EN      OUTPUT = 'X=' X
        OUTPUT = 'Y=' Y
        OUTPUT = 'Z=' Z
END
*-------------------------------------------------------------------- 2 dc_nest3
*  dc_nest3 [DCAP] three-deep nesting: capture of capture of defer
        P = LEN(2)
        Q = LEN(3)
        'ABCDEFG' ? (((*P $ X) $ W) (*Q $ Y)) $ Z      :F(NO)
        OUTPUT = '=S'                                  :(EN)
NO      OUTPUT = '=F'
EN      OUTPUT = 'X=' X
        OUTPUT = 'W=' W
        OUTPUT = 'Y=' Y
        OUTPUT = 'Z=' Z
END
*------------------------------------------------------------------ 3 dc_nest_bt
*  dc_nest_bt [DCAP] inner operand backtracks (re-fires Y) before Z lands
*  ARB inside Q's defer forces multiple Y assignments; Z begin must survive
        P = LEN(1)
        Q = ARB
        'ABCDE' ? ((*P $ X) (*Q $ Y) 'D') $ Z          :F(NO)
        OUTPUT = '=S'                                  :(EN)
NO      OUTPUT = '=F'
EN      OUTPUT = 'X=' X
        OUTPUT = 'Y=' Y
        OUTPUT = 'Z=' Z
END
*-------------------------------------------------------------------- 4 dc_recur
*  dc_recur [DCAP] recursive pattern through *LIST with captures INSIDE
*  the recursion: same static capture nodes live at several depths at once
        ITEM = SPAN('0123456789') $ LAST | *LIST
        LIST = ('(' ITEM ARBNO(',' ITEM) ')') $ GRP
        TEST = POS(0) LIST RPOS(0)
        '(12,(3,45),78)' ? TEST                        :F(NO)
        OUTPUT = '=S'                                  :(EN)
NO      OUTPUT = '=F'
EN      OUTPUT = 'LAST=' LAST
        OUTPUT = 'GRP=' GRP
END
*------------------------------------------------------------------- 5 dc_sib_bt
*  dc_sib_bt: deep-backtrack re-entry of an EARLIER same-depth sibling capture.
*  X=ARB re-extends AFTER Y's SAVE has already fired -- X's IMM re-read must see
*  X's OWN begin (per-NODE slot), not Y's (a per-DEPTH slot would alias here:
*  predicted X='B' under depth-sharing; oracle X='AB').
        P = ARB
        Q = LEN(1)
        'ABCD' ? ((*P $ X) (*Q $ Y) 'D') $ Z                   :F(NO)
        OUTPUT = '=S'                                          :(EN)
NO      OUTPUT = '=F'
EN      OUTPUT = 'X=' X
        OUTPUT = 'Y=' Y
        OUTPUT = 'Z=' Z
END
