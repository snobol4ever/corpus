 z = CHAR(0); w = 'a' z 'b'; OUTPUT = SIZE(w);END;* n01_size
 z = CHAR(0); w = 'a' z 'b'; t = TABLE(); t['a' z 'b'] = 'FIRST'; t['a' z 'c'] = 'SECOND'; t['a'] = 'PLAIN'; OUTPUT = t['a' z 'b'] '/' t['a' z 'c'] '/' t['a'];END;* n02_table_keys
 z = CHAR(0); w = 'a' z 'b'; OUTPUT = IDENT('a' z 'b', 'a' z 'c') 'SAME'; OUTPUT = DIFFER('a' z 'b', 'a' z 'c') 'DIFF';END;* n03_ident
 z = CHAR(0); w = 'a' z 'b'; OUTPUT = SIZE(w w);END;* n04_concat_size
 z = CHAR(0); w = 'a' z 'b'; OUTPUT = SIZE(REVERSE(w));END;* n05_reverse
 z = CHAR(0); w = 'a' z 'b'; OUTPUT = SIZE(DUPL(w, 3));END;* n06_dupl
 z = CHAR(0); w = 'a' z 'b'; OUTPUT = SIZE(REPLACE(w, 'ab', 'xy'));END;* n07_replace
 z = CHAR(0); w = 'a' z 'b'; w LEN(3) . m :F(NO); OUTPUT = SIZE(m) :(END);NO OUTPUT = 'nomatch';END;* n08_pat_len
 z = CHAR(0); w = 'a' z 'b'; w BREAK(z) . m :F(NO); OUTPUT = SIZE(m) :(END);NO OUTPUT = 'nomatch';END;* n09_pat_break
 z = CHAR(0); w = 'a' z 'b'; w ('a' z 'b') :F(NO); OUTPUT = 'matched' :(END);NO OUTPUT = 'nomatch';END;* n10_pat_lit
 z = CHAR(0); w = 'a' z 'b'; t = TABLE(); t[w] = 1; OUTPUT = SIZE(CONVERT(t,'ARRAY')[1,1]);END;* n11_array_key
 z = CHAR(0); w = 'a' z 'b'; OUTPUT = w;END;* n12_output_bytes
 z = CHAR(0); w = 'a' z 'b'; OUTPUT = SIZE(TRIM(w ' '));END;* n13_trim
 z = CHAR(0); w = 'a' z 'b'; w POS(0) LEN(1) . a1 LEN(1) . a2 LEN(1) . a3 :F(NO); OUTPUT = SIZE(a1) '/' SIZE(a2) '/' SIZE(a3) :(END);NO OUTPUT = 'nomatch';END;* n14_substr_pat
