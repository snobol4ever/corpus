up_end
        P = LEN(0)
        P = P (up('a') | 'a')
        'A' P                           :F(NO)
        OUTPUT = 'MATCHED alt-call-top' :(FIN)
NO      OUTPUT = 'NOMATCH'
FIN
END
*-------------------------------------------- 13 mv_ctl_eager_call_concat_fnloop
        DEFINE('up(up)')                :(up_end)
up      up = REPLACE(up, &LCASE, &UCASE)  :(RETURN)
up_end
        DEFINE('mk(s)c')                :(mk_end)
mk      IDENT(s)                        :S(RETURN)
        s POS(0) LEN(1) . c =
        mk = mk up(c)                   :(mk)
mk_end
        'AB' mk('ab')                   :F(NO)
        OUTPUT = 'MATCHED call-concat'  :(FIN)
NO      OUTPUT = 'NOMATCH'
FIN
END
