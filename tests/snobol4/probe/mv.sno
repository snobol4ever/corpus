 DEFINE('mk(s)c') :(mk_end);mk c = s; mk = (REPLACE(c,&LCASE,&UCASE) | c) :(RETURN);mk_end; 'A' mk('a') :F(NO); OUTPUT = 'MATCHED e7' :(FIN);NO OUTPUT = 'NOMATCH';FIN;END;* mv_alt_builtin_call_infn
*----------------------------------------------------- 2 mv_alt_call_build_order
        DEFINE('up(up)')                :(up_end)
up      OUTPUT = 'CALLED up'
        up = REPLACE(up, &LCASE, &UCASE)  :(RETURN)
up_end
        c = 'a'
        P = LEN(0)
        P = P (up(c) | c)
        OUTPUT = 'BUILT'
        'A' P                           :F(NO)
        OUTPUT = 'MATCHED'              :(FIN)
NO      OUTPUT = 'NOMATCH'
FIN
END
 DEFINE('mk(s)c,p') :(mk_end);mk c = s; p = (REPLACE(c,&LCASE,&UCASE) | c); 'A' p :F(FRETURN); mk = 'inner-ok' :(RETURN);mk_end; OUTPUT = mk('a');END;* mv_alt_call_infn_matched_infn
 DEFINE('F()') :(FEND);F F = LEN(2) :(RETURN);FEND; 'ABCDE' F() :F(NOM); OUTPUT = 'MATCHED nocapture' :(FIN);NOM OUTPUT = 'NOMATCH';FIN;END;* mv_call_as_pattern
 DEFINE('F()') :(FEND);F F = LEN(2) . X :(RETURN);FEND; 'ABCDE' F() :F(NOM); OUTPUT = 'MATCHED X=[' X ']' :(FIN);NOM OUTPUT = 'NOMATCH';FIN;END;* mv_call_as_pattern_capture
 DEFINE('F()') :(FEND);F F = LEN(2) :(RETURN);FEND; 'ABCDE' POS(0) F() :F(NOM); OUTPUT = 'MATCHED compound' :(FIN);NOM OUTPUT = 'NOMATCH';FIN;END;* mv_call_as_pattern_compound
 DEFINE('F()') :(FEND);F F = LEN(2) :(RETURN);FEND; X = 'ABCDE'; X ? F() :F(NOM); OUTPUT = 'MATCHED qmark' :(FIN);NOM OUTPUT = 'NOMATCH';FIN;END;* mv_call_as_pattern_qmark
 DEFINE('mk(s)c,p') :(mk_end);mk c = s; p = (REPLACE(c,&LCASE,&UCASE) | c); mk = 'built-ok' :(RETURN);mk_end; OUTPUT = mk('a');END;* mv_ctl_alt_call_infn_built_only
*------------------------------------------------ 9 mv_ctl_alt_call_toplevel_var
        DEFINE('up(up)')                :(up_end)
up      up = REPLACE(up, &LCASE, &UCASE)  :(RETURN)
up_end
        c = 'a'
        P = LEN(0)
        P = P (up(c) | c)
        'A' P                           :F(NO)
        OUTPUT = 'MATCHED e1'           :(FIN)
NO      OUTPUT = 'NOMATCH'
FIN
END
 DEFINE('mk(s)c') :(mk_end);mk c = s; mk = ('A' | c) :(RETURN);mk_end; 'A' mk('a') :F(NO); OUTPUT = 'MATCHED e4' :(FIN);NO OUTPUT = 'NOMATCH';FIN;END;* mv_ctl_alt_nocall_infn
*--------------------------------------------------- 11 mv_ctl_call_hoisted_infn
        DEFINE('up(up)')                :(up_end)
up      up = REPLACE(up, &LCASE, &UCASE)  :(RETURN)
up_end
        DEFINE('mk(s)c,t')              :(mk_end)
mk      c = s
        t = up(c)
        mk = (t | c)                    :(RETURN)
mk_end
        'A' mk('a')                     :F(NO)
        OUTPUT = 'MATCHED e6'           :(FIN)
NO      OUTPUT = 'NOMATCH'
FIN
END
*--------------------------------------------- 12 mv_ctl_eager_call_alt_toplevel
