*---------------------------------------------------- 1 indirect_pattern_operand
        vowel_set = SPAN('aeiou')
        pattern_name = .vowel_set
        sample = 'aeiou' 'zzz'
        sample $pattern_name				:F(no_match)
        OUTPUT = 'match ok'				:(check_fail)
no_match	OUTPUT = 'match ERR'
check_fail
        digit_set = SPAN('0123456789')
        digit_name = .digit_set
        word = 'hello'
        word $digit_name				:S(fail_err)
        OUTPUT = 'fail ok'				:(END)
fail_err	OUTPUT = 'fail ERR'
END
