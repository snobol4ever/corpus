 mk = LEN(0); n = 0;LP n = n + 1; mk = mk ('X' | 'y'); LT(n,1) :S(LP); 'X' mk :F(NO); OUTPUT = 'MATCHED once' :(FIN);NO OUTPUT = 'NOMATCH once';FIN;END;* pb_ctl_selfref_alt_once_ok
 mk = LEN(0); mk = mk ('X' | 'y'); mk = mk ('X' | 'y'); 'Xy' mk :F(NO); OUTPUT = 'MATCHED unrolled' :(FIN);NO OUTPUT = 'NOMATCH unrolled';FIN;END;* pb_ctl_selfref_alt_unrolled_ok
 mk = LEN(0); n = 0;LP n = n + 1; mk = mk 'x'; LT(n,2) :S(LP); 'xx' mk :F(NO); OUTPUT = 'MATCHED noalt' :(FIN);NO OUTPUT = 'NOMATCH noalt';FIN;END;* pb_ctl_selfref_noalt_ok
*-------------------------------------------------- 4 pb_ctl_snap_accum_unrolled
        DEFINE('mk(s)c')                :(mk_end)
mk      s POS(0) LEN(1) . c =
        mk = mk ('X' | c)
        s POS(0) LEN(1) . c =
        mk = mk ('X' | c)               :(RETURN)
mk_end
        'ab' mk('ab')                   :F(NO)
        OUTPUT = 'MATCHED r2'           :(FIN)
NO      OUTPUT = 'NOMATCH r2'
FIN
END
 mk = LEN(0); n = 0;LP n = n + 1; mk = mk ('X' | 'y'); LT(n,2) :S(LP); 'Xy' mk :F(NO); OUTPUT = 'MATCHED cycle' :(FIN);NO OUTPUT = 'NOMATCH cycle';FIN;END;* pb_selfref_alt_cycle
 mk = 'q'; n = 0;LP n = n + 1; mk = mk | 'y'; LT(n,2) :S(LP); 'y' mk :F(NO); OUTPUT = 'MATCHED toplevel' :(FIN);NO OUTPUT = 'NOMATCH toplevel';FIN;END;* pb_selfref_toplevel_alt_cycle
*----------------------------------------------------- 7 pb_snap_alias_loop_infn
        DEFINE('mk(s)c')                :(mk_end)
mk      IDENT(s)                        :S(RETURN)
        s POS(0) LEN(1) . c =
        mk = mk ('X' | c)               :(mk)
mk_end
        'ab' mk('ab')                   :F(NO)
        OUTPUT = 'MATCHED r1'           :(FIN)
NO      OUTPUT = 'NOMATCH r1'
FIN
END
 s = 'ab'; mk = LEN(0);LP IDENT(s) :S(DONE); s POS(0) LEN(1) . c =; mk = mk ('X' | c) :(LP);DONE 'ab' mk :F(NO); OUTPUT = 'MATCHED r3' :(FIN);NO OUTPUT = 'NOMATCH r3';FIN;END;* pb_snap_alias_loop_main
*----------------------------------------------------- 9 pb_stale_snapshot_value
        c = 'a'
        n = 0
LP      n = n + 1
        p = ('X' | c)
        saved = IDENT(n,1) p
        c = 'b'
        LT(n,2)                         :S(LP)
        'a' saved                       :F(NO)
        OUTPUT = 'MATCHED stale'        :(FIN)
NO      OUTPUT = 'NOMATCH stale'
FIN
END
