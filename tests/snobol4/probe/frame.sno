 inner = ('a' | 'ab'); outer = ARBNO(*inner); s = 'abab'; s POS(0) *outer RPOS(0) :S(G)F(B);G OUTPUT = 'match' :(END);B OUTPUT = 'nomatch';END;* frame_alt_two_instances
 A2 = 'xy'; P = ('x' | *A2); Q = ('z' | 'yz'); s = 'xyyz'; s POS(0) *P *Q RPOS(0) :S(G)F(B);G OUTPUT = 'match' :(END);B OUTPUT = 'nomatch';END;* frame_cross_blob_alt
*-------------------------------------------------------- 3 frame_recursive_list
        ITEM = SPAN('0123456789') | *LIST
        LIST = '(' ITEM ARBNO(',' ITEM) ')'
        TEST = POS(0) LIST RPOS(0)
        '(12,(3,45,(6)),78)' ? TEST                           :S(G1)F(B1)
G1      OUTPUT = 'match1'                                     :(T2)
B1      OUTPUT = 'nomatch1'
T2      '(12,(34)' ? TEST                                     :S(B2)F(G2)
B2      OUTPUT = 'match2'                                     :(END)
G2      OUTPUT = 'nomatch2'
END
