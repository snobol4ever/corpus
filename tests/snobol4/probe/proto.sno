*------------------------------------------------------------ 1 proto_excess_arg
        a = ARRAY(3)
        c = ARRAY('1:3')
        OUTPUT = 'ctl_bare  = ' PROTOTYPE(a) ' / ' DATATYPE(PROTOTYPE(a))
        OUTPUT = 'ctl_range = ' PROTOTYPE(c) ' / ' DATATYPE(PROTOTYPE(c))
        OUTPUT = 'exc_bare  = ' PROTOTYPE(a,1) ' / ' DATATYPE(PROTOTYPE(a,1))
        OUTPUT = 'exc_range = ' PROTOTYPE(c,1) ' / ' DATATYPE(PROTOTYPE(c,1))
END
*----------------------------------------------------------------- 2 proto_table
        t0 = TABLE()
        t5 = TABLE(5)
        t57 = TABLE(5,7)
        OUTPUT = 'ctl_array = ' PROTOTYPE(ARRAY(3))            :s(w0)
        OUTPUT = 'ctl_array FAILED'
w0      OUTPUT = 'tbl_dflt  = ' PROTOTYPE(t0)                  :s(w5)
        OUTPUT = 'tbl_dflt FAILED'
w5      OUTPUT = 'tbl_5     = ' PROTOTYPE(t5)                  :s(w57)
        OUTPUT = 'tbl_5 FAILED'
w57     OUTPUT = 'tbl_5_7   = ' PROTOTYPE(t57)                 :s(wdt)
        OUTPUT = 'tbl_5_7 FAILED'
wdt     OUTPUT = 'tbl_dtype = ' DATATYPE(PROTOTYPE(t0))        :s(END)
        OUTPUT = 'tbl_dtype FAILED'
END
