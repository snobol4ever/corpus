 N = 'V'; S = 'xyz'; S LEN(1) . *$N =; OUTPUT = '[' V ']';END;* gim_defer_cassign_indirect
 PAT = LEN(1) . *V; S = 'xyz'; S PAT =; OUTPUT = '[' V ']';END;* gim_defer_cassign_simple_control
 I = SPAN('0123456789'); DY = 83; P = '(' I $ X *GT(DY,X) ',' I $ M; T = '(334,12)(31,2)(0,1)'; T P :F(GDP_F); OUTPUT = X ' ' M :(END);GDP_F OUTPUT = 'NO MATCH';END;* gim_defer_pred_in_pattern_segv
 E = CONVERT('GE(1,2)', 'EXPRESSION'); EVAL(E) :S(Y); OUTPUT = 'FAILED AS IT SHOULD' :(Z);Y OUTPUT = 'SUCCEEDED (WRONG)';Z;END;* gim_eval_silent_success
 OUTPUT = 2 ** 0.5; OUTPUT = 1.0 / 3.0; OUTPUT = 2.0 / 3.0; OUTPUT = 4.0 ** 0.5; OUTPUT = 1 + 1;END;* gim_real_print_precision
 DEFINE('STRIP(S1,S2)P') :(STRIP_END);STRIP STRIP = S1; P = SPAN(S2); STRIP P = :(RETURN);STRIP_END; OUTPUT = STRIP('ABCDEF', 'BDF');END;* gim_span_param_pattern_wrong
 S = 'ABCDEF'; X = 'BDF'; P = SPAN(X); S P =; OUTPUT = S;END;* gim_span_self_rebind_control
 R = 3; 'ABCDEF' TAB(*R) LEN(1) . C; OUTPUT = C;END;* gim_tab_defer_no_template
*-------------------------------------------------- 9 gim_blanks_min_wrong XFAIL
*  MINIMAL WITNESS (s183): BLANKS('X = A') must remove blanks -> 'X=A'.
*  SCRIP answers 'X = A' -- a SILENT WRONG ANSWER, oracle-differential, and
*  INDEPENDENT of RTSEQ-RESUME (SCRIP_RTSEQ_RESUME=0 gives the same wrong answer).
-INCLUDE "BLANKS.sno"
        OUTPUT  =  BLANKS('X = A')
END
*----------------------------------------------- 10 gim_break_value_drops_prefix
        X  =  'ab'
        &ALPHABET  BREAK('b')  REM . HIGHS
        OUTPUT  =  'SIZE(HIGHS)=' SIZE(HIGHS)
        X  (BREAK(HIGHS) | REM) . S1  =  S1 'b'
        OUTPUT  =  '[' X ']'
        Y  =  'ab'
        H2  =  'bcdefghijklmnopqrstuvwxyz'
        Y  (BREAK(H2) | REM) . S2  =  S2 'b'
        OUTPUT  =  '[' Y ']'
END
*------------------------------------------ 11 gim_defer_cassign_array_elt XFAIL
*  gim_defer_cassign_array_elt - SILENT WRONG ANSWER (distilled from CRACK.sno,
*  gimpel batch D).  A conditional assignment whose target is a DEFERRED
*  non-simple name -- an array element -- captures nothing and says nothing.
*  CRACK's whole mechanism is PAT = BREAK(B) . *CRACK<I> LEN(1), so CRACK
*  returns an array of the RIGHT SIZE with EVERY ELEMENT NULL.
*  ORACLE: [x][y][z].  SCRIP: [][][], rc=0, no diagnostic, both modes.
        A  =  ARRAY(3)
        PAT  =  LEN(1) . *A<I>
        S  =  'xyz'
        I  =  1
        S  PAT  =
        I  =  2
        S  PAT  =
        I  =  3
        S  PAT  =
        OUTPUT  =  '[' A<1> '][' A<2> '][' A<3> ']'
END
*---------------------------------------------- 12 gim_double_include_hang XFAIL
*  gim_double_include_hang - INCLUDING THE SAME FILE TWICE HANGS SCRIP.
*
*  Distilled from gimpel batch D.  MINP.sno includes SPACING.sno AND
*  COUNT.sno, and SPACING.sno itself includes COUNT.sno -- the ordinary
*  "name every module you use" habit, which is why the shape is everywhere in
*  the gimpel library.  The oracle is INCLUDE-ONCE and answers normally.
*  SCRIP re-expands the file, and the resulting image never terminates:
*  rc=124, NO output, NO diagnostic, in BOTH modes.
*
*  ORACLE: 3.  SCRIP: hangs.
*  Control one file over: gim_double_include_once_control (same body, one
*  include) is GREEN, so the ingredient is the SECOND include and nothing else.
-INCLUDE "gim_double_include_hang_A.sno"
-INCLUDE "gim_double_include_hang_A.sno"
        OUTPUT  =  DI_COUNT('aaa','a')
END
*-------------------------------------------- 13 gim_double_include_once_control
*  gim_double_include_once_control - the GREEN CONTROL for
*  gim_double_include_hang: the identical program with ONE include.
-INCLUDE "gim_double_include_hang_A.inc"
        OUTPUT  =  DI_COUNT('aaa','a')
END
*--------------------------------------------- 14 gim_fortput_m4_only_segv XFAIL
*  gim_fortput_m4_only_segv - AN m4-ONLY SIGSEGV, THREE LINES, **CURED BY THE
*  SPAN-FRAME FLIP** -- kept as a regression guard and as an independent
*  witness FOR that flip, from a seat that did not know it was landing.
*
*  ⭐ STATUS.  GREEN at SCRIP 6d4cab2d (m4 rc=0, 6/6).  RED at SCRIP cecb7d11
*  (m4 SIGSEGV 16/16, ASLR on and off alike; m3 correct 8/8 at both).  The
*  cure is named by a ONE-COMMAND A/B on the killswitch, not by a bisect:
*      SCRIP_SPAN_FRAME=0  -> rc=139, the SEGV verbatim
*      SCRIP_ARBNO_ALTSIB=0 -> rc=0, correct
*  so SPAN-FRAME (s188 seat7, SCRIP d3251f23 -- 'the ALT-arm leaf's zeta cell
*  stops being a raw flat rsp coordinate') is what fixed it.  This program has
*  no ARBNO, no alternation the eye can see, and nothing to do with the row
*  that flip was landed for; it reaches the ALT-arm leaf through
*  (LEN(72) | REM) . T inside a self-recursive DEFINEd function.
*
*  ⭐ WHAT RULED OUT A CODEGEN DIVERGENCE WHEN IT WAS RED: the emitted .s was
*  BYTE-IDENTICAL across repeated compiles at both revisions, so the two modes
*  were never handed different code -- the same deterministic program was
*  correct in the in-process image and fatal in the linked binary.
*
*  Distilled from gimpel batch D.  FORTPUT.sno is a four-statement module that
*  chops a FORTRAN statement into 72-column pieces and hands each to PUT:
*        FORTPUT  S  (LEN(72) | REM) . T  =
*                 PUT(T)
*                 IDENT(S,NULL)              :S(RETURN)
*                 S  =  DUPL(' ',5)  '1' S   :(FORTPUT)
*  ⛔ HONEST NOTE ON ONE READING, from when it was red: an early burst of three
*  runs returned rc=124 (hang) instead of 139 from the same binary.  It did not
*  reproduce in the 16 runs after, on a machine running eight seats, so it is
*  recorded as an unexplained transient and NOT claimed as nondeterminism.
*
*  When it was red, every piece was separately GREEN in m4 -- LPAD, RPAD, PUT
*  alone, the (LEN(n) | REM) . T capture-and-replace loop alone, and the same
*  loop inside a DEFINEd function that recurses on itself.  The crash needed
*  the assembled module, which is why it survived minimization attempts.
*
*  ORACLE: "hi" padded to column 73 with its serial number.
-INCLUDE "/home/claude4/corpus/programs/gimpel/FORTPUT.sno"
        FORTPUT('hi')
END
*----------------------------------------- 15 gim_goto_function_call_parse XFAIL
*  gim_goto_function_call_parse - distilled from gimpel STATEF_driver (batch F).
*  A GOTO WHOSE OPERAND IS A FUNCTION CALL -- :(GO()) -- IS A PARSE ERROR IN
*  SCRIP.  The oracle compiles and runs it: the function returns a label NAME
*  by name (:(NRETURN)) and control transfers to it.  This is not exotic; it is
*  the entire published contract of STATEF.inc, whose state functions return by
*  executing :(RET(label)) instead of :(RETURN).
*
*  ⛔ NOT the batch-C/D :<ARG_S> class (gim_seq_code_loop_in_function): that is
*  an ANGLE-BRACKET direct goto and it SEGVs at RUN time.  This one never gets
*  past the parser, and the parenthesised goto is the ordinary spelling.
*
*  THE TWO PASSING SIBLINGS ARE THE POINT: the goto field itself is fine and the
*  indirection is fine, so the refused ingredient is THE CALL IN THE GOTO.
        DEFINE('GO()')                          :(SIB1)
GO      GO  =  .L3                              :(NRETURN)
*  sibling 1: an ordinary direct goto to a label -- ACCEPTED
SIB1    OUTPUT  =  'sib1 go'                    :(L1)
L1      OUTPUT  =  'sib1 landed'
*  sibling 2: an indirect goto through a variable holding the label name -- ACCEPTED
        W  =  'L2'
        OUTPUT  =  'sib2 go'                    :($W)
L2      OUTPUT  =  'sib2 landed'
*  THE WITNESS: the target reached by CALLING GO() IN THE GOTO -- SCRIP refuses
*  at parse time; the oracle transfers to L3.
        OUTPUT  =  'witness go'                 :(GO())
        OUTPUT  =  'NOT REACHED'
L3      OUTPUT  =  'witness landed'
END
*-------------------------------------- 16 gim_indirect_read_third_operand XFAIL
*  indirect_read_third_operand - distilled from gimpel TEMP_driver (batch C).
*  An indirect read $N whose cell was created ONLY by a preceding indirect
*  store reads as NULL when N is ALSO the first operand of the SAME three-
*  operand concatenation.  Line 1 must read V1=stored (sbl oracle); SCRIP
*  prints V1= in BOTH m3 and m4, and under SCRIP_OPT=0 and RTSEQ_RESUME=0.
*  THREE ingredients, all required -- lines 2..7 remove one each and pass:
*    (a) the name in N is built at RUN TIME, so no compile-time cell exists
*        (with N = 'V1' written literally the same shape is correct);
*    (b) the exact shape  N <literal> $N , with $N the LAST of three -- a
*        literal prefix, a fourth operand, or $N not last all restore it;
*    (c) the name must appear NOWHERE literally in the program text, and
*        NOTHING may read N before the witness.  ORDER IS LOAD-BEARING:
*        the M = N below sits AFTER the witness because moving it ABOVE
*        the store masks the defect, as does one literal mention of V1.
*  CASCADE: with the witness executed FIRST, lines 2..6 -- every one of
*  which is correct in isolation -- ALSO read null, so the damage is not
*  confined to the offending statement.  Line 7 recovers only because a
*  fresh store through a COMPILE-TIME-VISIBLE name rebinds the cell.
        DEFINE('TEMP()')                        :(TEMP_END)
TEMP    K  =  1
        TEMP  =  'V'  K                         :(RETURN)
TEMP_END
        N  =  TEMP()
        $N  =  'stored'
        OUTPUT  =  N '=' $N
        OUTPUT  =  $N
        OUTPUT  =  N $N
        OUTPUT  =  N 'x' 'y' $N
        OUTPUT  =  N 'x' $N 'y'
        M  =  N
        OUTPUT  =  M 'x' $N
        L  =  'V1'
        $L  =  'again'
        OUTPUT  =  L '=' $L
END
*---------------------------------------------- 17 gim_name_of_field_store XFAIL
*  MINIMAL WITNESS (s186, batch B, from LINEARIZ.sno and READL.sno): an
*  indirect store through the NAME OF A DATA FIELD -- P = .R(X) then $P = ...
*  -- is a SILENT NO-OP in SCRIP; the field keeps its old value.  The same
*  idiom over a plain variable (the second half) works in both, so the defect
*  is the field name, not the name operator or the indirect store.
*  LINEARIZE strings its tree through exactly this ($LAST_NAME = T over
*  LAST_NAME = .RSON(T)) and so returns a chain truncated after two nodes;
*  READL builds its list through it and returns an empty one.
	DATA('ND(L,R)')
	X  =  ND('a','b')
	P  =  .R(X)
	$P  =  'CHANGED'
	OUTPUT  =  R(X)
	Y  =  'orig'
	Q  =  .Y
	$Q  =  'CHANGED2'
	OUTPUT  =  Y
END
*----------------------------------------------------- 18 gim_not_op_no_template
*  gim_not_op_no_template - COMPILER FATAL.  The unary ~ (negation) operator
*  reaches the emitter as IR op=3 with no template, aborting the compile in
*  both m3 and m4 (op NUMBER valid at SCRIP 0b75fa5e -- the enum went
*  alphabetical at 54b6c478, so cite the CONSTRUCT, never the number).
*  Distilled from IP.sno, which ends its loop on ~P<M>.
        P  =  ARRAY(2)
        OUTPUT  =  'A'  ~P<9>
        OUTPUT  =  'B'
END
*------------------------------------------------ 19 gim_omitted_arg_shift XFAIL
*  gim_omitted_arg_shift - SILENT WRONG ANSWER.  An OMITTED LEADING argument in
*  a call, F(, 'y'), shifts the remaining arguments left in SCRIP: 'y' lands in
*  A instead of B.  A trailing omission, F('x', ), is handled correctly.
*  Distilled from INSERT.sno, whose contract case is INSERT(, 'SOLO') -- the
*  header's "if T is null, a root node is created" arm.
        DEFINE('F(A,B)')                        :(F_END)
F       F  =  '[' A ']' '[' B ']'               :(RETURN)
F_END
        OUTPUT  =  F('x', 'y')
        OUTPUT  =  F(, 'y')
        OUTPUT  =  F('x', )
END
*-------------------------------------- 20 gim_or_single_alternative_crash XFAIL
*  gim_or_single_alternative_crash - distilled from gimpel batch E, where it
*  takes OR_driver, ORSORT_driver and ORVISUAL_driver together.
*  ONE call to OR(LIST) with a SINGLE one-character alternative crashes
*  SCRIP.  The oracle (sbl -b) prints "built".  SCRIP dies before it.
*  ⛔ IT IS NONDETERMINISTIC, AND THAT IS THE POINT: measured n=12 per mode
*  on the full driver, SCRIP always fails but the SIGNAL varies run to run --
*  OR m3 SIGSEGV 7 / SIGABRT 5, m4 SIGSEGV 8 / SIGABRT 4; ORSORT m3 9/3,
*  m4 6/6; ORVISUAL m3 SIGSEGV 2 / SIGABRT 5 / COMPLETED 5, m4 SIGABRT 9 /
*  COMPLETED 3.  At this minimum size it is 6/6 crashes, alternating 139
*  and 134.  A SINGLE-RUN BOARD ROW ON THIS FAMILY IS AN ARBITRARY DRAW,
*  not a verdict -- do not bisect against one run.
*  ⭐ THE m4 BINARY FLAPS TOO, so the nondeterminism lives in the RUNTIME
*  (out/libscrip_rt.so), not in compilation: the same emitted binary run
*  twice gives different signals.
*  ⛔ AND SHRINKING PROVES IT IS NOT THE ALTERNATION: ',A,B' ',AB,AC' and
*  ',ABLE,ACTOR' all crash exactly as ',A' does, so the defect is reached by
*  OR's machinery on ONE alternative and needs no alternation at all.
*  On the runs where the full ORVISUAL driver DOES complete, OR() does not
*  return a wrong string -- it FAILS, so the OUTPUT statement assigns
*  nothing and the line is absent entirely.
*  OR.sno and BALREV.sno are copied in beside this file so the probe stands
*  alone in its own directory (the BLANKS.sno + DIFF.sno precedent).
-INCLUDE "OR.sno"
        P  =  OR(',A')
        OUTPUT  =  'built'
END
*----------------------------------------------------- 21 gim_real_literal_parse
*  gim_real_literal_parse - PARSE ERROR.  A real literal written with a
*  TRAILING DOT and no fractional digits, 25., is rejected by SCRIP's SNOBOL4
*  parser, so no code is generated at all.  Distilled from DAY.sno line 9,
*  CENT_ = (25. * YEAR_4) - 1.
        X  =  (25. * 3) - 1
        OUTPUT  =  X
END
*---------------------------------------- 22 gim_seq_code_loop_in_function XFAIL
*  seq_code_loop_in_function - distilled from gimpel SEQ_driver (batch C);
*  the same crash takes AI_driver and AOPA_driver, which both go through SEQ.
*  A DEFINE'd function that (a) reaches its loop variable INDIRECTLY through
*  a name argument, (b) drives a CODE()-compiled statement with an indirect
*  goto :<ARG_S>, and (c) returns after that loop finally fails, runs the
*  loop body correctly -- a, b, c below -- and then SEGFAULTS on the way out.
*  Oracle (sbl -b) prints a, b, c, then "K = 4".  SCRIP prints a, b, c and
*  dies with SIGSEGV in BOTH m3 and m4.
*  BOTH INGREDIENTS ARE NEEDED, and each half is correct on its own:
*    - the CODE loop with :<C> at top level, exiting on failure, is right
*      (see the L1/L2 loop below, which prints "exited with K = 4");
*    - a function that writes and reads its caller's variable through
*      $ARG_NAME and then FRETURNs is right (see F1 below).
*  Only the two together crash, so this is not "CODE is unimplemented" --
*  CODE, :<VAR> and indirect name arguments each work.
        DEFINE('S1(ARG_S,ARG_NAME)')            :(S1_END)
S1      $ARG_NAME  =  0
        ARG_S  =  CODE(ARG_S ' :S(S1_1)F(S1_2)')        :F(ERROR)
S1_1    $ARG_NAME  =  $ARG_NAME + 1             :<ARG_S>
S1_2    EQ($ARG_NAME,1)                         :S(FRETURN)F(RETURN)
S1_END
        DEFINE('F1(ARG_NAME)')                  :(F1_END)
F1      $ARG_NAME  =  0
        $ARG_NAME  =  $ARG_NAME + 1
        EQ($ARG_NAME,1)                         :S(FRETURN)F(RETURN)
F1_END
        A  =  ARRAY(3)
        A<1>  =  'a'
        A<2>  =  'b'
        A<3>  =  'c'
        C  =  CODE(' OUTPUT = A<J> :S(L1)F(L2)')
        J  =  0
L1      J  =  J + 1                             :<C>
L2      OUTPUT  =  'sibling CODE loop exited with J = ' J
        F1(.M)                                  :F(SIB2)
        OUTPUT  =  'sibling function returned, M = ' M    :(WITNESS)
SIB2    OUTPUT  =  'sibling function freturned, M = ' M
WITNESS S1(' OUTPUT = A<K> ', .K)
        OUTPUT  =  'witness returned, K = ' K
END
*------------------------------------------- 23 gim_span_self_rebind_wrong XFAIL
*  gim_span_self_rebind_wrong - SILENT WRONG ANSWER, 5 lines, no function.
*  A variable rebound to a PATTERN BUILT OVER ITS OWN FORMER VALUE (X = SPAN(X))
*  is inert as a pattern in SCRIP: the replacement removes nothing and the
*  subject comes back unchanged.  Oracle removes the first run of B/D/F.
*  This is the ROOT of the s183 BLANKS silent wrong answer -- BLANKS strips
*  blanks by calling DIFF(S,' '), and DIFF.sno is exactly this shape
*  (S2 = SPAN(S2) then DIFF S2 = ).  The passing control is `P = SPAN(X)`
*  into a DIFFERENT variable, which SCRIP gets right.
        S  =  'ABCDEF'
        X  =  'BDF'
        X  =  SPAN(X)
        S  X  =
        OUTPUT  =  S
END
