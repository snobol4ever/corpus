*-------------------------------------------------------------------- 1 un_never
        UNLOAD('NEVERDEF')                      :S(A)F(B)
A       OUTPUT = 'never-defined: SUCCEEDED'     :(C)
B       OUTPUT = 'never-defined: FAILED'
C       DEFINE('MYFN(X)')
        UNLOAD('MYFN')
        UNLOAD('MYFN')                          :S(D)F(E)
D       OUTPUT = 'second unload: SUCCEEDED'     :(END)
E       OUTPUT = 'second unload: FAILED'        :(END)
MYFN    MYFN = X                                :(RETURN)
END
 DEFINE('MYFN(X)'); UNLOAD('MYFN') :S(YES)F(NO);YES OUTPUT = 'unload SUCCEEDED' :(NEXT);NO OUTPUT = 'unload FAILED';NEXT OUTPUT = 'ret=[' UNLOAD('MYFN') ']' :(END);MYFN MYFN = X :(RETURN);END;* un_ret
 DEFINE('MYFN(X)'); MYFN = 'a value in the variable'; UNLOAD('MYFN'); OUTPUT = 'var after unload = [' MYFN ']' :(END);MYFN MYFN = X :(RETURN);END;* un_var_survives
