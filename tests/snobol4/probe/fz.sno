 S = 'aaabbbccc'; S ? SPAN('a') FENCE SPAN('b') SPAN('c') :F(NO); OUTPUT = 'MATCH' :(END);NO OUTPUT = 'FAIL';END;* fz1_span_fence_span
*-------------------------------------------------------------- 2 fz2_cut_family
*	SPITBOL manual p.125-126 -- bare FENCE cut semantics
	'1AB+' ? ANY('AB') FENCE '+'	:S(A1)F(A0)
A1	OUTPUT = 'A-MATCH'	:(B)
A0	OUTPUT = 'A-FAIL'
B	'1AB+' ? ANY('AB') '+'	:S(B1)F(B0)
B1	OUTPUT = 'B-MATCH'	:(C)
B0	OUTPUT = 'B-FAIL'
C	'ABC' ? FENCE 'B'	:S(C1)F(C0)
C1	OUTPUT = 'C-MATCH'	:(D)
C0	OUTPUT = 'C-FAIL'
D	'aaabbb' ? SPAN('a') FENCE SPAN('z')	:S(D1)F(D0)
D1	OUTPUT = 'D-MATCH'	:(E)
D0	OUTPUT = 'D-FAIL'
E	'aaabbbccc' ? SPAN('a') FENCE SPAN('b') FENCE SPAN('c')	:S(E1)F(E0)
E1	OUTPUT = 'E-MATCH'	:(F)
E0	OUTPUT = 'E-FAIL'
F	'aaabbbccc' ? SPAN('a') FENCE SPAN('b') SPAN('z')	:S(F1)F(F0)
F1	OUTPUT = 'F-MATCH'	:(END)
F0	OUTPUT = 'F-FAIL'
END
*---------------------------------------------------- 3 fz3_capture_across_fence
*	FZ-2: what the cut may release is the CONTIGUOUS backtrack-only frontier and nothing under it.
*	A: capture closed BEFORE the fence -- the SPAN cell above the SAVE is dead and bills 16; the
*	   SAVE cursor under it is live and bounds the walk (it is excluded BY NAME, never released).
*	B: bare leaf before the fence, capture after it -- the leaf is releasable, bills 16.
*	C: two fences -- each bills only the leaf carved since the previous cut; a FENCE0 stops the walk.
*	D: the capture GROUP wraps the fence, so its COND reads the SAVE cursor back AFTER the cut --
*	   the release must not touch it.
	S = 'aaabbbccc'
	S ? SPAN('a') . X FENCE SPAN('b') . Y	:F(BAD)
	OUTPUT = 'A=' X '/' Y
	S ? SPAN('a') FENCE SPAN('b') . Z	:F(BAD)
	OUTPUT = 'B=' Z
	S ? SPAN('a') . P FENCE SPAN('b') FENCE SPAN('c') . Q	:F(BAD)
	OUTPUT = 'C=' P '/' Q
	S ? (SPAN('a') FENCE SPAN('b')) . W	:F(BAD)
	OUTPUT = 'D=' W	:(END)
BAD	OUTPUT = 'UNEXPECTED-FAIL'
END
*----------------------------------------------------- 4 fz4_group_capture_chain
*	FZ-3: a capture GROUP that WRAPS the cut, plus a capture to the RIGHT of the group.
*	Both readers are staged [rsp+off] cells that the release moves; the predecessor statement is
*	what puts the group COND far enough down the spine for a stale offset to be visible.
	S = 'aaabbbccc'
	S ? SPAN('a') . X FENCE SPAN('b') . Y	:F(BAD)
	OUTPUT = 'A=' X '/' Y
	S ? (SPAN('a') FENCE SPAN('b') . M) . W SPAN('c') . V	:F(BAD)
	OUTPUT = 'C=' W '/' M '/' V	:(END)
BAD	OUTPUT = 'UNEXPECTED-FAIL'
END
*------------------------------------------------------ 5 fz5_two_cuts_one_group
*	FZ-3: TWO cuts inside ONE captured group -- the group COND reads its SAVE cursor back across
*	both releases, so the depth model must compose them, not just the last one.
	S = 'aaabbbccc'
	S ? SPAN('a') . X FENCE SPAN('b') . Y	:F(BAD)
	OUTPUT = 'A=' X '/' Y
	S ? (SPAN('a') FENCE SPAN('b') FENCE SPAN('c')) . W	:F(BAD)
	OUTPUT = 'D=' W	:(END)
BAD	OUTPUT = 'UNEXPECTED-FAIL'
END
*-------------------------------------------------------- 6 fz6_cut_on_fail_path
*	FZ-3: a fenced group that FAILS, then one that succeeds.  The failing attempt unwinds through
*	the cut box beta; the succeeding one then reads its SAVE cursor across a live release.
	S = 'aaabbbccc'
	S ? SPAN('a') . X FENCE SPAN('b') . Y	:F(BAD)
	OUTPUT = 'A=' X '/' Y
	S ? (SPAN('a') FENCE SPAN('z')) . W	:S(BAD)
	OUTPUT = 'E=fail-ok/' W
	S ? (SPAN('a') FENCE SPAN('b')) . W	:F(BAD)
	OUTPUT = 'F=' W	:(END)
BAD	OUTPUT = 'UNEXPECTED'
END
*------------------------------------------------------ 7 fz7_replace_across_cut
*	FZ-3: the capture group wraps the cut inside a REPLACEMENT statement, so MATCH_REPLACE reads
*	the subject and the group COND reads its SAVE cursor on the same spine the cut shortened.
	S = 'aaabbbccc'
	S ? SPAN('a') . X FENCE SPAN('b') . Y	:F(BAD)
	OUTPUT = 'A=' X '/' Y
	T = 'aaabbbccc'
	T ? (SPAN('a') FENCE SPAN('b')) . W = 'Z'	:F(BAD)
	OUTPUT = 'R=' T '/' W	:(END)
BAD	OUTPUT = 'UNEXPECTED-FAIL'
END
*--------------------------------------------------------- 8 fz8_arbno_after_cut
*	FZ-3: an ARBNO carrying its own instance record sits to the RIGHT of the cut -- the release
*	must leave the arbno record addressable at its post-release offset.  ARBNO matches null first
*	(SPITBOL Ch.18), so V is the empty string; the witness is the addressing, not the repetition.
	S = 'aaabbbccc'
	S ? SPAN('a') . X FENCE SPAN('b') . Y	:F(BAD)
	OUTPUT = 'A=' X '/' Y
	S ? (SPAN('a') FENCE SPAN('b')) . W ARBNO('c') . V	:F(BAD)
	OUTPUT = 'G=' W '/' V	:(END)
BAD	OUTPUT = 'UNEXPECTED-FAIL'
END
