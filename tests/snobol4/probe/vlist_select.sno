 x =; OUTPUT = 'a=' (IDENT(x) 0, 5); OUTPUT = 'b=' (LT(1,2) 7, 9);END;* c01_control_first_arm_succeeds
 DATA('list(n,a)'); x = list(0, ARRAY('0:3')); a(x)[0] = 5; OUTPUT = 'v=' a(x)[0]; OUTPUT = 'p=' PROTOTYPE(a(x));END;* c02_control_no_select
 x = 'nonnull'; OUTPUT = 'a=[' (IDENT(x) 0, 5) ']'; y =; OUTPUT = 'b=[' (IDENT(y) 0, 5) ']'; OUTPUT = 'c=[' (IDENT(x) 0, 3 * 2 - 1) ']';END;* v01_select_min
 x = 'nn'; z = (IDENT(x) 0, 5); OUTPUT = 'z=' z; OUTPUT = 'direct=' (IDENT(x) 0, 5); w = (LT(1,0) 7, 9); OUTPUT = 'w=' w; v = (LT(1,2) 7, 9); OUTPUT = 'v=' v;END;* v02_select_concat_and_assign
