        SUBJ = '(ab)(c)'
        I = '<unset>'
        O = '<unset>'
        SUBJ ? POS(0) ARBNO(('(' ARBNO(NOTANY(')') . I) ')') . O) RPOS(0) :F(NO)
        OUTPUT = '=S'                                   :(EN)
NO      OUTPUT = '=F'
EN      OUTPUT = 'I=' I
        OUTPUT = 'O=' O
END
