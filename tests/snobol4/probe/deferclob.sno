*------------------------------------------------------ 1 deferclob_stmt_alt_red
        nl = CHAR(10)
        Leaf1 = '*' BREAK(nl)
        Leaf2 = '-' BREAK(nl)
        Label = BREAK(' ' nl)
        epsilon = ''
        White = SPAN(' ') | epsilon
        Expr = SPAN('0123456789')
        Stmt = *Label (*White *Expr | epsilon)
        Command = FENCE(*Leaf1 nl | *Leaf2 nl | *Stmt nl)
        Src = 'START' nl
        Src ? POS(0) *Command RPOS(0)                      :S(OK)F(NO)
OK      OUTPUT = 'match'                                   :(FIN)
NO      OUTPUT = 'nomatch'
FIN
END
*----------------------------------------------- 2 deferclob_stmt_standalone_grn
        nl = CHAR(10)
        Label = BREAK(' ' nl)
        epsilon = ''
        White = SPAN(' ') | epsilon
        Expr = SPAN('0123456789')
        Stmt = *Label (*White *Expr | epsilon)
        Src = 'START' nl
        Src ? POS(0) *Stmt nl RPOS(0)                       :S(OK)F(NO)
OK      OUTPUT = 'match'                                    :(FIN)
NO      OUTPUT = 'nomatch'
FIN
END
