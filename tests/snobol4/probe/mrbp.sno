*----------------------------------------------------------- 1 cs0_nul_producers
        N = CHAR(0)
        A = 'AB' N 'CD'
        OUTPUT = 'concat  SIZE=' SIZE(A)
        A POS(0) LEN(5) RPOS(0)         :F(X1)
        OUTPUT = 'concat  LEN5 MATCH'   :(P2)
X1      OUTPUT = 'concat  LEN5 NOMATCH'
P2      B = SUBSTR(A,1,5)
        OUTPUT = 'substr  SIZE=' SIZE(B)
        B POS(0) LEN(5) RPOS(0)         :F(X2)
        OUTPUT = 'substr  LEN5 MATCH'   :(P3)
X2      OUTPUT = 'substr  LEN5 NOMATCH'
P3      C = REVERSE(A)
        OUTPUT = 'reverse SIZE=' SIZE(C)
        C POS(0) LEN(5) RPOS(0)         :F(X3)
        OUTPUT = 'reverse LEN5 MATCH'   :(P4)
X3      OUTPUT = 'reverse LEN5 NOMATCH'
P4      D = A
        OUTPUT = 'copy    SIZE=' SIZE(D)
        D POS(0) LEN(5) RPOS(0)         :F(X4)
        OUTPUT = 'copy    LEN5 MATCH'   :(Z)
X4      OUTPUT = 'copy    LEN5 NOMATCH'
Z
END
*------------------------------------------------------------- 2 cs0_nul_subject
        S = 'AB' CHAR(0) 'CD'
        OUTPUT = 'SIZE=' SIZE(S)
        S POS(0) LEN(5) RPOS(0)                 :F(F5)
        OUTPUT = 'LEN5 MATCH'                   :(T2)
F5      OUTPUT = 'LEN5 NOMATCH'
T2      S POS(0) LEN(2) RPOS(0)                 :F(F2)
        OUTPUT = 'LEN2 MATCH'                   :(Z)
F2      OUTPUT = 'LEN2 NOMATCH'
Z
END
 Q = LEN(3) $ W; S = 'ABCDEF'; S ? Q . X :S(Y)F(N);Y OUTPUT = 'MATCH' :(D);N OUTPUT = 'NOMATCH';D OUTPUT = 'X=[' X ']'; OUTPUT = 'W=[' W ']';END;* mrbp_result_capture
 Q = LEN(3); S = 'ABCDEF'; V = (S ? Q); OUTPUT = 'V=[' V ']';END;* mrbp_result_control
 Q = LEN(3) $ W; S = 'ABCDEF'; V = (S ? Q); OUTPUT = 'V=[' V ']'; OUTPUT = 'W=[' W ']';END;* mrbp_result_value
 N = 2; S = 'ABCDEF'; S ? LEN(*N) . FRONT REM . REST :F(BAD); OUTPUT = FRONT; OUTPUT = REST; OUTPUT = 'ok' :(END0);BAD OUTPUT = 'BAD-match-failed';END0;END;* mrbp_shallow_len
