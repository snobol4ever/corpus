*------------------------------------------------------------- 1 ev_beauty_shape
        DEFINE('Reduce(t,n)')                     :(REND)
Reduce  Reduce = 'R<' t ',' n '>'                 :(RETURN)
REND
        epsilon = LEN(0)
        t = 'TT'
        n = 'NN'
        reduce = EVAL('epsilon . *Reduce("x", "y")')
        OUTPUT = 'DT=' DATATYPE(reduce)
        'abc' ? reduce
        OUTPUT = 'OK'
END
 C = CODE(" OUTPUT = 'in fragment' :(DONE)"); OUTPUT = 'before' :<C>;DONE OUTPUT = 'after';END;* ev_code_back_ctl
 N = 5; E = *(1 + N); OUTPUT = DATATYPE(E); OUTPUT = 'built';END;* ev_defer_int_lead
 E = *(1); OUTPUT = DATATYPE(E);END;* ev_defer_int_lit
 E = *('AB'); OUTPUT = DATATYPE(E);END;* ev_defer_str_lit
 DEFINE('R(t,n)'); DEFINE('Q(a,b)'); epsilon = ''; p = R('a','b'); OUTPUT = DATATYPE(p) :(END);R R = EVAL("epsilon . *Q(" t ", " n ")") :(RETURN);Q Q = 1 :(RETURN);END;* ev_fn_beauty_shape
 DEFINE('F(x)'); OUTPUT = F('ignored') :(END);F F = EVAL('1 + 2') :(RETURN);END;* ev_fn_literal
 DEFINE('H()'); OUTPUT = H() :(END);H H = 42 :(RETURN);END;* ev_fn_noeval
 DEFINE('F(x)'); OUTPUT = F('ignored') :(END);F F = EVAL('10 + 20') :(RETURN);END;* ev_fn_sum_10_20
 DEFINE('F(x)'); OUTPUT = F('ignored') :(END);F F = EVAL('1 + 2') :(RETURN);END;* ev_fn_sum_1_2
 DEFINE('F(x)'); OUTPUT = F('ignored') :(END);F F = EVAL('1 + 5') :(RETURN);END;* ev_fn_sum_1_5
 DEFINE('G()'); s = '1 + 2'; OUTPUT = G() :(END);G G = EVAL(s) :(RETURN);END;* ev_fn_var
 OUTPUT = EVAL('1 + 2');END;* ev_min_arith
 DEFINE('F(x)'); OUTPUT = F('ignored') :(END);F F = EVAL('1 + 2') :(RETURN);END;* ev_pad_alias_0
 DEFINE('F(x)'); PADV0 = 0; OUTPUT = F('ignored') :(END);F F = EVAL('1 + 2') :(RETURN);END;* ev_pad_alias_1
 OUTPUT = DATATYPE(EVAL('LEN(0)'));END;* ev_pat_builtin
 e = LEN(0); OUTPUT = DATATYPE(EVAL('e . OUT'));END;* ev_pat_capture
 DEFINE('F()') :(FE);F F = 'v' :(RETURN);FE; e = LEN(0); OUTPUT = DATATYPE(EVAL('e . *F()'));END;* ev_pat_defer_call
 e = LEN(0); OUTPUT = DATATYPE(EVAL('e'));END;* ev_pat_var
