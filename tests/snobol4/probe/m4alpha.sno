*---------------------------------------------------------- 5 m4a_dot_defer_expr
        DEFINE("Zero()")
        DEFINE("One(a)")
        DEFINE("Two(a,b)")                               :(CE)
Zero           n = n + 1
        Zero = .dummy                             :(NRETURN)
One            n = n + a
        One = .dummy                              :(NRETURN)
Two            n = n + a + b
        Two = .dummy                              :(NRETURN)
CE
        subj = "A"
        p = LEN(1) . *(n = n + 1)
        OUTPUT = "before"
        subj p                                           :F(F)
        OUTPUT = "after n=" n " dummy=[" dummy "]"       :(T)
F       OUTPUT = "nomatch n=" n
T
END
*----------------------------------------------------------- 6 m4a_dot_defer_var
        DEFINE("Zero()")
        DEFINE("One(a)")
        DEFINE("Two(a,b)")                               :(CE)
Zero           n = n + 1
        Zero = .dummy                             :(NRETURN)
One            n = n + a
        One = .dummy                              :(NRETURN)
Two            n = n + a + b
        Two = .dummy                              :(NRETURN)
CE
        subj = "A"
        p = LEN(1) . *n
        OUTPUT = "before"
        subj p                                           :F(F)
        OUTPUT = "after n=" n " dummy=[" dummy "]"       :(T)
F       OUTPUT = "nomatch n=" n
T
END
*------------------------------------------------ 7 m4a_manual_p136_nreturn_push
        DEFINE('PUSH(X)')
        STK = TABLE()                                     :(PUSH_END)
PUSH    STK[0] = STK[0] + 1
        PUSH = .STK[STK[0]]
        $PUSH = X                                         :(NRETURN)
PUSH_END
        'ABCDE' ? LEN(2) . *PUSH() 'D' LEN(1) . *PUSH()   :F(NOMATCH)
        OUTPUT = 'n=' STK[0] ' [1]=' STK[1] ' [2]=' STK[2] :(DONE)
NOMATCH OUTPUT = 'nomatch'
DONE
END
