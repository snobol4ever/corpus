*------------------------------------------------------- 1 m4a_defer_call_no_dot
        DEFINE("Zero()")
        DEFINE("One(a)")
        DEFINE("Two(a,b)")                               :(CE)
Zero           n = n + 1
        Zero = .dummy                             :(NRETURN)
One            n = n + a
        One = .dummy                              :(NRETURN)
Two            n = n + a + b
        Two = .dummy                              :(NRETURN)
CE
        subj = "A"
        p = LEN(1) *Zero()
        OUTPUT = "before"
        subj p                                           :F(F)
        OUTPUT = "after n=" n " dummy=[" dummy "]"       :(T)
F       OUTPUT = "nomatch n=" n
T
END
