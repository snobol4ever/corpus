        tab = CHAR(9)
        White = ( SPAN(' ' tab)
+                   FENCE(nl ('+' | '.') FENCE(SPAN(' ' tab) | epsilon) | epsilon)
+                 | nl ('+' | '.') FENCE(SPAN(' ' tab) | epsilon)
+                 )
        Gray = *White | epsilon
        Stmt3 = BREAK(' ' tab nl ';') FENCE(*Gray ':' | epsilon) *Gray
        Src = 'START' nl
        Src POS(0) *Stmt3 nl RPOS(0)                    :F(NO)
        OUTPUT = 'match'                                :(DONE)
NO        OUTPUT = 'nomatch'
DONE
END
*--------------------------------------------------------------- 5 fw_min_inline
        $('Z' 'Z') = 1
        nl = CHAR(10)
        tab = CHAR(9)
        Stmt3 = BREAK(' ' tab nl ';') FENCE((( SPAN(' ' tab) FENCE(nl '+' | epsilon) | nl '+' ) | epsilon) ':' | epsilon) (( SPAN(' ' tab) FENCE(nl '+' | epsilon) | nl '+' ) | epsilon)
        Src = 'START' nl
        Src POS(0) Stmt3 nl RPOS(0)                     :F(NO)
        OUTPUT = 'match'                                :(DONE)
NO        OUTPUT = 'nomatch'
DONE
END
