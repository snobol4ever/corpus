 DEFINE('G(x)'); OUTPUT = G('ignored') :(DONE);G G = 7 :(RETURN);DONE;END;* mon_fn_plain
*------------------------------------------------------------- 2 nr_defer_concat
        DEFINE('PC()')
        DEFINE('nP()')
        DEFINE('nPop()') :(MAIN)
PC      PC = .dummy                             :(NRETURN)
nP      nP = epsilon . *PC()                    :(RETURN)
nPop    nPop = epsilon . *PC()                  :(RETURN)
MAIN    epsilon = LEN(0)
        XList = 'x'
        E = nP() *XList nPop()
        'x' ? E                                 :F(ERR)
        OUTPUT = 'matched'                      :(END)
ERR     OUTPUT = 'no match'
END
 DEFINE('PC()'); DEFINE('nP()') :(MAIN);PC PC = .dummy :(NRETURN);nP nP = LEN(1) . *PC() :(RETURN);MAIN P = nP(); 'abc' ? P; OUTPUT = 'dummy=' dummy;END;* nr_defer_min
*-------------------------------------------------------------- 4 nr_defer_recur
        DEFINE('PC()')
        DEFINE('nP()') :(MAIN)
PC      $'#N' = 1
        PC = .dummy                             :(NRETURN)
nP      nP = epsilon . *PC()                    :(RETURN)
MAIN    epsilon = LEN(0)
        E1 = 'y'
        E = nP() (*E1 | 'x')
        Src = 'x'
        Src POS(0) *E RPOS(0)                   :F(ERR)
        OUTPUT = 'matched'                      :(END)
ERR     OUTPUT = 'Parse Error'
END
*------------------------------------------------------ 5 nr_eval_direct_CONTROL
        DEFINE('PC()')
        DEFINE('nP()')
        DEFINE('Reduce(t,n)')
        DEFINE('red(t,n)')
        OPSYN('&', 'red', 2) :(MAIN)
PC      PC = .dummy                                       :(NRETURN)
nP      nP = epsilon . *PC()                              :(RETURN)
Reduce  Reduce = .dummy                                   :(NRETURN)
red     red = EVAL("epsilon . *Reduce(" t ", " n ")")     :(RETURN)
MAIN    epsilon = LEN(0)
        XList = 'x'
        E = nP() *XList red("'E'", "1")
        'x' ? E                                           :F(ERR)
        OUTPUT = 'matched'                                :(END)
ERR     OUTPUT = 'no match'
END
*--------------------------------------------------------- 6 nr_eval_opsyn_CRASH
        DEFINE('PC()')
        DEFINE('nP()')
        DEFINE('Reduce(t,n)')
        DEFINE('red(t,n)')
        OPSYN('&', 'red', 2) :(MAIN)
PC      PC = .dummy                                       :(NRETURN)
nP      nP = epsilon . *PC()                              :(RETURN)
Reduce  Reduce = .dummy                                   :(NRETURN)
red     red = EVAL("epsilon . *Reduce(" t ", " n ")")     :(RETURN)
MAIN    epsilon = LEN(0)
        XList = 'x'
        E = nP() *XList ("'E'" & '1')
        'x' ? E                                           :F(ERR)
        OUTPUT = 'matched'                                :(END)
ERR     OUTPUT = 'no match'
END
 DEFINE('F()') :(FEND);F F = .dummy :(NRETURN);FEND; 'ABCDE' ? LEN(2) . *F() :F(BAD); OUTPUT = 'dummy=' dummy :(END);BAD OUTPUT = 'NOMATCH';END;* nret_cond_defer_call
 DEFINE('F()') :(FEND);F F = .dummy :(NRETURN);FEND; P = LEN(2) . *F(); 'ABCDE' ? P :F(BAD); OUTPUT = 'dummy=' dummy :(END);BAD OUTPUT = 'NOMATCH';END;* nret_cond_stored_blob
 'ABCDE' ? LEN(2) . x :F(C1); OUTPUT = 'C x=' x :(END);C1 OUTPUT = 'C NOMATCH';END;* nret_control_plain_capture
 DEFINE('F()') :(FEND);F F = .dummy :(NRETURN);FEND; 'ABCDE' ? LEN(3) $ *F() :F(D1); OUTPUT = 'D dummy=' dummy :(END);D1 OUTPUT = 'D NOMATCH';END;* nret_imm_defer_call
 DEFINE('F()') :(FEND);F F = .dummy :(NRETURN);FEND; F() = 43; OUTPUT = 'A dummy=' dummy;END;* nret_lvalue_plain
 DEFINE('G()') :(GEND);G G = .DUMMY :(RETURN);GEND; DUMMY = 'VAL'; RV = G(); OUTPUT = 'G_ret=[' RV ']'; OUTPUT = 'dt=' DATATYPE(RV);END;* nret_name_op_return
