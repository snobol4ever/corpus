 VOWEL = ANY('AEIOU'); PAT = VOWEL SPAN('BCDFGHJKLMNPQRSTVWXYZ'); 'AY' ? PAT . N; OUTPUT = N;END;* w_cap_ay
 VOWEL = ANY('AEIOU'); PAT = (VOWEL SPAN('BCDFGHJKLMNPQRSTVWXYZ')) . N; 'GRAY' ? PAT; OUTPUT = N;END;* w_cap_group
 'GRAY' ? ANY('AEIOU') SPAN('BCDFGHJKLMNPQRSTVWXYZ') . N; OUTPUT = N;END;* w_cap_inline
 VOWEL = ANY('AEIOU'); PAT = VOWEL SPAN('BCDFGHJKLMNPQRSTVWXYZ'); 'BCD' ? PAT . N :F(NOPE); OUTPUT = 'MATCHED:[' N ']' :(END);NOPE OUTPUT = 'FAILED';END;* w_cap_novowel
 VOWEL = ANY('AEIOU'); PAT = VOWEL SPAN('BCDFGHJKLMNPQRSTVWXYZ'); 'GRAY' ? PAT . N; OUTPUT = N;END;* w_cap_stored
 VOWEL = ANY('AEIOU'); PAT = VOWEL SPAN('BCDFGHJKLMNPQRSTVWXYZ'); 'XXAY' ? PAT . N; OUTPUT = N;END;* w_cap_xxay
