 S = 'abcd+efg'; S ANY('+') SPAN('ef') 'g' = '*' :S(Y)F(N);Y OUTPUT = 'S=[' S ']' :(D);N OUTPUT = 'NOMATCH';D OUTPUT = 'DONE';END;* l3_spl_VACUOUS_terminal_trap
 S = 'XXXXXXXXXX+efgYYYY'; S ANY('+') ARB 'g' = '*' :S(Y)F(N);Y OUTPUT = 'S=[' S ']' :(D);N OUTPUT = 'NOMATCH';D OUTPUT = 'DONE';END;* l3_spl_arb_nonterm
 S = 'XXXXXXXXXX+efgYYYY'; S ANY('+') BREAK('g') 'g' = '*' :S(Y)F(N);Y OUTPUT = 'S=[' S ']' :(D);N OUTPUT = 'NOMATCH';D OUTPUT = 'DONE';END;* l3_spl_break_nonterm
 S = 'XXXXXXXXXX+efgYYYY'; S ANY('+') LEN(2) 'g' = '*' :S(Y)F(N);Y OUTPUT = 'S=[' S ']' :(D);N OUTPUT = 'NOMATCH';D OUTPUT = 'DONE';END;* l3_spl_len_nonterm
 S = 'abcdefghij'; S LEN(2) LEN(3) = '*' :S(Y)F(N);Y OUTPUT = 'S=[' S ']' :(D);N OUTPUT = 'NOMATCH';D OUTPUT = 'DONE';END;* l3_spl_len_pure
 S = 'abcdefghij'; S 'cd' LEN(3) = '*' :S(Y)F(N);Y OUTPUT = 'S=[' S ']' :(D);N OUTPUT = 'NOMATCH';D OUTPUT = 'DONE';END;* l3_spl_lit_len
 S = 'ABCDEFGHIJ'; S POS(4) LEN(1) = '*' :S(Y)F(N);Y OUTPUT = 'S=[' S ']' :(D);N OUTPUT = 'NOMATCH';D OUTPUT = 'DONE';END;* l3_spl_pos
 S = 'XXXXXXXXXX+efgYYY'; S ANY('+') REM = '*' :S(Y)F(N);Y OUTPUT = 'S=[' S ']' :(D);N OUTPUT = 'NOMATCH';D OUTPUT = 'DONE';END;* l3_spl_rem_nonterm
 S = 'XXXXXXXXXX+efgYYYY'; S LEN(2) RTAB(4) = '*' :S(Y)F(N);Y OUTPUT = 'S=[' S ']' :(D);N OUTPUT = 'NOMATCH';D OUTPUT = 'DONE';END;* l3_spl_rtab_nonterm
 A = '<'; B = '>'; S = 'XXXXXXXXXX+efgYYYY'; S ANY('+') SPAN('ef') 'g' = A '-' B :S(Y)F(N);Y OUTPUT = 'S=[' S ']' :(D);N OUTPUT = 'NOMATCH';D OUTPUT = 'DONE';END;* l3_spl_span_concat
 S = 'XXXXXXXXXX+efgYYYY'; S ANY('+') SPAN('ef') 'g' = '*' :S(Y)F(N);Y OUTPUT = 'S=[' S ']' :(D);N OUTPUT = 'NOMATCH';D OUTPUT = 'DONE';END;* l3_spl_span_nonterm
 S = 'XXXXXXXXXX+eeefffgYYYY'; S ANY('+') SPAN('e') SPAN('f') 'g' = '*' :S(Y)F(N);Y OUTPUT = 'S=[' S ']' :(D);N OUTPUT = 'NOMATCH';D OUTPUT = 'DONE';END;* l3_spl_span_span_double
 S = 'ABCDEFGHIJ'; S LEN(3) TAB(6) LEN(1) = '*' :S(Y)F(N);Y OUTPUT = 'S=[' S ']' :(D);N OUTPUT = 'NOMATCH';D OUTPUT = 'DONE';END;* l3_spl_tab_linear3
 S = 'XXXXXXXXXX+efgYYYY'; S LEN(2) TAB(14) = '*' :S(Y)F(N);Y OUTPUT = 'S=[' S ']' :(D);N OUTPUT = 'NOMATCH';D OUTPUT = 'DONE';END;* l3_spl_tab_nonterm
