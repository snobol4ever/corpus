*------------------------------------------------------------ 1 guard_conflation
        DEFINE('g(n)')                          :(g_end)
g                                               :(FRETURN)
g_end
        NE(1, 1)                                :f(a_f)
        OUTPUT = 'A fellthrough'                :(b)
a_f     OUTPUT = 'A took :f'
b       NE(g(1), 1)                             :f(b_f)
        OUTPUT = 'B fellthrough'                :(END)
b_f     OUTPUT = 'B took :f'
END
