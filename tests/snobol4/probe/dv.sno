 P = 'AB'; S = 'ABABC'; S ? POS(0) ARBNO(P) $ X 'C' RPOS(0) :F(NO); OUTPUT = 'M ' X :(EN);NO OUTPUT = 'F';EN;END;* dv_arbno_capture
 P = 'AB'; S = 'ABABABC'; S ? POS(0) ARBNO(*P) 'C' RPOS(0) :F(NO); OUTPUT = 'M' :(EN);NO OUTPUT = 'F';EN;END;* dv_arbno_defer
 P = 'AB'; S = 'ABABC'; S ? POS(0) ARBNO(*P) $ X 'C' RPOS(0) :F(NO); OUTPUT = 'M ' X :(EN);NO OUTPUT = 'F';EN;END;* dv_arbno_defer_cap
 E = 'b'; S = 'abc'; S ('z' | E) . X :S(OK)F(NO);OK OUTPUT = 'X=[' X ']' :(D);NO OUTPUT = 'NOMATCH';D;END;* dv_cap_defer_alt_var
*--------------------------------------------------- 5 dv_cap_defer_alt_var_span
        digits = '0123456789'
        epsilon = ''
        S = '1:1'
        S POS(0) (('+' | '-' | epsilon) SPAN(digits)) . iMin ':'	:S(OK)F(NO)
OK	OUTPUT = 'iMin=' iMin	:(D)
NO	OUTPUT = 'NOMATCH'
D
END
 E = 'b'; S = 'abc'; S (E) . X :S(OK)F(NO);OK OUTPUT = 'X=[' X ']' :(D);NO OUTPUT = 'NOMATCH';D;END;* dv_cap_defer_bare
*---------------------------------------------------- 7 dv_cap_defer_xdump_proto
        digits = '0123456789'
        epsilon = ''
        arr = ARRAY('1:1')
        arr[1] = 'alpha'
        objProto = PROTOTYPE(arr)
        OUTPUT = 'proto=[' objProto ']'
        objProto POS(0) (('+' | '-' | epsilon) SPAN(digits)) . iMin ':' (('+' | '-' | epsilon) SPAN(digits)) . iMax RPOS(0)	:S(OK)F(NO)
OK	OUTPUT = 'iMin=' iMin ' iMax=' iMax	:(D)
NO	OUTPUT = 'NOMATCH'
D
END
 P = 'BC'; S = 'ABCD'; S ? 'A' (*P) . X :F(NO); OUTPUT = 'M ' X :(EN);NO OUTPUT = 'F';EN;END;* dv_defer_cond
 P = 'BC'; S = 'ABCD'; S ? 'A' *P $ X :F(NO); OUTPUT = 'M ' X :(EN);NO OUTPUT = 'F';EN;END;* dv_defer_imm
 P = 'BC'; S = 'ABCDE'; S ? 'A' (*P $ X 'D') . Y :F(NO); OUTPUT = 'M ' X ' ' Y :(EN);NO OUTPUT = 'F';EN;END;* dv_defer_nested
 P = 'BC'; Q = 'EF'; S = 'ABCDEF'; S ? 'A' *P $ X 'D' *Q $ Y :F(NO); OUTPUT = 'M ' X ' ' Y :(EN);NO OUTPUT = 'F';EN;END;* dv_defer_two
 DEFINE('F()') :(GO);F F = 'BC' :(RETURN);GO S = 'ABCD'; S ? 'A' F() $ X :F(NO); OUTPUT = 'M ' X :(EN);NO OUTPUT = 'F';EN;END;* dv_value_imm
