 subject = "HELLO WORLD"; p = "HELLO" . *$("dummy"); subject p :S(ok)F(no);ok OUTPUT = "ok dummy=" dummy :(END);no OUTPUT = "failed";END;* dit_cond
 subject = "HELLO WORLD"; p = "HELLO" $ *$("dummy"); subject p :S(ok)F(no);ok OUTPUT = "ok dummy=" dummy :(END);no OUTPUT = "failed";END;* dit_imm
*------------------------------------------------------------ 3 dit_nreturn_twin
        subject = "HELLO WORLD"
        DEFINE("note()")	:(note_end)
note	note = .dummy	:(NRETURN)
note_end
        p = "HELLO" . *note()
        subject p	:S(ok)F(no)
ok	OUTPUT = "ok dummy=" dummy	:(END)
no	OUTPUT = "failed"
END
