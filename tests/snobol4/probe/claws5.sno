*--------------------------------------------------- 5 claws5_spine_drift_k5_red
        &TRIM   =   0
        src     =   'ab_A0 ab_A0 ab_A0 ab_A0 ab_A0 '
        p       =   POS(0) ARBNO((SPAN('0123456789') | SPAN('ab') SPAN('_A0')) SPAN(' ')) RPOS(0)
        src     ?   p  :F(error)
        OUTPUT  =   'matched bytes=' SIZE(src)  :(END)
