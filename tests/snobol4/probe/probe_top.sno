 X = 'Z'; 'AZB' ? 'A' $ X X :S(OK)F(NO);OK OUTPUT = 'S ' X :(END);NO OUTPUT = 'F ' X;END;* pb_snapshot_imm
 P = '12'; Q = 'A' P; R = Q Q Q; P = 'X'; Q = 'B'; 'A12A12A12' ? POS(0) R RPOS(0) :S(OK)F(NO);OK OUTPUT = 'S' :(END);NO OUTPUT = 'F';END;* pb_stitch_compose
 P = '123'; Q = 'A' *P 'Z'; P = 'XXX'; 'AXXXZ' ? Q :S(O1)F(N1);O1 OUTPUT = 'S1' :(T2);N1 OUTPUT = 'F1';T2 'A123Z' ? Q :S(O2)F(N2);O2 OUTPUT = 'S2' :(END);N2 OUTPUT = 'F2';END;* pb_stitch_defer
 P = '123'; Q = 'A' P 'Z'; P = 'XXX'; 'A123Z' ? Q :S(OK)F(NO);OK OUTPUT = 'S' :(END);NO OUTPUT = 'F';END;* pb_stitch_snapshot
*---------------------------------------------------------- 5 claws5_table_flat1
*  claws5_table_flat1 -- minimal witness, row table-flat-1level-segv (FINDING-2026-08-21-s199).
*  Flattens claws5's 3-level counts[number][word][tag] table build to ONE level, counts[word],
*  keeping the SAME grammar shape (FENCE/ARBNO + a deferred *token() callout) claws5 itself uses.
*  Self-contained: no -INCLUDE, no file I/O, one deterministic pass over an embedded literal line.
        &TRIM = 0
        DEFINE('token()')  :(token_end)
token   number = +number
        counts = IDENT(counts) TABLE()
        counts[word] = IDENT(counts[word]) 0
        counts[word] = counts[word] + 1
        token = .dummy  :(NRETURN)
token_end
        grammar = POS(0)
+                 ARBNO(
+                   FENCE(
+                     (SPAN('0123456789') . number) '_CRD :_PUN'
+                   | (NOTANY('_') BREAK('_')) . word
+                     '_'
+                     (ANY(&UCASE) SPAN('0123456789' &UCASE)) . tag . *token()
+                   )
+                   SPAN(' ' CHAR(10))
+                 )
+                 RPOS(0)
        text = '1_CRD dog_NN1 cat_NN2 dog_NN1' CHAR(10)
        text ? grammar                                  :F(bad)
        OUTPUT = 'dog=' counts['dog'] ' cat=' counts['cat']  :(done)
bad     OUTPUT = 'MATCH-FAILED'
done
END
*------------------------------------------------------------ 6 mv_arbno_callcap
-CASE 0
        DEFINE("p()")
        DEFINE("P()")	:(p_end)
p	p = .dummy	:(NRETURN)
P	P = epsilon . *p()	:(RETURN)
p_end
        epsilon =
        pat = ARBNO(P()) 'z'
        'x' ? pat	:F(FF)
        OUTPUT = 'S'	:(END)
FF	OUTPUT = 'F'
END
*-------------------------------------------------------------- 7 mv_valheld_cap
-CASE 0
        epsilon =
        pat = epsilon . v
        'x' ? pat 'z'	:F(FAILED)
        OUTPUT = 'S'	:(END)
FAILED	OUTPUT = 'F'
END
