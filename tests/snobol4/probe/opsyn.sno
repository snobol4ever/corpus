 DEFINE('R(t,n)'); OPSYN('&', 'R', 2); OUTPUT = R('a','b') :(END);R R = 'GOT-' t n :(RETURN);END;* a_reg_only;* a_reg_only
 DEFINE('R(t,n)'); OPSYN('&', 'R', 2); OUTPUT = 'a' & 'b' :(END);R R = 'CONST' :(RETURN);END;* b_noargs;* b_noargs
 DEFINE('R(t,n)'); OPSYN('&', 'R', 2); OUTPUT = 'a' & 'b' :(END);R OUTPUT = 'IN-BODY'; R = 'CONST' :(RETURN);END;* c_trace;* c_trace
 DEFINE('R(t,n)'); OUTPUT = R('a','b') :(END);R R = 'GOT-' t n :(RETURN);END;* ctl_call2;* ctl_call2
 DEFINE('U(s)'); OPSYN('!', 'U', 1); OUTPUT = !'x' :(END);U U = 'UN-' s :(RETURN);END;* d_unary;* d_unary
 DEFINE('R(t,n)'); OPSYN('&', 'R', 2); X = 'a' & 'b'; OUTPUT = X :(END);R R = 'CONST' :(RETURN);END;* e_bare;* e_bare
 DEFINE('R(t,n)'); OUTPUT = APPLY('R','a','b') :(END);R R = 'GOT-' t n :(RETURN);END;* f_apply;* f_apply
 DEFINE('cat(a,b)') :(ce);cat cat = a b :(RETURN);ce; OPSYN('foo', 'cat', 0); OUTPUT = foo('abc','def');END;* opsyn_alias_plain_function;* opsyn_alias_plain_function
 DEFINE('twice(x)') :(setup);twice twice = x + x :(RETURN);setup OPSYN('double', 'twice');main OUTPUT = APPLY('double', 21);END;* opsyn_apply_alias_sigsegv;* opsyn_apply_alias_sigsegv
 DEFINE('cat(a,b)') :(cat_end);cat cat = a b :(RETURN);cat_end; OPSYN('&', 'cat', 2); OUTPUT = 'abc' & 'def'; OUTPUT = 'x' & 5;END;* opsyn_bin_amp;* opsyn_bin_amp
 DEFINE('cat(a,b)') :(cat_end);cat cat = a b :(RETURN);cat_end; OPSYN('@', 'cat', 2); OUTPUT = 'abc' @ 'def'; OUTPUT = 'x' @ 5;END;* opsyn_bin_at;* opsyn_bin_at
 DEFINE('cat(a,b)') :(cat_end);cat cat = a b :(RETURN);cat_end; OPSYN('%', 'cat', 2); OUTPUT = 'abc' % 'def'; OUTPUT = 'x' % 5;END;* opsyn_bin_pct;* opsyn_bin_pct
 DEFINE('cat(a,b)') :(cat_end);cat cat = a b :(RETURN);cat_end; OPSYN('#', 'cat', 2); OUTPUT = 'abc' # 'def'; OUTPUT = 'x' # 5;END;* opsyn_bin_pound;* opsyn_bin_pound
 DEFINE('cat(a,b)') :(cat_end);cat cat = a b :(RETURN);cat_end; OPSYN('~', 'cat', 2); OUTPUT = 'abc' ~ 'def'; OUTPUT = 'x' ~ 5;END;* opsyn_bin_tilde;* opsyn_bin_tilde
*------------------------------------------------- 15 opsyn_builtin_target XFAIL
*  OPSYN'd operator whose target is a BUILT-IN (manual p.116 worked example: OPSYN('#','DIFFER',2)).
        OPSYN('#', 'DIFFER', 2)
        OUTPUT         =   IDENT(1 # 2, '') 'DIFFER-SUCCEEDS'
        1 # 1                                               :S(BAD)F(OK)
BAD     OUTPUT         =   'BAD: 1 # 1 succeeded'           :(FIN)
OK      OUTPUT         =   'OK: 1 # 1 failed'
FIN
END
 DEFINE('R(t)'); OUTPUT = DATATYPE(R('x')) :(END);R R = EVAL("LEN(1)") :(RETURN);END;* opsyn_control_nopsyn;* opsyn_control_nopsyn
 DEFINE('R(t,n)'); OPSYN('&', 'R', 2); OUTPUT = 1 & 2 :(END);R R = EVAL("1 + 2") :(RETURN);END;* opsyn_int;* opsyn_int
*-------------------------------------------------------- 18 opsyn_kind_selector
        &ERRLIMIT = 20
        OPSYN('STRLEN', 'SIZE', 1)              :F(B1)
        OUTPUT = 'fn-name i=1        accepted'  :(N1)
B1      OUTPUT = 'fn-name i=1        ' &ERRTYPE
N1      OPSYN('SUM', '+', 2)                    :F(B2)
        OUTPUT = 'fn-name i=2        accepted'  :(N2)
B2      OUTPUT = 'fn-name i=2        ' &ERRTYPE
N2      OPSYN('+', 'SIZE', 2)                   :F(B3)
        OUTPUT = 'used-op i=2        accepted'  :(N3)
B3      OUTPUT = 'used-op i=2        ' &ERRTYPE
N3      OPSYN('&', 'DIFFER', 2)                 :F(B4)
        OUTPUT = 'unused-bin & i=2   accepted'  :(N4)
B4      OUTPUT = 'unused-bin & i=2   ' &ERRTYPE
N4      OPSYN('!', 'SIZE', 1)                   :F(B5)
        OUTPUT = 'unused-un ! i=1    accepted'  :(N5)
B5      OUTPUT = 'unused-un ! i=1    ' &ERRTYPE
N5      OPSYN('@', 'SIZE', 3)                   :F(B6)
        OUTPUT = 'unused-bin @ i=3   accepted'  :(N6)
B6      OUTPUT = 'unused-bin @ i=3   ' &ERRTYPE
N6      OPSYN('&', 'SIZE', 1)                   :F(B7)
        OUTPUT = 'bin-op as i=1      accepted'  :(N7)
B7      OUTPUT = 'bin-op as i=1      ' &ERRTYPE
N7      OPSYN('~', 'SIZE', 'zz')                :F(B8)
        OUTPUT = 'i not integer      accepted'  :(N8)
B8      OUTPUT = 'i not integer      ' &ERRTYPE
N8      OPSYN('~', 'SIZE', -1)                  :F(B9)
        OUTPUT = 'i negative         accepted'  :(N9)
B9      OUTPUT = 'i negative         ' &ERRTYPE
N9      OPSYN('~', 'SIZE', 16777216)            :F(B10)
        OUTPUT = 'i = 2**24          accepted'  :(N10)
B10     OUTPUT = 'i = 2**24          ' &ERRTYPE
N10     OPSYN('~', 'SIZE', 16777217)            :F(B11)
        OUTPUT = 'i = 2**24 + 1      accepted'  :(N11)
B11     OUTPUT = 'i = 2**24 + 1      ' &ERRTYPE
N11     OPSYN('%', 'SIZE', '2')                 :F(B12)
        OUTPUT = 'i numeral string   accepted'  :(N12)
B12     OUTPUT = 'i numeral string   ' &ERRTYPE
N12     OPSYN('#', 'SIZE', 2.7)                 :F(B13)
        OUTPUT = 'i real 2.7         accepted'  :(END)
B13     OUTPUT = 'i real 2.7         ' &ERRTYPE
END
 DEFINE('R(t,n)'); OPSYN('&', 'R', 2); OUTPUT = 'a' & 'b' :(END);R R = 'GOT-' t n :(RETURN);END;* opsyn_noeval;* opsyn_noeval
 DEFINE('R(t,n)'); OPSYN('&', 'R', 2); OUTPUT = DATATYPE('a' & 'b') :(END);R R = EVAL("LEN(1)") :(RETURN);END;* opsyn_pat;* opsyn_pat
*--------------------------------------------------------- 21 opsyn_rebind_twice
        DEFINE('cat(a,b)')                                  :(cat_end)
cat     cat            =   a b                              :(RETURN)
cat_end
        DEFINE('rev(a,b)')                                  :(rev_end)
rev     rev            =   b a                              :(RETURN)
rev_end
        OPSYN('&', 'cat', 2)
        OUTPUT         =   'abc' & 'def'
        OPSYN('&', 'rev', 2)
        OUTPUT         =   'abc' & 'def'
END
*--------------------------------------------------- 22 opsyn_unary_target XFAIL
*  OPSYN'd unused UNARY operator (manual p.116: OPSYN('!','ANY',1); unused unary set = ! % / # = |).
        OPSYN('!', 'ANY', 1)
        'ABC321'       ?   !'3C' . OUTPUT
END
