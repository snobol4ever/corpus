 'A' ? ('X' | &ABORT | 'A') :S(sawthird); OUTPUT = 'amp-abort-shortcircuits-ok' :(fin);sawthird OUTPUT = 'amp-abort-wrongly-reached-third';fin;END;* k01_amp_abort
 'ABCDEF' ? 'A' (&ARB | 'D') 'E' :F(bad); OUTPUT = 'amp-arb-ok' :(fin);bad OUTPUT = 'amp-arb-bad';fin;END;* k02_amp_arb
