*---------------------------------------------------------------- 95 k12_rtntype
        DEFINE('retter(v)')
        DEFINE('fretter(v)')
        DEFINE('nretter(v)')                         :(main)
retter  retter = v                                    :(RETURN)
fretter EQ(v,999)                                      :F(FRETURN)
        fretter = v                                    :(RETURN)
nretter nretter = v                                    :(NRETURN)
main    retter(1)
        OUTPUT = 'after-return=' &RTNTYPE
        fretter(1)
        OUTPUT = 'after-freturn=' &RTNTYPE
        nretter(1)
        OUTPUT = 'after-nreturn=' &RTNTYPE
END
