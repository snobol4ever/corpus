*------------------------------------------------------------------- 83 f51_copy
        A = ARRAY(3)
        A<1> = 'x'
        B = COPY(A)
        B<1> = 'y'
        OUTPUT = A<1>
        OUTPUT = B<1>
        IDENT(A,B)                                        :S(bad1)
        OUTPUT = 'copy-array-distinct-ok'                   :(chk2)
bad1    OUTPUT = 'copy-array-same-bad'
chk2    T = TABLE()
        T<'k'> = 'v1'
        T2 = COPY(T)
        T2<'k'> = 'v2'
        OUTPUT = T<'k'>
        OUTPUT = T2<'k'>
END
*------------------------------------------------ 84 f52_copy_table_independence
        T = TABLE()
        T<'a'> = 1
        T<2> = 'int-key'
        T<'c'> = 'three'
        C = COPY(T)
        T<'a'> = 'MUTATED-ORIG'
        OUTPUT = 'copy-a=' C<'a'>
        OUTPUT = 'copy-int=' C<2>
        C<'c'> = 'MUTATED-COPY'
        OUTPUT = 'orig-c=' T<'c'>
        E = TABLE()
        EC = COPY(E)
        EC<'k'> = 'v'
        OUTPUT = 'empty-orig-k=[' E<'k'> ']'
        OUTPUT = 'empty-copy-k=' EC<'k'>
        N = TABLE()
        INNER = TABLE()
        INNER<'i'> = 'inner-v'
        N<'nest'> = INNER
        NC = COPY(N)
        X = NC<'nest'>
        X<'i'> = 'SHALLOW'
        OUTPUT = 'nested-shared=' INNER<'i'>
        IDENT(T,C)                                                              :S(same)F(dist)
same    OUTPUT = 'copy-is-alias-BAD'                                            :(fin)
dist    OUTPUT = 'copy-distinct-ok'
fin
END
*------------------------------------------------------------------ 85 f57_fence
        ',abc' ? POS(0) (BREAK(',') | REM) $ STR *DIFFER(STR)           :F(bad1)
        OUTPUT = 'unfenced-succeeds-via-rem:' STR                         :(next)
bad1    OUTPUT = 'unfenced-should-have-succeeded-via-rem'
next
        ',abc' ? POS(0) FENCE(BREAK(',') | REM) $ STR *DIFFER(STR)      :S(bad2)
        OUTPUT = 'fence-correctly-blocks-rem-retry'                        :(fin)
bad2    OUTPUT = 'fence-wrongly-allowed-rem-retry:' STR
fin
END
