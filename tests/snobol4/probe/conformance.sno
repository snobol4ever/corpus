*-------------------------------------------------------------------- 38 f53_any
        'abc' ? ANY('xyz')                        :S(bad1)
        OUTPUT = 'any-correctly-rejects-non-member' :(next)
bad1    OUTPUT = 'any-wrongly-matched-non-member'
next
        'abc' ? ANY('cba') . X                    :F(bad2)
        OUTPUT = 'any-matched-' X                   :(fin)
bad2    OUTPUT = 'any-should-have-matched-member'
fin
END
*------------------------------------------------------------------ 39 f54_arbno
        'aaa' ? ARBNO('a') . Y REM . Z            :F(bad1)
        OUTPUT = 'lazy:Y=[' Y ']:Z=' Z              :(next)
bad1    OUTPUT = 'arbno-lazy-should-have-matched'
next
        'aaa' ? POS(0) ARBNO('a') . X RPOS(0)     :F(bad2)
        OUTPUT = 'anchored-full:X=' X                :(fin)
bad2    OUTPUT = 'arbno-anchored-should-have-matched'
fin
END
