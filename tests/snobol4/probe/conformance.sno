*------------------------------------------------------------------ 74 f14_opsyn
        DEFINE('twice(x)')
        DEFINE('sum2(a,b)')                          :(setup)
twice   twice = x + x                                :(RETURN)
sum2    sum2 = a + b                                  :(RETURN)
setup   OPSYN('double', 'twice')
        OPSYN('!', 'twice', 1)
        OPSYN('@', 'sum2', 2)
main    OUTPUT = double(21)
        OUTPUT = !21
        OUTPUT = 3 @ 4
END
*-------------------------------------------------------------- 75 f16_backspace
        OUTPUT(.o, 1, '/tmp/f16_backspace_fixture.txt')
        o = 'AAA'
        o = 'BBB'
        ENDFILE(1)
        INPUT(.i, 2, '/tmp/f16_backspace_fixture.txt')
        rec1 = i
        rec2 = i
        BACKSPACE(2)
        rec3 = i
        OUTPUT = 'rec1=' rec1
        OUTPUT = 'rec2=' rec2
        OUTPUT = 'rec3=' rec3
        IDENT(rec2,rec3)                                     :S(yes)F(no)
no      OUTPUT = 'backspace=no'                                :(fin)
yes     OUTPUT = 'backspace=yes'
fin
END
*----------------------------------------------------------------- 76 f17_detach
        OUTPUT(.o, 1, '/tmp/f17_detach_fixture.txt')
        o = 'first'
        DETACH(.o)
        o = 'second'
        ENDFILE(1)
        INPUT(.i, 2, '/tmp/f17_detach_fixture.txt')
        rec1 = i
        rec2 = i                                            :S(bad)
        OUTPUT = 'rec1=' rec1
        OUTPUT = 'detach=ok'                                  :(fin)
bad     OUTPUT = 'rec1=' rec1
        OUTPUT = 'rec2=' rec2
        OUTPUT = 'detach=bad'
fin
END
