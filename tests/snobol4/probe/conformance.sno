*------------------------------------------------------------------- 10 f02_item
        A = ARRAY(10)
        ITEM(A,1) = 5
        OUTPUT = ITEM(A,1)
        OUTPUT = A<1>
        M = ARRAY('2,3')
        ITEM(M,2,2) = 'mid'
        OUTPUT = ITEM(M,2,2)
        T = TABLE()
        ITEM(T,'key') = 'val'
        OUTPUT = ITEM(T,'key')
        OUTPUT = T<'key'>
END
*-------------------------------------------------------------- 11 f03_prototype
        A = ARRAY(3)
        OUTPUT = PROTOTYPE(A)
        OUTPUT = DATATYPE(PROTOTYPE(A))
        B = ARRAY('2,2')
        OUTPUT = PROTOTYPE(B)
        C = ARRAY('1901:2000')
        OUTPUT = PROTOTYPE(C)
        T = TABLE()
        T<1> = 'x'
        T<2> = 'y'
        TA = CONVERT(T,'ARRAY')
        OUTPUT = PROTOTYPE(TA)
END
*------------------------------------------------------------------- 12 f07_eval
        N = 21
        OUTPUT = EVAL('3+4')
        OUTPUT = EVAL(5)
        OUTPUT = EVAL(*N)
        OUTPUT = EVAL('bad(')                        :S(bad1)
        OUTPUT = 'eval-badsyntax-failed-ok'             :(fin)
bad1    OUTPUT = 'eval-badsyntax-succeeded-bad'
fin
END
*------------------------------------------------------------------- 13 f08_code
        C = CODE(" OUTPUT = 'from-code' :(RET)")      :S(ok1)
        OUTPUT = 'code-compile-failed-bad'              :(fin)
ok1     OUTPUT = 'before'                                :<C>
RET     OUTPUT = 'after-code-ok'                          :(chk2)
chk2    BAD = CODE(' OUTPUT = 3 + ')                    :S(bad2)
        OUTPUT = 'code-badsyntax-failed-ok'                :(fin)
bad2    OUTPUT = 'code-badsyntax-succeeded-bad'
fin
END
*----------------------------------------------------------------- 14 f11_define
        DEFINE('foo(x)', 'entry')
        DEFINE('bar(x)')
        DEFINE('rec(n)temp')                         :(main)
entry   foo = x * 2                                  :(RETURN)
bar     bar = x * 3                                  :(RETURN)
rec     temp = n
        EQ(n,1)                                       :F(rdeep)
        rec = temp                                    :(RETURN)
rdeep   rec = rec(n - 1) + temp                        :(RETURN)
main    OUTPUT = foo(21)
        OUTPUT = bar(21)
        OUTPUT = rec(3)
END
