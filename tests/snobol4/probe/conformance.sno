        ffline = i
        textline = i
        OUTPUT = 'textline=' textline
        IDENT(ffline,CHAR(12))                               :S(yes)F(no)
no      OUTPUT = 'eject=no'                                    :(fin)
yes     OUTPUT = 'eject=yes'
fin
END
 OUTPUT(.o, 1, '/tmp/f19_endfile_fixture.txt'); o = 'hello'; ENDFILE(1); INPUT(.i, 1, '/tmp/f19_endfile_fixture.txt'); line = i; OUTPUT = 'line=' line; ENDFILE(1);END;* f19_endfile
*------------------------------------------------------------------ 79 f20_input
        INPUT(.m, 1, '/tmp/f20_input_does_not_exist.txt')       :F(noexist)
        OUTPUT = 'input-should-have-failed'                     :(fin)
noexist OUTPUT(.o, 2, '/tmp/f20_input_fixture.txt')
        o = 'one'
        o = 'two'
        ENDFILE(2)
        INPUT(.i, 3, '/tmp/f20_input_fixture.txt')
        a = i
        b = i
        c = i                                                 :S(bad)
        OUTPUT = 'a=' a
        OUTPUT = 'b=' b
        OUTPUT = 'input=ok'                                     :(fin)
bad     OUTPUT = 'a=' a
        OUTPUT = 'b=' b
        OUTPUT = 'c=' c
        OUTPUT = 'input=bad-extra-read-succeeded'
fin
END
*----------------------------------------------------------------- 80 f22_rewind
        OUTPUT(.o, 1, '/tmp/f22_rewind_fixture.txt')
        o = 'ONE'
        o = 'TWO'
        ENDFILE(1)
        INPUT(.i, 2, '/tmp/f22_rewind_fixture.txt')
        a1 = i
        a2 = i
        REWIND(2)
        a3 = i
        OUTPUT = 'a1=' a1
        OUTPUT = 'a2=' a2
        OUTPUT = 'a3=' a3
        IDENT(a1,a3)                                          :S(yes)F(no)
no      OUTPUT = 'rewind=no'                                    :(fin)
yes     OUTPUT = 'rewind=yes'
fin
END
