*------------------------------------------------- 7 c07_json_shape_single_defer
        $' '           =  SPAN(' ' CHAR(9) CHAR(10) CHAR(13)) | ''
        jnumber        =  ANY('0123456789')
        jarray         =  '[' ( *jelement ARBNO(',' *jelement) | $' ' ) ']'
        jvalue         =  ( jnumber | jarray )
        jelement       =  jvalue
        json           =  POS(0) jelement RPOS(0)
        src = '[1,2]'
        src json  :F(BAD)
        OUTPUT = 'MATCH'  :(END)
BAD     OUTPUT = 'FAIL'
END
 $'W' = SPAN(' ') | ''; S = '1,2'; S POS(0) ( ANY('12') ARBNO(',' ANY('12')) | $'W' ) RPOS(0) :S(OK)F(BAD);OK OUTPUT = 'MATCH' :(END);BAD OUTPUT = 'FAIL';END;* c08_no_brackets_min
