 S = 'a(b(c))d'; S POS(0) BAL . V RPOS(0) :S(OK)F(NO);OK OUTPUT = 'match:' V :(END);NO OUTPUT = 'nomatch';END;* ctl_bal_solo
*-------------------------------------------------------- 2 ctl_span_constcs_alt
        epsilon        =
        digits         = '0123456789'
        T              = 'Name'
        T              POS(0) ANY(&UCASE &LCASE)
+                        (SPAN( digits &UCASE '_' &LCASE) | epsilon) RPOS(0)       :S(OK)F(NO)
OK        OUTPUT         = 'bare'                                                  :(END)
NO        OUTPUT         = 'quoted'
END
 CS = 'ab'; S = 'aabbz'; S POS(0) (('q' . V) | (SPAN(*CS) . V)) :S(OK)F(NO);OK OUTPUT = 'match:' V :(END);NO OUTPUT = 'nomatch';END;* ctl_spanvar_alt_inline
 CS = 'ab'; S = 'aabbz'; S POS(0) SPAN(*CS) . V :S(OK)F(NO);OK OUTPUT = 'match:' V :(END);NO OUTPUT = 'nomatch';END;* ctl_spanvar_solo
 S = 'a(b(c))d'; P = ('zz' . V) | (BAL . V); S POS(0) P RPOS(0) :S(OK)F(NO);OK OUTPUT = 'match:' V :(END);NO OUTPUT = 'nomatch';END;* leafwide_bal_alt
*----------------------------------------------------- 6 leafwide_span_dyncs_alt
        epsilon        =
        CS             = '0123456789' &UCASE '_' &LCASE
