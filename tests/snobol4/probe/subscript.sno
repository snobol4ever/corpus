*---------------------------------------------------------- 1 sub_container_only
        &ERRLIMIT = 100
        DATA('PT(X,Y)')
        NULLS =
        STR = 'hello'
        INT = 7
        REAL = 1.5
        PAT = SPAN('a')
        NAM = .STR
        EXPR = *(1 + 2)
        COD = CODE(' OUTPUT = 1' CHAR(10) 'END' CHAR(10))
        OBJ = PT(1, 2)
        ARR = ARRAY('0:3')
        TBL = TABLE()
        V = NULLS[1]                            :F(F1)
        OUTPUT = 'null-string  accepted'        :(N1)
F1      OUTPUT = 'null-string  ' &ERRTYPE
N1      V = STR[2]                              :F(F2)
        OUTPUT = 'string       accepted=' V     :(N2)
F2      OUTPUT = 'string       ' &ERRTYPE
N2      V = INT[1]                              :F(F3)
        OUTPUT = 'integer      accepted=' V     :(N3)
F3      OUTPUT = 'integer      ' &ERRTYPE
N3      V = REAL[1]                             :F(F4)
        OUTPUT = 'real         accepted=' V     :(N4)
F4      OUTPUT = 'real         ' &ERRTYPE
N4      V = PAT[1]                              :F(F5)
        OUTPUT = 'pattern      accepted'        :(N5)
F5      OUTPUT = 'pattern      ' &ERRTYPE
N5      V = NAM[1]                              :F(F6)
        OUTPUT = 'name         accepted=' V     :(N6)
F6      OUTPUT = 'name         ' &ERRTYPE
N6      V = EXPR[1]                             :F(F7)
        OUTPUT = 'expression   accepted'        :(N7)
F7      OUTPUT = 'expression   ' &ERRTYPE
N7      V = COD[1]                              :F(F8)
        OUTPUT = 'code         accepted'        :(N8)
F8      OUTPUT = 'code         ' &ERRTYPE
N8      V = OBJ[1]                              :F(F9)
        OUTPUT = 'data-object  accepted=' V     :(N9)
F9      OUTPUT = 'data-object  ' &ERRTYPE
N9      ARR[1] = 'in-array'
        OUTPUT = 'array        accepted=' ARR[1]
        TBL['k'] = 'in-table'
        OUTPUT = 'table        accepted=' TBL['k']
        OUTPUT = 'end'
END
*-------------------------------------------------------- 2 sub_positive_control
        A = ARRAY(3)
        M = ARRAY('2,3')
        T = TABLE()
        B = ARRAY(3)
        A[1] = 'one'
        A<2> = 'two'
        M[1,2] = 'm12'
        M<2,3> = 'm23'
        T['k'] = 'tv'
        T<7> = 'ti'
        B[1] = 1
        I = 1
        OUTPUT = 'arr_brk   = ' A[1]
        OUTPUT = 'arr_ang   = ' A<2>
        OUTPUT = 'mul_brk   = ' M[1,2]
        OUTPUT = 'mul_ang   = ' M<2,3>
        OUTPUT = 'tbl_str   = ' T['k']
        OUTPUT = 'tbl_int   = ' T<7>
        OUTPUT = 'arr_var   = ' A[I]
        OUTPUT = 'nested    = ' A[B[1]]
        OUTPUT = 'tbl_miss  = <' T['nosuch'] '>'
END
*------------------------------------------------------------------ 3 sub_shapes
        &ERRLIMIT = 100
        X = A[1]                                :F(F1)
        OUTPUT = 'rvalue       accepted'        :(N1)
F1      OUTPUT = 'rvalue       ' &ERRTYPE
N1      X = B[1, 2]                             :F(F2)
        OUTPUT = 'multi        accepted'        :(N2)
F2      OUTPUT = 'multi        ' &ERRTYPE
N2      X = C[D[1]]                             :F(F3)
        OUTPUT = 'nested       accepted'        :(N3)
F3      OUTPUT = 'nested       ' &ERRTYPE
N3      E[1] = 'hello'                          :F(F4)
        OUTPUT = 'lvalue       accepted'        :(N4)
F4      OUTPUT = 'lvalue       ' &ERRTYPE
N4      G = ARRAY(3)
        G[1] = 'one'
        OUTPUT = 'ok-rvalue    ' G[1]
        H = ARRAY('2,3')
        H[2, 3] = 'two-three'
        OUTPUT = 'ok-multi     ' H[2, 3]
        K = ARRAY(3)
        K[1] = 2
        OUTPUT = 'ok-nested    ' G[K[1] - 1]
        OUTPUT = 'end'
END
