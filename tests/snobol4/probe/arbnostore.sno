 'aaa' POS(0) ARB RPOS(0) :S(OK)F(NO);OK OUTPUT = 'MATCH' :(END);NO OUTPUT = 'NOMATCH' :(END);END;* arb_inline_green
 C = ARB; 'aaa' POS(0) C RPOS(0) :S(OK)F(NO);OK OUTPUT = 'MATCH' :(END);NO OUTPUT = 'NOMATCH' :(END);END;* arb_stored_red
 s = 'ab'; s POS(0) ARBNO('a' | 'ab') RPOS(0) :S(BAD)F(GOOD);BAD OUTPUT = 'match' :(END);GOOD OUTPUT = 'nomatch';END;* arbno_alt_inline_red
 D = 'a'; C = ARBNO(*D); 'aaa' POS(0) C RPOS(0) :S(OK)F(NO);OK OUTPUT = 'MATCH' :(END);NO OUTPUT = 'NOMATCH' :(END);END;* arbno_defer_stored_red
 C = ARBNO('a'); 'aaa' POS(0) C RPOS(0) :S(OK)F(NO);OK OUTPUT = 'MATCH' :(END);NO OUTPUT = 'NOMATCH' :(END);END;* arbno_lit_stored_green
 D = 'a'; 'aaa' POS(0) ARBNO(D) RPOS(0) :S(OK)F(NO);OK OUTPUT = 'MATCH' :(END);NO OUTPUT = 'NOMATCH' :(END);END;* arbno_var_inline_green
 D = 'a'; C = ARBNO(D); 'aaa' POS(0) C RPOS(0) :S(OK)F(NO);OK OUTPUT = 'MATCH' :(END);NO OUTPUT = 'NOMATCH' :(END);END;* arbno_var_stored_red
 P = ARB; Q = *P 'X'; 'aaX' POS(0) Q RPOS(0) :S(OK)F(NO);OK OUTPUT = 'MATCH' :(END);NO OUTPUT = 'NOMATCH' :(END);END;* defer_star_arb_red
 C = SPAN('a'); 'aaa' POS(0) C RPOS(0) :S(OK)F(NO);OK OUTPUT = 'MATCH' :(END);NO OUTPUT = 'NOMATCH' :(END);END;* span_stored_green
*----------------------------------------------------- 10 arbno_defer_altarg_red
*  arbno_defer_altarg_red - stored ARBNO whose deferred argument has INTERNAL ALTERNATIVES.
*  NO FENCE ANYWHERE.  Minted s123 as the discriminating control for 148/119/129/149:
*  those four are named "..._fence_..." but the seal is NOT what breaks them.
*  Oracle: ARBNO takes 'a' (cursor 0->1), RPOS(0) fails, backtrack INTO the placed
*  instance picks its second alternative 'ab' (cursor 0->2), RPOS(0) succeeds => MATCH.
*  SCRIP default: NOMATCH (silent wrong answer, no backtrack into a stored pattern).
*  SCRIP SCRIP_DEFER_RESUME=1: SIGSEGV (rbp walks the frame chain to 0) -- SAME crash
*  as the four fence witnesses, proving the crash is the ARBNO retry-unwind over-pop
*  and not a seal-visibility failure.
        cmd   = ('a' | 'ab')
        outer = ARBNO(*cmd)
        s     = 'ab'
        s POS(0) *outer RPOS(0)                               :S(BAD)F(GOOD)
BAD     OUTPUT = 'match'                                      :(END)
GOOD    OUTPUT = 'nomatch'
END
