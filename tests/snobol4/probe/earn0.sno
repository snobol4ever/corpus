*--------------------------------------- 32 earn0_disc_arbno_star_fence_poisoned
        cmd   = FENCE('zz')
        outer = ARBNO(*cmd)
        s     = 'aa'
        s POS(0) *outer RPOS(0)                               :S(GOOD)F(BAD)
GOOD    OUTPUT = 'arbno-star-cmd spanned aa'                  :(END)
BAD     OUTPUT = 'FAILED: pattern did not span aa'
END
*--------------------------------------- 33 earn0_disc_arbno_star_fence_positive
        cmd   = FENCE('a' | 'ab')
        outer = ARBNO(*cmd)
        s     = 'aa'
        s POS(0) *outer RPOS(0)                               :S(GOOD)F(BAD)
GOOD    OUTPUT = 'arbno-star-cmd spanned aa'                  :(END)
BAD     OUTPUT = 'FAILED: pattern did not span aa'
END
