*-------------------------------------------------------------------- 1 z4_arbno
*       Z4 PROBE — ARBNO backtrack ladder.  The dynamic-housekeeping stressor (RBP-pin class).
        &ANCHOR = 1
        N = 0
        H = 0
LOOP    N = N + 1
        S = 'ababababababababababab'
        S ARBNO('ab') 'ab' RPOS(0)                     :F(NEXT)
        H = H + 1
NEXT    LT(N,150000)                                     :S(LOOP)
        OUTPUT = 'arbno ' H
END
*-------------------------------------------------------------------- 2 z4_arith
*       Z4 PROBE — tight arithmetic loop.  Storage regime under test: per-BB result cells.
        N = 0
        S = 0
LOOP    N = N + 1
        S = S + N * 2 - 1
        GT(N,3000000)                                     :F(LOOP)
        OUTPUT = 'arith ' S
END
*------------------------------------------------------------------ 3 z4_capture
*       Z4 PROBE — capture (.) into a value.  Storage regime under test: capture slots.
*       Uses capture-at-pattern-START only: a capture preceded by another element
*       returns a WRONG start delta at HEAD (see FINDING Z4-CAPTURE-START), so the
*       broken shape is deliberately avoided here and tracked separately.
        &ANCHOR = 1
        N = 0
        T = 0
LOOP    N = N + 1
        S = 'abcdefghij0123456789'
        S SPAN('abcdefghij') . D                       :F(NEXT)
        T = T + SIZE(D)
NEXT    LT(N,150000)                                     :S(LOOP)
        OUTPUT = 'capture ' T
END
*---------------------------------------------------------------------- 4 z4_fib
*       Z4 PROBE — DEFINE recursion.  Frame-vs-cell call cost.
        DEFINE('FIB(N)')                                :(FIBEND)
FIB     LE(N,1)                                         :S(FIBR)
        FIB = FIB(N - 1) + FIB(N - 2)                   :(RETURN)
FIBR    FIB = N                                         :(RETURN)
FIBEND
        K = 0
        A = 0
LOOP    K = K + 1
        A = A + FIB(17)
        LT(K,120)                                         :S(LOOP)
        OUTPUT = 'fib ' A
END
*--------------------------------------------------------------------- 5 z4_span
*       Z4 PROBE — SPAN/BREAK scan.  Storage regime under test: pattern leaf locals.
*       INLINE patterns only: stored patterns (P = ...) segv at HEAD, port-invariant,
*       upstream of storage (see FINDING Z4-STORED-PATTERN) — excluded so this probe
*       measures the storage regime and nothing else.
        &ANCHOR = 0
        N = 0
        T = 0
LOOP    N = N + 1
        S = 'alpha123beta456gamma789delta012epsilon345zeta678'
SCAN    S BREAK('0123456789') SPAN('0123456789') =     :F(NEXT)
        T = T + 1                                      :(SCAN)
NEXT    LT(N,150000)                                     :S(LOOP)
        OUTPUT = 'span ' T
END
