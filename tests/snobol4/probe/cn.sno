*----------------------------------------------------------- 1 cn_alt_eval_order
        DEFINE('f(x)')
        DEFINE('g(x)')                        :(E)
f         OUTPUT = 'call-f'
        f = 'F'                               :(RETURN)
g         OUTPUT = 'call-g'
        g = 'G'                               :(RETURN)
E         P = (f('a') | g('a'))
        OUTPUT = 'built'
        Q = f('a') g('a')
        OUTPUT = 'concat-built'
END
 V1 = "pad1"; V2 = "pad2"; V3 = "pad3"; V4 = "pad4"; V5 = "pad5"; "ab" POS(0) (SPAN("ab") | SPAN("09")) RPOS(0) :S(Y)F(N);Y OUTPUT = "match" :(END);N OUTPUT = "nomatch";END;* cn_alt_leaf_flat_grn
*-------------------------------------------------------- 3 cn_alt_leaf_flat_red
        V1 = "pad1"
        V2 = "pad2"
        V3 = "pad3"
        V4 = "pad4"
        V5 = "pad5"
        V6 = "pad6"
        V7 = "pad7"
        V8 = "pad8"
        V9 = "pad9"
        V10 = "pad10"
        V11 = "pad11"
        V12 = "pad12"
        V13 = "pad13"
        V14 = "pad14"
        V15 = "pad15"
        V16 = "pad16"
        V17 = "pad17"
        V18 = "pad18"
        V19 = "pad19"
        V20 = "pad20"
        "ab" POS(0) (SPAN("ab") | SPAN("09")) RPOS(0)	:S(Y)F(N)
Y	OUTPUT = "match"	:(END)
N	OUTPUT = "nomatch"
END
 &USER_DECLARED_CONSTANTS = 1; &P = SPAN("ab") | SPAN("09"); "ab" POS(0) *&P RPOS(0) :S(Y)F(N);Y OUTPUT = "match" :(END);N OUTPUT = "nomatch";END;* cn_alt_leaf_lit_red
*------------------------------------------------------------- 5 cn_arbno_static
        Word = SPAN("abcdefghijklmnopqrstuvwxyz")
        &Command = Word
        Line = ARBNO(*&Command " ")
        "go run stop " POS(0) Line RPOS(0)	:S(Y)F(N)
Y	OUTPUT = "match"	:(END)
N	OUTPUT = "nomatch"
END
 &USER_DECLARED_CONSTANTS = 1; &Cmd = "go" | "run"; "run x" POS(0) &Cmd :S(Y)F(N);Y OUTPUT = "match" :(END);N OUTPUT = "nomatch";END;* cn_bare_const_pos
 X = "gone"; CLEAR(); OUTPUT = "direct=[" X "]"; OUTPUT = "indirect=[" $("X") "]";END;* cn_clear_user_var
*-------------------------------------------------------------- 8 cn_const_chain
        &Word = SPAN("abcdefghijklmnopqrstuvwxyz")
        &Num = SPAN("0123456789")
        &Item = &Word | &Num
        Line = ARBNO(*&Item " ")
        "go 42 stop " POS(0) Line RPOS(0)	:S(Y)F(N)
Y	OUTPUT = "match"	:(END)
N	OUTPUT = "nomatch"
END
 &A = ARBNO('a'); &B = ''; &P2 = &A &B; 'aa' POS(0) *&P2 RPOS(0) :S(OK)F(NO);OK OUTPUT = 'match' :(END);NO OUTPUT = 'nomatch';END;* cn_const_compose_all
 A = ARBNO('a'); B = ''; P2 = A B; 'aa' POS(0) *P2 RPOS(0) :S(OK)F(NO);OK OUTPUT = 'match' :(END);NO OUTPUT = 'nomatch';END;* cn_const_compose_ctl
 &A = ARBNO('a'); &B = ''; P2 = &A &B; 'aa' POS(0) *P2 RPOS(0) :S(OK)F(NO);OK OUTPUT = 'match' :(END);NO OUTPUT = 'nomatch';END;* cn_const_compose_leaf
 &USER_DECLARED_CONSTANTS = 1; &T = "b"; &W = SPAN("a" &T); "abba x" POS(0) *&W :S(Y)F(N);Y OUTPUT = "match" :(END);N OUTPUT = "nomatch";END;* cn_cset_const
 &P = "a" | "b"; "xay" POS(1) *&P :S(Y)F(N);Y OUTPUT = "match" :(END);N OUTPUT = "nomatch";END;* cn_defer_const
 &W = "hi"; W = "bare"; OUTPUT = "amp=" &W " bare=" W;END;* cn_namespace_split
 &USER_DECLARED_CONSTANTS = 1; &W2 = SPAN("ab"); &N2 = SPAN("09"); &P = &W2 | &N2; "ab" POS(0) *&P RPOS(0) :S(Y)F(N);Y OUTPUT = "match" :(END);N OUTPUT = "nomatch";END;* cn_nest_alt_defer
*--------------------------------------------------- 16 cn_t2_inline_and_recurse
        &L = 'a' | 'b'
        P = 'x' *&L 'y'
        'xay' POS(0) P RPOS(0)	:S(A)F(B)
A	OUTPUT = 'leaf-inline match'	:(T2)
B	OUTPUT = 'FAIL'
T2	&R = 'q' *&R | 'z'
        'z' POS(0) *&R RPOS(0)	:S(C)F(D)
C	OUTPUT = 'recursive-defer match'	:(END)
D	OUTPUT = 'FAIL2'
END
 &USER_DECLARED_CONSTANTS = 1; t = "b"; &W = SPAN("a" t); "abba x" POS(0) *&W :S(Y)F(N);Y OUTPUT = "match" :(END);N OUTPUT = "nomatch";END;* cn_var_cset_fold
*--------------------------------------------------- 18 cn_eval_fails_not_aborts
        X = EVAL('&NEVERSET')	:F(F1)
        OUTPUT = 'r1-kw-OK=[' X ']'	:(S1)
F1	OUTPUT = 'r1-kw-FAILED'
        DIFFER(&ERRTEXT)	:F(S1)
        OUTPUT = 'r1-errtext-nonnull'
S1	Z = EVAL('3 +')	:F(F3)
        OUTPUT = 'r3-syntax-OK=[' Z ']'	:(S3)
F3	OUTPUT = 'r3-syntax-FAILED'
S3	W = EVAL('3 + 4')	:F(F4)
        OUTPUT = 'r4-good=' W	:(S4)
F4	OUTPUT = 'r4-good-FAILED'
S4	OUTPUT = 'reached-end'
END
*------------------------------------------------ 19 cn_indirect_is_ordinary_var
        &ANCHOR = 1
        OUTPUT = 'r1-direct-anchor=' &ANCHOR
        OUTPUT = 'r2-indirect-anchor=[' $('&ANCHOR') ']'
        $('&ANCHOR') = 'HELLO'
        OUTPUT = 'r3-direct-after-indirect-write=' &ANCHOR
        OUTPUT = 'r4-indirect-after-indirect-write=[' $('&ANCHOR') ']'
        $('&NEVERSET') = 99
        OUTPUT = 'r5-indirect-neverset=[' $('&NEVERSET') ']'
        OUTPUT = 'reached-end'
END
*-------------------------------------------------------- 20 cn_indirect_rewrite
        $('&ZED') = 1
        OUTPUT = 'w1=[' $('&ZED') ']'
        $('&ZED') = 2
        OUTPUT = 'w2=[' $('&ZED') ']'
        $('&ZED') = 3
        OUTPUT = 'w3=[' $('&ZED') ']'
        OUTPUT = 'dt=' DATATYPE($('&ZED'))
        &ANCHOR = 1
        $('&ANCHOR') = 'X1'
        $('&ANCHOR') = 'X2'
        OUTPUT = 'anch-indirect=[' $('&ANCHOR') ']'
        OUTPUT = 'anch-direct=' &ANCHOR
        N = '&ZED'
        OUTPUT = 'via-var=[' $N ']'
        OUTPUT = 'reached-end'
END
*----------------------------------------------------------- 21 cn_indirect_seal
        &USER_DECLARED_CONSTANTS = 1
        &N = 42
        OUTPUT = 'direct=' &N
        OUTPUT = 'indirect=[' $('&N') ']'
        $('&N') = 99
        OUTPUT = 'write=[' $('&N') ']'
        $('&N') = 100
        OUTPUT = 'rewrite=[' $('&N') ']'
        OUTPUT = 'direct-after=' &N
        OUTPUT = 'undeclared=[' $('&NEVERSET') ']'
        OUTPUT = 'reached-end'
END
*----------------------------------------------------------------- 22 cn_t1_eval
        &USER_DECLARED_CONSTANTS = 1
        &N = 42
        &Tag = 'hello'
        OUTPUT = 'eval-int=' EVAL('&N')
        OUTPUT = 'eval-arith=' EVAL('&N + 1')
        OUTPUT = 'eval-str=' EVAL('&Tag')
        OUTPUT = 'direct=' &N
        C = CODE('L OUTPUT = "code-int=" &N; :(BACK)')	:F(NOCODE)
        :<C>
BACK	OUTPUT = 'boundary-ok'				:(END)
NOCODE	OUTPUT = 'CODE-COMPILE-FAILED'
END
*---------------------------------------------------------- 23 cn_t1_eval_undecl
        &USER_DECLARED_CONSTANTS = 1
        &N = 42
        OUTPUT = 'before=' &N
        X = EVAL('&NEVERSET')	:F(F1)
        OUTPUT = 'eval-OK=[' X ']'	:(S1)
F1	OUTPUT = 'eval-FAILED'
        DIFFER(&ERRTEXT)	:F(S1)
        OUTPUT = 'errtext-nonnull'
S1	OUTPUT = 'after=' &N
        OUTPUT = 'reached-end'
END
 &USER_DECLARED_CONSTANTS = 1; &N = 42; &Pi = 3.14; &Tag = 'hello'; OUTPUT = &N; OUTPUT = &Pi; OUTPUT = &Tag; OUTPUT = &N + 1; OUTPUT = &Tag ' world';END;* cn_t1_scalar_fold
*-------------------------------------------------------- 25 cn_t2_eval_boundary
        &USER_DECLARED_CONSTANTS = 1
        &Word = SPAN('abcdefghijklmnopqrstuvwxyz')
        'hello42' ? *&Word . W				:F(N1)
        OUTPUT = 'direct=' W
N1	OUTPUT = 'eval-dt=' EVAL('DATATYPE(&Word)')
        P = EVAL('&Word')
        'zebra9' ? P . V				:F(N2)
        OUTPUT = 'eval-byname=' V			:(END)
N2	OUTPUT = 'EVAL-BYNAME-NOMATCH'
END
*------------------------------------------------------------- 26 cn_udc_declare
        OUTPUT = 'born=' &USER_DECLARED_CONSTANTS
        &Word = SPAN('abcdefghijklmnopqrstuvwxyz')
        &Num  = SPAN('0123456789')
        OUTPUT = 'dt-word=' DATATYPE(&Word)
        OUTPUT = 'dt-num='  DATATYPE(&Num)
        'hello42' ? *&Word . W *&Num . N            :F(NOMATCH)
        OUTPUT = 'w=' W ' n=' N
        OUTPUT = 'declare-ok'                       :(END)
NOMATCH OUTPUT = 'MATCH-FAILED'
END
*-------------------------------------------------------------- 27 cn_udc_reopen
        OUTPUT = &USER_DECLARED_CONSTANTS
        &USER_DECLARED_CONSTANTS = 0
        OUTPUT = &USER_DECLARED_CONSTANTS
        &USER_DECLARED_CONSTANTS = 1
        OUTPUT = &USER_DECLARED_CONSTANTS
        &Late = LEN(2)
        OUTPUT = 'reopen-declare=' DATATYPE(&Late)
END
