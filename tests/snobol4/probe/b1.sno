 Q = 'q0'; P = 'A' . *Q; S = 'A'; S POS(0) P :S(Y)F(N);Y OUTPUT = 'match Q=[' Q '] q0=[' q0 ']' :(END);N OUTPUT = 'nomatch';END;* b1c_capname_var_target
*----------------------------------------------- 12 b1c_cross_medium_concat_seam
        DEFINE('PC()')	:(PCe)
PC	OUTPUT = "PC ran"	:(RETURN)
PCe	F = EVAL("'x' . D2 *PC()")
        R = ("" . D1 *PC()) F
        S = "x"
        S POS(0) R	:S(Y)F(N)
Y	OUTPUT = "match"	:(END)
N	OUTPUT = "nomatch"
END
 DEFINE('PC()') :(PCe);PC OUTPUT = 'PC ran' :(RETURN);PCe P = EVAL("'x' *PC()"); S = 'x'; S POS(0) P :S(Y)F(N);Y OUTPUT = 'match' :(END);N OUTPUT = 'nomatch';END;* b1c_e_plain
*------------------------------------------------ 14 b1c_eval_fn_pattern_retreat
        DEFINE('SH(p,t)')	:(SHe)
SH	SH = EVAL("p . thx . *CB('" t "', thx)")	:(RETURN)
SHe	DEFINE('CB(a,b)')	:(CBe)
CB	OUTPUT = 'CB: ' a ' cap=' b	:(RETURN)
CBe	R = SH('AB', 'ty')
        OUTPUT = 'dt: ' DATATYPE(R)
        S = 'AB'
        S POS(0) R	:S(Y)F(N)
Y	OUTPUT = 'match'	:(END)
N	OUTPUT = 'nomatch'
END
 DEFINE('PC()') :(PCe);PC OUTPUT = 'PC ran' :(RETURN);PCe S = 'x'; S POS(0) 'x' *PC() :S(Y)F(N);Y OUTPUT = 'match' :(END);N OUTPUT = 'nomatch';END;* b1c_m_plain
*----------------------------------------------- 16 b1c_patvalued_formal_retreat
        DEFINE('CB(a,b)')	:(CBe)
CB	OUTPUT = "CB: " a " cap=" b	:(RETURN)
CBe	DEFINE('SH(p,t)')	:(SHe)
SH	SH = EVAL("p . thx . *CB('" t "', thx)")	:(RETURN)
SHe	BASE = 'A' | 'B'
        R = SH(BASE, "ty")
        OUTPUT = "dt: " DATATYPE(R)
        S = 'B'
        S POS(0) R	:S(Y)F(N)
Y	OUTPUT = "match"	:(END)
N	OUTPUT = "nomatch"
END
