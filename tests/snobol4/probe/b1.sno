*-------------------------------------------------- 6 b1_eval_pattern_defer_call
        DEFINE('F(a,b)')	:(Fe)
F	OUTPUT = 'F called: ' a ' cap=' b	:(RETURN)
Fe	P = EVAL("'A' . TH . *F('t', TH)")	:F(EF)
        OUTPUT = 'dt: ' DATATYPE(P)
        S = 'A'
        S POS(0) P RPOS(0)	:S(Y)F(N)
Y	OUTPUT = 'match'	:(END)
N	OUTPUT = 'nomatch'	:(END)
EF	OUTPUT = 'EVAL failed'
END
 DEFINE('RED(A,B)') :(RED_end);RED RED = A '+' B :(RETURN);RED_end; OPSYN('&', 'RED', 2); X = 'l' & 'r'; OUTPUT = X;END;* b1_opsyn_binary_snodef
 DEFINE('F()') :(Fe);F OUTPUT = 'F called' :(RETURN);Fe P = EVAL('LEN(0) . *F()'); 'abc' ? P; OUTPUT = 'OK';END;* b1c_capname_abandon_once
*---------------------------------------------------- 9 b1c_capname_call_nreturn
        DEFINE('F()')	:(Fe)
F	F = 'ZZ'
        OUTPUT = 'F called'	:(NRETURN)
Fe	P = 'A' . *F()
        S = 'A'
        S POS(0) P	:S(Y)F(N)
Y	OUTPUT = 'match ZZ=[' ZZ ']'	:(END)
N	OUTPUT = 'nomatch ZZ=[' ZZ ']'
END
