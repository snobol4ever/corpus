*---------------------------------------------------------- 1 alt_litcat_control
        digits = '0123456789'
        E =
        S = 'Name'
        S ANY('NX') (SPAN('0123456789' 'ABCDEFGHIJKLMNOPQRSTUVWXYZ' '_' 'abcdefghijklmnopqrstuvwxyz') | E) RPOS(0)   :S(OK)F(NO)
OK      OUTPUT = 'MATCHED'   :(END)
NO      OUTPUT = 'NOMATCH'
END
 digits = '0123456789'; E =; S = 'Name'; S ANY('NX') (SPAN(digits 'abcdemn') | E) RPOS(0) :S(OK)F(NO);OK OUTPUT = 'MATCHED' :(END);NO OUTPUT = 'NOMATCH';END;* alt_span_concat_segv
*------------------------------------------------------ 3 alt_span_kwcat_nomatch
        digits = '0123456789'
        epsilon =
        s = 'Name'
        s POS(0) ANY(&UCASE &LCASE) (SPAN(digits &UCASE '_' &LCASE) | epsilon) RPOS(0)  :S(OK)F(NO)
OK      OUTPUT = 'MATCHED'         :(END)
NO      OUTPUT = 'NOMATCH'
END
 digits = '0123456789'; lets = 'abcdemn'; E =; S = 'Name'; S ANY('NX') (SPAN(lets) | E) RPOS(0) :S(OK)F(NO);OK OUTPUT = 'MATCHED' :(END);NO OUTPUT = 'NOMATCH';END;* alt_span_var_control
 digits = '0123456789'; lets = 'abcdemn'; E =; S = 'Name'; S ANY('NX') (ANY(lets) SPAN(lets) | E) RPOS(0) :S(OK)F(NO);OK OUTPUT = 'MATCHED' :(END);NO OUTPUT = 'NOMATCH';END;* alt_two_evals_nomatch
*--------------------------------------------------- 6 noalt_span_concat_control
        digits = '0123456789'
        DATA('tree(t,v,n,c)')
        DEFINE('F(x)')             :(FEnd)
F       t(x) POS(0) ANY(&UCASE &LCASE) SPAN(digits &UCASE '_' &LCASE) RPOS(0)  :S(RETURN)F(FRETURN)
FEnd
        leaf = tree('Name','foo',,)
        F(leaf)                    :S(OK)F(NO)
OK      OUTPUT = 'MATCHED'         :(END)
NO      OUTPUT = 'NOMATCH'
END
