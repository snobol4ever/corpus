*------------------------------------------------- 1 k40_lambda_primitives XFAIL
* k40 -- lambda/LAMBDA pattern primitives (Lon 2026-08-28; row lang-lambda-pattern-primitives).
* ⛔ RED ON PURPOSE until the feature lands (the k30 precedent): this witness is the instrument,
* authored BEFORE the cure per RULES.md THE INSTRUMENT LAWS clause 3.
* ⛔ GRADING IS SELF-PINNED VS THIS FILE'S .ref -- SPITBOL cannot run lambda (cross-twin law,
* feature row §7). Never grade this against sbl.
* Arms: (1) conditional lambda queues IN ORDER, runs at overall success; (2) backtracking
* DISCARDS queued lambdas of abandoned arms; (3) IMMEDIATE runs at cursor-pass and is NOT
* undone by backtracking; (4) LAMBDA expression FAILURE fails the match at that point;
* (5) Greek spellings λ/Λ + a STORED pattern (the dtp_rcp round trip, recon point 5).
        &TRIM = 1
        SUB = 'ab'
* arm 1 -- order of queued conditionals
        S = ''
        SUB ? 'a' lambda(S = S 'x') 'b' lambda(S = S 'y')
        OUTPUT = 'arm1 S=' S
* arm 2 -- abandoned arm's conditional is unqueued
        N = 0
        SUB ? ('a' lambda(N = N + 100) 'x' | 'a' lambda(N = N + 1)) 'b'
        OUTPUT = 'arm2 N=' N
* arm 3 -- immediates from abandoned arms persist
        M = 0
        SUB ? ('a' LAMBDA(M = M + 100) 'x' | 'a' LAMBDA(M = M + 1)) 'b'
        OUTPUT = 'arm3 M=' M
* arm 4 -- failing expression inside LAMBDA fails the match there
        SUB ? 'a' LAMBDA(LT(1, 0)) 'b'          :S(A4Y)F(A4N)
A4Y     OUTPUT = 'arm4 matched (WRONG)'         :(A5)
A4N     OUTPUT = 'arm4 failed ok'
* arm 5 -- Greek spellings inside a STORED pattern, both primitives
A5      G = ''
        H = ''
        P = 'a' λ(G = G 'g') Λ(H = H 'h') 'b'
        SUB ? P
        OUTPUT = 'arm5 G=' G ' H=' H
END
*------------------------------------------------- 2 k41_lambda_immediate_landed
*  k41 -- the IMMEDIATE pattern lambda, LANDED ARM ONLY (row lang-lambda-pattern-primitives).
*  ⭐ WHY THIS EXISTS BESIDE k40 RATHER THAN INSTEAD OF IT: k40 is the row's INSTRUMENT, authored
*  before the cure and RED ON PURPOSE until the whole feature lands (conditional lambda, backtrack
*  unqueue, and the stored-pattern round trip are all still unlanded). A red instrument cannot also
*  be a regression guard -- so this file grades the part that IS landed and is green today, and k40
*  keeps measuring the distance still to go. Deleting either one would lose a different thing.
*  ⛔ SELF-PINNED, NEVER sbl-GRADED: SPITBOL cannot even LEX this file -- sbl -bf dies at the Greek
*  line with ERROR 230 "syntax error: illegal character".
        &ANCHOR = 0
*  1. assignment expression inside the lambda, evaluated when the cursor passes
        N = 0
        X = 'ab'
        X 'a' LAMBDA(N = 5) 'b'                     :F(F1)
        OUTPUT = 'k41.1 matched N=' N               :(T2)
F1      OUTPUT = 'k41.1 FAIL'
*  2. expression FAILURE fails the match at that point
T2      X 'a' LAMBDA(LT(2, 1)) 'b'                  :S(F2)
        OUTPUT = 'k41.2 expr failure failed the match' :(T3)
F2      OUTPUT = 'k41.2 FAIL'
*  3. expression SUCCESS matches the null string and consumes nothing
T3      X 'a' LAMBDA(LT(1, 2)) 'b'                  :F(F3)
        OUTPUT = 'k41.3 expr success matched epsilon' :(T4)
F3      OUTPUT = 'k41.3 FAIL'
*  4. the Greek spelling is first-class and means the same thing
T4      M = 0
        X 'a' Λ(M = 7) 'b'                          :F(F4)
        OUTPUT = 'k41.4 greek matched M=' M         :(T5)
F4      OUTPUT = 'k41.4 FAIL'
*  5. IMMEDIATE is not undone by a later failure in the same match
T5      K = 0
        X 'a' LAMBDA(K = 3) LAMBDA(LT(2, 1)) 'b'    :S(F5)
        OUTPUT = 'k41.5 K=' K ' after failed match' :(END)
F5      OUTPUT = 'k41.5 FAIL'
END
