*----------------------------------------------------------- 20 m1_defer_x_thunk
        DEFINE('shift(a,b)')
        OPSYN('~', 'shift', 2)
        Expr0          =  LEN(1)
        Expr           =  *Expr0
        P              =  POS(0) ('=' ~ '=' *Expr) RPOS(0)
        '=x'           P                                               :F(NO)
        OUTPUT         =  'match'                                      :(FIN)
NO                OUTPUT         =  'nomatch'                                    :(FIN)
shift             shift          =  a                                            :(RETURN)
FIN
END
*------------------------------------------------------- 21 m1_defer_x_thunk_ctl
        DEFINE('shift(a,b)')
        OPSYN('~', 'shift', 2)
        Expr0          =  LEN(1)
        Expr           =  epsilon *Expr0
        P              =  POS(0) ('=' ~ '=' *Expr) RPOS(0)
        '=x'           P                                               :F(NO)
        OUTPUT         =  'match'                                      :(FIN)
NO                OUTPUT         =  'nomatch'                                    :(FIN)
shift             shift          =  a                                            :(RETURN)
FIN
END
