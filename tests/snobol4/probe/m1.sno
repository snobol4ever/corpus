*-------------------------------------------------- 13 m1_beauty_arbno_defer_min
        &ANCHOR      =  1
        Word         =  SPAN('ABCDEFGHIJKLMNOPQRSTUVWXYZ')
        Space        =  SPAN(' ') | LEN(0)
        Command      =  Word *Space
        Parse        =  ARBNO(*Command)
        Src          =  'START'
        Src          POS(0) *Parse *Space RPOS(0)                :F(FA)
        OUTPUT       =  'A ok'                                   :(B)
FA       OUTPUT       =  'A FAIL'
B        Src          =  'START HERE'
        Src          POS(0) *Parse *Space RPOS(0)                :F(FB)
        OUTPUT       =  'B ok'                                   :(C)
FB       OUTPUT       =  'B FAIL'
C        Src          =  'ONE TWO THREE'
        Src          POS(0) *Parse *Space RPOS(0)                :F(FC)
        OUTPUT       =  'C ok'                                   :(D)
FC       OUTPUT       =  'C FAIL'
D        Src          =
        Src          POS(0) *Parse *Space RPOS(0)                :F(FD)
        OUTPUT       =  'D ok'                                   :(END)
FD       OUTPUT       =  'D FAIL'
END
