        DEFINE('PC()')	:(PCe)
PC	PC = .d	:(NRETURN)
PCe	nP = '' . *PC()
        C = 'x'
        P = nP ARBNO(*C) nP
        Src = 'START'
        Src POS(0) P RPOS(0)	:S(Y)F(N)
Y	OUTPUT = 'match'	:(END)
N	OUTPUT = 'nomatch'
END
