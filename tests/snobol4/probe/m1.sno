*------------------------------------------------- 7 m1_alt_arm_eager_call_order
        DEFINE('u(u)')	:(ue)
u       OUTPUT = 'CALLED'
        u = REPLACE(u,'ab','AB')	:(RETURN)
ue      P = 'x' | u('b')
        OUTPUT = 'built'
        'B' ? P	:S(K)
        OUTPUT = 'nm'	:(E)
K       OUTPUT = 'ok'
E
END
