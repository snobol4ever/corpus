*------------------------------------------------------ 68 127_pat_json_keyvalue
        ws     = SPAN(' ') | LEN(0)
        digits = SPAN('0123456789')
        str    = '"' BREAK('"') . S '"'
        num    = digits . N
        bool   = FENCE('true' | 'false') . B
        value  = FENCE(str | num | bool)
        pair   = '"' BREAK('"') . K '"' ws ':' ws value
        s = '"age":42'
        s POS(0) pair RPOS(0)                                 :S(YES)F(NO)
YES     OUTPUT = 'k=' K ' s=' S ' n=' N ' b=' B               :(END)
NO      OUTPUT = 'fail'
END
