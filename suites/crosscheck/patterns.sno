*------------------------------------------------------ 28 064_replace_multi_arm
        &TRIM = 1
        A = 'alpha,beta,gamma,'
DEL A ',' = ''                              :S(DEL)
        OUTPUT = 'del: ' A
        B = 'XXmiddleXX'
        B 'XX' = 'yy'
        OUTPUT = 'head: ' B
        C = 'bodyZZ'
        C 'ZZ' = 'ww'
        OUTPUT = 'tail: ' C
        D = 'a.b.c.d'
GROW D '.' = '<->'                          :S(GROW)
        OUTPUT = 'grow: ' D
        E = 'aaaabbbbcccc'
        E 'bbbb' = '-'
        OUTPUT = 'shrink: ' E
        F = 'n=?'
        F '?' = 42
        OUTPUT = 'int: ' F
        G = 'swap:LEFT|RIGHT'
        G ('LEFT' . L1) '|' ('RIGHT' . R1) = R1 '|' L1
        OUTPUT = 'cap: ' G
        H = ',lead'
        H BREAK(',') ',' = 'K'
        OUTPUT = 'null: ' H
        S = 'one,two,three,four,five,six,seven,eight,nine,ten,'
        R = ''
INNER S BREAK(',') . W ',' = ''             :F(FIN)
        R = R W :(INNER)
FIN OUTPUT = 'loop: ' R
END
