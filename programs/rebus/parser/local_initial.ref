(STMT :subj (TT_FNC DEFINE (TT_QLIT "MAIN()/X")))
(STMT :go rb_1)
(STMT :lbl MAIN)
(STMT :subj (TT_VAR rb_init_MAIN) :goS rb_2)
(STMT :eq :subj (TT_VAR X) :repl (TT_ILIT 0))
(STMT :subj (TT_ASSIGN
  (TT_VAR rb_init_MAIN)
  (TT_ILIT 1)
))
(STMT :lbl rb_2)
(STMT :eq :subj (TT_VAR X) :repl (TT_ADD
  (TT_VAR X)
  (TT_ILIT 1)
))
(STMT :eq :subj (TT_VAR OUTPUT) :repl (TT_VAR X))
(STMT :go RETURN)
(STMT :lbl rb_1)
(STMT :subj (TT_FNC MAIN))
