(STMT :subj (E_FNC DEFINE (E_QLIT "MAIN()/X")))
(STMT :go rb_1)
(STMT :lbl MAIN)
(STMT :subj (E_VAR rb_init_MAIN) :goS rb_2)
(STMT :eq :subj (E_VAR X) :repl (E_ILIT 0))
(STMT :subj (E_ASSIGN
  (E_VAR rb_init_MAIN)
  (E_ILIT 1)
))
(STMT :lbl rb_2)
(STMT :eq :subj (E_VAR X) :repl (E_ADD
  (E_VAR X)
  (E_ILIT 1)
))
(STMT :eq :subj (E_VAR OUTPUT) :repl (E_VAR X))
(STMT :go RETURN)
(STMT :lbl rb_1)
(STMT :subj (E_FNC MAIN))
