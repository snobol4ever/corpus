(STMT :subj (AST_FNC DEFINE (AST_QLIT "MAIN()/X")))
(STMT :go rb_1)
(STMT :lbl MAIN)
(STMT :subj (AST_VAR rb_init_MAIN) :goS rb_2)
(STMT :eq :subj (AST_VAR X) :repl (AST_ILIT 0))
(STMT :subj (AST_ASSIGN
  (AST_VAR rb_init_MAIN)
  (AST_ILIT 1)
))
(STMT :lbl rb_2)
(STMT :eq :subj (AST_VAR X) :repl (AST_ADD
  (AST_VAR X)
  (AST_ILIT 1)
))
(STMT :eq :subj (AST_VAR OUTPUT) :repl (AST_VAR X))
(STMT :go RETURN)
(STMT :lbl rb_1)
(STMT :subj (AST_FNC MAIN))
