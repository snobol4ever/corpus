(STMT :subj (TT_FNC DATA (TT_QLIT "STACK(TOP,DATA)")))
(STMT :subj (TT_FNC DEFINE (TT_QLIT "PUSH(S,V)")))
(STMT :go rb_1)
(STMT :lbl PUSH)
(STMT :eq :subj (TT_IDX
  (TT_VAR S.DATA)
  (TT_ASSIGN
    (TT_VAR S.TOP)
    (TT_ADD
      (TT_VAR S.TOP)
      (TT_ILIT 1)
    )
  )
) :repl (TT_VAR V))
(STMT :go RETURN)
(STMT :lbl rb_1)
(STMT :subj (TT_FNC DEFINE (TT_QLIT "POP(S,V)")))
(STMT :go rb_2)
(STMT :lbl POP)
(STMT :eq :subj (TT_VAR V) :repl (TT_IDX
  (TT_VAR S.DATA)
  (TT_VAR S.TOP)
))
(STMT :eq :subj (TT_VAR S.TOP) :repl (TT_SUB
  (TT_VAR S.TOP)
  (TT_ILIT 1)
))
(STMT :eq :subj (TT_VAR POP) :repl (TT_VAR V))
(STMT :go RETURN)
(STMT :go RETURN)
(STMT :lbl rb_2)
(STMT :subj (TT_FNC DEFINE (TT_QLIT "MAIN()/S")))
(STMT :go rb_3)
(STMT :lbl MAIN)
(STMT :subj (TT_VAR rb_init_MAIN) :goS rb_4)
(STMT :eq :subj (TT_VAR S) :repl (TT_FNC STACK
  (TT_ILIT 0)
  (TT_FNC ARRAY (TT_QLIT "1:100"))
))
(STMT :subj (TT_ASSIGN
  (TT_VAR rb_init_MAIN)
  (TT_ILIT 1)
))
(STMT :lbl rb_4)
(STMT :subj (TT_FNC PUSH
  (TT_VAR S)
  (TT_ILIT 42)
))
(STMT :subj (TT_FNC PUSH
  (TT_VAR S)
  (TT_ILIT 99)
))
(STMT :eq :subj (TT_VAR OUTPUT) :repl (TT_FNC POP (TT_VAR S)))
(STMT :go RETURN)
(STMT :lbl rb_3)
(STMT :subj (TT_FNC MAIN))
