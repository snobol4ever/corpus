(STMT :subj (E_FNC DATA (E_QLIT "STACK(TOP,DATA)")))
(STMT :subj (E_FNC DEFINE (E_QLIT "PUSH(S,V)")))
(STMT :go rb_1)
(STMT :lbl PUSH)
(STMT :eq :subj (E_IDX
  (E_VAR S.DATA)
  (E_ASSIGN
    (E_VAR S.TOP)
    (E_ADD
      (E_VAR S.TOP)
      (E_ILIT 1)
    )
  )
) :repl (E_VAR V))
(STMT :go RETURN)
(STMT :lbl rb_1)
(STMT :subj (E_FNC DEFINE (E_QLIT "POP(S,V)")))
(STMT :go rb_2)
(STMT :lbl POP)
(STMT :eq :subj (E_VAR V) :repl (E_IDX
  (E_VAR S.DATA)
  (E_VAR S.TOP)
))
(STMT :eq :subj (E_VAR S.TOP) :repl (E_SUB
  (E_VAR S.TOP)
  (E_ILIT 1)
))
(STMT :eq :subj (E_VAR POP) :repl (E_VAR V))
(STMT :go RETURN)
(STMT :go RETURN)
(STMT :lbl rb_2)
(STMT :subj (E_FNC DEFINE (E_QLIT "MAIN()/S")))
(STMT :go rb_3)
(STMT :lbl MAIN)
(STMT :subj (E_VAR rb_init_MAIN) :goS rb_4)
(STMT :eq :subj (E_VAR S) :repl (E_FNC STACK
  (E_ILIT 0)
  (E_FNC ARRAY (E_QLIT "1:100"))
))
(STMT :subj (E_ASSIGN
  (E_VAR rb_init_MAIN)
  (E_ILIT 1)
))
(STMT :lbl rb_4)
(STMT :subj (E_FNC PUSH
  (E_VAR S)
  (E_ILIT 42)
))
(STMT :subj (E_FNC PUSH
  (E_VAR S)
  (E_ILIT 99)
))
(STMT :eq :subj (E_VAR OUTPUT) :repl (E_FNC POP (E_VAR S)))
(STMT :go RETURN)
(STMT :lbl rb_3)
(STMT :subj (E_FNC MAIN))
