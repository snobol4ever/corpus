(STMT :subj (AST_FNC DEFINE (AST_QLIT "MAIN()")))
(STMT :go rb_1)
(STMT :lbl MAIN)
(STMT :subj (AST_NUL) :goS rb_2 :goF rb_3)
(STMT :lbl rb_2)
(STMT :subj (AST_FNC EQ
  (AST_VAR X)
  (AST_ILIT 1)
))
(STMT :go rb_4)
(STMT :lbl rb_3)
(STMT :eq :subj (AST_VAR Y) :repl (AST_ILIT 10))
(STMT :lbl rb_4)
(STMT :go RETURN)
(STMT :lbl rb_1)
(STMT :subj (AST_FNC MAIN))
