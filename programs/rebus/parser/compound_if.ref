(STMT :subj (TT_FNC DEFINE (TT_QLIT "MAIN()")))
(STMT :go rb_1)
(STMT :lbl MAIN)
(STMT :subj (TT_NUL) :goS rb_2 :goF rb_3)
(STMT :lbl rb_2)
(STMT :subj (TT_VAR X))
(STMT :go rb_4)
(STMT :lbl rb_3)
(STMT :eq :subj (TT_VAR OUTPUT) :repl (TT_QLIT "yes"))
(STMT :eq :subj (TT_VAR X) :repl (TT_ILIT 2))
(STMT :lbl rb_4)
(STMT :go RETURN)
(STMT :lbl rb_1)
(STMT :subj (TT_FNC MAIN))
