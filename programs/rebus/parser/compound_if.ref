(STMT :subj (E_FNC DEFINE (E_QLIT "MAIN()")))
(STMT :go rb_1)
(STMT :lbl MAIN)
(STMT :subj (E_NUL) :goS rb_2 :goF rb_3)
(STMT :lbl rb_2)
(STMT :subj (E_VAR X))
(STMT :go rb_4)
(STMT :lbl rb_3)
(STMT :eq :subj (E_VAR OUTPUT) :repl (E_QLIT "yes"))
(STMT :eq :subj (E_VAR X) :repl (E_ILIT 2))
(STMT :lbl rb_4)
(STMT :go RETURN)
(STMT :lbl rb_1)
(STMT :subj (E_FNC MAIN))
