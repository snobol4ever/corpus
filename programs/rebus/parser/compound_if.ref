(STMT :subj (AST_FNC DEFINE (AST_QLIT "MAIN()")))
(STMT :go rb_1)
(STMT :lbl MAIN)
(STMT :subj (AST_NUL) :goS rb_2 :goF rb_3)
(STMT :lbl rb_2)
(STMT :subj (AST_VAR X))
(STMT :go rb_4)
(STMT :lbl rb_3)
(STMT :eq :subj (AST_VAR OUTPUT) :repl (AST_QLIT "yes"))
(STMT :eq :subj (AST_VAR X) :repl (AST_ILIT 2))
(STMT :lbl rb_4)
(STMT :go RETURN)
(STMT :lbl rb_1)
(STMT :subj (AST_FNC MAIN))
