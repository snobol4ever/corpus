(STMT :subj (AST_FNC DEFINE (AST_QLIT "PUSH(S,V)")))
(STMT :go rb_1)
(STMT :lbl PUSH)
(STMT :eq :subj (AST_IDX
  (AST_VAR S.DATA)
  (AST_ASSIGN
    (AST_VAR S.TOP)
    (AST_ADD
      (AST_VAR S.TOP)
      (AST_ILIT 1)
    )
  )
) :repl (AST_VAR V))
(STMT :go RETURN)
(STMT :lbl rb_1)
(STMT :subj (AST_FNC DEFINE (AST_QLIT "MAIN()")))
(STMT :go rb_2)
(STMT :lbl MAIN)
(STMT :subj (AST_FNC PUSH
  (AST_VAR S)
  (AST_ILIT 1)
))
