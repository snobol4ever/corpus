(STMT :subj (E_FNC DEFINE (E_QLIT "MAIN()")))
(STMT :go rb_1)
(STMT :lbl MAIN)
(STMT :subj (E_ASSIGN
  (E_VAR I)
  (E_ILIT 1)
))
(STMT :lbl rb_2)
(STMT :subj (E_FNC GT
  (E_VAR I)
  (E_ILIT 5)
) :goS rb_3)
(STMT :subj (E_ASSIGN
  (E_VAR I)
  (E_ADD
    (E_VAR I)
    (E_ILIT 1)
  )
))
(STMT :go rb_2)
(STMT :lbl rb_3)
(STMT :go RETURN)
(STMT :lbl rb_1)
(STMT :subj (E_FNC MAIN))
