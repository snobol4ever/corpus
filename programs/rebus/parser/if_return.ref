(STMT :subj (E_FNC DEFINE (E_QLIT "CHECK(N)")))
(STMT :go rb_1)
(STMT :lbl CHECK)
(STMT :subj (E_NUL) :goS rb_2 :goF rb_3)
(STMT :lbl rb_2)
(STMT :subj (E_FNC EQ
  (E_VAR N)
  (E_ILIT 0)
))
(STMT :go rb_4)
(STMT :lbl rb_3)
(STMT :eq :subj (E_VAR CHECK) :repl (E_VAR N))
(STMT :go RETURN)
(STMT :lbl rb_4)
(STMT :subj (E_VAR N))
(STMT :go RETURN)
(STMT :lbl rb_1)
(STMT :subj (E_FNC DEFINE (E_QLIT "MAIN()")))
(STMT :go rb_5)
(STMT :lbl MAIN)
(STMT :eq :subj (E_VAR OUTPUT) :repl (E_FNC CHECK (E_ILIT 5)))
(STMT :go RETURN)
(STMT :lbl rb_5)
(STMT :subj (E_FNC MAIN))
