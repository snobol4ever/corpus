(STMT :subj (TT_FNC DEFINE (TT_QLIT "MAIN()")))
(STMT :go rb_1)
(STMT :lbl MAIN)
(STMT :eq :subj (TT_VAR X) :repl (TT_ADD
  (TT_VAR X)
  (TT_ILIT 1)
))
(STMT :eq :subj (TT_VAR Y) :repl (TT_SUB
  (TT_VAR Y)
  (TT_ILIT 2)
))
(STMT :eq :subj (TT_VAR Z) :repl (TT_CAT
  (TT_VAR Z)
  (TT_QLIT "hi")
))
(STMT :subj (TT_FNC EXCHG
  (TT_VAR A)
  (TT_VAR B)
))
(STMT :go RETURN)
(STMT :lbl rb_1)
(STMT :subj (TT_FNC MAIN))
