(STMT :subj (TT_FNC DATA (TT_QLIT "POINT(X,Y)")))
(STMT :subj (TT_FNC DEFINE (TT_QLIT "DIST(P)")))
(STMT :go rb_1)
(STMT :lbl DIST)
(STMT :subj (TT_ADD
  (TT_MUL
    (TT_VAR P.X)
    (TT_VAR P.X)
  )
  (TT_MUL
    (TT_VAR P.Y)
    (TT_VAR P.Y)
  )
))
(STMT :go RETURN)
(STMT :lbl rb_1)
(STMT :subj (TT_FNC DEFINE (TT_QLIT "MAIN()")))
(STMT :go rb_2)
(STMT :lbl MAIN)
(STMT :eq :subj (TT_VAR Q) :repl (TT_FNC POINT
  (TT_ILIT 3)
  (TT_ILIT 4)
))
(STMT :eq :subj (TT_VAR OUTPUT) :repl (TT_FNC DIST (TT_VAR Q)))
(STMT :go RETURN)
(STMT :lbl rb_2)
(STMT :subj (TT_FNC MAIN))
