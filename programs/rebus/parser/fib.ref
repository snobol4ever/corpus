(STMT :subj (TT_FNC DEFINE (TT_QLIT "FIB(N)")))
(STMT :go rb_1)
(STMT :lbl FIB)
(STMT :subj (TT_NUL) :goS rb_2 :goF rb_3)
(STMT :lbl rb_2)
(STMT :subj (TT_FNC LE
  (TT_VAR N)
  (TT_ILIT 1)
))
(STMT :go rb_4)
(STMT :lbl rb_3)
(STMT :eq :subj (TT_VAR FIB) :repl (TT_VAR N))
(STMT :go RETURN)
(STMT :lbl rb_4)
(STMT :eq :subj (TT_VAR FIB) :repl (TT_ADD
  (TT_FNC FIB (TT_SUB
      (TT_VAR N)
      (TT_ILIT 1)
    ))
  (TT_FNC FIB (TT_SUB
      (TT_VAR N)
      (TT_ILIT 2)
    ))
))
(STMT :go RETURN)
(STMT :go RETURN)
(STMT :lbl rb_1)
(STMT :subj (TT_FNC DEFINE (TT_QLIT "MAIN()")))
(STMT :go rb_5)
(STMT :lbl MAIN)
(STMT :eq :subj (TT_VAR OUTPUT) :repl (TT_FNC FIB (TT_ILIT 7)))
(STMT :go RETURN)
(STMT :lbl rb_5)
(STMT :subj (TT_FNC MAIN))
