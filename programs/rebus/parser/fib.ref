(STMT :subj (E_FNC DEFINE (E_QLIT "FIB(N)")))
(STMT :go rb_1)
(STMT :lbl FIB)
(STMT :subj (E_NUL) :goS rb_2 :goF rb_3)
(STMT :lbl rb_2)
(STMT :subj (E_FNC LE
  (E_VAR N)
  (E_ILIT 1)
))
(STMT :go rb_4)
(STMT :lbl rb_3)
(STMT :eq :subj (E_VAR FIB) :repl (E_VAR N))
(STMT :go RETURN)
(STMT :lbl rb_4)
(STMT :eq :subj (E_VAR FIB) :repl (E_ADD
  (E_FNC FIB (E_SUB
      (E_VAR N)
      (E_ILIT 1)
    ))
  (E_FNC FIB (E_SUB
      (E_VAR N)
      (E_ILIT 2)
    ))
))
(STMT :go RETURN)
(STMT :go RETURN)
(STMT :lbl rb_1)
(STMT :subj (E_FNC DEFINE (E_QLIT "MAIN()")))
(STMT :go rb_5)
(STMT :lbl MAIN)
(STMT :eq :subj (E_VAR OUTPUT) :repl (E_FNC FIB (E_ILIT 7)))
(STMT :go RETURN)
(STMT :lbl rb_5)
(STMT :subj (E_FNC MAIN))
