START LOAD 1,ONE
      ADD 1,TWO
      STORE 1,SUM
      SUB 1,LIMIT
      BRGT 1,DONE
      BR START
DONE  LOADN 2,SUM
      LOAD 1,255
      LOAD 99,ONE
      LOAD 1,TAB(2)
      ADD 1,MISSING
      MUL 1,ONE(9)
      BR START
ONE   FDIV 0,0
TWO   FSUB 0,0
SUM   FADD 0,0
LIMIT FMUL 0,0
TAB   LOADA 0,0
