*  READL_driver - exercises READL(P): a sequence of input items read into a
*  list whose head is returned, P marking the end of the list.  Contract per
*  READL.sno header, whose own example is READL(POS(0) 'STOP').  Input is
*  READL_driver.in.
-INCLUDE "READL.sno"
        DEFINE('SHOW(L)')                       :(SHOW_END)
SHOW    SHOW  =  DIFFER(DATATYPE(L),'LINK')  '.' :S(RETURN)
        SHOW  =  VALUE(L) ' ' SHOW(NEXT(L))     :(RETURN)
SHOW_END
        OUTPUT  =  SHOW(READL(POS(0) 'STOP'))
        OUTPUT  =  SHOW(READL(POS(0) 'STOP'))
        OUTPUT  =  'DONE'
END
