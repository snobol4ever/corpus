(STMT :subj (TT_IF
  (TT_FNC EQ (TT_VAR x) (TT_ILIT 1))
  (TT_PROGRAM
    (TT_STMT
      (TT_ATTR :line (TT_QLIT "1"))
      (TT_ATTR :stno (TT_QLIT "1"))
      (TT_ATTR :subj (TT_VAR y))
      (TT_ATTR :eq)
      (TT_ATTR :repl (TT_ILIT 1))
    )
  )
  (TT_PROGRAM
    (TT_STMT
      (TT_ATTR :line (TT_QLIT "2"))
      (TT_ATTR :stno (TT_QLIT "5"))
      (TT_ATTR :subj
        (TT_IF
          (TT_FNC EQ (TT_VAR x) (TT_ILIT 2))
          (TT_PROGRAM
            (TT_STMT
              (TT_ATTR :line (TT_QLIT "1"))
              (TT_ATTR :stno (TT_QLIT "2"))
              (TT_ATTR :subj (TT_VAR y))
              (TT_ATTR :eq)
              (TT_ATTR :repl (TT_ILIT 2))
            )
          )
          (TT_PROGRAM
            (TT_STMT
              (TT_ATTR :line (TT_QLIT "2"))
              (TT_ATTR :stno (TT_QLIT "4"))
              (TT_ATTR :subj
                (TT_IF
                  (TT_FNC EQ (TT_VAR x) (TT_ILIT 3))
                  (TT_PROGRAM
                    (TT_STMT
                      (TT_ATTR :line (TT_QLIT "1"))
                      (TT_ATTR :stno (TT_QLIT "3"))
                      (TT_ATTR :subj (TT_VAR y))
                      (TT_ATTR :eq)
                      (TT_ATTR :repl (TT_ILIT 3))
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
))
