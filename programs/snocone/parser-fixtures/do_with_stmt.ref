(STMT :eq :subj (TT_VAR x) :repl (TT_ILIT 0))
(STMT :subj (TT_DO_WHILE
  (TT_PROGRAM
    (TT_STMT
      (TT_ATTR :line (TT_QLIT "2"))
      (TT_ATTR :stno (TT_QLIT "2"))
      (TT_ATTR :subj (TT_VAR x))
      (TT_ATTR :eq)
      (TT_ATTR :repl (TT_ADD (TT_VAR x) (TT_ILIT 1)))
    )
  )
  (TT_VAR x)
  (TT_QLIT "_Lcont_0001")
  (TT_QLIT "_Lend_0002")
))
