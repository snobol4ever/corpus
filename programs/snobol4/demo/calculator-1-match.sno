        &TRIM   =  0
        I       =  SPAN('0123456789')
        V       =  ANY(&LCASE)
        A       =  I | V | '(' *X ')'
        F       =  '+' *F | '-' *F | A
        T       =  F '*' *T | F '/' *T | F
        X       =  T '+' *X | T '-' *X | T
        C       =  POS(0) ARBNO(X CHAR(10)) RPOS(0)
        INPUT(.INPUT, 9, '[-f0 -r4000000]')
        src     =  INPUT  :F(error)
        src     ?  C  :F(error)
        OUTPUT  =  'matched bytes=' SIZE(src)  :(END)
error   OUTPUT  =  'Pattern match failed'
END
