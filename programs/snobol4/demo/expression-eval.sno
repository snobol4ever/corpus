*------------------------------------------------------------------------------
* expression-eval.sno — faithful SNOBOL4 rendition of the snobol4python
* calculator (V/I/E/X/C single-char pattern names): an EVALUATOR whose
* semantic actions fire only along the surviving parse path, via conditional
* assignment to NRETURN by-name targets (the crosscheck/control/expr_eval.sno
* idiom).  Grammar is the UNfactored alternative form on purpose — each
* alternative re-matches E, one character at a time, massive re-entry into
* the recursive *X — that re-matching is the benchmark load.
* Faithfulness notes vs the Python original: pop order preserved (SUB = tail
* minus E, DIV = tail / E); SPITBOL / truncates where Python // floors (bench
* inputs avoid '/'); no precedence, right-associative, as in the original.
* Variables live in a TABLE keyed by letter (faithful to globals()[N]);
* x=1, y=2, z=3; any other lowercase letter derefs to null = 0.  No bare
* single-letter globals: the official sbl folds identifier case, so x=1
* would clobber pattern X (found the hard way).
* Run: sbl -b expression-eval.sno < expression-eval.input
*      scrip --run expression-eval.sno < expression-eval.input
*------------------------------------------------------------------------------
        DEFINE('PSH()')                         :(PSH_x)
PSH     sp = sp + 1
        PSH = .S[sp]                            :(NRETURN)
PSH_x
        DEFINE('DRF(nm)')                       :(DRF_x)
DRF     nm POS(0) ANY(&LCASE) RPOS(0)           :F(DRF_n)
        DRF = vars[nm]                          :(RETURN)
DRF_n   DRF = nm                                :(RETURN)
DRF_x
        DEFINE('ADD()p1')                       :(ADD_x)
ADD     p1 = DRF(S[sp])
        sp = sp - 1
        S[sp] = p1 + DRF(S[sp])
        ADD = .dm                               :(NRETURN)
ADD_x
        DEFINE('SUB()p1')                       :(SUB_x)
SUB     p1 = DRF(S[sp])
        sp = sp - 1
        S[sp] = p1 - DRF(S[sp])
        SUB = .dm                               :(NRETURN)
SUB_x
        DEFINE('MUL()p1')                       :(MUL_x)
MUL     p1 = DRF(S[sp])
        sp = sp - 1
        S[sp] = p1 * DRF(S[sp])
        MUL = .dm                               :(NRETURN)
MUL_x
        DEFINE('DIV()p1')                       :(DIV_x)
DIV     p1 = DRF(S[sp])
        sp = sp - 1
        S[sp] = p1 / DRF(S[sp])
        DIV = .dm                               :(NRETURN)
DIV_x
        DEFINE('NEG()')                         :(NEG_x)
NEG     S[sp] = -DRF(S[sp])
        NEG = .dm                               :(NRETURN)
NEG_x
*------------------------------------------------------------------------------
        S = ARRAY(65536)
        V = ANY(&LCASE) . *PSH()
        I = SPAN('0123456789') . *PSH()
        E = V | I | '(' *X ')'
        X = E '+' *X . *ADD()
+         | E '-' *X . *SUB()
+         | E '*' *X . *MUL()
+         | E '/' *X . *DIV()
+         | '+' *X
+         | '-' *X . *NEG()
+         | E
        C = POS(0) X RPOS(0)
*------------------------------------------------------------------------------
        &TRIM = 1
        vars = TABLE()
        vars['x'] = 1
        vars['y'] = 2
        vars['z'] = 3
loop    line = INPUT                            :F(END)
        sp = 0
        line C                                  :F(bad)
        OUTPUT = DRF(S[1])                      :(loop)
bad     OUTPUT = 'Boo!'                         :(loop)
END
