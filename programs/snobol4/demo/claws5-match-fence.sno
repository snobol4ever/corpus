        &TRIM   =   0
        claws   =   POS(0)
+                   ARBNO(
+                     FENCE(
+                       (SPAN('0123456789')) '_CRD :_PUN'
+                     | (NOTANY('_') BREAK('_'))
+                       '_'
+                       (ANY(&UCASE) SPAN('0123456789' &UCASE))
+                     )
+                     SPAN(' ' CHAR(10))
+                   )
+                   RPOS(0)
        INPUT(.INPUT, 9, '[-f0 -r1000000]')
        src     =   INPUT  :F(error)
        src     ?   claws  :F(error)
        OUTPUT  =   'matched bytes=' SIZE(src)  :(END)
error   OUTPUT  =   'Pattern match failed'
END
