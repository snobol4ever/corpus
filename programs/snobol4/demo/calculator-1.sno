        DEFINE('EMIT()')                        :(EMIT_x)
EMIT    OUTPUT = DRF(S[1])
        sp = 0
        EMIT = .dm                              :(NRETURN)
EMIT_x

        DEFINE('PSH()')                         :(PSH_x)
PSH     PSH = .S[sp = sp + 1]                   :(NRETURN)
PSH_x
        DEFINE('DRF(nm)')                       :(DRF_x)
DRF     nm ? POS(0) ANY(&LCASE) RPOS(0)         :F(DRF_n)
        DRF = vars[nm]                          :(RETURN)
DRF_n   DRF = nm                                :(RETURN)
DRF_x
        DEFINE('ADD()p1')                       :(ADD_x)
ADD     p1 = DRF(S[sp])
        sp = sp - 1
        S[sp] = DRF(S[sp]) + p1
        ADD = .dm                               :(NRETURN)
ADD_x
        DEFINE('SUB()p1')                       :(SUB_x)
SUB     p1 = DRF(S[sp])
        sp = sp - 1
        S[sp] = DRF(S[sp]) - p1
        SUB = .dm                               :(NRETURN)
SUB_x
        DEFINE('MUL()p1')                       :(MUL_x)
MUL     p1 = DRF(S[sp])
        sp = sp - 1
        S[sp] = DRF(S[sp]) * p1
        MUL = .dm                               :(NRETURN)
MUL_x
        DEFINE('DIV()p1')                       :(DIV_x)
DIV     p1 = DRF(S[sp])
        sp = sp - 1
        S[sp] = DRF(S[sp]) / p1
        DIV = .dm                               :(NRETURN)
DIV_x
        DEFINE('NEG()')                         :(NEG_x)
NEG     S[sp] = -DRF(S[sp])
        NEG = .dm                               :(NRETURN)
NEG_x
*------------------------------------------------------------------------------
        S = ARRAY(65536)
        V = ANY(&LCASE) . *PSH()
        I = SPAN('0123456789') . *PSH()
        A = V | I | FENCE('(' *X ')')
        F = A | FENCE('+' *F) | FENCE('-' *F . *NEG())
        T = F ( FENCE('*' *T . *MUL()) | FENCE('/' *T . *DIV()) | '' )
        X = T ( FENCE('+' *X . *ADD()) | FENCE('-' *X . *SUB()) | '' )
        eol = CHAR(10) FENCE
        C = POS(0) ARBNO(X eol . *EMIT()) RPOS(0)
*------------------------------------------------------------------------------
        &TRIM = 0
        vars = TABLE()
        vars['x'] = 1
        vars['y'] = 2
        vars['z'] = 3
* read all at once: raw fd 0, one 4 MiB-max transfer (larger inputs truncate)
        INPUT(.INPUT, 9, '[-f0 -r4194304]')
        src = INPUT
        t0 = TIME()
        src C                                   :F(bad)
        t1 = TIME()
        TERMINAL = 'match_ms=' (t1 - t0)        :(END)
bad     t1 = TIME()
        OUTPUT = 'Boo!'
        TERMINAL = 'match_ms=' (t1 - t0)
END
