*------------------------------------------------------------------------------
* json-match-fence.sno — json-match.sno plus bare FENCE locking in jobject's
* and jarray's closing bracket, mirroring json.sno (the WORK member)'s own
* '}' (epsilon . *eobj()) FENCE / ']' (epsilon . *earr()) FENCE rows exactly
* (json.sno lines ~243/246) — json-match.sno dropped those FENCEs along with
* the semantic actions they were adjacent to, even though the FENCE itself
* has nothing to do with the stripped side effects: it stops the pattern
* matcher from backing INTO a completed object/array and retrying earlier
* jmember/jelement alternatives once '}'/']' has already matched (manual
* Ch.9 p.125, FENCE(P) reference entry — "alternatives within the fenced
* pattern are not examined when the scanner is backing up").  Distinct
* recognizer from json-match.sno for any input with a failing match AFTER a
* successfully-parsed nested object/array (before this fix, json-match.sno
* and json-match-fence.sno were BYTE-IDENTICAL, BOARD B-7(i)).
* Run: sbl -b -d512m -i64m -s256m json-match-fence.sno < twitter.json
*      snobol4 -b -f -d 8m -P 4m -S 4m json-match-fence.sno < twitter.json
*      scrip --run json-match-fence.sno < twitter.json
* (json-match-fence.ref was built from twitter.json, not citm_catalog.json —
* BOARD B-7(ii); the -CASE 0 prepend cited elsewhere in this family is a
* control-statement per manual Ch.14 p.172, not a valid sbl CLI flag.)
*------------------------------------------------------------------------------
                bslash         =  CHAR(92)
                ws             =  FENCE(SPAN(' ' CHAR(9) CHAR(10) CHAR(13)) | '')
                hex            =  '0123456789abcdefABCDEF'
                dig            =  '0123456789'
*------------------------------------------------------------------------------
                jescape        =  bslash
+                                 ( ANY('"/bfnrt\')
+                                 | 'u' ANY('0123456789abcdefABCDEF') ANY('0123456789abcdefABCDEF') ANY('0123456789abcdefABCDEF') ANY('0123456789abcdefABCDEF')
+                                 )
                jchunk         =  BREAK('"\' CHAR(10) CHAR(13))
                jstring        =  '"' jchunk ARBNO(jescape jchunk) '"'
*------------------------------------------------------------------------------
                jnumber        =  FENCE('-' | '')
+                                 ( '0' | ANY('123456789') FENCE(SPAN('0123456789') | '') )
+                                 FENCE('.' SPAN('0123456789') | '')
+                                 FENCE(ANY('eE') FENCE(ANY('+-') | '') SPAN('0123456789') | '')
*------------------------------------------------------------------------------
                jmember        =  ws jstring ws ':' *jelement
                jobject        =  '{' ( jmember ARBNO(',' jmember) | ws ) '}' FENCE
                jarray         =  '[' ( *jelement ARBNO(',' *jelement) | ws ) ']' FENCE
                jvalue         =  jstring | jnumber | jobject | jarray
+                                 | 'true' | 'false' | 'null'
                jelement       =  ws *jvalue ws
                json           =  POS(0) jelement RPOS(0)
*------------------------------------------------------------------------------
                &TRIM          =  0
*------------------------------------------------------------------------------
*  ONE READ — SPITBOL raw mode: -f0 attaches stdin, -r sets raw record length;
*  newlines come back in-string, short read at EOF (manual, file processing options)
                INPUT(.INPUT, 9, '[-f0 -r1000000]')
                src             =   INPUT                       :F(fail)
                src             json                            :F(fail)
                OUTPUT          =  'matched bytes=' SIZE(src)   :(END)
fail            OUTPUT          =  'Pattern match failed'
*------------------------------------------------------------------------------
END
