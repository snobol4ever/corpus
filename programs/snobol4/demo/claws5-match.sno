*------------------------------------------------------------------------------
* claws5-match.sno — claws5 scanner ISOLATED: whole file in memory, ONE BIG
* MATCH, side-effect counters only (no tables, no printing pass).
* Lifted verbatim from claws5.sno: the claws pattern, the &ALPHABET nl trick,
* the (epsilon . *fn()) deferred fire-side-effect NRETURN workers.
* Run: sbl -b -d512m -i64m (with -CASE 0 prepend) claws5-match.sno < CLAWS5inTASA.dat
*      snobol4 -b -f -d 8m -P 4m -S 4m claws5-match.sno < CLAWS5inTASA.dat
*      scrip --run claws5-match.sno < CLAWS5inTASA.dat
*------------------------------------------------------------------------------
                &ALPHABET       POS(10) LEN(1) . nl
                DIGITS          =  '0123456789'
                UCASE           =  'ABCDEFGHIJKLMNOPQRSTUVWXYZ'
*------------------------------------------------------------------------------
                DEFINE('new_sent()')                            :(new_sent_end)
new_sent        nsent           =  nsent + 1
                sentsum         =  sentsum + num
                new_sent        =  .dummy                       :(NRETURN)
new_sent_end
*------------------------------------------------------------------------------
                DEFINE('add_tok()')                             :(add_tok_end)
add_tok         ntok            =  ntok + 1
                tokchars        =  tokchars + SIZE(wrd) + SIZE(tag)
                add_tok         =  .dummy                       :(NRETURN)
add_tok_end
*------------------------------------------------------------------------------
slurp           line            =   INPUT                       :F(slurp_done)
                src             =   src line                    :(slurp)
slurp_done
                nsent           =   0
                sentsum         =   0
                ntok            =   0
                tokchars        =   0
*------------------------------------------------------------------------------
                claws           =
+               POS(0)
+               ARBNO(
+                ( (SPAN(DIGITS) . num) '_CRD :_PUN'
+                  (epsilon . *new_sent())
+                | (NOTANY('_') BREAK('_')) . wrd
+                  '_'
+                  (ANY(UCASE) SPAN(DIGITS UCASE)) . tag
+                  (epsilon . *add_tok())
+                )
+                ' '
+               )
+               RPOS(0)
*------------------------------------------------------------------------------
                src             claws                           :F(fail)
                OUTPUT          =  'bytes=' SIZE(src) ' sentences=' nsent
+                                  ' sentsum=' sentsum ' tokens=' ntok
+                                  ' tokchars=' tokchars         :(END)
fail            OUTPUT          =  'Pattern match failed'
*------------------------------------------------------------------------------
END
