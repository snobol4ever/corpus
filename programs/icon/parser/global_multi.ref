(STMT :subj (AST_GLOBAL
  (AST_VAR x)
  (AST_VAR y)
  (AST_VAR z)
))
(STMT :subj (AST_FNC main
  (AST_VAR main)
  (AST_ASSIGN
    (AST_VAR x)
    (AST_ILIT 1)
  )
  (AST_ASSIGN
    (AST_VAR y)
    (AST_ILIT 2)
  )
  (AST_ASSIGN
    (AST_VAR z)
    (AST_ADD
      (AST_VAR x)
      (AST_VAR y)
    )
  )
))
