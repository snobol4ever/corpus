(STMT :subj (AST_FNC main
  (AST_VAR main)
  (AST_WHILE
    (AST_GT
      (AST_VAR x)
      (AST_ILIT 0)
    )
    (AST_SEQ_EXPR
      (AST_ASSIGN
        (AST_VAR x)
        (AST_SUB
          (AST_VAR x)
          (AST_ILIT 1)
        )
      )
      (AST_FNC
        (AST_VAR write)
        (AST_VAR x)
      )
    )
  )
))
