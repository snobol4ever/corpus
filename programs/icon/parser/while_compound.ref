(STMT :subj (TT_FNC main
  (TT_VAR main)
  (TT_WHILE
    (TT_GT
      (TT_VAR x)
      (TT_ILIT 0)
    )
    (TT_SEQ_EXPR
      (TT_ASSIGN
        (TT_VAR x)
        (TT_SUB
          (TT_VAR x)
          (TT_ILIT 1)
        )
      )
      (TT_FNC
        (TT_VAR write)
        (TT_VAR x)
      )
    )
  )
))
