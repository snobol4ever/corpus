(STMT :subj (AST_FNC main
  (AST_VAR main)
  (AST_CASE
    (AST_VAR x)
    (AST_ILIT 1)
    (AST_FNC
      (AST_VAR write)
      (AST_QLIT "one")
    )
    (AST_ILIT 2)
    (AST_FNC
      (AST_VAR write)
      (AST_QLIT "two")
    )
    (AST_FNC
      (AST_VAR write)
      (AST_QLIT "other")
    )
  )
))
