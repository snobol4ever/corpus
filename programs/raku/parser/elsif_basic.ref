(STMT :subj (AST_FNC main
  (AST_VAR main)
  (AST_ASSIGN
    (AST_VAR x)
    (AST_ILIT 2)
  )
  (AST_IF
    (AST_EQ
      (AST_VAR x)
      (AST_ILIT 1)
    )
    (AST_SEQ_EXPR (AST_FNC write
        (AST_VAR write)
        (AST_QLIT "one")
      ))
    (AST_IF
      (AST_EQ
        (AST_VAR x)
        (AST_ILIT 2)
      )
      (AST_SEQ_EXPR (AST_FNC write
          (AST_VAR write)
          (AST_QLIT "two")
        ))
      (AST_SEQ_EXPR (AST_FNC write
          (AST_VAR write)
          (AST_QLIT "other")
        ))
    )
  )
))
