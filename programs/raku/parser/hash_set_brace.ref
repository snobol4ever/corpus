(STMT :subj (AST_FNC main
  (AST_VAR main)
  (AST_ASSIGN
    (AST_VAR h)
    (AST_QLIT "")
  )
  (AST_ASSIGN
    (AST_VAR k)
    (AST_QLIT "foo")
  )
  (AST_FNC hash_set
