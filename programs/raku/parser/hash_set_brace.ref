(STMT :subj (TT_FNC main
  (TT_VAR main)
  (TT_ASSIGN
    (TT_VAR h)
    (TT_QLIT "")
  )
  (TT_ASSIGN
    (TT_VAR k)
    (TT_QLIT "foo")
  )
  (TT_FNC hash_set
    (TT_VAR hash_set)
    (TT_VAR h)
    (TT_VAR k)
    (TT_QLIT "baz")
  )
  (TT_FNC write
    (TT_VAR write)
    (TT_FNC hash_get
      (TT_VAR hash_get)
      (TT_VAR h)
      (TT_VAR k)
    )
  )
))
