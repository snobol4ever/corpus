(STMT :subj (TT_ASSIGN (TT_VAR s) (TT_QLIT "abc123")))
(STMT :subj (TT_IF (TT_SMATCH (TT_VAR s) (TT_QLIT "\\d+") (TT_QLIT "match")) (TT_SEQ_EXPR (TT_SAY (TT_QLIT "digit")))))
(STMT :subj (TT_IF (TT_SMATCH (TT_VAR s) (TT_QLIT "[a-z]+") (TT_QLIT "match")) (TT_SEQ_EXPR (TT_SAY (TT_QLIT "lower")))))
(STMT :subj (TT_IF (TT_SMATCH (TT_VAR s) (TT_QLIT "a|b") (TT_QLIT "match")) (TT_SEQ_EXPR (TT_SAY (TT_QLIT "alt")))))
