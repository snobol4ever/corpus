(STMT :subj (TT_FNC Dog__speak
  (TT_VAR Dog__speak)
  (TT_VAR self)
  (TT_FNC write
    (TT_VAR write)
    (TT_QLIT "woof")
  )
))
(STMT :subj (TT_RECORD Dog (TT_VAR name)))
(STMT :subj (TT_FNC main
  (TT_VAR main)
  (TT_NUL)
  (TT_ASSIGN
    (TT_VAR d)
    (TT_FNC raku_new
      (TT_VAR raku_new)
      (TT_QLIT "Dog")
      (TT_QLIT "name")
      (TT_QLIT "Rex")
    )
  )
  (TT_FNC write
    (TT_VAR write)
    (TT_FIELD name (TT_VAR d))
  )
))
