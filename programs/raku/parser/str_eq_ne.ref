(STMT :subj (E_FNC main
  (E_VAR main)
  (E_IF
    (E_LEQ
      (E_VAR a)
      (E_VAR b)
    )
    (E_SEQ_EXPR (E_FNC write
        (E_VAR write)
        (E_VAR a)
      ))
  )
  (E_IF
    (E_LNE
      (E_VAR a)
      (E_VAR b)
    )
    (E_SEQ_EXPR (E_FNC write
        (E_VAR write)
        (E_VAR b)
      ))
  )
))
