(STMT :subj (AST_FNC main
  (AST_VAR main)
  (AST_IF
    (AST_LEQ
      (AST_VAR a)
      (AST_VAR b)
    )
    (AST_SEQ_EXPR (AST_FNC write
        (AST_VAR write)
        (AST_VAR a)
      ))
  )
  (AST_IF
    (AST_LNE
      (AST_VAR a)
      (AST_VAR b)
    )
    (AST_SEQ_EXPR (AST_FNC write
        (AST_VAR write)
        (AST_VAR b)
      ))
  )
))
