(STMT :subj (TT_FNC main
  (TT_VAR main)
  (TT_IF
    (TT_LEQ
      (TT_VAR a)
      (TT_VAR b)
    )
    (TT_SEQ_EXPR (TT_FNC write
        (TT_VAR write)
        (TT_VAR a)
      ))
  )
  (TT_IF
    (TT_LNE
      (TT_VAR a)
      (TT_VAR b)
    )
    (TT_SEQ_EXPR (TT_FNC write
        (TT_VAR write)
        (TT_VAR b)
      ))
  )
))
