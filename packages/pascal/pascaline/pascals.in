program sieve(output);
const max = 60;
var flags: array [2..max] of boolean;
    i, k, count: integer;
function gcd(a, b: integer): integer;
begin
   if b = 0 then gcd := a else gcd := gcd(b, a mod b)
end;
begin
   for i := 2 to max do flags[i] := true;
   count := 0;
   for i := 2 to max do
      if flags[i] then begin
         count := count + 1;
         write(i: 4);
         k := i + i;
         while k <= max do begin flags[k] := false; k := k + i end
      end;
   writeln;
   writeln('primes below ', max: 1, ': ', count: 1);
   writeln('gcd(1071, 462) = ', gcd(1071, 462): 1)
end.
