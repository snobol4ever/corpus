{To identify valid characters in indentifiers}
var I: integer;
var TS: string;
var Good,Bad: string;
begin
{Test first characters in a symbol}
Good:=''; Bad:='';
for I:=$21 to $7F do
	begin
	TS:=Char(I);
	if IsValidIdent(TS) then Good:=Good+TS
	else Bad:=Bad+TS;
	end;
