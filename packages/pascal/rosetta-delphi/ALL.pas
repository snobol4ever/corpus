function IsMersennePrime(P: int64): boolean;
{Test for Mersenne Prime - P cannot be bigger than 63}
{Because (1 shl 64) would be bigger than in64}
var S,MP: int64;
var I: integer;
begin
if P= 2 then Result:=true
else
	begin
	MP:=(1 shl P) - 1;
	S:=4;
	for I:=3 to P do
		begin
		S:=(S * S - 2) mod MP;
		end;
	Result:=S = 0;
	end;
end;


