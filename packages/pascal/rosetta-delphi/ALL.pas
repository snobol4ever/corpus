function GetMagicNumber(N: double): double;
begin
Result:=N * (((N * N) + 1) / 2);
end;

function GetNumberLess(N: double): integer;
var M: double;
begin
for Result:=1 to High(Integer) do
	begin
	M:=GetMagicNumber(Result);
	if M>N then break;
	end;
end;

