var I: integer;
begin
{Create Sieve}
Sieve:=TPrimeSieve.Create;
{Test cannot handle values bigger than 64}
Sieve.Intialize(64);
for I:=0 to Sieve.PrimeCount-1 do
 if IsMersennePrime(Sieve.Primes[I]) then
	begin
	Memo.Lines.Add(IntToStr(Sieve.Primes[I]));
	end;
Sieve.Free;
end;



