  if n <= 1 then
  begin
    with b.Canvas do
    begin
      Pen.Color := p;
      MoveTo(Trunc(x + 0.5), Trunc(y + 0.5));
      LineTo(Trunc(x + d * _cos[a] + 0.5), Trunc(y + d * _sin[a] + 0.5));
      exit;
    end;
  end;

  d := d * s;
  var a1 := (a - t) and 7;
  var a2 := (a + t) and 7;

  dragon(n - 1, a1, 1, d, x, y, b);
  dragon(n - 1, a2, -1, d, x + d * _cos[a1], y + d * _sin[a1], b);
end;

