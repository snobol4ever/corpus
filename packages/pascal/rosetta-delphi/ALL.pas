function IsGiugaNumber(N: integer): boolean;
var IA: TIntegerDynArray;
var I,V: integer;
begin
Result:=False;
if IsPrime(N) then exit;
GetPrimeFactors(N,IA);
for I:=0 to High(IA) do
	begin
	V:=N div IA[I] - 1;
	if (V mod IA[I])<>0 then exit;
	end;
Result:=True;
end;

