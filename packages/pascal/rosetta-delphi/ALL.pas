function IsDisarium(N: integer): boolean;
{Sum all powers of the digits raised to position power}
var S: string;
var I,J: integer;
var Sum: int64;
begin
Sum:=0;
S:=IntToStr(N);
for I:=1 to Length(S) do
	begin
	Sum:=Sum+GetPower(byte(S[I])-$30,I);
	end;
Result:=Sum=N;
end;


