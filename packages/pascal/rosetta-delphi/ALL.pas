  for i := 1 to wordFractal.Length do
  begin
    g.LineTo(x + dx, y + dy);
    inc(x, dx);
    inc(y, dy);
    if wordFractal[i] = '0' then
    begin
      tx := dx;
      if Odd(i) then
      begin
        dx := dy;
        dy := -tx;
      end
      else
      begin
        dx := -dy;
        dy := tx;
      end;
    end;
  end;
end;

