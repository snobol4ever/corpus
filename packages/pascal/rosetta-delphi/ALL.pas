function GetWordFractal(n: Integer): string;
var
  f1, f2, tmp: string;
  i: Integer;
begin
  case n of
    0:
      Result := '';
    1:
      Result := '1';
  else
    begin
      f1 := '1';
      f2 := '0';

      for i := n - 2 downto 1 do
      begin
        tmp := f2;
        f2 := f2 + f1;
        f1 := tmp;
      end;

      Result := f2;
    end;
  end;
end;

procedure DrawWordFractal(n: Integer; g: TCanvas; x, y, dx, dy: integer);
var
  i, tx: Integer;
  wordFractal: string;
