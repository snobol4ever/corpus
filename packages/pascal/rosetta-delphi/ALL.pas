begin
Cnt:=0;
S:='';
for I:=1 to 999 do
 if IsDivisible(I) then
  begin
  Inc(Cnt);
  S:=S+Format('%4D',[I]);
  If (Cnt mod 10)=0 then S:=S+#$0D#$0A;
  end;
Memo.Lines.Add('Count='+IntToStr(Cnt));
Memo.Lines.Add(S);
end;

