Cnt:=0;
{Get palindromes and test them}
for I:=0 to high(Integer) do
   begin
   {Get next palinedrome}
   P:=GetNthPalindrome(I);
   {Is Gapful and has specified EndDigit}
   if IsGapFul(P) and HasEndDigit(P,EndDigit) then
