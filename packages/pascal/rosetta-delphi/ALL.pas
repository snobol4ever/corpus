type
  TextonymsChecker = class
  private
    Total, Elements, Textonyms, MaxFound: Integer;
    MaxStrings: TList<string>;
    Values: TDictionary<string, TList<string>>;
    FFileName: TFileName;
    function Map(c: Char): Char;
