  end;

  j := x;
  while j >= y do
  begin
    process(j);
    dec(j, -z);
  end;

  j := p;
  while j <= p + one do
  begin
    process(j);
    inc(j);
  end;

  writeln(format('sum  =  %d  ', [sum]));
  writeln(format('prod =  %d  ', [prod]));
  Readln;
end.
