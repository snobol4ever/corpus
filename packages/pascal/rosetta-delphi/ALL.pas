var S: string;
const Max = 123456789;
begin
if Assigned(Prog) then Prog(0);
S:='';
Cnt:=0;
for I:=2 to Max do
	begin
	if ((I mod 1000000)=0) and Assigned(Prog) then Prog(Trunc(100*(I/Max)));
	if IsDescending(I) and IsPrime(I) then
		begin
		S:=S+Format('%12.0n', [I*1.0]);
		Inc(Cnt);
		if (Cnt mod 8)=0 then
			begin
			Memo.Lines.Add(S);
			S:='';
			end;
		end;
	end;
if S<>'' then Memo.Lines.Add(S);
