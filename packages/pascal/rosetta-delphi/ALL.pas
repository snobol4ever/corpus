  Result := '[';
  for i := 0 to 2 do
  begin
    if i > 0 then
      Result := Result + #10;
    Result := Result + '[';
    for j := 0 to 2 do
    begin
      if j > 0 then
        Result := Result + ', ';
      Result := Result + format('%5.2f', [values[i, j]]);
    end;
    Result := Result + ']';
  end;
  Result := Result + ']';
end;

