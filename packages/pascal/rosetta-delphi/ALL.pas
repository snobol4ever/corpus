N1:=0; N2:=1;
while true do
	begin
	{Calculate next Fib number}
	T:=N1+N2;
	N1:=N2; N2:=T;
	{Test if it is prime}
	if IsPrime(N2) then
		begin
		Inc(Cnt);
		Memo.Lines.Add(IntToStr(N2));
		if Cnt>=9 then break;
		end;
	end;
end;
