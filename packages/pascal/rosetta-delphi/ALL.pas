  TProperDivisors = array of Integer;

function GetProperDivisors(const value: Integer): TProperDivisors;
var
  i, count: Integer;
begin
  count := 0;

  for i := 1 to value div 2 do
  begin
    if value mod i = 0 then
    begin
      inc(count);
      SetLength(result, count);
      Result[count - 1] := i;
    end;
  end;
