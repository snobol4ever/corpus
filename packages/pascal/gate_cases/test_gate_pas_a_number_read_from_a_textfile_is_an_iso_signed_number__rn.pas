program rn(input, output);
var i, j, k: integer; r, s, t, u: real; c: char;
begin
  read(i, j, k); writeln(i, ' ', j, ' ', k);
  read(r, s, t, u); writeln(r:10:3, s:12:3, t:10:3, u:10:3);
  read(i, c); writeln(i, ' [', c, ']');
  readln; read(r); writeln(r:14:6);
  readln(i); writeln(i);
  read(j); writeln(j)
end.
