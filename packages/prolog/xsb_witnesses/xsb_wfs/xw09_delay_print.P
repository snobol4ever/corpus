u :- tnot(u).
t1(a) :- u.
t1(b).
t4(X) :- t1(X), tnot(t4(X)).
test :- ( t1(_), fail ; true ), ( t4(_), fail ; true ),
  ( get_residual(t1(X), D), write(answer(t1(X), D)), nl, fail ; true ),
