atom_length(hello,A) => [atom_length(hello,5)]
atom_length('',A) => [atom_length('',0)]
atom_length(abc,4) => []
atom_length(A,B) => error(instantiation_error)
atom_length(123,A) => error(type_error(atom,123))
atom_length(abc,foo) => error(type_error(integer,foo))
atom_concat(abc,def,A) => [atom_concat(abc,def,abcdef)]
atom_concat(A,B,abc) => [atom_concat('',abc,abc),atom_concat(a,bc,abc),atom_concat(ab,c,abc),atom_concat(abc,'',abc)]
atom_concat(A,def,abcdef) => [atom_concat(abc,def,abcdef)]
atom_concat(ab,A,xyz) => []
atom_concat(a,A,B) => error(instantiation_error)
atom_concat(f(x),b,A) => error(type_error(atom,f(x)))
sub_atom(abcde,1,3,A,B) => [sub_atom(abcde,1,3,1,bcd)]
sub_atom(ab,A,B,C,D) => [sub_atom(ab,0,0,2,''),sub_atom(ab,0,1,1,a),sub_atom(ab,0,2,0,ab),sub_atom(ab,1,0,1,''),sub_atom(ab,1,1,0,b),sub_atom(ab,2,0,0,'')]
sub_atom(banana,A,2,B,an) => [sub_atom(banana,1,2,3,an),sub_atom(banana,3,2,1,an)]
sub_atom(abc,A,B,C,xyz) => []
sub_atom(A,B,C,D,E) => error(instantiation_error)
sub_atom(abc,a,A,B,C) => error(type_error(integer,a))
atom_chars(abc,A) => [atom_chars(abc,[a,b,c])]
atom_chars(A,[h,i]) => [atom_chars(hi,[h,i])]
atom_chars('',A) => [atom_chars('',[])]
atom_chars(abc,[a,b]) => []
atom_chars(A,[a|B]) => error(instantiation_error)
atom_chars(A,[a,f(b)]) => error(type_error(character,f(b)))
atom_codes(abc,A) => [atom_codes(abc,[97,98,99])]
atom_codes(A,[104,105]) => [atom_codes(hi,[104,105])]
atom_codes(abc,[97]) => []
atom_codes(A,B) => error(instantiation_error)
atom_codes(A,[a]) => error(type_error(integer,a))
number_atom(42,A) => [number_atom(42,'42')]
number_atom(A,'3.5') => [number_atom(3.5,'3.5')]
number_atom(7,'8') => []
number_atom(A,B) => error(instantiation_error)
number_atom(a,A) => error(type_error(number,a))
number_chars(12,A) => [number_chars(12,['1','2'])]
number_chars(A,['4','.','5']) => [number_chars(4.5,['4','.','5'])]
number_chars(A,[' ','1']) => [number_chars(1,[' ','1'])]
number_chars(3,['4']) => []
number_chars(a,A) => error(type_error(number,a))
number_chars(A,[a|B]) => error(instantiation_error)
number_codes(-7,A) => [number_codes(-7,[45,55])]
number_codes(A,[49,48]) => [number_codes(10,[49,48])]
number_codes(A,B) => error(instantiation_error)
number_codes(f(x),A) => error(type_error(number,f(x)))
char_code(a,A) => [char_code(a,97)]
char_code(A,98) => [char_code(b,98)]
char_code(a,98) => []
char_code(A,B) => error(instantiation_error)
char_code(ab,A) => error(type_error(character,ab))
name(abc,A) => [name(abc,[97,98,99])]
name(123,A) => [name(123,[49,50,51])]
name(A,[52,50]) => [name(42,[52,50])]
name(A,[97,98]) => [name(ab,[97,98])]
name(A,B) => error(instantiation_error)
name(f(x),A) => error(type_error(atomic,f(x)))
lower_upper(a,A) => [lower_upper(a,'A')]
lower_upper(A,'B') => [lower_upper(b,'B')]
lower_upper(a,'A') => [lower_upper(a,'A')]
lower_upper(a,'B') => []
lower_upper('1',A) => [lower_upper('1','1')]
lower_upper(A,B) => error(instantiation_error)
current_atom(abc) => [current_atom(abc)]
atom_property(hello,length(A)) => [atom_property(hello,length(5))]
atom_property(-,prefix_op) => [atom_property(-,prefix_op)]
atom_property(+,infix_op) => [atom_property(+,infix_op)]
atom_property(abc,infix_op) => []
atom_property('hello world',needs_quotes) => [atom_property('hello world',needs_quotes)]
atom_property(abc,needs_quotes) => []
\+ \+ (atom_property(abc,hash(A)),integer(A)) => [\+ \+ (atom_property(abc,hash(B)),integer(B))]
atom_property(abc,bogus) => error(domain_error(atom_property,bogus))
\+ \+ (new_atom(A),atom(A)) => [\+ \+ (new_atom(B),atom(B))]
\+ \+ (new_atom(A),new_atom(B),A\==B) => [\+ \+ (new_atom(C),new_atom(D),C\==D)]
new_atom(abc) => error(uninstantiation_error(abc))
\+ \+ (new_atom(foo_,A),atom(A),sub_atom(A,0,4,B,foo_)) => [\+ \+ (new_atom(foo_,C),atom(C),sub_atom(C,0,4,D,foo_))]
new_atom(A,B) => error(instantiation_error)
new_atom(3,A) => error(type_error(atom,3))
