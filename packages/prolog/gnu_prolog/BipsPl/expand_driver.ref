expand_term((a-->b,c),A) => [expand_term((a-->b,c),(a(B,C):-b(B,D),c(D,C)))]
expand_term((a-->[x],b),A) => [expand_term((a-->[x],b),(a([x|B],C):-b(B,C)))]
expand_term((a-->[x,y]),A) => [expand_term((a-->[x,y]),(a([x,y|B],B):-true))]
expand_term((a-->[]),A) => [expand_term((a-->[]),(a(B,B):-true))]
expand_term((a(A)-->{A=1},!,b),B) => [expand_term((a(C)-->{C=1},!,b),(a(C,D,E):-C=1,!,b(D,E)))]
expand_term((a-->b;c),A) => [expand_term((a-->b;c),(a(B,C):-b(B,C);c(B,C)))]
expand_term((a--> \+b),A) => [expand_term((a--> \+b),(a(B,C):- \+b(B,D),B=C))]
expand_term((a-->b->c;d),A) => [expand_term((a-->b->c;d),(a(B,C):-b(B,D)->c(D,C);d(B,C)))]
expand_term((a-->b,{c},[d]),A) => [expand_term((a-->b,{c},[d]),(a(B,C):-b(B,D),c,D=[d|C]))]
expand_term((a-->[x],!,[y]),A) => [expand_term((a-->[x],!,[y]),(a([x|B],C):-!,B=[y|C]))]
expand_term((a,[p]-->b),A) => [expand_term((a,[p]-->b),(a(B,C):-b(B,D),C=[p|D]))]
expand_term((a-->call(foo,x)),A) => [expand_term((a-->call(foo,x)),(a(B,C):-call(foo,x,B,C)))]
expand_term((a-->A),B) => [expand_term((a-->C),(a(D,E):-phrase(C,D,E)))]
expand_term(foo(x),A) => [expand_term(foo(x),foo(x))]
expand_term((h:-b),A) => [expand_term((h:-b),(h:-b))]
expand_term(A,B) => [expand_term(C,C)]
expand_term((a-->b),(a(A,B):-b(A,B))) => [expand_term((a-->b),(a(C,D):-b(C,D)))]
expand_term((a-->b),(a:-b)) => []
expand_term((a-->3),A) => error(type_error(callable,3))
expand_term((3-->a),A) => error(type_error(callable,3))
expand_term((A-->a),B) => error(instantiation_error)
phrase(greeting,[hello,world]) => [phrase(greeting,[hello,world])]
phrase(greeting,[hello,A]) => [phrase(greeting,[hello,world]),phrase(greeting,[hello,prolog])]
phrase(greeting,[hello,there]) => []
phrase(ab,[a,a,b,b]) => [phrase(ab,[a,a,b,b])]
phrase(ab,[a,b,b]) => []
phrase(nums(A),[1,2]) => [phrase(nums([1,2]),[1,2])]
phrase(A,[a]) => error(instantiation_error)
phrase(3,[a]) => error(type_error(callable,3))
phrase(nosuchnt,[a]) => error(existence_error(procedure,nosuchnt/2))
phrase(nums(A),[1,2,x],B) => [phrase(nums([1,2]),[1,2,x],[x]),phrase(nums([1]),[1,2,x],[2,x]),phrase(nums([]),[1,2,x],[1,2,x])]
phrase(greeting,[hello,prolog,extra],A) => [phrase(greeting,[hello,prolog,extra],[extra])]
phrase(([a],[b]),[a,b,c],A) => [phrase(([a],[b]),[a,b,c],[c])]
phrase([a],[a,b],[b]) => [phrase([a],[a,b],[b])]
phrase([a],[a,b],[]) => []
phrase(who,A,[]) => [phrase(who,[world],[]),phrase(who,[prolog],[])]
phrase(A,[a],[]) => error(instantiation_error)
expand_term(magic(1),A) => [expand_term(magic(1),expanded(1))]
expand_term((magic(2)-->b),A) => [expand_term((magic(2)-->b),(magic(2,B,C):-b(B,C)))]
expand_term(other(3),A) => [expand_term(other(3),other(3))]
