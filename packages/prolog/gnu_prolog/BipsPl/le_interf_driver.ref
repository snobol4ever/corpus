get_linedit_prompt(A) => [get_linedit_prompt('')]
get_linedit_prompt(nope) => []
get_linedit_prompt(123) => error(type_error(atom,123))
set_linedit_prompt('zqw> ') => [set_linedit_prompt('zqw> ')]
get_linedit_prompt(A) => [get_linedit_prompt('zqw> ')]
get_linedit_prompt('zqw> ') => [get_linedit_prompt('zqw> ')]
set_linedit_prompt('') => [set_linedit_prompt('')]
get_linedit_prompt(A) => [get_linedit_prompt('')]
set_linedit_prompt(A) => error(instantiation_error)
set_linedit_prompt(123) => error(type_error(atom,123))
set_linedit_prompt(f(x)) => error(type_error(atom,f(x)))
add_linedit_completion(zqwalpha) => [add_linedit_completion(zqwalpha)]
add_linedit_completion(zqwalphabet) => [add_linedit_completion(zqwalphabet)]
add_linedit_completion(zqw_beta2) => [add_linedit_completion(zqw_beta2)]
add_linedit_completion('zqw gamma') => []
add_linedit_completion('') => []
add_linedit_completion(A) => error(instantiation_error)
add_linedit_completion(12) => error(type_error(atom,12))
add_linedit_completion(f(zqw)) => error(type_error(atom,f(zqw)))
find_linedit_completion(zqwalp,A) => [find_linedit_completion(zqwalp,zqwalp),find_linedit_completion(zqwalp,zqwalpha),find_linedit_completion(zqwalp,zqwalphabet)]
find_linedit_completion(zqw_,A) => [find_linedit_completion(zqw_,zqw_),find_linedit_completion(zqw_,zqw_beta2)]
find_linedit_completion(zqwalpha,zqwalphabet) => [find_linedit_completion(zqwalpha,zqwalphabet)]
find_linedit_completion(zqwalphabet,zqwalpha) => []
find_linedit_completion(zqwnothing,zqwnothing_else) => [find_linedit_completion(zqwnothing,zqwnothing_else)]
find_linedit_completion(A,B) => error(instantiation_error)
find_linedit_completion(12,A) => error(type_error(atom,12))
find_linedit_completion(zqw,12) => error(type_error(atom,12))
