assertz(cnt(1)) => [assertz(cnt(1))]
assertz(cnt(2)) => [assertz(cnt(2))]
asserta(cnt(0)) => [asserta(cnt(0))]
clause(cnt(A),B) => [clause(cnt(0),true),clause(cnt(1),true),clause(cnt(2),true)]
assertz((pr(A,B):-cnt(A),B is A*10)) => [assertz((pr(C,D):-cnt(C),D is C*10))]
asserta(pr(a,b)) => [asserta(pr(a,b))]
clause(pr(A,B),C) => [clause(pr(a,b),true),clause(pr(D,E),(cnt(D),E is D*10))]
assertz((pv(A):-A)) => [assertz((pv(B):-B))]
clause(pv(A),B) => [clause(pv(C),call(C))]
assertz((pw(A):-(A=1;A=2),\+A=3)) => [assertz((pw(B):-(B=1;B=2),\+B=3))]
clause(pw(A),B) => [clause(pw(C),((C=1;C=2),\+C=3))]
asserta(A) => error(instantiation_error)
asserta(3) => error(type_error(callable,3))
asserta((foo:-4)) => error(type_error(callable,4))
assertz((foo:-a,4)) => error(type_error(callable,(a,4)))
assertz(sp(3)) => error(permission_error(modify,static_procedure,sp/1))
asserta((sp(9):-true)) => error(permission_error(modify,static_procedure,sp/1))
assertz(atom_length(a,1)) => error(permission_error(modify,static_procedure,atom_length/2))
assertz((a,b:-true)) => error(permission_error(modify,static_procedure,(',')/2))
retract(cnt(1)) => [retract(cnt(1))]
clause(cnt(A),B) => [clause(cnt(0),true),clause(cnt(2),true)]
retract(cnt(9)) => []
retract(nosuch(A)) => []
retract(cnt(A)),B is A+10,assertz(cnt(B)) => [(retract(cnt(0)),10 is 0+10,assertz(cnt(10))),(retract(cnt(2)),12 is 2+10,assertz(cnt(12)))]
clause(cnt(A),B) => [clause(cnt(10),true),clause(cnt(12),true)]
retract((pr(A,B):-C)) => [retract((pr(a,b):-true)),retract((pr(D,E):-cnt(D),E is D*10))]
retract((pv(A):-B)) => [retract((pv(C):-call(C)))]
retract(A) => error(instantiation_error)
retract(4) => error(type_error(callable,4))
retract((pw(A):-3)) => error(type_error(callable,3))
retract(sp(1)) => error(permission_error(modify,static_procedure,sp/1))
retract(atom_length(A,B)) => error(permission_error(modify,static_procedure,atom_length/2))
retractall(cnt(A)) => [retractall(cnt(B))]
clause(cnt(A),B) => []
retractall(fresh(A)) => [retractall(fresh(B))]
clause(fresh(A),B) => []
retractall(A) => error(instantiation_error)
retractall(3) => error(type_error(callable,3))
retractall(sp(A)) => error(permission_error(modify,static_procedure,sp/1))
clause(emp(A),B) => []
clause(nosuch(A),B) => []
clause(pw(1),A) => [clause(pw(1),((1=1;1=2),\+1=3))]
clause(A,true) => error(instantiation_error)
clause(4,A) => error(type_error(callable,4))
clause(pw(A),5) => error(type_error(callable,5))
clause(sp(A),B) => error(permission_error(access,private_procedure,sp/1))
clause(atom_length(A,B),C) => error(permission_error(access,private_procedure,atom_length/2))
clause((a,b),A) => error(permission_error(access,private_procedure,(',')/2))
clause(call(A),B) => error(permission_error(access,private_procedure,call/1))
abolish(pw/1) => [abolish(pw/1)]
clause(pw(A),B) => []
abolish(nosuch/2) => [abolish(nosuch/2)]
abolish(A) => error(instantiation_error)
abolish(foo/A) => error(instantiation_error)
abolish(foo) => error(type_error(predicate_indicator,foo))
abolish(foo/a) => error(type_error(integer,a))
abolish(3/1) => error(type_error(atom,3))
abolish(foo/ -1) => error(domain_error(not_less_than_zero,-1))
abolish(sp/1) => error(permission_error(modify,static_procedure,sp/1))
abolish(atom_length/2) => error(permission_error(modify,static_procedure,atom_length/2))
