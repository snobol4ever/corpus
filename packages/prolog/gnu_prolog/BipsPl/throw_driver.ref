throw(oops) => ball(oops)
throw(42) => ball(42)
throw(-1.5) => ball(-1.5)
throw([a,b|A]) => ball([a,b|B])
throw(f(A,b,2.5,'Q',[x|y])) => ball(f(B,b,2.5,'Q',[x|y]))
throw(g(A,A,B)) => ball(g(C,C,D))
throw('hello world') => ball('hello world')
throw(error(type_error(integer,x),my_ctx)) => error(type_error(integer,x))
throw(error(instantiation_error,A)) => error(instantiation_error)
throw(error(foo,bar)) => error(foo)
throw(h(i(j(k(l(m(n))))),[A,B],{curly})) => ball(h(i(j(k(l(m(n))))),[C,D],{curly}))
throw(A) => error(instantiation_error)
