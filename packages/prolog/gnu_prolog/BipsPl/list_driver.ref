append([a,b],[c,d],A) => [append([a,b],[c,d],[a,b,c,d])]
append(A,B,[1,2,3]) => [append([],[1,2,3],[1,2,3]),append([1],[2,3],[1,2,3]),append([1,2],[3],[1,2,3]),append([1,2,3],[],[1,2,3])]
append(foo,[],A) => []
member(A,[x,y,z]) => [member(x,[x,y,z]),member(y,[x,y,z]),member(z,[x,y,z])]
member(b,[a,b,c,b]) => [member(b,[a,b,c,b]),member(b,[a,b,c,b])]
memberchk(b,[a,b,c,b]) => [memberchk(b,[a,b,c,b])]
memberchk(A,[]) => []
reverse([1,2,3],A) => [reverse([1,2,3],[3,2,1])]
delete([a,b,a,c],a,A) => [delete([a,b,a,c],a,[b,c])]
select(A,[p,q,r],B) => [select(p,[p,q,r],[q,r]),select(q,[p,q,r],[p,r]),select(r,[p,q,r],[p,q])]
select(q,A,[p,r]) => [select(q,[q,p,r],[p,r]),select(q,[p,q,r],[p,r]),select(q,[p,r,q],[p,r])]
subtract([1,2,3,4],[2,4],A) => [subtract([1,2,3,4],[2,4],[1,3])]
permutation([1,2,3],A) => [permutation([1,2,3],[1,2,3]),permutation([1,2,3],[1,3,2]),permutation([1,2,3],[2,1,3]),permutation([1,2,3],[2,3,1]),permutation([1,2,3],[3,1,2]),permutation([1,2,3],[3,2,1])]
prefix(A,[a,b,c]) => [prefix([],[a,b,c]),prefix([a],[a,b,c]),prefix([a,b],[a,b,c]),prefix([a,b,c],[a,b,c])]
suffix(A,[a,b,c]) => [suffix([a,b,c],[a,b,c]),suffix([b,c],[a,b,c]),suffix([c],[a,b,c]),suffix([],[a,b,c])]
sublist(A,[a,b,c]) => [sublist([a,b,c],[a,b,c]),sublist([b,c],[a,b,c]),sublist([c],[a,b,c]),sublist([],[a,b,c]),sublist([b],[a,b,c]),sublist([a,c],[a,b,c]),sublist([a],[a,b,c]),sublist([a,b],[a,b,c])]
last([1,2,3],A) => [last([1,2,3],3)]
last([],A) => []
length([a,b,c],A) => [length([a,b,c],3)]
length(A,2) => [length([B,C],2)]
length(A,-1) => error(domain_error(not_less_than_zero,-1))
length(a,A) => []
nth(2,[a,b,c],A) => [nth(2,[a,b,c],b)]
