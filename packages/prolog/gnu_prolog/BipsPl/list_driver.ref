nth1(A,[a,b,c],c) => [nth1(3,[a,b,c],c)]
max_list([3,1,4,1,5],A) => [max_list([3,1,4,1,5],5)]
min_list([3,1,4,1,5],A) => [min_list([3,1,4,1,5],1)]
sum_list([1,2,3.5],A) => [sum_list([1,2,3.5],6.5)]
max_list([],A) => []
