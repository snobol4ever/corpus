write_to_atom(A,f('X',y,'a b',[1,2])) => [write_to_atom('f(X,y,a b,[1,2])',f('X',y,'a b',[1,2]))]
write_to_atom('f(x)',f(x)) => [write_to_atom('f(x)',f(x))]
write_to_atom(abc,f(x)) => []
write_to_atom(f(x),a) => error(type_error(atom,f(x)))
write_to_chars(A,'A'+b) => [write_to_chars(['A',+,b],'A'+b)]
write_to_chars(A,Z) => [write_to_chars(['Z'],Z)]
write_to_codes(A,- (1)) => [write_to_codes([45,32,40,49,41],- (1))]
write_to_codes(A,[]) => [write_to_codes([91,93],[])]
writeq_to_atom(A,f('X','a b',[],'\n')) => [writeq_to_atom('f(''X'',''a b'',[],''\\n'')',f('X','a b',[],'\n'))]
writeq_to_atom(A,- (1)) => [writeq_to_atom('- (1)',- (1))]
writeq_to_chars(A,'it''s') => [writeq_to_chars(['''',i,t,'''','''',s,''''],'it''s')]
writeq_to_codes(A,Z) => [writeq_to_codes([90],Z)]
write_canonical_to_atom(A,[a|'B']) => [write_canonical_to_atom('''.''(a,''B'')',[a|'B'])]
write_canonical_to_atom(A,Z) => [write_canonical_to_atom('''$VAR''(25)',Z)]
write_canonical_to_chars(A,1+2) => [write_canonical_to_chars([+,'(','1',',','2',')'],1+2)]
write_canonical_to_codes(A,'x y') => [write_canonical_to_codes([39,120,32,121,39],'x y')]
display_to_atom(A,1+2*3) => [display_to_atom('+(1,*(2,3))',1+2*3)]
display_to_atom(A,- (1)) => [display_to_atom('-(1)',- (1))]
display_to_chars(A,'a b') => [display_to_chars([a,' ',b],'a b')]
display_to_codes(A,[x]) => [display_to_codes([39,46,39,40,120,44,91,93,41],[x])]
print_to_atom(A,f(B,'a b')) => [print_to_atom('f(B,a b)',f(B,'a b'))]
print_to_chars(A,1+2) => [print_to_chars(['1',+,'2'],1+2)]
print_to_codes(A,ab) => [print_to_codes([97,98],ab)]
write_term_to_atom(A,'a b'+C,[quoted(true),numbervars(true)]) => [write_term_to_atom('''a b''+C','a b'+C,[quoted(true),numbervars(true)])]
write_term_to_atom(A,1+2,[ignore_ops(true)]) => [write_term_to_atom('+(1,2)',1+2,[ignore_ops(true)])]
write_term_to_atom(A,x,[bad]) => error(domain_error(write_option,bad))
write_term_to_chars(A,f(C),[numbervars(false)]) => [write_term_to_chars([f,'(',$,'V','A','R','(','2',')',')'],f(C),[numbervars(false)])]
write_term_to_chars(A,x,B) => error(instantiation_error)
write_term_to_codes(A,'A',[quoted(true)]) => [write_term_to_codes([39,65,39],'A',[quoted(true)])]
write_term_to_codes(A,x,[quoted(maybe)]) => error(domain_error(write_option,quoted(maybe)))
format_to_atom(A,'~w-~a ~d',[x,y,42]) => [format_to_atom('x-y 42','~w-~a ~d',[x,y,42])]
format_to_atom(A,[126,113,124,126,50,102],['A',1.5]) => [format_to_atom('''A''|1.50',[126,113,124,126,50,102],['A',1.5])]
format_to_atom(A,'~a',[]) => error(domain_error(non_empty_list,[]))
format_to_atom(A,'~y',[x]) => error(domain_error(format_control_sequence,y))
format_to_chars(A,'~q',['A']) => [format_to_chars(['''','A',''''],'~q',['A'])]
format_to_chars(A,'~d',[abc]) => error(type_error(evaluable,abc/0))
format_to_codes(A,'~a~n',[z]) => [format_to_codes([122,10],'~a~n',[z])]
format_to_codes(A,'~8r',[64]) => [format_to_codes([49,48,48],'~8r',[64])]
read_from_atom('foo(X, Y, X).',A) => [read_from_atom('foo(X, Y, X).',foo(B,C,B))]
read_from_atom('[1, 2|T].',A) => [read_from_atom('[1, 2|T].',[1,2|B])]
read_from_atom('foo(',A) => error(syntax_error('constant term stream:1 (char:5) expression expected'))
read_from_atom(A,B) => error(instantiation_error)
read_from_atom('',A) => [read_from_atom('',end_of_file)]
read_from_atom('a.',b) => []
read_from_chars([a,'(',b,')','.'],A) => [read_from_chars([a,'(',b,')','.'],a(b))]
read_from_chars(A,B) => error(instantiation_error)
read_from_codes([49,32,43,32,50,32,42,32,51,46],A) => [read_from_codes([49,32,43,32,50,32,42,32,51,46],1+2*3)]
read_from_codes([45,32,49,46],A) => [read_from_codes([45,32,49,46],-1)]
read_term_from_atom('f(X, _Y, Z, X).',A,[variable_names(B)]) => [read_term_from_atom('f(X, _Y, Z, X).',f(C,D,E,C),[variable_names(['X'=C,'_Y'=D,'Z'=E])])]
read_term_from_atom('f(X, _Y, Z, X).',A,[singletons(B)]) => [read_term_from_atom('f(X, _Y, Z, X).',f(C,D,E,C),[singletons(['_Y'=D,'Z'=E])])]
read_term_from_atom('g(A, B).',A,[variables(B)]) => [read_term_from_atom('g(A, B).',g(C,D),[variables([C,D])])]
read_term_from_atom('a.',A,[nope]) => error(domain_error(read_option,nope))
read_term_from_chars([h,'(','X',')','.'],A,[variable_names(B)]) => [read_term_from_chars([h,'(','X',')','.'],h(C),[variable_names(['X'=C])])]
read_term_from_chars([h,'(','.'],A,[syntax_error(fail)]) => []
read_term_from_codes([107,40,97,41,46],A,[]) => [read_term_from_codes([107,40,97,41,46],k(a),[])]
read_term_from_codes([107,40,97,41,46],A,foo) => error(type_error(list,foo))
read_token_from_atom('foo(bar)',A) => [read_token_from_atom('foo(bar)',foo)]
read_token_from_atom('X',A) => [read_token_from_atom('X',var('X'))]
read_token_from_atom('123 abc',A) => [read_token_from_atom('123 abc',123)]
read_token_from_atom('"str"',A) => [read_token_from_atom('"str"',string(str))]
read_token_from_atom('',A) => [read_token_from_atom('',punct(end_of_file))]
read_token_from_atom('( x',A) => [read_token_from_atom('( x',punct('('))]
read_token_from_atom(A,B) => error(instantiation_error)
read_token_from_chars(['''',a,' ',b,''''],A) => [read_token_from_chars(['''',a,' ',b,''''],'a b')]
read_token_from_chars([',',a],A) => [read_token_from_chars([',',a],',')]
read_token_from_codes([51,46,50,53],A) => [read_token_from_codes([51,46,50,53],3.25)]
read_token_from_codes([95,86,97,114],A) => [read_token_from_codes([95,86,97,114],var('_Var'))]
