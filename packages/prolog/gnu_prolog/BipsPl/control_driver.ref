repeat,! => [(repeat,!)]
repeat,between(1,3,A),A>=2,! => [(repeat,between(1,3,2),2>=2,!)]
repeat,(retract(gnu_drv_control_k(A))->true;A=0),B is A+1,assertz(gnu_drv_control_k(B)),B>=3,! => [(repeat,(retract(gnu_drv_control_k(2))->true;2=0),3 is 2+1,assertz(gnu_drv_control_k(3)),3>=3,!)]
between(1,3,A) => [between(1,3,1),between(1,3,2),between(1,3,3)]
between(-2,0,A) => [between(-2,0,-2),between(-2,0,-1),between(-2,0,0)]
between(3,3,A) => [between(3,3,3)]
between(3,1,A) => []
between(1,3,2) => [between(1,3,2)]
between(1,3,5) => []
between(A,3,B) => error(instantiation_error)
between(1,A,B) => error(instantiation_error)
between(a,3,A) => error(type_error(integer,a))
between(1,3.0,A) => error(type_error(integer,3.0))
between(1,3,x) => error(type_error(integer,x))
for(A,1,3) => [for(1,1,3),for(2,1,3),for(3,1,3)]
for(2,1,3) => [for(2,1,3)]
for(A,5,4) => []
for(x,1,2) => error(type_error(integer,x))
for(A,1,B) => error(instantiation_error)
