current_op(A,B,===>) => []
op(700,xfx,===>) => [op(700,xfx,===>)]
current_op(A,B,===>) => [current_op(700,xfx,===>)]
op(710,xfx,===>) => [op(710,xfx,===>)]
current_op(A,xfx,===>) => [current_op(710,xfx,===>)]
op(0,xfx,===>) => [op(0,xfx,===>)]
current_op(A,B,===>) => []
op(200,xfy,[++,^^]) => [op(200,xfy,[++,^^])]
current_op(A,B,++) => [current_op(200,xfy,++)]
current_op(A,B,^^) => [current_op(200,xfy,^^)]
op(200,xfy,++),A=a++b++c => [(op(200,xfy,++),a++b++c=a++b++c)]
op(900,fy,~~) => [op(900,fy,~~)]
op(900,xfx,~~) => [op(900,xfx,~~)]
current_op(A,fy,~~) => [current_op(900,fy,~~)]
current_op(A,xfx,~~) => [current_op(900,xfx,~~)]
current_op(A,xf,~~) => []
op(200,xf,===>) => [op(200,xf,===>)]
op(200,xfx,===>) => error(permission_error(create,operator,===>))
current_op(A,B,mod) => [current_op(400,yfx,mod)]
current_op(A,xfx,is) => [current_op(700,xfx,is)]
current_op(A,fy,-) => [current_op(200,fy,-)]
current_op(A,yfx,-) => [current_op(500,yfx,-)]
current_op(200,A,-) => [current_op(200,fy,-)]
current_op(A,B,nosuchop) => []
op(A,xfx,foo) => error(instantiation_error)
op(700,A,foo) => error(instantiation_error)
op(700,xfx,A) => error(instantiation_error)
op(1201,xfx,foo) => error(domain_error(operator_priority,1201))
op(-1,xfx,foo) => error(domain_error(operator_priority,-1))
op(a,xfx,foo) => error(type_error(integer,a))
op(700,yfy,foo) => error(domain_error(operator_specifier,yfy))
op(700,3,foo) => error(type_error(atom,3))
op(700,xfx,3) => error(type_error(list,3))
op(700,xfx,[a,3]) => error(type_error(atom,3))
op(700,xfx,',') => error(permission_error(modify,operator,','))
op(700,xfx,'|') => error(permission_error(create,operator,'|'))
op(700,xfx,{}) => error(permission_error(create,operator,{}))
current_op(1201,A,B) => error(domain_error(operator_priority,1201))
current_op(A,foo,B) => error(domain_error(operator_specifier,foo))
current_op(A,B,3) => error(type_error(atom,3))
current_op(a,A,B) => error(domain_error(operator_priority,a))
