sort([c,a,b,a],A) => [sort([c,a,b,a],[a,b,c])]
sort([],A) => [sort([],[])]
sort([b,1,f(x),2.0,a,g(a,b),f(a),1.0,'B'],A) => [sort([b,1,f(x),2.0,a,g(a,b),f(a),1.0,'B'],[1.0,2.0,1,'B',a,b,f(a),f(x),g(a,b)])]
sort([c,a],[a,c]) => [sort([c,a],[a,c])]
sort([c,a],[c,a]) => []
sort(A,B) => error(instantiation_error)
sort([a|A],B) => error(instantiation_error)
sort([a|b],A) => error(type_error(list,[a|b]))
sort([a],foo) => error(type_error(list,foo))
msort([c,a,b,a],A) => [msort([c,a,b,a],[a,a,b,c])]
msort([2,1.0,1,2],A) => [msort([2,1.0,1,2],[1.0,1,2,2])]
msort([b,a],[b,a]) => []
msort(foo,A) => error(type_error(list,foo))
keysort([b-1,a-2,b-0,a-1],A) => [keysort([b-1,a-2,b-0,a-1],[a-2,a-1,b-1,b-0])]
keysort([],A) => [keysort([],[])]
keysort([k-v],[A]) => [keysort([k-v],[k-v])]
keysort([x-1,y-2],[y-2,x-1]) => []
keysort([a-1,x],A) => error(type_error(pair,x))
keysort([a-1,A],B) => error(instantiation_error)
keysort([a-1],[x]) => error(type_error(pair,x))
atom_chars(cbab,A),sort(A) => [(atom_chars(cbab,[a,b,c]),sort([a,b,c]))]
atom_chars(z,A),sort(A) => [(atom_chars(z,[z]),sort([z]))]
sort(A) => error(instantiation_error)
sort(foo) => error(type_error(list,foo))
atom_chars(baca,A),msort(A) => [(atom_chars(baca,[a,a,b,c]),msort([a,a,b,c]))]
msort([a|A]) => error(instantiation_error)
A=[B-1,a-2,B-3,b-4],B=c,keysort(A) => [([a-2,b-4,c-1,c-3]=[a-2,b-4,c-1,c-3],c=c,keysort([a-2,b-4,c-1,c-3]))]
keysort([a-1,z]) => error(type_error(pair,z))
