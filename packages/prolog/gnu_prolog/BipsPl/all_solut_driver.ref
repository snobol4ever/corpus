findall(A,member(A,[c,a,b,a]),B) => [findall(C,member(C,[c,a,b,a]),[c,a,b,a])]
findall(A-B,(member(A,[1,2]),member(B,[a,b])),C) => [findall(D-E,(member(D,[1,2]),member(E,[a,b])),[1-a,1-b,2-a,2-b])]
findall(f(A,B),member(A,[p,q]),C) => [findall(f(D,E),member(D,[p,q]),[f(p,F),f(q,G)])]
findall(A,fail,B) => [findall(C,fail,[])]
findall(A,member(A,[1,2,3]),[B|C]) => [findall(D,member(D,[1,2,3]),[1,2,3])]
findall(A,member(A,[1,2]),[B]) => []
findall(A,B,C) => error(instantiation_error)
findall(A,3,B) => error(type_error(callable,3))
findall(A,true,foo) => error(type_error(list,foo))
findall(A,member(A,[1,2]),B,[z]) => [findall(C,member(C,[1,2]),[1,2,z],[z])]
findall(A,member(A,[1,2]),B,C) => [findall(D,member(D,[1,2]),[1,2|E],E)]
findall(A,fail,B,[end]) => [findall(C,fail,[end],[end])]
findall(A,B,C,[]) => error(instantiation_error)
bagof(A,member(A,[c,a,b,a]),B) => [bagof(C,member(C,[c,a,b,a]),[c,a,b,a])]
bagof(A,member(A-B,[1-a,2-b,3-a]),C) => [bagof(D,member(D-a,[1-a,2-b,3-a]),[1,3]),bagof(E,member(E-b,[1-a,2-b,3-a]),[2])]
bagof(A,B^member(A-B,[1-a,2-b,3-a]),C) => [bagof(D,E^member(D-E,[1-a,2-b,3-a]),[1,2,3])]
bagof(A-B,member(A-C-B,[1-a-p,2-b-q,3-a-r]),D) => [bagof(E-F,member(E-a-F,[1-a-p,2-b-q,3-a-r]),[1-p,3-r]),bagof(G-H,member(G-b-H,[1-a-p,2-b-q,3-a-r]),[2-q])]
bagof(A,fail,B) => []
bagof(A,B,C) => error(instantiation_error)
bagof(A,4,B) => error(type_error(callable,4))
bagof(A,true,foo) => error(type_error(list,foo))
setof(A,member(A,[c,a,b,a]),B) => [setof(C,member(C,[c,a,b,a]),[a,b,c])]
setof(A,member(A-B,[2-a,1-b,3-a,2-a]),C) => [setof(D,member(D-a,[2-a,1-b,3-a,2-a]),[2,3]),setof(E,member(E-b,[2-a,1-b,3-a,2-a]),[1])]
setof(A,B^member(A-B,[2-a,1-b,3-a]),C) => [setof(D,E^member(D-E,[2-a,1-b,3-a]),[1,2,3])]
setof(A-B,member(A-B,[2-a,1-b,2-a]),C) => [setof(D-E,member(D-E,[2-a,1-b,2-a]),[1-b,2-a])]
setof(A,member(A,[f(b),1,a,2.0,B]),[C,D,E,F,G]) => [setof(H,member(H,[f(b),1,a,2.0,I]),[I,2.0,1,a,f(b)])]
setof(A,member(B,[]),C) => []
setof(A,B,C) => error(instantiation_error)
setof(A,true,foo) => error(type_error(list,foo))
