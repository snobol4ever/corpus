find_first_arg([],A) => [find_first_arg([],var)]
find_first_arg([get_atom(a,0),proceed],A) => [find_first_arg([get_atom(a,0),proceed],atm(a))]
find_first_arg([get_integer(42,0),proceed],A) => [find_first_arg([get_integer(42,0),proceed],int(42))]
find_first_arg([get_nil(0),proceed],A) => [find_first_arg([get_nil(0),proceed],atm([]))]
find_first_arg([get_list(0),unify_variable(x(1)),proceed],A) => [find_first_arg([get_list(0),unify_variable(x(1)),proceed],lst)]
find_first_arg([get_structure(f/2,0),proceed],A) => [find_first_arg([get_structure(f/2,0),proceed],stc(f,2))]
find_first_arg([get_atom(b,1),get_atom(a,0),proceed],A) => [find_first_arg([get_atom(b,1),get_atom(a,0),proceed],atm(a))]
find_first_arg([call(foo/0),get_atom(a,0)],A) => [find_first_arg([call(foo/0),get_atom(a,0)],var)]
find_first_arg([execute(foo/0)],A) => [find_first_arg([execute(foo/0)],var)]
find_first_arg([cut(x(2)),get_nil(0)],A) => [find_first_arg([cut(x(2)),get_nil(0)],var)]
find_first_arg([get_float(1.5,0),proceed],A) => [find_first_arg([get_float(1.5,0),proceed],var)]
stopping_inst(call(p/1)) => [stopping_inst(call(p/1))]
stopping_inst(proceed) => []
defines_first_arg(get_structure(g/3,0),A) => [defines_first_arg(get_structure(g/3,0),stc(g,3))]
defines_first_arg(get_atom(a,1),A) => []
assign_x0([w(1),w(0)]) => [assign_x0([w(1),w(0)])]
assign_x0([c(0,0)]) => []
assign_x0([c(3,0)]) => [assign_x0([c(3,0)])]
