?- powerset2([a,b,c,d,e],PS).
PS = [[],[e],[d],[e,d],[c],[e,c],[d,c],[e,d,c],[b],[e,b],[d,b],[e,d,b],[c,b],[e,c,b],[d,c,b],[e,d,c,b],[a],[e,a],[d,a],[e,d,a],[c,a],[e,c,a],[d,c,a],[e,d,c,a],[b,a],[e,b,a],[d,b,a],[e,d,b,a],[c,b,a],[e,c,b,a],[d,c,b,a],[e,d,c,b,a]]
?- biglist(1,20,S),powerset(S,PS).
raised(existence_error(procedure,biglist/3))
