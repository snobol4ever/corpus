=== dlon(14)
Simultaneously solving : 
    -1 * cos(y) + sin(3 * x) = 0
    -1 * cos(x) + sin(3 * y) = 0
 For [x, y].

Offending set is [sin(3 * x), cos(x)]

Reduced term is cos(x)

Homogenizing equations in x
 gives 
    -1 * cos(y) + 1 * ((4 * cos(x) ^ 2 - 1) * (1 - cos(x) ^ 2) ^ (1 / 2)) = 0
    -1 * cos(x) + sin(3 * y) = 0


Substituting x4 = cos(x) gives 
    (1 + -1 * x4 ^ 2) ^ (1/2) * (-1 + 4 * x4 ^ 2) + -1 * cos(y) = 0
    sin(3 * y) + -1 * x4 = 0


Offending set is [cos(y), sin(3 * y)]

Reduced term is cos(y)

Homogenizing equations in y
 gives 
    (1 + -1 * x4 ^ 2) ^ (1/2) * (-1 + 4 * x4 ^ 2) + -1 * cos(y) = 0
    1 * ((4 * cos(y) ^ 2 - 1) * (1 - cos(y) ^ 2) ^ (1 / 2)) + -1 * x4 = 0


Substituting x5 = cos(y) gives 
    -1 * x5 + (-1 + 4 * x4 ^ 2) * (1 + -1 * x4 ^ 2) ^ (1/2) = 0
    -1 * x4 + (1 + -1 * x5 ^ 2) ^ (1/2) * (-1 + 4 * x5 ^ 2) = 0


Solving -1 * x4 + (1 + -1 * x5 ^ 2) ^ (1/2) * (-1 + 4 * x5 ^ 2) = 0 for x4

Tidying to -1 * x4 = -1 * (-1 + 4 * x5 ^ 2) * (1 + -1 * x5 ^ 2) ^ (1/2)

    x4 = -1 * (1 + -4 * x5 ^ 2) * (1 + -1 * x5 ^ 2) ^ (1/2)
     (by Isolation)

Answer is : 
X1
  where :
    X1 =  x4 = (1 + -1 * x5 ^ 2) ^ (1/2) * (-1 + 4 * x5 ^ 2)


Applying substitution 
    x4 = (1 + -1 * x5 ^ 2) ^ (1/2) * (-1 + 4 * x5 ^ 2)

   to    : 
    -1 * x5 + (-1 + 4 * x4 ^ 2) * (1 + -1 * x4 ^ 2) ^ (1/2) = 0

   gives : 
    (1 + -1 * (1 + -1 * x5 ^ 2) * (-1 + 4 * x5 ^ 2) ^ 2) ^ (1/2) * (-1 + 4 * (1 + -1 * x5 ^ 2) * (-1 + 4 * x5 ^ 2) ^ 2) + -1 * x5 = 0


Solving (1 + -1 * (1 + -1 * x5 ^ 2) * (-1 + 4 * x5 ^ 2) ^ 2) ^ (1/2) * (-1 + 4 * (1 + -1 * x5 ^ 2) * (-1 + 4 * x5 ^ 2) ^ 2) + -1 * x5 = 0 for x5

Tidying to (1 + (-1 + x5 ^ 2) * (-1 + 4 * x5 ^ 2) ^ 2) ^ (1/2) * (-1 + (4 + -4 * x5 ^ 2) * (-1 + 4 * x5 ^ 2) ^ 2) + -1 * x5 = 0

Trying to isolate 1 + (-1 + 4 * x5 ^ 2) ^ 2 * (-1 + x5 ^ 2)
 in -1 * x5 + (-1 + (-1 + 4 * x5 ^ 2) ^ 2 * (4 + -4 * x5 ^ 2)) * (1 + (-1 + 4 * x5 ^ 2) ^ 2 * (-1 + x5 ^ 2)) ^ (1/2) = 0

Assuming -1 + (-1 + 4 * x5 ^ 2) ^ 2 * (4 + -4 * x5 ^ 2) is non-zero

    1 + (-1 + x5 ^ 2) * (-1 + 4 * x5 ^ 2) ^ 2 = (-1 + (-1 + 4 * x5 ^ 2) ^ 2 * (4 + -4 * x5 ^ 2)) ^ -2 * x5 ^ 2
     (by Isolation)

Applying substitution 
    x5 ^ 2 = x6

   to    : 
    (-1 + x5 ^ 2) * (-1 + 4 * x5 ^ 2) ^ 2 + -1 * x5 ^ 2 * (-1 + (-1 + 4 * x5 ^ 2) ^ 2 * (4 + -4 * x5 ^ 2)) ^ -2 = -1

   gives : 
    -1 * x6 * (-1 + (4 + -4 * x6) * (-1 + 4 * x6) ^ 2) ^ -2 + (-1 + 4 * x6) ^ 2 * (-1 + x6) = -1


Clearing of rational functions

-1 * x6 + -1 * (-1 + 4 * x6) ^ 2 * (-1 + (4 + -4 * x6) * (-1 + 4 * x6) ^ 2) ^ 2 + (-1 + 4 * x6) ^ 2 * (-1 + (4 + -4 * x6) * (-1 + 4 * x6) ^ 2) ^ 2 * x6 = -1 * (-1 + (4 + -4 * x6) * (-1 + 4 * x6) ^ 2) ^ 2

Polynomial -1 * x6 + -1 * (-1 + 4 * x6) ^ 2 * (-1 + (-1 + 4 * x6) ^ 2 * (4 + -4 * x6)) ^ 2 + (-1 + (-1 + 4 * x6) ^ 2 * (4 + -4 * x6)) ^ 2 + (-1 + 4 * x6) ^ 2 * (-1 + (-1 + 4 * x6) ^ 2 * (4 + -4 * x6)) ^ 2 * x6 becomes 

65536 * x6 ^ 9 + -294912 * x6 ^ 8 + 552960 * x6 ^ 7 + -559104 * x6 ^ 6 + 329472 * x6 ^ 5 + -114048 * x6 ^ 4 + 22176 * x6 ^ 3 + -2160 * x6 ^ 2 + 80 * x6 when in normal form

By inspection x6 = 1 is a solution

After division, polynomial becomes
65536 * x6 ^ 7 + -229376 * x6 ^ 6 + 323584 * x6 ^ 5 + -235520 * x6 ^ 4 + 93952 * x6 ^ 3 + -20096 * x6 ^ 2 + 2080 * x6 + -80
Solving -1 * x5 + (-1 + 4 * x4 ^ 2) * (1 + -1 * x4 ^ 2) ^ (1/2) = 0 for x4

Tidying to (-1 + 4 * x4 ^ 2) * (1 + -1 * x4 ^ 2) ^ (1/2) = x5

Applying substitution 
    x4 ^ 2 = x7

