    X3 =  y = 2 * (-0.003591161945650174 + 180 * n26)
    X4 =  x = (-2 * sec(2 * (180 * n26 + -0.003591161945650174)) + -1 * tan(2 * (180 * n26 + -0.003591161945650174))) * -0.5


