q('assertz(impossible(on(X,X),_)), assertz((impossible(on(X,Y),Goals) :- (member(clear(Y),Goals) ; member(on(X,Y1),Goals), Y1 \\== Y ; member(on(X1,Y),Goals), X1 \\== X))), assertz((impossible(clear(X),Goals) :- member(on(_,X),Goals))).', 3).
assertz(impossible(on(X,X),_)), assertz((impossible(on(X,Y),Goals) :- (member(clear(Y),Goals) ; member(on(X,Y1),Goals), Y1 \== Y ; member(on(X1,Y),Goals), X1 \== X))), assertz((impossible(clear(X),Goals) :- member(on(_,X),Goals))).
