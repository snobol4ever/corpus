N = 3
;
S = [level:zero/inc,amount:zero/inc,flow:zero/inc,flow:inflow/dec]
B = [[level:zero/inc,amount:zero/inc,flow:zero/inc,flow:inflow/dec],[level:zero..top/inc,amount:zero..full/inc,flow:zero..inflow/inc,flow:zero..inflow/dec],[level:top/inc,amount:full/inc,flow:zero..inflow/inc,flow:zero..inflow/dec]]
N = 3
;
