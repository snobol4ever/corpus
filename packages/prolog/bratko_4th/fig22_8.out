?- qdir(D, Sign).
D = dec
Sign = neg
;
D = std
Sign = zero
;
D = inc
Sign = pos
...
?- qsum(neg, pos, X).
X = pos
;
X = zero
;
X = neg
...
?- qdirsum(inc, dec, D).
D = dec
;
D = std
;
D = inc
...
?- qdirsum(inc, std, D).
D = inc
?- compare_lands(zero, top, [zero, top, inf], Sign).
Sign = neg
?- compare_lands(inf, top, [zero, top, inf], Sign).
Sign = pos
?- once(consult('fig22_9.pl')), qmag(level:Q).
Q = zero
;
Q = top
;
Q = zero..top
...
?- once(consult('fig22_9.pl')), relative_qmag(level:zero..top, level:top, Sign).
