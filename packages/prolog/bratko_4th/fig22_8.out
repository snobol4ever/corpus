B = [[level:zero/inc,amount:zero/inc,flow:zero/inc,flow:inflow/dec],[level:zero..top/inc,amount:zero..full/inc,flow:zero..inflow/inc,flow:zero..inflow/dec],[level:top/std,amount:full/std,flow:inflow/std,flow:zero/std]]
N = 3
...
?- once(consult('fig22_9.pl')), initial(S), findall(N, (simulate(S, B, 10), length(B, N)), Ns).
S = [level:zero/inc,amount:zero/inc,flow:zero/inc,flow:inflow/dec]
N = A
B = B
Ns = [3,3,3]
?- once(consult('fig22_9.pl')), sum(flow:zero/inc, flow:N, flow:inflow/std).
N = inflow/dec
?- once(consult('fig22_9.pl')), mplus(amount:zero/inc, level:L).
L = zero/inc
?- once(consult('fig22_9.pl')), deriv(amount:zero..full/D, flow:zero..inflow/dec).
D = inc
?- once(consult('fig22_11.pl')), initial(S), simulate(S, B, 6), length(B, N).
