B = [[x:zero/inc,v:v0/std,a:zero/dec],[x:zero..inf/inc,v:zero..v0/dec,a:minf..zero/dec],[x:zero..inf/std,v:zero/dec,a:minf..zero/std],[x:zero..inf/dec,v:minf..zero/dec,a:minf..zero/inc],[x:zero/dec,v:minf..zero/std,a:zero/inc],[x:minf..zero/dec,v:minf..zero/inc,a:zero..inf/inc],[x:minf..zero/std,v:zero/inc,a:zero..inf/std],[x:minf..zero/inc,v:zero..v0/inc,a:zero..inf/dec]]
