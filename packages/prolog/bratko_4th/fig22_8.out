?- once(consult('fig22_9.pl')), transition(level:zero..top/inc, V).
V = level:zero..top/inc
;
V = level:zero..top/std
;
V = level:top/inc
...
?- once(consult('fig22_9.pl')), initial(S), legalstate(S).
S = [level:zero/inc,amount:zero/inc,flow:zero/inc,flow:inflow/dec]
?- once(consult('fig22_9.pl')), initial(S), legal_trans(S, S2).
S = [level:zero/inc,amount:zero/inc,flow:zero/inc,flow:inflow/dec]
S2 = [level:zero..top/inc,amount:zero..full/inc,flow:zero..inflow/inc,flow:zero..inflow/dec]
