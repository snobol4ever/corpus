?- findall(MilliVolts/MicroAmps, (circuit_b(10, _, _, _, _, (V,I), _), MilliVolts is round(V*1000), MicroAmps is round(I*1000000)), L).
MilliVolts = A
MicroAmps = B
V = C
I = D
L = [7340/42553]
?- findall(MilliVolts, (circuit_b(U, _, _, _, _, (_,I), _), {I = 0.02}, MilliVolts is round(U*1000)), L).
