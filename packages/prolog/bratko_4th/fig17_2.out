?- can(move(B,F,T),C).
B = a
F = 2
T = 1
C = [clear(a),clear(1),on(a,2)]
;
B = a
F = 3
T = 1
C = [clear(a),clear(1),on(a,3)]
;
B = a
F = 4
T = 1
C = [clear(a),clear(1),on(a,4)]
...
?- adds(move(c,a,2),A).
A = [on(c,2),clear(a)]
?- deletes(move(a,1,b),D).
D = [on(a,1),clear(b)]
?- object(X).
X = 1
;
X = 2
;
X = 3
...
?- state1(S).
S = [clear(2),clear(4),clear(b),clear(c),on(a,1),on(b,3),on(c,a)]
