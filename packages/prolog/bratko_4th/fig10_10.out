T2 = t(nil/0,1,t(nil/0,2,nil/0)/1)/2
T3 = t(t(nil/0,1,nil/0)/1,2,t(nil/0,3,nil/0)/1)/2
;
T1 = t(nil/0,1,nil/0)/1
T2 = t(nil/0,1,t(nil/0,2,nil/0)/1)/2
T3 = t(t(nil/0,1,nil/0)/1,2,t(nil/0,3,nil/0)/1)/2
;
