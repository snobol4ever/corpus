T = A
X = B
V = C
?- findall(N/T10/X1000, (state0(S), once(simulate(S, B)), length(B, N), last(B, [T, X | _]), T10 is round(T*10), X1000 is round(X*1000)), L).
N = A
T10 = B
X1000 = C
S = D
B = E
