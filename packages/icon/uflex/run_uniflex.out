procedure semantic_action_107()
   { tokflags +:= Beginner; return BACKSLASH }
end

procedure semantic_action_151()
   { yylineno +:= 1; yycolno := 1;
       if tokflags < Newline then tokflags +:= Newline }
end

procedure semantic_action_154()
   { yycolno +:= 1; while(yycolno-1)%8~=0 do yycolno +:= 1 }
end

procedure semantic_action_155()
   { stop("unrecognized character ", yytext) }
end

