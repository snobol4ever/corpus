procedure yylexaccepting(myautomata)
local currstate
accepttable := table()

   put(myautomata.states, currstate := anode(1, 0, [], [], []))
   myautomata.start := currstate

   put(myautomata.states, currstate := anode(2, 3, [], [], []))
   put(myautomata.accepting, currstate)
   insert(accepttable, 2, 3)

   put(myautomata.states, currstate := anode(3, 6, [], [], []))
   put(myautomata.accepting, currstate)
   insert(accepttable, 3, 6)

   put(myautomata.states, currstate := anode(4, 5, [], [], []))
   put(myautomata.accepting, currstate)
   insert(accepttable, 4, 5)

   put(myautomata.states, currstate := anode(5, 2, [], [], []))
   put(myautomata.accepting, currstate)
   insert(accepttable, 5, 2)

   put(myautomata.states, currstate := anode(6, 6, [], [], []))
   put(myautomata.accepting, currstate)
   insert(accepttable, 6, 6)

   put(myautomata.states, currstate := anode(7, 1, [], [], []))
   put(myautomata.accepting, currstate)
   insert(accepttable, 7, 1)

   put(myautomata.states, currstate := anode(8, 5, [], [], []))
   put(myautomata.accepting, currstate)
   insert(accepttable, 8, 5)

   put(myautomata.states, currstate := anode(9, 0, [], [], []))

   put(myautomata.states, currstate := anode(10, 2, [], [], []))
   put(myautomata.accepting, currstate)
   insert(accepttable, 10, 2)

   put(myautomata.states, currstate := anode(11, 4, [], [], []))
   put(myautomata.accepting, currstate)
   insert(accepttable, 11, 4)

   put(myautomata.states, currstate := anode(12, 1, [], [], []))
   put(myautomata.accepting, currstate)
   insert(accepttable, 12, 1)

   put(myautomata.states, currstate := anode(13, 2, [], [], []))
   put(myautomata.accepting, currstate)
   insert(accepttable, 13, 2)

end

global semantic_action

procedure yylex()
static myautomata
initial {
   myautomata := automata()

   myautomata.states := []
   myautomata.accepting := []
   yylexaccepting(myautomata)
   init_semantic_actions()

}

   return yyulex(myautomata)

end

procedure init_semantic_actions()

   semantic_action := table()
   semantic_action[1] := semantic_action_1
   semantic_action[2] := semantic_action_2
   semantic_action[3] := semantic_action_3
   semantic_action[4] := semantic_action_4
   semantic_action[5] := semantic_action_5
   semantic_action[6] := semantic_action_6

end

procedure semantic_action_3()
   { return 0 }
end

procedure semantic_action_6()
   { return ord(yytext) }
end

procedure semantic_action_5()
   # fail
end

procedure semantic_action_2()
   { yylval := numeric(yytext); return NUMBER }
end

procedure semantic_action_1()
   { yylval := yytext; return NAME }
end

procedure semantic_action_4()
   { return ASSIGNMENT }
end


