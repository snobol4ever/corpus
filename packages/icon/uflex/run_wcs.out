procedure yylexaccepting(myautomata)
local currstate
accepttable := table()

   put(myautomata.states, currstate := anode(1, 0, [], [], []))
   myautomata.start := currstate

   put(myautomata.states, currstate := anode(2, 1, [], [], []))
   put(myautomata.accepting, currstate)
   insert(accepttable, 2, 1)

   put(myautomata.states, currstate := anode(3, 2, [], [], []))
   put(myautomata.accepting, currstate)
   insert(accepttable, 3, 2)

   put(myautomata.states, currstate := anode(4, 3, [], [], []))
   put(myautomata.accepting, currstate)
   insert(accepttable, 4, 3)

end

global semantic_action

procedure yylex()
static myautomata
initial {
   myautomata := automata()

   myautomata.states := []
   myautomata.accepting := []
   yylexaccepting(myautomata)
   init_semantic_actions()

}

   return yyulex(myautomata)

end

procedure init_semantic_actions()

   semantic_action := table()
   semantic_action[1] := semantic_action_1
   semantic_action[2] := semantic_action_2
   semantic_action[3] := semantic_action_3

end

procedure semantic_action_1()
   { cc+:=yyleng; wc+:= 1 }
end

procedure semantic_action_2()
   { cc +:= yyleng }
end

procedure semantic_action_3()
   { lc +:= 1; cc +:= 1 }
end


$line 10 "wcs.l"

# Count lines, words and characters in a file (or files).
# It should give the same results as wc.l but does it by supplying the input
# as a string one line at at a time to yylex() rather than via the standard input.
# The point is not efficiency -- this is less efficient -- but to test a sequence
# of string inputs to yylex().
procedure main(args)
   local f

   cc := wc := lc := 0
   while f := open(pop(args)) do {
      every yysetyyin(!f || "\n") do yylex()
      close(f)
   }
   write(right(lc, 8), right(wc, 8), right(cc, 8))
end

