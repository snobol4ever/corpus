procedure yylexaccepting(myautomata)
local currstate
accepttable := table()

   put(myautomata.states, currstate := anode(1, 0, [], [], []))
   myautomata.start := currstate

   put(myautomata.states, currstate := anode(2, 0, [], [], []))

   put(myautomata.states, currstate := anode(3, 6, [], [], []))
   put(myautomata.accepting, currstate)
   insert(accepttable, 3, 6)

   put(myautomata.states, currstate := anode(4, 55, [], [], []))
   put(myautomata.accepting, currstate)
   insert(accepttable, 4, 55)

   put(myautomata.states, currstate := anode(5, 54, [], [], []))
   put(myautomata.accepting, currstate)
   insert(accepttable, 5, 54)

   put(myautomata.states, currstate := anode(6, 55, [], [], []))
   put(myautomata.accepting, currstate)
   insert(accepttable, 6, 55)

   put(myautomata.states, currstate := anode(7, 55, [], [], []))
   put(myautomata.accepting, currstate)
   insert(accepttable, 7, 55)

   put(myautomata.states, currstate := anode(8, 2, [], [], []))
   put(myautomata.accepting, currstate)
   insert(accepttable, 8, 2)

   put(myautomata.states, currstate := anode(9, 31, [], [], []))
   put(myautomata.accepting, currstate)
   insert(accepttable, 9, 31)

   put(myautomata.states, currstate := anode(10, 55, [], [], []))
   put(myautomata.accepting, currstate)
   insert(accepttable, 10, 55)

   put(myautomata.states, currstate := anode(11, 7, [], [], []))
   put(myautomata.accepting, currstate)
   insert(accepttable, 11, 7)

   put(myautomata.states, currstate := anode(12, 8, [], [], []))
   put(myautomata.accepting, currstate)
   insert(accepttable, 12, 8)

   put(myautomata.states, currstate := anode(13, 27, [], [], []))
   put(myautomata.accepting, currstate)
   insert(accepttable, 13, 27)

   put(myautomata.states, currstate := anode(14, 23, [], [], []))
   put(myautomata.accepting, currstate)
   insert(accepttable, 14, 23)

   put(myautomata.states, currstate := anode(15, 13, [], [], []))
   put(myautomata.accepting, currstate)
   insert(accepttable, 15, 13)

   put(myautomata.states, currstate := anode(16, 24, [], [], []))
