procedure semantic_action_1()
   { yylineno +:= 1
                                 if isender(lasttoken) then {
                                    yytext := ";"
                                    t := tok(";")
                                    yytoken.line := yylineno - 1
                                    return t
                                 }
                               }
end

procedure semantic_action_87()
   { stop(yylineno, ": unexpected character ",image(yytext[1])) }
end

