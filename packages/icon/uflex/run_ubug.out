procedure yylexaccepting(myautomata)
local currstate
accepttable := table()

   put(myautomata.states, currstate := anode(1, 0, [], [], []))
   myautomata.start := currstate

   put(myautomata.states, currstate := anode(2, 3, [], [], []))
   put(myautomata.accepting, currstate)
   insert(accepttable, 2, 3)

   put(myautomata.states, currstate := anode(3, 2, [], [], []))
   put(myautomata.accepting, currstate)
   insert(accepttable, 3, 2)

   put(myautomata.states, currstate := anode(4, 2, [], [], []))
   put(myautomata.accepting, currstate)
   insert(accepttable, 4, 2)

   put(myautomata.states, currstate := anode(5, 2, [], [], []))
   put(myautomata.accepting, currstate)
   insert(accepttable, 5, 2)

   put(myautomata.states, currstate := anode(6, 2, [], [], []))
   put(myautomata.accepting, currstate)
   insert(accepttable, 6, 2)

   put(myautomata.states, currstate := anode(7, 2, [], [], []))
   put(myautomata.accepting, currstate)
   insert(accepttable, 7, 2)

   put(myautomata.states, currstate := anode(8, 2, [], [], []))
   put(myautomata.accepting, currstate)
   insert(accepttable, 8, 2)

   put(myautomata.states, currstate := anode(9, 2, [], [], []))
   put(myautomata.accepting, currstate)
   insert(accepttable, 9, 2)

   put(myautomata.states, currstate := anode(10, 2, [], [], []))
   put(myautomata.accepting, currstate)
   insert(accepttable, 10, 2)

   put(myautomata.states, currstate := anode(11, 2, [], [], []))
   put(myautomata.accepting, currstate)
   insert(accepttable, 11, 2)

   put(myautomata.states, currstate := anode(12, 2, [], [], []))
   put(myautomata.accepting, currstate)
   insert(accepttable, 12, 2)

   put(myautomata.states, currstate := anode(13, 1, [], [], []))
   put(myautomata.accepting, currstate)
   insert(accepttable, 13, 1)

end

global semantic_action

procedure yylex()
static myautomata
initial {
   myautomata := automata()

   myautomata.states := []
   myautomata.accepting := []
   yylexaccepting(myautomata)
   init_semantic_actions()

}

   return yyulex(myautomata)

end

procedure init_semantic_actions()

   semantic_action := table()
   semantic_action[1] := semantic_action_1
   semantic_action[2] := semantic_action_2
   semantic_action[3] := semantic_action_3

end

procedure semantic_action_3()
   { lex_error() }
end

procedure semantic_action_2()
   { write("IDENT"); return IDENT }
end

procedure semantic_action_1()
   { write("procedure"); return PROCEDURE }
end


$line 12 "ubug.l"

procedure lex_error()
   yyerror("token not recognized ", image(yytext))
end
procedure uni_error(s)
   /errors := 0
   /s := "token not recognized"
write("uni_error calls yyerror ", image(s))
   yyerror(s)
   errors +:= 1
end

# implement semi-colon insert here, swap yylex:=:yylex2
procedure yylex2()
  static saved_tok, saved_yytext, seen_eof
  local rv
  if \seen_eof then return 0
  if \saved_tok then {
    rv := saved_tok
    saved_tok := &null
    yytext := saved_yytext
    yylval := yytoken := token(rv, yytext, yylineno, yycolno, yyfilename)
    if \debuglex then
      write("yylex() : ", tokenstr(rv), "\t", image(yytext))
    return rv
  }
  if /ender := iand(tokflags, Ender) then
      tokflags := 0
  if not (rv := yylex2()) then {
	 yytext := ""
	 if \debuglex then
	     write("yylex() : EOFX")
         seen_eof := 1
         return EOFX
  }
  if ender~=0 & iand(tokflags, Beginner)~=0 & iand(tokflags, Newline)~=0 then {
    saved_tok := rv
    saved_yytext := yytext
    yytext := ";"
    rv := SEMICOL
    }
   yylval := yytoken := token(rv, yytext, yylineno, yycolno, yyfilename)
   if \debuglex then
      write("yylex() : ", tokenstr(rv), "\t", image(yytext))
   return rv
end

# handle multi-line string, eating underscore-newline pairs and the leading
# spaces of the next line
procedure mls()
  outs := ""
  yytext ? {
     while outs ||:= tab(find("_\n")) do {
       move(2); tab(many(' \t'))
       }
     outs ||:= tab(0)
     }
  yytext := outs
  yyleng := *yytext
end
