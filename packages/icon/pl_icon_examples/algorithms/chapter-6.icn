link testing

procedure main()
  run_bfs_example();
  run_dfs_example();
  run_maze_example();
end

# -- implementation using Adjacency List

procedure al_new_graph(num_nodes)
  local graph;
  
  graph := list();
  every 1 to num_nodes do {
    put(graph, list())
  };
  
  return graph;
end

procedure al_add_edge(graph, u, v)
  put(graph[u], v);
end

record al_edge(start_node, end_node, weight)

procedure al_add_weighted_edge(graph, u, v, weight)
  put(graph[u], edge(u, v, weight));
end

procedure breadth_first_search(graph, start)
  local queue, parent, visited;
  local current, vertex;

  parent := table();
  queue := list();
  put(queue, start);
  visited := set();
  insert(visited, start);

  while *queue > 0 do {
    current := pop(queue);
    every vertex := !graph[current] do {
      if not member(visited, vertex) then {
        insert(visited, vertex);
        parent[vertex] := current;
        put(queue, vertex)
      }
    }
  };

  return parent;
end

procedure depth_first_search(graph, start)
  local vertex;
  static parent, visited;

  initial {
    parent := table();
    visited := set()
  };

  insert(visited, start);

  every vertex := !graph[start] do {
    if not member(visited, vertex) then {
      parent[vertex] := start;
      depth_first_search(graph, vertex)
    }
  };

  return parent;
end


# -- implementation using Adjacency Matrix

procedure am_new_graph(num_nodes)
  local graph;
  
  graph := list();
  every 1 to num_nodes do 
    put(graph, list(num_nodes, 0));
  return graph;
end

procedure am_add_edge(graph, u, v)
  graph[u][v] := 1;
end

procedure am_add_undirected_edge(graph, u, v, w)
  graph[u][v] := w;
  graph[v][u] := w;
end

procedure am_edge_weight(graph, u, v)
  return graph[u][v];
end

# -- examples

procedure run_bfs_example()
  local graph, parent;
  local k;

  # -- create example graph using adjacency list
  graph := al_new_graph(6);
  al_add_edge(graph, 1, 2);
  al_add_edge(graph, 1, 4);
  al_add_edge(graph, 4, 2);
  al_add_edge(graph, 2, 5);
  al_add_edge(graph, 5, 3);
  al_add_edge(graph, 3, 6);
  al_add_edge(graph, 6, 6);

  # -- run the search
  parent := breadth_first_search(graph, 1);

  write("BFS output: ");
  every k := key(parent) do {
    write("Vertex ", k, " <= ", parent[k])
  };
end

procedure run_dfs_example()
  local graph, parent;
  local k;

  # -- create example graph using adjacency list
  graph := al_new_graph(6);
  al_add_edge(graph, 1, 2);
  al_add_edge(graph, 1, 4);
  al_add_edge(graph, 4, 2);
  al_add_edge(graph, 2, 5);
  al_add_edge(graph, 5, 3);
  al_add_edge(graph, 3, 6);
  al_add_edge(graph, 6, 6);

  # -- run the search
  parent := depth_first_search(graph, 1);

  write("DFS output: ");
  every k := key(parent) do {
    write("Vertex ", k, " <= ", parent[k])
  };
end

procedure run_maze_example()
  local graph, maze, parent;
  local i, j, k, posn, goal_node, start_node;

  maze := list();
  put(maze, "####.##");
  put(maze, "#....##");
  put(maze, "#.#.#.#");
  put(maze, "#.#...#");
  put(maze, "#.###.#");
  put(maze, "#.....#");
  put(maze, "#######");

  goal_node := to_n(*maze[1], 1, 5);
  start_node := to_n(*maze[1], 3, 6);

  # -- create graph from maze
  graph := al_new_graph(*maze * *maze[1]);
  every i := 1 to *maze do {
    every j := 1 to *maze[i] do {
      if maze[i][j] ~== "." then
        next;
      if i-1 > 1 & maze[i-1][j] == "." then {
        al_add_edge(graph, to_n(*maze[1], i,j), to_n(*maze[1], i-1,j));
        al_add_edge(graph, to_n(*maze[1], i-1,j), to_n(*maze[1], i,j))
      };
      if i+1 < *maze & maze[i+1][j] == "." then {
        al_add_edge(graph, to_n(*maze[1], i,j), to_n(*maze[1], i+1,j));
        al_add_edge(graph, to_n(*maze[1], i+1,j), to_n(*maze[1], i,j))
      };
      if j-1 > 1 & maze[i][j-1] == "." then {
        al_add_edge(graph, to_n(*maze[1], i,j), to_n(*maze[1], i,j-1));
        al_add_edge(graph, to_n(*maze[1], i,j-1), to_n(*maze[1], i,j))
      };
      if j+1 < *maze[i] & maze[i][j+1] == "." then {
        al_add_edge(graph, to_n(*maze[1], i,j), to_n(*maze[1], i,j+1));
        al_add_edge(graph, to_n(*maze[1], i,j+1), to_n(*maze[1], i,j))
      }
    }
  };
      
  # -- run the search
  parent := breadth_first_search(graph, start_node);

  # -- trace back from goal
  write("Maze output: ");
  writes("Path: ");
  posn := goal_node;
  while posn ~= start_node do {
    writes(to_s(*maze[1], posn), " <= ");
    posn := parent[posn]
  };
  write(to_s(*maze[1], posn));
end

procedure to_n(m, a, b)
  return m*a + b;
end

procedure to_s(m, n)
  return "[" || n/m || " " || n%m || "]";
end
