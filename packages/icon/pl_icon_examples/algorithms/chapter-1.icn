#> Beginning Java Data Structures and Applications
#> Chapter 1: Algorithms and Complexities

link testing

procedure main()
  run_tests();
end

# ----------------------------------------------------------------------------

procedure convert_to_decimal(binary_string)
  local conversion, result;
  local i;

  conversion := 1;
  result := 0;
  
  every i := *binary_string to 1 by -1 do {
    if binary_string[i] == "1" then
      result +:= conversion;
    conversion *:= 2
  };

  return result;
end

procedure convert_octal_to_decimal(octal_string)
  local conversion, result;
  local i;

  conversion := 1;
  result := 0;
  
  every i := *octal_string to 1 by -1 do {
    result +:= conversion * integer(octal_string[i]);
    conversion *:= 8
  };

  return result;
end

procedure search_string_array(target, strings)
  local i;
  
  every i := 1 to *strings do 
    if target == strings[i] then
      return i;
      
  return -1;
end

procedure contains_duplicates(numbers)
  local i, j;
  
  every i := 1 to *numbers do {
    every j := 1 to *numbers do {
      if i ~= j & numbers[i] = numbers[j] then
        return numbers[i]
    }
  };
  fail;
end

# Example of Linear Complexity
procedure count_chars(c, str)
  local count, i;
  
  count := 0;
  
  every i := 1 to *str do
    if c == str[i] then
      count +:= 1;
  
  return count;
end

procedure faster_intersection(a, b)
  local i, j, result;
  
  a := sort(a);
  b := sort(b);
  result := list();
  i := 1;
  j := 1;
  while i <= *a & j <= *b do {
    if a[i] = b[j] then {
      put(result, a[i]);
      i +:= 1;
      j +:= 1
    } else if a[i] > b[j] then {
      j +:= 1
    } else {
      i +:= 1
    }
  };
  
  return result;
end

# ----------------------------------------------------------------------------
# Tests

procedure run_tests()
  test_start("Chapter 1 - Algorithms and Complexities");

  test_equals(1, convert_to_decimal("1"));
  test_equals(23, convert_to_decimal("10111"));
  test_equals(1, convert_octal_to_decimal("1"));
  test_equals(17, convert_octal_to_decimal("21"));
  test_equals(64, convert_octal_to_decimal("100"));

  test_equals(-1, search_string_array("abc", []));
  test_equals(-1, search_string_array("abc", ["def", "ghi"]));
  test_equals(1, search_string_array("def", ["def", "ghi"]));
  test_equals(2, search_string_array("ghi", ["def", "ghi"]));

  test_succeeds(create contains_duplicates([1,3,1]));
  test_fails(create contains_duplicates([]));
  test_fails(create contains_duplicates([2]));
  test_fails(create contains_duplicates([1,2,3]));
  
  test_equals(0, count_chars("a", "bbbb"));
  test_equals(2, count_chars("a", "abcad"));

  test_equal_lists([], faster_intersection([1,2,3], [4]));
  test_equal_lists([1], faster_intersection([1,2,3], [4,1]));
  test_equal_lists([1,3], faster_intersection([1,2,3], [4,1,3]));

  test_finish();
end

procedure test_equal_lists(list1, list2)
  local i;

  test_equals(*list1, *list2);
  every i := 1 to *list1 do 
    test_equals(list1[i], list2[i]);
end
