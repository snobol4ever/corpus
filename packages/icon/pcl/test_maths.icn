# test_maths.icn -- the "Maths Tests" of pcl_test.icn (its lines 468 to 542, as they stand there) under a main of ours that runs this one group
link abbrev, icon_formatters, icon_lexer, integer_division, json, maths, sort_libraries, statistics, testing

procedure main()
  test_maths();
end

# ------------------------------------------------------------------------
# Maths Tests

procedure test_maths()
  local num_keys, primes;

  test_start("Maths");
  # - ceiling
  test_equals(2, ceiling(2));
  test_equals(3, ceiling(2.5));
  test_equals(0, ceiling(0));
  test_equals(-2, ceiling(-2));
  test_equals(-2, ceiling(-2.5));
  # - clamp
  test_equals(5, clamp(3, 5, 10));
  test_equals(10, clamp(12, 5, 10));
  test_equals(7, clamp(7, 5, 10));
  # - floor
  test_equals(2, floor(2));
  test_equals(2, floor(2.5));
  test_equals(0, floor(0));
  test_equals(-2, floor(-2));
  test_equals(-3, floor(-2.5));
  # - round
  test_equals(2, round(2));
  test_equals(4, round(3.5));
  test_equals(2, round(2.5));
  test_equals(0, round(0));
  test_equals(-2, round(-2));
  test_equals(-2, round(-2.5));
  test_equals(-4, round(-3.5));
  # - truncate
  test_equals(2, maths_truncate(2));
  test_equals(3, maths_truncate(3.5));
  test_equals(2, maths_truncate(2.5));
  test_equals(0, maths_truncate(0));
  test_equals(-2, maths_truncate(-2));
  test_equals(-2, maths_truncate(-2.5));
  test_equals(-3, maths_truncate(-3.5));
  # - generate_primes
  every put(primes := list(), primes_generator(10));
  test_equals(4, *primes);
  test_equals(2, primes[1]);
  test_equals(3, primes[2]);
  test_equals(5, primes[3]);
  test_equals(7, primes[4]);
  # - prime_factors
  primes := prime_factors(360);
  num_keys := 0;
  every key(primes) do num_keys +:= 1;
  test_equals(3, num_keys);
  test_equals(3, primes[2]);
  test_equals(2, primes[3]);
  test_equals(1, primes[5]);
  primes := prime_factors(17);
  num_keys := 0;
  every key(primes) do num_keys +:= 1;
  test_equals(1, num_keys);
  test_equals(1, primes[17]);
  primes := prime_factors(20);
  num_keys := 0;
  every key(primes) do num_keys +:= 1;
  test_equals(2, num_keys);
  test_equals(2, primes[2]);
  test_equals(1, primes[5]);
  # - number theory procedures
  test_equals(3, extended_euclidean_algorithm(321, 843)[1]);
  test_equals(-21, extended_euclidean_algorithm(321, 843)[2]);
  test_equals(8, extended_euclidean_algorithm(321, 843)[3]);
  test_equals(3, gcd(321, 843));
  test_equals(90201, lcm(321, 843));
  test_equals(8, euler_totient(20));

  test_finish();
end
