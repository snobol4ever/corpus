    ["**:=", [lexer_token("AUG_INTER", "**:=")]],
    ["|||", [lexer_token("LCONCAT", "|||")]],
    ["|||:=", [lexer_token("AUG_LCONCAT", "|||:=")]],
    ["-", [lexer_token("MINUS", "-")]],
    ["-:=", [lexer_token("AUG_MINUS", "-:=")]],
