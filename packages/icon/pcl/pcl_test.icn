# Run tests for all relevant files in "pcl" library
#
link abbrev, icon_formatters, icon_lexer, integer_division, json, maths, sort_libraries, statistics, testing

procedure main()
  test_abbrev();
  test_icon_formatter();
  test_icon_lexer();
  test_integer_division();
  test_json();
  test_maths();
  test_sort_libraries();
  test_statistics();
end

# ------------------------------------------------------------------------
# Abbrev Tests

procedure test_abbrev() 
  test_start("Abbrev");
  do_abbrev_tests_1();
  do_abbrev_tests_2();
  do_abbrev_tests_3();
  test_finish();
end

procedure do_abbrev_tests_1 ()
  local t;

  t := abbrev (["car", "cat"]);
  test_equals(2, *t);
  test_succeeds(create member(t, "car") & t["car"] == "car");
  test_succeeds(create member(t, "car") & t["car"] == "car");
  test_succeeds(create member(t, "cat") & t["cat"] == "cat");
end

procedure do_abbrev_tests_2 ()
  local t;

  t := abbrev(["car", "cone"]);
  test_equals(5, *t);
  test_succeeds(create member(t, "ca") & t["ca"] == "car");
  test_succeeds(create member(t, "car") & t["car"] == "car");
  test_succeeds(create member(t, "co") & t["co"] == "cone");
  test_succeeds(create member(t, "con") & t["con"] == "cone");
  test_succeeds(create member(t, "cone") & t["cone"] == "cone");
end

procedure do_abbrev_tests_3 ()
  local t;

  t := abbrev(["car", "cat", "dog"], "c");
  test_equals(2, *t);
  test_succeeds(create member(t, "car") & t["car"] == "car");
  test_succeeds(create member(t, "cat") & t["cat"] == "cat");
end

# ------------------------------------------------------------------------
# Icon Formatter Tests

procedure test_icon_formatter()
  local html_styles, result;

  # create some html styles to simplify comparisons
  html_styles := table("blank");
  html_styles["identifier"] := "id";
  html_styles["operator"] := "op";
  html_styles["punctuation"] := "pn";
  html_styles["number"] := "nm";
  html_styles["string"] := "st";

  test_start("Icon Formatter");

  result := icon_html_format("write(2, \"string\")", html_styles);
  test_equals(1, *result);
  test_equals("<span style=\"id\">write</span><span style=\"pn\">(</span><span style=\"nm\">2</span><span style=\"pn\">,</span><span style=\"blank\"> </span><span style=\"st\">\"string\"</span><span style=\"pn\">)</span>", result[1]);
 
  test_finish();
end


# ------------------------------------------------------------------------
# Icon Lexer Tests

procedure test_icon_lexer()
  test_start("Icon Lexer");

  test_keywords();
  test_identifiers();
  test_integer_literals();
  test_real_literals();
  test_string_literals();
  test_cset_literals();
  test_operators();
  test_reserved_words();
  test_preprocessor();

  test_multi_tokens();
  test_multi_lines();
  test_include_comments();

  test_finish();
end

procedure test_keywords()
  test_lexer_cases([
    ["&digits", [lexer_token("KEYWORD", "&digits")]]
  ]);
end

procedure test_identifiers()
  test_lexer_cases([
    ["_", [lexer_token("IDENT", "_")]],
    ["a", [lexer_token("IDENT", "a")]],
    ["_X_a", [lexer_token("IDENT", "_X_a")]],
    ["xy", [lexer_token("IDENT", "xy")]]
  ]);
end

procedure test_integer_literals()
  test_lexer_cases([
    ["1", [lexer_token("INT_LIT", "1")]],
    ["1234", [lexer_token("INT_LIT", "1234")]],
    ["2r0100", [lexer_token("INT_LIT", "2r0100")]],
    ["2R0100", [lexer_token("INT_LIT", "2R0100")]], 
    ["16rfe", [lexer_token("INT_LIT", "16rfe")]],
    ["16RfE", [lexer_token("INT_LIT", "16RfE")]],
    ["36rcat", [lexer_token("INT_LIT", "36rcat")]]
  ]);
end

procedure test_real_literals()
  test_lexer_cases([
    ["1.2", [lexer_token("REAL_LIT", "1.2")]],
    ["1.2e2", [lexer_token("REAL_LIT", "1.2e2")]],
    ["1.2E2", [lexer_token("REAL_LIT", "1.2e2")]],
    ["1e-2", [lexer_token("REAL_LIT", "1e-2")]],
    ["16.", [lexer_token("REAL_LIT", "16.")]]
  ]);
end

procedure test_string_literals()
  test_lexer_cases([
    ["\"abc\"", [lexer_token("STRING_LIT", "abc")]],
    ["\"ab\\\"c\"", [lexer_token("STRING_LIT", "ab\"c")]],
    ["\"\"", [lexer_token("STRING_LIT", "")]]
  ]);
end

procedure test_cset_literals()
  test_lexer_cases([
    ["'abc'", [lexer_token("CSET_LIT", "abc")]],
    ["'ab\\'c'", [lexer_token("CSET_LIT", "ab'c")]]
  ]);
end

