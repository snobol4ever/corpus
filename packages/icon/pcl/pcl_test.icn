    [":=", [lexer_token("ASSIGN", ":=")]],
    [":=:", [lexer_token("SWAP", ":=:")]],
    ["<-", [lexer_token("REVASSIGN", "<-")]],
    ["<->", [lexer_token("REVSWAP", "<->")]],
    ["&", [lexer_token("AND", "&")]],
    ["&:=", [lexer_token("AUG_AND", "&:=")]],
    ["@", [lexer_token("AT", "@")]],
    ["@:=", [lexer_token("AUG_AT", "@:=")]],
    ["^", [lexer_token("CARET", "^")]],
    ["^:=", [lexer_token("AUG_CARET", "^:=")]],
    ["||", [lexer_token("CONCAT", "||")]],
    ["||:=", [lexer_token("AUG_CONCAT", "||:=")]],
    ["--", [lexer_token("DIFF", "--")]],
