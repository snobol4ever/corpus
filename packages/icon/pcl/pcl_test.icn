    ["=", [lexer_token("NMEQ", "=")]],
    ["=:=", [lexer_token("AUG_NMEQ", "=:=")]],
    [">=", [lexer_token("NMGE", ">=")]],
    [">=:=", [lexer_token("AUG_NMGE", ">=:=")]],
    [">", [lexer_token("NMGT", ">")]],
    [">:=", [lexer_token("AUG_NMGT", ">:=")]],
    ["<=", [lexer_token("NMLE", "<=")]],
    ["<=:=", [lexer_token("AUG_NMLE", "<=:=")]],
    ["<", [lexer_token("NMLT", "<")]],
    ["<:=", [lexer_token("AUG_NMLT", "<:=")]],
    ["~=", [lexer_token("NMNE", "~=")]],
    ["~=:=", [lexer_token("AUG_NMNE", "~=:=")]],
    ["+", [lexer_token("PLUS", "+")]],
    ["+:=", [lexer_token("AUG_PLUS", "+:=")]],
    ["?", [lexer_token("QMARK", "?")]],
