# test_json.icn -- the "JSON Tests" of pcl_test.icn (its lines 429 to 466, as they stand there) under a main of ours that runs this one group
link abbrev, icon_formatters, icon_lexer, integer_division, json, maths, sort_libraries, statistics, testing

procedure main()
  test_json();
end

# ------------------------------------------------------------------------
# JSON Tests

procedure test_json()
  local eg;

  test_start("JSON");

  # - booleans
  test_equals("TRUE", json_from_lines("true"));
  test_equals("FALSE", json_from_lines("false"));
  # - lists
  test_equals([], json_from_lines("[]"), "empty json list", equal_lists);
  test_equals([2], json_from_lines("[2]"), "single json list", equal_lists);
  test_equals([1, "TRUE", &null], json_from_lines("[1, true, null]"), "multiple json list", equal_lists);
  # - null
  test_equals(&null, json_from_lines("null"));
  # - numbers
  test_equals(0, json_from_lines("0"));
  test_equals(123, json_from_lines("123"));
  test_equals(12300.0, json_from_lines("123e2"));
  test_equals(12.3, json_from_lines("12.3"));
  test_equals(-123, json_from_lines("-123"));
  # - tables
  eg := json_from_lines("{}");
  test_equals("table", type(eg));
  test_equals(0, *eg);
  eg := json_from_lines("{\"a\" : 3}");
  test_equals("table", type(eg));
  test_equals(1, *eg);
  test_equals(3, eg["a"]);
  # - strings
  test_equals("", json_from_lines("\"\""));
  test_equals("abc", json_from_lines("\"abc\""));
  test_equals("a\"b\"c", json_from_lines("\"a\\\"b\\\"c\""));

  test_finish();
end

# equal_lists, a helper this group calls, from line 722 of pcl_test.icn
procedure equal_lists(lst1, lst2)
  local i;

  if (0 = *lst1) & (0 = *lst2) then return;
  if *lst1 ~= *lst2 then fail;
  every i := 1 to *lst1 do {
    if lst1[i] ~=== lst2[i] then fail
  };
  return;
end
