#  wifisd_driver.icn -- the grading vehicle for gprocs/wifisd.icn: it links wifisd and exercises wif2isd, which reads
#  a WIF (Weaving Information File) from an open file and writes the draft it describes, xencode()d, to &output.  No
#  WIF ships with the IPL and no file is written, so the WIF is embedded in THIS source file: the continuation lines
#  of the string literal wifdata below each begin in column 1, and wif2isd, handed this very file opened for
#  reading, takes every line that begins with "[" as a section header and ignores the rest of the program text.  The
#  WIF has weaving, warp, weft, color palette, color table, threading, treadling, tie-up and partial warp-color
#  sections.  After wif2isd has run, the helpers info and decode_data are called directly on the sections it
#  located (the globals wif, sections, data_default and data_entries are the ones wif2isd itself set).
#  NOT exercised: abort (calls stop(), terminating the program -- reached only for a WIF missing its weaving or weft
#  information); wif2isd over a WIF with a liftplan section (not included, to keep the draft small).
link wifisd
procedure main()
   local f, wifdata, x, k;
   wifdata := "_
[WIF]_
Version=1.1;_
Source Program=hand;_
[WEAVING]_
Shafts=4;_
Treadles=4;_
[WARP]_
Threads=8;_
Color=1;_
[WEFT]_
Threads=6;_
Color=2;_
[COLOR PALETTE]_
Entries=2;_
Range=0,999;_
[COLOR TABLE]_
1=999,999,999;_
2=0,0,0;_
[THREADING]_
1=1;_
2=2;_
3=3;_
4=4;_
5=4;_
6=3;_
7=2;_
8=1;_
[TREADLING]_
1=1;_
2=2;_
3=3;_
4=4;_
5=3;_
6=2;_
[TIEUP]_
1=1,2;_
2=2,3;_
3=3,4;_
4=4,1;_
[WARP COLORS]_
3=2;_
6=2;_
";
   write("embedded WIF: ", *wifdata, " characters");
   f := open("wifisd_driver.icn") | stop("cannot open wifisd_driver.icn");
   write("wif2isd:");
   wif2isd(f, "driver draft");
   close(f);
   write();
   write("lines kept by wif2isd: ", *wif);
   write("sections located:");
   every k := !sort(sections) do write("  ", left(k[1], 14), k[2]);
   write("info(\"weaving\"):");
   every k := !sort(info("weaving")) do write("  ", k[1], "=", k[2]);
   write("info(\"color palette\"):");
   every k := !sort(info("color palette")) do write("  ", k[1], "=", k[2]);
   write("info(\"notes\"): ", image(info("notes")) | "fails (no such section)");
   writes("decode_data(\"threading\"):");
   every writes(" ", !decode_data("threading"));
   write();
   writes("decode_data(\"treadling\"):");
   every writes(" ", !decode_data("treadling"));
   write();
   writes("decode_data(\"warp colors\"):");
   every writes(" ", image(!decode_data("warp colors")));
   write();
   writes("decode_data(\"color table\"):");
   every writes(" ", image(!decode_data("color table")));
   write();
   writes("decode_data(\"tieup\"):");
   every writes(" ", image(!decode_data("tieup")));
   write();
   write("decode_data(\"liftplan\"): ", image(decode_data("liftplan")) | "fails (no such section)");
end
