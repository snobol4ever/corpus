#  xbfont_driver.icn -- the grading vehicle for gprocs/xbfont.icn: it links xbfont and exercises BestFont and
#  RankFonts in their documented list form (a list of X font names passed instead of a window), over a fixed list of
#  tuned and scalable X logical font names, with size, family, weight, slant, spacing and sans-serif requests; and
#  the helpers they call directly: XBF_defaults, XBF_tokenlist, XBF_weights, XBF_sizes, XBF_fontlist (list form),
#  XBF_eval and XBF_spec (tuned and scalable names).
#  NOT exercised: BestFont/RankFonts/XBF_fontlist given a window (opens a pipe to the host's xlsfonts program,
#  xbfont.icn:268, and needs a window).
link xbfont
global F
procedure main()
   local r, t, L, s;
   F := ["-adobe-times-medium-r-normal--14-140-75-75-p-74-iso8859-1",
      "-adobe-times-bold-i-normal--18-180-75-75-p-94-iso8859-1",
      "-adobe-helvetica-medium-o-normal--12-120-75-75-p-67-iso8859-1",
      "-adobe-helvetica-bold-r-normal--24-240-75-75-p-138-iso8859-1",
      "-adobe-courier-medium-r-normal--10-100-75-75-m-60-iso8859-1",
      "-misc-fixed-medium-r-semicondensed--13-120-75-75-c-60-iso8859-1",
      "-b&h-lucida-medium-r-normal-sans-17-120-100-100-p-96-iso8859-1",
      "-bitstream-charter-medium-i-normal--0-0-0-0-p-0-iso8859-1",
      "-adobe-symbol-medium-r-normal--20-140-100-100-p-107-adobe-fontspecific",
      "-misc-typewriter-bold-r-normal--16-120-100-100-m-90-iso8859-1",
      "cursor"];
   write("XBF_tokenlist:");
   every s := !XBF_tokenlist(["Times Bold,italic  20", "  ", "\tMono,,sans"]) do write("  ", image(s));
   XBF_defaults();
   write("XBF_defaults: defsize=", XFW_defsize, " size=", XFW_size, " maxover=", XFW_maxover, " maxunder=",
      XFW_maxunder, " scaled=", XFW_scaled, " exact=", XFW_exact, " tiebreakers=", *XFW_tiebreakers);
   write("XBF_weights:");
   XBF_wantsize := XFW_defsize;
   every r := !XBF_weights(["times", "18", "i", "m", "p", "r", "o", "s"]) do write("  ", left(image(r.str), 14), r.val);
   write("  wantsize now ", XBF_wantsize);
   L := XBF_sizes(10);
   writes("XBF_sizes(10): ", *L, " entries:");
   every writes(" ", !L);
   write();
   L := XBF_sizes(14);
   writes("XBF_sizes(14): ", *L, " entries:");
   every writes(" ", !L);
   write();
   writes("XBF_fontlist(list): ");
   every writes(" ", XBF_fontlist(["a", "b", "c"]));
   write();
   write("XBF_eval with the size-14 table:");
   XBF_sizval := XBF_sizes(14);
   t := XBF_weights(["times", "bold"]);
   every s := F[1 | 2 | 4 | 8 | 11] do write("  ", right(XBF_eval(s, t), 5), " ", s);
   write("XBF_eval of an exact name: ", XBF_eval("cursor", XBF_weights(["cursor"])));
   write("XBF_spec:");
   write("  ", XBF_spec(F[1], 20));
   write("  ", XBF_spec(F[8], 20));
   write("  ", XBF_spec(F[8], 9));
   write("  ", XBF_spec("cursor", 12));
   every s := "times 14" | "helvetica bold 24" | "courier 10 mono" | "sans 17" | "italic 18" |
         "oblique helvetica" | "charter italic 30" | "fixed m 13" | "typewriter" | "cursor" | "roman 12 p" do {
      write("RankFonts(F, ", image(s), "):");
      every r := RankFonts(F, s) \ 4 do write("  ", right(r.val, 5), " ", r.str);
      write("  BestFont: ", BestFont(F, s))
      };
   write("RankFonts with several spec arguments:");
   every r := RankFonts(F, "lucida", "gill", "sans", 18) \ 3 do write("  ", right(r.val, 5), " ", r.str);
   write("BestFont over an empty list: ", BestFont([], "times") | "fails");
   write("the first six of BestFont(F, \"12\") (the rest tie on score):");
   every write("  ", BestFont(F, "12")) \ 6;
end
