!B:D:F:L:T:X+Y+W+H+M+G:P:S: 27
 ! B : D : F : L : T : X + Y + W + H + M + G : P : S :
[ -W 400 -H 300 -M 10 ] -> H=300 M=10 W=400  remaining:
[ -B white -F navy -L My Window -T fixed ] -> B="white" F="navy" L="My Window" T="fixed"  remaining:
[ -G 640x480+10+20 -! ] -> !=1 G="640x480+10+20"  remaining:
[ -P 5,6 -S 300,200 -f data.txt -v ] -> P="5,6" S="300,200" f="data.txt" v=1  remaining:
[ -X -15 -Y +7 -D host:0 rest of args ] -> D="host:0" X=-15 Y=7  remaining: rest of args
[ ] ->  remaining:
