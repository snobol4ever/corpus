pack_modkeys / unpack_modkeys
  ""     ->       0 = 16r0 -> ""
  "c"    ->   65536 = 16r10000 -> "c"
  "m"    ->  131072 = 16r20000 -> "m"
  "s"    ->  262144 = 16r40000 -> "s"
  "cm"   ->  196608 = 16r30000 -> "cm"
  "cs"   ->  327680 = 16r50000 -> "cs"
  "ms"   ->  393216 = 16r60000 -> "ms"
  "cms"  ->  458752 = 16r70000 -> "cms"
  "scm"  ->  458752 = 16r70000 -> "cms"
  "ccc"  ->   65536 = 16r10000 -> "c"
  unpack_modkeys(0) = ""
  unpack_modkeys(65536) = "c"
  unpack_modkeys(458752) = "cms"
  unpack_modkeys(524287) = "cms"
  unpack_modkeys(65535) = ""
  unpack_modkeys(327680) = "cs"
  unpack_modkeys("196608") = "cm"
pack_intrvl / unpack_intrvl
  0           ->            0 -> 0
  1           ->        65536 -> 1
  100         ->      6553600 -> 100
  4095        ->    268369920 -> 4095
  4096        ->    285212672 -> 4096
  4097        ->    285212672 -> 4096
  65535       ->    536805376 -> 65520
  65536       ->    553648128 -> 65536
  1000000     ->    792854528 -> 999936
  123456789   ->   1197146112 -> 123404288
