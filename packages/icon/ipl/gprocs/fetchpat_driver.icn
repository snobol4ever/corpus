#  fetchpat_driver.icn -- the grading vehicle for gprocs/fetchpat.icn: it links fetchpat and exercises fetchpat()
#  on its documented failure path: a pattern file that dopen() cannot find (in the current directory, or on DPATH,
#  which cannot supply an absolute nonexistent path either) makes fetchpat() fail, for several counts n.
#  NOT exercised: fetchpat() on a file that exists -- after reading, the library calls close(file) on the file NAME
#  (fetchpat.icn line 41) instead of the opened file, so iconx itself stops with "Run-time error 105 file expected"
#  for every existing file, whatever n is (measured on fetchpat("fetchpat.icn", 1)).
link fetchpat
procedure main()
   local n;
   every n := 0 | 1 | 3 do
      write("fetchpat(missing, ", n, "): ", image(fetchpat("/nonexistent-ipl-dir/none.pat", n)) | "fails");
   write("fetchpat(missing2, 2): ", image(fetchpat("/nonexistent-ipl-dir/sub/patterns.txt", 2)) | "fails");
   write("done");
end
