#  twists_driver.icn -- the grading vehicle for gprocs/twists.icn: it links twists and exercises twist1() and
#  twist2(), the generators of the point traces of twisting orbits, with two parameter sets each, printing the x and y
#  of every generated Point record (both compute only; nothing is drawn).
#  NOT exercised: nothing -- twist1() and twist2() are the file's only procedures (n=0 is avoided: the library
#  divides 2*pi by n, a run-time error 204 in iconx).
link twists
procedure main()
   local p, n;
   n := 0;
   every p := twist1(0, 0, 100, 6, 1, 1, 1, 1, 2, 2, 0.4, 0.2, 1, 0.5, 0.5, 1) do {
      n +:= 1;
      write("twist1 a ", n, ": ", p.x, " ", p.y)
      };
   n := 0;
   every p := twist1(50, 50, 80, 10, 2, 3, 1, 2, 3, 1, 0.3, 0.3, 2, 1, 0, 0.5) do {
      n +:= 1;
      write("twist1 b ", n, ": ", p.x, " ", p.y)
      };
   n := 0;
   every p := twist2(0, 0, 100, 6, 1, 1, 1, 1, 2, 2, 0.4, 0.2, 1, 1) do {
      n +:= 1;
      write("twist2 a ", n, ": ", p.x, " ", p.y)
      };
   n := 0;
   every p := twist2(10, -10, 60, 9, 3, 2, 2, 1, 1, 3, 0.5, 0.25, 3, 2) do {
      n +:= 1;
      write("twist2 b ", n, ": ", p.x, " ", p.y)
      }
end
