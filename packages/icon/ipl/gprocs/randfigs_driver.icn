#  randfigs_driver.icn -- the grading vehicle for gprocs/randfigs.icn: it links randfigs and exercises the endless
#  generators random_points(width, height) and random_lines(width, height) only on a 1-by-1 area: there the
#  library's random selections ?1 can only yield 1, so every point is (0, 0) and every line runs from (0, 0) to
#  (0, 0), and the output does not depend on the random sequence.  Each run is limited with \ n; the gobject
#  records Point and Line they build are printed field by field.
#  NOT exercised: random_points() and random_lines() on any larger area (random).
link randfigs
procedure main()
   local p, l, n;
   every p := random_points(1, 1) \ 3 do write(type(p), " ", p.x, ",", p.y, " ", image(p.z));
   every l := random_lines(1, 1) \ 2 do
      write(type(l), " ", type(l.p1), " ", l.p1.x, ",", l.p1.y, " -> ", l.p2.x, ",", l.p2.y);
   n := 0;
   every p := random_points(1, 1) \ 50 do if p.x = p.y = 0 then n +:= 1;
   every l := random_lines(1, 1) \ 50 do if l.p1.x = l.p2.y = 0 then n +:= 1;
   write("origin figures: ", n);
end
