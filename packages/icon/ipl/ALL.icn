   show(Viewpoint(10, 20, 30, 40, 50, 60, 70, 80));
   show(VisibilitySensor(10, 20, 30, 40, 50, 60));
   show(WorldInfo(10, 20));
   r := Box("2 2 2");
   write("box size ", r.size);
   r := Shape(Appearance(Material(0.2)), Sphere(1.5));
   write("shape ", type(r.appearance), " ", type(r.appearance.material), " ", r.appearance.material[1], " ", r.geometry.radius);
   r.geometry := Cone();
   show(r.geometry);
   r := Transform();
   r.translation := "0 1 0";
   show(r);
   r := Group([Box(), Sphere()]);
   write("group ", *r.children, " ", type(r.children[1]), " ", type(r.children[2]), " ", image(r.bboxSize));
