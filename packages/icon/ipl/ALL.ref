#----------------------------------------------------- 304 procs/recurmap_driver
procedure fib(i)
return {
if i = (1 | 2) then 1
else fib(i - 1) + fib(i - 2)
}
end
--
procedure q(i)
return {
if i = 1 then 1
if i = 2 then 1
else q(i - q(i - 1)) + q(i - q(i - 2))
}
end
--
f(n): extra
n * 2
}
end
--
}
