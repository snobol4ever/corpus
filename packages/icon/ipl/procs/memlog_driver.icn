#  memlog_driver.icn -- the grading vehicle for procs/memlog.icn: it links memlog and exercises memlog(f).  The
#  figures memlog writes (&storage, &regions, &collections) are implementation- and allocation-dependent, so the log
#  line itself goes to /dev/null and the driver grades only what is portable: memlog returns, its result is an
#  integer, it is non-negative, and it is positive once a list has been allocated.  (It went to &errout until
#  2026-09-27, but the IPL runner grades &errout too, so the iconx figures were in the ref; hq_icon.)  The &output
#  default of f is deliberately NOT exercised for the same reason.
link memlog
procedure main()
   local n, L, sink;
   sink := open("/dev/null", "w") | stop("cannot open /dev/null");
   n := memlog(sink);
   write("memlog returned: ", type(n));
   write("non-negative: ", if n >= 0 then "yes" else "no");
   L := list(1000, "x");
   n := memlog(sink);
   write("after allocation: ", type(n), " ", if n > 0 then "positive" else "zero");
end
