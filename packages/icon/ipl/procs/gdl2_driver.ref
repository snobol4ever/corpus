set_getdir_by_os() -> procedure unix_get_dir
  is unix_get_dir: yes
  is msdos_get_dir: no
set_getdir_rec_by_os() -> procedure unix_get_dir_rec
  is unix_get_dir_rec: yes
set_getdir_rec_by_os("find") -> procedure unix_get_dir_rec2
  is unix_get_dir_rec2: yes
  is msdos_get_dir_rec: no
set_getdir_rec_by_os(0) -> procedure unix_get_dir_rec2
get_dos_tempname("/nonexistent-ipl-dir/") -> "/nonexistent-ipl-dir/icondir.001"
get_dos_tempname("/nonexistent-ipl-dir/sub\\") -> "/nonexistent-ipl-dir/sub\\icondir.001"
get_dos_tempname(".\\nonexistent-ipl-dir\\") -> ".\\nonexistent-ipl-dir\\icondir.001"
get_dos_tempname("") -> "icondir.001"
