#  polystuf_driver.icn -- the grading vehicle for procs/polystuf.icn: it links polystuf and exercises poly, is_zero,
#  is_zero_poly, poly_add, poly_sub, poly_mul, poly_eval, term2string and poly_string.  Nothing is skipped.
link polystuf
procedure main()
   local p1, p2, z;
   p1 := poly(3, 2, -2, 1, 5, 0);
   p2 := poly(1, 1, -1, 0);
   write("p1 = ", poly_string(p1));
   write("p2 = ", poly_string(p2));
   write("sum = ", poly_string(poly_add(p1, p2)));
   write("diff = ", poly_string(poly_sub(p1, p2)));
   write("prod = ", poly_string(poly_mul(p1, p2)));
   write("p2*p2 = ", poly_string(poly_mul(p2, p2)));
   z := poly_sub(p1, p1);
   write("p1-p1 = ", poly_string(z));
   write("is_zero_poly(p1-p1) ", (is_zero_poly(z) & "yes") | "no");
   write("is_zero_poly(p1) ", (is_zero_poly(p1) & "yes") | "no");
   write("zero+p2 = ", poly_string(poly_add(z, p2)));
   write("eval p1 at 2: ", poly_eval(p1, 2));
   write("eval p2 at 3: ", poly_eval(p2, 3));
   write("eval p1 at 0.5: ", poly_eval(p1, 0.5));
   write("is_zero(0) ", (is_zero(0) & "yes") | "no");
   write("is_zero(0.0) ", (is_zero(0.0) & "yes") | "no");
   write("is_zero(4) ", (is_zero(4) & "yes") | "no");
   every write("term ", image(term2string(1 | -1 | 4 | 1, 0 | 1 | 3.0)));
   write(image(poly(1, 2, 3)) | "poly odd arg count fails");
   write("skip bad = ", poly_string(poly("a", 1, 2, 2, 7, "b")));
   write("single = ", poly_string(poly(-1, 5)))
end
