#  printf_driver.icn -- the grading vehicle for procs/printf.icn: it links printf and exercises sprintf, printf,
#  fprintf (to &output), the d s x o i r e conversions with width, justification, zero pad and precision, and the
#  helpers hexstr, octstr, fixnum, eformatstr and adjustfracprec.  Nothing is skipped.
link printf
procedure main()
   local L;
   write(image(sprintf("[%d] [%5d] [%-5d] [%05d]", 42, 42, 42, 42)));
   write(image(sprintf("[%s] [%.3s] [%8s] [%-8s|]", "hello", "hello", "hi", "hi")));
   write(image(sprintf("[%x] [%o] [%x] [%o] [%x]", 255, 8, 0, -1, "zz")));
   write(image(sprintf("[%i] [%i] [%10i]", "str", 3.5, 'ba')));
   write(image(sprintf("[%r] [%.2r] [%8.3r] [%.0r] [%r]", 3.14159, 2.675, -1.5, 7.6, "abc")));
   write(image(sprintf("[%e] [%.3e] [%12.2e] [%e] [%e]", 12345.678, 0.000123, -9.999, 0, 1e300)));
   write(image(sprintf("[%6.4e]", 123456.789)));
   write(image(sprintf("100%% done %q", 1)));
   write(image(sprintf("no conversions")));
   write(image(sprintf("")));
   printf("printf: %s=%d\n", "x", 17);
   fprintf(&output, "fprintf: %-6s|%6s|\n", "left", "right");
   every write(hexstr(16 | 4095 | -2 | 2147483648));
   every write(octstr(7 | 64 | -8));
   every write(fixnum(1.0 | 0.001 | -0.5 | 123.456, 2));
   write(fixnum(2));
   every write(eformatstr(1.5 | 1234.5 | 0.05 | -7.25e-10, 2, 10));
   write(eformatstr(9.99, 1, 3));
   L := adjustfracprec("12", 5);
   write(L[1], " ", L[2]);
   L := adjustfracprec("123456", 3);
   write(L[1], " ", L[2]);
   L := adjustfracprec("9996", 3);
   write(L[1], " ", L[2])
end
