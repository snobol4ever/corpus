#  progary_driver.icn -- the grading vehicle for procs/progary.icn: it links progary and exercises progary on the
#  module's own shipped source file progary.icn opened for reading (one row per line, one element per character,
#  every element initialized to the given value), with an integer, a string and the default null value, and on
#  /dev/null (a system device, always empty: an empty array).
#  NOT exercised: nothing -- progary is the module's only procedure.
link progary
procedure main()
   local f, A, i, s;
   f := open("progary.icn") | stop("cannot open progary.icn");
   A := progary(f, 0);
   close(f);
   write("rows: ", *A);
   s := "row lengths:";
   every s ||:= " " || *!A;
   write(s);
   write("longest row: ", maxlen(A));
   write("elements in all: ", total(A));
   write("A[1][1] = ", image(A[1][1]), ", A[", *A, "][1] = ", image(A[-1][1]));
   A[1][3] := 7;
   write("after A[1][3] := 7: A[1][3] = ", A[1][3], ", A[3][3] = ", A[3][3], " (rows are distinct lists)");
   f := open("progary.icn") | stop("cannot open progary.icn");
   A := progary(f, "x");
   close(f);
   i := 0;
   every !!A == "x" do i +:= 1;
   write("string value: ", i, " elements equal \"x\"");
   f := open("progary.icn") | stop("cannot open progary.icn");
   A := progary(f);
   close(f);
   i := 0;
   every /!!A do i +:= 1;
   write("default value: ", i, " elements are null");
   f := open("/dev/null") | stop("no /dev/null");
   A := progary(f, 1);
   close(f);
   write("/dev/null: ", type(A), " of ", *A, " rows")
end
procedure maxlen(A)
   local m;
   m := 0;
   every m <:= *!A;
   return m
end
procedure total(A)
   local n;
   n := 0;
   every n +:= *!A;
   return n
end
