#  repetit_driver.icn -- the grading vehicle for procs/repetit.icn: it links repetit and exercises repetit(L) on lists
#  with a repeating period, with no repetition, with a single element, and on hypothesis(L, n) directly.
#  Nothing is skipped.
link repetit
procedure main()
   write(repetit([1, 2, 3, 1, 2, 3, 1, 2, 3]));
   write(repetit([1, 1, 1, 1]));
   write(repetit(["a", "b", "a", "b", "a", "b"]));
   write(repetit([1, 2, 3, 4, 5]));
   write(repetit([7]));
   write(repetit([1, 2, 1, 3, 1, 2, 1, 3]));
   write(repetit([5, 6, 5, 6, 5, 7]));
   write(image(hypothesis([1, 2, 1, 2], 3)) | "hypothesis fails");
   write(image(hypothesis([1, 2, 3, 1, 2], 4)) | "hypothesis fails");
   write(image(hypothesis([1, 2, 1, 3], 3)) | "hypothesis fails")
end
