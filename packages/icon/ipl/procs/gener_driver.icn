#  gener_driver.icn -- the grading vehicle for procs/gener.icn: it links gener and exercises every generator it
#  documents -- days(), hex(), label(s,i), multii(i,j), months(), octal() and star(s) -- bounding the unbounded ones
#  with limitation.
link gener
procedure main()
   local n;
   every writes(days(), " ");
   write();
   every writes(months(), " ");
   write();
   every writes(hex() \ 20, " ");
   write();
   n := 0;
   every hex() do n +:= 1;
   write("hex count: ", n, " first: ", hex() \ 256 \ 1);
   every writes(octal() \ 12, " ");
   write();
   n := 0;
   every octal() do n +:= 1;
   write("octal count: ", n);
   every writes(label("L", 5) \ 6, " ");
   write();
   every writes(label("x", 0) \ 3, " ");
   write();
   every writes(multii(3, 2), " ");
   write();
   every writes(image(multii(7, 0)), " ");
   write("<none>");
   every writes(image(star("ab")) \ 15, " ");
   write();
   every writes(image(star("x")) \ 4, " ");
   write();
   write("end")
end
