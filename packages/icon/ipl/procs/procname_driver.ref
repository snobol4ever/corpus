procedure main -> "main" "main()"
procedure procname -> "procname" "procname()"
function write -> "write" "write()"
function upto -> "upto" "upto()"
function + -> "+2" "e1 + e2"
function - -> "-1" "-e"
function [] -> "[]2" "e1[e2]"
function ... -> "...3" "e1 to e2 by e3"
function [:] -> "[:]3" "e1[e2:e3]"
function * -> "*1" "*e"
function := -> ":=2" "e1 := e2"
record constructor point -> "point" "point()"
