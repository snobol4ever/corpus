#  sort_driver.icn -- the grading vehicle for procs/sort.icn: it links sort and exercises isort() with the
#  natural order, a key procedure with its extra argument and an integer subscript key; sortff() on records
#  over one and two fields; sortgen() in all four key/value orders; and sortt() by key and by value.  Values are
#  distinct where a value sort is shown, so no tie order is implied.  Skipped: sortt(T, 3), which is runerr(205).
link sort
record person(name, age, city)
procedure keylen(s, y)
   return *s * y
end
procedure imgl(L)
   local s, x;
   s := "";
   every x := !L do s ||:= " " || image(x);
   return "[" || s || " ]"
end
procedure main()
   local T, L, p, e, m;
   write(imgl(isort([5, 3, 9, 1, 3])));
   write(imgl(isort("banana")));
   write(imgl(isort(["ccc", "a", "bb", "dddd"], keylen, -1)));
   L := isort([[3, "c"], [1, "a"], [2, "b"]], 2);
   every p := !L do writes(" ", p[1], p[2]);
   write();
   L := [person("Ann", 30, "Rome"), person("Bob", 25, "Oslo"), person("Cid", 30, "Oslo"), person("Dee", 25, "Rome")];
   every p := !sortff(L, 2) do writes(" ", p.age);
   write();
   every p := !sortff(L, 2, 3) do writes(" ", p.name);
   write();
   every p := !sortff(L, 3, 2, 1) do writes(" ", p.name);
   write();
   write(*sortff([], 1), " ", *sortff([person("Z", 1, "Q")], 1));
   T := table();
   T["x"] := 3;
   T["y"] := 1;
   T["z"] := 2;
   every m := "k+" | "k-" | "v+" | "v-" do {
      writes(m, ":");
      every p := sortgen(T, m) do writes(" ", p[1], "=", p[2]);
      write()
      };
   every e := !sortt(T, 1) do writes(" ", type(e), "(", e.key, ",", e.value, ")");
   write();
   every e := !sortt(T, 2) do writes(" ", e.key, "=", e.value);
   write()
end
