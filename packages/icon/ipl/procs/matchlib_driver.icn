#  matchlib_driver.icn -- the grading vehicle for procs/matchlib.icn: it links matchlib and exercises the lexical
#  matchers rb_(), lb_(), rp_(), lp_() (which, as shipped, matches ")"), vb_(), nl_() and empty_() inside scanning.
link matchlib
procedure try(s, p)
   return s ? (image(p()) || "@" || &pos) | "fail"
end
procedure main()
   write(try("<a>", lb_));
   write(try(">x", rb_));
   write(try("(x", lp_));
   write(try(")x", lp_));
   write(try(")x", rp_));
   write(try("|b", vb_));
   write(try("\nq", nl_));
   write(try("abc", empty_));
   write(try("abc", rb_));
   "<>|" ? {
      write(image(lb_()), image(rb_()), image(vb_()), " ", &pos)
      }
end
