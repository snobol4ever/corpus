"no vars here" -> "no vars here"
"$HOME/bin" -> "/home/icon/bin"
"${x}y" -> "exy"
"$(x)z" -> "exz"
"$xy" -> "$xy"
"$long_name1-end" -> "LN-end"
"$undefined!" -> "$undefined!"
"${undefined}" -> "${undefined}"
"a$empty b" -> "a$empty b"
"cost $" -> "cost $"
"$$x" -> "$ex"
"" -> ""
"$x$x$x" -> "exexex"
"${HOME}/${x}/$(long_name1)" -> "/home/icon/ex/LN"
