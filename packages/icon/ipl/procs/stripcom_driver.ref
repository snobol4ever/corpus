"x := 1   # set x" -> "x := 1"
"# only a comment" -> fail
"   " -> fail
"" -> fail
"   write(\"a # b\")  # real" -> "write(\"a # b\")"
"c := '#'  # cset" -> "c := '#'"
"s := \"\\\"#\\\"\"  # escaped" -> "s := \"\\\"#\\\"\""
"   y := 2   " -> "y := 2"
"\tz := 3\t#" -> "z := 3"
"w := \"\\^##\" # ctrl" -> "w := \"\\^##\""
"a := b"
