#  lists_driver.icn -- the grading vehicle for procs/lists.icn: it links lists and exercises the list procedures
#  (limage, imag2lst, lclose, lcomb, lcompact, ldecollate, ldelete, ldupl, lequiv, levate, lextend, lfliph, lflipv,
#  lindex, lcollate, lconstant, linterl, llayer, llpad, lltrim, lmap, lpalin, lpermute, lreflect, lremvals, lrepl,
#  lresidue, lreverse, lrotate, lrpad, lrundown, lrunup, lrtrim, lshift, lst2str, lswap, lunique, lmaxlen, lminlen,
#  sortkeys, sortvalues, str2lst, lblock) and the list-scanning family l_Bscan/l_Escan/l_any/l_bal/l_find/l_many/
#  l_match/l_move/l_pos/l_tab/l_upto.  NOT exercised: file2lst(s), which reads a file.
link lists
procedure main()
   local L, t, x;
   L := [1, 2, 3, 4];
   write(limage(L), " ", limage([]), " ", limage(["a", 'b', 2.5]));
   write(limage(imag2lst("[1,2,[3,4],5]")), " ", *imag2lst("[]"));
   write(limage(lclose([1, 2, 3])), " ", limage(lclose([1, 2, 1])));
   every writes(limage(lcomb(L, 2)), " ");
   write();
   write(limage(lcompact([10, 30, 20, 30])));
   every writes(limage(!ldecollate([1, 2], [1, 2, 3, 4, 5])), " ");
   write();
   write(limage(ldelete([1, 2, 3, 4, 5], "2,4")));
   write(limage(ldupl(["a", "b"], 2)), " ", limage(ldupl([1, 2], [1, 3])));
   write(image(lequiv([1, [2, 3]], [1, [2, 3]])), " ", image(lequiv([1, 2], [1, 3])) | "lequiv fails");
   write(limage(levate([1, 2, 3, 4, 5, 6], 3, 9)));
   write(limage(lextend([1, 2, 3], 7)), " ", image(lextend([], 3)) | "lextend fails");
   write(limage(lfliph(L)), " ", limage(lfliph(["x", "y"])));
   write(limage(lflipv([1, 2, 3, 4])));
   every writes(lindex([1, 2, 1, 3, 1], 1), " ");
   write();
   write(limage(lcollate([1, 2, 3], ["a", "b"], [7, 8, 9])));
   write(lconstant([5, 5, 5]), " ", lconstant([5, 6]) | "not constant");
   write(limage(linterl([1, 2, 3], ["a", "b"])));
   write(limage(llayer([1, 2, 3], [1, 2])));
   write(limage(llpad([1, 2], 5, 0)), " ", limage(lrpad([1, 2], 4, "z")));
   write(limage(lltrim([0, 0, 1, 0], set([0]))), " ", limage(lrtrim([0, 1, 0, 0], set([0]))));
   write(limage(lmap([1, 2, 3, 4], [4, 3, 2, 1], ["a", "b", "c", "d"])));
   write(limage(lmap([1, 5, 2], [1, 2], ["one", "two"])));
   write(limage(lpalin([1, 2, 3])), " ", limage(lpalin([1, 2, 3], 1)));
   every writes(limage(lpermute([1, 2, 3])), " ");
   write();
   every writes(limage(lreflect([1, 2, 3], 0 to 3)), " ");
   write();
   write(limage(lremvals([1, 2, 3, 2, 1], 2, 3)));
   write(limage(lrepl([1, 2], 3)));
   write(limage(lresidue([5, 6, 7, 8], 4)), " ", limage(lresidue([5, 6, 7, 8], 4, 1)));
   write(limage(lreverse(L)), " ", limage(L));
   write(limage(lrotate(L)), " ", limage(lrotate(L, -1)), " ", limage(lrotate(L, 2)));
   write(limage(lrunup([1, 10], [3, 12])), " ", limage(lrundown([5], [1], [2])));
   write(limage(lshift(L, 10)), " ", lst2str(["ab", 1, "c"]));
   write(limage(lswap([1, 2, 3, 4])), " ", limage(lunique([3, 1, 3, 2, 1])));
   write(lmaxlen(["a", "abc", "ab"]), " ", lminlen(["a", "abc", "ab"]), " ", lmaxlen([3, 9, 4], proc("-", 1)));
   t := table();
   t["b"] := 2;
   t["a"] := 1;
   t["c"] := 3;
   write(limage(sortkeys(sort(t, 3))), " ", limage(sortvalues(sort(t, 3))));
   write(limage(str2lst("abcdefg", 3)), " ", limage(str2lst("xyz")));
   write(limage(lblock([1, 2], [2, 3])));
   L := ["a", "b", "c", "b", "c"];
   every writes(l_Escan(l_Bscan(L), l_find(["b", "c"])), " ");
   write();
   write(l_Escan(l_Bscan(L), l_match(["a", "b"])) | "no match");
   write(l_Escan(l_Bscan(L), l_any([["x"], ["a"]])) | "no any");
   write(l_Escan(l_Bscan(["a", "a", "b"]), l_many([["a"]])) | "no many");
   every writes(l_Escan(l_Bscan(L), l_upto([["c"]])), " ");
   write();
   write(l_Escan(l_Bscan(L), (l_move(1), l_pos(2), limage(l_tab(0)))) | "scan fails");
   write(l_Escan(l_Bscan(L), (l_tab(3), limage(l_move(2)))) | "scan fails");
   every writes(l_Escan(l_Bscan(["(", "a", ")", "+", "b"]), l_bal([["+"]], [["("]], [[")"]])), " ");
   write()
end
