#  vrml1lib_driver.icn -- the grading vehicle for procs/vrml1lib.icn: the library declares only record types (one per VRML
#  node), so the driver constructs every record with positional values, prints its type, size, field names and
#  values, then reads and assigns a few fields by name.  Nothing is skipped.
link vrml1lib
procedure show(r)
   local i;
   writes(type(r),  "(", *r, ")");
   every i := 1 to *r do writes(" ", name(r[i]), "=", image(r[i]));
   write()
end
procedure main()
   local r;
   show(AsciiText(10, 20, 30, 40));
   show(Color(10));
   show(Comment(10));
   show(Cone(10, 20, 30));
   show(Coordinate3(10));
   show(Cube(10, 20, 30));
   show(Cylinder(10, 20, 30));
   show(DEF(10, 20));
   show(DirectionalLight(10, 20, 30, 40));
   show(FontStyle(10, 20, 30));
   show(Group(10));
   show(Info(10));
   show(Include(10));
   show(IndexedFaceSet(10, 20, 30, 40));
   show(IndexedLineSet(10, 20, 30, 40));
   show(LOD(10, 20));
   show(Material(10, 20, 30, 40, 50, 60));
   show(MaterialBinding(10));
   show(MatrixTransform(10));
   show(Normal(10));
   show(NormalBinding(10));
   show(OrthographicCamera(10, 20, 30, 40));
   show(PerspectiveCamera(10, 20, 30, 40, 50, 60));
   show(PointLight(10, 20, 30, 40));
   show(PointSet(10, 20));
   show(Rotation(10));
   show(Scale(10));
   show(Separator(10, 20));
   show(ShapeHints(10, 20, 30, 40));
   show(Sphere(10));
   show(SpotLight(10, 20, 30, 40, 50, 60, 70));
   show(Switch(10, 20));
   show(Texture2Transform(10, 20, 30, 40));
   show(TextureCoordinate2(10));
   show(Transform(10, 20, 30, 40, 50));
   show(TransformSeparator(10));
   show(Translation(10));
   show(USE(10));
   show(WWWAnchor(10, 20, 30));
   show(WWWInline(10, 20, 30));
   r := Cube(2, 3, 4);
   write("cube volume ", r.width * r.height * r.depth);
   r.depth := 10;
   show(r);
   r := Separator([Sphere(1), Cube()], "ON");
   write("separator children ", *r.list, " first ", type(r.list[1]), " radius ", r.list[1].radius);
   show(Material());
   r := DEF("thing", Sphere(2.5));
   write(r.name, " is a ", type(r.node), " of radius ", r.node.radius)
end
