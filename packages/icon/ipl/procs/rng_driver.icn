#  rng_driver.icn -- the grading vehicle for procs/rng.icn: it links rng and draws bounded prefixes of the
#  linear-congruence generator rng(a, c, m, x) -- the Icon defaults, a small hand-checkable modulus, and a
#  second seed.  Nothing is skipped: rng() is a pure arithmetic generator (no &random, no clock).
link rng
procedure main()
   local x;
   every write(rng() \ 6);
   write("--");
   every writes(rng(5, 3, 15, 1) \ 12, " ");
   write();
   every writes(rng(1, 1, 7, 0) \ 10, " ");
   write();
   every write(rng(, , , 12345) \ 4);
   x := 0;
   every x +:= rng(3, 1, 255, 7) \ 20;
   write("sum ", x)
end
