#!/bin/sh
# file -- a stand-in for file(1) in ftype_driver's run (Lon CEO-1474): the classic tab-separated "NAME:<TAB>TYPE" line ftype()
# parses, decided by the name and the file's kind only, so the answer is the same on every box.
for f in "$@"; do
  case "$f" in
    /dev/null) t="character special (1/3)" ;;
    *.icn) t="ASCII text, Icon source" ;;
    *.txt) t="ASCII text" ;;
    *) if [ -d "$f" ]; then t="directory"; elif [ -e "$f" ]; then t="data"; else t="cannot open (No such file or directory)"; fi ;;
  esac
  printf '%s:\t%s\n' "$f" "$t"
done
