procedure do_string()

local c,s

s:=""
while c:=reads()do{
case c of{
"\\":s||:=c||reads()
"\"":return s||c||reads()
default:s||:=c
}
}

stop("malformed string literal")

end


procedure do_charlit()

local c,s

s:=""
while c:=reads()do{
case c of{
"\\":s||:=c||reads()
"'":return s||c||reads()
default:s||:=c
}
}

stop("malformed character literal")

end


procedure do_c_comment()

local c,s

s:=c:=reads()|
stop("malformed C-style /* comment */")

repeat{
if c=="*"then{
s||:=(c:=reads()|break)
if c=="/"then
return s
}
else s||:=(c:=reads()|break)
}

return s

end


procedure do_icon_comment()

local c,s

s:=""
while c:=reads()do{
case c of{
"\\":s||:=c||(reads()|break)
"\n":return s
default:s||:=c
}
}

return s

end


procedure mapargs(s,l1,l2)

local i,s2
static cs,tbl,last_l1,last_l2

if/l1|*l1=0 then return s

if not(last_l1===l1,last_l2===l2)then{
cs:=''
every cs++:=(!l1)[1]
tbl:=table()
every i:=1 to*l1 do
insert(tbl,l1[i],(\l2)[i]|"")
}

s2:=""
s?{
while s2||:=tab(upto(cs))do{
(s2<-(s2||tbl[tab(longstr(l1))]),
not any(&letters++&digits++'_'))|
(s2||:=move(1))
}
s2||:=tab(0)
}

return s2

end


procedure main()
iiparse()
end
















































