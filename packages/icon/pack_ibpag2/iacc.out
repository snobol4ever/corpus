case c of{
"\"":s||:=c||do_string()
"'":s||:=c||do_charlit()
"$":{
c2:=reads()|break
if c2=="$"then{
until(c:=reads())=="="
s||:="return "
}else{
s||:=c
c:=c2
next
}
}
"#":{
if s[-1]=="\n"
then s[-1]:=""
do_icon_comment()
}
"/":{
c:=reads()|break
if c=="*"then
do_c_comment()
else{
s||:=c
next
}
}
"{":{
s||:=c
