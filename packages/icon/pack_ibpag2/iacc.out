procedure get_icon_code(endmark,comment)

local yaccwords,ibpagwords,count,c,c2,s

yaccwords:=["YYDEBUG","YYACCEPT","YYERROR","yyclearin","yyerrok"]
ibpagwords:=["IIDEBUG","IIACCEPT","IIERROR","iiclearin","iierrok"]

s:=""
