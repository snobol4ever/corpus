procedure iilex(infile)

local line
initial betavals:=["",0,0]

while line:=read(infile)do{
line?{
if="~"then{
suspend ord("~")
until pos(0)do{
case move(1)of{
"a":suspend ord("a")
"b":suspend ord("b")
"c":suspend ord("c")
"x":suspend ord("x")
"y":suspend ord("y")
default:stop("betacode error:  ",line)
}
