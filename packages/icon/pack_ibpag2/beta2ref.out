iilval:=tab(find("\""))
suspend STRVAL
move(1)
}else{
if iilval:=integer(tab(many(&digits)))
then suspend INTVAL
}
}
suspend ord("\n")
}
else{
iilval:=line
suspend LINE
suspend ord("\n")
}
}
}

end


