############################################################################
#
#	Name:	textedit.icn
#
#	Title:	Mouse-Oriented Text Edit Widget for X (Windows)
#
#	Author:	Robert J. Alexander
#
#	Date:	August 27, 1992
#
############################################################################
#
#  <<< Use control-? to get a "help" window. >>>
#
#
#  Features
#
#       - Lots of commands, currently invoked by control-keys (until menus
#         are implemented).  Use ^? in the editor to get a help screen,
#         or see the EditHelpText() procedure, below.
#
#       - Selections are started by clicking with the left mouse button.
#         They are extended by dragging with the left button, or by
#         clicking and/or dragging with center or right button.
#
#       - Double-click selects word; triple-click selects line.  Double-
#         click on a bracket-type character (one of '{}()[]<>', or single or
#         double quote) selects text between it and its mate.  Double-
#         click on a non-word, non-bracked character selects a
#         single character.
#
#       - Multiple level undo-redo.  The number of actions that can be
#         undone/redone is currently set arbitrarily to 300.  In this
#         version, each keystroke is individually undoable.  Only data-
#         modifying actions, currently, are undoable (i.e. cursor
#         movements are not undoable).
#
#       - A Find/Replace facility that supports regular expressions as
#         well as plain character strings.  To find a regular expression
#         bracket the Find string with /.../ to search forward, or \...\
#         to search backward.  The regular expressions are nearly
#         identical to egrep style -- see file regexp.icn for details.
#
#       - Editing code is written with reusability in mind, but is not
#         quite set up for it yet.  For example, currently window-relative
#         x and y coordinates cannot be specified.  But it's almost there.
#
#
#  Bugs to fix, features to add:
#
#       Better command-entry user interface (menus).
#       Auto-scroll while select-dragging.
#       Time-dependent double, triple click.
#       Implement more visible insertion point display (blinking?).
#       Use the fast scrollint capatility as used for the scroll bars
#		for other scrolling needs, too, like find, go to line, etc.
#       Change event handling so that there is a central event
#               dispatcher, not one in "control", maybe.  (This
#               really applies to "control.icn", not "edit").
#       Multiple edit windows.
#       Non-modal help window.
#       Dynamically updating, non-modal info window (maybe).
#       Case-independent find (feature implemented, but can't be toggled
#               during session because no more control keys).
#       Line wrap mode.
#       Key binding function.
#       Revise method of searching for matching brackets.
#       No notification is given if a save fails.
#	Consider revising undo for typed characters.  Currently there
#		is one undo event per character typed.
#
#
#  Procedures and Records in textedit.icn (alphabetically):
#
#    Edit()                     EditRedo()
#    EditAddUndo()              EditReplace()
#    EditCopy()                 EditReplaceCmd()
#    EditCreateMsgBox()         EditRunFilter()
#    EditCreateOneLineBuffer()  EditSave()
#    EditCursorDown()           EditSaveCmd()
#    EditCursorLeft()           EditSaveCopy()
#    EditCursorRight()          EditScreenLine()
#    EditCursorUp()             EditScrollToSelection()
#    EditCut()                  EditScrollToSelectionIfOffScreen()
#    EditDataKeyTyped()         EditScrolled()
#    EditDelete()               EditSelectAll()
#    EditDeleteCmd()            EditSelectLine()
#    EditEvent()                EditSelectWholeLines()
#    EditExpandText()           EditSelectWord()
#    EditFind()                 EditSelection.
#    EditFindCmd()              EditSelectionLines()
#    EditFlushEvents()          EditSelectionToFind()
#    EditGetOneKey()            EditSetScroll()
#    EditGetScreenOffset()      EditShiftLeft()
#    EditGetStringOffset()      EditShiftLines()
#    EditGoToLine()             EditShiftRight()
#    EditGoToLineCmd()          EditSortSelection()
#    EditHelpCmd()              EditTextAsNeeded()
#    EditHelpText()             EditTextFromFileCmd()
#    EditHighlightSelection()   EditToggleAutoIndent()
#    EditInfoCmd()              EditToggleBackward()
#    EditIsEmptySelection()     EditToggleImage()
#    EditKeyEvent()             EditToggleTrace()
#    EditMouseEvent()           EditToggleWrap()
#    EditPaintLines()           EditUndo()
#    EditPaste()                EditUndoRec.
#    EditPrintClip()            EditValidateSelection()
#    EditPrintSelection()       EditWaitForAnyEvent()
#    EditPrintUndo()            EditWriteMode()
#    EditQuit()                 EditWrites()
#    EditRec.                   wim()
#
############################################################################
#
#  Requires:  X-Icon
#
############################################################################
#
#  Links: control, varsub, regexp, shquote
#
############################################################################

procedure EditHelpText()
   #
   #  The commands.
   #
return (
        "\n Control Key Commands_
	 \n --------------------_
	 \n Q      quit_
	 \n W      write a copy..._
	 \n S      save_
	 \n C      copy_
	 \n X      cut_
	 \n V      paste_
	 \n Z      undo (up to 300 changes)_
	 \n Y      redo_
	 \n A      select all_
	 \n H      cursor left_
	 \n J      cursor down_
	 \n K      cursor up_
	 \n L      cursor right_
	 \n F      find..._
	 \n G      find again_
	 \n U      set \"find\" string from selection_
	 \n R      replace..._
	 \n T      replace again_
	 \n B      backward mode toggle for find/replace_
	 \n @      info..._
	 \n ?      help..._
	 \n_
         \n Escape Key Commands_
	 \n --------------------_
	 \n r      enter data from file..._
	 \n g      go to line..._
	 \n [      shift lines left 1 column_
	 \n ]      shift lines right 1 column_
	 \n u      \"show unprintables\" toggle_
	 \n a      auto indent toggle_
	 \n return execute selected text as shell command_
	 \n i      execute selected text as Icon code_
	 \n f      run program to filter selection_
	 \n w      wrap mode toggle for find/replace_
	 \n c      case independence toggle for find/replace_
	 \n t      &trace toggle_
	 \n");
	 #
	 #  Control keys still available to assign to new commands:
	 #
	 #  [
	 #
end


link control,varsub,regexp,shquote


record EditRec(w,text,scroller,selection,saveFileName,autoIndent,
      image,rows,columns,dialogFile,changed,undoList,redoList,undoStatus,
      backward,wrap,readOnly,ignoreCase,findString,replaceString,lastKey,
      lastData,oldTextLen,oldSel)
record EditSelection(r1,c1,r2,c2)
record EditUndoRec(proc,args,selection,oldSel)

global EditFunnyChars
global EditTextAsNeededLength,EditTextAsNeededLines
global scrollWidth


procedure Edit(text,geometry,font,wname,saveFileName,
      autoIndent,image,dialogFile,readOnly,lineNbr,ignoreCase)
   local columns,e,geo,height,position,rows,w,width,x;
   initial {
      EditFunnyChars := &cset[1:33] ++ &cset[128:0] -- "\t"
      };
   scrollWidth := 18;
   /geometry := "80x24";
   /font := "fixed";
   x := XBind("font=" || font);
   geometry ? {
      columns := tab(find("x")) & move(1) & rows := tab(upto('+-')\1 | 0);
      position := tab(0)
      };
   columns := integer(columns) | 80;
   rows := integer(rows) | 24;
   /wname := "";
   columns +:= 4; # Crude way to make room for the scroll bar
   geo := columns * XAttrib(x,"fwidth") || "x" || rows * XAttrib(x,"fheight") ||
	 position;
   e := EditRec();
   ## e.w := w := open(wname,"x","font=" || font,"lines=" || rows,
	 ## "columns=" || columns) |
   e.w := w := open(wname,"x","font=" || font,"geometry=" || geo, "cursor=on") |
	 stop("Can't create window with font ",image(font));
   width := XAttrib(w,"width");
   height := XAttrib(w,"height");
   e.text := text;
   e.scroller :=
	 NewScroller(w,width - scrollWidth,-1,scrollWidth,height + 1,
	 EditScrolled,e,1,1 <= *text | 1,1,rows - 2);
   DrawScroller(e.scroller);
   e.selection := EditSelection(1,1,1,1);
   e.saveFileName := saveFileName;
   e.autoIndent := autoIndent;
   e.image := image;
   e.rows := rows;
   e.columns := columns;
   e.dialogFile := dialogFile;
   e.undoList := [];
   e.redoList := [];
   e.wrap := 1;
   e.readOnly := readOnly;
   e.ignoreCase := ignoreCase;
   EditGoToLine(e,lineNbr);
   EditScrollToSelection(e);
   EditPaintLines(e);
   ## XAttrib(w,"pointer=xterm")
   DoEvents(w,EditEvent,e);
   close(w);
   return;
end


procedure EditEvent(w,evt,e,x,y)
   case type(evt) of {
      "integer": EditMouseEvent(w,evt,e,x,y);
      "string": EditKeyEvent(w,evt,e)
      };
   return;
end


procedure EditQuit(e)
   local dw;
   if \e.changed & /e.readOnly then {
      dw := EditCreateMsgBox(e.w,"Quit");
      write(dw,"Save before quitting (save, quit, cancel)?\n");
      case map((EditGetOneKey(dw))[1]) of {
	 "s" | "\r": {EditSave(e) ; exit()};
	 "q": exit()
	 };
      close(dw);
      EditFlushEvents(e.w)
      }
   else exit();
   return;
end


procedure EditSaveCmd(e)
   if \e.readOnly then
	 EditErrorMessage(e,"File is read-only, so can't be saved")
   else EditSave(e);
   return;
end


procedure EditCut(e)
   if EditCopy(e) then {
      EditNoteState(e);
      EditReplace(e);
      EditRefreshScreen(e)
      };
   return;
end


procedure EditNoteState(e)
   e.oldTextLen := *e.text;
   e.oldSel := copy(e.selection);
   return;
end


procedure EditRefreshScreen(e)
   if *e.text = e.oldTextLen then
	 EditPaintLines(e,EditScreenLine(e,e.oldSel.r1),
	 EditScreenLine(e,e.oldSel.r2 < e.selection.r2 | e.oldSel.r2))
   else EditPaintLines(e,EditScreenLine(e,e.oldSel.r1));
   return;
end


procedure EditPaste(e)
   local f,fn,t;
   EditNoteState(e);
   fn := "/tmp/XedClipboard";
   t := [];
   if f := open(fn) then {
      every put(t,!f);
      close(f)
      };
   EditReplace(e,t);
   EditRefreshScreen(e);
   return;
end


procedure EditUndo(e)
   local r,sel,sel2;
   e.undoStatus := "undoing";
   EditPrintUndo(e);
   if r := pop(e.undoList) then {
      sel := e.selection;
      sel2 := r.selection;
      sel.r1 := sel2.r1;
      sel.c1 := sel2.c1;
      sel.r2 := sel2.r2;
      sel.c2 := sel2.c2;
      r.proc!(\r.args | [e]);
      sel2 := r.oldSel;
      sel.r1 := sel2.r1;
      sel.c1 := sel2.c1;
      sel.r2 := sel2.r2;
      sel.c2 := sel2.c2
      }
   else writes("\^G");
   e.undoStatus := &null;
   EditScrollToSelectionIfOffScreen(e);
   EditPaintLines(e);
   return;
end


procedure EditRedo(e)
   local r,sel,sel2;
   e.undoStatus := "redoing";
   EditPrintUndo(e);
   if r := pop(e.redoList) then {
      sel := e.selection;
      sel2 := r.selection;
      sel.r1 := sel2.r1;
      sel.c1 := sel2.c1;
      sel.r2 := sel2.r2;
      sel.c2 := sel2.c2;
      r.proc!(\r.args | [e])
      }
   else writes("\^G");
   e.undoStatus := &null;
   EditScrollToSelectionIfOffScreen(e);
   EditPaintLines(e);
   return;
end


procedure EditSelectAll(e)
   local oldSel,sel;
   sel := e.selection;
   oldSel := copy(sel);
   sel.r1 := sel.c1 := sel.c2 := 1;
   sel.r2 := *e.text + 1;
   EditHighlightSelection(e,oldSel);
   return;
end


procedure EditToggleImage(e)
   e.image := (\e.image,&null) | 1;
   EditPaintLines(e);
   return;
end


procedure EditToggleAutoIndent(e)
   e.autoIndent := (\e.autoIndent,&null) | 1;
   return;
end


procedure EditRunFilter(e)
   local cmd,f,fn,oldSel,t;
   oldSel := copy(e.selection);
   EditSelectWholeLines(e);
   EditHighlightSelection(e,oldSel);
   if cmd := EditGetTextDialog(e,"Filter","Enter filter command:\n") then {
      fn := "/tmp/xed" || &clock;
      if f := open(fn,"w") then {
	 every write(f,EditSelectionLines(e,,1));
	 close(f);
	 f := open(cmd || " < " || fn,"pr");
	 t := [];
	 while put(t,read(f));
	 close(f);
	 put(t,"");
	 remove(fn);
	 EditNoteState(e);
	 EditReplace(e,t);
	 EditRefreshScreen(e)
	 }
      else EditErrorMessage(e,"Can't create work file \"",fn,"\"")
      };
   return;
end


procedure EditShellCommand(e)
   local cmd,f,t,s;
   if EditIsEmptySelection(e) then EditSelectWholeLines(e);
   cmd := "";
   t := [];
   every s := EditSelectionLines(e,,1) do {
      cmd ||:= s || "\n";
      put(t,s)
      };
   f := open("sh 2>&1 -c " || shquote(cmd),"rp");
   every put(t,!f);
   close(f);
   put(t,"");
   EditNoteState(e);
   EditReplace(e,t);
   EditScrollToSelectionIfOffScreen(e);
   EditRefreshScreen(e);
   return;
end


procedure EditGetTextDialog(e,title,s[])
   local cmd,dw;
   dw := EditCreateMsgBox(e.w,title);
   every writes(dw,!s);
   write(dw);
   cmd := read(dw) | fail;
   close(dw);
   return "" ~== cmd;
end


procedure EditErrorMessage(e,s[])
   local dw;
   dw := EditCreateMsgBox(e.w,"Oops!");
   every writes(dw,!s);
   write(dw);
   EditWaitForAnyEvent(dw);
   close(dw);
   return;
end


procedure EditShiftLeft(e)
   EditNoteState(e);
   EditShiftLines(e,1);
   EditRefreshScreen(e);
   return;
end


procedure EditShiftRight(e)
   EditNoteState(e);
   EditShiftLines(e,-1);
   EditRefreshScreen(e);
   return;
end


procedure EditCursorLeft(e)
   local oldSel,sel;
   sel := e.selection;
   oldSel := copy(sel);
   if (sel.c1 -:= 1) < 1 then {
      sel.c1 := if (sel.r1 -:= 1) < 1 then 1 else *e.text[sel.r1] + 1
      };
   sel.r2 := sel.r1 ; sel.c2 := sel.c1;
   EditValidateSelection(e);
   EditHighlightSelection(e,oldSel);
   return;
end

 
procedure EditCursorRight(e)
   local oldSel,sel;
   sel := e.selection;
   oldSel := copy(sel);
   if (sel.c2 +:= 1) > (*e.text[sel.r2] + 1 | 1)\1 then {
      sel.r2 +:= 1;
      sel.c2 := 1
      };
   sel.r1 := sel.r2 ; sel.c1 := sel.c2;
   EditValidateSelection(e);
   EditHighlightSelection(e,oldSel);
   return;
end

 
procedure EditCursorUp(e)
   local oldSel,sel;
   sel := e.selection;
   oldSel := copy(sel);
   if not (e.lastKey == ("\^J" | "\^K")) then e.lastData :=
	  EditGetScreenOffset(e,e.text[sel.r1],sel.c1);
   sel.r2 := sel.r1 -:= 1;
   sel.c1 := sel.c2 := EditGetStringOffset(e,e.text[sel.r1],e.lastData);
   EditValidateSelection(e);
   EditHighlightSelection(e,oldSel);
   return;
end

 
procedure EditCursorDown(e)
   local oldSel,sel;
   sel := e.selection;
   oldSel := copy(sel);
   if not (e.lastKey == ("\^J" | "\^K")) then e.lastData :=
	 EditGetScreenOffset(e,e.text[sel.r1],sel.c1);
   sel.r2 := sel.r1 +:= 1;
   sel.c1 := sel.c2 := EditGetStringOffset(e,e.text[sel.r1],e.lastData);
   EditValidateSelection(e);
   EditHighlightSelection(e,oldSel);
   return;
end


procedure EditFindCmd(e)
   e.findString := EditGetTextDialog(e,"Find",
	 "Find what string or /regular expression/?\n  (Default: ",
	 image(e.findString),")\n");
   EditFind(e,e.findString);
   return;
end


procedure EditFindAgainCmd(e)
   EditFind(e,e.findString);
   return;
end


procedure EditSelectionToFind(e)
   e.findString := EditSelectionLines(e);
   return;
end


procedure EditReplaceCmd(e)
   local dw;
   dw := EditCreateMsgBox(e.w,"Replace");
   write(dw,"Replace what string or /regular expression/?\n  (Default: ",
   image(e.findString),")\n");
   e.findString := "" ~== read(dw);
   write(dw,"\nwith what string (",image(e.replaceString),")?\n");
   e.replaceString := "" ~== read(dw);
   close(dw);
   EditFind(e,e.findString,e.replaceString);
   return;
end


procedure EditReplaceAgainCmd(e)
   EditFind(e,e.findString,e.replaceString);
   return;
end


procedure EditToggleBackward(e)
   return e.backward := (\e.backward,&null) | 1;
   return;
end


procedure EditToggleWrap(e)
   return e.wrap := (\e.wrap,&null) | 1;
end


procedure EditToggleCase(e)
   return e.ignoreCase := (\e.ignoreCase,&null) | 1;
end


procedure EditTextFromFileCmd(e)
   local f,fn,t;
   if fn := EditGetTextDialog(e,"Enter Text from File",
	 "Enter text from what file?\n") then {
      if f := open(fn) then {
	 t := [];
	 while put(t,read(f));
	 close(f);
	 EditNoteState(e);
	 EditReplace(e,t);
	 EditRefreshScreen(e)
	 }
      else EditErrorMessage(e,"Can't find file named \"",fn,"\"")
      };
   return;
end


procedure EditToggleTrace()
   return &trace := if &trace = 0 then -1 else 0;
end


procedure EditDeleteCmd(e)
   EditNoteState(e);
   EditDelete(e);
   EditRefreshScreen(e);
   return;
end


procedure EditGoToLineCmd(e)
   local line;
   if line := EditGetTextDialog(e,"Go To Line","Enter line number:\n") then {
      if line := integer(line) then {
	 EditGoToLine(e,line) | writes("\^G")
	 }
      };
   EditNoteState(e);
   if EditScrollToSelectionIfOffScreen(e) then
	 EditPaintLines(e)
   else
	 EditRefreshScreen(e);
   return;
end


procedure EditInfoCmd(e)
   local dw,sel,t;
   sel := e.selection;
   dw := EditCreateMsgBox(e.w,"Info",60,20);
   write(dw,"\n Mouse-Oriented Editor for X (Windows)");
   write(dw,"   written in X-Icon by Bob Alexander\n");
   write(dw," File: ",
	 "\"" || "" ~== \e.saveFileName || "\"" | "** none **","; ",
	 if \e.changed then "" else "no ","changes since save");
   write(dw," Lines: ",*e.text);
   t := 0;
   every t +:= *!e.text + 1;
   write(dw," Chars: ",t);
   t := 0 = *e.text | sel.r2 - sel.r1 + 1;
   writes(dw," The Selection: line ",sel.r1,", column ",sel.c1);
   if sel.r2 ~= sel.r1 then writes(dw," to line ",sel.r2,", column ",sel.c2)
   else if sel.c2 ~= sel.c1 then writes(dw," to column ",sel.c2);
   write(dw);
   write(dw," Lines selected: ",abs(sel.r2 - sel.r1) + 1);
   t := 0;
   every t +:= *EditSelectionLines(e) + 1;
   write(dw," Chars selected: ",t - 1);
   write(dw," Current size of Undo list: ",*e.undoList);
   write(dw);
   EditWriteMode(dw,e.wrap,"Wrap Mode for Find");
   EditWriteMode(dw,e.ignoreCase,"Case Independence Mode for Find");
   EditWriteMode(dw,e.backward,"Find Backward");
   EditWriteMode(dw,e.autoIndent,"Auto Indent");
   EditWriteMode(dw,e.image,"Show Unprintables");
   write(dw," Tab spacing: ",\Tabs - 1 | "off");
   EditWriteMode(dw,&trace ~= 0 | &null,"Trace");
   EditWaitForAnyEvent(dw);
   close(dw);
   return;
end


procedure EditHelpCmd(e)
   local dw;
   dw := EditCreateMsgBox(e.w,"Help",50,40);
   writes(dw,EditHelpText());
   EditWaitForAnyEvent(dw);
   close(dw);
   return;
end


procedure EditDataKeyTyped(e,evt)
   local oldSel,r,r1,r2,sel,t,text;
   sel := e.selection;
   text := e.text;
   if EditIsEmptySelection(e) & evt ~== "\r" then {
      #
      #  This is optimized code for inserting a character into
      #  an empty selection.
      #
      oldSel := copy(sel);
      r1 := r2 := sel.r1;
      if (r1 > *text,put(text,evt),r2 +:= 1) |
	    (text[r1][sel.c1+:0] := evt) then
	    sel.c2 := sel.c1 +:= 1;
      EditAddUndo(e,EditDelete,,sel,oldSel);
      EditScrollToSelectionIfOffScreen(e);
      EditPaintLines(e,EditScreenLine(e,r1),EditScreenLine(e,r2))
      }
   else {
      EditSortSelection(sel);
      r := sel.r1;
      #
      #  Generalized replacement of selection by typed character.
      #
      t := evt;
      EditNoteState(e);
      if evt == "\r" & \e.autoIndent then {
	 detab(text[r],Tabs) ? {
	    t ||:= entab(tab(many(' \t')),Tabs)
	    };
	 sel.c2 := many(' \t',text[sel.r2],sel.c2)
	 };
      EditReplace(e,t,sel);
      if EditScrollToSelectionIfOffScreen(e) then
	    EditPaintLines(e)
      else EditRefreshScreen(e)
      };
   return;
end


procedure EditKeyEvent(w,evt,e)
   initial {
      e.findString := e.replaceString := e.lastKey := ""
      };
   ## write("{{{{ event = ",image(evt)," x = ",&x," y = ",&y," t = ",&time)
   case evt of {
      "\^Q": EditQuit(e);                          # quit
      "\^W": EditSaveCopy(e);                      # write a copy
      "\^S": EditSaveCmd(e);                       # save
      "\^C": EditCopy(e);                          # copy
      "\^X": EditCut(e);                           # cut
      "\^V": EditPaste(e);                         # paste
      "\^Z": EditUndo(e);                          # undo
      "\^Y": EditRedo(e);                          # redo
      "\^A": EditSelectAll(e);                     # select all
      "\^H": EditCursorLeft(e);                    # cursor left
      "\^J": EditCursorDown(e);                    # cursor down
      "\^K": EditCursorUp(e);                      # cursor up
      "\^L": EditCursorRight(e);                   # cursor right
      "\^F": EditFindCmd(e);                       # find
      "\^G": EditFindAgainCmd(e);                  # find again
      "\^U": EditSelectionToFind(e);               # set find string to selection
      "\^R": EditReplaceCmd(e);                    # replace
      "\^T": EditReplaceAgainCmd(e);               # replace again
      "\^B": EditToggleBackward(e);                # backward mode toggle
      "\d":  EditDeleteCmd(e);                     # delete/backspace
      "\^@": EditInfoCmd(e);                       # info
      "\^?" | "\^/": EditHelpCmd(e);               # help
      "\e": {                                     # escape key sequence
	 evt := XEvent(w);
	 if type(evt) == "string" then case map(evt) of {
	    "u": EditToggleImage(e);               # "image" toggle
	    "a": EditToggleAutoIndent(e);          # autoindent toggle
	    "\r": EditShellCommand(e);             # do a shell command
	    "f": EditRunFilter(e);                 # run program (filter)
	    "i": EditExecuteIcon(e);               # run program (filter)
	    "w": EditToggleWrap(e);                # wrap mode toggle
	    "c": EditToggleCase(e);                # case independence toggle
	    "r": EditTextFromFileCmd(e);           # enter text from file
	    "g": EditGoToLineCmd(e);               # go to line
	    "[": EditShiftLeft(e);                 # shift 1 left
	    "]": EditShiftRight(e);                # shift 1 right
	    "t": EditToggleTrace()                # &trace
	    }
         };
      default: EditDataKeyTyped(e,evt)            # data key typed
      };
   e.lastKey := evt;
   return;
end


procedure EditGoToLine(e,line)
   local sel;
   sel := e.selection;
   if line <= 0 then line := *e.text + line + 1;
   if 1 <= line <= *e.text then {
      sel.r1 := sel.r2 := line;
      sel.c1 := sel.c2 := 1;
      return
      };
end


procedure EditScreenLine(e,line)
   return line - e.scroller.value + 1;
end


procedure EditScrollToSelectionIfOffScreen(e,linesAtBottom)
   /linesAtBottom := 0;
   return if not
	 (1 <= EditScreenLine(e,e.selection.r1) <= e.rows - linesAtBottom) then
	 EditScrollToSelection(e);
end


procedure EditWriteMode(w,mode,modeString)
   return write(w," ",modeString,": ",if \mode then "on" else "off");
end


procedure EditWaitForAnyEvent(w)
   local evt;
   #
   #  Actually, wait for mouse UP or any key.
   #
   repeat {
      if type(evt := XEvent(w)) == "integer" then {
	 if evt = (&lrelease|&mrelease|&rrelease) then break
	 }
      else break
      };
   return evt;
end


procedure EditGetOneKey(w)
   local evt;
   while type(evt := XEvent(w)) == "integer" do {
      };
   return evt;
end


procedure EditFlushEvents(w)
   while XPending(w)[1] do XEvent(w);
   return;
end


procedure EditSaveCopy(e)
   local fn;
   if fn := EditGetTextDialog(e,"Write a Copy",
	 "Write a copy to what file?\n") then return EditSave(e,fn);
end


procedure EditMouseEvent(w,evt,e,x,y)
   local oldSel,sel,text,time;
   static lastKey,lastMouseEvent,nextMouseTime,clickCount,
	 lastMouseX,lastMouseY;
   initial {
      lastKey := "";
      clickCount := nextMouseTime := lastMouseEvent := 0
      };
   ## write("{{{{ event = ",image(evt)," x = ",x," y = ",y," t = ",&time)
   sel := e.selection;
   text := e.text;
   if evt = (&lpress | &mpress | &rpress) then {
      #
      #  Process mouse button presses, checking for double and triple
      #  clicks.
      #
      time := &time;
      if lastMouseEvent = evt & # time < nextMouseTime &
	    lastMouseX - 4 < x < lastMouseX + 4 &
	    lastMouseY - 4 < y < lastMouseY + 4 then {
	 3 >= (clickCount +:= 1) | (clickCount := 1)
	 }
      else {
	 clickCount := 1;
	 lastMouseX := x;
	 lastMouseY := y
	 };
      nextMouseTime := time + 60;
      lastMouseEvent := evt
      };
   oldSel := copy(sel);
   case evt of {
      &lpress: {  # mouse left button pressed
	 sel.r1 := sel.r2 := &row + e.scroller.value - 1;
	 sel.c1 := sel.c2 := EditGetStringOffset(e,text[sel.r1],
	       &col);
	 EditValidateSelection(e);
	 EditHighlightSelection(e,oldSel)
	 };
      &rpress|&mpress|&lrelease|&mrelease|&rrelease: { # any other mouse event
	 sel.r2 := &row + e.scroller.value - 1;
	 sel.c2 := EditGetStringOffset(e,text[sel.r2], &col);
	 case clickCount of {
	    2: EditSelectWord(e);
	    3: EditSelectLine(e)
	    };
	 EditValidateSelection(e);
	 if not EditEqualSel(sel,oldSel) then
	       EditHighlightSelection(e,oldSel)
	 };
      &ldrag|&mdrag|&rdrag: {
	 if not XPending(w)[1] then EditMouseEvent(w,-4,e,x,y)
	 };
      &resize: EditResizeWindow(e)
      };
   return;
end


procedure EditResizeWindow(e)
   local height,oldScroller,w,width;
   w := e.w;
   width := XAttrib(w,"width");
   height := XAttrib(w,"height");
   e.columns := XAttrib(w,"columns");
   e.rows := XAttrib(w,"lines");
   oldScroller := RemoveScroller(e.scroller);
   e.scroller :=
	 NewScroller(w,width - scrollWidth,-1,scrollWidth,height + 1,
	 EditScrolled,e,oldScroller.value,1 <= *e.text | 1,1,e.rows - 2);
   XClearArea(w);
   DrawScroller(e.scroller);
   EditPaintLines(e);
   return e;
end


procedure EditEqualSel(sel1,sel2)
   return sel1.r1 = sel2.r1 &
	     sel1.c1 = sel2.c1 &
	     sel1.r2 = sel2.r2 &
	     sel1.c2 = sel2.c2;
end


procedure EditShiftLines(e,n)
   local h,i,line,oldSel,p,sel,text;
   sel := e.selection;
   oldSel := copy(sel);
   text := e.text;
   EditSelectWholeLines(e);
   EditAddUndo(e,EditReplace,sel,sel,oldSel);
   every i := sel.r1 to sel.r2 - 1do {
      line := text[i];
      if p := many(' \t',line) then h := detab(line[1:p],Tabs)
      else {p := 1 ; h := ""};
      if n > 0 then {
	 (h[-n:0] := "") | (h := "")
	 }
      else {
	 h ||:= repl(" ",-n)
	 };
      text[i] := entab(h,Tabs) || line[p:0]
      };
   return;
end


procedure EditSelectWholeLines(e,sel)
   /sel := e.selection;
   EditSortSelection(sel);
   if sel.c2 ~= 1 then sel.r2 +:= 1;
   sel.c1 := sel.c2 := 1; 
   return sel;
end


procedure EditCreateMsgBox(w,title,width,height)
   local dw,x,y;
   /title := "?";
   /width := 45;
   /height := 10;
   x := XAttrib(w,"posx") + &x - 92;
   y := XAttrib(w,"posy") + &y - 72;
   width *:= XAttrib(w,"fwidth");
   height *:= XAttrib(w,"fheight");
   dw := open(title,"x","geometry=" || width || "x" || height ||
	 "+" || x || "+" || y);
   return dw;
end

procedure EditFind(e,s,replace)
   local backward,c,findMap,findProc,matchProc,r,sel,sel2,text,lookHere;
   findMap := if \e.ignoreCase then map else 1;
   sel := e.selection;
   sel2 := EditSortSelection(copy(sel));
   text := e.text;
   backward := e.backward;
   findProc := find;
   matchProc := match;
   lookHere := \replace ~== s;
   if *s > 2 & s[1] == "/" & s[-1] == "/" then {
      s := s[2:-1];
      backward := &null;
      findProc := ReFind;
      matchProc := ReMatch;
      Re_Filter := findMap;
      findMap := 1
      };
   if *s > 2 & s[1] == "\\" & s[-1] == "\\" then {
      s := s[2:-1];
      backward := 1;
      findProc := ReFind;
      matchProc := ReMatch;
      Re_Filter := findMap;
      findMap := 1
      };
   s := findMap(s);
   if \backward then {
      #
      #  Search backward.
      #
      (\lookHere,
	    c := (matchProc(s,findMap(text[r := sel2.r1]),sel2.c1),sel2.c1)) |
	    every c := findProc(s,findMap(text[r := sel2.r1]),,sel2.c1);
      if \c |
	    (every r := (sel2.r1 - 1 to 1 by -1) |
	    (if \e.wrap then *text to sel2.r1 by -1) do
	    {every c := findProc(s,findMap(text[r])) ; if \c then break}) then {
	 sel.r1 := sel.r2 := r;
	 sel.c1 := c;
	 sel.c2 := matchProc(s,findMap(text[r]),c);
	 ## writes((/replace,"Found ") | "Replaced ",image(s)," at ")
	 ## EditPrintSelection(e)
	 if EditReplace(e,\replace) then {
	    ## writes("with ",image(replace)," -- new ")
	    ## EditPrintSelection(e)
	    };
	 EditScrollToSelectionIfOffScreen(e);
	 EditPaintLines(e)
	 }
      else {
	 ## write("\^GCan't find ",image(s))
	 writes("\^G")
	 }
      }
   else {
      #
      #  Search forward.
      #
      if (\lookHere,
	    c := (matchProc(s,findMap(text[r := sel2.r1]),sel2.c1),sel2.c1)) |
	    (c := findProc(s,findMap(text[r := sel2.r2]),sel2.c2)) |
	    (every r := (sel2.r2 + 1 to *text) |
	    (if \e.wrap then 1 to sel2.r2) do 
	    if c := findProc(s,findMap(text[r])) then break) then {
	 sel.r1 := sel.r2 := r;
	 sel.c1 := c;
	 sel.c2 := matchProc(s,findMap(text[r]),c);
	 ## writes((/replace,"Found ") | "Replaced ",image(s)," at ")
	 ## EditPrintSelection(e)
	 if EditReplace(e,\replace) then {
	    ## writes("with ",image(replace)," -- new ")
	    ## EditPrintSelection(e)
	    };
	 EditScrollToSelectionIfOffScreen(e,4);
	 EditPaintLines(e)
	 }
      else {
	 ## write("\^GCan't find ",image(s))
	 writes("\^G")
	 }
      };
   return;
end


procedure EditScrollToSelection(e)
   local r1,r2,rows,sel,selRows;
   sel := e.selection;
   rows := e.rows;
   r1 := sel.r1;
   r2 := sel.r2;
   if r2 > r1 then r1 :=: r2;
   selRows := r2 - r1 + 1;
   EditSetScroll(e,if selRows >= rows then r1 else r1 - (rows - selRows) / 2);
   return;
end


procedure EditSelectWord(e)
   local b,c,i,line,sel,text;
   static wordSet,bracketChars,startBrackets,endBrackets;
   initial {
      wordSet := &letters ++ &digits ++ "_";
      bracketChars := '()[]{}<>"\'';
      startBrackets := "([{<\"'";
      endBrackets   := ")]}>\"'"
      };
   sel := e.selection;
   if line := e.text[sel.r2] then {
      if EditIsEmptySelection(e) then {
	 if any(bracketChars,c := line[sel.c1]) then {
	    #
	    #  Double click on a bracket-type character selects chars
	    #  between the brackets.
	    #
	    text := e.text;
	    if find(c,startBrackets) then {
	       sel.c1 +:= 1;
	       b := map(c,startBrackets,endBrackets);
	       if i := bal(b,c,b,EditTextAsNeeded(e,line,sel.r1 + 1,*text),
		     sel.c1) then {
		  sel.r2 := sel.r1 + EditTextAsNeededLines;
		  sel.c2 := i - EditTextAsNeededLength
		  }
	       }
	    else {
	       b := map(c,endBrackets,startBrackets);
	       if i := bal(b,c,b,EditTextAsNeeded(e,line,sel.r1 - 1,1,-1,
		     reverse),*line - sel.c1 + 2) then {
		  sel.r2 := sel.r1 - EditTextAsNeededLines;
		  sel.c2 := *text[sel.r2] - (i - EditTextAsNeededLength) + 2
		  }
	       }
	    }
	 else {
	    #
	    #  Select a word -- current selection empty.
	    #
	    if sel.c2 := many(wordSet,line,sel.c1) then {
	       sel.c1 +:= 1;
	       while any(wordSet,line,0 < (sel.c1 -:= 1));
	       sel.c1 +:= 1
	       }
	    else {
	       sel.c2 +:= 1;
	       EditValidateSelection(e)
	       }
	    }
	 }
      #
      #  Handle extend-select.
      #
      else if sel.r1 < sel.r2 | (sel.r1 = sel.r2 & sel.c1 < sel.c2) then {
	 #
	 #  Extend forward.
	 #
	 sel.c2 := many(wordSet,line,sel.c2) | sel.c2
	 }
      else {
	 #
	 #  Extend backward.
	 #
	 while any(wordSet,line,0 < (sel.c2 -:= 1));
	 sel.c2 +:= 1
	 }
      };
   return;
end


procedure EditTextAsNeeded(e,line,rfrom,rto,rby,prc)
   /rby := 1;
   /prc := 1;
   EditTextAsNeededLength := 0;
   EditTextAsNeededLines := 0;
   suspend line := prc(line);
   EditTextAsNeededLength := *line;
   EditTextAsNeededLines := 1;
   suspend line ||:= prc(e.text[rfrom to rto by rby]) do {
      EditTextAsNeededLength := *line;
      EditTextAsNeededLines +:= 1
      };
end


procedure EditSelectLine(e)
   local line,sel;
   sel := e.selection;
   line := e.text[sel.r2];
   if EditIsEmptySelection(e) then {
      #
      #  Select whole line if current selection empty.
      #
      sel.c2 := sel.c1 := 1;
      sel.r2 +:= 1
      }
   else if sel.r1 < sel.r2 | (sel.r1 = sel.r2 & sel.c1 < sel.c2) then {
      #
      #  Extend forward.
      #
      sel.c2 := 1;
      sel.r2 +:= 1
      }
   else {
      #
      #  Extend backward.
      #
      sel.c2 := 1
      };
   EditValidateSelection(e);
   return;
end


procedure EditValidateSelection(e)
   local sel;
   sel := e.selection;
   (sel.r1 <:= 1) |
	 (if sel.r1 > *e.text then {
	    sel.r1 := *e.text + 1;
	    sel.c1 := 1
	    });
   (sel.r2 <:= 1) |
	 (if sel.r2 > *e.text then {
	    sel.r2 := *e.text + 1;
	    sel.c2 := 1
	    });
   (sel.c1 <:= 1) |
	 (sel.c1 >:= ((*e.text[sel.r1] + 1) | 1)\1);
   (sel.c2 <:= 1) |
	 (sel.c2 >:= ((*e.text[sel.r2] + 1) | 1)\1);
   return;
end


procedure EditSave(e,fn,sel)
   local bakfn;
   (/fn := e.saveFileName) | (fn := varsub(fn));
   if not (\fn ~== "") then return EditSaveCopy(e);
   bakfn := fn || ".bak";
   EditCopyFile(fn,bakfn) |
	 {EditErrorMessage("Unable to create backup file \"",bakfn,"\"") ; fail};
   return EditWriteToFile(e,fn,sel,"edit");
end


procedure EditWriteToFile(e,fn,sel,tag)
   local f;
   if f := open(fn,"w") then {
      if \sel then every write(f,EditSelectionLines(e,sel,1))
      else every write(f,!e.text);
      close(f);
      e.changed := &null;
      return
      }
   else EditErrorMessage("Unable to write to ",tag," file \"",fn,"\"");
end


procedure EditCopyFile(fn1,fn2)
   local f1,f2,buf;
   f1 := open(fn1,"r") | fail;
   f2 := open(fn2,"w") | fail;
   while buf := read(f1) do write(f2,buf);
   every close(f2 | f1);
   return fn2;
end


procedure EditSelectionLines(e,sel,x)
   local text;
   /sel := e.selection;
   sel := EditSortSelection(sel);
   text := e.text;
   if sel.r1 = sel.r2 then suspend text[sel.r1][sel.c1:sel.c2]
   else {
      suspend text[sel.r1][sel.c1:0];
      every suspend text[sel.r1 + 1 to sel.r2 - 1];
      if /x | sel.c2 ~= 1 then
	    suspend text[sel.r2][1:sel.c2]
      };
end


procedure EditCopy(e)
   local f,fn;
   if not EditIsEmptySelection(e) then {
      fn := "/tmp/XedClipboard";
      if f := open(fn,"w") then {
	 every write(f,EditSelectionLines(e));
	 close(f)
	 }
      else EditErrorMessage(e,"Can't open clipboard file \"",fn,"\"");
      return
      };
   # fail
end


procedure EditDelete(e)
   local sel,text;
   sel := e.selection;
   text := e.text;
   if EditIsEmptySelection(e) & (sel.c1 -:= 1) = 0 then {
      #
      #  Handle backspace over the beginning of a line.
      #
      if sel.r1 > 1 then {
	 sel.r1 -:= 1;
	 sel.c1 := *text[sel.r1] + 1
	 }
      else {
	 #
	 #  Here if no text left in buffer.
	 #
	 sel.c1 := 1;
	 if *text = 0 then return;          # buffer was already empty
	 if *text = 1 & text[1] == "" then {
	    get(text);
	    EditAddUndo(e,EditCreateOneLineBuffer);
	    return text
	    }
	 }
      };
   return EditReplace(e);
end


procedure EditCreateOneLineBuffer(e)
   put(e.text,"");
   EditAddUndo(e,EditDelete,,e.selection);
   return;
end


procedure EditPaintLines(e,fromLine,toLine)
   local col1,col2,cols,ender,fwidth,i,off,row1,row2,rows,screenLine,
         scroll,scroller,sel,str,t1,t2,text,w;
   #
   #  Set up convenient variables.
   #
   ## write("Painting lines ",\fromLine | "start"," to ",\toLine | "end")
   ## EditPrintSelection(e)
   sel := EditSortSelection(copy(e.selection));
   row1 := sel.r1;
   col1 := sel.c1;
   row2 := sel.r2;
   col2 := sel.c2;
   scroller := e.scroller;
   w := scroller.w;
   rows := e.rows;
   fwidth :=  XAttrib(w,"fwidth");
   cols := e.columns - (scroller.width + fwidth - 1) / fwidth;
   scroll := scroller.value;
   text := e.text;
   #
   #  Provide argument defaults.
   #
   if not (\fromLine >= 1) then fromLine := 1;
   if not (\toLine <= rows) then toLine := rows;
   #
   #  Paint lines backward so underlining doesn't get overwritten.
   #
   screenLine := toLine + 1;
   every i := scroll + toLine - 1 to scroll + fromLine - 1 by -1 do {
      XGotoRC(w,screenLine -:= 1,1);
      if 1 <= screenLine <= rows then {
	 if str := text[i] then {
	 ## if line := EditExpandText(e,str := text[i]) then {
	    if not (row1 <= i <= row2) then {
	       #
	       #  If line not selected
	       #
	       EditWrites(w,left(EditExpandText(e,str),cols))
	       }
	    else if i = row1 then {
	       if i = row2 then {
		  if col1 = col2 then {
		     #
		     #  If selection is insertion point in this line.
		     #
		     EditWrites(w,left(EditExpandText(e,str),cols))
		     }
		  else {
		     #
		     #  If selection starts and finishes in this line.
		     #
		     EditWrites(w,t1 := EditExpandText(e,str,col1,1));
		     XAttrib(w,"reverse=on");
		     EditWrites(w,
			   (t2 := EditExpandText(e,str,col2,2))[*t1 + 1:0]);
		     XAttrib(w,"reverse=off");
		     EditWrites(w,
			   left(EditExpandText(e,str,,3)[*t2 + 1:0],cols - *t2))
		     }
		  }
	       else {
		  #
		  #  If selection starts in this but finishes beyond.
		  #
		  EditWrites(w,t1 := EditExpandText(e,str,col1,1));
		  XAttrib(w,"reverse=on");
		  EditWrites(w,
			left(EditExpandText(e,str,,3)[*t1 + 1:0],cols - *t1));
		  XAttrib(w,"reverse=off")
		  }
	       }
	    else if row1 < i < row2 then {
	       #
	       #  If this line is all included in selection.
	       #
	       XAttrib(w,"reverse=on");
	       EditWrites(w,left(EditExpandText(e,str),cols));
	       XAttrib(w,"reverse=off")
	       }
	    else { # i = row2
	       #
	       #  Selection starts before but finishes in this line.
	       #
	       XAttrib(w,"reverse=on");
	       EditWrites(w,t1 := EditExpandText(e,str,col2,1));
	       XAttrib(w,"reverse=off");
	       EditWrites(w,
		     left(EditExpandText(e,str,,3)[*t1 + 1:0],cols - *t1))
	       }
	    }
	 else {
	    #
	    #  Write lines that follow the valid text.
	    #
	    if i = *text + 1 then writes(w,repl("\x10",cols))
	    else writes(w,\ender | (ender := repl(" ",cols)))
	    }
	 }
      };
   off := EditGetScreenOffset(e,text[row1],col1) | 1;
   XGotoRC(w,(e.columns < off,300000) | row1 - scroll + 1,off);
   return w;
end


procedure EditNonPos(i,len,def)
   /i := def;
   if i <= 0 then i +:= len + 1;
   if 1 <= i <= len + 1 then return i;
end


procedure EditExpandText(e,line,col,part)
   local p;
   col := EditNonPos(col,*line,0) | fail;
   /part := 0;
   p :=
	 if \e.image then EditExpandImageLine
	 else EditExpandNormalLine;
   return p(e,line,col,part);
end


procedure EditExpandImageLine(e,line,col,part)
   return (
	 image(line[1:col])[1:
	       if part = (0 | 3) then 0 else -1]);
   ## image(line)[2:-1] ? {
      ## line := ""
      ## while line ||:= tab(find("\\\"")) do move(1)
      ## line ||:= tab(0)
   ## }
   ## return line
end


procedure EditExpandNormalLine(e,line,col)
   static hiChars;
   initial hiChars := cset(&cset[129:0]);
   if upto(EditFunnyChars,line,,col + 2 | 0) then {
      line ? {
	 line := "";
	 while &pos < col do
	       line ||:=
	       if ="_\b" then char(ord(move(1)) + 128)
	       else if ="\r" then line := ""
	       else if tab(any(hiChars)) then ""
	       else move(1)
	 }
      }
   else line[col:0] := "";
   return detab(line,Tabs);
   ## ## col := find("_\b",line,1 <= col - 2 | 1,col + (2 | 1)) + 3
   ## line := line[1:col]
   ## if upto(EditFunnyChars,line) then {
      ## #
      ## #  Remove characters that are unprintable and change underlined
      ## #  characters by setting their high order bit.
      ## #
      ## line ? {
	 ## line := ""
	 ## while line ||:= tab(upto(EditFunnyChars)) do {
	    ## case move(1) of {
	       ## "\b": {
		  ## if line[-1] == "_" then line[-1] := char(ord(move(1)) + 128)
		  ## else line[-1] := ""
	       ## }
	       ## "\r": line := ""
	    ## }
	 ## }
	 ## line ||:= tab(0)
      ## }
   ## }
   ## return detab(line,Tabs)
end


procedure EditGetStringOffset(e,s,screenOffset)
   local i;
   screenOffset -:= 1;
   if *EditExpandText(e,s) <= screenOffset then {
      return *s + 1
      };
   i := 0;
   while *EditExpandText(e,s,i +:= 1,1) < screenOffset;
   return i;
end


procedure EditGetScreenOffset(e,s,stringOffset)
   return *EditExpandText(e,s,stringOffset | 0,1) + 1;
end


procedure EditWrites(w,s[])
   local t,p;
   static loChars,hiChars,hiCharSet;
   initial {
      loChars := string(&ascii);
      hiChars := &cset[129:0];
      hiCharSet := cset(hiChars)
      };
   every t := !s do t ? {
      while writes(w,tab(upto(hiCharSet))) do {
	 p := [XAttrib(w,"x"),XAttrib(w,"y") + 1];
	 writes(w,map(tab(many(hiCharSet)),hiChars,loChars));
	 p := p ||| [XAttrib(w,"x"),XAttrib(w,"y") + 1];
	 XDrawLine!([w] ||| p)
	 };
      writes(w,tab(0))
      };
   return;
end


procedure EditScrolled(scroller,evt,data,oldValue)
   return EditScroll(data,scroller.value,oldValue);
end


procedure EditScroll(e,newValue,oldValue)
   local dy,ady,w,fw,fh,wid,hi;
   if /oldValue then EditPaintLines(e);
   dy := newValue - oldValue;
   ady := abs(dy);
   w := e.w;
   fw := XAttrib(w,"fwidth");
   fh := XAttrib(w,"fheight");
   wid := (e.columns - (e.scroller.width + fw - 1) / fw) * fw;
   hi := (e.rows - ady) * fh;
   if dy < 0 then {
      XCopyArea(w,w,
	    0,0,
	    wid,hi,
	    0,fh * ady);
      EditPaintLines(e,1,ady)
      }
   else {
      XCopyArea(w,w,
	    0,ady * fh,
	    wid,hi,
	    0,0);
      EditPaintLines(e,e.rows - dy + 1,e.rows)
      };
   return;
end


procedure EditHighlightSelection(e,oldSel)
   local rows,sel;
   sel := e.selection;
   rows := sort([sel.r1,sel.r2,oldSel.r1,oldSel.r2]);
   if rows[3] <= rows[2] + 1 then
	 EditPaintLines(e,EditScreenLine(e,rows[1]),EditScreenLine(e,rows[4]))
   else {
      EditPaintLines(e,EditScreenLine(e,rows[3]),EditScreenLine(e,rows[4]));
      EditPaintLines(e,EditScreenLine(e,rows[1]),EditScreenLine(e,rows[2]))
      };
   return;
end


procedure EditPrintSelection(e,tag,sel)
   /sel := e.selection;
   return write(\tag || " -- " | "",
	 "Selection = {",sel.r1,",",sel.c1,",",sel.r2,",",sel.c2,"}");
end


procedure EditPrintClip()
   local f;
   write(">>> Clipboard:");
   if f := open("/tmp/XedClipboard") then {
      every write(image(!f));
      close(f)
      };
   return;
end


