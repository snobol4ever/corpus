procedure main()
   every 1 to 100 do {
      write(&collections)
      every 1 to 100 do
         list(1000)
      }
   write("collecting ...")
   collect()
   every s := repl("x",1 to 1000) do {
      cset(string(&lcase))
      t := table()
      set([s])
      s[2 : 5]
      }
end
