smatch(s1,s2)
char *s1, *s2;
{
\twhile (~((*s1 ^ *s2) & 0137))
\t\tif (~*s1)
!...!...!...return 0;
   \t\telse
!...!...!...s1++, s2++;
  \treturn ((*s1 & 0137) - (*s2 & 0137));
}

# now some backspaces
