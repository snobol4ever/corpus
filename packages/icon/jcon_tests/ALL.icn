procedure main()
	write(3^3^2);
	write(8/4/2);
	write(2-2-2);
	write(image(f![g]![2]));
	write((2<3>2)|"fail");
	every write(1 to 2 to 3);
	write("x" ? (tab(0)||"y") ? tab(0));
end

procedure f(x)
	return x;
end

procedure g(x)
	return x+2;
end
