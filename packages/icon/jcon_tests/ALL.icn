   write("getenv(NOPE!) = ", getenv("nope") | "[FAILED]");

#  test open(directory)

   f := open(".") | stop("can't open `.'");
   fset := set();
   # try three kinds of reading in rotation
   while insert(fset, read(f)) do {
      insert(fset, !f);			# note just one per loop pass
