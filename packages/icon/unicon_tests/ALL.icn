    ############################################################################
    ############################################################################
    #                                                                          #
    #                                                                          #
    #                                                                          #
    #                                                                          #
    #                                                                          #
    #                                                                          #
    #                                                                          #
    #                                                                          #
    #                                                                          #
    ############################################################################
    ############################################################################

    #MD:
    #: Integer() - this will return the integer value representation of the
    #: object value or will fail if no such representation exists
    #:
    method Integer()
        return ClassObject::ClassClass.Integer(self);
