procedure monitor(line)
   write("\nerror in line ",line,":")
   write("   &error = ",&error)
   write("   &errornumber = ",&errornumber)
   write("   &errortext = ",
      image(&errortext))
   write("   &errorvalue = ", image(&errorvalue))
   return line
end
