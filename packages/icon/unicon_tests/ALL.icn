   write("real(\"2 \") ----> ",Image(real("2 ")) | "none")
   write("real(\"+2\") ----> ",Image(real("+2")) | "none")
   write("real(\"-2\") ----> ",Image(real("-2")) | "none")
   write("real(\"- 2\") ----> ",Image(real("- 2")) | "none")
   write("real(\" -    2 \") ----> ",Image(real(" -    2 ")) | "none")
   write("real(\"\") ----> ",Image(real("")) | "none")
   write("real(\"--2\") ----> ",Image(real("--2")) | "none")
   write("real(\" \") ----> ",Image(real(" ")) | "none")
   write("real(\"-\") ----> ",Image(real("-")) | "none")
