   write("r.a ----> ",image(r.a) | "none")
   write("r.b ----> ",image(r.b) | "none")
   write("r.c ----> ",image(r.c) | "none")
   write("r.d ----> ",image(r.d) | "none")
   write("r.e ----> ",image(r.e) | "none")
end

procedure p12()
   write("r.f ----> ",image(r.f) | "none")
   write("type(r) ----> ",image(type(r)) | "none")
