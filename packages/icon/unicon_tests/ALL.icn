    DisplayLine("gus1.LexLT(gs1)", (gus1.LexLT(gs1) & "Succeeded") | "Failed")
    DisplayLine("gus1.LexLT(gs2)", (gus1.LexLT(gs2) & "Succeeded") | "Failed")
    DisplayLine("gus1.LexLT(gus2)", (gus1.LexLT(gus2) & "Succeeded") | "Failed")
    Footer()
end

