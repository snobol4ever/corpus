    DisplayLine("gs1", gs1);
    DisplayLine("gs2", gs2);
    DisplayLine("UTF8.Concatenate(gs1, gs2).String()", UTF8.Concatenate(gs1, gs2).String());
    DisplayLine("UTF8.New(gs1 || gs2).String()", UTF8.New(gs1 || gs2).String());
    Footer();
end

