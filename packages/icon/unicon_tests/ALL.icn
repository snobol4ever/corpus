    #:
    method Greater(val)
        /val & AbortMessage(102, keyword("&file", , 1), keyword("&line", , 1),
                            __AuxMessage(102));

        return ClassObject::ClassClass.Greater(self, val);
    end

    #MD:
    #: LTorEqual(val) - this will convert the supplied parameter to numeric
