procedure MiscellaneousTest()
    Header();
    DisplayLine("\n'abcdefg' -- 'fghijk'", 'abcdefg' -- 'fghijk');
    DisplayLine("\n'abcdefg' -- (&cset -- 'fghijk')", 'abcdefg' -- (&cset -- 'fghijk'));
    Footer();
