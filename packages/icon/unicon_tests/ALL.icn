procedure FunctionMoveTest()
    local us4
    write("\n\nTest Move(i)")
    Header()
    us4 := UTF8.New("ббб" || gs1 || "ббб")
    DisplayLine("us4.String()", us4.String())
    DisplayLine("us4.String() ? {", )
