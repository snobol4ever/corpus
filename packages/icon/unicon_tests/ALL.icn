#------------------------------------------------------------- 78 pattern/parbno
# parbno.icn
# Tests: Pos(), Arbno(), Rpos(), ??, ||,
#        =>, Span(), included pattern in pattern

procedure main()
   out := &output;
   item := Span(&digits) => out;
   Lpat := Pos(1) || "(" || item || Arbno("," || item) || ")" || Rpos(0);
   while line := read() do {
      if line ?? Lpat then
         write("Match succeeded: ", line)
      else
