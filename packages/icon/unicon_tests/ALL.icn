    Header()
    UTF8()
    DisplayLine("UTF8()", image(UTF8))
    UTF8Set()
    DisplayLine("UTF8Set()", image(UTF8Set))
    Footer()
end

procedure InitialiseUTF8Objects()
    write("\n\nCreate the five UTF-8 objects")
    write("Create gus1 based on string gs1:", gs1, "\nximage(gs1):", ximage(gs1))
