   write("a4 := a[2:2] ----> ",image(a4 := a[2:2]) | "none")
   write("every write(!a4) ----> ",image(every write(!a4)) | "none")
end

procedure p11()
   write("a5 := a[0-:2] ----> ",image(a5 := a[0-:2]) | "none")
   write("every write(!a5) ----> ",image(every write(!a5)) | "none")
   write("[] ||| [] ----> ",image([] ||| []) | "none")
   write("[1,2,3] ||| [] ----> ",image([1,2,3] ||| []) | "none")
   write("[] ||| [1,2,3] ----> ",image([] ||| [1,2,3]) | "none")
