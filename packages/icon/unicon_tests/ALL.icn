        /local_val1 & AbortMessage(102, keyword("&file", , 1), keyword("&line", , 1),
                                   __AuxMessage(102, 2), image(val1));

        /local_val2 & AbortMessage(102, keyword("&file", , 1), keyword("&line", , 1),
