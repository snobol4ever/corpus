procedure InitialiseGlobals()
    gs1 := "abcde"
    gs2 := "Необычная активность"
    gs3 := "극지탐험　협회결성　체계적　연구"
    gs4 := "\xef\xbb\xbf"

    gs10 := "abc\tde"
    gs11 := "Нео\tбычн\tая"
end

procedure InitialiseUTF8Classes()
