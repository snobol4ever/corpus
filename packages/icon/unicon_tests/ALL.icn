      };
end
#--------------------------------------------------------- 86 pattern/ralternate
## ralternate.icn
## Paden Rumsey
## July 10, 2016

## Tests grouping/images of alternation with and without parenthesis in
## regular expressions.

procedure main()
    while s := read() do {
        write("Alternation");
        regx := <"Unicon" | "Icon">;
        write(image(regx));
        match_string(s, regx);

        write("Group Alternation");
        regx := <("Unicon" | "Icon")>;
        write(image(regx));
        match_string(s, regx);

        write("Multi Group Alternation");
        regx := <("Unicon" | "Icont" | "Icon")>;
        write(image(regx));
        match_string(s, regx);

        write("Multi Group Alternation with Concatenation");
        regx := <(("Uni" "con") | ("Icon" "t") | ("I" "con"))>;
        write(image(regx));
        match_string(s, regx);

        write("Multi Group Alternation with Concatenation minus Parens");
        regx := <("Uni" "con" | "Icon" "t" | "Ic" "on")>;
        write(image(regx));
        match_string(s, regx)
    };
end

procedure match_string(s, r)
    r := r -> out || Rem() -> remain;
    write("The string is: ", s);
    if s ?? r then {
        write("The matched string is ", out, " the remainder is ", remain)
        }
    else
        write("The regex failed to match");
    write("\n");
end
#---------------------------------------------------------- 87 pattern/rasterisk
## rasterisk.icn
## Paden Rumsey
## July 10, 2016

#
# These tests are implemented with combinations of asterisk in place. It's
# tested on strings and on asterisks combined within asterisks.
#


procedure main()
    while s := read() do {
        write("Asterisk Concatenation with csets");
        regx :=  <'a'* 'b'* 'c'* > || 'd';
        write(image(regx));
        match_string(s, regx);

        write("Asterisk Concatenation with csets with Any('a')");
        regx :=  Any('a') || <'a'* 'b'* 'c'* > || 'd';
        write(image(regx));
        match_string(s, regx);

        write("Asterisk Concatenation with strings");
        regx := <"aa"* "bb"* "cc"*> || 'd';
        write(image(regx));
        match_string(s, regx);

        write("Nested Asterisks");
        regx := <("abc" | ('a' 'b'* 'c') | ('a' 'b') 'c'*)*> || 'd';
        write(image(regx));
        match_string(s, regx)
    };
end

procedure match_string(s, r)
    r := r -> out || Rem() -> remain;
    write("The string is: ", s);
    if s ?? r then {
        write("The matched string is ", image(out), " the remainder is ", image(remain))
        }
    else
        write("The regex failed to match");
    write("\n");
end
#------------------------------------------------------------- 88 pattern/rbasic
### rbasic.icn
### Paden Rumsey
### July 15, 2016

### a test designed to test basic concatenation of csets and strings
### in a regular expression environment. Also performs basic matching

procedure main()
    while input := read() do {

        write("Basic match");
        regx := <'f'> || "at";
        write(image(regx));
        match_string(input, regx);

        write("Basic character alternation/concatenation");
        regx := <([f]|[c])"at">;
        write(image(regx));
        match_string(input, regx);

        write("Basic character alternation/concatenation minus Parens");
        regx := <[f]|[c]"at">;
        write(image(regx));
        match_string(input, regx);

        regx := <(([f]|[c]) ("atter"|"at"))>;
        write("Basic string alternation/concatenation");
        write(image(regx));
        match_string(input, regx)
    };
end

procedure match_string(s, r)
    r := r -> out || Rem() -> remain;
    write("The string is: ", s);
    if s ?? r then {
        write("The matched string is ", out, " the remainder is ", remain)
        }
    else
        write("The regex failed to match");
    write("\n");
end
#------------------------------------------------------------- 89 pattern/rcurly
## rcurly.icn
## Paden Rumsey
## July 31, 2016

## Tests the curly brace notation in regular expressions. Mixes some complex
## patterns and csets to set parenthetical grouping. Images included.
##

procedure main()
    while s := read() do {
        write("Curly Brace Alternation with Strings");
        regx := <"l"{2} | "s"{2}>;
        write(image(regx));
        match_string(s, regx);


        write("Curly Braces with Csets");
        regx := <[l]{2} | [s]{2}>;
        write(image(regx));
        match_string(s, regx);

        write(" Curly Brace Alternation with Parenthesis");
        regx := <([l]){2} | ([s]{2})>;
        write(image(regx));
        match_string(s, regx);

        write("Curly Brace Concatenation");
        regx := <[i] [l]{2}>;
        write(image(regx));
        match_string(s, regx);

        write("Curly Braces Used on Semi-Complex Pattern");
        regx := <[w]."l"{2}>;
        write(image(regx));
        match_string(s, regx);

        write("Curly Braces Used on Semi-Complex Pattern with Parens");
        regx := <([w]."l"){2}>;
        write(image(regx));
        match_string(s, regx)

    };

end

procedure match_string(s, r)
    r := r -> out || Rem() -> remain;
    write("The string is: ", s);
    if s ?? r then {
        write("The matched string is ", out, " the remainder is ", remain)
        }
    else
        write("The regex failed to match");
    write("\n");
end
#-------------------------------------------------------------- 90 pattern/rplus
## rplus.icn
## Paden Rumsey
## July 30, 2016

## Tests the one or more operator "+" on a variety of groupings and operators
## within the regular expression environment. Images included.

procedure main()
    while s := read() do {

        write("Plus Operator Alternation with Strings");
        regx := <"a"+ | "b"+> || 'd';
        write(image(regx));
        match_string(s, regx);

        write("Plus Operator Alternation on Csets");
        regx := <[a]+ | [b]+> || 'd';
        write(image(regx));
        match_string(s, regx);

        write("Plus Operator Concatenation");
        regx := <[a]+ [b]+> || 'd';
        write(image(regx));
        match_string(s, regx);

        write("Plus Operator Used on Semi-Complex Pattern");
        regx := <[a].[b]+> || 'd';
        write(image(regx));
        match_string(s, regx);

        write("Plus Operator Used on Semi-Complex Pattern with Parens");
        regx := <([a].[b])+> || 'd';
        write(image(regx));
        match_string(s, regx);

        write("Plus Operator Used With Curly Braces");
        regx := <[a]{2}+> || 'c';
        write(image(regx));
        match_string(s, regx)
    };

end

procedure match_string(s, r)
    r := r -> out || Rem() -> remain;
    write("The string is: ", s);
    if s ?? r then {
        write("The matched string is ", out, " the remainder is ", remain)
        }
    else
        write("The regex failed to match");
    write("\n");
end
#---------------------------------------------------------- 91 pattern/rquestion
## rquestion.icn
## Paden Rumsey
## July 30, 2016

## Unfortunately the semanatics of question mark in regexes is somewhat limited.
## Either the string you request to match must be at the beginning of the
## string you are matching or it matches nothing. That being said this
## tests the beginning string quite well. Images included


procedure main()
    while s := read() do {
        write("Question Mark Alternation with Strings");
        regx := <"all"? | "none"?>;
        write(image(regx));
        match_string(s, regx);

        write("Question Mark Alternation with Csets");
        regx := <[a]? | [b]?>;
        write(image(regx));
        match_string(s, regx);

        write("Question Mark Alternation with Parenthesis");
        regx := <("all")? | ("none")?>;
        write(image(regx));
        match_string(s, regx);

        write("Question Mark Concatenation");
        regx := <"a"? "ll"?>;
        write(image(regx));
        match_string(s, regx);

        write("Question Mark Used on Semi-Complex Pattern");
        regx := <[s]."lly"?>;
        write(image(regx));
        match_string(s, regx);

        write("Question Mark Used on Semi-Complex Pattern with Parens");
        regx := <([s]."lly")?>;
        write(image(regx));
        match_string(s, regx);

        write("Question Mark Used With Curly Braces");
        regx := <'a' ('l'{2}?)>;
        write(image(regx));
        match_string(s, regx)
    };

end

procedure match_string(s, r)
    r := r -> out || Rem() -> remain;
    write("The string is: ", s);
    if s ?? r then {
        write("The matched string is ", out, " the remainder is ", remain)
        }
    else
        write("The regex failed to match");
    write("\n");
end
#--------------------------------------------------------------- 92 pattern/rtab
### Paden Rumsey
### rtab.icn
### test Rtab() on a variety of inputs

## Tests Rtab by increasing the size of the tab from the right. This results
## in a decreasing string that is matched by Rtab() and a greater remaining

procedure main()

    while input := read() do {
      inputSize := *input;
      while inputSize >= 0 do {
          tabsize := (*input - inputSize );
          pat := Rtab(tabsize) -> out || Rem() -> remain;
          input ?? pat;
          write_output(out, remain);
          inputSize -:= 1
          }
      };
end

procedure write_output(out, remainder)
    write("The match by Rtab is: " || out || " and remainder is: " || remainder);
end
#-------------------------------------------------------------- 93 pattern/sawss
# sawss.icn
# Tests: Succeed(), ||, Len(), Arb(), =>, Fail(),
#        `proc`, ??
# Note: the Succeed()...Fail() pair creates an endless loop.

procedure main()

   out := &output;

   sawtooth := Succeed() || ( Len(1) || Arb() ) => out ||
      `curtail()` || Fail();
   (s := read()) ?? sawtooth;
end

procedure curtail()
   static n;
   initial n := 0;
   if (n  +:= 1) > 19 then exit(0)
   else return "";
end
