# ptab.icn
# Tests:  Len(), Rem(), Rtab(), Tab(), 
#   =p, ->, ||, ??

procedure main()
   out := &output;
   p := Tab(3) || Len(4) -> out || Rtab(2) -> y;

   while s := read() do {
      write(out, "line: ", s);
      s ?? "abc" -> out;
      s ?? "def" || Rem() -> out;
      s ?? Len(2) || Rem() -> out;
      s ?? Tab(3) -> out || Rtab(1) -> out;
