        DisplayLine("    l", l);
        DisplayLine("    UTF8.AmpPos()", UTF8.AmpPos());
        DisplayLine("    UTF8.Move(l).String()", UTF8.Move(l).String() | "fail");
        DisplayLine("    UTF8.AmpPos()", UTF8.AmpPos());
        DisplayLine("    UTF8.Move(-6).String()", UTF8.Move(-6).String() | "fail");
        DisplayLine("    UTF8.AmpPos()", UTF8.AmpPos());
