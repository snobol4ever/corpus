#----------------------------------------------------------------- 127 posix/udp
$include "posix.icn"

procedure main()
   port:="127.0.0.1:1072"
   if fork() = 0 then {
      f := open(port, "nua")

      if r := receive(f) then {
          # Process the request in r.msg - in the case of the time
          # service, we don't care what is actually in the message
         send(r.addr, "hello, world!")
      }
      exit(0)
   }

   f := &null
   every !10 do {
      delay(100)
      if f := open(port, "nu") then break
   }
   if /f then
      stop("Open failed: ", &errortext | "Unknown")

   write(f, "")
   if *select(f, 5000) = 0 then
      stop("Connection timed out: ", &errortext | "Unknown")

   r := receive(f) | stop("Receive failed: ", &errortext | "Unknown")

   write("Received ", r.msg)

end
#--------------------------------------------------------------- 128 posix/umask
# umask.icn - set and get the umask.

procedure main()
   local u
   write("setting the mask to rwxr-xr-x.")
   umask("rwxr-xr-x") | write("set umask fails")
   # read and check the newly-set umask (Windows CRT may report "rwxrwxrwx" after set)
   u := umask()
   write(image(u), "; ", if (u === "rwxr-xr-x") | (u === "rwxrwxrwx") then "OK" else "FAIL")
end
#------------------------------------------------------------ 129 posix/uxsocket
$include "posix.icn"
link io

procedure main()
   sock := tempname("unicon-uxsocket-", "")

   if fork() ~= 0 then {
      # parent
      client := &null
      every !10 do {
         delay(100)
         if client := open(sock, "n") then break
      }
      if /client then
         stop("Client couldn't connect " || sock || ":\n",  &errortext | "Unknown")

      write(client, "hello, world!")
      write(read(client))

      delay(500)
      close(client)
      exit(0)
   }

   # child
   if server := open(sock, "na") then {
      if fork() = 0 then {
         handle(server)
         close(server)
         exit(0)
      }
      close(server)
      system("rm -f " || sock)
   }
   (&errno = 0) | stop("Server couldn't accept " || sock || ":\n", &errortext | "Unknown")
end
   
procedure handle(f)
   while line := read(f) do
      write(f, reverse(line))
end
#---------------------------------------------------------------- 130 posix/wait

$include "posix.icn"

procedure main()

   # Child exits with code 3; parent reaps and prints wait status string.
   if (child1 := fork()) = 0 then {
      delay(1000)
      exit(3)
   }

   st := wait(child1) | write(&errout, "Wait 1 failed: ", sys_errstr(&errno))
   write(trim(st))

   # Child would exit(5) after a long delay; SIGTERM stops it first (see kill comment).
   if (child2 := fork()) = 0 then {
      delay(10000)
      exit(5)
   }

   # If SIGQUIT is ignored, the child can run exit(5) after delay; expect
   # terminated:SIGTERM in stand/wait.std instead of terminated:SIGQUIT.
   kill(child2, "SIGTERM")
   st := wait() | write(&errout, "Wait 2 failed: ", sys_errstr(&errno))
   # some of these will end in :core and some won't
   if st[-5:0] == ":core" then st[-5:0] := ""
   write(trim(st))

   # Stopped with SIGSTOP, waited with WUNTRACED ("u"), then CONT + TERM to finish.
   if (child3 := fork()) = 0 then {
      delay(10000)
      exit(0)
   }

   kill(child3, "SIGSTOP")
   st := wait(child3, "u") |
      write(&errout, "Wait 3 failed: ", sys_errstr(&errno))
   write(trim(st))
   
   
   kill(child3, "SIGCONT")
   kill(child3, "SIGTERM")


   delay(1000)
   system("rm -f core")
end

# Drop optional ":core" suffix so golden output matches hosts that differ on cores.
procedure trim(st)
   st ? {
      pid := (integer(tab(many(&digits))) | &null)
      writes(type(pid), " ")
      move(1)
      write(tab(0))
   }
end
#------------------------------------------------------------ 131 samples/btrees
#
#          B I N A R Y   T R E E S
#

#  This program accepts string representations of binary trees from
#  standard input.  It performs a tree walk and lists the leaves of
#  each tree.

record node(data,ltree,rtree)

procedure main()
   local line, tree
   while line := read() do $(
      tree := tform(line)
      write("tree walk")
      every write(walk(tree))
      write("leaves")
      every write(leaves(tree))
      $)
end

procedure tform(s)
   local value,left,right
   if /s then return
   s ? if value := tab(upto('(')) then $(
      move(1)
      left := tab(bal(','))
      move(1)
      right := tab(bal(')'))
      return node(value,tform(left),tform(right))
      $)
      else return node(s)
end

procedure walk(t)
   suspend walk(\t.ltree | \t.rtree)
   return t.data
end

procedure leaves(t)
   if not(\t.ltree | \t.rtree) then return t.data
   suspend leaves(\t.ltree | \t.rtree)
end
#---------------------------------------------------------- 132 samples/diffwrds
#
#          D I F F E R E N T   W O R D S
#

#  This program lists all the different words in the input text.
#  The definition of a "word" is naive.

procedure main()
   words := set()
   while text := read() do
      text ? while tab(upto(&letters)) do
         insert(words,tab(many(&letters)))
   every write(!sort(words))
end
#------------------------------------------------------------- 133 samples/kross
#
#          W O R D   I N T E R S E C T I O N S
#

#  This program procedure accepts string pairs from standard input, with
#  the strings separated by semicolons.  It then diagrams all the
#  intersections of the two strings in a common character.

procedure main()
   local line, j
   while line := read() do $(
      write()
      j := upto(':',line)
      cross(line$<1:j$>,line$<j+1:0$>)
      $)
end

procedure cross(s1,s2)
   local j, k
   every j := upto(s2,s1) do
      every k := upto(s1$<j$>,s2) do
         xprint(s1,s2,j,k)
end

procedure xprint(s1,s2,j,k)
   write()
   every write(right(s2$<1 to k-1$>,j))
   write(s1)
   every write(right(s2$<k+1 to *s2$>,j))
end
#----------------------------------------------------------- 134 samples/meander
#
#          M E A N D E R I N G   S T R I N G S
#

#  This main procedure accepts specifications for meandering strings
#  from standard input with the alphabet separated from the length by
#  a colon.

procedure main()
   local line, alpha, n
   while line := read() do $(
      line ? if $(
         alpha := tab(upto(':')) &
         move(1) &
         n := integer(tab(0))
         $)
         then write(meander(alpha,n)) 
         else stop("*** erroneous input ***")
      $)
end

procedure meander(alpha,n)
   local result, t, i, c, k
   i := k := *alpha
   t := n-1
   result := repl(alpha$<1$>,t)
   while c := alpha$<i$> do $(
      if find(result$<-t:0$> || c,result)
      then i -:= 1
      else $(result ||:= c; i := k$)
      $)
   return result
end
#------------------------------------------------------------ 135 samples/prefix
#
#          I N F I X - T O - P R E F I X   C O N V E R S I O N
#

#  This program accepts infix expressions from standard input and
#  writes the corresponding prefix expressions to standard output.

procedure main()
   while write(prefix(read()))
end

procedure prefix(s)
   s := strip(s)
   return lassoc(s,'+-' | '*/') | rassoc(s,'^') | s
end

procedure strip(s)
   while s ? (="(" & s <- tab(bal(')')) & pos(-1))
   return s
end

procedure lassoc(s,c)
   local j
   s ? every j := bal(c)
   return form(s,\j)
end

procedure rassoc(s,c)
   local j
   return form(s,s ? bal(c))
end

procedure form(s,k)
   local a1, a2, op
   s ? $(
      a1 := tab(k)
      op := move(1)
      a2 := tab(0)
      $)
   return op || "(" || prefix(a1) || "," || prefix(a2) || ")"
end
#------------------------------------------------------------ 136 samples/recogn
#
#          C F L   R E C O G N I T I O N
#

#  This program takes strings from standard input and determines
#  whether or not they are sentences in the language defined by <s>.

procedure main()
   local line
   while line := read() do
      if recogn(s,line) then write("accepted") else write("rejected")
end

procedure recogn(goal,text)
   return text ? (goal() & pos(0))
end

#  <s> ::= a <s> | <t> b | c

procedure s()
   suspend (="a" || s()) | (t() || ="b") | ="c"
end

#  <t> ::= d <s> d | e | f

procedure t()
   suspend (="d" || s() || ="d") | ="e" | ="f"
end
#------------------------------------------------------------- 137 samples/roman
#
#          R O M A N   N U M E R A L S
#

#  This program takes Arabic numerals from standard input and writes
#  the corresponding Roman numerals to standard outout.

procedure main()
   local n
   while n := read() do
      write(roman(n) | "cannot convert")
end

procedure roman(n)
   local arabic, result
   static equiv
   initial equiv := $<"","I","II","III","IV","V","VI","VII","VIII","IX"$>
   integer(n) > 0 | fail
   result := ""
   every arabic := !n do
      result := map(result,"IVXLCDM","XLCDM**") || equiv$<arabic+1$>
   if find("*",result) then fail else return result
end
#------------------------------------------------------------- 138 samples/sieve
#
#          S I E V E   O F   E R A T O S T H E N E S
#

#  This program illustrates the use of sets in implementing the
#  classical sieve algorithm for computing prime numbers.

procedure main()
   local limit, s, i
   limit := 100
   s := set()
   every insert(s,1 to limit)
   every member(s,i := 2 to limit) do
      every delete(s,i + i to limit by i)
   delete(s,1)
   primes := sort(s)
   write("There are ",*primes," primes in the first ",limit," integers.")
   write("The primes are:")
   every write(right(!primes,*limit + 1))
end
#----------------------------------------------------------- 139 samples/wordcnt
#
#          W O R D   C O U N T I N G
#

#  This program tabulates the words in standard input and writes the
#  results with the words in a column 20 characters wide.  The definition
#  of a "word" is naive.

procedure main()
   wordcount(20)
end

procedure wordcount(n)
   local t, line, x, i
   static letters
   initial letters := &lcase ++ &ucase
   t := table(0)
   while line := read() do
      line ? while tab(upto(letters)) do
         t$<tab(many(letters))$> +:= 1
   x := sort(t,3)
   every i := 1 to *x - 1 by 2 do
      write(left(x$<i$>,n),x$<i + 1$>)
end
#---------------------------------------------------------- 140 samples/xcommand
###############################################################################
#
#   Demonstrate the use of the extended command line options processing procedure
#
#       xoptions(arg, optstring, errproc, finishoption[])
#
#
# Requires f1.xop and f2.xop to exist in the current directory and writes the
# results to a file command.lst
#
link ximage
link xoptions


procedure main()
    local   arglist, outfile, optionspecifier, options

    outfile := open("xcommand.lst", "w") |
               stop("Unable to write to the current working directory:\"", chdir(), "\"")
    #
    # the following is an example argument list that would be obtained when using
    # procedure main(arglist)
    #
    arglist := ["while", "-n8", "-geometry=230:340", "-Ffilename1.ext1",
                "@f1.xop", "-F", "filename2.ext2", "-si=4", "-ui",
                "-o", "file=filename3.ext3,sz=230x333,in=4,l,verbose=5",
                "-sil", "-x", "f1", "f2", "@f1.xop", "--", "f3"]
    optionspecifier := "x<*n+tvqF:*-geometry:-ui$-si+-silent!-?!=help _
                        --help-me!o(-file:-sz:-in+lmn-verb:-verbose+) _
                        -bish-bash-bosh--bash=pish-pash-posh--pash"

    #
    # write out the original arglist to the outfile first
    #
    write(outfile, ximage(arglist))
    #
    # process the arglist against the optionspecifier and write the resultant
    # values to the outfile
    #
    options := xoptions(arglist, optionspecifier)

    write(outfile, ximage(options))
    write(outfile, ximage(arglist))
end

