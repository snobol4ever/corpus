procedure main()
   if not (&features == "concurrent threads") then
      stop("This program requires concurrent threads.");

   write("Create two threads..");
   a := thread print(1);
   b := thread print(2);

   # wait for the two threads
   write(<<@a);
   write(<<@b);
   
   write("The process ended successfully, exiting now..");
end

