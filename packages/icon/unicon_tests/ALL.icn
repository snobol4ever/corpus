procedure main()
   if not(&features == "large integers") then
      stop("large integers not supported");
   i := 100000 + 10000;
   write(i);
   i +:= 2 ^ 30;
   write(i);
   i +:= i;
   write(i);
   i := 100000 * 10000;
   write(i);
   i +:= 2 ^ 30;
   write(i);
   i *:= i;
   write(i);
   i := -100000 - 10000;
   write(i);
   i +:= -(2 ^ 30);
   write(i);
   i -:= 2 ^ 30;
   write(i);
end
