    (s6 := UTF8.Concatenate(s6, s5)).String()     : Н
# Iteration 2                                     : 
    s5.String()                                   : е
    (s6 := UTF8.Concatenate(s6, s5)).String()     : Не
# Iteration 3                                     : 
    s5.String()                                   : о
