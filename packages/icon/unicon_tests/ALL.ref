F := open("gc1.icn") ----> file(gc1.icn)
procedure main()
   write("filling ...")
   every 1 to 100 do {
      every 1 to 100 do
         list(1000)
      }
   #write(&collections)
   write("collecting ...")
   collect()
   write("filling ...")
   every s := repl("x",1 to 1000) do {
      cset(string(&lcase))
      t := table()
      set([s])
      s[2 : 5]
      }
   write("done")
end
