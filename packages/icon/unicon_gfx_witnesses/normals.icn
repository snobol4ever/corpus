procedure main()
    w := open("normals", "gl", "bg=black", "size=300,300") | stop("Can't open 3D Window: ", &errortext);
    WAttrib(w, "light0=on, ambient gray, diffuse white", "normode=on");
    Fg(w, "diffuse white");
    Normals(w, [0.0, 0.0, 1.0, 0.9, 0.0, 0.4, 0.0, 0.9, 0.4]);
    FillPolygon(w, -0.6, -0.5, -2.0, 0.6, -0.5, -2.0, 0.0, 0.6, -2.0);
    Refresh(w);
    Active();
end
