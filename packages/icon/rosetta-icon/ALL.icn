procedure nextlooknsayseq(n)  #: return next element in look and say sequence
n2 := "";
n ? until pos(0) do {
   i := tab(any(&digits)) | fail;  # or fail if not digits
   move(-1);
   n2 ||:= *tab(many(i)) || i     # accumulate count+digit
   };
return n2;
end
