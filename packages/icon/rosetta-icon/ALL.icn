procedure dotproduct(a,b)   #: return dot product of vectors a & b or error
if *a ~= *b & type(a) == type(b) == "list" then runerr(205,a); # invalid value
every (dp := 0) +:= a[i := 1 to *a] * b[i];
return dp;
end
