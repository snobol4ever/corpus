   every !(canvas := list(width)) := list(width," ");      # prime the canvas
   every y := 1 to width & x := 1 to width do             # traverse it
      if iand(x - 1, y - 1) = 0 then canvas[x,y] := "*"  ; # fill

   every x := 1 to width & y := 1 to width do
      writes((y=1,"\n")|"",canvas[x,y]," ");               # print

end
#--------------------------------------------------- 260 sieve-of-eratosthenes-1
 procedure main()
    sieve(100);
 end

 procedure sieve(n)
    local p,i,j;
    p:=list(n, 1);
    every i:=2 to sqrt(n) & j:= i+i to n by i & p[i] == 1
      do p[j] := 0;
    every write(i:=2 to n & p[i] == 1 & i);
 end
#--------------------------------------------------- 261 sieve-of-eratosthenes-2
 procedure main()
     sieve(100);
 end

 procedure sieve(n)
     primes := set();
     every insert(primes,1 to n);
     every member(primes,i := 2 to n) do
         every delete(primes,i + i to n by i);
     delete(primes,1);
     every write(!sort(primes));
end
