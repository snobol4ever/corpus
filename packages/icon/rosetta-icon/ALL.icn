procedure primedecomp(n)         #: return a list of factors
local F,o,x;
F := [];

every writes(o,n|(x := genfactors(n))) do {
   \o := "*";
   /o := "=";
   put(F,x)   # build a list of factors to satisfy the task
   };
write();
return F;
end

