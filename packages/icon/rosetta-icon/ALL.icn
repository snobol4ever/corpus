#------------------------------------------------------------ 31 averages-median
procedure main(args)
    write(median(args));
end

procedure median(A)
    A := sort(A);
    n := *A;
    return if n % 2 = 1 then A[n/2+1]
           else (A[n/2]+A[n/2+1])/2.0 | 0;  # 0 if empty list
end
