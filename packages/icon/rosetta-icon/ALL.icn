#-------------------------------------------------- 27 associative-array-merging
procedure main()
    local base, update, master, f, k;

    base := table();
    base["name"] := "Rocket Skates";
    base["price"] := 12.75;
    base["color"] := "yellow";

    update := table();
    update["price"] := 15.25;
    update["color"] := "red";
    update["year"] := 1974;

    master := table();
    every k := key((f := base | update)) do {
        master[k] := f[k]
    };

    every k := key(master) do {
        write(k, " = ", master[k])
    };
end
