procedure combinations(m,n,z)                      # demonstrate combinations
/z := 1;

write(m," combinations of ",n," integers starting from ",z);
every put(L := [], z to n - 1 + z by 1)  ;          # generate list of n items from z
write("Intial list\n",list2string(L));
