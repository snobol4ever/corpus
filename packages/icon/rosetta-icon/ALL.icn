#------------------------------------------------------------------------ 14 amb
procedure main()
    s1 := ["the","that","a"];
    s2 := ["frog","elephant","thing"];
    s3 := ["walked","treaded","grows"];
    s4 := ["slowly","quickly"];

    write(amb(!s1,!s2,!s3,!s4));
end

procedure amb(exprs[])
    s := "";
    every e := !exprs do {
        if \c ~== e[1] then fail;
        c := e[-1];
        s ||:= e || " "
        };
    return s;
end
#--------------------------------------------------- 15 animation-2-three-frames
link graphics

procedure main()
    s := "Hello World! ";
    WOpen("size=640,400", "label=Animation");
    Font("typewriter,60,bold");
    direction := 1;
    w := TextWidth(s);
    h := WAttrib("fheight");
    x := (WAttrib("width") - w) / 2;
    y := (WAttrib("height") - 20 + h) / 2;

    every 1 to 3 do
    {   s := s[2 - 3 * direction:0] || s[1:2 - 3 * direction];
        EraseArea(x, y, w, -h);
        DrawString(x,y - WAttrib("descent")-1,s);
        WFlush()
    };
    Event();
end
