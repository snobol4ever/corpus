procedure choose_from_menu(X)

 displaymenu(X);
repeat {
   writes("Choose a number from the menu above: ");
   a := read();
   if a == "" then return(a);   ## no selection

  write("You selected ",a);
  if numeric(a) then {
   if integer(a) <= 0 | integer(a) > *X  then displaymenu(X) else
      {                    ## check entered option in range
        write(a, " ==> ",X[a]);
      return ( string(a))
	 }
	}
  else displaymenu(X)				
   };

end ## choose_from_menu(X)

procedure displaymenu(X)
	every i := 1 to *X do
		write(i,") ",X[i]);    ## dispay menu options
		
end ## displaymenu(X)

#------------------------------------------------------ 199 mian-chowla-sequence
procedure main(A)
   limit := \A[1] | 100;
   cnt := 0;
   write("First 30 terms:");
   every cnt +:= (m := mian()\limit,1) do {
      if cnt <= 30 then writes(" ",m);
      if cnt = 30 then write("\nTerms 91 to 100:");
      if 91 <= cnt <= 100 then writes(" ",m)
      };
   write();
end

procedure mian()
   a := [1];
   suspend 1;
   every n := seq(2) do {
      every (sums := set(), s := (i := a[k := 1 to *a]) + (j := a[k to *a]|n)) do
         if member(sums, s) then break next
         else insert(sums,s);
      suspend (put(a,n),n)
      };
end
#-------------------------- 200 minimum-multiple-of-m-where-digital-sum-equals-m
procedure main(A)
   limit := \A[1] | 40;
   every m := minmult(n := seq())\limit do
      writes(right(m,9),if n%10=0 then "\n" else "");
end

procedure minmult(n)
   every m := seq() do if n = sums(m*n) then return m;
end

procedure sums(k)
   j := 0;
   while k > 0 do (j +:= k%10, k /:= 10);
   return j;
end
#---------------------------------------------------- 201 modular-exponentiation
procedure main()
    a := 2988348162058574136915891421498819466320163312926952423791023078876139;
    b := 2351399303373464486466122544523690094744975233415544072992656881240319;
    write("last 40 digits = ",mod_power(a,b,(10^40)));
end

procedure mod_power(base, exponent, modulus)   # fast modular exponentation
   if exponent < 0 then runerr(205,m);          # added for this task
   result := 1;
   while exponent > 0 do {
      if exponent % 2 = 1 then
         result := (result * base) % modulus;
      exponent /:= 2;
      base := base ^ 2 % modulus
      };
   return result;
end
#--------------------------------------------------------- 202 modular-inverse-1
procedure main(args)
    a := integer(args[1]) | 42;
    b := integer(args[2]) | 2017;
    write(mul_inv(a,b));
end

procedure mul_inv(a,b)
    if b == 1 then return 1;
    (b0 := b, x0 := 0, x1 := 1);
    while a > 1 do {
        q := a/b;
        (t := b, b := a%b, a := t);
        (t := x0, x0 := x1-q*x0, x1 := t)
        };
    return if (x1 > 0) then x1 else x1+b0;
end
#--------------------------------------------------------- 203 modular-inverse-2
link numbers

procedure main(args)
    a := integer(args[1]) | 42;
    b := integer(args[2]) | 2017;
    write(mul_inv(a,b));
end

procedure mul_inv(a,b)
    if b == 1 then return 1;
    if gcd(a,b) ~= 1 then return "not coprime";
    (b0 := b, x0 := 0, x1 := 1);
    while a > 1 do {
        q := a/b;
        (t := b, b := a%b, a := t);
        (t := x0, x0 := x1-q*x0, x1 := t)
        };
    return if (x1 > 0) then x1 else x1+b0;
end
#-------------------------------------------------------- 204 monty-hall-problem
procedure main(arglist)

rounds := integer(arglist[1]) | 10000;
doors := '123';
strategy1 := strategy2 := 0;

every 1 to rounds do {
   goats  := doors -- ( car := ?doors );
   guess1 := ?doors;
   show   := goats -- guess1;
   if guess1 == car then strategy1 +:= 1
   else strategy2 +:= 1
   };

write("Monty Hall simulation for ", rounds, " rounds.");
write("Strategy 1 'Staying' won ", real(strategy1) / rounds );
write("Strategy 2 'Switching' won ", real(strategy2) / rounds );

end
