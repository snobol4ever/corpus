#--------------------------------------------------- 276 sieve-of-eratosthenes-1
 procedure main()
    sieve(100);
 end

 procedure sieve(n)
    local p,i,j;
    p:=list(n, 1);
    every i:=2 to sqrt(n) & j:= i+i to n by i & p[i] == 1
      do p[j] := 0;
    every write(i:=2 to n & p[i] == 1 & i);
 end
#--------------------------------------------------- 277 sieve-of-eratosthenes-2
 procedure main()
     sieve(100);
 end

 procedure sieve(n)
     primes := set();
     every insert(primes,1 to n);
     every member(primes,i := 2 to n) do
         every delete(primes,i + i to n by i);
     delete(primes,1);
     every write(!sort(primes));
end
