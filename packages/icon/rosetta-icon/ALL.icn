#----------------------------------------------- 519 knapsack-problem-continuous
link printf

procedure main()
room := 15;
every (x := !(choices := get_items())).uprice := x.price / x.weight;
choices := reverse(sortf(choices,4));

every (value := 0, x := !choices) do {
   if x.weight <= room then {
      printf("Take all of the %s (%r kg) worth $%r\n",x.name,x.weight,x.price);
      value +:= x.price;
      room -:= x.weight
      }
   else {
      fvalue := x.uprice * room;
      printf("Take (%r kg) of the %s worth $%r\n",room,x.name,fvalue);
      value +:= fvalue;
      break
   }
};
printf("Total value of a full knapsack is $%r\n",value);
end

record item(name,weight,price,uprice)

procedure get_items()
   return [  item("beef", 3.8, 36),
             item("pork", 5.4, 43),
             item("ham", 3.6, 90),
             item("greaves", 2.4, 45),
             item("flitch", 4.0, 30),
             item("brawn", 2.5, 56),
             item("welt", 3.7, 67),
             item("salami", 3.0, 95),
             item("sausage", 5.9, 98) ];
end
#-------------------------------------------------------- 520 knuths-algorithm-s
import Utils

procedure main(A)
    freq := table(0)
    every 1 to (\A[2] | 100000)\1 do {
        s_of_n := s_of_n_creator(\A[1] | 3)
        every sample := s_of_n(0 to 9)
        every freq[!sample] +:= 1
        }
    every write(i := 0 to 9,": ",right(freq[i],6))
end

procedure s_of_n_creator(n)
    items := []
    itemCnt := 0.0
    return makeProc {
               repeat {
                   item := (items@&source)[1]
                   itemCnt +:= 1
                   if *items < n then put(items, item)
                   else if ?0 < (n/itemCnt) then ?items := item
                   }
               }
end
#-------------------------------------------------------------- 521 langtons-ant
link graphics,printf

procedure main(A)
   e := ( 0 < integer(\A[1])) | 100;   # 100 or whole number from command line
   LangtonsAnt(e);
end

record antrec(x,y,nesw)

procedure LangtonsAnt(e)
   size  := sprintf("size=%d,%d",e,e);
   label := sprintf("Langton's Ant %dx%d [%d]",e,e,0);
   &window := open(label,"g","bg=white",size) |
               stop("Unable to open window");

   ant := antrec(e/2,e/2,?4%4);
   board := list(e);
   every !board := list(e,"w");

   k := 0;
   repeat {
      k +:= 1;
      WAttrib("fg=red");
      DrawPoint(ant.x,ant.y);

      cell := board[ant.x,ant.y];
      if cell == "w" then {                        # white cell
         WAttrib("fg=black");
         ant.nesw := (ant.nesw + 1) % 4            # . turn right
         }
      else {                                       # black cell
         WAttrib( "fg=white");
         ant.nesw := (ant.nesw + 3) % 4            # . turn left = 3 x right
         };
      board[ant.x,ant.y] := map(cell,"wb","bw");    # flip colour
      DrawPoint(ant.x,ant.y);

      case ant.nesw of {                           # go
         0: ant.y -:= 1 ;                           # . north
         1: ant.x +:= 1;                            # . east
         2: ant.y +:= 1;                            # . south
         3: ant.x -:= 1                            # . west
         };

      if 0 < ant.x <= e & 0 < ant.y <= e then next
      else break
      };
   printf("Langton's Ant exited the field after %d rounds.\n",k);
   label := sprintf("label=Langton's Ant %dx%d [%d]",e,e,k);
   WAttrib(label);
   WDone();
end
#---------------------------------------- 522 largest-int-from-concatenated-ints
import Collections    # For the Heap (dense priority queue) class

procedure main(a)
    write(lici(a))
end

procedure lici(a)
    every (result := "") ||:= Heap(a,,cmp).gen()
    return result
end

procedure cmp(a,b)
   return (a||b) > (b||a)
end
#------------------------------------------------- 523 last-friday-of-each-month
procedure main(A)
every write(lastfridays(!A))
end

procedure lastfridays(year)
every m := 1 to 12 do {
   d := case m of {
      2        : if IsLeapYear(year) then 29 else 28
      4|6|9|11 : 30
      default  : 31
      }                          # last day of month

   z := 0
   j := julian(m,d,year) + 1     # first day of next month
   until (j-:=1)%7 = 4 do z -:=1 # backup to last friday=4
   suspend sprintf("%d-%d-%d",year,m,d+z)
   }
end

