#------------------------------------------------- 123 get-system-command-output
#
# piped.icn, Get system command output
#
# Dedicated to the public domain
#
procedure main()
    # start with an empty list
    directory := [];

    # ls for UNIX, dir for other, assume Windows
    command := if &features == "UNIX" then "ls" else "dir";

    # open command in pipe mode
    p := open(command, "p") | stop("Cannot open pipe for ", command);

    # read in results and append to list
    while put(directory, read(p));

    # display the fifth entry, if there is one
    write(\directory[5]);

    close(p);
end
#-------------------------------------------------- 124 golden-ratio-convergence
global one, one_squared

procedure main ()
  local result, phi, n, floatphi;
  one := 1000000000000000000;
  one_squared := one * one;
  result := iterate (one, 0);
  phi := result[1];
  n := result[2];
  floatphi := real (phi) / one;
  write ("Result: ", phi, "/", one, " (", floatphi, ")");
  write ("        ", n, " iterations");
  write ("The error is approximately ",
         floatphi - (0.5 * (1 + sqrt (5))));
end

procedure iterate (phi, n)
  local phi1, n1;
  phi1 := one + (one_squared / phi);
  n1 := n + 1;
  if 100000 * abs (phi1 - phi) <= one then
    return [phi1, n1]
  else
    return iterate (phi1, n1);
end
#-------------------------------------------------------------- 125 gospers-hack
procedure main()
    every i := 1|3|7|15 do{
        writes(i,":");
        every writes(" ",gosperhack(i)\10);
        write()
    };
end

procedure gosperhack(n)
    n > 0 | fail;
    repeat{
        a := iand(n,-n);
        b := n + a;
        suspend n := ior(b, ishift(ixor(n,b),-2) / a)
    };
end
