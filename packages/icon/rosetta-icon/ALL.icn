#-------------------------------------------------- 117 first-class-environments
link printf

procedure main()
   every put(environment := [], hailenv(1 to 12,0));  # setup environments
   printf("Sequences:\n");
   while (e := !environment).sequence > 1 do {
      every hailstep(!environment);
      printf("\n")
      };
