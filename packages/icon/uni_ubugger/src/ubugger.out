global dbg_step_hello
;dbg_step_hello:=1;
procedure main()
local i, total
total := 0;if /dbg_step_hello then dbg_step_hello:=0; if dbg_step_hello==1 then {write("\n",center("hello.icn",125,"="));write(">> ",left("total := 0",121," "),"|");every local_s := staticnames(debug_c_s) do write("S-","----3","\t\t",left(local_s,20,"-"),left(fullimage(variable(local_s)),80," "),"|");every local_v := localnames(debug_c_l) do write("L-","----3","\t\t",if \variable(local_v) then right(*(variable(local_v)),6,"") else right(0,6,""),"\t",left(local_v,20,"-"),left(fullimage(variable(local_v)),80," "),"|");write("[S] Step, [C] Continue");ch:= getch(); if ch=="s" then write("Stepped.") else {write("Continued.\n");dbg_step_hello:=0;}}
every i := 1 to 3 do {
;dbg_step_hello:=1;
total +:= i;if /dbg_step_hello then dbg_step_hello:=0; if dbg_step_hello==1 then {write("\n",center("hello.icn",125,"="));write(">> ",left("total +:= i",121," "),"|");every local_s := staticnames(debug_c_s) do write("S-","----5","\t\t",left(local_s,20,"-"),left(fullimage(variable(local_s)),80," "),"|");every local_v := localnames(debug_c_l) do write("L-","----5","\t\t",if \variable(local_v) then right(*(variable(local_v)),6,"") else right(0,6,""),"\t",left(local_v,20,"-"),left(fullimage(variable(local_v)),80," "),"|");write("[S] Step, [C] Continue");ch:= getch(); if ch=="s" then write("Stepped.") else {write("Continued.\n");dbg_step_hello:=0;}}
write("line ", i);if /dbg_step_hello then dbg_step_hello:=0; if dbg_step_hello==1 then {write("\n",center("hello.icn",125,"="));write(">> ",left("write(\"line \", i)",121," "),"|");every local_s := staticnames(debug_c_s) do write("S-","----6","\t\t",left(local_s,20,"-"),left(fullimage(variable(local_s)),80," "),"|");every local_v := localnames(debug_c_l) do write("L-","----6","\t\t",if \variable(local_v) then right(*(variable(local_v)),6,"") else right(0,6,""),"\t",left(local_v,20,"-"),left(fullimage(variable(local_v)),80," "),"|");write("[S] Step, [C] Continue");ch:= getch(); if ch=="s" then write("Stepped.") else {write("Continued.\n");dbg_step_hello:=0;}}
}
if total > 5 then
write("total ", total);if /dbg_step_hello then dbg_step_hello:=0; if dbg_step_hello==1 then {write("\n",center("hello.icn",125,"="));write(">> ",left("write(\"total \", total)",121," "),"|");every local_s := staticnames(debug_c_s) do write("S-","----9","\t\t",left(local_s,20,"-"),left(fullimage(variable(local_s)),80," "),"|");every local_v := localnames(debug_c_l) do write("L-","----9","\t\t",if \variable(local_v) then right(*(variable(local_v)),6,"") else right(0,6,""),"\t",left(local_v,20,"-"),left(fullimage(variable(local_v)),80," "),"|");write("[S] Step, [C] Continue");ch:= getch(); if ch=="s" then write("Stepped.") else {write("Continued.\n");dbg_step_hello:=0;}}
write("done");if /dbg_step_hello then dbg_step_hello:=0; if dbg_step_hello==1 then {write("\n",center("hello.icn",125,"="));write(">> ",left("write(\"done\")",121," "),"|");every local_s := staticnames(debug_c_s) do write("S-","---10","\t\t",left(local_s,20,"-"),left(fullimage(variable(local_s)),80," "),"|");every local_v := localnames(debug_c_l) do write("L-","---10","\t\t",if \variable(local_v) then right(*(variable(local_v)),6,"") else right(0,6,""),"\t",left(local_v,20,"-"),left(fullimage(variable(local_v)),80," "),"|");write("[S] Step, [C] Continue");ch:= getch(); if ch=="s" then write("Stepped.") else {write("Continued.\n");dbg_step_hello:=0;}}
end
