#SRC: JCON (jcon-master/tran/jtran_main.icn) — semicolons added for SCRIP; otherwise verbatim.
#     Original: Gregg Townsend & Todd Proebsting, Arizona. See COPYRIGHT in this dir.
#  jtran_main.icn -- (generic) driver for Jcon.

invocable all

procedure cat(getline, args);
    local f, p;

    while f := !args do {
        suspend |open(f)
    };
    if *args = 0 then {
        if /getline then {
            suspend |&input
        } else {
            while p := @getline do {
                suspend p
            }
        }
    };
end

procedure tee(c, L);
    local fn, f, v;
    fn := get(L) | stop("ERROR: tee: no filename");
    f := open(fn, "w") | stop("ERROR: cannot write ", fn);
    while v := @c do {
	write(f, dump_verbose(v, "", ""));
	suspend v
    };
end

procedure stdout(c);
    local p;
    while p := @\c do {
        write(p)
    };
end

procedure devnull(c);
    while @\c;
end

procedure main(L);
    local args, k, fn0, fn, c;

    while L[1] do {
        args := [];
        while k := pop(L) & k ~== ":" do {
            put(args, k)
        };
        fn0 := pop(args);
        fn := proc(fn0) | stop("ERROR: unknown command-line procedure, ", fn0);
        # SCRIP deviation (ceo 2026-08-30): upstream says `c := create fn(c, args)`, but SCRIP's
        # `create` through a proc-VARIABLE currently yields a dead co-expression (minimal witness:
        # fn := stage; create fn(...) activates to immediate failure while create stage(...) is
        # correct). Until that engine gap is cured, dispatch the known pipeline stages by direct
        # name; the default arm keeps upstream's shape so an unlisted stage fails loudly there.
        c := case fn0 of {
            "preproc":  create preproc(c, args);
            "yylex":    create yylex(c, args);
            "parse":    create parse(c, args);
            "ast2ir":   create ast2ir(c, args);
            "bc_File":  create bc_File(c, args);
            "cat":      create cat(c, args);
            "tee":      create tee(c, args);
            "stdout":   create stdout(c);
            "devnull":  create devnull(c);
            default:    create fn(c, args)
        }
    };
    while @c;
end
