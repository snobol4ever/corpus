procedure do_ops();
	if ="@" then { # @
	  if =":=" then { # @:=
	    { return lex_AUGAT }
	  }
	  else { return lex_AT }
	};
	if ="-" then { # -
	  if ="-" then { # --
	    if =":=" then { # --:=
	      { return lex_AUGDIFF }
	    }
	    else { return lex_DIFF }
	  };
	  if =":" then { # -:
	    if ="=" then { # -:=
	      { return lex_AUGMINUS }
	    }
	    else { return lex_MCOLON }
	  }
	  else { return lex_MINUS }
	};
	if ="=" then { # =
	  if ="=" then { # ==
	    if ="=" then { # ===
	      if =":=" then { # ===:=
	        { return lex_AUGEQUIV }
	      }
	      else { return lex_EQUIV }
	    };
	    if =":=" then { # ==:=
	      { return lex_AUGSEQ }
	    }
	    else { return lex_SEQ }
	  };
	  if =":=" then { # =:=
	    { return lex_AUGNMEQ }
	  }
	  else { return lex_NMEQ }
	};
	if ="]" then { # ]
	  { return lex_RBRACK }
	};
	if ="}" then { # }
	  { return lex_RBRACE }
	};
	if ="*" then { # *
	  if ="*" then { # **
	    if =":=" then { # **:=
	      { return lex_AUGINTER }
	    }
	    else { return lex_INTER }
	  };
	  if =":=" then { # *:=
	    { return lex_AUGSTAR }
	  }
	  else { return lex_STAR }
	};
	if =":" then { # :
	  if ="=" then { # :=
	    if =":" then { # :=:
	      { return lex_SWAP }
	    }
	    else { return lex_ASSIGN }
	  }
	  else { return lex_COLON }
	};
	if ="$" then { # $
	  if =">" then { # $>
	    { return lex_RBRACK }
	  };
	  if ="(" then { # $(
	    { return lex_LBRACE }
	  };
	  if ="<" then { # $<
	    { return lex_LBRACK }
	  };
	  if =")" then { # $)
	    { return lex_RBRACE }
	  }
	  else { return lex_RHSARG }
	};
	if ="!" then { # !
	  { return lex_BANG }
	};
	if ="." then { # .
	  { return lex_DOT }
	};
	if =">" then { # >
	  if ="=" then { # >=
	    if =":=" then { # >=:=
	      { return lex_AUGNMGE }
	    }
	    else { return lex_NMGE }
	  };
	  if =">" then { # >>
	    if ="=" then { # >>=
	      if =":=" then { # >>=:=
	        { return lex_AUGSGE }
	      }
	      else { return lex_SGE }
	    };
	    if =":=" then { # >>:=
	      { return lex_AUGSGT }
	    }
	    else { return lex_SGT }
	  };
	  if =":=" then { # >:=
	    { return lex_AUGNMGT }
	  }
	  else { return lex_NMGT }
	};
	if ="^" then { # ^
	  if =":=" then { # ^:=
	    { return lex_AUGCARET }
	  }
	  else { return lex_CARET }
	};
	if ="~" then { # ~
	  if ="=" then { # ~=
	    if ="=" then { # ~==
	      if ="=" then { # ~===
	        if =":=" then { # ~===:=
	          { return lex_AUGNEQUIV }
	        }
	        else { return lex_NEQUIV }
	      };
	      if =":=" then { # ~==:=
	        { return lex_AUGSNE }
	      }
	      else { return lex_SNE }
	    };
	    if =":=" then { # ~=:=
	      { return lex_AUGNMNE }
	    }
	    else { return lex_NMNE }
	  }
	  else { return lex_TILDE }
	};
	if ="+" then { # +
	  if =":" then { # +:
	    if ="=" then { # +:=
	      { return lex_AUGPLUS }
	    }
	    else { return lex_PCOLON }
	  };
	  if ="+" then { # ++
	    if =":=" then { # ++:=
	      { return lex_AUGUNION }
	    }
	    else { return lex_UNION }
	  }
	  else { return lex_PLUS }
	};
	if =";" then { # ;
	  { return lex_SEMICOL }
	};
	if ="[" then { # [
	  { return lex_LBRACK }
	};
	if ="{" then { # {
	  { return lex_LBRACE }
	};
	if ="(" then { # (
	  { return lex_LPAREN }
	};
	if ="%" then { # %
	  if ="}" then { # %}
	    { return lex_ENDGLOB }
	  };
	  if ="$)" then { # %$)
	    { return lex_ENDGLOB }
	  };
	  if ="{" then { # %{
	    { return lex_BEGGLOB }
	  };
	  if ="%" then { # %%
	    { return lex_NEWSECT }
	  };
	  if =":=" then { # %:=
	    { return lex_AUGMOD }
	  };
	  if ="$(" then { # %$(
	    { return lex_BEGGLOB }
	  }
	  else { return lex_MOD }
	};
	if ="/" then { # /
	  if =":=" then { # /:=
	    { return lex_AUGSLASH }
	  }
	  else { return lex_SLASH }
	};
	if ="?" then { # ?
	  if =":=" then { # ?:=
	    { return lex_AUGQMARK }
	  }
	  else { return lex_QMARK }
	};
	if ="," then { # ,
	  { return lex_COMMA }
	};
	if ="<" then { # <
	  if ="-" then { # <-
	    if =">" then { # <->
	      { return lex_REVSWAP }
	    }
	    else { return lex_REVASSIGN }
	  };
	  if ="=" then { # <=
	    if =":=" then { # <=:=
	      { return lex_AUGNMLE }
	    }
	    else { return lex_NMLE }
	  };
	  if ="<" then { # <<
	    if ="=" then { # <<=
	      if =":=" then { # <<=:=
	        { return lex_AUGSLE }
	      }
	      else { return lex_SLE }
	    };
	    if =":=" then { # <<:=
	      { return lex_AUGSLT }
	    }
	    else { return lex_SLT }
	  };
	  if =":=" then { # <:=
	    { return lex_AUGNMLT }
	  }
	  else { return lex_NMLT }
	};
	if ="\\" then { # \
	  { return lex_BACKSLASH }
	};
	if ="|" then { # |
	  if ="|" then { # ||
	    if ="|" then { # |||
	      if =":=" then { # |||:=
	        { return lex_AUGLCONCAT }
	      }
	      else { return lex_LCONCAT }
	    };
	    if =":=" then { # ||:=
	      { return lex_AUGCONCAT }
	    }
	    else { return lex_CONCAT }
	  }
	  else { return lex_BAR }
	};
	if =")" then { # )
	  { return lex_RPAREN }
	};
	if ="&" then { # &
	  if =":=" then { # &:=
	    { return lex_AUGAND }
	  }
	  else { return lex_AND }
	};
	fail;
end
