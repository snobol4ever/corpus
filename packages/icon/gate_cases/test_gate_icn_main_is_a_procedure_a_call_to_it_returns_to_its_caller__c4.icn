global n
procedure a(x, y)
   write("a ", x, " ", y);
   if n < 3 then return main(x + 1);
   return b(x);
end
procedure b(x)
   write("b ", x);
   return c(x, x);
end
procedure main(z)
   /n := 0;
   n +:= 1;
   write("main ", image(z), " n=", n, " level=", &level);
   if n < 4 then write("got ", a(n, 2));
   return 7;
end
procedure c(p, q)
   write("c ", p + q);
   return p * q;
end
