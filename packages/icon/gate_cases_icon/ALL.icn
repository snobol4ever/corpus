procedure g(n, s)
   local t;
   t := n * 2;
   write(variable("n"), " ", variable("s"), " ", variable("t"));
   display(1);
   return h(n, s);
end
procedure h(a, b)
   return a + b;
end
#------------------- 213 test_gate_icn_the_block_protocol_carries_every_call__w3
