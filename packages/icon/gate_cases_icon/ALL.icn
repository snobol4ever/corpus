#---------- 32 test_gate_icn_a_one_character_substring_swap_builds_one_string__w
global G
procedure sw(x)
   every !x :=: ?x;
   return x;
end
procedure main()
   local s, t, L, T, i, v;
   &random := 7;
   s := "abcdef";
   write(s[1] :=: s[6], " ", s);
   write(s[3] :=: s[3], " ", s);
   write(s[2] :=: s[-1], " ", s);
   t := "XYZ";
   write(s[1] :=: t[2], " ", s, " ", t);
   write(s[1:3] :=: s[4:5], " ", s);
   write(s[1:3] :=: t[1:3], " ", s, " ", t);
   write(s[5:7] :=: s[1:2], " ", s);
   s := "a\x00b";
   write(image(s[1] :=: s[2]), " ", image(s));
   L := ["hello", "world"];
   write(L[1][1] :=: L[1][5], " ", L[1]);
   write(L[1][1] :=: L[2][1], " ", L[1], " ", L[2]);
   T := table();
   T["k"] := "table";
   write(T["k"][1] :=: T["k"][5], " ", T["k"]);
   G := "global";
   write(G[1] :=: G[6], " ", G);
   s := "abcdef";
   every i := 1 to 6 do s[i] :=: s[7 - i];
   write(s);
   s := "0123456789";
   every 1 to 100 do ?s :=: ?s;
   write(s);
   every write(sw("deal" | "shuffle" | "x" | ""));
   s := "abc";
   v := s;
   s[1] :=: s[3];
   write(s, " ", v);
end
