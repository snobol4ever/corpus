procedure two(a, b)
   return a;
end
procedure va(a[])
   return *a;
end
procedure vb(x, y, z[])
   return *z;
end
procedure main()
   write(args(two), " ", args(va), " ", args(vb), " ", args(main), " ", args(write), " ", args(reverse));
   write(va(1, 2, 3), " ", vb(1, 2), " ", vb(1, 2, 3, 4), " ", two(5, 6));
end
