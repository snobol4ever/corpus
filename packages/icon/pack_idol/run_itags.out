icont -Sr500 -SF30 -Si1000 itags
global ibrowseflag
procedure main(args)
local line, lineno, fout, i, fin, notvar, objects, actual_file, outlines
initial {
#line 19 "itags.iol"

    fout := open("ITAGS", "w") | stop("can't open ITAGS for writing");
    outlines := [[0,0,0,0,0,0]]
    i := 1
    notid := &cset -- &ucase -- &digits -- &lcase -- '_'
}

if(*args=0) then
    stop("usage: itags file1 [file2 ...]")

while i <= *args do {
    if args[i] == "-i" then {
	ibrowseflag := 1
	i +:= 1
	continue
    }
    fin := open(args[i],"r") |
	stop("could not open file ",args[i]," exiting")
    lineno := 1
    objects := program( args[i] )

    while line := read(fin) do {
	line[upto('#',line):0] := ""
	line ? {
	    tab(many(' '))

	    if =("global") then {
		if(any(notid)) then
		    every (__self1 := objects).__methods.addvar(__self1.__state,getword(), lineno )
	    }

	    if =("procedure")  then
		  if(any(notid)) then {
		    (__self1 := objects).__methods.addproc(__self1.__state,getword(), lineno )
		    (__self1 := objects).__methods.myline(__self1.__state,tab(0),lineno)
	    }


	    if =("class") then
		if any(notid) then {
		    (__self1 := objects).__methods.addclass(__self1.__state,getword(), lineno )
		    (__self1 := objects).__methods.myline(__self1.__state,tab(0),lineno)
		}


	    if =("method") then {
		if any(notid) then {
		    (__self1 := objects).__methods.addmethod(__self1.__state,getword(), lineno )
		    (__self1 := objects).__methods.myline(__self1.__state,tab(0),lineno)
		}
	    }

	    if =("local") then {
		if any(notid) then
		    every (__self1 := objects).__methods.addvar(__self1.__state,getword(), lineno )
	    }

	    if =("static") then {
		if any(notid) then
		    every (__self1 := objects).__methods.addstat(__self1.__state,getword(), lineno )
	    }

	    if =("record") then {
		if any(notid) then {
		    (__self1 := objects).__methods.addrec(__self1.__state,getword(), lineno )
		    (__self1 := objects).__methods.myline(__self1.__state,tab(0),lineno)
		    (__self1 := objects).__methods.endline(__self1.__state,lineno)
		}
	    }
	    if =("end") then
		(__self1 := objects).__methods.endline(__self1.__state,lineno)
	}
	lineno +:= 1
    }
    (__self1 := objects).__methods.drawthyself(__self1.__state,outlines)
    i +:= 1
}

every i := 2 to *outlines do {
    outlines[i] := (
	left(outlines[i][1],outlines[1][1]+1) ||
	left(outlines[i][2],outlines[1][2]+1) ||
	left(outlines[i][3],outlines[1][3]+1) ||
	left(outlines[i][4],outlines[1][4]+1) ||
	left(outlines[i][5],outlines[1][5]) ||
	(if \outlines[i][6] then ":"||outlines[i][6] else ""))
}
outlines := outlines[2:0]
outlines := sort(outlines)
every write(fout,!outlines)
end
