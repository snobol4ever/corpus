class ictester()
method classmethod()
end
procedure ictester_classmethod(self)
#line 2 "ictest.iol"
    write("hello, world")
  end
record ictester__state(__state,__methods)
record ictester__methods(classmethod)
global ictester__oprec
procedure ictester()
local self,clone
initial {
  if /ictester__oprec then ictesterinitialize()
  }
  self := ictester__state(&null,ictester__oprec)
  self.__state := self
  return idol_object(self,ictester__oprec)
end

procedure ictesterinitialize()
  initial ictester__oprec := ictester__methods(ictester_classmethod)
end
record idol_object(__state,__methods)
