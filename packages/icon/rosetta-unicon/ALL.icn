#--------------------------------------------------------- 13 singly-linked-list-element-insertion
class Node (value, successor)

  method insert (node)
    node.successor := self.successor;
    self.successor := node;
  end

  initially (value, successor)
    self.value := value;
    self.successor := successor;
end
