procedure main()
   v1 := vector(5,7);
   v2 := vector(2,3);
   write(v1.tostring(),"+",v2.tostring()," = ",(v1 + v2).tostring());
   write(v1.tostring(),"-",v2.tostring()," = ",(v1 - v2).tostring());
