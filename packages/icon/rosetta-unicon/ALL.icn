#--------------------------------------------------------------- 30 emirp-primes
link fastprime

procedure main(A)
   limit := \A[1] | 10000;
   l1 := \A[2] | 20;
   l2 := \A[3] | 7700;
   l3 := \A[4] | 8000;

   every (cnt := 0, (n := emirp())\limit, cnt +:= 1) do {
      if cnt < l1 then writes(" ",n)
      else if cnt = l1 then write(" ",n)
      else {
         if (/c1,n > l2,c1:=1) then writes("Emirps between ",l2," and ",l3,":");
         if l2 < n < l3 then writes(" ",n);
         if (/c2,n >= l3,c2:=1) then write()
         }
      };
   write(limit,"th emirp: ",n);
end

procedure emirp()
   every p := string(genprimes()) do
      if (p ~== (rp := reverse(p)), is_prime(integer(rp))) then suspend p;
end
#--------------------------------------------- 31 equal-prime-and-composite-sums
link fastprime
global pidx, cidx

procedure main(A)
   limit := \A[1] | 6;
   c1 := create sumprime();
   c2 := create sumcomp();

   (cnt := 0, sump := @c1, sumc := @c2);
   while cnt < limit do {
      if (sump = sumc) then (cnt +:= 1, write("(",pidx,",",cidx,"): ",sump));
      (sump := @c1, sumc := @c2);
      while (sump < sumc, sump := @c1);
      while (sumc < sump, sumc := @c2)
      };
end

procedure sumprime()
static sum;
initial (sum := 0, pidx := 0);
   every (sum +:= genprimes(), pidx +:= 1) do suspend sum;
end

procedure sumcomp()
static sum;
initial (sum := 0, cidx := 0);
   every n := seq(3) do if (not is_prime(n), cidx +:=1) then suspend sum +:= n;
end
#----------------------------------------------------------- 32 factorial-primes
link fastprime

procedure main(A)
   limit := \A[1] | 10;
   every f := gfactorial(n := seq()) do {
      if (x := (is_prime(y := f-1),n||"!-1")) then
         (write(" (",x,",",y,")"), if 0 = (limit -:= 1) then break);
      if (x := (is_prime(y := f+1),n||"!+1")) then
         (write(" (",x,",",y,")"), if 0 = (limit -:= 1) then break)
      };
end
#------------------------------------------------------------- 33 fermat-numbers
link fastprime

procedure main(A)
   limit := \A[1] | 10;
   limit2 := \A[2] | 6;
   write("First ",limit," Fermat numbers:");
   cnt := 0;
   every f := fermat()\limit do {
       if cnt > limit2 then write(right(cnt,3)," ",f)
       else {
          if (g := f/(x := getfactor(f))) = 1 then s := " is prime"
          else s := " factors: ["||x||" x "||(f/x)||"]";
          write(right(cnt,3)," ",f,s)
          };
       cnt +:= 1
       };
end

procedure fermat()
   suspend 2^2^seq(0)+1;
end
#--------------------------------------------------------------- 34 pell-numbers
link fastprime

global pidx

procedure main(A)
   limit := \A[1] | 10;
   write("Pell numbers:");
   every writes(" ",pell(0,1)\limit | "\n");

   write("\nPell-Lucas numbers:");
   every writes(" ",pell(2,2)\limit | "\n");

   write("\nRational approximations to sqrt(2):");
   @(cp := create pell(0,1));
   @(cl := create pell(2,2));
   cnt := 1;
   while (cnt <= limit, cnt +:=1) do
       (n := @cl/2, d := @cp, write(" (",n,"/",d,") = ",real(n)/d));

   write("\n(Pell Prime Index,Pell Prime):");
   every p := is_prime(pell(0,1))\limit do write(" (",pidx,",",p,")");

   write("\nNSW numbers:");
   every writes(" ",nsw()\limit | "\n");

   write("\nTriangles:");
   every write(" ",triangles()\limit);
end

procedure pell(p0,p1)
   pidx := -1;
   repeat suspend 1(p := 2*p1 + p0, p :=: p1 :=: p0, pidx +:= 1);
end

procedure nsw()
   ps := [];
   n := 0;
   every put(ps,pell(0,1)) do
      if *ps >= 2 then suspend 1(ps[2*n+1]+ps[2*n+2], n +:= 1);
end

procedure triangles()
   n := 3;
   repeat {
      (sum := 0, ps := [0]);
      every put(ps,pell(0,1))\(n+1) do sum +:= ps[*ps-1];
      suspend (n%2 = 1, "("||sum||","||(sum+1)||","||ps[*ps]||")");
      n +:= 1
      };
end
#------------------------------------------------------------- 35 repunit-primes
link fastprime

procedure main(A)
   limit := \A[1] | 1000;
   every writes("Base ",b := 2 to 16,":") do
      every writes(" ",repunits(b,limit) | "\n");
end

procedure repunits(b,n)
   every x := genprimes() do
      if x > n then break
      else suspend (is_prime(ru(b,x)), x);
end

procedure ru(b,n)
   every (r := 0) +:= b^(0 to n-1);
   return r;
end
