#--------------------------------------------------------- 5 barnsley-fern-seeded
link graphics

global x, y

procedure main()
    &window := open("FERN", "g", "size=400,400", "bg=black");
	
    &random := 42;
    x := y := 0;
	
    draw();
    WFlush(&window);
    Event();
end

procedure next_point()
    local nx, ny, r;
	
    nx := 0.0;
    ny := 0.0;
	
    r := ?100;
	
    if r < 1 then {
	nx := 0.0;
	ny := 0.16 * y
    } else if r < 86 then {
	nx := 0.85 * x + 0.04 * y;
	ny := -0.04 * x + 0.85 * y + 1.6
    } else if r < 93 then {
	nx := 0.2 * x - 0.26 * y;
	ny := 0.23 * x + 0.22 * y + 1.6
    } else {
	nx := -0.15 * x + 0.28 * y;
	ny := 0.26 * x + 0.24 * y + 0.44
    };
	
    x := nx;
    y := ny;
end

procedure map(v:real, a, b, c, d)
    return (v - a) / (b - a) * (d - c) + c;
end

procedure draw_point()
    local px, py;
	
    px := map(x, -2.1820, 2.6558, 0.0, 400.0);
    py := map(y, 0.0, 9.9983, 400.0, 0.0);
	
    Fg("green");
    DrawPoint(px, py);
end

procedure draw()
    every i := 0 to 10000 do {
	draw_point();
	next_point()
    };
end
