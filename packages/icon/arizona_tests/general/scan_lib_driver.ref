s3 = "a+'b+c'+(d+e)+\"f\\\"+g\"+h"
balq('+', , , , , s3): 2 8 14 22
balq('+', , , , , s3, 1, 12): 2 8
s3 ? balq('+'): 2 8 14 22
balq('+', , , , , "a+(b+c))+d"): 2
s4 = "a+/*b+c*/+d+(e+f)+'g+h'+i"
balqc('+', , , , , , , s4): 2 10 12 18 24
s4 ? balqc('+'): 2 10 12 18 24
balqc('+', , , , , "<", ">", "p+<q+r>+s"): 2 8
limatch(["quick", "brown", "fox"], ' ,') = 21
limatch(["quick", "fox"], ' ,') = fails
limatch(["e.g.", "i.e."], ' ') = 11
