s1 = "a+(b+c)+d\\(+e)+f"
slashbal('+', '(', ')', s1): 2 8 12 15
slashbal(, , , s1): 1 2 3 8 9 10 11 12 13 14 15 16
slashbal('+', , , s1, 3, 12): 8
s1 ? slashbal('+'): 2 8 12 15
s2 = "x*y\\*z*w\\\\*v"
slashupto('*', s2): 2 7 11
slshupto('*', s2): 2 7 11
slshupto('*', s2, 5): 5 7 11
s2 ? slshupto('*'): 2 7 11
slshupto('\\', "a\\b\\"): 4
