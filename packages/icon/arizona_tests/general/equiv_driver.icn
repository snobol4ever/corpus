link equiv
record point(x, y)
record pair(x, y)
procedure report(label, x1, x2)
   write(label, " ", (equiv(x1, x2) & "succeeds") | "fails")
end
procedure main()
   local L1, L2, L3, T1, T2, T3, S1, S2, S3, r, v;
   report("equiv(1,1)", 1, 1);
   report("equiv(1,2)", 1, 2);
   report("equiv(1,\"1\")", 1, "1");
   report("equiv(\"abc\",\"abc\")", "abc", "abc");
   report("equiv(\"abc\",\"abd\")", "abc", "abd");
   report("equiv(2.5,2.5)", 2.5, 2.5);
   report("equiv('abc','cba')", 'abc', 'cba');
   report("equiv(&null,&null)", &null, &null);
   report("equiv(&null,0)", &null, 0);
   report("equiv([],[])", [], []);
   report("equiv([1,2,3],[1,2,3])", [1, 2, 3], [1, 2, 3]);
   report("equiv([1,2,3],[1,2,4])", [1, 2, 3], [1, 2, 4]);
   report("equiv([1,2],[1,2,3])", [1, 2], [1, 2, 3]);
   report("equiv([1,[2,[3]]],[1,[2,[3]]])", [1, [2, [3]]], [1, [2, [3]]]);
   report("equiv([1,[2,[3]]],[1,[2,[4]]])", [1, [2, [3]]], [1, [2, [4]]]);
   report("equiv([\"a\",[]],[\"a\",[]])", ["a", []], ["a", []]);
   report("equiv([],table())", [], table());
   report("equiv(point(1,2),point(1,2))", point(1, 2), point(1, 2));
   report("equiv(point(1,2),point(2,1))", point(1, 2), point(2, 1));
   report("equiv(point(1,2),pair(1,2))", point(1, 2), pair(1, 2));
   report("equiv(point([1],\"a\"),point([1],\"a\"))", point([1], "a"), point([1], "a"));
   T1 := table();
   T2 := table();
   T3 := table();
   T1["a"] := 1;
   T1["b"] := [2, 3];
   T2["b"] := [2, 3];
   T2["a"] := 1;
   T3["a"] := 1;
   T3["b"] := [2, 4];
   report("equiv(T1,T2)", T1, T2);
   report("equiv(T1,T3)", T1, T3);
   report("equiv(table(),table())", table(), table());
   S1 := set([1, 2, 3]);
   S2 := set([3, 2, 1]);
   S3 := set([1, 2, 5]);
   report("equiv(S1,S2)", S1, S2);
   report("equiv(S1,S3)", S1, S3);
   report("equiv(set(),set())", set(), set());
   report("equiv(set(),[])", set(), []);
   report("equiv(write,write)", write, write);
   report("equiv(write,writes)", write, writes);
   report("equiv(main,main)", main, main);
   L1 := [];
   L2 := [];
   put(L1, L1);
   put(L2, L1);
   report("equiv(L1,L2) loop", L1, L2);
   report("equiv(L2,L1) loop", L2, L1);
   # Two distinct self-loops (L := [L] vs M := [M]) recurse without bound in
   # equiv() itself (iconx: run-time error 301), so that case is not exercised.
   r := point(1);
   r.y := r;
   report("equiv(record loop)", r, point(1, r));
   L1 := [1, 2];
   L2 := [L1, L1];
   L3 := [[1, 2], [1, 2]];
   report("equiv(shared,unshared)", L2, L3);
   v := equiv(L2, L3);
   write("equiv returns x2: ", (v === L3 & "yes") | "no");
   write("equiv(\"x\",\"x\") value: ", equiv("x", "x"));
   write("equiv(42,42) value: ", equiv(42, 42))
end
