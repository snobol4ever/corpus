link indices
procedure show(L)
   local s;
   s := "";
   every s ||:= " " || image(!L);
   return "[" || s || " ]"
end
procedure main()
   local s;
   every s := "1,3-10" | "10-1" | "3-10, 1" | "3-10,1,5" | "10,,12" | "5" | "" | "0" | "1,0" | "a" | "4-2,x" | "7,7,7" | "10-" do
      write("indices(", image(s), ") = ", show(indices(s)) | "fails");
   write("indices(\"2-4,7-\", 9) = ", show(indices("2-4,7-", 9)) | "fails");
   write("indices(\"10-\", 12) = ", show(indices("10-", 12)) | "fails");
   write("indices(\"12-\", 10) = ", show(indices("12-", 10)) | "fails");
   write("indices(\"1\", 0) = ", show(indices("1", 0)) | "fails");
   write("indices(\"1\", \"x\") = ", show(indices("1", "x")) | "fails");
   write("indices(\"3-\", \"5\") = ", show(indices("3-", "5")) | "fails");
   write("*indices(\"1-100\") = ", *indices("1-100") | "fails")
end
