link strings
procedure drv_vowels(s)
   return charcnt(s, 'aeiouAEIOU')
end
procedure main()
   local s, n, t, msg;
   write("cat(\"ab\",\"cd\",\"ef\") = ", cat("ab", "cd", "ef"));
   write("cat() = ", image(cat()));
   write("cat(1,2,3) = ", cat(1, 2, 3));
   write("charcnt(\"banana\",'an') = ", charcnt("banana", 'an'));
   write("charcnt(\"banana\",'xyz') = ", charcnt("banana", 'xyz'));
   write("collate(\"abc\",\"def\") = ", collate("abc", "def"));
   write("collate(\"\",\"\") = ", image(collate("", "")));
   t := collate(repl("a", 130), repl("b", 130));
   write("collate(130a,130b): * = ", *t, " head = ", t[1:9], " tail = ", t[-8:0], " a-count = ", charcnt(t, 'a'));
   s := "";
   every s ||:= comb("abcd", 2) || " ";
   write("comb(\"abcd\",2) = ", s);
   s := "";
   every s ||:= comb("abcd", 3) || " ";
   write("comb(\"abcd\",3) = ", s);
   s := "";
   every s ||:= comb("abc", 1) || " ";
   write("comb(\"abc\",1) = ", s);
   write("comb(\"abc\",0) = ", comb("abc", 0) | "fails");
   write("compress(\"aaabbbccc   ddd\") = ", compress("aaabbbccc   ddd"));
   write("compress(\"aaabbbccc   ddd\",' ') = ", compress("aaabbbccc   ddd", ' '));
   write("compress(\"mississippi\",'s') = ", compress("mississippi", 's'));
   write("coprefix(\"abcde\",\"abcxy\",\"abz\") = ", image(coprefix("abcde", "abcxy", "abz")));
   write("coprefix(\"abc\",\"xyz\") = ", image(coprefix("abc", "xyz")));
   write("coprefix(\"solo\") = ", image(coprefix("solo")));
   write("coprefix() = ", coprefix() | "fails");
   write("cosuffix(\"testing\",\"running\",\"sing\") = ", image(cosuffix("testing", "running", "sing")));
   write("cosuffix(\"abc\",\"xyz\") = ", image(cosuffix("abc", "xyz")));
   write("cosuffix() = ", cosuffix() | "fails");
   write("csort(\"banana\") = ", csort("banana"));
   write("csort(\"hello world\") = ", image(csort("hello world")));
   write("decollate(\"abcdefg\") = ", decollate("abcdefg"));
   write("decollate(\"abcdefg\",2) = ", decollate("abcdefg", 2));
   write("decollate(\"abcdefg\",0) = ", decollate("abcdefg", 0));
   write("decollate(\"abcdefg\",3) = ", decollate("abcdefg", 3));
   write("deletec(\"banana\",'a') = ", deletec("banana", 'a'));
   write("deletec(\"banana\",'bn') = ", deletec("banana", 'bn'));
   write("deletep(\"abcdef\",[2,4]) = ", deletep("abcdef", [2, 4]));
   write("deletep(\"abcdef\",[6,1,3]) = ", deletep("abcdef", [6, 1, 3]));
   write("deletes(\"abcabcab\",\"ab\") = ", deletes("abcabcab", "ab"));
   write("deletes(\"hello\",\"xyz\") = ", deletes("hello", "xyz"));
   write("diffcnt(\"banana\") = ", diffcnt("banana"));
   write("diffcnt(\"\") = ", diffcnt(""));
   write("extend(\"abc\",8) = ", extend("abc", 8));
   write("extend(\"abc\",2) = ", extend("abc", 2));
   write("extend(\"\",5) = ", extend("", 5) | "fails");
   write("fchars(\"mississippi\") = ", fchars("mississippi"));
   write("fchars(\"abracadabra\") = ", fchars("abracadabra"));
   write("interleave(\"abcdef\",\"xy\") = ", interleave("abcdef", "xy"));
   write("ispal(\"racecar\") = ", ispal("racecar") | "fails");
   write("ispal(\"abc\") = ", ispal("abc") | "fails");
   write("ispal(\"\") = ", image(ispal("")) | "fails");
   write("maxlen([\"a\",\"abcd\",\"ab\"]) = ", maxlen(["a", "abcd", "ab"]));
   write("maxlen([]) = ", maxlen([]) | "fails");
   write("maxlen(L,drv_vowels) = ", maxlen(["sky", "banana", "queue"], drv_vowels));
   write("meander(\"01\",3) = ", meander("01", 3));
   write("meander(\"abc\",2) = ", meander("abc", 2));
   write("multicoll([\"abc\",\"def\",\"ghi\"]) = ", multicoll(["abc", "def", "ghi"]));
   write("ochars(\"banana\") = ", ochars("banana"));
   write("ochars(\"mississippi\") = ", ochars("mississippi"));
   write("odd_even(\"123456\") = ", odd_even("123456"));
   write("odd_even(\"1133\") = ", odd_even("1133"));
   write("odd_even(\"2468\") = ", odd_even("2468"));
   every n := 1 to 4 do {
      s := "";
      every s ||:= palins("ab", n) || " ";
      write("palins(\"ab\",", n, ") = ", s)
   };
   s := "";
   every s ||:= permutes("abc") || " ";
   write("permutes(\"abc\") = ", s);
   n := 0;
   every permutes("abcd") do n +:= 1;
   write("count permutes(\"abcd\") = ", n);
   write("pretrim(\"   hello  \") = ", image(pretrim("   hello  ")));
   write("pretrim(\"xxyhello\",'xy') = ", pretrim("xxyhello", 'xy'));
   every n := 0 to 3 do write("reflect(\"abc\",", n, ") = ", reflect("abc", n));
   write("reflect(\"abc\",,\"-\") = ", reflect("abc", , "-"));
   write("reflect(\"abc\",2,\"|\") = ", reflect("abc", 2, "|"));
   write("replace(\"the cat sat on the mat\",\"at\",\"og\") = ", replace("the cat sat on the mat", "at", "og"));
   write("replace(\"aaa\",\"a\",\"bb\") = ", replace("aaa", "a", "bb"));
   write("replace(\"abc\",\"\",\"x\") = ", replace("abc", "", "x") | "fails");
   write("replacem(\"abcdabcd\",\"a\",\"bc\",\"d\",\"cd\") = ", replacem("abcdabcd", "a", "bc", "d", "cd"));
   write("replc(\"abc\",[1,2,3]) = ", replc("abc", [1, 2, 3]));
   write("replc(\"xyz\",[0,3,1]) = ", replc("xyz", [0, 3, 1]));
   write("rotate(\"abcdef\") = ", rotate("abcdef"));
   write("rotate(\"abcdef\",2) = ", rotate("abcdef", 2));
   write("rotate(\"abcdef\",-2) = ", rotate("abcdef", -2));
   write("rotate(\"abcdef\",0) = ", rotate("abcdef", 0));
   write("rotate(\"abcdef\",8) = ", rotate("abcdef", 8));
   write("rotate(\"\",3) = ", image(rotate("", 3)));
   write("schars(\"banana\") = ", schars("banana"));
   write("schars(\"hello world\") = ", image(schars("hello world")));
   t := scramble("abcdefgh");
   write("scramble(\"abcdefgh\"): * = ", *t, " csort = ", csort(t));
   write("scramble(\"\") = ", image(scramble("")));
   write("csort(scramble(123)) = ", csort(scramble(123)));
   write("selectp(\"abcdef\",[1,3,5]) = ", selectp("abcdef", [1, 3, 5]));
   write("selectp(\"abcdef\",[6,6,1]) = ", selectp("abcdef", [6, 6, 1]));
   msg := "the quick brown fox jumps over the lazy dog and keeps running far away";
   every write("slugs(msg,20)> ", image(slugs(msg, 20)));
   every write("slugs(s,10)> ", image(slugs("aaaaaaaaaaaaaaaaaaaaaaaaa bb", 10)));
   every write("slugs(s,9,',')> ", image(slugs("one,two,three,four,five", 9, ',')));
   every write("slugs(short)> ", image(slugs("short text")));
   s := "";
   every t := starseq("ab") \ 10 do s ||:= image(t) || " ";
   write("starseq(\"ab\") \\ 10 = ", s);
   write("strcnt(\"ab\",\"abcabab\") = ", strcnt("ab", "abcabab"));
   write("strcnt(\"aa\",\"aaaaa\") = ", strcnt("aa", "aaaaa"));
   write("strcnt(\"\",\"abc\") = ", strcnt("", "abc") | "fails");
   s := "";
   every s ||:= substrings("abc") || " ";
   write("substrings(\"abc\") = ", s);
   s := "";
   every s ||:= substrings("abcd", 2, 3) || " ";
   write("substrings(\"abcd\",2,3) = ", s);
   write("transpose(\"abcdefgh\",\"12\",\"21\") = ", transpose("abcdefgh", "12", "21"));
   write("transpose(\"abcdefg\",\"123\",\"312\") = ", transpose("abcdefg", "123", "312"));
   s := "";
   every s ||:= image(words("  the quick\tbrown  fox ")) || " ";
   write("words(\"  the quick\\tbrown  fox \") = ", s);
   s := "";
   every s ||:= image(words("a,b,,c,", ',')) || " ";
   write("words(\"a,b,,c,\",',') = ", s);
   n := 0;
   every words("") do n +:= 1;
   write("words(\"\") count = ", n)
end
