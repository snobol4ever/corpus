link lists_lib
procedure main()
   local L, l, t, x, hello_list, n;
   L := file2lst("lists_lib.icn");
   write("file2lst(\"lists_lib.icn\")[3] = ", image(L[3]) | "fails");
   write("file2lst(\"no_such_file_zz.txt\") = ", image(file2lst("no_such_file_zz.txt")) | "fails");
   write("imag2lst(\"[1,2,3]\") = ", limage(imag2lst("[1,2,3]")));
   write("imag2lst(\"[4, 5.5, 6]\") = ", limage(imag2lst("[4, 5.5, 6]")));
   write("imag2lst(\"[]\") = ", limage(imag2lst("[]")));
   write("imag2lst(limage([7,8])) = ", limage(imag2lst(limage([7, 8]))));
   l := ["h", "e", "l", "l", "o", " ", "t", "t", "t", "h", "e", "r", "e"];
   l_Escan(l_Bscan(l), {
      hello_list := l_tab(l_match(["h", "e", "l", "l", "o"]));
      every writes(!hello_list);
      write();
      l_Escan(l_Bscan(l_tab(0)), {
         l_tab(l_many([[" "], ["t"]]) - 1);
         every writes(!l_tab(0));
         write()
         })
      });
   writes("l_find([\"t\", \"h\"], l, 1, 0):");
   every writes(" ", l_find(["t", "h"], l, 1, 0));
   write();
   writes("l_find([\"t\"], l, 1, 0):");
   every writes(" ", l_find(["t"], l, 1, 0));
   write();
   writes("l_upto([[\"t\"], [\"r\"]], l, 1, 0):");
   every writes(" ", l_upto([["t"], ["r"]], l, 1, 0));
   write();
   write("l_any([[\"h\"]], l, 1, 0) = ", l_any([["h"]], l, 1, 0) | "fails");
   write("l_any([[\"x\"]], l, 1, 0) = ", l_any([["x"]], l, 1, 0) | "fails");
   write("l_many([[\"h\"], [\"e\"], [\"l\"]], l, 1, 0) = ", l_many([["h"], ["e"], ["l"]], l, 1, 0) | "fails");
   write("l_match([\"h\", \"e\"], l, 1, 0) = ", l_match(["h", "e"], l, 1, 0) | "fails");
   write("l_match([\"e\"], l, 1, 0) = ", l_match(["e"], l, 1, 0) | "fails");
   x := ["(", "a", ")", ",", "b", ",", "c"];
   writes("l_bal([[\",\"]], [[\"(\"]], [[\")\"]], x, 1, 8):");
   every writes(" ", l_bal([[","]], [["("]], [[")"]], x, 1, 8));
   write();
   l_Escan(l_Bscan(["a", "b", "c", "d"]), {
      write("l_pos(1): ", if l_pos(1) then "yes" else "no");
      write("l_move(2) = ", limage(l_move(2)));
      write("l_pos(3): ", if l_pos(3) then "yes" else "no");
      write("l_move(5): ", if l_move(5) then "yes" else "no");
      write("l_tab(0) = ", limage(l_tab(0)));
      write("l_pos(0): ", if l_pos(0) then "yes" else "no");
      write("l_tab(2) = ", limage(l_tab(2)));
      write("l_move(-1) = ", limage(l_move(-1)))
      });
   write("lclose([1,2,3]) = ", limage(lclose([1, 2, 3])));
   write("lclose([1,2,1]) = ", limage(lclose([1, 2, 1])));
   writes("lcomb([1,2,3,4], 2):");
   every writes(" ", limage(lcomb([1, 2, 3, 4], 2)));
   write();
   write("lcomb([1,2], 0) = ", limage(lcomb([1, 2], 0)) | "fails");
   write("lcompact([10,30,20,10]) = ", limage(lcompact([10, 30, 20, 10])));
   t := ldecollate([1, 2], [1, 2, 3, 4, 5]);
   write("ldecollate([1,2], [1,2,3,4,5]) has ", *t, " lists: ", limage(t[1]), " ", limage(t[2]));
   write("ldelete([\"a\",\"b\",\"c\",\"d\",\"e\"], \"2,4\") = ", limage(ldelete(["a", "b", "c", "d", "e"], "2,4")) | "fails");
   write("ldelete([1,2,3], \"0\") = ", limage(ldelete([1, 2, 3], "0")) | "fails");
   write("ldelete([1,2,3,4,5], \"2-\") = ", limage(ldelete([1, 2, 3, 4, 5], "2-")) | "fails");
   write("ldupl([1,2], 2) = ", limage(ldupl([1, 2], 2)));
   write("ldupl([1,2], [1,3]) = ", limage(ldupl([1, 2], [1, 3])));
   write("lequiv([1,[2,3]], [1,[2,3]]) ", if lequiv([1, [2, 3]], [1, [2, 3]]) then "succeeds" else "fails");
   write("lequiv([1,2], [1,3]) ", if lequiv([1, 2], [1, 3]) then "succeeds" else "fails");
   write("levate([1,2,3,4,5,6], 3, 9) = ", limage(levate([1, 2, 3, 4, 5, 6], 3, 9)));
   write("lextend([1,2,3], 7) = ", limage(lextend([1, 2, 3], 7)) | "fails");
   write("lextend([], 3) = ", limage(lextend([], 3)) | "fails");
   write("lfliph([1,2,3]) = ", limage(lfliph([1, 2, 3])));
   write("lfliph([\"x\",\"y\"]) = ", limage(lfliph(["x", "y"])));
   write("lflipv([1,2,3]) = ", limage(lflipv([1, 2, 3])));
   write("lflipv([2,5,1,4]) = ", limage(lflipv([2, 5, 1, 4])));
   write("limage([1,\"a\",2.5,&null]) = ", limage([1, "a", 2.5, &null]));
   write("limage([]) = ", limage([]));
   writes("lindex([1,2,1,3,1], 1):");
   every writes(" ", lindex([1, 2, 1, 3, 1], 1));
   write();
   write("lcollate([1,2,3],[4,5],[6,7,8]) = ", limage(lcollate([1, 2, 3], [4, 5], [6, 7, 8])));
   write("lconstant([2,2,2]) = ", lconstant([2, 2, 2]) | "fails");
   write("lconstant([1,2]) = ", lconstant([1, 2]) | "fails");
   write("linterl([1,2,3], [\"a\",\"b\"]) = ", limage(linterl([1, 2, 3], ["a", "b"])) | "fails");
   write("llayer([1,2], [1,2]) = ", limage(llayer([1, 2], [1, 2])));
   write("llayer([3,1,2], [2,1]) = ", limage(llayer([3, 1, 2], [2, 1])));
   write("llpad([1,2], 4, 0) = ", limage(llpad([1, 2], 4, 0)));
   write("lltrim([0,0,1,0], set([0])) = ", limage(lltrim([0, 0, 1, 0], set([0]))));
   write("lmap([1,2,3,4], [4,3,2,1], [\"a\",\"b\",\"c\",\"d\"]) = ", limage(lmap([1, 2, 3, 4], [4, 3, 2, 1], ["a", "b", "c", "d"])));
   write("lmap([1,5], [1], [\"x\"]) = ", limage(lmap([1, 5], [1], ["x"])));
   write("lpalin([1,2,3]) = ", limage(lpalin([1, 2, 3])));
   write("lpalin([1,2,3], 1) = ", limage(lpalin([1, 2, 3], 1)));
   writes("lpermute([1,2,3]):");
   every writes(" ", limage(lpermute([1, 2, 3])));
   write();
   every n := &null | 0 | 1 | 2 | 3 do
      write("lreflect([1,2,3], ", image(n), ") = ", limage(lreflect([1, 2, 3], n)));
   write("lremvals([1,2,3,2,4], 2, 4) = ", limage(lremvals([1, 2, 3, 2, 4], 2, 4)));
   write("lrepl([1,2], 3) = ", limage(lrepl([1, 2], 3)));
   write("lresidue([7,8,9,10], 3) = ", limage(lresidue([7, 8, 9, 10], 3)));
   write("lresidue([7,8,9], 3, 1) = ", limage(lresidue([7, 8, 9], 3, 1)));
   write("lreverse([1,2,3,4]) = ", limage(lreverse([1, 2, 3, 4])));
   write("lrotate([1,2,3,4]) = ", limage(lrotate([1, 2, 3, 4])));
   write("lrotate([1,2,3,4], -1) = ", limage(lrotate([1, 2, 3, 4], -1)));
   write("lrotate([1,2,3,4], 2) = ", limage(lrotate([1, 2, 3, 4], 2)));
   write("lrpad([1], 3, \"x\") = ", limage(lrpad([1], 3, "x")));
   write("lrundown([5], [1], [2]) = ", limage(lrundown([5], [1], [2])));
   write("lrundown([3], [1]) = ", limage(lrundown([3], [1])));
   write("lrunup([1], [5]) = ", limage(lrunup([1], [5])));
   write("lrunup([1], [3,5]) = ", limage(lrunup([1], [3, 5])));
   write("lrunup([1,10], [4], [2,3]) = ", limage(lrunup([1, 10], [4], [2, 3])));
   write("lrtrim([1,0,0], set([0])) = ", limage(lrtrim([1, 0, 0], set([0]))));
   write("lshift([1,2,3], 10) = ", limage(lshift([1, 2, 3], 10)));
   write("lst2str([\"ab\",\"c\",1]) = ", image(lst2str(["ab", "c", 1])));
   write("lswap([1,2,3,4]) = ", limage(lswap([1, 2, 3, 4])));
   write("lswap([1,2,3]) = ", limage(lswap([1, 2, 3])));
   write("lunique([1,2,1,3,2]) = ", limage(lunique([1, 2, 1, 3, 2])));
   write("lmaxlen([\"a\",\"abc\",\"ab\"]) = ", lmaxlen(["a", "abc", "ab"]) | "fails");
   write("lminlen([\"a\",\"abc\",\"ab\"]) = ", lminlen(["a", "abc", "ab"]) | "fails");
   write("lmaxlen([3,-7,2], abs) = ", lmaxlen([3, -7, 2], abs) | "fails");
   write("lminlen([3,-7,2], abs) = ", lminlen([3, -7, 2], abs) | "fails");
   write("lmaxlen([]) = ", lmaxlen([]) | "fails");
   t := table();
   t["b"] := 2;
   t["a"] := 3;
   t["c"] := 1;
   write("sortkeys(sort(t, 3)) = ", limage(sortkeys(sort(t, 3))));
   write("sortvalues(sort(t, 3)) = ", limage(sortvalues(sort(t, 3))));
   write("sortkeys(sort(t, 4)) = ", limage(sortkeys(sort(t, 4))));
   write("sortvalues(sort(t, 4)) = ", limage(sortvalues(sort(t, 4))));
   write("str2lst(\"abcdefg\", 3) = ", limage(str2lst("abcdefg", 3)));
   write("str2lst(\"abc\") = ", limage(str2lst("abc")));
   write("str2lst(\"\") = ", limage(str2lst("")))
end
