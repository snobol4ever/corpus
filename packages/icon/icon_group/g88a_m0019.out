Invalid input line "procedure binrep(n)"
Invalid input line "# Compute the binary representation of n (as a string)"
Invalid input line "    local retval;"
Invalid input line "    retval := \"\";"
Invalid input line "    while n > 0 do {"
Invalid input line "        retval := n % 2 || retval;"
Invalid input line "        n /:= 2"
Invalid input line "        };"
Invalid input line "    return retval;"
Invalid input line "end"
Invalid input line ""
Invalid input line "procedure power(a, bbits)"
Invalid input line "# Compute a to the power bbits, where bbits is a bit string."
Invalid input line "# The result is a list of coefficients for the polynomial a(i)*k^i,"
Invalid input line "# least significant values first, with k=10000 and zero trailing coefficient"
Invalid input line "# deleted."
Invalid input line "    local b, m1, retval;"
Invalid input line "    m1 := (if a >= 10000 then [a % 10000, a / 10000] else [a]);"
Invalid input line "    retval := [1];"
Invalid input line "    every b := !bbits do {"
Invalid input line "        (retval := product(retval, retval)) | fail;"
Invalid input line "        if b == \"1\" then"
Invalid input line "            (retval := product(retval, m1)) | fail"
Invalid input line "        };"
Invalid input line "    return retval;"
Invalid input line "end"
Invalid input line ""
Invalid input line "procedure product(a,b)"
Invalid input line "# Compute a*b as a polynomial in the same form as for power."
Invalid input line "# a and b are also polynomials in this form."
Invalid input line "    local i, j, k, retval, x;"
Invalid input line "    if *a + *b > 5001 then"
Invalid input line "        fail;"
Invalid input line "    retval := list(*a + *hv);"
Invalid input line "    every i := 1 to *a do"
Invalid input line "        every j := 1 to *b do {"
Invalid input line "            k := i + j - 1;"
Invalid input line "            retval[k] +:= a[i] * b[j];"
Invalid input line "            while (x := retval[k]) >= 10000 do {"
Invalid input line "                retval[k + 1] +:= x / 10000;"
Invalid input line "                retval[k] %:= 10000;"
Invalid input line "                k +:= 1"
Invalid input line "            }   };"
Invalid input line "    every i := *retval to 1 by -1 do"
Invalid input line "        if retval[i] > 0 then"
Invalid input line "            break;"
Invalid input line "    return retval[1+:i];"
Invalid input line "end"
Invalid input line ""
Invalid input line "procedure print_it(n)"
Invalid input line "    local ds, i, j, k;"
Invalid input line "    ds := \"\";"
Invalid input line "    every k := *n to 1 by -1 do"
Invalid input line "        ds ||:= right(n[k], 4, \"0\");"
Invalid input line "    ds ?:= (tab(many(\"0\")), tab(0));"
Invalid input line "    ds := repl(\"0\", 4 - (*ds - 1) % 5) || ds;"
Invalid input line ""
Invalid input line "    every i := 1 to *ds by 50 do {"
Invalid input line "        k := *ds > i + 45 | *ds;"
Invalid input line "        every j := i to k by 5 do"
Invalid input line "            writes(ds[j+:5], \" \");"
Invalid input line "        write()"
Invalid input line "        };"
Invalid input line "    writes(\"\\n\\n\");"
Invalid input line "end"
