procedure main()
every write(strip_comments(!&input));
end
procedure strip_comments(s)
local i, j;
s ?:= (tab(many(' \t')), tab(0));
s ? {
match("#") & fail;
(s2 <- tab(find("#"))) ? {
i := j := 0;
while tab(upto('"\'')) do {
case move(1) of {
"\""    : {
i +:= 1;
if tab(find("\"")+1)
then i +:= 1
else tab(find("\'")+1) | break
};
"\'"    : {
j +:= 1;
if tab(find("\'")+1)
then j +:= 1
else tab(find("\"")+1) | break
}
}
};
i % 2 = 0 & j % 2 = 0
};
return "" ~== trim((\s2 | .&subject) \ 1, ' \t')
};
end
