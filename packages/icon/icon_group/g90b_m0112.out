procedure main()
  while line := read() do {
    line[ 1(x<-find("#",line),notquote(line[1:x])) : 0] := "";
    write(trim(line))
  };
end



procedure notquote(s)
  outs := "";



  s ? {
    while outs ||:= tab(find("\\")+1) do move(1);
    outs ||:= tab(0)
  };

  outs ? {
    while s := tab(find("\""|"'")+1) do {
	if not tab(find(s[-1])+1) then fail
    }
  };
  return;
end
