1:  procedure main()   count := 0; extrabit := "";   while line := !&input do {     if line == "" ~== extrabit then {       write(string(count+:=1),":  ",extrabit);       extrabit := "";       next       }     else line := extrabit || line;     line ? {       while sentence := TabSentence()       do write(string(count+:=1),":  ",sentence);       extrabit := tab(0);       if extrabit[-1] ~== "-"       then extrabit ||:= " "       }     }; end 
2:  procedure TabSentence()   return {     End2Front() ||     tab(upto('!.?')+1) ||     (tab(many('\'"()[]')) | &null, "") ||     ((pos(0), "") | ="  ")     }; end 
