        DEFINE("dotp(a,b)sum,i")        :(dotp_end)
dotp    i = 1; sum = 0
loop    sum = sum + (a[i] * b[i])
        i = i + 1 ?a[i] :S(loop)
        dotp = sum      :(RETURN)
dotp_end

        a = ARRAY(3); a[1] = 1; a[2] = 3; a[3] = -5;
        b = ARRAY(3); b[1] = 4; b[2] = -2; b[3] = -1;
        OUTPUT = dotp(a,b)
END
