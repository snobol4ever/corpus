        OUTPUT(.file,1,'output.txt');  ENDFILE(1)  ;* Macro Spitbol
*       output(.file,1,,'output.txt'); endfile(1)  ;* CSnobol
        HOST(1,'mkdir docs')

        OUTPUT(.file,1,'/output.txt');  ENDFILE(1) ;* Macro Spitbol
*       output(.file,1,,'/output.txt'); endfile(1) ;* CSnobol
        HOST(1,'mkdir /docs')
END
