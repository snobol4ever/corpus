*----------------------------------------------------------------- 8 even-or-odd
      DEFINE('even(n)')                         :(even_end)
even  even = (EQ(REMDR(n, 2), 0) 'even', 'odd') :(RETURN)
even_end

      OUTPUT = "-2 is " even(-2)
      OUTPUT = "-1 is " even(-1)
      OUTPUT = "0 is " even(0)
      OUTPUT = "1 is " even(1)
      OUTPUT = "2 is " even(2)
END
*------------------------------------------ 9 find-the-intersection-of-two-lines
              DEFINE("findInter(l1x1,l1y1,l1x2,l1y2,l2x1,l2y1,l2x2,l2y2)")
              ret = ARRAY("2")                                              :(findInter_END)
findInter     l1m = (l1y1 - l1y2) / (l1x1 - l1x2) * 1.0
              l2m = (l2y1 - l2y2) / (l2x1 - l2x2) * 1.0
*Multiply 1.0 to convert it to float
              EQ(l1m,l2m)                                                    :F(not_parallel)
              findInter = "No intersection(parallel)"                       :(RETURN)
not_parallel  ret<1> = (l2m * l2x1 - l1m * l1x1 + l1y1 - l2y1) / (l2m - l1m)
              ret<2> = l1m * (ret<1> - l1x1) + l1y1
              findInter = "(" ret<1> "," ret<2> ")"                         :(RETURN)
findInter_END

              OUTPUT = findInter(4,0,6,10,0,3,10,7)
END
*------------------------------------------------------------------- 10 fizzbuzz
        I = 1
LOOP    FIZZBUZZ = ""
        EQ(REMDR(I, 3), 0)              :F(TRY_5)
        FIZZBUZZ = FIZZBUZZ "FIZZ"
TRY_5   EQ(REMDR(I, 5), 0)              :F(DO_NUM)
        FIZZBUZZ = FIZZBUZZ "BUZZ"
DO_NUM  IDENT(FIZZBUZZ, "")             :F(SHOW)
        FIZZBUZZ = I
SHOW    OUTPUT = FIZZBUZZ
        I = I + 1
        LE(I, 100)                      :S(LOOP)
END
