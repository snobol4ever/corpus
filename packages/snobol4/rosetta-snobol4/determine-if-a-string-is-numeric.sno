        DEFINE('nchk(str)') :(nchk_end)
nchk    CONVERT(str,'real') :S(RETURN)F(FRETURN)
nchk_end

*       # Wrapper for testing
        DEFINE('isnum(str)') :(isnum_end)
isnum   isnum = 'F'; isnum = nchk(str) 'T'
        isnum = isnum ': ' str :(RETURN)
isnum_end

*       # Test and display
        OUTPUT = isnum('123')
        OUTPUT = isnum('123.0')
        OUTPUT = isnum('123.')
        OUTPUT = isnum('-123')
        OUTPUT = isnum('3.14159')
        OUTPUT = isnum('1.2.3')
        OUTPUT = isnum('abc')
        OUTPUT = isnum('A440')
END
