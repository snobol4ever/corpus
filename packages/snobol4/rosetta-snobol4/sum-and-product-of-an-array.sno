          t = TABLE()
* read the integer from the std. input
init_tab  t[x = x + 1] = TRIM(INPUT)    :S(init_tab)
          product = 1
          sum = 0

* counting backwards to 1
loop      i = t[ x = ?GT(x,1) x - 1]	:F(out)
          sum = sum + i
          product = product * i         :(loop)
out       OUTPUT = "Sum:  " sum
          OUTPUT = "Prod: " product
END
