*       # Fill arrays
        keys = ARRAY(5); vals = ARRAY(5)
        ks = 'ABCDE'; vs = '12345'
kloop   i = i + 1; ks LEN(1) . keys[i] = :S(kloop)
vloop   j = j + 1; vs LEN(1) . vals[j] = :S(vloop)

*       # Create hash
        hash = TABLE(5)
hloop   k = k + 1; hash[keys[k]] = vals[k] :S(hloop)

*       # Test and display
        ts = 'ABCDE'
tloop   ts LEN(1) . ch = :F(out)
        str = str ch ':' hash[ch] ' ' :(tloop)
out     OUTPUT = str
END
