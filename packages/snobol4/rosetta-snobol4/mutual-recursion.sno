        DEFINE('f(n)') :(f_end)
f       f = EQ(n,0) 1 :S(RETURN)
        f = n - m(f(n - 1)) :(RETURN)
f_end

        DEFINE('m(n)') :(m_end)
m       m = EQ(n,0) 0 :S(RETURN)
        m = n - f(m(n - 1)) :(RETURN)
m_end

*       # Test and display
L1      s1 = s1 m(i) ' ' ; s2 = s2 f(i) ' '
        i = LE(i,25) i + 1 :S(L1)
        OUTPUT = 'M: ' s1; OUTPUT = 'F: ' s2
END
