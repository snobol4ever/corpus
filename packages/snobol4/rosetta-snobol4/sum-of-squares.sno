        DEFINE('ssq(a)i') :(ssq_end)
ssq     i = i + 1; ssq = ssq + (a[i] * a[i]) :S(sumsq)F(RETURN)
ssq_end

*       # Fill array, test and display
        str = '1 2 3 5 7 11 13 17 19 23'; a = ARRAY(10)
loop    i = i + 1; str LEN(p) SPAN('0123456789') . a[i] @p :S(loop)
        OUTPUT = str ' -> ' sumsq(a)
END
