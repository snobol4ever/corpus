        DEFINE('leap(yr)')  :(end_leap)
leap    EQ(REMDR(yr,400),0) :S(RETURN)
        EQ(REMDR(yr,100),0) :S(FRETURN)
    	EQ(REMDR(yr,4),0)   :S(RETURN)F(FRETURN)
end_leap

*       # Test and display (with ?: kluge)
        test = "output = ('10' ? (*leap(yr) 1 | 0)) ': ' yr"
        yr = '1066'; EVAL(test)
        yr = '1492'; EVAL(test)
        yr = '1900'; EVAL(test)
        yr = '2000'; EVAL(test)
END
