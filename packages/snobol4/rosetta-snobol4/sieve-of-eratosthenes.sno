        DEFINE('sieve(n)i,j,k,p,str,res') :(sieve_end)
sieve   i = LT(i,n - 1) i + 1 :F(sv1)
        str = str (i + 1) ' ' :(sieve)
sv1     str BREAK(' ') . j SPAN(' ') = :F(RETURN)
        sieve = sieve j ' '
        sieve = GT(j ^ 2,n) sieve str :s(return) ;* Opt1
        res = ''
        str (ARB ' ') @p ((j ^ 2) ' ') ;* Opt2
        str LEN(p) . res = ;* Opt2
sv2     str BREAK(' ') . k  SPAN(' ') = :F(sv3)
        res = NE(REMDR(k,j),0) res k ' ' :(sv2)
sv3     str = res :(sv1)
sieve_end

*       # Test and display
        OUTPUT = sieve(100)
END
