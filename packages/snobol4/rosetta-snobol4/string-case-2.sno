        DEFINE('UC(STR)')
        DEFINE('LC(STR)')
        DEFINE('UCFIRST(STR)')
        DEFINE('SWAPC(STR)')                               :(CASES.END)
UC      uc = REPLACE(str,&LCASE,&UCASE)                    :(RETURN)
LC      lc = REPLACE(str,&UCASE,&LCASE)                    :(RETURN)
UCFIRST str LEN(1) . ch = uc(ch) ; ucfirst = str           :(RETURN)
SWAPC   swapc = REPLACE(str, &UCASE &LCASE, &LCASE &UCASE) :(RETURN)
CASES.END

*       # Test and display
        str = 'alphaBETA'
        OUTPUT = str
        OUTPUT = lc(str)
        OUTPUT = uc(str)
        OUTPUT = ucfirst(str)
        OUTPUT = swapc(str)
END
