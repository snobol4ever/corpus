*       # Encode RLE
        DEFINE('rle(str)c,n') :(rle_end)
rle     str LEN(1) . c :F(RETURN)
        str SPAN(c) @n =
        rle = rle n c :(rle)
rle_end

*       # First m members of sequence with seed n
        DEFINE('looksay(n,m)') :(looksay_end)
looksay OUTPUT = n; m = GT(m,1) m - 1 :F(RETURN)
        n = rle(n) :(looksay)
looksay_end

*       Test and display
        looksay(1,10)
END
