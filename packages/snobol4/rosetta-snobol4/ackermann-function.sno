DEFINE('ack(m,n)') :(ack_end)
ack     ack = EQ(m,0) n + 1 :S(RETURN)
        ack = EQ(n,0) ack(m - 1,1) :S(RETURN)
        ack = ack(m - 1,ack(m,n - 1)) :(RETURN)
ack_end

*       # Test and display ack(0,0) .. ack(3,6)
L1      str = str ack(m,n) ' '
        n = LT(n,6) n + 1 :S(L1)
        OUTPUT = str; str = ''
        n = 0; m = LT(m,3) m + 1 :S(L1)
END
