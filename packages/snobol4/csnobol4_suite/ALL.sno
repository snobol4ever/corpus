d79	 :(alldone)
	 eject
*
*	 error handling	routine
*
error	 output	= '****** error	detected at ' &lastno '	********'
	 errcount = errcount + 1
	 output	= '***** resuming execution *******'	   :(return)
*
*	 termination routine
*
alldone
	 errcount = errcount + &errlimit - 100
	 &errlimit = 100
	 output	= eq(errcount,0)
.		  '****		  no errors detected	     ****'
	 output	= '**********************************************'
	 &fullscan = eq(&fullscan,0) 1		 :s(floop)
	 output	= '****		  end of diagnostics	     ****'
	 output	= '**********************************************'
end
