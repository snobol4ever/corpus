<<< NO SYNTACTIC ERROR >>>

     FILL_HOLE
     .             DATA<HOLE_IN_TREE> = HOLD_LOCATION
     .                                                :($RETURN_FROM_SIFT)
<<< NO SYNTACTIC ERROR >>>

     END
