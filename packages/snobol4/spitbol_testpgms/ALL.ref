  CARD ABOVE IS ILLEGAL
              NUMBER_IN_TREE = GT(NUMBER_IN_TREE,1)
  CARD ABOVE IS ILLEGAL
.                               NUMBER_IN_TREE - 1
  CARD ABOVE IS ILLEGAL
.                                                :S(SIFT_NODE)F(RETURN)
  CARD ABOVE IS ILLEGAL
-EJECT
  CARD ABOVE IS ILLEGAL
SIFT_NODE
  CARD ABOVE IS ILLEGAL
.             FATHER = NODE_TO_SIFT
  CARD ABOVE IS ILLEGAL
PULL_UP_LARGER_SON
  CARD ABOVE IS ILLEGAL
.             LEFT_SON = FATHER * 2
  CARD ABOVE IS ILLEGAL
              LT(LEFT_SON,NUMBER_IN_TREE)        :S(COMPARE_SONS)
  CARD ABOVE IS ILLEGAL
              EQ(LEFT_SON,NUMBER_IN_TREE)        :S(LEFT_SON_HIGH)
  CARD ABOVE IS ILLEGAL
                                                 :(CHECK_FATHERS)
  CARD ABOVE IS ILLEGAL
COMPARE_SONS
  CARD ABOVE IS ILLEGAL
.             RIGHT_SON = LEFT_SON + 1
  CARD ABOVE IS ILLEGAL
