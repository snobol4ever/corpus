<<< NO SYNTACTIC ERROR >>>

                   LT(LEFT_SON,NUMBER_IN_TREE)        :S(COMPARE_SONS)
<<< NO SYNTACTIC ERROR >>>

                   EQ(LEFT_SON,NUMBER_IN_TREE)        :S(LEFT_SON_HIGH)
<<< NO SYNTACTIC ERROR >>>

                                                      :(CHECK_FATHERS)
<<< NO SYNTACTIC ERROR >>>

     COMPARE_SONS
     .             RIGHT_SON = LEFT_SON + 1
<<< NO SYNTACTIC ERROR >>>

                   LGT(DATA<LEFT_SON>,DATA<RIGHT_SON>)
     .                                                :S(LEFT_SON_HIGH)
<<< NO SYNTACTIC ERROR >>>

     RIGHT_SON_HIGH
