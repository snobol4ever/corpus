     ./*
     -TITLE SPITBOL TEST PROGRAM #6 -- TOPOLOGICAL SORT
     *
     *        TOPOLOGICAL SORT
     *
     *   MAPS A PARTIAL ORDERING OF OBJECTS INTO A LINEAR ORDERING
     *
     *        A(1), A(2), ..., A(N)
     *
     *   SUCH THAT IF   A(S) < A(T) IN THE PARTIAL ORDERING,THEN S < T.
     *   (CF. D.E.KNUTH, THE ART OF COMPUTER PROGRAMMING,VOLUME 1,
     *   ADDISON-WESLEY,MASS.,1968, P.262)
     *
<<< NO SYNTACTIC ERROR >>>

              &DUMP = 2
<<< NO SYNTACTIC ERROR >>>

              OUTPUT('OUT',6,'(121A1)')
<<< NO SYNTACTIC ERROR >>>

              PAIR      = BREAK('<') . MU LEN(1) BREAK(',') . NU LEN(1)
<<< NO SYNTACTIC ERROR >>>

              DATA('ITEM(COUNT,TOP)')
<<< NO SYNTACTIC ERROR >>>

              DATA('NODE(SUC,NEXT)')
<<< NO SYNTACTIC ERROR >>>

              DEFINE('DECR(X)')
<<< NO SYNTACTIC ERROR >>>

              DEFINE('INDEX(TAU)')
<<< NO SYNTACTIC ERROR >>>

              INPUT(.INPUT,,72)
     *
     *     READ IN THE NUMBER OF ITEMS, N, AND GENERATE AN ARRAY OF ITEMS.
     *
     *   EACH ITEM HAS TWO FIELDS, (COUNT,TOP), WHERE
     *        COUNT = NO. OF ELEMENTS PRECEEDING IT.
<<< NO SYNTACTIC ERROR >>>

              TOP = TOP OF LIST OF ITEMS SUCCEEDING IT.
     *
<<< NO SYNTACTIC ERROR >>>

              N         = TRIM(INPUT)
<<< NO SYNTACTIC ERROR >>>

              X         = ARRAY('0:' N)
     *   INITIALIZE THE ITEMS TO (0,NULL).
     *
<<< NO SYNTACTIC ERROR >>>

     T1       X<I>      =  ITEM(0,)              :F(T1A)
<<< NO SYNTACTIC ERROR >>>

              I         =  I + 1                 :(T1)
     *
     *   READ IN RELATIONS.
     *
<<< NO SYNTACTIC ERROR >>>

     T1A      OUT       = '1 THE RELATIONS ARE:'
<<< NO SYNTACTIC ERROR >>>

     T2A      REL       = TRIM(INPUT) ','        :F(T3A)
<<< NO SYNTACTIC ERROR >>>

              OUTPUT    = REL
<<< NO SYNTACTIC ERROR >>>

     T2       REL       PAIR  =                  :F(T2A)
<<< NO SYNTACTIC ERROR >>>

              J         = INDEX(MU)
<<< NO SYNTACTIC ERROR >>>

              K         = INDEX(NU)
     *
     *   SINCE MU < NU, INCREASE THE COUNT OF THE KTH ITEM AND ADD A
     *   NODE TO THE LIST OF SUCCESSORS OF THE JTH ITEM.
     *
<<< NO SYNTACTIC ERROR >>>

     T3       COUNT(X<K>) = COUNT(X<K>) + 1
<<< NO SYNTACTIC ERROR >>>

              TOP(X<J>) = NODE(K,TOP(X<J>))      :(T2)
     -EJECT
     *
     *    A QUEUE IS MAINTAINED OF THOSE ITEMS WITH ZERO COUNT FIELD.
     *    THE LINKS FOR THE QUEUE, QLINK, ARE KEPT IN THE COUNT FIELD.
     *    THE VARIABLES F,R POINT TO THE FRONT AND REAR OF THE QUEUE.
     *
<<< NO SYNTACTIC ERROR >>>

     T3A      OPSYN('QLINK','COUNT')
     *
     *    INITIALIZE THE QUEUE FOR OUTPUT.
     *
<<< NO SYNTACTIC ERROR >>>

              R         = 0
<<< NO SYNTACTIC ERROR >>>

              QLINK(X<0>) = 0
<<< NO SYNTACTIC ERROR >>>

              K         = 0
<<< NO SYNTACTIC ERROR >>>

     T4       K         = ?X<K + 1>  K + 1       :F(T4A)
<<< NO SYNTACTIC ERROR >>>

              QLINK(X<R>) = EQ(COUNT(X<K>),0)  K :F(T4)
<<< NO SYNTACTIC ERROR >>>

              R         = K                      :(T4)
<<< NO SYNTACTIC ERROR >>>

     T4A      F         = QLINK(X<0>)
     *
     *    OUTPUT THE FRONT OF THE QUEUE.
     *
<<< NO SYNTACTIC ERROR >>>

              OUT       = '0 THE LINEAR ORDERING IS:'
<<< NO SYNTACTIC ERROR >>>

     T5       OUTPUT    = NE(F,0)  $(F ':')      :F(T8)
<<< NO SYNTACTIC ERROR >>>

              N         = N - 1
<<< NO SYNTACTIC ERROR >>>

              P         = TOP(X<F>)
     *    ERASE RELATIONS.
<<< NO SYNTACTIC ERROR >>>

     T6       IDENT(P)                           :S(T7)
<<< NO SYNTACTIC ERROR >>>

              DECR(.COUNT(X<SUC(P)>))            :S(T6A)
     *
     *    IF COUNT IS ZERO ADD  ITEM TO QUEUE.
     *
<<< NO SYNTACTIC ERROR >>>

              QLINK(X<R>) = SUC(P)
<<< NO SYNTACTIC ERROR >>>

              R         = SUC(P)
<<< NO SYNTACTIC ERROR >>>

     T6A      P         = NEXT(P)                :(T6)
     *
     *    REMOVE FROM QUEUE.
     *
<<< NO SYNTACTIC ERROR >>>

     T7       F         = QLINK(X<F>)            :(T5)
     *
     *    FUNCTION DEFINITIONS.
     *
<<< NO SYNTACTIC ERROR >>>

     DECR     $X        = GT($X,1)  $X - 1       :S(RETURN)
<<< NO SYNTACTIC ERROR >>>

              $X        = 0                      :(FRETURN)
     *
<<< NO SYNTACTIC ERROR >>>

     INDEX    INDEX     = DIFFER($(TAU ':'))  $(TAU ':')  :S(RETURN)
<<< NO SYNTACTIC ERROR >>>

              TERMCT    = LT(TERMCT,N)  TERMCT + 1    :F(FRETURN)
<<< NO SYNTACTIC ERROR >>>

              INDEX     = TERMCT
<<< NO SYNTACTIC ERROR >>>

              $(TERMCT ':')   =  TAU
<<< SYNTACTIC ERROR >>>

              $(TAU ':')   =  TERMCT             :(RETURN)
     *
<<< SYNTACTIC ERROR >>>

     T8       OUTPUT    = NE(N,0) 'THE ORDERING CONTAINS A LOOP.'
<<< NO SYNTACTIC ERROR >>>

     END
<<< NO SYNTACTIC ERROR >>>

