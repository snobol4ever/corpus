*---------------------------------------------------------------------- 1 arcget
extracting extract1.txt
extracting extract2.txt
the first extracted line
the second extracted line
the only line of the second file
*---------------------------------------------------------------------- 2 arcput
!@#$hello.spt
   OUTPUT = 'Hello World'
END
!@#$hi.spt
	OUTPUT = 'hello dave'
END
END
*--------------------------------------------------------------------------- 3 c
program demo;
{ a block comment opens here
  a starred line inside it
  an indented line inside it
}
begin
  writeln(1)
end.
*-------------------------------------------------------------------------- 4 cc
int count; // the counter 
// a whole-line comment 
int total;
x = y; // swap later 
*--------------------------------------------------------------------------- 5 d
    1 this  $
    1 next  program demo;$
    1 

    2 this  program demo;$
    2 next  $
    2 
program demo;
    3 this  $
    3 next  *$
    3 

    4 this  *$
    4 next  { a block comment opener on its own line$
    4 

    5 this  { a block comment opener on its own line$
    5 next  * a starred line inside the block$
    5 
{ a block comment opener on its own line
    6 this  * a starred line inside the block$
    6 next    an indented line inside the block$
    6 
* a starred line inside the block
    7 this    an indented line inside the block$
    7 next  }$
    7 
  an indented line inside the block
    8 this  }$
    8 next  begin$
    8 
}
    9 this  begin$
    9 next  end.$
    9 
