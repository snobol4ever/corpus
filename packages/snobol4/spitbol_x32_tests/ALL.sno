*------------------------------------------------------------------------ 15 rev
	optab = TABLE()
	&ANCHOR = &TRIM = 1
	optab['mov'] = 1
	optab['add'] = 1
	optab['sub'] = 1
*	optab['aov'] = 1
	optab['orb'] = 1
	optab['anb'] = 1
	optab['xob'] = 1
				:(loop)
COPY
 	OUTPUT = LINE
loop
	LINE = INPUT				:f(finis)
	lines = lines + 1
	IDENT(LINE)				:s(COPY)
	LINE '*'				:s(COPY)
	LINE '{'				:s(block)
	LINE ? LEN(7) . p1 LEN(3) . opc '  ' BREAK(',') . a1 ',' BREAK(' ') . a2 ' ' REM . rest :f(stmt1)
	IDENT(optab[opc])			:s(COPY)
	OUTPUT = p1 opc '  ' a2 ',' a1 ' ' rest
						:(loop)
stmt1
*	look for operation with no trailing comment
	LINE ? LEN(7) . p1 LEN(3) . opc '  ' BREAK(',') . a1 ',' REM . a2 :f(COPY)
	IDENT(optab[opc])			:s(COPY)
*	output = 'no comment'
*	output = 'old' char(9) line
*	output = 'new ' char(9) p1 opc '  ' a2 ',' a1 
	OUTPUT = p1 opc '  ' a2 ',' a1 		:(loop)
block
*	here in block comment, just copy until closer seen
 	OUTPUT = LINE
bloop
	LINE = INPUT				:f(finis)
	LINE '}'				:f(block)s(COPY)

finis
END
*------------------------------------------------------------------------ 16 tbl
	&ANCHOR = &TRIM = 1

loop
	LINE = INPUT		:f(END)
	LINE BREAK(' ') . sec SPAN(' ') BREAK(' ') . op 
+       SPAN(' ') BREAK(' ') . args SPAN(' ')  REM . desc
	OUTPUT = '<tr>'
	OUTPUT = '<td>' sec  '</td>'
	OUTPUT = '<td>' op   '</td>'
	OUTPUT = '<td>' args   '</td>'
	OUTPUT = '<td>' desc '</td>'
	OUTPUT = '</tr>'
				:(loop)
END
