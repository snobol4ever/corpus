*---------------------------------------------------------------------- 1 arcget
* extract archive from standard input

    &ANCHOR = 1
    &STLIMIT = 1200000
    &DUMP = 2
    files = 0
loop
    LINE = TRIM(INPUT)			:f(atend) 
    LINE '!@#$'				:f(COPY)
    LINE LEN(4) REM . filename
    filename = TRIM(filename)
    TERMINAL = 'extracting ' filename
    files = files + 1
    EQ(files,1)				:s(first)
    ENDFILE(1)
first
    OUTPUT(.FILE, 1, filename)		:(loop)
COPY
    FILE = TRIM(LINE)                         :(loop)
done
    ENDFILE(1)                                :(loop)
atend
	&DUMP = 0
END
*---------------------------------------------------------------------- 2 arcput
* create archive from list of files
* give in standard input. For example
*    ls *.[ch] | spitbol arcput.spt >ch.arc
* will create ch.arc with a copy of all the .c and
* .h files in the current directory

    &TRIM = 1
    &STLIMIT = 1200000
loop
    filename = INPUT			:f(END)
    OUTPUT = '!@#$' filename 
    TERMINAL = 'archiving ' filename
    INPUT(.FILE, 1, filename)
COPY
    LINE = FILE				:f(done)
    OUTPUT = TRIM(LINE)			:(COPY)
done
    ENDFILE(1)				:(loop)
END
*--------------------------------------------------------------------------- 3 c
*

	&ANCHOR = &TRIM = 1
	lastline = 
*	state is null when normal text, non-null when processing block
*	comment
	inside.comment  =
					:(loop)
copy.comment	
	LINE = TRIM(' ' SUBSTR(LINE,2))
COPY
	OUTPUT = LINE
loop
	LINE = INPUT		:f(END)
	IDENT(LINE)		:s(COPY)
	DIFFER(inside.comment)	:s(com)
* here if in normal text, look for block opener
	LEQ(SUBSTR(LINE,1,1),'{')	:f(COPY)
	inside.comment = 1	:(COPY)
com
* here if in block comment, look for closer
	LINE = TRIM( (IDENT(SUBSTR(LINE,1,1), '*') ' ' SUBSTR(LINE,2)))
	LEQ(SUBSTR(LINE,1,1),'}')	:f(COPY)
	inside.comment =	:(COPY)
END	
*-------------------------------------------------------------------------- 4 cc
* change /* ... */ comments to '// ...
*	dave shields	29 jan 2013

	&ANCHOR = 0
	:(loop)
COPY	OUTPUT	= LINE
loop	LINE	= INPUT	:f(END)
	LINE ARB . first '/*' ARB . text '*/' RPOS(0) = first '//' text		:(COPY)
END
*--------------------------------------------------------------------------- 5 d
*

	&ANCHOR = &TRIM = 1
	lastline = 
*	state is null when normal text, non-null when processing block
*	comment
	inside.comment  =
					:(loop)
copy.comment	
	thisline = TRIM(' ' SUBSTR(thisline,2))
COPY
	OUTPUT = thisline
loop
	thisline = nextline
	nextline = TRIM(INPUT)	:f(END)
	lines = lines + 1
 	OUTPUT = LPAD( lines,5) ' ' 'this  ' thisline '$'
 	OUTPUT = LPAD( lines,5) ' ' 'next  ' nextline '$'
 	OUTPUT = LPAD( lines,5) ' ' inside.comment
	
*	gt(lines,27200)		:s(copy.rest)
*	gt(lines,1000)		:s(end)
	DIFFER(inside.comment)	:s(in.comment)
* here looking for start of block
	IDENT(nextline)		:s(COPY)
* turn line with only initial comment characer into null line
	thisline = IDENT(thisline,'*') 	:s(COPY)
	DIFFER(SUBSTR(nextline,1,1), '{')		:s(COPY)
	OUTPUT = 'BLOCK comment start at ' lines
	inside.comment = 'yes'
* if opener stands alone, just copy it out
	EQ(SIZE(thisline),1)			:s(COPY)
* here to swap opener in next line with this line
	OUTPUT = '{'
	OUTPUT = ' ' SUBSTR(nextline,2)
	nextline = INPUT		:(loop)

in.comment
* here if inside block comment
	IDENT(thisline)			:s(COPY)
	LEQ(SUBSTR(thisline,1,1), '*')	:s(copy.comment)
	LEQ(SUBSTR(thisline,1,1), ' ')	:s(copy.comment)
	OUTPUT = 'BLOCK comment end ' lines
	OUTPUT = '}'	
	inside.comment =		:(COPY)
copy.rest
	OUTPUT = thisline
	OUTPUT = nextline
copy.r
	OUTPUT = INPUT	:s(copy.r)
* initial state
END
*------------------------------------------------------------------------- 6 def
*	generate enum for list of SPITBOL accessible values
	TAB = CHAR(9)
loop
	lname = TRIM(INPUT)		:f(END)
	uname = REPLACE(lname,
+		'abcdeefghijklmnopqrstuvwxyz$',
+		'ABCDEEFGHIJKLMNOPQRSTUVWXYZ_')
	OUTPUT = TAB 'global' TAB uname
	OUTPUT =  '%define' TAB lname  TAB uname  :(loop)
END
