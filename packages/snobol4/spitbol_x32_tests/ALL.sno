*------------------------------------------------------------------------ 7 enum
*	generate enum for list of SPITBOL accessible values
	TAB = CHAR(9)
loop
	name = INPUT		:f(END)
	OUTPUT = TAB name ',' TAB TAB '/* ' LPAD(count,2) '  */'
	count = count + 1			:s(loop)
END
