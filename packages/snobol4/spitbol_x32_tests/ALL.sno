*---------------------------------------------------------------------- 13 lower
* translate lower to upper case to lower
	 &TRIM = &ANCHOR = 1
loop
	OUTPUT = REPLACE(INPUT,
+				'ABCDEFGHIJKLMNOPQRSTUVWXYZ',
+				'abcdefghijklmnopqrstuvwxyz') :s(loop)
END
