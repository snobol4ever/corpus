	&ANCHOR = &TRIM = 1

loop
	LINE = INPUT		:f(END)
	LINE BREAK(' ') . sec SPAN(' ') BREAK(' ') . op 
+       SPAN(' ') BREAK(' ') . args SPAN(' ')  REM . desc
	OUTPUT = '<tr>'
	OUTPUT = '<td>' sec  '</td>'
	OUTPUT = '<td>' op   '</td>'
	OUTPUT = '<td>' args   '</td>'
	OUTPUT = '<td>' desc '</td>'
	OUTPUT = '</tr>'
				:(loop)
END
