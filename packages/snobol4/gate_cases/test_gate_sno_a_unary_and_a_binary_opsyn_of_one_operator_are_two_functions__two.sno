        DEFINE('U(X)')                          :(U.END)
U       U = 'u<' X '>'                          :(RETURN)
U.END   DEFINE('B(X,Y)')                        :(B.END)
B       B = 'b<' X ',' Y '>'                    :(RETURN)
B.END   OPSYN('%', .B, 2)
        OPSYN('%', .U, 1)
        OUTPUT = 'bin ' (3 % 'q')
        OUTPUT = 'un ' %'r'
        OPSYN('#', .U, 1)
        OPSYN('#', .B, 2)
        OUTPUT = 'bin2 ' ('s' # 't')
        OUTPUT = 'un2 ' #'v'
END
