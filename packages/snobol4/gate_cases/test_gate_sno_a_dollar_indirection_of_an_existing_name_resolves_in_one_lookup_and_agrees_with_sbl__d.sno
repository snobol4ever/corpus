        target = 'tv'
        holder = 'target'
        OUTPUT = 'read ' $holder
        $holder = 'set'
        OUTPUT = 'after ' target
        n = 'fresh'
        $n = 'created'
        OUTPUT = 'fresh ' fresh
        $'k' = 'lit'
        OUTPUT = 'k ' k
        i = 7
        $i = 'int named 7'
        OUTPUT = $7
        $'two words' = 'sp'
        OUTPUT = $'two words'
        &ANCHOR = 0
        h2 = '&ANCHOR'
        OUTPUT = 'kw ' $h2
        $h2 = 1
        OUTPUT = 'kw set ' &ANCHOR
        t = TABLE()
        t['a'] = 'ta'
        h3 = 'size'
        size = 99
        OUTPUT = $h3 + 1
        OUTPUT = $'OUTPUT'
        $'OUTPUT' = 'via out'
        hh = 'holder'
        OUTPUT = $$hh
        $$hh = 'changed'
        OUTPUT = target
        OUTPUT = DATATYPE($.holder) ' ' DATATYPE($holder)
END
