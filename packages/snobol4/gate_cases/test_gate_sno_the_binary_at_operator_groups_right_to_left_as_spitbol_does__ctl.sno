        DEFINE('F(X,Y)')
        OPSYN('&','F',2)
        OPSYN('#','F',2)
        OPSYN('%','F',2)
        OPSYN('~','F',2)
        OUTPUT = 1 & 2 & 3
        OUTPUT = 1 # 2 # 3
        OUTPUT = 1 % 2 % 3
        OUTPUT = 1 ~ 2 ~ 3
        OUTPUT = 10 - 2 - 3
        OUTPUT = 2 + 3 - 4 + 5
        :(END)
F       F = '(' X ',' Y ')'                     :(RETURN)
END
