        DEFINE('TF(NAME,TAG)')                    :(TFEND)
TF      OUTPUT = 'trace ' NAME ' tag=' TAG       :(RETURN)
TFEND   DEFINE('F(A)')                            :(FEND)
F       F = A                                     :(RETURN)
FEND    TRACE('F','CALL','','TF')
        TRACE('F','RETURN','','TF')
        TRACE('X','ACCESS','','TF')
        &TRACE = 100
        X = 1
        Y = F(2)
        Z = X
        OUTPUT = 'done ' Y Z
END
