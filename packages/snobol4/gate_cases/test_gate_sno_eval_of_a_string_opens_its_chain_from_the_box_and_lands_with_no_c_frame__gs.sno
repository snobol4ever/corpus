        SUBJ = 'alpha beta gamma delta epsilon zeta eta theta iota kappa'
        N = 0
LOOP    N = N + 1
        SUBJ ('beta' . B)
        JUNK = SUBJ SUBJ SUBJ SUBJ SUBJ SUBJ SUBJ SUBJ
        R = EVAL('3 + 4')
        D = EVAL("DUPL('ab', N) 'x'")
        T = "DUPL('cd', 7)"
        Q = EVAL('SIZE(EVAL(T)) + N')
        LT(N, 40)                                             :S(LOOP)
        OUTPUT = 'R=' R ' B=' B ' N=' N ' D=' SIZE(D) ' Q=' Q
END
