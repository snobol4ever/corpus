N3      OUTPUT = 'NO  3 in an ARBNO body'
W4      X = ; 'ab' ? 'a' . *NM() FLUSH 'b'            :S(Y4)F(N4)
Y4      OUTPUT = 'YES 4 deferred *NM() target ' X     :(W5)
N4      OUTPUT = 'NO  4 deferred *NM() target'
W5      'abc' ? ('a' | 'ab') FLUSH 'c'                :S(Y5)F(N5)
