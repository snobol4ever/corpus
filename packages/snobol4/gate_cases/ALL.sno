*- 247 test_gate_sno_a_traced_call_keeps_its_procedure_and_its_value_across_a_collection__wa
 DEFINE('F(X,Y)A')
 DEFINE('TF(N,T)')  :(TFE)
TF OUTPUT = 'TF ' N ' ' T ' X=' X ' F=' F :(RETURN)
TFE
 TRACE('F','CALL',,'TF')
 TRACE('F','RETURN',,'TF')
