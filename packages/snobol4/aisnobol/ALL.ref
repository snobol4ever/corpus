Property list functions


PUT(.DOG,"NUMBER.OF.LEGS",4)
      ((NUMBER.OF.LEGS 4))

GET(.DOG,"NUMBER.OF.LEGS")
      (4)

PAUSE()

      ""

REMPROP(.DOG,"NUMBER.OF.LEGS")
      T

GET(.DOG,"NUMBER.OF.LEGS")
      NIL

PAUSE()

      ""

PUTL(#"(DOG CAT HORSE)","NUMBER.OF.LEGS",4)
      NIL

GET(.DOG,"NUMBER.OF.LEGS")
      (4)

GET(.CAT,"NUMBER.OF.LEGS")
      (4)

GET(.HORSE,"NUMBER.OF.LEGS")
      (4)

GET(.ARMADILLO,"NUMBER.OF.LEGS")
      NIL

PAUSE()

      ""

PUTPROP(.DOG,3,"LEGS")
      ((LEGS 3) (NUMBER.OF.LEGS 4))

PUTPROP(.DOG,2,"LEGS")
      ((LEGS 2 3) (NUMBER.OF.LEGS 4))

PUTPROP(.DOG,1,"LEGS")
      ((LEGS 1 2 3) (NUMBER.OF.LEGS 4))

PUTPROP(.DOG,1,"HEAD")
      ((HEAD 1) (LEGS 1 2 3) (NUMBER.OF.LEGS 4))

GETL(.DOG,#"(LEGS HEAD)")
      ((HEAD 1) (LEGS 1 2 3) (NUMBER.OF.LEGS 4))

GETL(.DOG,#"(HEAD)")
      ((HEAD 1) (LEGS 1 2 3) (NUMBER.OF.LEGS 4))

PAUSE()

      ""

ADDPROP(.DOG,3,"LEGS")
      ((HEAD 1) (LEGS 1 2 3) (NUMBER.OF.LEGS 4))

GET(.DOG,"LEGS")
      (1 2 3)

ADDPROP(.DOG,"ANOMALY","LEGS")
      ((HEAD 1) (LEGS ANOMALY 1 2 3) (NUMBER.OF.LEGS 4))

GET(.DOG,"LEGS")
      (ANOMALY 1 2 3)

PAUSE()

      ""

DEFPROP(.FISH,0,"LEGS")
      ((LEGS 0))

GETL(.FISH,#"(EYES ARMS TEETH LEGS)")
      ((LEGS 0))


