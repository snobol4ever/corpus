**********************************
 FUNCTION SELECT (S,T) ()
    S (BREAK(" ") $ SELECT) SPAN(" ") =    :F(FRETURN) ;
    T (POS(0) | " ") SELECT " "
        :S(RETURN)F(SELECT) ;
 END SELECT

