 FUNCTION TESTF (X,F) (W,G)
    NULL(F)        :S(RETURN) ;
    G = GETF(X) ;
TESTF1
    F (BREAK(" ") $ W) SPAN(" ") =    :F(RETURN) ;
    G (POS(0) | " ") W " "    :S(TESTF)F(FRETURN) ;
 END TESTF

