*------------------------------------------------------------------------ 7 WANG
IMP(NOT(OR(P,Q)),NOT(P))
NOT(IMP(NOT(OR(P,Q)),NOT(P)))
IMP(AND(NOT(P),NOT(Q)),EQU(P,Q))
IMP(IMP(OR(P,Q),OR(P,R)),OR(P,IMP(Q,R)))
IMP(IMP(OR(P,Q),OR(P,R)),AND(P,IMP(Q,R)))
