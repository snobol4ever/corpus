 C = CODE(" DEFINE('F(X,Y)A') :(FE)" ';'
+ "F OUTPUT = 'inF X=' X ' Y=' Y ; A = X Y ;"
+ " F = A A :(RETURN) ;"
+ "FE :(BACK)")                            :F(BAD)
 :<C>
BACK
 DEFINE('TF(N,T)')  :(TFE)
TF OUTPUT = 'TF ' N ' ' T ' F=' F :(RETURN)
TFE
 TRACE('F','CALL',,'TF')
 &TRACE = 10000
 OUTPUT = 'R=' F('abc', 'def')
 OUTPUT = 'after'                  :(END)
BAD OUTPUT = 'CODE failed'
END
