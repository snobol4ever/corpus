        P = 'k' | ('xyz' ? 'y')
        'zzk' ? P . V
        OUTPUT = 'alt right ' V
        Q = ('xyz' ? 'y') | 'k'
        'zzk' ? Q . W
        OUTPUT = 'alt left ' W
        OUTPUT = 'dupl ' DUPL('ab', SIZE('xyz' ? 'y'))
        OUTPUT = 'concat ' 'k' ('xyz' ? 'y')
        OUTPUT = 'replace ' REPLACE('abc', ('xyz' ? 'y'), 'Y')
        OUTPUT = 'arith ' (1 + SIZE('xyz' ? 'xy'))
        OUTPUT = 'two ' DUPL('ab', SIZE('xyz' ? 'y') + SIZE('pq' ? 'q'))
        R = 'k' | ('xyz' ? 'y') | 'm'
        'zzm' ? R . U
        OUTPUT = 'alt3 ' U
        OUTPUT = 'lpad ' LPAD('ab', SIZE('xyz' ? ('x' | 'y')) + 3, '*')
END
