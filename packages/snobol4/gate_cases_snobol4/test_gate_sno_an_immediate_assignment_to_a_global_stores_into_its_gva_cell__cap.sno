        DEFINE('f()loc')                        :(f_end)
f       'xyz' LEN(2) $ loc
        f = 'f:' loc                            :(RETURN)
f_end   DEFINE('g()stem')                       :(g_end)
g       stem = 'g-local'
        'abc' p
        g = 'g:' stem                           :(RETURN)
g_end   OUTPUT(.assoc)
        'hello' LEN(4) $ assoc
        &TRACE = 5
        TRACE('tr')
        'trace' LEN(3) $ tr
        stem = 'global'
        p = LEN(1) $ stem
        OUTPUT = f()
        OUTPUT = g()
        OUTPUT = 'after g: ' stem
        'q' p
        OUTPUT = 'top: ' stem
        s = 'the quick brown fox'
        s BREAK(' ') $ w1 ' ' BREAK(' ') $ w2 ' ' REM $ rest
        OUTPUT = w1 '|' w2 '|' rest
        n = 0
loop    n = LT(n, 2000) n + 1                   :F(done)
        s ARB $ a1 'quick' $ a2 ARB $ a3 RPOS(0) :F(bad)
        t = a2                                  :(loop)
bad     OUTPUT = 'bad'
done    OUTPUT = a1 '|' a2 '|' a3 ' ' n
        s POS(0) SPAN('abcdefghijklmnopqrstuvwxyz') $ w RPOS(0)  :S(no)
        OUTPUT = 'w=' w
no      OUTPUT = 'done ' tr
END
