        &ERRLIMIT = 10
        INPUT(.IN, 5, 'data.txt')
        A = IN
        OUTPUT = 'A=' A
        R = SET(5, 0, 0)
        OUTPUT = 'rewind ret=[' R ']'
        A = IN
        OUTPUT = 'again A=' A
        R = SET(5, 6, 0)
        OUTPUT = 'abs6 ret=[' R ']'
        A = IN
        OUTPUT = 'abs6 A=' A
        R = SET(5, 0, 2)
        OUTPUT = 'end ret=[' R ']'
        A = IN                          :S(GOT)
        OUTPUT = 'at end: read failed'  :(NEXT)
GOT     OUTPUT = 'at end: got ' A
NEXT    R = SET(5, -5, 2)
        OUTPUT = 'end-5 ret=[' R ']'
        A = IN
        OUTPUT = 'end-5 A=' A
        R = SET(5, 3, 1)
        OUTPUT = 'cur+3 ret=[' R ']'
        R = SET(5, 0, 1)
        OUTPUT = 'cur+0 ret=[' R ']'
        R = SET(5, 2, 0)
        R = SET(5, 4, 1)
        OUTPUT = 'cur ret=[' R ']'
        A = IN
        OUTPUT = 'cur A=' A
        R = SET(5, -100, 0)
        OUTPUT = 'neg abs ret=[' R '] errtype=' &ERRTYPE
        R = SET(9, 0, 0)                :S(OK2)F(BAD2)
OK2     OUTPUT = 'unopened ok [' R ']' :(N3)
BAD2    OUTPUT = 'unopened FAILED errtype=' &ERRTYPE
N3      X = TELL(5)                     :S(OK3)F(BAD3)
OK3     OUTPUT = 'TELL ok [' X ']'      :(N4)
BAD3    OUTPUT = 'TELL FAILED errtype=' &ERRTYPE
N4      OUTPUT = 'done'
END
