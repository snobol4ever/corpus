        &ERRLIMIT = 1000
        t = TABLE()
        a = ARRAY(3)
        p = LEN(1)
        i = 0
nxt     i = i + 1
        SETEXIT(.errh)
        :($('C' i))
C1      '0' ? t                         :(ok)
C2      'ab' ? a                        :(ok)
C3      x = LEN(2) | a                  :(ok)
C4      x = a | LEN(2)                  :(ok)
C5      a[1] ? t 'a'                    :(ok)
C6      'ab' ? 'a' | a                  :(ok)
C7      'ab' ? a | 'a'                  :(ok)
C8      'ab' ? 'a' | a | 'b'            :(ok)
C9      'ab' ? a | 'a' | 'b'            :(ok)
C10     'ab' ? 'a' | 'b' | a            :(ok)
C11     'ab' ? 'a' a 'b'                :(ok)
C12     'ab' ? a 'a' 'b'                :(ok)
C13     'ab' ? 'a' 'b' a                :(ok)
C14     x = ('a' ? a)                   :(ok)
C15     x = ('a' ? t | 'a')             :(ok)
C16     'ab' ? p t                      :(ok)
C17     'ab' ? p 'b'                    :(ok)
C18     'ab' ? p | 'b'                  :(ok)
C19     x = p | 'b'                     :(ok)
C20     x = 'ab' ? p                    :(ok)
C21     'ab' ? ARBNO(t)                 :(ok)
C22     'ab' ? FENCE(t)                 :(ok)
C23     'ab' ? *t                       :(ok)
C24     'ab' ? t . x                    :(ok)
C25     'ab' ? a $ x                    :(ok)
C26     x = ('ab' ? t . y)              :(ok)
C27     :(END)
ok      OUTPUT = i ' ok'                :(nxt)
errh    OUTPUT = i ' ERROR ' &ERRTYPE   :(nxt)
END
