* @title SUBSTR over every position and length of "hello world"
* @attribution Ported from Phil Budne's CSNOBOL4 test suite (substr.sno).
* @expect >>>
* 1,0: "hello world"
* 1,1: "h"
* 1,2: "he"
* 1,3: "hel"
* 1,4: "hell"
* 1,5: "hello"
* 1,6: "hello "
* 1,7: "hello w"
* 1,8: "hello wo"
* 1,9: "hello wor"
* 1,10: "hello worl"
* 1,11: "hello world"
* 2,0: "ello world"
* 2,1: "e"
* 2,2: "el"
* 2,3: "ell"
* 2,4: "ello"
* 2,5: "ello "
* 2,6: "ello w"
* 2,7: "ello wo"
* 2,8: "ello wor"
* 2,9: "ello worl"
* 2,10: "ello world"
* 3,0: "llo world"
* 3,1: "l"
* 3,2: "ll"
* 3,3: "llo"
* 3,4: "llo "
* 3,5: "llo w"
* 3,6: "llo wo"
* 3,7: "llo wor"
* 3,8: "llo worl"
* 3,9: "llo world"
* 4,0: "lo world"
* 4,1: "l"
* 4,2: "lo"
* 4,3: "lo "
* 4,4: "lo w"
* 4,5: "lo wo"
* 4,6: "lo wor"
* 4,7: "lo worl"
* 4,8: "lo world"
* 5,0: "o world"
* 5,1: "o"
* 5,2: "o "
* 5,3: "o w"
* 5,4: "o wo"
* 5,5: "o wor"
* 5,6: "o worl"
* 5,7: "o world"
* 6,0: " world"
* 6,1: " "
* 6,2: " w"
* 6,3: " wo"
* 6,4: " wor"
* 6,5: " worl"
* 6,6: " world"
* 7,0: "world"
* 7,1: "w"
* 7,2: "wo"
* 7,3: "wor"
* 7,4: "worl"
* 7,5: "world"
* 8,0: "orld"
* 8,1: "o"
* 8,2: "or"
* 8,3: "orl"
* 8,4: "orld"
* 9,0: "rld"
* 9,1: "r"
* 9,2: "rl"
* 9,3: "rld"
* 10,0: "ld"
* 10,1: "l"
* 10,2: "ld"
* 11,0: "d"
* 11,1: "d"
* <<<
	S = "hello world"
	M = SIZE(S)

	O = -1
LLOOP	L = -1
LOOP	OUTPUT = O ',' L ': "' SUBSTR(S,O,L) '"'
	L = L + 1
	LE(L,M)						:S(LOOP)
	O = O + 1
	LE(O,M)						:S(LLOOP)
END
*------------------------------------------------------ 67 strings-and-variables
* @title String concatenation, coercion, and null variables
* @attribution Griswold 1971, Chapter 1
* @expect >>>
* CONCATENATION
* ONE,TWO,THREE
* ABC
* BEGINNING AND END.
* 3 DOG NIGHT
* 194
* EGGSHELL
*
* EGGSHELL
* 60
* EGG17
* <<<
 OUTPUT = 'CONCAT' 'ENATION'
 OUTPUT = 'ONE,' 'TWO,' 'THREE'
 OUTPUT = 'A'                 'B'       'C'
 OUTPUT = 'BEGINNING '   'AND '   'END.'
 OUTPUT = (20 - 17)  ' DOG NIGHT'
 OUTPUT = 19  (12 / 3)
 ABC = 'EGG'
 D = 'SHELL'
 OUTPUT = ABC D
 OUTPUT = NONESUCH
 OUTPUT = ABC NULL D
 N1 = 43
 D = 17
 OUTPUT = N1 + D
 OUTPUT = ABC D
END
*------------------------------------------------------------ 68 succeed-rematch
* @title SUCCEED rematches the null string until its neighbor succeeds
* @expect >>>
* MATCHED AFTER 3 TRIES
* <<<
        DEFINE('BUMP()')                        :(MAIN)
BUMP    N = N + 1
        BUMP = N                                :(RETURN)
MAIN    N = 0
        'ABC' SUCCEED *EQ(BUMP(), 3)            :F(NO)
        OUTPUT = 'MATCHED AFTER ' N ' TRIES'    :(END)
NO      OUTPUT = 'FAILED'
END
*------------------------------------------------------------- 69 tower-of-hanoi
* @title Tower of Hanoi
* @attribution Griswold 1971, Chapter 4
* @expect >>>
* MOVE DISC 1 FROM A TO C
* MOVE DISC 2 FROM A TO B
* MOVE DISC 1 FROM C TO B
* MOVE DISC 3 FROM A TO C
* MOVE DISC 1 FROM B TO A
* MOVE DISC 2 FROM B TO C
* MOVE DISC 1 FROM A TO C
* <<<
         DEFINE('HANOI(N,NS,ND,NI)')          :(TEST)
HANOI    EQ(N, 0)                             :S(RETURN)
         HANOI(N - 1, NS, NI, ND)
         OUTPUT = 'MOVE DISC ' N ' FROM ' NS ' TO ' ND
         HANOI(N - 1, NI, ND, NS)             :(RETURN)
TEST     HANOI(3, 'A', 'C', 'B')
END
*-------------------------------------------------------- 70 trace-all-functions
* @title Trace every function call with &FTRACE
* @match substring/i
* @expect >>>
* LEVEL 0 RETURN OF DBL = 42
* <<<
* Setting &FTRACE turns on call/return tracing for all defined functions at
* once, without naming each with TRACE. It is the blunt-instrument companion to
* TRACE(...,'FUNCTION'): handy when you do not yet know which function is
* misbehaving. The output format is the same call/return ladder.
        DEFINE('DBL(X)')              :(MAIN)
DBL     DBL = X + X                   :(RETURN)
MAIN    &FTRACE = 10
        OUTPUT = DBL(21)
END
*------------------------------------------------------- 71 trace-function-calls
* @title Trace calls and returns of a recursive function
* @match substring/i
* @expect >>>
* LEVEL 0 RETURN OF FACT = 6
* <<<
* TRACE(name,'FUNCTION') asks the interpreter to announce every call and every
* return of a defined function, with the nesting depth in &FNCLEVEL. Running it
* over a recursive factorial prints the classic descend/ascend ladder:
*   LEVEL 0 CALL OF FACT(3) ... LEVEL 2 RETURN OF FACT = 1 ... and back up.
* We match the final top-level return, which only appears once the whole
* recursion has unwound correctly.
        DEFINE('FACT(N)')             :(MAIN)
FACT    FACT = LE(N,1) 1             :S(RETURN)
        FACT = N * FACT(N - 1)       :(RETURN)
MAIN    &TRACE = 100
        TRACE('FACT','FUNCTION')
        OUTPUT = FACT(3)
END
*----------------------------------------------------- 72 trace-keyword-fnclevel
* @title Trace the &FNCLEVEL keyword across a call
* @match substring
* @expect >>>
* &FNCLEVEL = 1
* <<<
* Keyword tracing watches a system keyword instead of a program variable.
* &FNCLEVEL records the function-call nesting depth, so tracing it prints a line
* whenever the depth changes: up to 1 as GREET is entered, back to 0 as it
* returns. (Only a handful of system keywords -- &FNCLEVEL, &STCOUNT,
* &STFCOUNT -- are checked for keyword traces; ordinary keyword assignments are
* not.)
        DEFINE('GREET(WHO)')          :(MAIN)
GREET   GREET = 'HI ' WHO            :(RETURN)
MAIN    &TRACE = 100
        TRACE('FNCLEVEL','KEYWORD')
        OUTPUT = GREET('WORLD')
END
*----------------------------------------------------------- 73 trace-label-flow
* @title Follow control flow with label tracing
* @match substring/i
* @expect >>>
* TRANSFER TO STEP
* <<<
* TRACE(label,'LABEL') prints a line every time control transfers to that
* label, which is handy for confirming a loop actually iterates. Here STEP is
* re-entered on each successful pass, so "TRANSFER TO STEP" is printed once per
* loop trip before the program reports the final count.
        &TRACE = 100
        TRACE('STEP','LABEL')
        N = 0
STEP    N = LT(N,3) N + 1            :S(STEP)
        OUTPUT = 'COUNTED TO ' N
END
*------------------------------------------------------------ 74 trace-procedure
* @title Programmer-defined trace procedure
* @attribution Griswold 1971, Chapter 8
* @expect >>>
* VARIABLE X SET TO 10 AT LINE 7
* VARIABLE X SET TO 15 AT LINE 8
* <<<
         DEFINE('VALTR(VAR,TAG)ST,TIME')      :(START)
VALTR    ST = &LASTNO
         OUTPUT = 'VARIABLE ' VAR ' SET TO ' $VAR ' AT LINE ' ST
         :(RETURN)
START    &TRACE = 100
         TRACE('X', 'VALUE', , 'VALTR')
         X = 10
         X = X + 5
END
*---------------------------------------------------------- 75 trace-value-watch
* @title Watch a variable with default value tracing
* @match substring
* @expect >>>
* TOTAL = 42
* <<<
* Turning on &TRACE and naming a variable with TRACE(...,'VALUE') makes the
* interpreter print the variable every time it is assigned -- the SNOBOL4
* equivalent of a watchpoint. With no trace function supplied the built-in
* printer formats each change as "STATEMENT n: NAME = value". We match only the
* NAME = value clause: the statement-number prefix and ,TIME= suffix vary
* between implementations and runs.
        &TRACE = 100
        TRACE('TOTAL','VALUE')
        TOTAL = 0
        TOTAL = TOTAL + 17
        TOTAL = TOTAL + 25
        OUTPUT = 'FINAL ' TOTAL
END
*------------------------------------------------ 76 unary-plus-minus-conversion
* @title Unary plus and minus convert string operands to numbers
* @expect >>>
* -5
* -2.5
* -3.25
* 7
* 4.5
* 6.125
* -4
* 5.
* <<<
        OUTPUT = -'5'
        OUTPUT = -'2.5'
        OUTPUT = -3.25
        OUTPUT = +'7'
        OUTPUT = +'4.5'
        OUTPUT = +6.125
        OUTPUT = -'5' + 1
        OUTPUT = +'4.5' + 0.5
END
*--------------------------------------------- 77 unevaluated-pair-backreference
* @title Unevaluated expression matches a repeated adjacent character
* @attribution Griswold 1971, Chapter 2, Section 2.16.1
* @expect >>>
* OO
* MM
* AA
* EE
* <<<
          PAIR = (LEN(1) $ X *X) . OUTPUT
          'COOK' PAIR
          'COMMON' PAIR
          'AARON' PAIR
          'CHICKADEE' PAIR
END
*--------------------------------------------------- 78 value-trace-during-match
* @title VALUE trace fires for $, @, and . assignments during matching
* @expect >>>
* TRACE  HE
* TRACE  4
* TRACE  SNO
* X=HE C=4 D=SNO
* <<<
        DEFINE('TFN(NAM,TYP)')          :(MAIN)
TFN     OUTPUT = 'TRACE ' TYP ' ' $NAM          :(RETURN)
MAIN    &TRACE = 10
        TRACE('X', 'VALUE', , 'TFN')
        TRACE('C', 'VALUE', , 'TFN')
        TRACE('D', 'VALUE', , 'TFN')
        'HELLO' LEN(2) $ X
        'WORLD' 'RL' @C
        'SNOBOL' LEN(3) . D
        OUTPUT = 'X=' X ' C=' C ' D=' D
END
*------------------------------------------------------------ 79 words-of-length
* @title Word-length filter over input text
* @attribution Griswold 1971, Appendix D, Solution 2.3
* @input >>>
* 5
* THE QUICK BROWN FOX JUMPS.
* SIXTY SEVEN EIGHT NINE?
* <<<
* @expect >>>
*  WORDS OF LENGTH 5 ARE:
* QUICK
* BROWN
* JUMPS
* SIXTY
* SEVEN
* EIGHT
* <<<
          &TRIM = 1
          WORD = BREAK(' ,.;?') . W LEN(1)
          N = INPUT
          OUTPUT = ' WORDS OF LENGTH ' N ' ARE:'
READ      TEXT = INPUT ' ' :F(END)
NEXTW     TEXT WORD = :F(READ)
          OUTPUT = EQ(SIZE(W),N) W :(NEXTW)
END
