* hello world
* paul is dead
* ABCDEFGHIJKLMNOPQRSTUVWXYZ
* <<<
	OUTPUT = REVERSE("dlrow olleh")
	OUTPUT = REVERSE("daed si luap")
	OUTPUT = REVERSE(REVERSE(&UCASE))
END
