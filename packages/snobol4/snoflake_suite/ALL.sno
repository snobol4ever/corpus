SQUARE   SQUARE = ARRAY(PROTOTYPE(A) ',' PROTOTYPE(A)) :(RETURN)
SQ_END   B = ARRAY('3,3')
         C = SQUARE(B)
         OUTPUT = PROTOTYPE(C)
END
