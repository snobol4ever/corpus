*--------------------------------------------------------------- 14 math_limits1
* Find floating point limits
    DEFINE('LIMITS(lower,upper,maxdigit)')              :(LIMITS.end)

LIMITS
    cursor = 1
    OUTPUT = 'Find limits to ' maxdigit ' digits'

nextcursor
    testnum = lower
    cursor = cursor + 1
    GT(cursor,maxdigit)                                 :s(report)
    i = 0

nexti
    testnum POS(cursor) LEN(1) = i
    result = EVAL(testnum)
    result POS(0) '0.' RPOS(0)                          :f(saveupper)
    lower = testnum
    LE(i = i + 1, 9)                                    :s(nexti)f(nextcursor)

saveupper
    upper = testnum                                     :(nextcursor)

report
    OUTPUT = 'lower: ' lower ' = ' EVAL(lower)
    OUTPUT = 'upper: ' upper ' = ' EVAL(upper)                                                     :(RETURN)

LIMITS.end

    LIMITS('2.000000000E-324' ,             '3.000000000E-324', 10)
    LIMITS('2.0000000000E-324' ,            '3.0000000000E-324', 11)
    LIMITS('2.00000000000E-324' ,           '3.00000000000E-324', 12)
    LIMITS('2.000000000000E-324' ,          '3.000000000000E-324', 13)
    LIMITS('2.0000000000000E-324' ,         '3.0000000000000E-324', 14)
    LIMITS('2.00000000000000E-324' ,        '3.00000000000000E-324', 15)
    LIMITS('2.000000000000000E-324' ,       '3.000000000000000E-324', 16)

END
*--------------------------------------------------------------- 15 math_limits2
* Find floating point limits
    DEFINE('LIMITS(lower,upper,maxdigit)')              :(LIMITS.end)

LIMITS
    cursor = 1
    OUTPUT = 'Find limits to ' maxdigit ' digits'

nextcursor
    testnum = lower
    cursor = cursor + 1
    GT(cursor,maxdigit)                                 :s(report)
    i = 0

nexti
    testnum POS(cursor) LEN(1) = i
    result = EVAL(testnum)                              :s(print)
    result = "***"

print
    result POS(0) '***' RPOS(0)                         :s(saveupper)
    lower = testnum
    LE(i = i + 1, 9)                                    :s(nexti)f(nextcursor)

saveupper
    upper = testnum                                     :(nextcursor)

report
    OUTPUT = 'lower: ' lower ' = ' EVAL(lower)
    OUTPUT = 'upper: ' upper ' = ' '***'
                                                       :(RETURN)
LIMITS.end

    LIMITS('1.000000000E+308' ,             '2.000000000E+308', 10)
    LIMITS('1.0000000000E+308' ,            '2.0000000000E+308', 11)
    LIMITS('1.00000000000E+308' ,           '2.00000000000E+308', 12)
    LIMITS('1.000000000000E+308' ,          '2.000000000000E+308', 13)
    LIMITS('1.0000000000000E+308' ,         '2.0000000000000E+308', 14)
    LIMITS('1.00000000000000E+308' ,        '2.00000000000000E+308', 15)

END

*--------------------------------------------------------------- 16 math_limits3
* Find floating point limits
    DEFINE('LIMITS(lower,upper,maxdigit)')              :(LIMITS.end)

LIMITS
    cursor = 2
    OUTPUT = 'Find limits to ' maxdigit ' digits'

nextcursor
    testnum = lower
    cursor = cursor + 1
    GT(cursor,maxdigit + 1)                             :s(report)
    i = 0

nexti
    testnum POS(cursor) LEN(1) = i
    result = EVAL(testnum)                              :s(print)
    result = "***"

print
    testnum ' = ' result
    result POS(0) '***' RPOS(0)                         :s(saveupper)
    lower = testnum
    LE(i = i + 1, 9)                                    :s(nexti)f(nextcursor)

saveupper
    upper = testnum                                     :(nextcursor)

report
    OUTPUT = 'lower: ' lower ' = ' EVAL(lower)
    OUTPUT = 'upper: ' upper ' = ' '***'
                                                        :(RETURN)
LIMITS.end

    LIMITS('-1.000000000E+308' ,             '-2.000000000E+308', 10)
    LIMITS('-1.0000000000E+308' ,            '-2.0000000000E+308', 11)
    LIMITS('-1.00000000000E+308' ,           '-2.00000000000E+308', 12)
    LIMITS('-1.000000000000E+308' ,          '-2.000000000000E+308', 13)
    LIMITS('-1.0000000000000E+308' ,         '-2.0000000000000E+308', 14)
    LIMITS('-1.00000000000000E+308' ,        '-2.00000000000000E+308', 15)
    LIMITS('-1.000000000000000E+308' ,       '-2.000000000000000E+308', 16)

END
