*----------------------------------------------------------------------- 29 save
    OUTPUT = 'writing save file'
    EXIT(-3,'save.spx')
    OUTPUT = 'Resuming after save'
END
*-------------------------------------------------------------------- 30 setexit
    SETEXIT(.errtrace)
    &ERRLIMIT = 100

    n1 = 1.0
    n0 = 0.1e-308
*    a = n1 / n0         :f(oops)
    r = EVAL('n1 / n0') :s(END)f(oops)
oops
    OUTPUT = "oops"       :(END)
errtrace
    OUTPUT = 'trace'
    OUTPUT = ">> error #" &ERRTYPE ", " &ERRTEXT
    SETEXIT(.errtrace)
    (DIFFER(&ERRTYPE,20) DIFFER(&ERRTYPE,23) DIFFER(&ERRTYPE,24) DIFFER(&ERRTYPE,38)) :s(CONTINUE)f(ABORT)
END
*------------------------------------------------------------------------- 31 sv
 OUTPUT = 'saving ...'
 EXIT(-3)
 OUTPUT = 'resuming'
END
*----------------------------------------------------------------------- 32 trim
loop
  OUTPUT = TRIM(INPUT)  :s(loop)
END
