*-------------------------------------------------------------------- 3 gcbuster
        &ABEND = 1      ; &DUMP = 1
        DATA('THING(A,B)')
MAKE    LIST = THING(N,LIST)
        N = N + 1 LT(N,100000) :s(MAKE)
        OUTPUT = 'starting garbage collection'
        OUTPUT = COLLECT()
        OUTPUT = COLLECT()
TEST    OUTPUT = NE(A(LIST),N) 'oops'   :s(END)
        LIST = B(LIST)
        N = N - 1 GT(N,0) :s(TEST)
        &ABEND = 0      ; &DUMP = 1
        OUTPUT = 'test succeeded'
     MEMINCB = HOST(-1, 0)
     DATABTS = HOST(-1, 1)
     BASEMEM = HOST(-1, 2)
     TOPMEM  = HOST(-1, 3)
     STACKSIZ = HOST(-1,4)
     STACKCUR = HOST(-1,5)
     WORDSIZE = HOST(-1,6)
     STACKMAX = HOST(-1,7)
END
*----------------------------------------------------------------------- 4 hello
   OUTPUT = 'Hello World'
END
*------------------------------------------------------------------------ 5 host
    OUTPUT = "host(): " HOST()
    OUTPUT = "host(0)"  HOST(0)
END
*----------------------------------------------------------------------- 6 lower
* translate lower to upper case to lower
     &TRIM = &ANCHOR = 1
loop
    OUTPUT = REPLACE(INPUT,
+               'ABCDEFGHIJKLMNOPQRSTUVWXYZ',
+               'abcdefghijklmnopqrstuvwxyz') :s(loop)
END
