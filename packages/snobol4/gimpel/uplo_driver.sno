*  UPLO_driver - exercises UPLO(S): upper case letters become lower case and
*  vice versa, non-alphabetic characters unchanged.  Contract per uplo.inc.
-INCLUDE "uplo.inc"
        OUTPUT  =  UPLO('ABC')
        OUTPUT  =  UPLO('abc')
        OUTPUT  =  UPLO('Hello, World!')
        OUTPUT  =  UPLO('123 +-*/')
        OUTPUT  =  '[' UPLO('') ']'
END
