*  TRIG_driver - exercises SIN(A), COS(A) and TAN(A) through trig.inc.  Contract per
*  the SPITBOL form's header: the functions are built in to SPITBOL, so the library
*  defines none of them and the built-ins answer.
-INCLUDE "trig.inc"
        OUTPUT  =  SIN(0.0)
        OUTPUT  =  COS(0.0)
        OUTPUT  =  TAN(0.0)
        OUTPUT  =  SIN(1.0)
        OUTPUT  =  COS(1.0)
END
