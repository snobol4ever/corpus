*  TIMEGC_driver - RESOLUTION is stubbed to 0 so TIMEGC collects exactly once; its two
*  report lines are the engine's clock and storage units (ALL.mask); the rest is pinned.
-INCLUDE "timegc.inc"
        DEFINE('RESOLUTION()', 'RES_0')                 :(RES_0_END)
RES_0   RESOLUTION  =  0                                :(RETURN)
RES_0_END
        R  =  TIMEGC(3)
        OUTPUT  =  'TIMEGC(3) returned a '  DATATYPE(R)
        OUTPUT  =  GE(R,0)  'that is not negative'
        OUTPUT  =  'returned'
END
