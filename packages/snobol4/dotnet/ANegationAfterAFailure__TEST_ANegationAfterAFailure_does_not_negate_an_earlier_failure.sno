        &ERRLIMIT = 10
        V = REVERSE(' 12 ') * -~1 * ~6                  :S(Y1)
        OUTPUT = '1 F'                                  :(E1)
Y1      OUTPUT = '1 S [' V ']'
E1      V = 'f' / (~7) / ~RTAB(0)                       :S(Y2)
        OUTPUT = '2 F'                                  :(E2)
Y2      OUTPUT = '2 S ' DATATYPE(V)
E2      V = SIZE(~1) ~2                                 :S(Y3)
        OUTPUT = '3 F'                                  :(E3)
Y3      OUTPUT = '3 S [' V ']'
E3      V = ~1 + 2 ~3                                   :S(Y4)
        OUTPUT = '4 F'                                  :(E4)
Y4      OUTPUT = '4 S [' V ']'
E4      V = EVAL("REVERSE(' 12 ') * -~1 * ~6")         :S(Y5)
        OUTPUT = '5 F'                                  :(E5)
Y5      OUTPUT = '5 S [' V ']'
E5      V = (~1 * ~2, 'alt')                            :S(Y6)
        OUTPUT = '6 F'                                  :(E6)
Y6      OUTPUT = '6 S [' V ']'
E6      V = ~(~1 * ~2)                                  :S(Y7)
        OUTPUT = '7 F'                                  :(E7)
Y7      OUTPUT = '7 S [' V ']'
E7      V = DUPL(~1, 2) ~(~3)                           :S(Y8)
        OUTPUT = '8 F'                                  :(E8)
Y8      OUTPUT = '8 S [' V ']'
E8
END
