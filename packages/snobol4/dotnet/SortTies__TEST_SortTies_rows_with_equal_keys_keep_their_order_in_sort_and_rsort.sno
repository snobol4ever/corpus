        A = ARRAY('24,2')
        A[1,1] = 'a0'; A[1,2] = 5
        A[2,1] = 'b1'; A[2,2] = 5
        A[3,1] = 'c2'; A[3,2] = 5
        A[4,1] = 'd3'; A[4,2] = 2
        A[5,1] = 'e4'; A[5,2] = 2
        A[6,1] = 'f5'; A[6,2] = 5
        A[7,1] = 'g6'; A[7,2] = 2
        A[8,1] = 'h7'; A[8,2] = 1
        A[9,1] = 'i8'; A[9,2] = 5
        A[10,1] = 'j9'; A[10,2] = 3
        A[11,1] = 'k10'; A[11,2] = 2
        A[12,1] = 'l11'; A[12,2] = 1
        A[13,1] = 'm12'; A[13,2] = 1
        A[14,1] = 'n13'; A[14,2] = 5
        A[15,1] = 'o14'; A[15,2] = 5
        A[16,1] = 'p15'; A[16,2] = 2
        A[17,1] = 'q16'; A[17,2] = 1
        A[18,1] = 'r17'; A[18,2] = 1
        A[19,1] = 's18'; A[19,2] = 1
        A[20,1] = 't19'; A[20,2] = 1
        A[21,1] = 'u20'; A[21,2] = 2
        A[22,1] = 'v21'; A[22,2] = 2
        A[23,1] = 'w22'; A[23,2] = 1
        A[24,1] = 'x23'; A[24,2] = 5
        R = RSORT(A, 2)
        S = SORT(A, 2)
        I = 1
L       OUTPUT = R[I,1] ' ' R[I,2] '   ' S[I,1] ' ' S[I,2]  :F(END)
        I = I + 1  :(L)
END
