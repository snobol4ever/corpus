-CASE 1
        DEFINE('f(n)')                              :(fe)
f       f = n * 10                                  :(RETURN)
fe      OPSYN('h', 'f')
        OUTPUT = H(2)
        OUTPUT = APPLY('H', 3)
        OUTPUT = APPLY('h', 4)
        OPSYN('Size2', 'SIZE')
        OUTPUT = SIZE2('abc')
END
