        C1 = CODE(' A = &STNO ; B = &STNO :(R1)')
        :[C1]
R1      OUTPUT = A ' ' B ' ' &STNO
        C2 = CODE(' D = &STNO :(R2)')
        :[C2]
R2      OUTPUT = D ' ' &STNO ' ' &LASTNO
        E = EVAL('&STNO')
        OUTPUT = 'E=' E
        C3 = CODE(' F = &STNO :(R3)')
        :[C3]
R3      OUTPUT = F
END
