        &ERRLIMIT = 20
        &TRIM = 0
        S = 'abcdef'
        AB = 'ab'
        E = ''
        NEG = -2
        BAD = 'x'
        BIG = 16777217
        MAX = 16777216
        HUGE = 9223372036854775807
        P = LEN(2)
        X = DUPL(E, HUGE)   :F(NO1)
        OUTPUT = 'ok'   :(N1)
NO1     OUTPUT = 'fails ' &ERRTYPE
N1      X = DUPL(AB, BIG)   :F(NO2)
        OUTPUT = 'ok'   :(END)
NO2     OUTPUT = 'fails ' &ERRTYPE
END
