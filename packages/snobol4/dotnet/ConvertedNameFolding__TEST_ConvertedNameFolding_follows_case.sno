-CASE 1
        abc = 5
        OUTPUT = 'x' CONVERT('abc', 'NAME')
        OUTPUT = $CONVERT('abc', 'NAME')
        OUTPUT = 'x' CONVERT(1.0E-10, 'NAME')
        OUTPUT = 'x' CONVERT('Mixed', 'NAME')
        &CASE = 0
        OUTPUT = 'y' CONVERT('Def', 'NAME')
        &CASE = 1
        OUTPUT = 'z' CONVERT('Def', 'NAME')
END
