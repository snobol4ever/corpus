        DEFINE('F(X)')                 :(F_END)
F                                      :(FRETURN)
F_END
        DEFINE('G(X)')                 :(G_END)
G       G = X                          :(RETURN)
G_END
        ( F(1) ~F(2) )                 :S(Y1)F(N1)
Y1      OUTPUT = 'wrong'               :(E1)
N1      OUTPUT = 'failed'
E1      ( LT(1,2) F(1) ~F(2) )         :S(Y2)F(N2)
Y2      OUTPUT = 'wrong 2'             :(E2)
N2      OUTPUT = 'failed 2'
E2      OUTPUT = ~F(1) 'a'
        OUTPUT = ~(F(1) G(2)) 'b'
        OUTPUT = ~G(F(1)) 'c'
        OUTPUT = ~LT(2,1) 'd'
        OUTPUT = (F(1) ~F(2)) 'e'
        OUTPUT = (LT(2,1) ~F(2)) 'f'
        OUTPUT = ~G(1) 'g'
        OUTPUT = ~~F(1) 'h'
        OUTPUT = 'end'
END
