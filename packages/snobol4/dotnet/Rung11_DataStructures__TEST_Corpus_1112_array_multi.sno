
        c = ARRAY('2,2')
        c[1,2] = '*'
        DIFFER(c[1,2], '*')                   :F(e001)
        OUTPUT = 'FAIL 1112/001: 2D array assign/read' :(END)
e001
        DIFFER(PROTOTYPE(c), '2,2')                   :F(e002)
