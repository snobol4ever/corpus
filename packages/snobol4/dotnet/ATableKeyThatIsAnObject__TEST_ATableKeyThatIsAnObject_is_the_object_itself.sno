        T = TABLE()
        A = ARRAY(2)
        P = LEN(1)
        E = *X
        T[A] = 'arr'
        T[P] = 'pat'
        T[E] = 'exp'
        T[3] = 'int'
        T[2.5] = 'real'
        OUTPUT = '1 [' T[A] '] [' T[P] '] [' T[E] '] [' T[COPY(A)] ']'
        C = CONVERT(T, 'ARRAY')
        I = 0
L       I = I + 1
        OUTPUT = '2 ' DATATYPE(C[I, 1]) ' ' C[I, 2]          :S(L)
        OUTPUT = '3 ' (IDENT(C[1, 1], A) 'ident', 'differ')
        Q = P
        OUTPUT = '4 [' T[Q] '] [' T[LEN(1)] ']'
        N = .&TRACE
        T[N] = 'kwN'
        OUTPUT = '5 [' T[N] ']'
END
