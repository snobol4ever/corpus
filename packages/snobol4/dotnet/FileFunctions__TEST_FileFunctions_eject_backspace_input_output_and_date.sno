        &ERRLIMIT = 100
        E = ''
        P = LEN(2)
        R1 = OUTPUT(.F, 7, 'ejt.out')
        OUTPUT = '1 [' R1 '] ' &ERRTYPE
        F = 'x'
        R2 = EJECT(7)
        OUTPUT = '2 [' R2 '] ' &ERRTYPE
        F = 'y'
        R3 = EJECT(.F)
        OUTPUT = '3 ' &ERRTYPE
        &ERRTYPE = 0
        R4 = EJECT(8)
        OUTPUT = '4 ' &ERRTYPE
        &ERRTYPE = 0
        R5 = EJECT('OUTPUT')
        OUTPUT = '5 ' &ERRTYPE
        &ERRTYPE = 0
        R6 = EJECT(-1)
        OUTPUT = '6 ' &ERRTYPE
        &ERRTYPE = 0
        R7 = EJECT(P)
        OUTPUT = '7 ' &ERRTYPE
        &ERRTYPE = 0
        R8 = BACKSPACE(E)
        OUTPUT = '8 ' &ERRTYPE
        &ERRTYPE = 0
        R9 = BACKSPACE(9)
        OUTPUT = '9 ' &ERRTYPE
        &ERRTYPE = 0
        R10 = SET(9, 'x', 'y')
        OUTPUT = '10 ' &ERRTYPE
        &ERRTYPE = 0
        R11 = SET(E, 1, 0)
        OUTPUT = '11 ' &ERRTYPE
        &ERRTYPE = 0
        R12 = SET(P, 1, 0)
        OUTPUT = '12 ' &ERRTYPE
        &ERRTYPE = 0
        R13 = INPUT(.G, 8, 'ejt.out')
        OUTPUT = '13 [' R13 '] ' &ERRTYPE
        R14 = INPUT(.H, 8)
        OUTPUT = '14 [' R14 '] ' &ERRTYPE
        R15 = SET(8, 'x', 0)
        OUTPUT = '15 ' &ERRTYPE
        &ERRTYPE = 0
        R16 = SET(8, 0, 5)
        OUTPUT = '16 ' &ERRTYPE
        &ERRTYPE = 0
        R17 = SET(8, 1, 0)
        OUTPUT = '17 [' R17 '] ' &ERRTYPE
        R18 = OUTPUT(.J, 7)
        OUTPUT = '18 [' R18 '] ' &ERRTYPE
        R19 = OUTPUT(.K, 6, 'ejt2.out')
        OUTPUT = '19 [' R19 '] ' &ERRTYPE
        R20 = OUTPUT(.L, 6)
        OUTPUT = '20 [' R20 '] ' &ERRTYPE
        R21 = OUTPUT(.M)
        OUTPUT = '21 [' R21 '] ' &ERRTYPE
        R22 = OUTPUT(.N, E, E)
        OUTPUT = '22 [' R22 '] ' &ERRTYPE
        N = 'to stdout'
        R23 = DATE()
        OUTPUT = '23 ' SIZE(R23) ' ' &ERRTYPE
        R24 = DATE(1)
        OUTPUT = '24 ' SIZE(R24) ' ' &ERRTYPE
        R25 = DATE(2)
        OUTPUT = '25 ' SIZE(R25) ' ' &ERRTYPE
        R26 = DATE(5)
        OUTPUT = '26 ' SIZE(R26) ' ' &ERRTYPE
        R27 = DATE('x')
        OUTPUT = '27 ' &ERRTYPE
        &ERRTYPE = 0
        ENDFILE(8)
        ENDFILE(7)
        ENDFILE(6)
END
