        &ERRLIMIT = 10
        X = 'abc'
        V = ~X                                      :S(Y1)
        OUTPUT = '1 F'                              :(E1)
Y1      OUTPUT = '1 S'
E1      OUTPUT = '2 [' X ']'
        Y = X                                       :S(Y3)
        OUTPUT = '3 F'                              :(E3)
Y3      OUTPUT = '3 S [' Y ']'
E3      V = ?FAIL
        OUTPUT = '4 ' DATATYPE(V)
        V = ~FAIL                                   :S(Y5)
        OUTPUT = '5 F'                              :(E5)
Y5      OUTPUT = '5 S'
E5      V = ?FAIL                                   :S(Y6)
        OUTPUT = '6 F'                              :(E6)
Y6      OUTPUT = '6 S ' DATATYPE(V)
E6      V = 'q' X                                   :S(Y7)
        OUTPUT = '7 F'                              :(E7)
Y7      OUTPUT = '7 S [' V ']'
E7      V = EVAL('~~X')
        OUTPUT = '8 [' V ']'
        V = 'a' + ~$Q                               :S(Y9)
        OUTPUT = '9 F ' &ERRTYPE                    :(E9)
Y9      OUTPUT = '9 S'
E9      V = 'p' ~~LEN(0)
        OUTPUT = '10 ' DATATYPE(V) ' [' V ']'
        V = ~DIFFER(1, 1) 'z'
        OUTPUT = '11 [' V ']'
END
