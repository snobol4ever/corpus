
        DEFINE('bump(v)')                                           :(bumpend)
bump    bump = v + 1                                               :(RETURN)
bumpend
        S = ''
        J = 0
LOOP    S = S bump(2 * J)
        J = J + 1
        LT(J, 5)                                                    :S(LOOP)
        RESULT = S
END
