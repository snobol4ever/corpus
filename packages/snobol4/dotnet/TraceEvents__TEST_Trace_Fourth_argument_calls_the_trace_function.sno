        &TRACE = 50
        DEFINE('H(N,T)')               :(EH)
H       OUTPUT = 'H ' N ' ' T ' ' &TRACE ' ' DATATYPE(N) ' ' $N    :(RETURN)
EH      DEFINE('F(X)')                 :(EF)
F       F = X * 2                      :(RETURN)
EF      TRACE('L1', 'LABEL', 'lab', 'H')
        TRACE('F', 'FUNCTION', 'fn', .H)
        TRACE('V', 'VALUE', 'val', 'H')
        TRACE('FNCLEVEL', 'KEYWORD', 'kw', 'H')
                                       :(L1)
L1      V = F(3)
        STOPTR('V', 'VALUE')
        V = 7
        OUTPUT = V ' ' &TRACE
END
