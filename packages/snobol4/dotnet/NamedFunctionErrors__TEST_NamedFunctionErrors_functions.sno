        &ERRLIMIT = 100
        E = ''
        P = LEN(2)
        BL = '  '
        X = OPSYN(E, 'SIZE')
        OUTPUT = '1 ' &ERRTYPE
        &ERRTYPE = 0
        X = OPSYN(BL, 'SIZE', 1)
        OUTPUT = '2 ' &ERRTYPE
        &ERRTYPE = 0
        X = OPSYN(P, 'SIZE', 1)
        OUTPUT = '3 ' &ERRTYPE
        &ERRTYPE = 0
        X = OPSYN(P, 'SIZE')
        OUTPUT = '4 ' &ERRTYPE
        &ERRTYPE = 0
        X = OPSYN('MYSIZE', 'SIZE')
        OUTPUT = '5 ' MYSIZE('abc') ' ' &ERRTYPE
        &ERRTYPE = 0
        A = 1
        B = 2
        C = 3
        CLEAR(' A , B ')
        OUTPUT = '6 [' A '][' B '][' C ']'
        A = 1
        B = 2
        C = 3
        CLEAR('B')
        OUTPUT = '7 [' A '][' B '][' C ']'
        X = CLEAR('  ')
        OUTPUT = '8 ' &ERRTYPE
        &ERRTYPE = 0
        X = CLEAR('A,')
        OUTPUT = '9 ' &ERRTYPE
        &ERRTYPE = 0
        X = CLEAR(P)
        OUTPUT = '10 ' &ERRTYPE
        &ERRTYPE = 0
        W = 5
        V = 'vv'
        T = TABLE()
        T['k'] = 'tv'
        X = EVAL('W,W')
        OUTPUT = '11 ' &ERRTYPE
        &ERRTYPE = 0
        X = EVAL('(W,W)')
        OUTPUT = '12 [' X '] ' &ERRTYPE
        &ERRTYPE = 0
        X = EVAL('W ,')
        OUTPUT = '13 ' &ERRTYPE
        &ERRTYPE = 0
        X = EVAL(.V)
        OUTPUT = '14 [' X '] ' &ERRTYPE
        N = .V
        X = EVAL(N)
        OUTPUT = '15 [' X '] ' &ERRTYPE
        X = EVAL(.W)
        OUTPUT = '16 [' X '] ' &ERRTYPE
        X = EVAL(.T['k'])
        OUTPUT = '17 [' X '] ' &ERRTYPE
        &ERRTYPE = 0
        X = EVAL("'a,b'")
        OUTPUT = '18 [' X '] ' &ERRTYPE
        X = EVAL('SIZE("a,b")')
        OUTPUT = '19 [' X '] ' &ERRTYPE
        X = EVAL('W + 1')
        OUTPUT = '20 [' X '] ' &ERRTYPE
        S = ' X = 1 :(BACK)'
        C1 = CODE(.S)
        OUTPUT = '21 ' DATATYPE(C1) ' ' &ERRTYPE
        C3 = CODE(7)
        OUTPUT = '22 ' DATATYPE(C3) ' ' &ERRTYPE
        C4 = CODE(2.5)
        OUTPUT = '23 ' DATATYPE(C4) ' ' &ERRTYPE
        C7 = CODE(C3)
        OUTPUT = '24 ' DATATYPE(C7) ' ' &ERRTYPE
        &ERRTYPE = 0
        C8 = CODE(P)
        OUTPUT = '25 ' DATATYPE(C8) ' ' &ERRTYPE
        C9 = CODE(ARRAY(2))
        OUTPUT = '26 ' DATATYPE(C9) ' ' &ERRTYPE
        C10 = CONVERT(7, 'CODE')
        OUTPUT = '27 ' DATATYPE(C10) ' ' &ERRTYPE
        C11 = CONVERT(2.5, 'CODE')
        OUTPUT = '28 ' DATATYPE(C11) ' ' &ERRTYPE
END
