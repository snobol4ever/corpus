        &ERRLIMIT = 100
        SETEXIT('H')
        N = .EVAL('1 + 2')
        N = .EVAL(5)
        N = .EVAL(*(1 + 2))
        'abc' ? LEN(1) . EVAL('1 + 2')
        'abc' ? LEN(1) $ EVAL('1 + 2')
        'abc' ? @EVAL('1 + 2')
        EVAL('1 + 2') = 4
        X = 'x'
        EVAL('X') = 'y'
        S = S ' X=' X                       :(END)
H       S = S ' ' &ERRTYPE
        SETEXIT('H')                        :(CONTINUE)
END
