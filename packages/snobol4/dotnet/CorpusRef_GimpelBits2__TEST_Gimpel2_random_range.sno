
        DEFINE('RANDOM(N)')
        RAN_VAR = 1                                :(RANDOM_END)
RANDOM  RAN_VAR = REMDR(RAN_VAR * 4676., 414971.)
        RANDOM = RAN_VAR / 414971.
        RANDOM = NE(N,0) CONVERT(RANDOM * N,'INTEGER') + 1
                                                    :(RETURN)
RANDOM_END

        I = 1
LOOP    R = RANDOM(6)
        GE(R, 1)                                   :F(FAIL)
        LE(R, 6)                                   :F(FAIL)
        I = I + 1
        LE(I, 20)                                  :S(LOOP)
        OUTPUT = 'ok'
        :(END)
FAIL    OUTPUT = 'out of range'
END
