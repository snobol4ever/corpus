
        b = ARRAY(3, 10)
        DIFFER(b[2], 10)                   :F(e001)
        OUTPUT = 'FAIL 1111/001: array default value'  :(END)
e001
        DIFFER(b[1], 10)                   :F(e002)
        OUTPUT = 'FAIL 1111/002: default fills all slots' :(END)
e002
        OUTPUT = 'PASS 1111_array_default (2/2)'
END
