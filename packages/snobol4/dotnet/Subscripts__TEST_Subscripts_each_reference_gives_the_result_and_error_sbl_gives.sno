
        &ERRLIMIT = 100
        DATA('D(X,Y,Z)')
        S = 'abc'
        N = 12
        R = 2.5
        E = ''
        P = LEN(2)
        V = D(1,2,3)
        A3 = ARRAY(3)
        A3[2] = 'two'
        T3 = TABLE()
        K1 = ARRAY(2)
        K2 = TABLE()
        L = S[1]
        OUTPUT = '1 ' &ERRTYPE
        &ERRTYPE = 0
        L = N[1]
        OUTPUT = '2 ' &ERRTYPE
        &ERRTYPE = 0
        L = R[1,2]
        OUTPUT = '3 ' &ERRTYPE
        &ERRTYPE = 0
        L = E[1]
        OUTPUT = '4 ' &ERRTYPE
        &ERRTYPE = 0
        L = P[1]
        OUTPUT = '5 ' &ERRTYPE
        &ERRTYPE = 0
        L = V[1]
        OUTPUT = '6 ' &ERRTYPE
        &ERRTYPE = 0
        L = A3[K1]
        OUTPUT = '7 ' &ERRTYPE
        &ERRTYPE = 0
        L = A3[K2]
        OUTPUT = '8 ' &ERRTYPE
        &ERRTYPE = 0
        T3[K1] = 'by array'
        T3[K2] = 'by table'
        OUTPUT = '9 ' T3[K1] ' ' T3[K2] ' ' &ERRTYPE
        K3 = K1
        OUTPUT = '10 ' T3[K3]
        K4 = ARRAY(2)
        OUTPUT = '11 [' T3[K4] ']'
        L = A3[1,2]
        OUTPUT = '12 ' &ERRTYPE
        &ERRTYPE = 0
        L = T3[1,2]
        OUTPUT = '13 ' &ERRTYPE
        &ERRTYPE = 0
        L = T3[]
        OUTPUT = '14 ' &ERRTYPE
        &ERRTYPE = 0
        L = A3[]
        OUTPUT = '15 ' &ERRTYPE
        &ERRTYPE = 0
        A3[2] = 'set'
        OUTPUT = '16 ' A3[2] ' ' &ERRTYPE
        S[1] = 'x'
        OUTPUT = '17 ' &ERRTYPE
        &ERRTYPE = 0
        L = A3[4]
        OUTPUT = '18 ' &ERRTYPE
        &ERRTYPE = 0
        A3[2][1] = 'y'
        OUTPUT = '19 ' &ERRTYPE
        &ERRTYPE = 0
        L = S[1]
        OUTPUT = '20 ' &ERRTYPE
        &ERRTYPE = 0
        L = A3[2]
        OUTPUT = '21 ' L
        L = ITEM(A3, 2)
        OUTPUT = '22 ' L
        L = ITEM(S, 1)
        OUTPUT = '23 ' &ERRTYPE
END
