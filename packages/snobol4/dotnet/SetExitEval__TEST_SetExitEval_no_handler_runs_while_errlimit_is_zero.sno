        SETEXIT(.H)
        X = 1
        R = EVAL('X / 0')                         :S(A1)
        OUTPUT = '1 failed lim=' &ERRLIMIT ' t=' &ERRTYPE
A1      SETEXIT(.H)
        'abc' ? *(X / 0)                          :S(END)
        OUTPUT = '2 failed t=' &ERRTYPE           :(END)
H       OUTPUT = 'handler t=' &ERRTYPE ' lim=' &ERRLIMIT   :(CONTINUE)
END
