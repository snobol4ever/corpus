        &ERRLIMIT = 100
        DEFINE('NR()')   :(SKIP)
NR      NR = .Z   :(NRETURN)
SKIP    F = 'fvalue'
        Z = 'zvalue'
        L = ARRAY(4)
        T = TABLE()
        L[1] = .F
        OUTPUT = '1 ' DATATYPE(L[1])
        N = .F
        L[2] = N
        OUTPUT = '2 ' DATATYPE(L[2])
        T['k'] = .F
        OUTPUT = '3 ' DATATYPE(T['k'])
        T['j'] = N
        OUTPUT = '4 ' DATATYPE(T['j'])
        L[3] = NR()
        OUTPUT = '5 ' DATATYPE(L[3]) ' ' L[3]
        $L[1] = 'set through name'
        OUTPUT = '6 ' F
        $(T['k']) = 'again'
        OUTPUT = '7 ' F
        X = L[2]
        OUTPUT = '8 ' DATATYPE(X) ' ' $X
        NR() = 'via nreturn'
        OUTPUT = '12 ' Z
        L[3] = 'x'
        OUTPUT = '13 ' DATATYPE(L[3])
END
