-CASE 1
        &ERRLIMIT = 10
        SETEXIT('lab1')                                 :S(Y1)
        OUTPUT = '1 F ' &ERRTYPE                        :(E1)
Y1      OUTPUT = '1 S'
E1      SETEXIT()
        &CASE = 0
        SETEXIT('lab1')                                 :S(Y2)
        OUTPUT = '2 F ' &ERRTYPE                        :(E2)
Y2      OUTPUT = '2 S'
        SETEXIT()
E2      SETEXIT('LAB1')                                 :S(Y3)
        OUTPUT = '3 F ' &ERRTYPE                        :(E3)
Y3      OUTPUT = '3 S'
        SETEXIT()
E3      &CASE = 1
        SETEXIT('lab1')                                 :S(Y4)
        OUTPUT = '4 F ' &ERRTYPE                        :(E4)
Y4      OUTPUT = '4 S'
E4      SETEXIT()                                       :(END)
lab1    OUTPUT = 'handler'
END
