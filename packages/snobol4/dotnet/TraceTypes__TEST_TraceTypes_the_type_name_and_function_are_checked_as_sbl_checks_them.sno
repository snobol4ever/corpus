        &ERRLIMIT = 1000
        &TRIM = 0
        P = LEN(2)
        E = ''
        DEFINE('F(A)')   :(SKIP)
F       F = A   :(RETURN)
SKIP    DEFINE('H(NAME,TAG)')   :(SKIP2)
H       OUTPUT = 'handler ' NAME ' ' TAG   :(RETURN)
SKIP2
L1      OUTPUT = 'at L1'
        &TRACE = 100
        R1 = TRACE('F', 'CALL')
        OUTPUT = '1 ' &ERRTYPE
        R2 = TRACE('F', 'call')
        OUTPUT = '2 ' &ERRTYPE
        &ERRTYPE = 0
        R3 = TRACE('G', 'CALL')
        OUTPUT = '3 ' &ERRTYPE
        &ERRTYPE = 0
        R4 = TRACE('L1', 'LABEL')
        OUTPUT = '4 ' &ERRTYPE
        R5 = TRACE('NOLABEL', 'LABEL')
        OUTPUT = '5 ' &ERRTYPE
        &ERRTYPE = 0
        R6 = TRACE('ERRTYPE', 'KEYWORD')
        OUTPUT = '6 ' &ERRTYPE
        R7 = TRACE('&ERRTYPE', 'K')
        OUTPUT = '7 ' &ERRTYPE
        &ERRTYPE = 0
        R8 = TRACE('STLIMIT', 'K')
        OUTPUT = '8 ' &ERRTYPE
        &ERRTYPE = 0
        R9 = TRACE('X', 'V', 'tag', 'H')
        OUTPUT = '9 ' &ERRTYPE
        R10 = TRACE('Y', 'V', 'tag', 'NOFUNC')
        OUTPUT = '10 ' &ERRTYPE
        R11 = TRACE('Z', 'V', 'tag', 5)
        OUTPUT = '11 ' &ERRTYPE
        R12 = TRACE('W', 'V', 'tag', P)
        OUTPUT = '12 ' &ERRTYPE
        &ERRTYPE = 0
        R13 = TRACE(E, 'bogus')
        OUTPUT = '13 ' &ERRTYPE
        R14 = TRACE('bogus', E)
        OUTPUT = '14 ' &ERRTYPE
        X = 'first'
        X = 'second'
        Q = F('arg')
        R15 = STOPTR('X', 'V')
        OUTPUT = '15 ' &ERRTYPE
        X = 'third'
        R16 = STOPTR('F', 'CALL')
        OUTPUT = '16 ' &ERRTYPE
        R17 = STOPTR('NOLABEL', 'L')
        OUTPUT = '17 ' &ERRTYPE
        &ERRTYPE = 0
        R18 = STOPTR('X', 'Q')
        OUTPUT = '18 ' &ERRTYPE
        &ERRTYPE = 0
        R19 = STOPTR('', 'V')
        OUTPUT = '19 ' &ERRTYPE
        &ERRTYPE = 0
        R20 = TRACE('A1', 'ACCESS')
        T1 = A1
        T2 = A1
        R21 = TRACE('ERRTYPE', 'K')
        &ERRTYPE = 0
        R22 = TRACE(E, E, E, E)
        OUTPUT = '22 ' &ERRTYPE
        :(L1X)
L1X     OUTPUT = 'done'
END
