
        &ERRLIMIT = 10
        B = -0.5
        E = 1E300
        R1 = B ** E
        B = -1.0
        E = 1E19
        R2 = B ** E
        E = -1E300
        R3 = B ** E
        B = -2.0
        E = 1E300
        R4 = B ** E
        E4 = &ERRTYPE
        &ERRTYPE = 0
        B = -0.5
        E = -1E300
        R5 = B ** E
        E5 = &ERRTYPE
        R = R1 ' ' R2 ' ' R3 ' [' R4 '] ' E4 ' [' R5 '] ' E5
END
