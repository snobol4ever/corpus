        &ERRLIMIT = 30
        DEFINE('H()')                               :(HE)
H       H = .X                                      :(NRETURN)
HE      X = 5
        A = ARRAY(3)
        A[1] = 7
        T = TABLE()
        T['k'] = 9
        N = .X
        &ERRTYPE = 0
        V = H() + 1
        OUTPUT = '1 ' &ERRTYPE ' ' V
        &ERRTYPE = 0
        V = N + 1
        OUTPUT = '2 ' &ERRTYPE ' ' V
        &ERRTYPE = 0
        V = .A[1]
        V = V + 1
        OUTPUT = '3 ' &ERRTYPE ' ' V
        &ERRTYPE = 0
        V = .T['k']
        V = -V
        OUTPUT = '4 ' &ERRTYPE ' ' V
        &ERRTYPE = 0
        V = CONVERT('12', 'NAME')
        V = V * 2
        OUTPUT = '5 ' &ERRTYPE ' ' V
        &ERRTYPE = 0
        V = LT(N, 6)
        OUTPUT = '6 ' &ERRTYPE ' ' V
        &ERRTYPE = 0
        V = REMDR(N, 2)
        OUTPUT = '7 ' &ERRTYPE ' ' V
        &ERRTYPE = 0
        V = LEN(N)
        OUTPUT = '8 ' &ERRTYPE ' ' DATATYPE(V)
        &ERRTYPE = 0
        V = H() * H()
        OUTPUT = '9 ' &ERRTYPE ' ' V
        &ERRTYPE = 0
        V = DUPL('a', N)
        OUTPUT = '10 ' &ERRTYPE ' ' V
        &ERRTYPE = 0
        V = SIZE(N)
        OUTPUT = '11 ' &ERRTYPE ' ' V
        &ERRTYPE = 0
        V = N 'z'
        OUTPUT = '12 ' &ERRTYPE ' ' V
END
