        DEFINE('G()')
        DEFINE('MARK()')                    :(GE)
G       G = 'ZZ'                            :(RETURN)
MARK    FIRES = FIRES + 1
        MARK = ''                           :(RETURN)
GE      S = 'abcdefghi'
        A = ARRAY(1)
        N = 0
        FIRES = 0
        S 'a' . *G()                        :S(Y1)
        R = R 'n'                           :(E1)
Y1      R = R 'y'
E1      S 'b' $ *G()                        :S(Y2)
        R = R 'n'                           :(E2)
Y2      R = R 'y'
E2      S 'c' . *'ZZ'                       :S(Y3)
        R = R 'n'                           :(E3)
Y3      R = R 'y'
E3      S 'd' . *(N = N + 1)                :S(Y4)
        R = R 'n'                           :(E4)
Y4      R = R 'y'
E4      S 'e' . *(.ZZ)                      :S(Y5)
        R = R 'n'                           :(E5)
Y5      R = R 'y'
E5      S 'f' . *('Z' 'Z')                  :S(Y6)
        R = R 'n'                           :(E6)
Y6      R = R 'y'
E6      S 'g' . *DUPL('ZZ', 1)              :S(Y7)
        R = R 'n'                           :(E7)
Y7      R = R 'y'
E7      'X' ? (EPS . *MARK()) (EPS . *MARK()) :S(Y8)
        R = R 'n'                           :(E8)
Y8      R = R 'y'
E8      S 'h' . *$'ZZ'                      :S(Y9)
        R = R 'n'                           :(E9)
Y9      R = R 'y'
E9      S 'i' . *A[1]                       :S(Y10)
        R = R 'n'                           :(E10)
Y10     R = R 'y'
E10     OUTPUT = R ' N=' N ' FIRES=' FIRES ' ZZ=' ZZ ' A1=' A[1] ' G=' G
END
