        &ERRLIMIT = 30
        A = ARRAY(3)
        A[1] = 2
        T = TABLE()
        T['k'] = 3
        &ERRTYPE = 0
        V = 'none'
        V = DUPL('ab', .A[1])
        OUTPUT = '1 ' &ERRTYPE ' ' V
        &ERRTYPE = 0
        V = 'none'
        V = RPAD('u6', .A[1])
        OUTPUT = '2 ' &ERRTYPE ' ' V
        &ERRTYPE = 0
        V = 'none'
        V = CHAR(.A[1])
        OUTPUT = '3 ' &ERRTYPE ' ' V
        &ERRTYPE = 0
        V = 'none'
        V = 'u6' ? LEN(.A[1])
        OUTPUT = '4 ' &ERRTYPE ' ' V
        &ERRTYPE = 0
        V = 'none'
        V = SUBSTR('abc', .A[1])
        OUTPUT = '5 ' &ERRTYPE ' ' V
        &ERRTYPE = 0
        V = 'none'
        V = LPAD('u6', .T['k'])
        OUTPUT = '6 ' &ERRTYPE ' ' V
        &ERRTYPE = 0
        V = 'none'
        V = CONVERT(.A[1], 'INTEGER')
        OUTPUT = '7 ' &ERRTYPE ' ' V
        &ERRTYPE = 0
        V = 'none'
        V = CONVERT(.T['k'], 'REAL')
        OUTPUT = '8 ' &ERRTYPE ' ' V
        &ERRTYPE = 0
        V = 'none'
        V = DUPL('ab', .$'3')
        OUTPUT = '9 ' &ERRTYPE ' ' V
END
