        N = .X
        A = ARRAY(3) ; B = ARRAY(3) ; T = TABLE()
        R = R IDENT(N, .X) 'a'
        R = R IDENT(N, .Y) 'b'
        R = R IDENT(N, 'X') 'c'
        R = R IDENT(N) 'd'
        R = R DIFFER(N) 'e'
        R = R IDENT(.A[1], .A[1]) 'f'
        R = R IDENT(.A[1], .A[2]) 'g'
        R = R IDENT(.A[1], .B[1]) 'h'
        R = R IDENT(.T['k'], .T['k']) 'i'
        R = R IDENT(.T['k'], .T['j']) 'j'
        R = R IDENT(.&ANCHOR, .&ANCHOR) 'k'
        K = .&ANCHOR
        R = R IDENT(K, K) 'l'
END
