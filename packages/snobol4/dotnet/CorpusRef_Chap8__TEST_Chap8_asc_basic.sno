
        DEFINE('ASC(S)C')
        ASC_ONE     =  LEN(1) . C
        ASC_PAT     =  BREAK(*C) @ASC                :(ASC_END)
ASC     S           ?  ASC_ONE                       :F(FRETURN)
        &ALPHABET   ?  ASC_PAT                       :(RETURN)
ASC_END
        OUTPUT = ASC('A')
        OUTPUT = ASC(' ')
END
