
        DATA('NODE(VAL,NXT)')
        N = NODE('a', NODE('b'))
        C = COPY(N)
        VAL(C) = 'changed'
        VAL(NXT(C)) = 'deep'
        R1 = VAL(N) ' ' VAL(C) ' ' VAL(NXT(N))
        R2 = DIFFER(N,C) 'differ'
        A = ARRAY(2)
        A[1] = ARRAY(2)
        A[2] = 's'
        CA = COPY(A)
        CA[1][1] = 'inner'
        CA[2] = 't'
        R3 = A[1][1] ' ' A[2] ' ' CA[2]
        T = TABLE()
        T['k'] = ARRAY(1)
        CT = COPY(T)
        CT['k'][1] = 'ti'
        CT['j'] = 'new'
        R4 = T['k'][1] ' [' T['j'] ']'
END
