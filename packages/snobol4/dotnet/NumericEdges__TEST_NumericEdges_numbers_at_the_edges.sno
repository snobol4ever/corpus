        &ERRLIMIT = 100
        R = 3.0
        S = 1.0E-5
        X = REMDR(R, S)
        OUTPUT = '1 ' X
        X = REMDR(7, S)
        OUTPUT = '2 ' X
        X = REMDR(1.0E17, 0.3)
        OUTPUT = '3 ' X
        X = REMDR(-1.0E17, 0.3)
        OUTPUT = '4 ' X
        X = REMDR(1.5, 1.0E-5)
        OUTPUT = '5 ' X
        M = -9223372036854775807 - 1
        N = -1
        X = REMDR(M, N)
        OUTPUT = '6 ' X ' ' &ERRTYPE
        S2 = '9223372036854775808'
        X = S2 + 0
        OUTPUT = '7 [' X '] ' &ERRTYPE
        &ERRTYPE = 0
        X = -S2
        OUTPUT = '8 [' X '] ' &ERRTYPE
        &ERRTYPE = 0
        X = EQ(S2, S2)
        OUTPUT = '9 ' &ERRTYPE
        &ERRTYPE = 0
        X = CONVERT(S2, 'REAL')
        OUTPUT = '10 [' X '] ' &ERRTYPE
        &ERRTYPE = 0
        S3 = '9223372036854775808.'
        X = S3 + 0
        OUTPUT = '11 ' DATATYPE(X) ' ' X
        S4 = '-9223372036854775808'
        X = S4 + 0
        OUTPUT = '12 ' DATATYPE(X) ' ' X
        S5 = '92233720368547758080'
        X = S5 + 0
        OUTPUT = '13 [' X '] ' &ERRTYPE
        &ERRTYPE = 0
        BIG = 1.0E19
        X = CONVERT(BIG, 'INTEGER')
        OUTPUT = '14 ' DATATYPE(X) ' ' X
        X = CONVERT('1e19', 'INTEGER')
        OUTPUT = '15 ' DATATYPE(X) ' ' X
        HUGE = 1.0E100
        X = DUPL('x', HUGE)  :S(O16)F(F16)
O16     OUTPUT = '16 ok [' X ']'  :(N16)
F16     OUTPUT = '16 fails ' &ERRTYPE
N16     X = LPAD('x', HUGE)
        OUTPUT = '17 [' X '] ' &ERRTYPE
        X = SUBSTR('abc', 1, HUGE)  :S(O18)F(F18)
O18     OUTPUT = '18 ok [' X ']'  :(N18)
F18     OUTPUT = '18 fails ' &ERRTYPE
N18     Z = 0
        B = 2147483648
        X = Z ** B
        OUTPUT = '19 ' X ' ' &ERRTYPE
        X = Z ** 4294967296
        OUTPUT = '20 ' X ' ' &ERRTYPE
END
