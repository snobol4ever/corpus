        DEFINE('F(Y)')                  :(FE)
F       F = Y                           :(RETURN)
FE      T = TABLE()
        T['k'] = 'v'
        T['j'] = 'w'
        A = ARRAY(2, 'a')
        R = EVAL(*SORT(T)[1, 2]) ' ' EVAL(*F(A)[1]) ' ' EVAL(*(A)[2]) ' ' EVAL(*ARRAY(2, 'q')[1])
        E = *SORT(T)[N, 1]
        N = 2
        R = R ' ' EVAL(E) ' ' DATATYPE(E)
        'zkw' LEN(1) *SORT(T)[N, 1] @K
        R = R ' ' K
END
