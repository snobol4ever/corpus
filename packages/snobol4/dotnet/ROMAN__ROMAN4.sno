
	    DEFINE('ROMAN(N)T')			:(ROMAN_END)
ROMAN	OUTPUT = N
        N   RPOS(1)  LEN(1) . T  =		:F(RETURN)
	    '0,1I,2II,3III,4IV,5V,6VI,7VII,8VIII,9IX,'
+	    T   BREAK(',') . T			:F(FRETURN)
	    ROMAN = REPLACE(ROMAN(N), 'IVXLCDM', 'XLCDM**') T
+						:S(RETURN)F(FRETURN)
ROMAN_END
        R1 = ROMAN('1066')
        R2 = ROMAN('1492')
        R3 = ROMAN('1984')
        R4 = ROMAN('2000')
END
