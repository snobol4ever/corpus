# Subtest: where clause with only one *, but two expressions
    1..3
    ok 1 - 'sub foo($a where {* < 5 or $a > 9}) { say $a }' died
    ok 2 - right exception type (X::Syntax::Malformed)
    ok 3 - .what matches -> ;; $_? is raw = OUTER::<$_> {  \#`(Block|2348380720736) ... }
ok 13 - where clause with only one *, but two expressions
# Subtest: where clause with two *s and two expressions (with an or)
    1..3
    ok 1 - 'sub foo($a where {* < 5 or * > 9}) { say $a }' died
    ok 2 - right exception type (X::Syntax::Malformed)
    ok 3 - .what matches -> ;; $_? is raw = OUTER::<$_> {  \#`(Block|2348380720808) ... }
ok 14 - where clause with two *s and two expressions (with an or)
