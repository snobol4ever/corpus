1..18
# Subtest: attempting to raise to a huge power throws
    1..2
    ok 1 - '2**10000000000' died
    ok 2 - right exception type (X::Numeric::Overflow)
ok 1 - attempting to raise to a huge power throws
# Subtest: attempting to raise to a huge negative power throws
    1..2
    ok 1 - '2**-10000000000' died
    ok 2 - right exception type (X::Numeric::Underflow)
ok 2 - attempting to raise to a huge negative power throws
# Subtest: attempting to raise to a large negative power throws
    1..2
    ok 1 - '2**-999999' died
    ok 2 - right exception type (X::Numeric::Underflow)
ok 3 - attempting to raise to a large negative power throws
# Subtest:  2 ** 4553535345364535345634543534
