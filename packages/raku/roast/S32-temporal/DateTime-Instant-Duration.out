# Subtest: Instant:U.Date throws
    1..2
    ok 1 - code dies
    ok 2 - right exception type (Exception)
ok 62 - Instant:U.Date throws
# Subtest: Duration.new with wrong-typed arg throws
    1..2
    ok 1 - code dies
    ok 2 - right exception type (X::Str::Numeric)
ok 63 - Duration.new with wrong-typed arg throws
ok 64 - Duration.new(Inf) works
ok 65 - Duration.new(NaN) works
# Subtest: infix:<%>(Duration, Real)
    1..25
    ok 1 - Duration.new(32)  %  0.5
    ok 2 - Duration.new(32)  % -0.5
    ok 3 - Duration.new(-32) %  0.5
    ok 4 - Duration.new(-32) % -0.5
    ok 5 - Duration.new(55)  %  1
    ok 6 - Duration.new(55)  % -1
    ok 7 - Duration.new(-55) %  1
    ok 8 - Duration.new(-55) % -1
    ok 9 - Duration.new(81)  %  1.5
    ok 10 - Duration.new(81)  % -1.5
    ok 11 - Duration.new(-81) %  1.5
    ok 12 - Duration.new(-81) % -1.5
    ok 13 - Duration.new(43)  %  2
    ok 14 - Duration.new(43)  % -2
    ok 15 - Duration.new(-43) %  2
    ok 16 - Duration.new(-43) % -2
    ok 17 - Duration.new(22)  %  3
    ok 18 - Duration.new(22)  % -3
    ok 19 - Duration.new(-22) %  3
    ok 20 - Duration.new(-22) % -3
    ok 21 - Duration.new(69)  %  73786976294838206464
    ok 22 - Duration.new(69)  % -73786976294838206464
    ok 23 - Duration.new(-69) %  73786976294838206464
    ok 24 - Duration.new(-69) % -73786976294838206464
    # Subtest: Duration % 0 dies
        1..2
        ok 1 - code dies
        ok 2 - right exception type (X::Numeric::DivideByZero)
