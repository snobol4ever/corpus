# Subtest: infix:<->(Duration, Real)
    1..9
    ok 1 - -1
    ok 2 - 1
    ok 3 - 100
    ok 4 - -1e0
    ok 5 - 1e0
    ok 6 - 1e2
    ok 7 - -1.5
    ok 8 - 1.5
    ok 9 - 100.5
