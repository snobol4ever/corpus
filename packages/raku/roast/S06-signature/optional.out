# Subtest: making an "is rw" parameter optional dies with adequate error message
    1..4
    ok 1 - 'sub foo($x? is rw) {}' died
    ok 2 - right exception type (X::Trait::Invalid)
    ok 3 - .subtype matches rw
    ok 4 - .type matches is
ok 31 - making an "is rw" parameter optional dies with adequate error message
# Subtest: making an "is rw" parameter optional dies with adequate error message
    1..4
    ok 1 - 'sub foo($x is rw = 42) {}' died
    ok 2 - right exception type (X::Trait::Invalid)
    ok 3 - .type matches is
    ok 4 - .subtype matches rw
ok 32 - making an "is rw" parameter optional dies with adequate error message
# Subtest: Catch impossible default types at compile time
    1..2
    ok 1 - 'sub foo(Int $x = "omg") { }' died
    ok 2 - right exception type (X::Parameter::Default::TypeCheck)
ok 33 - Catch impossible default types at compile time
# Subtest: Catch impossible default types at compile time (code object)
    1..2
    ok 1 - 'sub foo(Bool $b = sub { False }) {}' died
    ok 2 - right exception type (X::Parameter::Default::TypeCheck)
ok 34 - Catch impossible default types at compile time (code object)
