# Subtest: optional params before required ones are forbidden
    1..2
    ok 1 - 'sub wrong1 ($a?, $b) {...}' died
    ok 2 - right exception type (X::Parameter::WrongOrder)
ok 11 - optional params before required ones are forbidden
# Subtest: ...even if they're only optional by virtue of a default
    1..2
    ok 1 - 'sub wrong2 ($a = 1, $b) {...}' died
    ok 2 - right exception type (X::Parameter::WrongOrder)
ok 12 - ...even if they're only optional by virtue of a default
# Subtest: ...and the default is 0
    1..2
    ok 1 - 'sub wrong3 ($a = 0, $b) {...}' died
    ok 2 - right exception type (X::Parameter::WrongOrder)
ok 13 - ...and the default is 0
ok 14 - die on too many parameters (was once bug RT  \#53814)
# Subtest: two commas in a row doesn't parse
    1..2
    ok 1 - 'sub rt54804( $v, $w?, $x?, $y? ) {
    #         (defined( $v ) ?? $v !! 'undef')
    #         ~ '|' ~
    #         (defined( $w ) ?? $w !! 'undef')
    #         ~ '|' ~
    #         (defined( $x ) ?? $x !! 'undef')
    #         ~ '|' ~
    #         (defined( $y ) ?? $y !! 'undef')
    #     }
    #     rt54804( 1, , 3, )' died
    ok 2 - right exception type (X::Syntax::InfixInTermPosition)
ok 15 - two commas in a row doesn't parse
