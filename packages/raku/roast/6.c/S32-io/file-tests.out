1..16
# Subtest: .e
    1..8
    ok 1 - It exists
    ok 2 - .e returns Bool
    ok 3 - It exists
    ok 4 - ~~ :e returns Bool
    ok 5 - It doesn't
    ok 6 - .e returns Bool
    ok 7 - It doesn't
    ok 8 - ~~ :e returns Bool
ok 1 - .e
# Subtest: .d
    1..2
    # Subtest: Existing file
        1..4
        ok 1 - Existing file is not a directory
        ok 2 - .d returns Bool
        ok 3 - Existing file is not a directory
        ok 4 - ~~ :d returns Bool
    ok 1 - Existing file
    # Subtest: Non-existent file
        1..4
        ok 1 - Non-existant file is also not a directory
        # Subtest: did we fails-like X::IO::DoesNotExist?
            1..2
            ok 1 - code returned a Failure
            # Subtest: Failure threw when sunk
                1..2
                ok 1 - code dies
                ok 2 - right exception type (X::IO::DoesNotExist)
            ok 2 - Failure threw when sunk
        ok 2 - did we fails-like X::IO::DoesNotExist?
        ok 3 - Non-existant file is also not a directory
        ok 4 - ~~ :d returns Bool
    ok 2 - Non-existent file
ok 2 - .d
