# Subtest: $limit works right with any combination of args
    1..5
    ok 1 - IO::Path.lines($limit)
    # Subtest: IO::Handle.lines($limit)
        1..2
        ok 1 - right lines
        ok 2 - left handle opened
    ok 2 - IO::Handle.lines($limit)
    # Subtest: IO::Handle.lines($limit, :close)
        1..4
        ok 1 - right lines (full read)
        ok 2 - closed handle (full read)
        ok 3 - right lines (slice)
        ok 4 - closed handle (slice)
    ok 3 - IO::Handle.lines($limit, :close)
    # Subtest: &lines($fh, $limit)
        1..2
        ok 1 - right lines
        ok 2 - left handle opened
    ok 4 - &lines($fh, $limit)
    # Subtest: &lines($fh, $limit, :close)
        1..4
        ok 1 - right lines (full read)
        ok 2 - closed handle (full read)
        ok 3 - right lines (slice)
        ok 4 - closed handle (slice)
    ok 5 - &lines($fh, $limit, :close)
