# Subtest: .open uses attributes by default
    1..8
    ok 1 - .nl-in remains same after open
    ok 2 - .nl-out remains same after open
    ok 3 - .encoding is Nil due to :bin
    ok 4 - .chomp remains same after open
    ok 5 - .encoding is respected
    ok 6 - .chomp is respected
    ok 7 - .nl-out is respected
    ok 8 - .nl-in is respected
ok 15 - .open uses attributes by default
# Subtest: .DESTROY does not close standard handles
    1..3
    ok 1 - IO::Handle.new(path => IO::Special.new("<STDIN>"), chomp => Bool::True, nl-in => $["\n", "\r\n"], nl-out => "\n", encoding => "utf8")
    ok 2 - IO::Handle.new(path => IO::Special.new("<STDOUT>"), chomp => Bool::True, nl-in => $["\n", "\r\n"], nl-out => "\n", encoding => "utf8")
    ok 3 - IO::Handle.new(path => IO::Special.new("<STDERR>"), chomp => Bool::True, nl-in => $["\n", "\r\n"], nl-out => "\n", encoding => "utf8")
ok 16 - .DESTROY does not close standard handles
# Subtest: .open error does not incorrectly complain about malformed UTF-8
    1..3
    ok 1 - '('a' x 975).IO.open' died
    ok 2 - right exception type (Exception)
    ok 3 - .message matches -> ;; $_? is raw = OUTER::<$_> {  \#`(Block|4937547558496) ... }
ok 17 - .open error does not incorrectly complain about malformed UTF-8
