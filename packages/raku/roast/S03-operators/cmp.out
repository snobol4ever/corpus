    ok 4 - Less; differ at pos 0
    ok 5 - More; differ at pos 0
    ok 6 - Less; differ at pos 1
    ok 7 - More; differ at pos 1
    ok 8 - Less; differ at pos 1; ignore lengths
    ok 9 - More; differ at pos 1; ignore lengths
    ok 10 - Less; differ at pos 1; ignore later elems
    ok 11 - More; differ at pos 1; ignore later elems
ok 64 - lazy array comparisons
