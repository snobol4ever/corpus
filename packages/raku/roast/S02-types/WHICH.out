# Subtest: ObjAt.raku gives distinct results for different objects
    1..18
    ok 1 - can .raku.EVAL roundtrip .WHICH for "rt"
    ok 2 - can .raku.EVAL roundtrip .WHICH for 128944
    ok 3 - can .raku.EVAL roundtrip .WHICH for IntStr.new(128944, "128944")
    ok 4 - can .raku.EVAL roundtrip .WHICH for rx/^/
    ok 5 - can .raku.EVAL roundtrip .WHICH for NaN
    ok 6 - can .raku.EVAL roundtrip .WHICH for Inf
    ok 7 - can .raku.EVAL roundtrip .WHICH for <6.283185307179586+1i>
    ok 8 - can .raku.EVAL roundtrip .WHICH for 0.5
    ok 9 - can .raku.EVAL roundtrip .WHICH for <anon|1>
    ok 10 - can .raku.EVAL roundtrip .WHICH for any("a", 42)
    ok 11 - can .raku.EVAL roundtrip .WHICH for sub {  \#`(Sub|2893989705232) ... }
    ok 12 - can .raku.EVAL roundtrip .WHICH for ->  {  \#`(Block|2893982344704) ... }
    ok 13 - can .raku.EVAL roundtrip .WHICH for method <anon> (Mu $:: *%_) {  \#`(Method|2893989705368) ... }
    ok 14 - can .raku.EVAL roundtrip .WHICH for *
    ok 15 - can .raku.EVAL roundtrip .WHICH for WhateverCode.new
    ok 16 - can .raku.EVAL roundtrip .WHICH for Promise.new(scheduler => ThreadPoolScheduler.new(uncaught_handler => Callable), status => PromiseStatus::Kept)
    ok 17 - can .raku.EVAL roundtrip .WHICH for Supply.new
    ok 18 - number of unique .WHICH.rakus matches number of objects we tested
ok 1655 - ObjAt.raku gives distinct results for different objects
ok 1656 - cloned Bag does not lose WHICH
# Subtest: Mixins to Code:U objects do not cause crash on .WHICH
    1..6
    ok 1 - Method
    ok 2 - Submethod
    ok 3 - Sub
    ok 4 - Block
    ok 5 - Code
    ok 6 - Whatever
