    1..6
    ok 1 - sprintf("% 0+ \#-8.*e",2,0) eq '+0.00e+00'
    ok 2 - sprintf("% 0+ \#-8.*E",2,0) eq '+0.00E+00'
    ok 3 - sprintf("% 0+ \#-8.*e",2,27.1) eq '+2.71e+01'
    ok 4 - sprintf("% 0+ \#-8.*E",2,27.1) eq '+2.71E+01'
    ok 5 - sprintf("% 0+ \#-8.*e",2,-2.71) eq '-2.71e+00'
    ok 6 - sprintf("% 0+ \#-8.*E",2,-2.71) eq '-2.71E+00'
ok 2281 - Tested '% 0+ \#-8.*e'
# Subtest: Tested '% 0+-#8.*e'
    1..6
    ok 1 - sprintf("% 0+- \#8.*e",2,0) eq '+0.00e+00'
    ok 2 - sprintf("% 0+- \#8.*E",2,0) eq '+0.00E+00'
    ok 3 - sprintf("% 0+- \#8.*e",2,27.1) eq '+2.71e+01'
    ok 4 - sprintf("% 0+- \#8.*E",2,27.1) eq '+2.71E+01'
    ok 5 - sprintf("% 0+- \#8.*e",2,-2.71) eq '-2.71e+00'
    ok 6 - sprintf("% 0+- \#8.*E",2,-2.71) eq '-2.71E+00'
ok 2282 - Tested '% 0+- \#8.*e'
