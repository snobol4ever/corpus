#--------------------------------------------------------- 892 set-consolidation
[Set(A B) Set(C D)]
    ==> (Set(C D) Set(A B))
[Set(A B) Set(B D)]
    ==> (Set(A B D))
[Set(A B) Set(C D) Set(B D)]
    ==> (Set(A B C D))
[Set(H I K) Set(A B) Set(C D) Set(B D) Set(F G H)]
    ==> (Set(A B C D) Set(F G H I K))
