Example 1:
Input: @matrix = [ [1, 2, 3],
                   [4, 5, 6],
                   [7, 8, 9] ]
       $k = 1
Output: [ [9, 1, 2],
          [3, 4, 5],
          [6, 7, 8] ]

Example 2:
Input: @matrix = [ [10, 20],
                   [30, 40] ]
       $k = 1
Output: [ [40, 10],
          [20, 30] ]

Example 3:
Input: @matrix = [ [1, 2],
                   [3, 4],
                   [5, 6] ]
       $k = 1
Output: [ [6, 1],
          [2, 3],
          [4, 5] ]

Example 4:
Input: @matrix = [ [1, 2, 3],
                   [4, 5, 6] ]
       $k = 5
Output: [ [2, 3, 4],
          [5, 6, 1] ]

Example 5:
Input: @matrix = [ [1, 2, 3, 4] ]
       $k = 1
Output: [ [4, 1, 2, 3] ]
