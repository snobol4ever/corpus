Example 1:
Input: @arr1 = ("a", "bc")
       @arr2 = ("ab", "c")
Output: True

Example 2:
Input: @arr1 = ("a", "b", "c")
       @arr2 = ("a", "bc")
Output: True

Example 3:
Input: @arr1 = ("a", "bc")
       @arr2 = ("a", "c", "b")
Output: False

Example 4:
Input: @arr1 = ("ab", "c", "")
       @arr2 = ("", "a", "bc")
Output: True

Example 5:
Input: @arr1 = ("p", "e", "r", "l")
       @arr2 = ("perl")
Output: True
