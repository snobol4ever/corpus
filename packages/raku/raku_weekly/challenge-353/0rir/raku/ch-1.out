1..5
ok 1 - 4 <- $("Hello world", "This is a test", "Perl is great")
ok 2 - 1 <- $("Single",)
ok 3 - 7 <- $("Short", "This sentence has seven words in total", "A B C", "Just four words here")
ok 4 - 3 <- $("One", "Two parts", "Three part phrase", "")
ok 5 - 10 <- $("The quick brown fox jumps over the lazy dog", "A", "She sells seashells by the seashore", "To be or not to be that is the question")

Input: @sentence = ("Hello world", This is a test", Perl is great")
Output: 4
