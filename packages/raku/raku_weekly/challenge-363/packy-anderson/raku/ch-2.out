Example 1:
Input: $ip_addr = "192.168.1.45"
       $domain  = "192.168.1.0/24"
Output: True

Example 2:
Input: $ip_addr = "10.0.0.256"
       $domain  = "10.0.0.0/24"
Output: False

Example 3:
Input: $ip_addr = "172.16.8.9"
       $domain  = "172.16.8.9/32"
Output: True

Example 4:
Input: $ip_addr = "172.16.4.5"
       $domain  = "172.16.0.0/14"
Output: True

Example 5:
Input: $ip_addr = "192.0.2.0"
       $domain  = "192.0.2.0/25"
Output: True
