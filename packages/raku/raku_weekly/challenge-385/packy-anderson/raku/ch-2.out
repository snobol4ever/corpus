Example 1:
Input: $str = "()()()"
Output: ""

Primitive Decomposition: "()" + "()" + "()"

Example 2:
Input: $str = "(((())))"
Output: "((()))"

Primitive Decomposition: "(((())))"

Example 3:
Input: $str = "(()())(())"
Output: "()()()"

Primitive Decomposition: "(()())" + "(())"

Example 4:
Input: $str = "()((()))()"
Output: "(())"

Primitive Decomposition: "()" + "((()))" + "()"

Example 5:
Input: $str = "(()(()))(()())"
Output: "()(())()()"

Primitive Decomposition: "(()(()))" + "(()())"
