Example 1:
Input: @matrix = [
                   [1, 2, 3, 4],
                   [2, 3, 4, 1],
                   [3, 4, 1, 2],
                   [4, 1, 2, 3]
                 ]
Output: True

Example 2:
Input: @matrix = [
                   [1]
                 ]
Output: True

Example 3:
Input: @matrix = [
                   [1, 2, 5],
                   [5, 1, 2],
                   [2, 5, 1]
                 ]
Output: False

Example 4:
Input: @matrix = [
                   [1, 2, 3],
                   [1, 2, 3],
                   [1, 2, 3]
                 ]
Output: False

Example 5:
Input: @matrix = [
                   [1, 2, 3],
                   [3, 1, 2],
                   [3, 2, 1]
                 ]
Output: False
