sub show(*@cps) {
    my $u = Uni.new(|@cps);
    say $u.elems, ' ', $u.NFC.list.join(','), ' | ', $u.NFD.list.join(','), ' | ', $u.NFKC.list.join(','), ' | ', $u.NFKD.list.join(',');
}
