ok 13 - Reopened account does not retain balance
# Subtest: Cannot withdraw more than deposited
    ok 1 - operations
    # Subtest: error
        1..3
        ok 1 - code dies
        ok 2 - right exception type (X::BankAccount::NoOverdraft)
        ok 3 - .message matches /^ "amount must be less than balance" $/
    ok 2 - error
    1..2
ok 14 - Cannot withdraw more than deposited
# Subtest: Cannot withdraw negative
    ok 1 - operations
    # Subtest: error
        1..3
        ok 1 - code dies
        ok 2 - right exception type (X::BankAccount::AmountNotPositive)
        ok 3 - .message matches /^ "amount must be greater than 0" $/
    ok 2 - error
    1..2
ok 15 - Cannot withdraw negative
