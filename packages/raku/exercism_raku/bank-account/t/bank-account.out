# Subtest: Cannot open an already opened account
    ok 1 - operations
    # Subtest: error
        1..3
        ok 1 - code dies
        ok 2 - right exception type (X::BankAccount::AlreadyOpen)
        ok 3 - .message matches /^ "account already open" $/
