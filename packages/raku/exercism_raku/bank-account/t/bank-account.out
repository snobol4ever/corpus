# Subtest: Cannot check balance of closed account
    ok 1 - operations
    # Subtest: error
        1..3
        ok 1 - code dies
        ok 2 - right exception type (X::BankAccount::Closed)
        ok 3 - .message matches /^ "account not open" $/
    ok 2 - error
    1..2
ok 7 - Cannot check balance of closed account
