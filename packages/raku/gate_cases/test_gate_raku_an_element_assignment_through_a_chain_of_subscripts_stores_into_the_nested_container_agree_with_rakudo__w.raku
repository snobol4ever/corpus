my @a;
@a[1][2] = 5;
say @a;
my @b;
@b[3] = 1;
say @b;
say @b.elems;
my @c = 1, 2;
@c[4] = 9;
say @c;
my %h;
%h<a><b><c> = 1;
say %h;
my @m;
@m[0][0] = 1;
@m[1][1] = 2;
say @m;
my @g = [1, 2], [3, 4];
@g[1][0] += 5;
@g[0][1]++;
say @g;
my %n = a => [1, 2];
%n<a>[1] = 7;
%n<b>[0] = 8;
say %n<a>;
say %n<b>;
my @t;
@t[2]<k> = 3;
say @t[2]<k>;
my $x = [[1, 2], [3, 4]];
$x[1][1] = 9;
say $x;
say $x[1][1];
my @src;
my @dst;
for flat(1 .. 4 X 1 .. 4) -> $i, $j { @src[$i][$j] = $i + $j }
for flat(1 .. 4 X 1 .. 4) -> $i, $j { @dst[$i][$j] = @src[$i][$j] }
say @dst[4][4];
say @dst[2][3];
say @dst.elems;
my @it = $[1, 2];
say $[3, 4].WHAT;
my @rows = ($[5, 6], $[7]);
say @rows[0].WHAT;
my @ma = 3, 1, 2;
@ma .= sort;
say @ma;
@ma .= reverse;
say @ma;
my @mb = 1, 2, 3;
@mb .= map(* * 2);
say @mb;
@mb>>++;
say @mb;
my @mc = 1, 2, 3;
@mc>>--;
say @mc;
my %mh = b => 2, a => 1;
%mh .= grep({ $_.value > 1 });
say %mh;
