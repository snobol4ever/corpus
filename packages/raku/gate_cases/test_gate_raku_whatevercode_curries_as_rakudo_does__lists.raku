say (1,2,3).map(* * 2);
say (1,2,3,4).grep(* > 2);
say (3,1,2).sort(-*);
say (1,2,3).first(* > 1);
my @a = 1,2,3,4;
say @a.map(* + 10);
say @a.grep(* %% 2).map(* ** 2);
say @a.sort(-*).map(*.Str);
say @a.reduce(* + *);
say (<b a c>).sort(*.ord);
say @a[*-1] + 1;
say @a.map({ $_ * 2 }).map(* - 1);
my $inc = * + 1; my $dbl = * * 2;
say $inc($dbl(5));
say (1,2,3).map(-> $x { $x + 1 });
say <a b c>.map(* ~ "!");
say (* ** 2)(4);
say (2 ** *)(5);
say (* > 1 ?? "a" !! "b")(1) if False;
