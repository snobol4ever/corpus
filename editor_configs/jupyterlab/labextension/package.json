{
  "name": "scrip-highlight",
  "version": "0.1.0",
  "description": "Syntax colouring in JupyterLab and Notebook for the languages of the SCRIP kernel: SNOBOL4, Snocone, Icon, Prolog",
  "license": "MIT",
  "main": "src/index.js",
  "files": [
    "src/*.js",
    "grammars/*.json"
  ],
  "scripts": {
    "build": "jupyter labextension build .",
    "test": "node test/tokens.mjs"
  },
  "dependencies": {
    "@codemirror/language": "^6.0.0",
    "@jupyterlab/codemirror": "^4.0.0"
  },
  "devDependencies": {
    "@jupyterlab/builder": "^4.5.2"
  },
  "jupyterlab": {
    "extension": true,
    "outputDir": "labextension",
    "sharedPackages": {
      "@jupyterlab/codemirror": {
        "bundled": false,
        "singleton": true
      },
      "@codemirror/language": {
        "bundled": false,
        "singleton": true
      }
    },
    "_build": {
      "load": "static/remoteEntry.1e2a5c8210e046bd3827.js",
      "extension": "./extension"
    }
  }
}
