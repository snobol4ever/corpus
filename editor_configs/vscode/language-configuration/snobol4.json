{
  "comments": {
    "lineComment": { "comment": "*", "noIndent": true }
  },
  "brackets": [["(", ")"], ["[", "]"], ["<", ">"]],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [["(", ")"], ["[", "]"], ["<", ">"], ["'", "'"], ["\"", "\""]],
  "folding": {
    "markers": {
      "start": "^\\*\\s*#?region\\b",
      "end": "^\\*\\s*#?endregion\\b"
    }
  },
  "wordPattern": "[A-Za-z][A-Za-z0-9._]*|\\d+(\\.\\d+)?"
}
