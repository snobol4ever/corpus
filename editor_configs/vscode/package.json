{
  "name": "scrip",
  "displayName": "SCRIP",
  "description": "The languages SCRIP runs: SNOBOL4, Snocone, Rebus, Icon and Unicon, Prolog, Pascal, SCRIPtix documents and the SCRIP notebook kernel.",
  "version": "0.1.0",
  "publisher": "scrip",
  "license": "SEE LICENSE IN the SCRIP repository",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "dependencies": {
    "vscode-languageclient": "9.0.1"
  },
  "contributes": {
    "languages": [
      {
        "id": "snobol4",
        "aliases": ["SNOBOL4", "SPITBOL", "snobol"],
        "extensions": [".sno", ".spt", ".sbl"],
        "configuration": "./language-configuration/snobol4.json"
      },
      {
        "id": "snocone",
        "aliases": ["Snocone"],
        "extensions": [".sc"],
        "configuration": "./language-configuration/snocone.json"
      },
      {
        "id": "rebus",
        "aliases": ["Rebus"],
        "extensions": [".reb"],
        "configuration": "./language-configuration/rebus.json"
      },
      {
        "id": "icon",
        "aliases": ["Icon", "Unicon"],
        "extensions": [".icn"],
        "configuration": "./language-configuration/icon.json"
      },
      {
        "id": "prolog",
        "aliases": ["Prolog"],
        "extensions": [".pro", ".prolog", ".plt"],
        "configuration": "./language-configuration/prolog.json"
      },
      {
        "id": "pascal",
        "aliases": ["Pascal", "Free Pascal", "Object Pascal"],
        "extensions": [".pas", ".p", ".pp", ".lpr", ".dpr"],
        "configuration": "./language-configuration/pascal.json"
      },
      {
        "id": "scrip",
        "aliases": ["SCRIP", "SCRIP notebook cell"],
        "configuration": "./language-configuration/snobol4.json"
      },
      {
        "id": "scriptix",
        "aliases": ["SCRIPtix"],
        "extensions": [".scrip"],
        "configuration": "./language-configuration/scriptix.json"
      }
    ],
    "grammars": [
      {
        "language": "raku",
        "scopeName": "source.raku",
        "path": "./syntaxes/raku.tmLanguage.json"
      },
      {
        "language": "pascal",
        "scopeName": "source.pascal",
        "path": "./syntaxes/pascal.tmLanguage.json"
      },
      {
        "language": "snobol4",
        "scopeName": "source.sno",
        "path": "./syntaxes/snobol4.tmLanguage.json"
      },
      {
        "language": "snocone",
        "scopeName": "source.sc",
        "path": "./syntaxes/snocone.tmLanguage.json"
      },
      {
        "language": "rebus",
        "scopeName": "source.reb",
        "path": "./syntaxes/rebus.tmLanguage.json"
      },
      {
        "language": "prolog",
        "scopeName": "source.pl",
        "path": "./syntaxes/prolog.tmLanguage.json"
      },
      {
        "language": "icon",
        "scopeName": "source.icn",
        "path": "./syntaxes/icon.tmLanguage.json"
      },
      {
        "language": "scriptix",
        "scopeName": "text.scriptix",
        "path": "./syntaxes/scriptix.tmLanguage.json"
      },
      {
        "scopeName": "scrip.fences.injection",
        "path": "./syntaxes/scrip-fences.tmLanguage.json",
        "injectTo": ["text.html.markdown", "text.scriptix"],
        "embeddedLanguages": {
          "meta.embedded.block.snobol4": "snobol4",
          "meta.embedded.block.snocone": "snocone",
          "meta.embedded.block.rebus": "rebus",
          "meta.embedded.block.icon": "icon",
          "meta.embedded.block.prolog": "prolog",
          "meta.embedded.block.pascal": "pascal",
          "meta.embedded.block.raku": "raku"
        }
      }
    ],
    "debuggers": [
      {
        "type": "scrip",
        "label": "SCRIP",
        "languages": ["snobol4", "snocone", "rebus", "icon", "prolog", "pascal", "raku"],
        "configurationAttributes": {
          "launch": {
            "required": ["program"],
            "properties": {
              "program": { "type": "string", "description": "The SCRIP program to debug.", "default": "${file}" },
              "args": { "type": "array", "items": { "type": "string" }, "description": "The arguments the program is given.", "default": [] },
              "runtimeArgs": { "type": "array", "items": { "type": "string" }, "description": "The arguments of the SCRIP engine itself, put after --debug and before the program, for example [\"-s64m\"].", "default": [] },
              "cwd": { "type": "string", "description": "The folder the program runs in.", "default": "${workspaceFolder}" },
              "console": { "type": "string", "enum": ["internalConsole", "integratedTerminal"], "description": "Where the program's input and output go.", "default": "internalConsole" },
              "stopOnEntry": { "type": "boolean", "description": "Stop at the program's first statement.", "default": false },
              "env": { "type": "object", "additionalProperties": { "type": "string" }, "description": "Environment variables of the program.", "default": {} }
            }
          }
        },
        "initialConfigurations": [
          { "type": "scrip", "request": "launch", "name": "Debug the current SCRIP file", "program": "${file}", "stopOnEntry": false }
        ],
        "configurationSnippets": [
          {
            "label": "SCRIP: Launch the current file",
            "description": "Debug the file open in the editor.",
            "body": { "type": "scrip", "request": "launch", "name": "Debug the current SCRIP file", "program": "^\"\\${file}\"", "stopOnEntry": false }
          },
          {
            "label": "SCRIP: Launch a program with arguments",
            "description": "Debug a program of your choice with arguments.",
            "body": { "type": "scrip", "request": "launch", "name": "Debug ${1:a SCRIP program}", "program": "^\"\\${workspaceFolder}/${2:program.sno}\"", "args": [], "stopOnEntry": false }
          }
        ]
      }
    ],
    "breakpoints": [
      { "language": "snobol4" },
      { "language": "snocone" },
      { "language": "rebus" },
      { "language": "icon" },
      { "language": "prolog" },
      { "language": "pascal" },
      { "language": "raku" }
    ],
    "commands": [
      {
        "command": "scrip.openPlAsProlog",
        "category": "SCRIP",
        "title": "Open .pl files as Prolog"
      },
      {
        "command": "scrip.runFile",
        "category": "SCRIP",
        "title": "Run file"
      }
    ],
    "configuration": {
      "title": "SCRIP",
      "properties": {
        "scrip.path": {
          "type": "string",
          "default": "/home/install/bin/scrip",
          "description": "The scrip binary that runs a program or a SCRIPtix document and that the language client starts as scrip --lsp."
        },
        "scrip.trace.server": {
          "type": "string",
          "enum": ["off", "messages", "verbose"],
          "default": "off",
          "description": "Traces the messages between VS Code and the SCRIP language server in the SCRIP Language Server output channel."
        }
      }
    },
    "taskDefinitions": [
      {
        "type": "scrip",
        "required": ["file"],
        "properties": {
          "file": {
            "type": "string",
            "description": "The program or SCRIPtix document to run, as an absolute path or ${file}."
          }
        }
      }
    ],
    "problemMatchers": [
      {
        "name": "scrip",
        "owner": "scrip",
        "source": "scrip",
        "severity": "error",
        "fileLocation": "absolute",
        "pattern": [
          { "regexp": "^scrip: error (\\d+): (.*)$", "code": 1, "message": 2 },
          { "regexp": "^\\s+at (.+):(\\d+)$", "file": 1, "line": 2 }
        ]
      },
      {
        "name": "scrip-icon",
        "owner": "scrip",
        "source": "scrip",
        "severity": "error",
        "fileLocation": "absolute",
        "pattern": { "regexp": "^icon: parse error in (.+): line (\\d+): (.*)$", "file": 1, "line": 2, "message": 3 }
      },
      {
        "name": "scrip-prolog",
        "owner": "scrip",
        "source": "scrip",
        "severity": "error",
        "fileLocation": "absolute",
        "pattern": { "regexp": "^(.+):(\\d+): parse error: (.*)$", "file": 1, "line": 2, "message": 3 }
      },
      {
        "name": "scrip-pascal",
        "owner": "scrip",
        "source": "scrip",
        "severity": "error",
        "fileLocation": "absolute",
        "pattern": [
          { "regexp": "^pascal parse error line (\\d+): (.*)$", "line": 1, "message": 2 },
          { "regexp": "^pascal: parse error in (.+)$", "file": 1 }
        ]
      },
      {
        "name": "scrip-raku",
        "owner": "scrip",
        "source": "scrip",
        "severity": "error",
        "fileLocation": "absolute",
        "pattern": { "regexp": "^(.+):(\\d+):(\\d+): raku syntax error: (.*)$", "file": 1, "line": 2, "column": 3, "message": 4 }
      },
      {
        "name": "scrip-snocone",
        "owner": "scrip",
        "source": "scrip",
        "severity": "error",
        "fileLocation": "absolute",
        "pattern": { "regexp": "^(.+):(\\d+): snocone parse error: (.*)$", "file": 1, "line": 2, "message": 3 }
      }
    ]
  }
}
