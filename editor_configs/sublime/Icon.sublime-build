{
//  Icon build: runs the open file by scrip; its output is shown in Sublime's build panel.
//  scrip must be on PATH, or set "path" to the folder holding it.
//  Several Icon files run together by naming each one as an argument: scrip --run a.icn b.icn.
    "shell_cmd": "scrip --run \"$file\"",

//  scrip prints a refusal as "at FILE:LINE" under its error line (SNOBOL4, Icon) or as "FILE:LINE: message" (Prolog);
//  this regex takes both, so the panel's links jump to the line. A file name with a space is not linked.
    "file_regex": "^(?:  at )?([^ :]+):([0-9]+)(?::[0-9]+)?(?:: | *$)",

    "selector": "source.icn",
    "file_patterns": ["*.icn"],
    "target": "exec",
    "cancel": {"kill": true}
}
