{
//  SCRIPtix build: runs the open .md document as ONE program by scrip, as VS Code's run does: scrip --run on the whole file.
//  scrip reads the document itself; each fence whose label names a language scrip runs is one part of the program, in order,
//  so a name one fence sets is seen by the fences after it, and the answers of the whole document show in Sublime's build panel.

    "shell_cmd": "scrip --run \"$file\"",

//  scrip prints a refusal as "at FILE:LINE" under its error line (SNOBOL4, Icon) or as "FILE:LINE: message" (Prolog);
//  this regex takes both, so the panel's links jump to the line. A file name with a space is not linked.
    "file_regex": "^(?:  at )?([^ :]+):([0-9]+)(?::[0-9]+)?(?:: | *$)",

    "selector": "text.html.markdown.scriptix",
    "file_patterns": ["*.md"],
    "target": "exec",
    "cancel": {"kill": true}
}
