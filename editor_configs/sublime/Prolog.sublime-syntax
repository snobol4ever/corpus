%YAML 1.2
---
# See http://www.sublimetext.com/docs/syntax.html
#
# Prolog.sublime-syntax: the colouring of SCRIP Prolog, the fourth of the family (SNOBOL4 by Lon, Snocone by Claude Sonnet, Icon by Claude, Prolog by Claude Fable).
#
# EVERY RULE IS READ FROM bootstrap/parser_prolog.sc AND CITED BY ITS LINE (plan scrip_ide D3b; Lon 2026-11-21 13:4x CST: "Best grammar definitions are
# parser.sc programs."): the comment above a rule names parser_prolog.sc:N, the line that defines the token the rule colours. The VS Code grammar
# (editor_configs/vscode/syntaxes/prolog.tmLanguage.json) is CONVERTED from this file by util_sublime_to_highlight_grammar.py --write-tm and the
# JupyterLab grammar by --write; neither is written by hand, and a change of a colour is made here and nowhere else.
#
# THE DIALECT THIS FILE COLORS IS SCRIP PROLOG, as parser_prolog.sc reads it. The first check of the cites (developer_04, 2026-11-21, SCRIP 96143aae2) found
# the file right in the facts below and wrong in four, each MEASURED on scrip --run and marked at its rule as a NOTE; no colour is changed by the cites, since a
# colour change is a row of its own (D3b):
#   * BLOCK COMMENTS DO NOT NEST: the first */ closes the comment (parser_prolog.sc:4); SWI nests, SCRIP does not, and neither does this file.
#   * % COMMENTS run to the end of the line (parser_prolog.sc:3).
#   * QUOTED ATOMS ('...') and STRINGS ("...") are multi-line, take backslash escapes, and double their own quote (parser_prolog.sc:118, 139).
#   * NUMBERS: 0'c character codes, 0b 0o 0x radix integers with _ groups, floats with an exponent, bare 2e8, NaN and Inf tails (parser_prolog.sc:16-18, 161-172).
#     A SCRIP EXTENSION: digit groups may be separated by single spaces, so 1 000 000 is one integer to the reader (parser_prolog.sc:18); a syntax file
#     cannot join tokens across spaces, so each group colours as its own number, a cosmetic limit.
#   * VARIABLES start upper case or underscore; a lone _ is the anonymous variable (parser_prolog.sc:13-15).
#   * GRAPHIC ATOMS are maximal-munch runs over the graphic characters (parser_prolog.sc:55-58); a clause ends at a . followed by white space or the end of
#     the text (parser_prolog.sc:23), so =.. is one operator and X.Y never ends a clause.
#   * THE FOUR DIFFERENCES: (1) SCRIP reads the operator words div and rdiv and as (parser_prolog.sc:27-29, 50-51); this file colours is mod rem xor only.
#     (2) SCRIP reads the escapes \s \d \u \U and \c (parser_prolog.sc:95-98, 114); the escape variable lacks them. (3) SCRIP refuses 0X1F and 0B101 (a parse
#     error, as swipl); the radix rules below colour them as numbers. (4) the directive words of parser_prolog.sc:392-395 include thread_local, volatile,
#     thread_initialization, public, table and record, which the directive rule lacks.
#
# Builtin predicates colored support.function are the names the lowerers wire (the Prolog lowerer); parser_prolog.sc holds no list of them, so the
# list cites the Atom token it is made of. A predicate SCRIP does not implement reads as a plain atom, which is the truth.
#
# Scope vocabulary kept consistent with the other files of the family so one color scheme renders every dialect alike.

name: Prolog
file_extensions: [pl]
scope: source.pl

variables:
  # parser_prolog.sc:13-15, Var_first and Var_rest: upper case or _, then letters, digits and _.
  var: '\b[A-Z][0-9A-Za-z_]*\b|(?<![0-9A-Za-z_])_[0-9A-Za-z_]+\b'
  # parser_prolog.sc:10-12, Atom_first and Atom_rest: lower case, then letters, digits and _.
  atom: '\b[a-z][0-9A-Za-z_]*\b'
  # parser_prolog.sc:95-100 and 114, Escape and EscNone. NOTE: the parser also reads \s \d \u \U and \c, which this variable lacks (difference 2 of the header).
  escape: '\\(?:[abfnrtve\\''"`]|[0-7]+\\?|x\h+\\?|\n)'
  # parser_prolog.sc:55-58, Graphic_first and Graphic_rest.
  graphic: '[+\-*/\\^<>=~?@#&:.!]'

contexts:
  main:
    - include: comments
    - include: necks
    - include: numbers
    - include: strings
    - include: quoted-atoms
    - include: variables
    - include: cut
    - include: operators
    - include: words
    - include: punctuation

  comments:
    # parser_prolog.sc:3, a % comment to the end of the line.
    - match: '%'
      scope: punctuation.definition.comment.pl
      push:
        - meta_scope: comment.line.percentage.pl
        # parser_prolog.sc:3, the line's end closes it.
        - match: $
          pop: true
    # parser_prolog.sc:4, a block comment, non-nesting.
    - match: '/\*'
      scope: punctuation.definition.comment.begin.pl
      push:
        - meta_scope: comment.block.pl
        # parser_prolog.sc:4, the first */ closes it.
        - match: '\*/'
          scope: punctuation.definition.comment.end.pl
          pop: true

  necks:
    # parser_prolog.sc:24 for :- and parser_prolog.sc:392-395 for the declaration words (pfx_kw_name); use_module is read at parser_prolog.sc:246. NOTE:
    # difference 4 of the header.
    - match: '(:-)\s*(dynamic|discontiguous|multifile|module_transparent|meta_predicate|use_module|ensure_loaded|initialization|module|mode|op|current_prolog_flag|if|elif|else|endif)\b'
      captures:
        1: keyword.operator.definition.pl
        2: keyword.other.directive.pl
    # parser_prolog.sc:24 (:-), parser_prolog.sc:54 (?-), parser_prolog.sc:30 (-->).
    - match: ':-|\?-|-->'
      scope: keyword.operator.definition.pl

  numbers:
    # parser_prolog.sc:17 and parser_prolog.sc:171-172, Char_code and CharCode: 0' then one character, an escape or a doubled quote.
    - match: '0''(?:\\(?:[abfnrtve\\''"`]|[0-7]+\\?|x\h+\\?)|''''|.)'
      scope: constant.character.pl
    # parser_prolog.sc:166 and parser_prolog.sc:163, 0b and BinGroups. NOTE: the parser reads the lower-case 0b alone; SCRIP refuses 0B101 (difference 3 of the
    # header).
    - match: '\b0[bB][01_]+\b'
      scope: constant.numeric.integer.binary.pl
    # parser_prolog.sc:165 and parser_prolog.sc:162, 0o and OctGroups. NOTE: lower-case 0o alone (difference 3 of the header).
    - match: '\b0[oO][0-7_]+\b'
      scope: constant.numeric.integer.octal.pl
    # parser_prolog.sc:164 and parser_prolog.sc:161, 0x and HexGroups. NOTE: lower-case 0x alone; SCRIP refuses 0X1F (difference 3 of the header).
    - match: '\b0[xX][\h_]+\b'
      scope: constant.numeric.integer.hexadecimal.pl
    # parser_prolog.sc:16, Float: digits, a dot, digits, an optional exponent and an optional NaN or Inf tail.
    - match: '\b[0-9]+\.[0-9]+(?:[eE][+-]?[0-9]+)?(?:NaN|Inf)?\b'
      scope: constant.numeric.float.pl
    # parser_prolog.sc:16, Float: digits and an exponent alone.
    - match: '\b[0-9]+[eE][+-]?[0-9]+\b'
      scope: constant.numeric.float.pl
    # parser_prolog.sc:18, Int: digit groups; a space-separated group is the same integer to the reader (see the header).
    - match: '\b[0-9]+\b'
      scope: constant.numeric.integer.pl

  strings:
    # parser_prolog.sc:152, Str: a double-quoted text.
    - match: '"'
      scope: punctuation.definition.string.begin.pl
      push:
        - meta_scope: string.quoted.double.pl
        # parser_prolog.sc:141 and parser_prolog.sc:145, an escape in a string.
        - match: '{{escape}}'
          scope: constant.character.escape.pl
        # parser_prolog.sc:152, the closing double quote.
        - match: '"'
          scope: punctuation.definition.string.end.pl
          pop: true

  quoted-atoms:
    # parser_prolog.sc:122 and parser_prolog.sc:138, Qatom and QatomP: a quoted atom.
    - match: ''''
      scope: punctuation.definition.string.begin.pl
      push:
        - meta_scope: string.quoted.single.pl
        # parser_prolog.sc:118 and parser_prolog.sc:132, a doubled quote is one quote.
        - match: ''''''
          scope: constant.character.escape.pl
        # parser_prolog.sc:119 and parser_prolog.sc:134, an escape in a quoted atom.
        - match: '{{escape}}'
          scope: constant.character.escape.pl
        # parser_prolog.sc:122, the closing quote.
        - match: ''''
          scope: punctuation.definition.string.end.pl
          pop: true

  variables:
    # parser_prolog.sc:13, Var_first: a lone _ is the anonymous variable.
    - match: '(?<![0-9A-Za-z_])_(?![0-9A-Za-z_])'
      scope: variable.language.anonymous.pl
    # parser_prolog.sc:13-15, Var.
    - match: '{{var}}'
      scope: variable.other.pl

  cut:
    # parser_prolog.sc:33, Tk_cut.
    - match: '!'
      scope: keyword.control.cut.pl

  operators:
    # parser_prolog.sc:34-42, the comparison operators =:= =\= == \== >= =< > < \= =.. @>= @=< @> @<.
    - match: '=\.\.|=:=|=\\=|\\==|@=<|@>=|=<|>=|==|@<|@>|\\=|<|>'
      scope: keyword.operator.comparison.pl
    # parser_prolog.sc:53 for -> and parser_prolog.sc:21 for ;.
    - match: '->|;'
      scope: keyword.operator.logical.pl
    # parser_prolog.sc:297, the prefix \+.
    - match: '\\\+'
      scope: keyword.operator.logical.negation.pl
    # parser_prolog.sc:25-26 for + - * /, parser_prolog.sc:43-44 for ** ^ //, parser_prolog.sc:46 for << >>.
    - match: '\*\*|<<|>>|//|[+\-*/^]'
      scope: keyword.operator.arithmetic.pl
    # parser_prolog.sc:24, the = operator.
    - match: '='
      scope: keyword.operator.unification.pl
    # parser_prolog.sc:55-58, Graphic_atom: any other run of graphic characters is an atom, and so an operator minted by op/3.
    - match: '{{graphic}}{{graphic}}+'
      scope: keyword.operator.pl

  words:
    # parser_prolog.sc:12 for the Atom, parser_prolog.sc:24 and parser_prolog.sc:30 for the :- and --> that follow a clause head.
    - match: '^\s*({{atom}})(?=\s*(?:\(|:-|-->))'
      captures:
        1: entity.name.function.pl
    # parser_prolog.sc:27, 47-49 for is mod rem xor. NOTE: the parser reads div, rdiv and as the same way (parser_prolog.sc:29, 50-51), which this rule lacks
    # (difference 1 of the header).
    - match: '\b(?:is|mod|rem|xor)\b'
      scope: keyword.operator.word.pl
    # parser_prolog.sc:12, an Atom: the parser holds no not operator, so this is a colour of the word, not a lexical fact.
    - match: '\bnot\b'
      scope: keyword.operator.logical.negation.pl
    # parser_prolog.sc:12, Atom: true, fail and false are atoms to the reader.
    - match: '\b(?:true|fail|false)\b'
      scope: constant.language.pl
    # parser_prolog.sc:12, Atom: the names are the lowerers' wired set (the Prolog lowerer); head position wins above, so foo :- ... colours foo as a
    # definition even when the name collides with a builtin.
    - match: |-
        (?x)\b(?:
          abolish|abs|acos|acyclic_term|aggregate_all|arg|asin|assert|asserta|assertz
         |atan|atom|atom_chars|atom_codes|atom_concat|atomic|atomic_list_concat
         |atom_length|atom_number|atom_string|bagof|between|call|callable|catch
         |ceiling|char_type|clause|compound|concat_atom|copy_term|cos|current_op
         |current_predicate|current_prolog_flag|current_stream|downcase_atom|exp
         |findall|float|float_fractional_part|float_integer_part|floor
         |flush_output|forall|format|functor|gcd|ground|halt|ignore|integer
         |is_list|log|max|min|msort|name|nb_getval|nb_setval|nl|nonvar|number
         |number_chars|number_codes|number_string|numbervars|once|phrase|plus
         |predicate_property|print|put_char|read|read_term|retract|retractall
         |round|setof|setup_call_cleanup|sign|sin|sort|sqrt|stream_property
         |string_chars|string_codes|string_concat|string_length|string_lower
         |string_to_atom|string_upper|sub_atom|succ|tab|tan|term_string
         |term_to_atom|throw|truncate|upcase_atom|var|with_output_to|write
         |write_canonical|writeln|writeq
        )\b(?=\s*\()
      scope: support.function.pl
    # parser_prolog.sc:12, Atom.
    - match: '\b(?:nl|halt|fail|true|listing)\b'
      scope: support.function.pl
    # parser_prolog.sc:20 and parser_prolog.sc:305, the empty list.
    - match: '\[\]'
      scope: constant.language.empty-list.pl
    # parser_prolog.sc:10-12, Atom: any other lower-led word is a plain atom.
    - match: '{{atom}}'
      scope: constant.other.atom.pl

  punctuation:
    # parser_prolog.sc:19-20 and parser_prolog.sc:32, the brackets and the braces.
    - match: '[()\[\]{}]'
      scope: punctuation.section.group.pl
    # parser_prolog.sc:22, the bar.
    - match: '\|'
      scope: punctuation.separator.pl
    # parser_prolog.sc:21, the comma.
    - match: ','
      scope: punctuation.separator.pl
