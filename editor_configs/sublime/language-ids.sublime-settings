// The language ids scrip --lsp knows (src/driver/lsp_diagnostics.c), by the base scope of each Sublime syntax. Without this the LSP package would
// send the scope's second word (sno, icn, pl, sc), which the server does not know, and no diagnostic would come back.
{
	"source.sno": "snobol4",
	"source.sc": "snocone",
	"source.reb": "rebus",
	"source.icn": "icon",
	"source.pl": "prolog",
	"source.pascal": "pascal",
	"source.raku": "raku",
	"text.html.markdown.scriptix": "scriptix"
}
