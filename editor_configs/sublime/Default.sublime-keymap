// SCRIP's Sublime keymap, written 2026-11-26 by developer_03 on the cqo's ruling (row lsp-go-to-definition-of-a-procedure-lists-its-definition-and-never-its-call-site).
// F12 is go to definition through the language server when a SCRIP server is attached to the view, and Sublime's own goto with none.
// The context names the capability: the key falls through to Sublime's built-in F12 when lsp.session_with_capability finds no definitionProvider.
[
    {
        "keys": ["f12"],
        "command": "lsp_symbol_definition",
        "args": {"side_by_side": false, "force_group": true, "fallback": false, "group": -1},
        "context": [
            {"key": "lsp.session_with_capability", "operand": "definitionProvider"}
        ]
    }
]
