*  REVL_driver - exercises REVL(L): a linked list L reversed.  Contract per
*  REVL.sno header; the module's own DATA('LINK(NEXT,VALUE)') supplies the
*  cell, and a non-LINK argument is returned unchanged.
-INCLUDE "REVL.sno"
        DEFINE('SHOW(L)')                       :(SHOW_END)
SHOW    SHOW  =  DIFFER(DATATYPE(L),'LINK')  '.' :S(RETURN)
        SHOW  =  VALUE(L) ' ' SHOW(NEXT(L))     :(RETURN)
SHOW_END
        L  =  LINK(LINK(LINK(LINK(,'d'),'c'),'b'),'a')
        OUTPUT  =  SHOW(L)
        OUTPUT  =  SHOW(REVL(L))
        OUTPUT  =  SHOW(REVL(LINK(,'solo')))
        OUTPUT  =  '[' REVL('notalist') ']'
        OUTPUT  =  '[' REVL() ']'
END
