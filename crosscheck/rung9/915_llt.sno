* 915_llt.sno — LLT: lexicographic less-than
* Rung 9. 6 assertions.

*       'abc' < 'xyz' — LLT should succeed
        LLT('abc', 'xyz')          :s(e001)
        OUTPUT = 'FAIL 915/001: LLT(abc,xyz) should succeed' :(END)
e001

*       equal strings — LLT fails (strictly less, not <=)
        LLT('abc', 'abc')          :f(e002)
        OUTPUT = 'FAIL 915/002: LLT(abc,abc) should fail'   :(END)
e002

*       'xyz' > 'abc' — LLT should fail
        LLT('xyz', 'abc')          :f(e003)
        OUTPUT = 'FAIL 915/003: LLT(xyz,abc) should fail'   :(END)
e003

*       null < any non-empty string — LLT succeeds
        LLT('', 'abc')             :s(e004)
        OUTPUT = 'FAIL 915/004: LLT(null,abc) should succeed' :(END)
e004

*       any non-empty > null — LLT fails
        LLT('abc', '')             :f(e005)
        OUTPUT = 'FAIL 915/005: LLT(abc,null) should fail'  :(END)
e005

*       ordinal: 'A'(65) < 'a'(97) — LLT must succeed (ordinal, not culture)
        LLT('A', 'a')              :s(e006)
        OUTPUT = 'FAIL 915/006: LLT(A,a) should succeed (ordinal)' :(END)
e006

        OUTPUT = 'PASS 915_llt (6/6)'
