*  208 - GC: one string block referenced by global + array cell + table value
        S = 'shared-payload-' DUPL('s', 12)
        A = ARRAY(3)
        A<1> = S
        T = TABLE()
        T<'k'> = S
        J = 0
cl      J = LT(J, 250) J + 1                                        :F(rd)
        G = 'alias-junk' J DUPL('j', 18)
        :(cl)
rd      OUTPUT = S
        OUTPUT = A<1>
        OUTPUT = T<'k'>
END
