*  207 - GC: computed-name NV buckets created pre-churn read back post-churn
        I = 0
st      I = LT(I, 12) I + 1                                         :F(churn)
        $('VAR' I) = 'stored-' I '-' DUPL('s', 6)
        :(st)
churn   J = 0
cl      J = LT(J, 200) J + 1                                        :F(rd)
        G = 'x' J DUPL('k', 15)
        :(cl)
rd      OUTPUT = $('VAR' 3)
        OUTPUT = $('VAR' 12)
END
