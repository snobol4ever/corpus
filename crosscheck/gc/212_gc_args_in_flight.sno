*  212 - GC: arg window roots; three freshly built string args per call
        DEFINE('j3(a,b,c)')                                         :(j_end)
j3      j3 = a '|' b '|' c                                          :(RETURN)
j_end
        I = 0
lp      I = LT(I, 80) I + 1                                         :F(done)
        R = j3('A' I, DUPL('b', 10) I, 'C' I)
        :(lp)
done    OUTPUT = R
END
