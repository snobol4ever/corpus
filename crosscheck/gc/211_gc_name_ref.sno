*  211 - GC: .NAME cell survives churn; write through $N after regenerations
        X = 'before'
        N = .X
        J = 0
cl      J = LT(J, 200) J + 1                                        :F(wr)
        G = 'name-junk' J DUPL('m', 20)
        :(wr)
wr      $N = 'after-' DUPL('n', 6)
        OUTPUT = X
        OUTPUT = $N
END
