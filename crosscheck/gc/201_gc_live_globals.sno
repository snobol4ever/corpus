*  201 - GC: many NV globals assigned early must adjust across churn
        V1 = 'alpha-' DUPL('a', 8)
        V2 = 'beta-' DUPL('b', 8)
        V3 = 'gamma-' DUPL('c', 8)
        V4 = 'delta-' DUPL('d', 8)
        V5 = 'epsilon-' DUPL('e', 8)
        V6 = 'zeta-' DUPL('f', 8)
        I = 0
loop    I = LT(I, 300) I + 1                                        :F(done)
        G = 'junk' I DUPL('y', 25)
        :(loop)
done    OUTPUT = V1
        OUTPUT = V2
        OUTPUT = V3
        OUTPUT = V4
        OUTPUT = V5
        OUTPUT = V6
END
