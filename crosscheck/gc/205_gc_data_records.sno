*  205 - GC: DATINST fields adjust; linked list of records with string payloads
        DATA('node(val,nxt)')
        HEAD = node('n-0-' DUPL('p', 5), )
        I = 0
mk      I = LT(I, 30) I + 1                                         :F(churn)
        HEAD = node('n-' I '-' DUPL('p', 5), HEAD)
        :(mk)
churn   J = 0
cl      J = LT(J, 250) J + 1                                        :F(walk)
        G = 'trash' J DUPL('t', 20)
        :(cl)
walk    C = 0
        P = HEAD
wl      P = DIFFER(P) nxt(P)                                        :F(done)
        C = C + 1
        :(wl)
done    OUTPUT = 'links=' C
        OUTPUT = val(HEAD)
        OUTPUT = val(nxt(nxt(HEAD)))
END
