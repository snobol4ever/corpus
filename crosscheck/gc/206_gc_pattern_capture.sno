*  206 - GC: scan roots + captures survive churn between and during matches
        R =
        I = 0
lp      I = LT(I, 60) I + 1                                         :F(done)
        S = 'ab' I 'cd' DUPL('m', 5)
        S 'ab' BREAK('c') . V1 'cd'                                 :F(bad)
        G = 'junk' DUPL('w', 40) I
        R = R ',' V1
        :(lp)
bad     OUTPUT = 'MATCH FAILED'                                     :(END)
done    OUTPUT = V1
        OUTPUT = SIZE(R)
END
