*  184_pat_cond_assign_defer_double_fire.sno -- queue row cond-assign-double-fire (s251/s255).
*  A `.` conditional-assignment whose target is a computed/deferred call (`. *f()`)
*  is a REJECTING component in real SPITBOL: `f()` fires once, then the component
*  itself is treated as not-by-name and the whole match fails right there -- any
*  LATER `. *f()` site in the same pattern is never reached. SCRIP's rt_dcap_pump
*  kept walking the queued conditional-assign entries after the first rejection
*  (rc=1; continue) instead of stopping (rc=1; break), so a second, later
*  `. *f()` site fired too. Ablation proved ARBNO is not the ingredient -- see
*  185_pat_cond_assign_defer_seq_minimal.sno for the loop-free reduction.
*  MECHANISM: FINDING-2026-08-22-cond-assign-double-fire-strict-refuse-continue.md
*  ORACLE PROVENANCE: x64/bin/sbl -bf (correctness oracle, s255 two-oracle ruling).
        DEFINE('mark_fire()')                          :(mark_fire_end)
mark_fire       fire_count = fire_count + 1
        mark_fire = ''                                 :(RETURN)
mark_fire_end
        fire_count = 0
        digits = '0123456789'
        pattern = '[' SPAN(digits) (epsilon . *mark_fire()) ARBNO(',' SPAN(digits) (epsilon . *mark_fire())) ']'
        '[1,2]' ? pattern                              :S(matched)F(no_match)
matched OUTPUT = 'MATCH fire_count=' fire_count        :(END)
no_match        OUTPUT = 'NOMATCH fire_count=' fire_count
END
