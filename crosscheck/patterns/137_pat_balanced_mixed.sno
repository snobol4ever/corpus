*  137 - Mixed brackets ([{<>}]) via FENCE alternation
        eps    = LEN(0)
        open   = '(' | '[' | '{' | '<'
        close  = ')' | ']' | '}' | '>'
        B      = open FENCE(*B | eps) close
        s      = '([{<>}])'
        s POS(0) *B RPOS(0)                                   :S(YES)F(NO)
YES     OUTPUT = 'mixed ' s                                   :(END)
NO      OUTPUT = 'fail'
END
