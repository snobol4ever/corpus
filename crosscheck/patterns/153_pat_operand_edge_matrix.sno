	V = 'q'
	V = ','
	'ab,cd' BREAK(V) . W
	OUTPUT = W
	V = 'A'
	'EXCEPTIONS ARE AS TRUE AS RULES' BREAKX(V) . OUTPUT 'AS'
	C = 'z'
	C = 'xa'
	'abc' ANY(C) . W
	OUTPUT = W
	C = 'xz'
	'abc' NOTANY(C) . W
	OUTPUT = W
	C = 'ab'
	'aabbc' SPAN(C) . W
	OUTPUT = W
	N = 9
	N = 3
	'abcde' TAB(N) . W
	OUTPUT = W
	N = 2
	'abcde' RTAB(N) . W
	OUTPUT = W
	N = 3
	'abcde' RPOS(N) LEN(1) . W
	OUTPUT = W
	N = 2
	'abcde' LEN(N) . W
	OUTPUT = W
	N = '2'
	'abcde' TAB(N) . W
	OUTPUT = W
END
