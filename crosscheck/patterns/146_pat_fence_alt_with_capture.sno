*  146 - FENCE picks first matching alt; capture into OP
*  Note: FENCE with ('++' | '+') tries '++' first; both arms work for '++' INPUT
        num   = SPAN('0123456789')
        op    = FENCE('++' | '+')
        expr  = num . A op . OP num . B
        s     = '1++2'
        s POS(0) expr RPOS(0)                                 :S(YES)F(NO)
YES     OUTPUT = A '|' OP '|' B                               :(END)
NO      OUTPUT = 'fail'
END
