*  150 - NEGATIVE DISCRIMINATOR.  Same conjunction as 119 but the outer
*  iterator is explicit alternation, not ARBNO.  Currently PASSES on
*  csnobol4 — establishes that the bug requires ARBNO specifically,
*  not generic iteration over *var-FENCE.  Any future FENCE fix must
*  keep this passing.
        cmd   = FENCE('a' | 'ab')
        outer = (*cmd | *cmd *cmd | *cmd *cmd *cmd)
        s     = 'aab'
        s POS(0) *outer RPOS(0)                               :S(MATCH)F(NOM)
MATCH   OUTPUT = 'matched: ' s                                :(END)
NOM     OUTPUT = 'no match (seals held all paths)'
END
