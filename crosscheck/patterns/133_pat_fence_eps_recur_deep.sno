*  133 - FENCE(*P | epsilon) recursion, depth 30
        eps  = LEN(0)
        P    = LEN(1) FENCE(*P | eps)
        s    = DUPL('a', 30)
        s POS(0) *P RPOS(0)                                   :S(YES)F(NO)
YES     OUTPUT = 'matched depth 30'                           :(END)
NO      OUTPUT = 'fail'
END
