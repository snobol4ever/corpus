*---------------------------------------------------------------------------------------------------
* WITNESS (s118) -- Gen drops the continuation marker on a line completed by a LATER Gen call.
* A flush leaves REM in $'$B'; the line that later completes it was emitted through the
* first-line path ($outNm = outline), losing BOTH the $'$C' marker and the indent.
* RED before the s118 Gen.inc fix: second line came out "BBBCCC" with no '+' and no indent.
*---------------------------------------------------------------------------------------------------
-INCLUDE 'Gen.inc'
                  nl             =  CHAR(10)
                  GenSetCont('+')
                  SetLevel(4)
                  Gen('AAA' nl 'BBB')
                  Gen('CCC' nl)
                  GenSetCont('+')
                  SetLevel(4)
                  Gen('DDD' nl 'EEE' nl 'FFF' nl)
END
