*  1019 - EVAL of a string argument: compile-and-evaluate at runtime
*  (manual Ch.9: string arg is compiled as an expression, evaluated with
*  current variable values; numeric strings/values return themselves)
	N = 15
	OUTPUT = EVAL('3 * N + 2')
	OUTPUT = EVAL(19)
	OUTPUT = EVAL('7')
	P = 'N + 100'
	OUTPUT = EVAL(P)
END
