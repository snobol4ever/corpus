*  TABLE KEYS ARE COUNTED STRINGS -- CHAR(0) IS DATA, NOT A TERMINATOR.
*  ⛔ Lon s263: "Using any C function to manipulate strings is INVALID since the NUL
*  character problem."  strcmp/strlen truncate at the first NUL, so 'a' CHAR(0) 'b'
*  and 'a' CHAR(0) 'c' compare EQUAL and collapse into one table entry -- a wrong
*  ANSWER, silently.  This witness pins the hash AND the equality: both must be
*  length-driven.  It caught rtx_table.S's inlined djb2 and byte-compare at s263,
*  which were still NUL-terminated after the C had been cured.
        z = CHAR(0)
        tab = TABLE()
        tab['a' z 'b'] = 'FIRST'
        tab['a' z 'c'] = 'SECOND'
        tab['a'] = 'PLAIN'
        OUTPUT = 'ab=' tab['a' z 'b'] ' ac=' tab['a' z 'c'] ' a=' tab['a']
        tab[z] = 'JUSTNUL'
        tab[''] = 'EMPTY'
        OUTPUT = 'nul=' tab[z] ' empty=' tab['']
        OUTPUT = 'sizes=' SIZE('a' z 'b') ',' SIZE(z) ',' SIZE('')
*  a NUL in the middle must not shorten a key that is otherwise a prefix
        tab['pre' z] = 'WITHNUL'
        tab['pre'] = 'NONUL'
        OUTPUT = 'pre_nul=' tab['pre' z] ' pre=' tab['pre']
END
