* 1110_array_1d.sno — 1D ARRAY: null init, index/assign, bounds, PROTOTYPE
* Rung 11. 9 assertions.

        a = ARRAY(3)

*       all elements init to null
        DIFFER(a<1>)               :f(e001)
        OUTPUT = 'FAIL 1110/001: array element init null' :(END)
e001

*       assign and read back
        a<2> = 4.5
        DIFFER(a<2>, 4.5)                   :f(e002)
        OUTPUT = 'FAIL 1110/002: array assign/read'    :(END)
e002

*       out of bounds (high) fails
        a<4>                       :f(e003)
        OUTPUT = 'FAIL 1110/003: OOB high should fail' :(END)
e003

*       out of bounds (zero for 1-based) fails
        a<0>                       :f(e004)
        OUTPUT = 'FAIL 1110/004: OOB zero should fail' :(END)
e004

*       PROTOTYPE of a 1-BASED 1-D array is the INTEGER upper bound -- NOT a string.
*       SPITBOL normalises: ARRAY(3) and ARRAY('3') both prototype to INTEGER 3, while
*       the lo:hi and N-D forms stay STRING ('1:3', '2,2' -- see 1112_array_multi).
*       IDENT/DIFFER compare datatype AND value, so the bare 3 asserts the datatype too.
*       (CSNOBOL4 returns STRING '3'; SPITBOL is the authority -- RULES.md.)
        DIFFER(PROTOTYPE(a), 3)                     :f(e005)
        OUTPUT = 'FAIL 1110/005: PROTOTYPE(ARRAY(3)) is INTEGER 3' :(END)
e005

*       array created from numeric string
        b = ARRAY('3')
        b<2> = 'x'
        DIFFER(b<2>, 'x')                   :f(e006)
        OUTPUT = 'FAIL 1110/006: array from string dim' :(END)
e006

*       a numeric-STRING dimension prototypes to the same INTEGER as the numeral
        DIFFER(PROTOTYPE(b), 3)                     :f(e007)
        OUTPUT = "FAIL 1110/007: PROTOTYPE(ARRAY('3')) is INTEGER 3" :(END)
e007

*       assign real into array
        a<1> = 3.14
        DIFFER(a<1>, 3.14)                   :f(e008)
        OUTPUT = 'FAIL 1110/008: array stores real'    :(END)
e008

*       assign string into array
        a<3> = 'z'
        DIFFER(a<3>, 'z')                   :f(e009)
        OUTPUT = 'FAIL 1110/009: array stores string'  :(END)
e009

        OUTPUT = 'PASS 1110_array_1d (9/9)'
END
