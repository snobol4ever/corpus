*  215 - conditional indirect goto :S($X)/:F($X) — the success/failure
*  branch target is itself a label named by a variable's value.
        &TRIM = 1
        T = 'WON'
        F = 'LOST'
        GT(7,3)         :S($T)F($F)
WON     OUTPUT = 'took WON via :S($T)'
        GT(0,3)         :S($T)F($F)
LOST    OUTPUT = 'took LOST via :F($F)'          :(END)
END
