*  216 - computed indirect goto :($('L' OP)) — SPITBOL manual multi-way
*  branch: the label name is BUILT at transfer time from a data value.
        &TRIM = 1
        DEFINE('dispatch(OP)')          :(dmain)
dispatch                                :($('L' OP))
LADD    OUTPUT = 'op=ADD'               :(RETURN)
LMUL    OUTPUT = 'op=MUL'               :(RETURN)
LSUB    OUTPUT = 'op=SUB'               :(RETURN)
dmain   dispatch('ADD')
        dispatch('MUL')
        dispatch('SUB')
        dispatch('MUL')                 :(END)
END
