# rate_concat_table.icn — FIXED-TIME RATE BENCHMARK (s247, GOAL-ICON-100).
# PROTOCOL: warm for args[1] ms UNTIMED (so a JIT reaches steady state), then run whole UNITs
# until args[2] ms elapse, counting them.  Output: "<units> <elapsed_ms> <checksum>".
# The checksum is PER-UNIT, so it is IDENTICAL on every engine no matter how many units each
# managed — one run therefore yields the RATE and a cross-engine CORRECTNESS check together.
# Startup is excluded by construction: the clock is &time, read inside the program.
# UNIT = 10000 string-extends + 10000 table stores (fresh state).  Rate = units * 10000 / ms.
procedure main(args)
  local warm, budget, t0, t1, n, i, s, t;
  warm := integer(args[1]) | 500;
  budget := integer(args[2]) | 2000;
  t0 := &time;
  while &time - t0 < warm do {
    s := "";
    t := table(0);
    every i := 1 to 10000 do {
      s := s || "x";
      t["k" || (i % 97)] := i;
    }
  }
  n := 0;
  t0 := &time;
  while &time - t0 < budget do {
    s := "";
    t := table(0);
    every i := 1 to 10000 do {
      s := s || "x";
      t["k" || (i % 97)] := i;
    }
    n +:= 1;
  }
  t1 := &time;
  write(n, " ", t1 - t0, " ", *s);
end
