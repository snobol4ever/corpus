START &TRIM = 1
      &ANCHOR = 0
      &STLIMIT = 4294967295
      T1 = TIME()
      ITER = 0
LOOP  ITER = LT(ITER, 5000000) ITER + 1  :F(DONE)
      S = 'The quick brown fox jumps over the lazy dog'
      S = REPLACE(S, 'aeiou', '*****')
      N = SIZE(S)  :(LOOP)
DONE  T2 = TIME()
      OUTPUT = T2 - T1
END
