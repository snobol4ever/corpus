* string_manip -- TIME-BASED: fixed ms budget, count iterations.
* bottleneck: REPLACE character translation over a fixed string
        &TRIM = 1
        &ANCHOR = 0
        &STLIMIT = -1
        ZCHK = 1000
        ZBUD = 500
        ZFLR = 20
        DEFINE('ZBODY(ZKN)')                            :(ZBODY_END)
ZBODY   ZI = 1
ZBL     S = 'The quick brown fox jumps over the lazy dog'
        S = REPLACE(S, 'aeiou', '*****')
        NS = SIZE(S)
        ZI = LT(ZI, ZKN) ZI + 1                         :S(ZBL)
        ZBODY = NS                                      :(RETURN)
ZBODY_END
-INCLUDE 'harness.inc'
