* string_manip -- masks every vowel in a fixed sentence, 1000 times, and reports the result.
* bottleneck: REPLACE character translation over a fixed string.
        i = 1
loop    s = 'The quick brown fox jumps over the lazy dog'
        s = REPLACE(s, 'aeiou', '*****')
        i = LT(i, 1000) i + 1                           :S(loop)
        OUTPUT = 'masked text = ' s
END
