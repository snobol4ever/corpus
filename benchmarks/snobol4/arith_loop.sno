* arith_loop -- TIME-BASED: fixed ms budget, count iterations.
* bottleneck: counter increment; loop dispatch
        &TRIM = 1
        &ANCHOR = 0
        &STLIMIT = -1
        ZCHK = 1000
        ZBUD = 500
        ZFLR = 20
        DEFINE('ZBODY(ZKN)')                            :(ZBODY_END)
ZBODY   A = 0
        ZI = 1
ZBL     A = A + 1
        ZI = LT(ZI, ZKN) ZI + 1                         :S(ZBL)
        ZBODY = A                                       :(RETURN)
ZBODY_END
-INCLUDE 'harness.inc'
