* op_dispatch -- TIME-BASED: fixed ms budget, count iterations.
* bottleneck: arithmetic operator dispatch and predicate test
        &TRIM = 1
        &ANCHOR = 0
        &STLIMIT = -1
        ZCHK = 1000
        ZBUD = 500
        ZFLR = 20
        DEFINE('ZBODY(ZKN)')                            :(ZBODY_END)
ZBODY   N = 1
        ZI = 1
ZBL     N = N + 3
        N = N - 1
        N = N * 2
        N = GE(N, 1000000) N / 1000
        ZI = LT(ZI, ZKN) ZI + 1                         :S(ZBL)
        ZBODY = N                                       :(RETURN)
ZBODY_END
-INCLUDE 'harness.inc'
