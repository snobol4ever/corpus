START &TRIM = 1
      &ANCHOR = 0
      &STLIMIT = 4294967295
      T1 = TIME()
      OUTER = 0
      N = 1
OUTER N = N + 3
      N = N - 1
      N = N * 2
      N = GE(N, 10000000) N / 10000  :S(OUTER)F(NEXT)
NEXT  OUTER = LT(OUTER, 1000000) OUTER + 1  :S(OUTER)
      T2 = TIME()
      OUTPUT = T2 - T1
END
