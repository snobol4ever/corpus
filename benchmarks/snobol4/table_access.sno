* table_access -- fills a 500-entry TABLE of even numbers and totals it, 20 times over.
* bottleneck: table creation, hashed store and fetch.
        pass = 1
build   tab = TABLE(512)
        i = 1
fill    tab[i] = i * 2
        i = LT(i, 500) i + 1                            :S(fill)
        sum = 0
        i = 1
read    sum = sum + tab[i]
        i = LT(i, 500) i + 1                            :S(read)
        pass = LT(pass, 20) pass + 1                    :S(build)
        OUTPUT = 'sum of tab[1..500] after 20 rebuilds = ' sum
END
