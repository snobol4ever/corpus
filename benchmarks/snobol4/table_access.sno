* table_access -- fills a 500-entry TABLE of even numbers and totals it, N times over.
* bottleneck: table creation, hashed store and fetch.
* Standalone:  scrip table_access.sno   |   sbl -bf table_access.sno   |   snobol4 table_access.sno
        &TRIM = 1
        &ANCHOR = 0
        &STLIMIT = -1
        DEFINE('TABLE_ACCESS(N)')                       :(TABLE_ACCESS_END)
TABLE_ACCESS  ZI = 1
ZBL     T = TABLE(512)
        I = 1
ZFILL   T[I] = I * 2
        I = LT(I, 500) I + 1                            :S(ZFILL)
        SUM = 0
        I = 1
ZREAD   SUM = SUM + T[I]
        I = LT(I, 500) I + 1                            :S(ZREAD)
        ZI = LT(ZI, N) ZI + 1                           :S(ZBL)
        TABLE_ACCESS = SUM                              :(RETURN)
TABLE_ACCESS_END
*BENCH kernel=TABLE_ACCESS check=20 bud=500 flr=20
        OUTPUT = 'sum of T[1..500] = ' TABLE_ACCESS(1)
        OUTPUT = 'after 20 rebuilds = ' TABLE_ACCESS(20)
END
