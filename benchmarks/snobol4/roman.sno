* roman -- converts the integers 1001..1200 to Roman numerals and totals their lengths.
* bottleneck: recursive function dispatch; RPOS/LEN/BREAK patterns; REPLACE. Each step converts a different integer, so
* no conversion can be hoisted and every recursion depth is exercised.
        DEFINE('roman(n)t')                             :(roman_end)
roman   n ? RPOS(1) LEN(1) . t =                        :F(RETURN)
        '0,1I,2II,3III,4IV,5V,6VI,7VII,8VIII,9IX,' t BREAK(',') . t   :F(FRETURN)
        roman = REPLACE(roman(n), 'IVXLCDM', 'XLCDM**') t   :S(RETURN)F(FRETURN)
roman_end OUTPUT = '1776 -> ' roman(1776)
        total = 0
        i = 1
loop    total = total + SIZE(roman(1000 + i))
        i = LT(i, 200) i + 1                            :S(loop)
        OUTPUT = 'total numeral length for 1001..1200 = ' total
END
