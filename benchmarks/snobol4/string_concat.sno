* string_concat -- TIME-BASED: fixed ms budget, count iterations.
* bottleneck: string growth; cost rises with length
* batch PINNED: this kernel's cost per iteration is not steady-state,
* so the batch size is part of the workload and must not float.
        &TRIM = 1
        &ANCHOR = 0
        &STLIMIT = -1
        ZCHK = 1000
        ZBUD = 500
        ZFLR = 20
        ZK = 20000
        DEFINE('ZBODY(ZKN)')                            :(ZBODY_END)
ZBODY   S = ''
        ZI = 1
ZBL     S = S 'x'
        ZI = LT(ZI, ZKN) ZI + 1                         :S(ZBL)
        ZBODY = SIZE(S)                                 :(RETURN)
ZBODY_END
-INCLUDE 'harness.inc'
