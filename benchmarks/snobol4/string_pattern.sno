* string_pattern -- TIME-BASED: fixed ms budget, count iterations.
* bottleneck: BREAK scanning with conditional capture, field split
        &TRIM = 1
        &ANCHOR = 0
        &STLIMIT = -1
        ZCHK = 1000
        ZBUD = 500
        ZFLR = 20
        REC = 'alpha,beta,gamma,delta,epsilon'
        PAT = BREAK(',') . F1 ',' BREAK(',') . F2 ',' BREAK(',') . F3
        DEFINE('ZBODY(ZKN)')                            :(ZBODY_END)
ZBODY   ZI = 1
ZBL     REC ? PAT
        ZI = LT(ZI, ZKN) ZI + 1                         :S(ZBL)
        ZBODY = F3                                      :(RETURN)
ZBODY_END
-INCLUDE 'harness.inc'
