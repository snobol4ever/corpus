* string_pattern -- splits a comma-separated record into its leading three fields, 1000 times.
* bottleneck: BREAK scanning with conditional capture, field split.
        rec = 'alpha,beta,gamma,delta,epsilon'
        pat = BREAK(',') . f1 ',' BREAK(',') . f2 ',' BREAK(',') . f3
        i = 1
loop    rec ? pat
        i = LT(i, 1000) i + 1                           :S(loop)
        OUTPUT = 'fields = ' f1 ' ' f2 ' ' f3
END
