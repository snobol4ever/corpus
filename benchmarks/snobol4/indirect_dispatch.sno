* indirect_dispatch -- TIME-BASED: fixed ms budget, count iterations.
* bottleneck: BY-NAME dispatch -- APPLY(<name in a variable>, arg) to a
* SNOBOL-defined target, contrast with func_call (direct) and eval_fixed (EVAL).
* ⛔ m4 SEGVs here and it is the B1 class, not a benchmark defect: by-name
* dispatch cannot reach SNOBOL-defined targets in m4 (probe/b1, FINDING s156).
* Sibling .xfail carries the disposition; the 3-line witness is
* probe/b1/b1_apply_snodef_target.sno.  The historical $FN(X) form this file
* used to carry is ORACLE-INVALID (sbl raises ERROR 022) and is gone.
        &TRIM = 1
        &ANCHOR = 0
        &STLIMIT = -1
        ZCHK = 500
        ZBUD = 500
        ZFLR = 20
        DEFINE('ADD1(V)')                               :(ADD1_END)
ADD1    ADD1 = V + 1                                    :(RETURN)
ADD1_END
        ZFN = 'ADD1'
        DEFINE('ZBODY(ZKN)')                            :(ZBODY_END)
ZBODY   ZI = 1
        ZS = 0
ZBL     ZS = ZS + APPLY(ZFN, ZI)
        ZI = LT(ZI, ZKN) ZI + 1                         :S(ZBL)
        ZBODY = ZS                                      :(RETURN)
ZBODY_END
-INCLUDE 'harness.inc'
