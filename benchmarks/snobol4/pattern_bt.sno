* pattern_bt -- TIME-BASED: fixed ms budget, count iterations.
* bottleneck: alternation backtracking; capture on the winning arm
        &TRIM = 1
        &ANCHOR = 0
        &STLIMIT = -1
        ZCHK = 1000
        ZBUD = 500
        ZFLR = 20
        PAT = ('aaa' | 'bbb' | 'ccc' | 'ddd') SPAN('abcd') . W
        SUB = 'xxxxxxxxxxbbbccccddddaaaaxxxxxxxxxxbbbccccddddaaaa'
        DEFINE('ZBODY(ZKN)')                            :(ZBODY_END)
ZBODY   ZI = 1
ZBL     SUB ? PAT
        ZI = LT(ZI, ZKN) ZI + 1                         :S(ZBL)
        ZBODY = W                                       :(RETURN)
ZBODY_END
-INCLUDE 'harness.inc'
