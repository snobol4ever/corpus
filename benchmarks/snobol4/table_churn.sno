START &TRIM = 1
      &ANCHOR = 0
      &STLIMIT = 4294967295
      T = TABLE(1024)
      I = 0
FILL  I = LT(I, 400) I + 1  :F(START)
      T[I] = I  :(FILL)
START T1 = TIME()
      P = 0
PASS  P = LT(P, 10000) P + 1  :F(DONE)
      I = 0
CELL  I = LT(I, 400) I + 1  :F(PASS)
      T[I] = T[I] + 1  :(CELL)
DONE  T2 = TIME()
      SUM = 0
      I = 0
SUMUP I = LT(I, 400) I + 1  :F(REPORT)
      SUM = SUM + T[I]  :(SUMUP)
REPRT OUTPUT = T2 - T1
END
