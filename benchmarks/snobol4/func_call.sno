* func_call -- TIME-BASED: fixed ms budget, count iterations.
* bottleneck: program-defined function call and return overhead
        &TRIM = 1
        &ANCHOR = 0
        &STLIMIT = -1
        ZCHK = 1000
        ZBUD = 500
        ZFLR = 20
        DEFINE('INC(N)')                                :(INCE)
INC    INC = N + 1                                     :(RETURN)
INCE
        DEFINE('ZBODY(ZKN)')                            :(ZBODY_END)
ZBODY   R = 0
        ZI = 1
ZBL     R = INC(R)
        ZI = LT(ZI, ZKN) ZI + 1                         :S(ZBL)
        ZBODY = R                                       :(RETURN)
ZBODY_END
-INCLUDE 'harness.inc'
