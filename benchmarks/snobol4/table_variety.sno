* table_variety -- probes one TABLE with keys of every datatype, 40 times, and reports the census.
* bottleneck: table key handling across every key datatype: integers (negative, zero, positive), strings (short, long,
* integer-looking), reals and the null key, the mixed-type pair 17 and '17', overwrite in place, and misses. The census
* sums every probe, so a wrong bucket, a wrong compare or a lost entry changes it.
        census = 0
        pass = 1
round   tab = TABLE(64)
        ix = -30
intfill tab[ix] = ix * 3
        ix = LT(ix, 30) ix + 1                          :S(intfill)
        sx = 1
strfill tab['k' sx] = sx * 5
        tab['a_much_longer_key_' sx] = sx * 7
        sx = LT(sx, 20) sx + 1                          :S(strfill)
        tab['17'] = 1700
        rx = 1
realfil tab[rx / 2.0] = rx * 11
        rx = LT(rx, 12) rx + 1                          :S(realfil)
        tab[''] = 99
        tab[17] = 1717
        census = census + tab[17] + tab['17']
        tab[5] = 500
        tab[5] = 501
        census = census + tab[5]
        ix = -30
intread census = census + tab[ix]
        ix = LT(ix, 30) ix + 1                          :S(intread)
        sx = 1
strread census = census + tab['k' sx] + tab['a_much_longer_key_' sx]
        sx = LT(sx, 20) sx + 1                          :S(strread)
        rx = 1
realrd  census = census + tab[rx / 2.0]
        rx = LT(rx, 12) rx + 1                          :S(realrd)
        census = census + tab['']
        census = census + SIZE(tab[9999]) + SIZE(tab['absent']) + SIZE(tab[-9999])
        pass = LT(pass, 40) pass + 1                    :S(round)
        OUTPUT = 'census of 40 passes = ' census
        OUTPUT = 'tab[17] = ' tab[17] '   tab["17"] = ' tab['17'] '   tab[5] = ' tab[5]
END
