START &TRIM = 1
      &ANCHOR = 0
      &STLIMIT = 4294967295
      DEFINE('STORE()') :(STORE_END)
STORE STORE = .SLOT :(NRETURN)
STORE_END
      T1 = TIME()
      S = 'abcXdefXghiX'
      PAT1 = LEN(3) $ *STORE() 'X'
      PAT2 = LEN(3) $ V 'X'
      N = 0
LOOP  S ? PAT1
      S ? PAT2
      N = LT(N, 100000) N + 1 :S(LOOP)
      T2 = TIME()
      OUTPUT = T2 - T1
END
