* array_sum -- builds an ARRAY(500) of even numbers and totals it, N times over.
* bottleneck: array allocation, indexed store and fetch.
* Standalone:  scrip array_sum.sno   |   sbl -bf array_sum.sno   |   snobol4 array_sum.sno
        &TRIM = 1
        &ANCHOR = 0
        &STLIMIT = -1
        DEFINE('ARRAY_SUM(N)')                          :(ARRAY_SUM_END)
ARRAY_SUM  ZI = 1
ZBL     V = ARRAY(500)
        I = 1
ZFILL   V[I] = I * 2
        I = LT(I, 500) I + 1                            :S(ZFILL)
        SUM = 0
        I = 1
ZREAD   SUM = SUM + V[I]
        I = LT(I, 500) I + 1                            :S(ZREAD)
        ZI = LT(ZI, N) ZI + 1                           :S(ZBL)
        ARRAY_SUM = SUM                                 :(RETURN)
ARRAY_SUM_END
*BENCH kernel=ARRAY_SUM check=20 bud=500 flr=20
        OUTPUT = 'sum of 2,4,..,1000 = ' ARRAY_SUM(1)
        OUTPUT = 'after 20 rebuilds  = ' ARRAY_SUM(20)
END
