* array_sum -- builds an ARRAY(500) of even numbers and totals it, 20 times over.
* bottleneck: array allocation, indexed store and fetch.
        pass = 1
build   vec = ARRAY(500)
        i = 1
fill    vec[i] = i * 2
        i = LT(i, 500) i + 1                            :S(fill)
        sum = 0
        i = 1
read    sum = sum + vec[i]
        i = LT(i, 500) i + 1                            :S(read)
        pass = LT(pass, 20) pass + 1                    :S(build)
        OUTPUT = 'sum of 2,4,..,1000 after 20 rebuilds = ' sum
END
