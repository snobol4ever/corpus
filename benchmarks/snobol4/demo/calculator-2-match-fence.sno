* calculator-2-match-fence -- TIME-BASED: fixed ms budget, count iterations.
* workload: as calculator-2-match, with FENCE pruning the operator arms.
* PURE MATCH -- no captures, no side effects: isolates pattern throughput from the
* deserializing sibling (calculator-2.sno) which runs the same grammar with sprinkled loads.
* input: calculator-2.dat on stdin (runner redirects <family>.dat).  check = SIZE of the slurped
* text, so a missing or truncated input cannot masquerade as a passing run.
        V              =  ANY('abcdefghijklmnopqrstuvwxyz')
        I              =  SPAN('0123456789')
        A              =  FENCE(V | I | '(' *X ')')
        F              =  FENCE(A | ANY('+-') *F)
        T              =  F ARBNO(ANY('*/') F)
        X              =  T ARBNO(ANY('+-') T)
        eol            =  CHAR(10)
        C              =  POS(0) ARBNO(X eol) RPOS(0)
        &TRIM          =  0
        &STLIMIT =  -1
        ZCHK    =   1
        ZBUD    =   1000
        ZFLR    =   20
        INPUT(.INPUT, 9, '[-f0 -r4194304]')
        ZSRC    =   INPUT
        DEFINE('ZBODY(ZKN)')                            :(ZBODY_END)
ZBODY   ZI      =   1
ZBL     ZSRC    ?   C                               :F(ZBAD)
        ZI      =   LT(ZI, ZKN) ZI + 1                  :S(ZBL)
        ZBODY   =   SIZE(ZSRC)                          :(RETURN)
ZBAD    ZBODY   =   'MATCH-FAILED'                      :(RETURN)
ZBODY_END
-INCLUDE '../harness.inc'
