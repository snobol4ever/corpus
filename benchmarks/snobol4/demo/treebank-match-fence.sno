* treebank-match-fence -- TIME-BASED: fixed ms budget, count iterations.
* workload: as treebank-match, with FENCE pruning the group backtrack.
* PURE MATCH -- no captures, no side effects: isolates pattern throughput from the
* deserializing sibling (treebank.sno) which runs the same grammar with sprinkled loads.
* input: treebank.dat on stdin (runner redirects <family>.dat).  check = SIZE of the slurped
* text, so a missing or truncated input cannot masquerade as a passing run.
        &TRIM       =   0
        delim       =   SPAN(' ' CHAR(10))
        word        =   NOTANY('( )' CHAR(10))
+                       BREAK('( )' CHAR(10))
        group       =   '('
+                       word
+                       ARBNO(delim FENCE(*group | word))
+                       ')'
        treebank    =   POS(0) ARBNO(ARBNO(*group FENCE) delim FENCE) RPOS(0)
        &STLIMIT =  -1
        ZCHK    =   1
        ZBUD    =   1000
        ZFLR    =   20
        INPUT(.INPUT, 9, '[-f0 -r4194304]')
        ZSRC    =   INPUT
        DEFINE('ZBODY(ZKN)')                            :(ZBODY_END)
ZBODY   ZI      =   1
ZBL     ZSRC    ?   treebank                               :F(ZBAD)
        ZI      =   LT(ZI, ZKN) ZI + 1                  :S(ZBL)
        ZBODY   =   SIZE(ZSRC)                          :(RETURN)
ZBAD    ZBODY   =   'MATCH-FAILED'                      :(RETURN)
ZBODY_END
-INCLUDE '../harness.inc'
