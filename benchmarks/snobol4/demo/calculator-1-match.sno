* calculator-1-match -- TIME-BASED: fixed ms budget, count iterations.
* workload: recursive expression grammar (right-assoc *X descent).
* PURE MATCH -- no captures, no side effects: isolates pattern throughput from the
* deserializing sibling (calculator-1.sno) which runs the same grammar with sprinkled loads.
* input: calculator-1.dat on stdin (runner redirects <family>.dat).  check = SIZE of the slurped
* text, so a missing or truncated input cannot masquerade as a passing run.
        &TRIM   =  0
        I       =  SPAN('0123456789')
        V       =  ANY(&LCASE)
        A       =  I | V | '(' *X ')'
        F       =  '+' *F | '-' *F | A
        T       =  F '*' *T | F '/' *T | F
        X       =  T '+' *X | T '-' *X | T
        C       =  POS(0) ARBNO(X CHAR(10)) RPOS(0)
        &STLIMIT =  -1
        ZCHK    =   1
        ZBUD    =   1000
        ZFLR    =   20
        INPUT(.INPUT, 9, '[-f0 -r4194304]')
        ZSRC    =   INPUT
        DEFINE('ZBODY(ZKN)')                            :(ZBODY_END)
ZBODY   ZI      =   1
ZBL     ZSRC    ?   C                               :F(ZBAD)
        ZI      =   LT(ZI, ZKN) ZI + 1                  :S(ZBL)
        ZBODY   =   SIZE(ZSRC)                          :(RETURN)
ZBAD    ZBODY   =   'MATCH-FAILED'                      :(RETURN)
ZBODY_END
-INCLUDE '../harness.inc'
