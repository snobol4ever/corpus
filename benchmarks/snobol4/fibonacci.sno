* fibonacci -- the naive doubly-recursive Fibonacci, printed as a table.
* bottleneck: recursive program-defined function call depth.
* Standalone:  scrip fibonacci.sno   |   sbl -bf fibonacci.sno   |   snobol4 fibonacci.sno
        &TRIM = 1
        &ANCHOR = 0
        &STLIMIT = -1
        DEFINE('FIB(N)')                                :(FIBE)
FIB     FIB = LT(N, 2) N                                :S(RETURN)
        FIB = FIB(N - 1) + FIB(N - 2)                   :(RETURN)
FIBE
        DEFINE('FIBONACCI(N)')                          :(FIBONACCI_END)
FIBONACCI  ZI = 1
ZBL     R = FIB(16)
        ZI = LT(ZI, N) ZI + 1                           :S(ZBL)
        FIBONACCI = R                                   :(RETURN)
FIBONACCI_END
*BENCH kernel=FIBONACCI check=3 bud=500 flr=20
        K = 0
FTAB    OUTPUT = 'fib(' K ') = ' FIB(K)
        K = LT(K, 16) K + 1                             :S(FTAB)
END
