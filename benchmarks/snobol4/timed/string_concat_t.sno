* string_concat_t -- TIME-BASED: fixed ms budget, count iterations
* bottleneck: string growth; cost rises with length
* GENERATED by scripts/gen_timed_bench_snobol4.sh -- edit the generator, not this file.
* phase 1 = deterministic check (ref-diffable) | phase 2 = calibrate batch | phase 3 = measure
        &TRIM = 1
        &ANCHOR = 0
        &STLIMIT = -1
        ZBUD = 500
        ZFLR = 20
* ---- phase 1 -- CHECK: fixed count, deterministic output
        S = ''
        ZI = 1
ABODY   S = S 'x'
        ZI = LT(ZI, 1000) ZI + 1                      :S(ABODY)
        OUTPUT = "check: " SIZE(S)
* ---- phase 2 -- CALIBRATE: grow the batch until it spans ZFLR ms
        ZK = 20000
* batch PINNED: this kernel's cost per iteration is not steady-state,
* so the batch size is part of the workload and must not float.
* ---- phase 3 -- MEASURE: batches until the deadline; count iterations
        ZT = TIME()
        ZD = ZT + ZBUD
        ZN = 0
ZB      ZI = 1
        S = ''
CBODY   S = S 'x'
        ZI = LT(ZI, ZK) ZI + 1                          :S(CBODY)
        ZN = ZN + ZK
        LT(TIME(), ZD)                                  :S(ZB)
        ZE = TIME() - ZT
        OUTPUT = "iters: " ZN
        OUTPUT = "ms: " ZE
END
