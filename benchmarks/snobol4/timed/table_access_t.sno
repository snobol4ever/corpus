        ZI = LT(ZI, 20) ZI + 1                      :S(ABODY)
        OUTPUT = "check: " SUM
* ---- phase 2 -- CALIBRATE: grow the batch until it spans ZFLR ms
        ZK = 1
ZCAL    ZT = TIME()
        ZI = 1
BBODY   T = TABLE(512)
        I = 1
BFILL   T[I] = I * 2
        I = LT(I, 500) I + 1                            :S(BFILL)
        SUM = 0
        I = 1
BREAD   SUM = SUM + T[I]
        I = LT(I, 500) I + 1                            :S(BREAD)
