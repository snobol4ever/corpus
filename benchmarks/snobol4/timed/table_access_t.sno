        &TRIM = 1
        &ANCHOR = 0
        &STLIMIT = -1
        ZBUD = 500
        ZFLR = 20
* ---- phase 1 -- CHECK: fixed count, deterministic output
        ZI = 1
ABODY   T = TABLE(512)
