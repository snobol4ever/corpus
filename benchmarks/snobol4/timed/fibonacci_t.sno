* fibonacci_t -- TIME-BASED: fixed ms budget, count iterations
* bottleneck: deep recursion; FIB(16) per iteration
* GENERATED by scripts/gen_timed_bench_snobol4.sh -- edit the generator, not this file.
* phase 1 = deterministic check (ref-diffable) | phase 2 = calibrate batch | phase 3 = measure
        &TRIM = 1
        &ANCHOR = 0
        &STLIMIT = -1
        ZBUD = 500
        ZFLR = 20
        DEFINE('FIB(N)')                                :(FIBE)
FIB    FIB = LT(N, 2) N                                :S(RETURN)
        FIB = FIB(N - 1) + FIB(N - 2)                   :(RETURN)
FIBE
* ---- phase 1 -- CHECK: fixed count, deterministic output
        ZI = 1
ABODY   R = FIB(16)
        ZI = LT(ZI, 3) ZI + 1                      :S(ABODY)
        OUTPUT = "check: " R
* ---- phase 2 -- CALIBRATE: grow the batch until it spans ZFLR ms
        ZK = 1
ZCAL    ZT = TIME()
        ZI = 1
BBODY   R = FIB(16)
        ZI = LT(ZI, ZK) ZI + 1                          :S(BBODY)
        ZE = TIME() - ZT
        ZK = LT(ZE, ZFLR) ZK * 2                        :S(ZCAL)
* ---- phase 3 -- MEASURE: batches until the deadline; count iterations
        ZT = TIME()
        ZD = ZT + ZBUD
        ZN = 0
ZB      ZI = 1
CBODY   R = FIB(16)
        ZI = LT(ZI, ZK) ZI + 1                          :S(CBODY)
        ZN = ZN + ZK
        LT(TIME(), ZD)                                  :S(ZB)
        ZE = TIME() - ZT
        OUTPUT = "iters: " ZN
        OUTPUT = "ms: " ZE
END
