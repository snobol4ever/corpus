START &TRIM = 1
      &ANCHOR = 0
      &STLIMIT = 4294967295
      PAT = ('aaa' | 'bbb' | 'ccc' | 'ddd') SPAN('abcd') . W
      S = 'xxxxxxxxxxbbbccccddddaaaaxxxxxxxxxxbbbccccddddaaaa'
      T1 = TIME()
      N = 0
LOOP  S ? PAT  :F(DONE)
      N = LT(N, 8000000) N + 1  :S(LOOP)
DONE  T2 = TIME()
      OUTPUT = T2 - T1
END
