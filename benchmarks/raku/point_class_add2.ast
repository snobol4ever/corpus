#rc 0
(STMT :subj (TT_USE_DECL v6))
(STMT :subj (TT_USE_DECL nqp))
(STMT :subj (TT_CLASS_DECL
  (TT_VAR Point)
  (TT_VAR .x)
  (TT_VAR .y)
  (TT_SUB_DECL
    (TT_VAR new)
    (TT_VAR x (TT_QLIT "num"))
    (TT_VAR y (TT_QLIT "num"))
    (TT_DECL (TT_VAR Point) (TT_VAR self) (TT_FNC nqp::create (TT_VAR nqp::create) (TT_VAR self)))
    (TT_FNC nqp::bindattr_n (TT_VAR nqp::bindattr_n) (TT_VAR self) (TT_VAR Point) (TT_QLIT "$!x") (TT_VAR x))
    (TT_FNC nqp::bindattr_n (TT_VAR nqp::bindattr_n) (TT_VAR self) (TT_VAR Point) (TT_QLIT "$!y") (TT_VAR y))
    (TT_RETURN (TT_VAR self))
  )
  (TT_SUB_DECL
    (TT_VAR add)
    (TT_VAR b (TT_QLIT "Point"))
    (TT_RETURN
      (TT_NEW
        (TT_QLIT "Point")
        (TT_ADD (TT_TWIGIL_FIELD x) (TT_METHCALL (TT_VAR b) (TT_QLIT "x")))
        (TT_ADD (TT_TWIGIL_FIELD y) (TT_METHCALL (TT_VAR b) (TT_QLIT "y")))
      )
    )
  )
))
(STMT :subj (TT_DECL (TT_VAR int) (TT_VAR i) (TT_ILIT 0)))
(STMT :subj (TT_DECL (TT_VAR Point) (TT_VAR a) (TT_NEW (TT_QLIT "Point") (TT_FLIT 1.5) (TT_FLIT 2.5))))
(STMT :subj (TT_DECL (TT_VAR Point) (TT_VAR b) (TT_NEW (TT_QLIT "Point") (TT_FLIT 3.25) (TT_FLIT 4.75))))
(STMT :subj (TT_WHILE
  (TT_LT (TT_VAR i) (TT_ILIT 1000000))
  (TT_SEQ_EXPR
    (TT_ASSIGN (TT_VAR a) (TT_METHCALL (TT_METHCALL (TT_VAR a) (TT_QLIT "add") (TT_VAR b)) (TT_QLIT "add") (TT_VAR b)))
    (TT_ASSIGN (TT_VAR i) (TT_ADD (TT_VAR i) (TT_ILIT 1)))
  )
))
(STMT :subj (TT_PRINT (TT_METHCALL (TT_VAR a) (TT_QLIT "x")) (TT_QLIT " ") (TT_METHCALL (TT_VAR a) (TT_QLIT "y"))))
(STMT :subj (TT_SEQ_EXPR))
