#rc 0
(STMT :subj (TT_ASSIGN
  (TT_VAR s)
  (TT_CAT (TT_CAT (TT_XREP (TT_QLIT " ") (TT_ILIT 128)) (TT_XREP (TT_QLIT "x") (TT_ILIT 128))) (TT_XREP (TT_QLIT " ") (TT_ILIT 128)))
))
(STMT :subj (TT_ASSIGN (TT_VAR result) (TT_QLIT "")))
(STMT :subj (TT_EVERY
  (TT_ITERATE _ (TT_TO (TT_ILIT 1) (TT_ILIT 128)))
  (TT_SEQ_EXPR (TT_ASSIGN (TT_VAR result) (TT_METHCALL (TT_VAR s) (TT_QLIT "trim"))))
))
(STMT :subj (TT_SAY (TT_METHCALL (TT_VAR result) (TT_QLIT "chars"))))
(STMT :subj (TT_SEQ_EXPR))
