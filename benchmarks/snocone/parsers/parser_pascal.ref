(TT_PROC_DECL
  (TT_VAR endofline)
  (TT_VLIST)
  (TT_PROGRAM
    (TT_IF
      (TT_GT
        (TT_VAR errinx)
        (TT_ILIT 0)
      )
      (TT_SEQ_EXPR
        (TT_FNC
          (TT_VAR __pas_write)
          (TT_VAR output)
          (TT_VAR linecount)
          (TT_ILIT 6)
          (TT_QLIT " ****  ")
          (TT_ILIT 9)
          (TT_ILIT -1)
        )
        (TT_ASSIGN
          (TT_VAR lastpos)
          (TT_ILIT 0)
        )
        (TT_ASSIGN
          (TT_VAR freepos)
          (TT_ILIT 1)
        )
        (TT_FOR
          (TT_VAR k)
          (TT_ILIT 1)
          (TT_VAR errinx)
          (TT_SEQ_EXPR
            (TT_FNC
              (TT_VAR __pas_with)
              (TT_IDX
                (TT_VAR errlist)
                (TT_VAR k)
              )
              (TT_SEQ_EXPR
                (TT_ASSIGN
                  (TT_VAR currpos)
                  (TT_VAR pos)
                )
                (TT_ASSIGN
                  (TT_VAR currnmr)
                  (TT_VAR nmr)
                )
              )
            )
            (TT_IF
              (TT_EQ
                (TT_VAR currpos)
                (TT_VAR lastpos)
              )
              (TT_FNC
                (TT_VAR __pas_write)
                (TT_VAR output)
                (TT_QLIT ",")
                (TT_ILIT -1)
              )
              (TT_SEQ_EXPR
                (TT_WHILE
                  (TT_LT
                    (TT_VAR freepos)
                    (TT_VAR currpos)
                  )
                  (TT_SEQ_EXPR
                    (TT_FNC
                      (TT_VAR __pas_write)
                      (TT_VAR output)
                      (TT_QLIT " ")
                      (TT_ILIT -1)
                    )
                    (TT_ASSIGN
                      (TT_VAR freepos)
                      (TT_ADD
                        (TT_VAR freepos)
                        (TT_ILIT 1)
                      )
                    )
                  )
                )
                (TT_FNC
                  (TT_VAR __pas_write)
                  (TT_VAR output)
                  (TT_QLIT "^")
                  (TT_ILIT -1)
                )
                (TT_ASSIGN
                  (TT_VAR lastpos)
                  (TT_VAR currpos)
                )
              )
            )
            (TT_IF
              (TT_LT
                (TT_VAR currnmr)
                (TT_ILIT 10)
              )
              (TT_ASSIGN
                (TT_VAR f)
                (TT_ILIT 1)
              )
              (TT_IF
                (TT_LT
                  (TT_VAR currnmr)
                  (TT_ILIT 100)
                )
                (TT_ASSIGN
                  (TT_VAR f)
                  (TT_ILIT 2)
                )
                (TT_ASSIGN
                  (TT_VAR f)
                  (TT_ILIT 3)
                )
              )
            )
            (TT_FNC
              (TT_VAR __pas_write)
              (TT_VAR output)
              (TT_VAR currnmr)
              (TT_VAR f)
              (TT_ILIT -1)
            )
            (TT_ASSIGN
              (TT_VAR freepos)
              (TT_ADD
                (TT_ADD
                  (TT_VAR freepos)
                  (TT_VAR f)
                )
                (TT_ILIT 1)
              )
            )
          )
        )
        (TT_FNC
          (TT_VAR __pas_writeln)
          (TT_VAR output)
          (TT_ILIT -1)
        )
        (TT_ASSIGN
          (TT_VAR errinx)
          (TT_ILIT 0)
        )
      )
    )
    (TT_ASSIGN
      (TT_VAR linecount)
      (TT_ADD
        (TT_VAR linecount)
        (TT_ILIT 1)
      )
    )
    (TT_IF
      (TT_MUL
        (TT_VAR list)
        (TT_EQ
          (TT_FNC
            (TT_VAR eof)
            (TT_VAR input)
          )
          (TT_ILIT 0)
        )
      )
      (TT_SEQ_EXPR
        (TT_FNC
          (TT_VAR __pas_write)
          (TT_VAR output)
          (TT_VAR linecount)
          (TT_ILIT 6)
          (TT_QLIT "  ")
          (TT_ILIT 2)
          (TT_ILIT -1)
        )
        (TT_IF
          (TT_VAR dp)
          (TT_FNC
            (TT_VAR __pas_write)
            (TT_VAR output)
            (TT_VAR lc)
            (TT_ILIT 7)
            (TT_ILIT -1)
          )
          (TT_FNC
            (TT_VAR __pas_write)
            (TT_VAR output)
            (TT_VAR ic)
            (TT_ILIT 7)
            (TT_ILIT -1)
          )
        )
        (TT_FNC
          (TT_VAR __pas_write)
          (TT_VAR output)
          (TT_QLIT " ")
          (TT_ILIT -1)
        )
      )
    )
    (TT_ASSIGN
      (TT_VAR chcnt)
      (TT_ILIT 0)
    )
  )
  (TT_VLIST)
)
(TT_PROC_DECL
  (TT_VAR error)
  (TT_VLIST
    (TT_VAR ferrnr)
  )
  (TT_PROGRAM
    (TT_IF
      (TT_GE
        (TT_VAR errinx)
        (TT_ILIT 9)
      )
      (TT_SEQ_EXPR
        (TT_ASSIGN
          (TT_FIELD
            (TT_IDX
              (TT_VAR errlist)
              (TT_ILIT 10)
            )
            (TT_VAR nmr)
          )
          (TT_ILIT 255)
        )
        (TT_ASSIGN
          (TT_VAR errinx)
          (TT_ILIT 10)
        )
      )
      (TT_SEQ_EXPR
        (TT_ASSIGN
          (TT_VAR errinx)
          (TT_ADD
            (TT_VAR errinx)
            (TT_ILIT 1)
          )
        )
        (TT_ASSIGN
          (TT_FIELD
            (TT_IDX
              (TT_VAR errlist)
              (TT_VAR errinx)
            )
            (TT_VAR nmr)
          )
          (TT_VAR ferrnr)
        )
      )
    )
    (TT_ASSIGN
      (TT_FIELD
        (TT_IDX
          (TT_VAR errlist)
          (TT_VAR errinx)
        )
        (TT_VAR pos)
      )
      (TT_VAR chcnt)
    )
  )
  (TT_VLIST)
)
