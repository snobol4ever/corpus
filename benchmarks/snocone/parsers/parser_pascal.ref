            (TT_ADD
              (TT_VAR chcnt)
              (TT_ILIT 1)
            )
          )
        )
        (TT_SEQ_EXPR
          (TT_FNC
            (TT_VAR __pas_writeln)
            (TT_VAR output)
            (TT_QLIT "   *** eof ")
            (TT_QLIT "encountered")
            (TT_ILIT -1)
          )
          (TT_ASSIGN
            (TT_VAR test)
            (TT_EQ
              (TT_ILIT 0)
              (TT_ILIT 1)
            )
          )
        )
      )
    )
    (TT_VLIST)
  )
  (TT_PROC_DECL
    (TT_VAR options)
    (TT_VLIST)
    (TT_PROGRAM
      (TT_REPEAT
