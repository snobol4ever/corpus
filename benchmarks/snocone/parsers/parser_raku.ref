(TT_STMT
  (TT_ATTR :subj
    (TT_SUB_DECL
      (TT_QUAL
        (TT_QLIT "multi")
      )
      (TT_VAR to-json)
      (TT_SIGNATURE
        (TT_PARAM
          (TT_TYPE Bool:D)
          (TT_VAR $d)
