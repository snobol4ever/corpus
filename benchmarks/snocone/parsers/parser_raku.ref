(TT_STMT
  (TT_ATTR :subj
    (TT_SUB_DECL
      (TT_QUAL
        (TT_QLIT "multi")
      )
      (TT_VAR to-json)
      (TT_SIGNATURE
        (TT_PARAM
          (TT_TYPE Mu:D)
          (TT_VAR $s)
          (TT_NUL)
          (TT_TRAITS)
        )
      )
      (TT_TRAITS)
      (TT_SEQ_EXPR
        (TT_DIE
          (TT_CAT
            (TT_QLIT "Can't serialize an object of type ")
            (TT_METHCALL
              (TT_METHCALL
                (TT_VAR $s)
                (TT_QLIT "WHAT")
              )
              (TT_QLIT "perl")
            )
          )
        )
      )
    )
  )
)
(TT_STMT
  (TT_ATTR :subj
    (TT_SUB_DECL
      (TT_QUAL)
      (TT_VAR MAIN)
      (TT_SIGNATURE
        (TT_PARAM
          (TT_NUL)
          (TT_VAR $json-file)
          (TT_METHCALL
            (TT_METHCALL
              (TT_METHCALL
                (TT_VAR $*PROGRAM)
                (TT_QLIT "parent")
              )
              (TT_QLIT "add")
              (TT_QLIT "panda-projects.json")
            )
            (TT_QLIT "Str")
          )
          (TT_TRAITS)
        )
        (TT_PARAM
          (TT_TYPE Int)
          (TT_VAR $count)
          (TT_ILIT 8)
          (TT_TRAITS)
        )
      )
      (TT_TRAITS)
      (TT_SEQ_EXPR
        (TT_DECL my
          (TT_NUL)
          (TT_VAR $json)
          (TT_BIND
            (TT_FNC
              (TT_VAR slurp)
              (TT_VAR $json-file)
            )
          )
        )
        (TT_DECL my
          (TT_TYPE Int)
          (TT_VAR $i)
          (TT_ILIT 0)
        )
        (TT_WHILE
          (TT_LT
            (TT_VAR $i)
            (TT_VAR $count)
          )
          (TT_SEQ_EXPR
            (TT_POSTINC
              (TT_VAR $i)
            )
            (TT_DECL my
              (TT_NUL)
              (TT_VAR $data)
              (TT_BIND
                (TT_FNC
                  (TT_VAR from-json)
                  (TT_VAR $json)
                )
              )
            )
          )
        )
        (TT_SAY
          (TT_CAT
            (TT_QLIT "parsed ")
            (TT_VAR $i)
          )
        )
      )
    )
  )
)
