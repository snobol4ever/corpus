          (TT_VAR $d)
          (TT_QLIT "true")
          (TT_QLIT "false")
        )
      )
    )
  )
)
(TT_STMT
  (TT_ATTR :subj
    (TT_SUB_DECL
      (TT_QUAL
        (TT_QLIT "multi")
      )
      (TT_VAR to-json)
      (TT_SIGNATURE
        (TT_PARAM
          (TT_TYPE Str:D)
          (TT_VAR $d)
          (TT_NUL)
          (TT_TRAITS)
        )
      )
      (TT_TRAITS)
      (TT_SEQ_EXPR
        (TT_CAT
          (TT_CAT
            (TT_QLIT "\"")
            (TT_METHCALL
              (TT_METHCALL
                (TT_VAR $d)
                (TT_QLIT "trans")
                (TT_PAIR
                  (TT_ARRAY
                    (TT_QLIT "\"")
                    (TT_QLIT "\\")
                    (TT_QLIT "\x08")
                    (TT_QLIT "\x0c")
                    (TT_QLIT "\n")
                    (TT_QLIT "\r")
                    (TT_QLIT "\t")
                  )
                  (TT_ARRAY
                    (TT_CAT
                      (TT_QLIT "\\")
                      (TT_QLIT "\"")
                    )
                    (TT_CAT
                      (TT_QLIT "\\")
                      (TT_QLIT "\\")
                    )
                    (TT_CAT
                      (TT_QLIT "\\")
                      (TT_QLIT "b")
                    )
                    (TT_CAT
                      (TT_QLIT "\\")
                      (TT_QLIT "f")
                    )
                    (TT_CAT
                      (TT_QLIT "\\")
                      (TT_QLIT "n")
                    )
                    (TT_CAT
                      (TT_QLIT "\\")
                      (TT_QLIT "r")
                    )
                    (TT_CAT
                      (TT_QLIT "\\")
                      (TT_QLIT "t")
                    )
                  )
                )
              )
              (TT_QLIT "subst")
              (TT_REGEX
                (TT_QLIT "<-[\\c32..\\c126]>")
              )
              (TT_ANON_BLOCK
                (TT_NUL)
                (TT_SEQ_EXPR
                  (TT_METHCALL
                    (TT_FNC
                      (TT_VAR ord)
                      (TT_STR
                        (TT_VAR $_)
                      )
                    )
                    (TT_QLIT "fmt")
                    (TT_CAT
                      (TT_QLIT "\\")
                      (TT_QLIT "u%04x")
                    )
                  )
                )
              )
              (TT_COLONPAIR
                (TT_QLIT "g")
              )
            )
          )
          (TT_QLIT "\"")
        )
      )
    )
  )
)
(TT_STMT
  (TT_ATTR :subj
    (TT_SUB_DECL
      (TT_QUAL
        (TT_QLIT "multi")
      )
      (TT_VAR to-json)
      (TT_SIGNATURE
        (TT_PARAM
          (TT_TYPE Positional:D)
          (TT_VAR $d)
          (TT_NUL)
          (TT_TRAITS)
        )
      )
      (TT_TRAITS)
      (TT_SEQ_EXPR
        (TT_RETURN
          (TT_CAT
            (TT_CAT
              (TT_QLIT "[ ")
              (TT_METHCALL
                (TT_METHCALL
                  (TT_VAR $d)
                  (TT_QLIT "map")
                  (TT_VAR &to-json)
                )
                (TT_QLIT "join")
                (TT_QLIT ", ")
              )
            )
            (TT_QLIT " ]")
          )
        )
      )
    )
  )
)
(TT_STMT
  (TT_ATTR :subj
    (TT_SUB_DECL
      (TT_QUAL
        (TT_QLIT "multi")
      )
      (TT_VAR to-json)
      (TT_SIGNATURE
        (TT_PARAM
          (TT_TYPE Associative:D)
          (TT_VAR $d)
          (TT_NUL)
          (TT_TRAITS)
        )
      )
      (TT_TRAITS)
      (TT_SEQ_EXPR
        (TT_RETURN
          (TT_CAT
            (TT_CAT
              (TT_QLIT "{ ")
              (TT_METHCALL
                (TT_METHCALL
                  (TT_VAR $d)
                  (TT_QLIT "map")
                  (TT_ANON_BLOCK
                    (TT_NUL)
                    (TT_SEQ_EXPR
                      (TT_CAT
                        (TT_CAT
                          (TT_FNC
                            (TT_VAR to-json)
                            (TT_METHCALL
                              (TT_VAR $_)
                              (TT_QLIT "key")
                            )
                          )
                          (TT_QLIT " : ")
                        )
                        (TT_FNC
                          (TT_VAR to-json)
                          (TT_METHCALL
                            (TT_VAR $_)
                            (TT_QLIT "value")
                          )
                        )
                      )
                    )
                  )
                )
                (TT_QLIT "join")
                (TT_QLIT ", ")
              )
            )
            (TT_QLIT " }")
          )
        )
      )
    )
  )
)
(TT_STMT
  (TT_ATTR :subj
    (TT_SUB_DECL
      (TT_QUAL
