# rung37_cset_ops.icn -- IJ-15: cset literal, cset() builtin, cset ops, augmented ops
procedure main();
   local cs, cs2, cs3;
   # cset literal type
   cs := 'abc';
   write(type(cs));
   # cset() conversion
   cs2 := cset("xyz");
   write(type(cs2));
   # cset union
   cs3 := cs ++ cs2;
   write(type(cs3));
   write(image(cs3));
   # cset diff
   cs3 := cs3 -- cset("bx");
   write(image(cs3));
   # cset inter
   cs3 := cs3 ** cset("acyz");
   write(image(cs3));
   # cset augmented assignment
   cs := cset("abc");
   cs ++:= cset("d");
   write(image(cs));
   cs --:= cset("b");
   write(image(cs));
   cs **:= cset("cd");
   write(image(cs));
   # cset iteration
   cs := cset("ba");
   every write(!cs);
   # cset() from read string
   write(*cset("hello"));
end
